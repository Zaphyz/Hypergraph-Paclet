# Upstream reference clones (WolframInstitute/Hypergraph and Wolfram/Multicomputation).
# These are read-only checkouts kept for comparison; each carries its own .git directory.
# Re-create with:
#   git clone https://github.com/WolframInstitute/Hypergraph.git reference/Hypergraph
#   git clone https://github.com/WolframInstitute/Multicomputation.git reference/Multicomputation
reference/*
# The research files under reference/ are not clones of anything and exist nowhere else, so
# they are tracked. HypergraphMinicourse.wl is left out at 4.2 MB.
!reference/Chemoids.wl
!reference/PlexAlgebra.wl
!reference/HypergraphAlgebras.wl
!reference/ArrayAlgebra.wl

# Paclet build products. Anchored: an unanchored build/ also swallows notebooks/build/,
# which holds the notebook generators and is tracked.
/build/
*.paclet

# The documentation notebooks under Documentation/ are generated by Documentation/build_docs.wls,
# which is itself tracked, but they are tracked too: they are what a reader opens, and a paclet is
# installed rather than built. (The upstream paclets ignore theirs, building from markdown; this
# project has no such pipeline.) Only the search index is left out, being a true build product.
Documentation/English/SearchIndex/

# Wolfram scratch
*.wlnb.bak
.MathematicaNotebookBackups/

# OS cruft
.DS_Store
Thumbs.db
desktop.ini
