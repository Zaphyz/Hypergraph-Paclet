}], "Text",ExpressionUUID->"663e4788-1272-9541-b9c6-b8b8aeb75f41"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"FindArrayEquations", "::", "arity"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"3145476f-7d8c-a940-86d1-edf95fffe2a7"],
