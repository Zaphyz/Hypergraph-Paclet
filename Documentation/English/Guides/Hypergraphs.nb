   RowBox[{"NumericalArray", "::", "entries"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"00795348-d6a7-244d-b6ca-63eaeac4b98f"],
 " \[LongDash] ",
 "some entry lies outside the declared value domain"
}], "Text",ExpressionUUID->"e2a8d334-841a-bb4e-9a1c-6adf9f4069fc"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"NumericalArray", "::", "nosym"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"a409a430-ed90-0a44-bd5d-ef2297eab79b"],
 " \[LongDash] ",
 "the entries are not invariant under the declared symmetry"
}], "Text",ExpressionUUID->"84ca2b11-9827-ee4d-95f3-c53ff1a71032"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"NumericalArray", "::", "irreg"}], "InlineCode"]], "InlineFormula",
