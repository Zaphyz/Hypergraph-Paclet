 "one vertex identifier was given more than one label"
}], "Text",ExpressionUUID->"7a852690-b0f2-6a44-9198-4d2488bb8858"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"CanonicalHypergraph", "::", "large"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"2d0f825d-4e04-f841-aba4-d384a8434d0e"],
 " \[LongDash] ",
 "the isomorphism search will be slow at this size"
}], "Text",ExpressionUUID->"3a15967f-7730-c241-80c1-7d85dd9f1dce"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayObject", "::", "nosym"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"cdbb5380-d502-5241-8dec-32af1d8aff0d"],
