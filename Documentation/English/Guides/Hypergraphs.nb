}], "Text",ExpressionUUID->"a8e15425-c384-b143-a4b1-6def9b7d437d"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayEntries", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "ddb18005-0824-fd46-afa4-ef7b209fff34"],
 " \[LongDash] ",
 "the entries, as a nested list"
}], "Text",ExpressionUUID->"de09c071-6274-7d43-84dc-cc337609559c"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["RegularArrayQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "ce215eb5-8b60-cd44-a5c9-42f1bc9a0dd9"],
 " \[LongDash] ",
 "whether every index ranges over the same length"
}], "Text",ExpressionUUID->"d095f03b-9e12-834e-a9d4-ead72c72c8c4"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayObjectQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "612673a1-33b6-5f42-b22f-58ff3281d6fe"],
 " \[LongDash] ",
 "test for a valid array object"
}], "Text",ExpressionUUID->"b26cad26-9224-4f4e-83e7-36ec4264e40b"],

Cell[TextData[{
 "Dimensions and Normal work directly on an array object, and further \
properties are read as ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"arr", "[", "\"\<prop\>\"", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"373d8754-3965-8645-9b60-6bbee4665386"],
 "."
}], "Text",ExpressionUUID->"e762d601-5c47-eb4d-b664-4b7715f75217"],

Cell["Special arrays", "Section",ExpressionUUID->"33df3d37-3df7-144f-86c0-857f7c06acb1"],

Cell["\<\
Constant arrays and the generalized Kronecker deltas, in any order, dimension \
and value domain. Each declares the strongest symmetry that actually holds of \
it.\
\>", "Text",ExpressionUUID->"2e7e1b7d-64dc-7c42-8d71-a27f5358ef42"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ZeroArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "8b56e354-e981-1241-b952-ecebc45ad340"],
 " \[LongDash] ",
 "every entry zero"
}], "Text",ExpressionUUID->"89c29d80-1db3-c647-a128-665611bda9ae"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["OneArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "3b78356e-034c-d84c-ab6c-4c1bf26b348c"],
 " \[LongDash] ",
 "every entry one"
}], "Text",ExpressionUUID->"bfa54340-c913-7f4e-b799-0eb3ec5979ff"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["IdentityArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "fa52ab3d-254a-8648-8ba2-e95aaa331576"],
 " \[LongDash] ",
 "one where all the indices agree, zero elsewhere"
}], "Text",ExpressionUUID->"0d947203-8a5e-aa4c-b8dc-bcebe9c4e20f"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["PartialIdentityArray", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"d7fbb77d-7115-8743-8ad2-7474e8c8c149"],
 " \[LongDash] ",
 "one where the indices at chosen positions agree"
}], "Text",ExpressionUUID->"5e55c566-60f8-f442-86ea-e18b7f08f0bc"],

Cell["Contraction", "Section",ExpressionUUID->"a5c90eca-4f8e-7241-911e-97c1ddd4f14c"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayMultiply", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "c1e88d4c-5572-754f-ad44-a06b065b9aaa"],
 " \[LongDash] ",
 "contract arrays by an index specification, in the manner of Einstein \
summation"
}], "Text",ExpressionUUID->"cf8490d7-4921-ea46-afdb-e01c074c8685"],

Cell["\<\
The specification is written either as a string, \"ij,jk->ik\", or as a rule \
between lists of index labels. An index may occur in any number of the arrays \
and in the output as well, so diagonals and three-way contractions are \
expressible, not only pairwise ones. A 0-array is named by an empty group of \
labels, and contracting every index away gives one back.\
\>", "Text",ExpressionUUID->"f78dd0c3-0327-5c41-aca2-d2cf660452f1"],

Cell["Drawing arrays", "Section",ExpressionUUID->"c6df34be-774e-474b-9204-5d4cb621ead7"],

Cell["\<\
There are two families, and an array of any order may be drawn in either. The \
flat family gives plane pictures throughout: a row of cells at order one, a \
grid at order two, and above that a nesting of those, a grid whose cells hold \
grids. The spatial family gives cubes arranged in space throughout: a line of \
cubes, a plane of them, a lattice, and above that the same lattices tiled \
through space, block beside block, all in one picture.\
\>", "Text",ExpressionUUID->"c3e4d7e6-8e0b-de41-880a-77152806dd36"],

Cell[TextData[{
 "Which indices go outside and which inside is a choice rather than a fact \
about the array, and ",
 Cell[BoxData[
  StyleBox["\"\<Nesting\>\"", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "2012a9b1-fe89-cf4b-be38-b11f3c13eec6"],
 " makes it. A flat picture holds one or two indices at a time and a spatial \
one holds three, so that is the only difference between the two defaults."
}], "Text",ExpressionUUID->"c01d3eaf-bb08-ff4b-910f-9270b1ba4043"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayGraphics", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "a7a0a0d1-a74b-b741-94b2-631c37163317"],
 " \[LongDash] ",
 "draw an array of any order in the plane"
}], "Text",ExpressionUUID->"2e12afde-02dc-b948-bf1b-2126034b83e1"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayGraphics3D", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "da8bd46e-170a-264f-a445-5ab6dd3c0095"],
 " \[LongDash] ",
 "draw an array of any order as cubes in space"
}], "Text",ExpressionUUID->"af1a93f0-b315-1145-a41d-ad7acabec11c"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayNesting", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "1dd27c19-f42d-0a45-a316-1f37c75916fc"],
 " \[LongDash] ",
 "how the indices are split by default, for either family"
}], "Text",ExpressionUUID->"bcf1ac2c-1232-9441-bfbb-211abf478186"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["HypermatrixGraphics", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"5d49d2fd-ac0e-e64c-b9a9-6a67e8614794"],
 " \[LongDash] ",
 "draw every array of a hypermatrix, in the plane"
}], "Text",ExpressionUUID->"7434514c-35dc-8a41-b417-8e027d113863"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["HypermatrixGraphics3D", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"1e124738-7f08-e64d-a86c-7bce7a99c370"],
 " \[LongDash] ",
 "the same, as cubes in space"
}], "Text",ExpressionUUID->"e682ae66-f9e3-fc4b-8b9a-d230eab96a2f"],

Cell["Adding and multiplying entry by entry", "Section",ExpressionUUID->"f6da5b0d-f291-1f4f-9828-beb244b72c54"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayAdd", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "46b2a2ab-d722-c94f-b213-a4638af5c5a2"],
 " \[LongDash] ",
 "add arrays entry by entry"
}], "Text",ExpressionUUID->"7dd331a9-a113-574f-a47f-413e186ed176"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayTimes", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "39c66eaf-0fc9-a646-937d-e04d814d1aa6"],
 " \[LongDash] ",
 "multiply arrays entry by entry"
}], "Text",ExpressionUUID->"320eb0c1-0bd2-7d4a-829f-27903e60b83c"],

Cell[TextData[{
 "These are the multilinear structure of arrays, as against the contraction \
ArrayMultiply. Arrays of the same dimensions combine entry by entry, and a \
0-array, having no shape of its own, reaches every entry \[LongDash] which is \
why scalar multiplication needs no name of its own. ",
 Cell[BoxData[
  StyleBox["Plus", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "51478a52-2ed6-844b-b4ef-4626b011a5ba"],
 " and ",
 Cell[BoxData[
  StyleBox["Times", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "f4ffdf3d-72a8-0f4d-a819-6607f79e93e0"],
 " on array objects are the same operations, so ",
 Cell[BoxData[
  StyleBox[
   RowBox[{
    RowBox[{"2", " ", "a"}], " ", "+", " ", "b"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"0fb859a4-90f6-404a-a512-4d0100aa53bf"],
 " means what it looks like."
}], "Text",ExpressionUUID->"208c8c67-a0cb-1f46-9203-0e5692c1d0d7"],

Cell["Equational identities", "Section",ExpressionUUID->"b21307de-a78b-6746-a79f-509244885bae"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["FindArrayEquations", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"f8b9a15a-bc47-3840-bc53-4d532b94bcf5"],
 " \[LongDash] ",
 "search for equations between all nestings of given operations over given \
arguments"
}], "Text",ExpressionUUID->"70c750a4-6b4c-e546-8b89-eaad6766adc8"],

Cell["\<\
The search screens candidates on random numerical arrays first, which is \
fast, and verifies only the survivors on symbolic arrays. Matrix \
multiplication on three arguments returns associativity; the Fish product on \
five returns a twisted ternary associativity; the Bhattacharya-Mesner product \
on five returns nothing. An operation of arity one may be nested, so that the \
involutivity of a transpose is within reach, and an equation that follows \
from the others is not reported.\
\>", "Text",ExpressionUUID->"7a59ef1d-7669-f24f-94d5-f4dd14be4db2"],

Cell["From hypergraphs to hypermatrices", "Section",ExpressionUUID->"6ed171b2-882b-b448-8e97-a66d07422ced"],

Cell[TextData[{
 "The two halves of the package meet here. An edge has an arity and a \
symmetry type; an array has an order and a symmetry; and the two vocabularies \
line up one for one \[LongDash] ",
 Cell[BoxData[
  StyleBox["\"\<Directed\>\"", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "c0d101a3-b056-7448-adae-6bbf8f4912f5"],
 " with ",
 Cell[BoxData[
  StyleBox["\"\<Rigid\>\"", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "c313c9c3-8b5f-8744-9569-4d7b42665ee3"],
 ", ",
 Cell[BoxData[
  StyleBox["\"\<Cyclic\>\"", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "f05b34c1-e07b-884b-ab83-cd46f77fa393"],
 " with ",
 Cell[BoxData[
  StyleBox["\"\<Cyclic\>\"", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "fdbae7c3-505b-7148-a913-970b2a129a42"],
 ", ",
 Cell[BoxData[
  StyleBox["\"\<Unordered\>\"", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"fc9960c6-6240-4848-8df0-f96d0d4846e9"],
 " with ",
 Cell[BoxData[
  StyleBox["\"\<Symmetric\>\"", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"1313f051-8096-0e4a-8cb5-72855a517b03"],
 ". An array holds one symmetry and one order, so the edges are gathered by \
arity and symmetry type together and each group becomes one array."
}], "Text",ExpressionUUID->"bf108f2c-9ad2-554b-b00e-f67914094580"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["AdjacencyHypermatrix", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"141f04a0-68d9-e74e-b834-8524364c8c94"],
 " \[LongDash] ",
 "the adjacency hypermatrix of a hypergraph"
}], "Text",ExpressionUUID->"6d4c049e-dcdb-5b4a-a24f-6b10d2882b5c"],

Cell[TextData[{
 "Identical copies of an edge share an entry, so a repeated edge comes out as \
an integer multiple. With ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"\"\<Labeled\>\"", " ", "->", " ", "True"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"ee752dba-4e96-b449-8561-af2d44959e4e"],
 " the entries are the edge labels themselves rather than counts, which needs \
the hypergraph to be simple \[LongDash] one entry cannot hold two labels."
}], "Text",ExpressionUUID->"8e99a4e4-7c30-914c-a50e-a5d83b1c5eef"],

Cell["\<\
The entry at an index tuple counts the edges sitting on it, and every tuple \
of an orbit reads the same count, which is what makes each array carry its \
symmetry by construction. Nothing is lost in the passage: the canonical \
entries name exactly the edges that went in.\
\>", "Text",ExpressionUUID->"7d6be55d-3d05-7145-bafb-d9e5af669822"],

Cell[TextData[{
 "The vertices are a set, so numbering the indices is a choice; the \
Hypergraph constructor makes it by storing its vertices sorted. That is \
deterministic but not invariant \[LongDash] renaming the vertices can permute \
the indices \[LongDash] so for an invariant of the isomorphism class, compose \
with ",
 Cell[BoxData[
  StyleBox["CanonicalHypergraph", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"f82bf6fa-14e4-2843-88b3-8c9af6277876"],
 "."
}], "Text",ExpressionUUID->"6dd395af-a0f5-4749-8c37-ff97f62164bb"],

Cell["Hypermatrices", "Section",ExpressionUUID->"380dfa25-adc4-294b-8996-db05d83bbe8f"],

Cell["\<\
A hypermatrix is a list of arrays held in canonical order: lowest order \
first, then the shorter dimensions, then symmetry taking symmetric before \
cyclic before rigid. Giving the same arrays in a different order produces the \
identical expression.\
\>", "Text",ExpressionUUID->"7943a7a2-e2aa-b141-a0e1-d5887e3c95a3"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["Hypermatrix", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "716bf23f-11b3-854c-ae6e-24a8ba074f0e"],
 " \[LongDash] ",
 "a canonically ordered list of arrays"
}], "Text",ExpressionUUID->"625f07b7-c2cc-1e4b-a9e2-f955fcd101df"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["HypermatrixArrays", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"0853772e-e021-dd4d-b9f3-349fdce595ac"],
 " \[LongDash] ",
 "the arrays, in canonical order"
}], "Text",ExpressionUUID->"d784f82d-072a-a74a-af2c-cc6e7dd28c1b"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["HypermatrixQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "87bb07e1-a790-9a4a-ba28-f89d0b76d277"],
 " \[LongDash] ",
 "test for a valid hypermatrix object"
}], "Text",ExpressionUUID->"a6876867-d965-8d48-8d1e-b74141c65c6e"],

Cell["Messages", "Section",ExpressionUUID->"087a9d3b-c388-624a-a6b9-cdbdbc7c1596"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Edge", "::", "sym"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"57c6dc51-d68d-8f41-8e3a-329e809cd15d"],
 " \[LongDash] ",
 "the given edge symmetry type is not one of the three recognized ones"
}], "Text",ExpressionUUID->"583b4998-4336-0f44-93c0-0a178d2d951e"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Edge", "::", "spec"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"46ddc657-7251-a14b-933e-3bbfbc6b98ea"],
 " \[LongDash] ",
 "the expression is not a valid hyperedge specification"
}], "Text",ExpressionUUID->"9f70a0a3-b7a8-ec4e-b3fd-cc4e8519c6a1"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Hypergraph", "::", "spec"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"31582197-7be3-524c-ade4-32396ac24bb9"],
 " \[LongDash] ",
 "the expression is not a valid hypergraph specification"
}], "Text",ExpressionUUID->"0ad88e4e-7440-c744-b4ff-0edd4b025fe1"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Hypergraph", "::", "vlbl"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"04bf4e83-c301-6a45-8f1b-565447b96ca8"],
