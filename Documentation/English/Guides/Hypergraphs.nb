Notebook[{
Cell["Hypergraphs", "Title",ExpressionUUID->"21bd6ac0-e842-544b-aa63-643e60698d37"],

Cell["\<\
WolframInstitute`Hypergraphs` \[LongDash] guide to the implemented functions\
\>", "Subtitle",ExpressionUUID->"9173b8d1-2424-bf4c-bfbb-b3bba0eddc16"],

Cell["\<\
Hypergraphs as multisets of hyperedges, with independently labelled vertices \
and edges, a symmetry type on every edge, a default graphical display, and \
isomorphism testing that takes labels into account up to renaming.\
\>", "Text",ExpressionUUID->"ca2c488b-ec75-7a4e-8237-98dc0d2a95ad"],

Cell["Loading the package", "Section",ExpressionUUID->"850d4843-6123-7647-ba6b-8184d2bd6b46"],

Cell[TextData[{
 "The whole package is loaded by a single ",
 Cell[BoxData[
  StyleBox["Get", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "8c2f88b9-a67d-8a48-a7c5-b81fc21d4c06"],
 " of the core file, which pulls in the plotting code itself:"
}], "Text",ExpressionUUID->"bde37b7d-a41a-3c4b-9550-de94ae7a8c56"],

Cell["Get[FileNameJoin[{\"<project>\", \"src\", \"Hypergraph.wl\"}]]", "Input",ExpressionUUID->"03e70f50-2df3-5d41-8ac6-1131f866fd4b"],

Cell[TextData[{
 "Everything lives in the context ",
 Cell[BoxData[
  StyleBox["WolframInstitute`Hypergraphs`", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"8bd3d9c8-35c7-8243-aebc-7afadb1bdc05"],
 ", deliberately distinct from the upstream paclet ",
 Cell[BoxData[
  StyleBox["WolframInstitute`Hypergraph`", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"80588cc5-5e78-354f-b60e-8f1d93e5ad42"],
 " (singular) so that both can be loaded into one kernel."
}], "Text",ExpressionUUID->"714c82bb-0a71-0a4e-ae61-baa66b914c65"],

Cell["Where the code lives", "Section",ExpressionUUID->"d225faed-8df6-3c4c-abfa-1e75ad7623ba"],

Cell["\<\
The package proper is the files in src/. Everything else is documentation, \
tests, or earlier research material that predates the rewrite and is kept \
under reference/ for consultation.\
\>", "Text",ExpressionUUID->"b127bfd0-f04e-f543-8b36-a6fae9a8556c"],

Cell[TextData[{
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 " \[LongDash] ",
 "Vertex, Edge and Hypergraph, their accessors and predicates, \
HypergraphSkeleton, and the canonical form and isomorphism functions. Loads \
the other four files at its end, so this is the only one that has to be read \
in."
}], "Text",ExpressionUUID->"da074c68-6d08-fe42-81b2-a6a9f6736b9c"],

Cell[TextData[{
 StyleBox["src/HypergraphPlot.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 " \[LongDash] ",
 "HypergraphPlot and HypergraphEmbedding, the summary-box thresholds, and the \
MakeBoxes definition that makes a Hypergraph draw itself."
}], "Text",ExpressionUUID->"3d0430fd-7bf3-1140-b106-f415444c87ef"],

Cell[TextData[{
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 " \[LongDash] ",
 "ArrayObject, GenerateSymbolicArray and Hypermatrix, their accessors and \
predicates."
}], "Text",ExpressionUUID->"7a6c7ed2-e8de-2643-8b78-2347d8b605cb"],

Cell[TextData[{
 StyleBox["src/ArrayAlgebra.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 " \[LongDash] ",
 "The special arrays, the contraction ArrayMultiply, the entry-by-entry \
ArrayAdd and ArrayTimes, and FindArrayEquations."
}], "Text",ExpressionUUID->"841d444c-362c-444b-b49f-7ae19893df67"],

Cell[TextData[{
 StyleBox["src/Rewriting.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 " \[LongDash] ",
 "HypergraphRule and its application: the matcher, and the events a rewrite \
produces."
}], "Text",ExpressionUUID->"6c401b87-fd08-174f-97e8-d34881c7f60a"],

Cell[TextData[{
 StyleBox["src/Adjacency.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 " \[LongDash] ",
 "AdjacencyHypermatrix: the correspondence between edge symmetry types and \
array symmetries, and the passage from one to the other."
}], "Text",ExpressionUUID->"fd22dc71-2284-d24c-97c2-73e6faa23372"],

Cell[TextData[{
 StyleBox["src/ArrayGraphics.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 " \[LongDash] ",
 "The two families of pictures: ArrayGraphics and HypermatrixGraphics in the \
plane, ArrayGraphics3D and HypermatrixGraphics3D in space, with ArrayNesting \
deciding how the indices are split between them."
}], "Text",ExpressionUUID->"866e17b7-7cdd-6d4d-85e0-dd7c85cb8dff"],

Cell[TextData[{
 StyleBox["tests/BasicExamples.wls",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 " \[LongDash] ",
 "Every hypergraph example in the documentation as an assertion, plus several \
thousand randomized checks. Run it with wolframscript -file."
}], "Text",ExpressionUUID->"b96247b9-dfc2-ad48-9762-1106dce9255e"],

Cell[TextData[{
 StyleBox["tests/HypermatrixExamples.wls",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 " \[LongDash] ",
 "The same for the array and hypermatrix objects."
}], "Text",ExpressionUUID->"1bc85d04-eb12-814e-bf12-c4e0f6ad7aba"],

Cell[TextData[{
 StyleBox["tests/ArrayAlgebraExamples.wls",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 " \[LongDash] ",
 "The same for the special arrays, ArrayMultiply and FindArrayEquations."
}], "Text",ExpressionUUID->"d84e1df1-fa33-c945-aaaa-9879b02fad35"],

Cell[TextData[{
 StyleBox["notebooks/HypergraphBasics.nb",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 " \[LongDash] ",
 "Worked examples with the reasoning behind each design choice."
}], "Text",ExpressionUUID->"5a4d392d-fcda-c843-975b-670a40473645"],

Cell[TextData[{
 StyleBox["notebooks/HypermatrixBasics.nb",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 " \[LongDash] ",
 "The same for arrays and hypermatrices."
}], "Text",ExpressionUUID->"87cf3820-96c2-2644-895b-04a6f7302897"],

Cell[TextData[{
 StyleBox["Documentation/English/ReferencePages/Symbols/",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 " \[LongDash] ",
 "One reference page per exported symbol."
}], "Text",ExpressionUUID->"26fbcbd0-3a43-c747-a7b9-1139e9a14033"],

Cell[TextData[{
 StyleBox["Documentation/English/Guides/Hypergraphs.nb",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 " \[LongDash] ",
 "This guide."
}], "Text",ExpressionUUID->"fcc19a63-ed71-7440-a63f-1c70ff36b176"],

Cell[TextData[{
 StyleBox["reference/Hypergraph/, reference/Multicomputation/",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 " \[LongDash] ",
 "Read-only clones of the two upstream paclets, WolframInstitute/Hypergraph \
and Wolfram/Multicomputation, kept for comparison."
}], "Text",ExpressionUUID->"65c6b88c-aaa6-6e41-9a4e-956297fc63e1"],

Cell[TextData[{
 StyleBox["reference/PlexAlgebra.wl, reference/Chemoids.wl, \
reference/HypergraphAlgebras.wl, reference/HypergraphMinicourse.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 " \[LongDash] ",
 "Earlier research notebooks exported as packages, from before the rewrite. \
They hold the prototypes this package is growing out of \[LongDash] \
hypermatrix contraction and plex diagrams in PlexAlgebra.wl in particular \
\[LongDash] together with many worked examples of what the two upstream \
paclets could do in combination. Mostly commented out, and not part of the \
package."
}], "Text",ExpressionUUID->"1fbebb32-866d-ad41-81b3-d4fb015993b9"],

Cell[TextData[{
 StyleBox["notebooks/legacy/",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 " \[LongDash] ",
 "The notebooks those exports came from."
}], "Text",ExpressionUUID->"aa63e39f-e70c-4747-9fe8-b9cb317a19ba"],

Cell["\<\
A reference page names the file and the section heading its function is \
defined under, rather than a line number, since line numbers go stale on the \
next edit.\
\>", "Text",ExpressionUUID->"517ff790-d03a-9d45-95c0-99f01783e87b"],

