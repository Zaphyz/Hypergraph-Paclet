  StyleBox["ArrayOrder", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "5b8b5e89-f6a2-3743-ab3f-2ff61d773411"],
 " \[LongDash] ",
 "the number of indices"
}], "Text",ExpressionUUID->"aeceefb5-91c4-1545-9452-453c901c4a63"],

