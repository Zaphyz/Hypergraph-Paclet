Cell[TextData[{
 "The standard graph functions ",
 Cell[BoxData[
  StyleBox["VertexList", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "fbe376d5-408f-bb4e-b16b-6d9cd6240131"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeList", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "70f441fc-49d7-9749-8021-febb647e3280"],
 ", ",
 Cell[BoxData[
  StyleBox["VertexCount", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "d1ac0085-831d-d74a-bb3b-449ef8397065"],
 " and ",
 Cell[BoxData[
  StyleBox["EdgeCount", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "fe10af0b-0c00-a248-8d02-614826e18eda"],
 " work directly on a Hypergraph, added as UpValues rather than redefined. \
Further properties are read as ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"hg", "[", "\"\<prop\>\"", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"98f13c12-d432-eb48-9ade-d65545735738"],
 ", and ",
 Cell[BoxData[
  StyleBox[
