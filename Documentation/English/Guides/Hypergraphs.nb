Cell[TextData[{
 Cell[BoxData[
  StyleBox["RegularArrayQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "69cdd0c3-d55d-5b44-88fc-5914508fd1f1"],
 " \[LongDash] ",
