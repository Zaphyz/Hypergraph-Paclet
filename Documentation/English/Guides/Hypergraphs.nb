  "939ca0be-9af2-6443-b097-88c3fbdb97a2"],
 " and ",
 Cell[BoxData[
  StyleBox["EdgeCount", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "f6fa9efd-5d54-754a-9932-792571f86bd0"],
 " work directly on a Hypergraph, added as UpValues rather than redefined. \
Further properties are read as ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"hg", "[", "\"\<prop\>\"", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"16baa389-8765-454c-9d60-cb8da5e19e7d"],
 ", and ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"hg", "[", "\"\<Properties\>\"", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"84af5393-cd41-df40-9768-523fee075aae"],
 " lists them."
}], "Text",ExpressionUUID->"91c3abb2-b9d3-7340-88d8-db52b918681a"],

Cell["Canonical form and isomorphism", "Section",ExpressionUUID->"9523722b-5d8f-ea4a-9139-e670c48acca9"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["CanonicalHypergraph", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"85b65d00-a49a-3d4a-9d99-3a206e3713bb"],
 " \[LongDash] ",
 "a canonical representative of the isomorphism class"
}], "Text",ExpressionUUID->"d2508fef-74e4-ea41-81db-1c45d0560464"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["IsomorphicHypergraphQ", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"becde9a4-c460-dd44-9f0e-906ca35761f1"],
 " \[LongDash] ",
 "test two hypergraphs for isomorphism, with or without labels"
}], "Text",ExpressionUUID->"1d907070-a511-c143-b287-cee4f09740f5"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["FindHypergraphIsomorphism", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"1a9f1d62-1603-0741-b5cd-cf63a85d23c5"],
 " \[LongDash] ",
 "the vertex renaming, and optionally the label correspondences"
}], "Text",ExpressionUUID->"1533348f-ae28-9443-aeb0-473e1e1d26c3"],

Cell["\<\
Labelled isomorphism matches labels up to a one-to-one correspondence rather \
than identically, with vertex labels and edge labels corresponded \
independently. The option \"Labeled\" -> False compares the skeletons instead.\
\>", "Text",ExpressionUUID->"bcc904cc-d4cd-334c-9d28-93adbee7a847"],

