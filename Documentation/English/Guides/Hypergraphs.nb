}], "Text",ExpressionUUID->"f0288b1c-7ad9-fb45-baec-41b43532a5a8"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayObject", "::", "irreg"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"18951d67-0fc0-984e-9b26-e6d2f2d22ef0"],
 " \[LongDash] ",
 "an irregular array cannot carry a symmetry"
}], "Text",ExpressionUUID->"930eb249-eb24-5e4c-8c93-cb0ce8731f77"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayObject", "::", "data"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"74726db8-08ff-4446-bcde-3eab96531f27"],
