 " \[LongDash] ",
 "\"UnaryDepth\" is not a non-negative integer"
}], "Text",ExpressionUUID->"fe6a8e18-6b72-be44-8320-71650b5f63ac"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayMultiply", "::", "mixed"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"9c676b30-fa73-e443-bd55-61d2e768d624"],
 " \[LongDash] ",
