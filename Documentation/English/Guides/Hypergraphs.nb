Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayTimes", "::", "dims"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"2692f418-27bf-6542-ba3b-c10eeafcd233"],
 " \[LongDash] ",
 "the same, for multiplication entry by entry"
}], "Text",ExpressionUUID->"732515f7-886b-fd44-ac5b-22b3a9ca4f2d"],

Cell["Not yet implemented", "Section",ExpressionUUID->"c0f91f07-4f96-f744-9e6a-1231626e2b8f"],

Cell["\<\
The array and hypermatrix objects are in place, with contraction, the \
entry-by-entry operations, and the search for equational identities. The \
graphical rendering of 1-, 2- and 3-arrays is the next step. After that come \
rewriting rules, the causal machinery, and plex diagrams.\
\>", "Text",ExpressionUUID->"368b1238-4912-dc4a-b86f-27b7ebba9aef"]
},
