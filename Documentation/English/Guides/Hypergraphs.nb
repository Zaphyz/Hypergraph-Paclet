  "InlineFormula",ExpressionUUID->"ffc1ae96-e695-db4a-a74b-88bc8ec29bfa"],
 " lists them."
}], "Text",ExpressionUUID->"7a33ed79-730c-fe45-9898-81b4b8d21f6f"],

