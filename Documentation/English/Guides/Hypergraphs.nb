  "InlineFormula",ExpressionUUID->"33992629-86e8-3844-ae05-9a44576ae6b5"],
 " lists them."
}], "Text",ExpressionUUID->"d8bd87d4-8159-4749-8b6f-b0bc6cd65c5e"],

