Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"SymbolicArray", "::", "name"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"6543b746-aba8-6e46-baf7-cfd93532fe6b"],
 " \[LongDash] ",
 "an array name must be a symbol or a string"
}], "Text",ExpressionUUID->"21541078-ba8b-db44-aea4-1949073179f4"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Hypermatrix", "::", "arrays"}], "InlineCode"]], "InlineFormula",
