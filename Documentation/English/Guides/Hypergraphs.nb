 Cell[BoxData[
  StyleBox["VertexList", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "c6b889d5-5d40-0547-967a-f307a82f2ea0"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeList", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "3524a9d7-42d2-504e-b93c-64ba13e22c7e"],
 ", ",
 Cell[BoxData[
  StyleBox["VertexCount", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "b39dc27e-abb2-2343-8c65-cdd19d7dde76"],
 " and ",
 Cell[BoxData[
  StyleBox["EdgeCount", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "af71a5ba-279f-2347-b3c0-1b961fb8ff85"],
 " work directly on a Hypergraph, added as UpValues rather than redefined. \
Further properties are read as ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"hg", "[", "\"\<prop\>\"", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"46e90d79-b96f-8d44-a18b-f2459c85a484"],
 ", and ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"hg", "[", "\"\<Properties\>\"", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"5da5c778-5a64-9940-ae75-57cd1e0e8cc4"],
 " lists them."
}], "Text",ExpressionUUID->"9295ee7c-4e34-e94c-b221-609eb6a09b01"],

Cell["Canonical form and isomorphism", "Section",ExpressionUUID->"e5d814d6-a568-8a45-a005-51ace203bbc3"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["CanonicalHypergraph", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"e44ffbcc-04e1-8d42-b1b0-d6fa655a6c07"],
 " \[LongDash] ",
 "a canonical representative of the isomorphism class"
}], "Text",ExpressionUUID->"9706e1bd-0009-b041-8380-c5db91151377"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["IsomorphicHypergraphQ", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"af9f3b8c-fb03-8943-921f-9e506b85ee3e"],
 " \[LongDash] ",
 "test two hypergraphs for isomorphism, with or without labels"
}], "Text",ExpressionUUID->"ac54522c-23b8-df40-9ca4-b553b671f654"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["FindHypergraphIsomorphism", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"4e2a8ded-b665-e148-9249-afe451b6f905"],
 " \[LongDash] ",
 "the vertex renaming, and optionally the label correspondences"
}], "Text",ExpressionUUID->"39c22ab1-a8fb-7b4d-a492-7de06d0e2352"],

Cell["\<\
Labelled isomorphism matches labels up to a one-to-one correspondence rather \
than identically, with vertex labels and edge labels corresponded \
independently. The option \"Labeled\" -> False compares the skeletons instead.\
\>", "Text",ExpressionUUID->"b0a21c6e-5304-a04a-9069-f0c088f08180"],

Cell["Drawing", "Section",ExpressionUUID->"8645e2bd-84b4-444a-ae06-05a3f1eaffbd"],

