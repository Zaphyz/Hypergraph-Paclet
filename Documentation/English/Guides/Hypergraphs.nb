}], "Text",ExpressionUUID->"ff10f2c4-c688-3741-a814-609c32218227"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"CanonicalHypergraph", "::", "large"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"9621eab8-8c62-0049-8222-cd2ae723e325"],
 " \[LongDash] ",
