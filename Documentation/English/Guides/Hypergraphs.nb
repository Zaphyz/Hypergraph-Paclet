}], "Text",ExpressionUUID->"e492aeb7-209f-fd45-b181-632dd7cf7d8d"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["SetHypergraphPlotThresholds", "InlineCode"]], "InlineFormula",
