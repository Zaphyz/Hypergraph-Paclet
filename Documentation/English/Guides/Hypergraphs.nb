Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"GenerateSymbolicArray", "::", "name"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"ef6fbfcb-2d4c-ff42-a9c7-1526fcdb0f02"],
 " \[LongDash] ",
 "an array name must be a symbol or a string"
}], "Text",ExpressionUUID->"e06f1793-e794-e34c-9ebd-5324e71fab9b"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Hypermatrix", "::", "arrays"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"62242e75-abbe-5943-b06b-ab6e67b6c3af"],
