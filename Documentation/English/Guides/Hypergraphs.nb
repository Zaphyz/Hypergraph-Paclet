}], "Text",ExpressionUUID->"d0ebc41c-33ea-2c45-b2bd-bc4a47500f3c"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"NumericalArray", "::", "data"}], "InlineCode"]], "InlineFormula",
