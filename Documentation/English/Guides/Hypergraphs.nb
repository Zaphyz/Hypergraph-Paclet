  "36e3efc9-c35f-594e-951b-dc10368d3aff"],
 " \[LongDash] ",
 "draw a hypergraph"
}], "Text",ExpressionUUID->"1367d55a-07fc-124a-be3f-d6ba9514ccf3"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["HypergraphEmbedding", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"ea70ebad-9c07-ba4a-90d4-101abf66d57f"],
 " \[LongDash] ",
