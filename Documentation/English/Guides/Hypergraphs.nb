 "an output index does not occur among the inputs"
}], "Text",ExpressionUUID->"68a24680-b6d0-0247-a535-65325c9b891c"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"FindArrayEquations", "::", "arity"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"e6126332-e78d-d844-92d3-311982c91fa3"],
 " \[LongDash] ",
 "the arity of an operation could not be determined"
}], "Text",ExpressionUUID->"2a06389d-eecc-5e45-a6a6-ad90d8684b66"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"FindArrayEquations", "::", "eval"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"d0d84675-ac79-dd45-9512-5cb7d7754d20"],
 " \[LongDash] ",
 "no nesting evaluated on arrays of the shape used"
}], "Text",ExpressionUUID->"a9c7c43e-a66c-d34f-a6bb-26d110070bc1"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"FindArrayEquations", "::", "shape"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"011c703f-87be-9243-876b-14d06fe29ce6"],
 " \[LongDash] ",
 "no order from 1 to 5 suits every operation"
}], "Text",ExpressionUUID->"1e91d861-1327-804f-9013-7477e513a2f2"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"FindArrayEquations", "::", "depth"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"5dae67aa-1a77-9746-8ef9-1abfaecb3b8c"],
 " \[LongDash] ",
 "\"UnaryDepth\" is not a non-negative integer"
}], "Text",ExpressionUUID->"ab0e8cae-9826-d74b-b952-7db0753ec974"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayAdd", "::", "dims"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"c105089f-d4a1-5247-8d3a-98cb4ab5ce69"],
 " \[LongDash] ",
 "the arrays are not of the same dimensions"
}], "Text",ExpressionUUID->"4e17b929-4213-7848-b9a4-2bc1ee833f0a"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayTimes", "::", "dims"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"9364e78b-7926-334f-a6aa-f8c7f4093dd5"],
 " \[LongDash] ",
 "the same, for multiplication entry by entry"
}], "Text",ExpressionUUID->"b668be60-0f48-9240-90c0-cbe1d13ee9cb"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayGraphics", "::", "nesting"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"2a2855b6-7917-1341-a559-180f488a3ac9"],
 " \[LongDash] ",
 "the given nesting does not account for every index"
}], "Text",ExpressionUUID->"2dc90ece-9fc2-8d4c-a8b5-5def2abc04b3"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayGraphics", "::", "block"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"5f2eff53-21aa-7f47-adf5-52f8d7a422d3"],
 " \[LongDash] ",
 "a block of more than two indices has no flat picture"
}], "Text",ExpressionUUID->"986f5a9b-3be2-6a49-ba9f-cfaa8ee9fbb6"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayGraphics3D", "::", "block"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"13e966c6-b472-7d4a-81ff-9c74d7daf50d"],
 " \[LongDash] ",
 "a block of more than three indices has nowhere to go in space"
}], "Text",ExpressionUUID->"09a2a22f-c3af-8548-afae-5fc6ca19c2ed"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"AdjacencyHypermatrix", "::", "hg"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"c0d27b12-d5b4-6246-9cb1-a08469ce241c"],
 " \[LongDash] ",
 "the argument is not a hypergraph"
}], "Text",ExpressionUUID->"2487858a-f67a-884a-85ce-7c8880c0bc2d"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"AdjacencyHypermatrix", "::", "nonsimple"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"4d9230ab-5bd0-6844-9ffa-427ba0778f33"],
 " \[LongDash] ",
 "labels cannot be entries unless no edge is repeated"
}], "Text",ExpressionUUID->"a084370e-93c3-b94e-917d-f1b76db4ebc0"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayGraphics", "::", "big"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"62f32774-de28-da4f-8897-b3c638dacc34"],
 " \[LongDash] ",
 "the array has too many entries to be drawn legibly"
}], "Text",ExpressionUUID->"61dacf01-7d45-8645-bf53-94bd55743083"],

Cell["Not yet implemented", "Section",ExpressionUUID->"da9cb2a6-413b-6a41-9543-c06a8a4d317f"],

Cell["\<\
The hypergraph and array halves are both in place, and the passage from a \
hypergraph to its adjacency hypermatrix now joins them. What remains is the \
passage back, and then the rewriting itself \[LongDash] rules, their \
application, the generations of states and the causal graph \[LongDash] and \
after that the plex diagrams that tie rewriting to hypermatrix algebra. A \
visual editor, for hypergraphs and for rules, is still to come.\
\>", "Text",ExpressionUUID->"a4a03751-c1d3-764b-9430-5f04b9a58916"]
},
WindowSize->{820, 750},
FrontEndVersion->"15.0 for Microsoft Windows (64-bit) (July 2, 2026)",
StyleDefinitions->"Default.nb",
ExpressionUUID->"d8aa7511-5182-ac4c-bf73-0bac3a5635f3"
]
