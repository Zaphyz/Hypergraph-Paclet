Cell["Canonical form and isomorphism", "Section",ExpressionUUID->"1a03afde-9bae-4647-a3c0-54b324ea0d5f"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["CanonicalHypergraph", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"7cf61091-223d-e743-a8a5-c6db107e3975"],
 " \[LongDash] ",
 "a canonical representative of the isomorphism class"
}], "Text",ExpressionUUID->"9900654b-4400-b444-a964-14d6432f777f"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["IsomorphicHypergraphQ", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"b96506a5-7c84-304f-be64-a170f898b0e5"],
 " \[LongDash] ",
 "test two hypergraphs for isomorphism, with or without labels"
}], "Text",ExpressionUUID->"9ed4ef9f-b474-1b4f-bdad-e6e25df90760"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["FindHypergraphIsomorphism", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"5ee98051-88ad-f34d-954c-2066bbba025d"],
 " \[LongDash] ",
 "the vertex renaming, and optionally the label correspondences"
}], "Text",ExpressionUUID->"a4b8eb63-c6db-5142-8890-fff3ad3f503c"],

Cell["\<\
Labelled isomorphism matches labels up to a one-to-one correspondence rather \
than identically, with vertex labels and edge labels corresponded \
independently. The option \"Labeled\" -> False compares the skeletons instead.\
\>", "Text",ExpressionUUID->"f7f516cf-20a3-0b4b-aced-346bbe0314a8"],

Cell["Drawing", "Section",ExpressionUUID->"d57b0910-f1ea-e14c-a96a-30d5a387fe23"],

