Cell["Canonical form and isomorphism", "Section",ExpressionUUID->"e0873c6c-3e92-234a-a2fa-c899261905f3"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["CanonicalHypergraph", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"e5882a16-ff9f-8744-ae13-a50add77370d"],
 " \[LongDash] ",
 "a canonical representative of the isomorphism class"
}], "Text",ExpressionUUID->"16e11dec-bd3e-5c4a-9571-9116abcdaff3"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["IsomorphicHypergraphQ", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"e389419e-3cc4-b344-909e-37ed2b5c1e9e"],
 " \[LongDash] ",
 "test two hypergraphs for isomorphism, with or without labels"
}], "Text",ExpressionUUID->"6a3afcd1-7186-6b4e-ba23-75d81b015653"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["FindHypergraphIsomorphism", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"87e8f64d-f4b7-8f43-ae2f-683d7ff0aa46"],
 " \[LongDash] ",
 "the vertex renaming, and optionally the label correspondences"
}], "Text",ExpressionUUID->"7c08d32a-0a88-c546-8a57-da6fdd5585bd"],

Cell["\<\
Labelled isomorphism matches labels up to a one-to-one correspondence rather \
than identically, with vertex labels and edge labels corresponded \
independently. The option \"Labeled\" -> False compares the skeletons instead.\
\>", "Text",ExpressionUUID->"7b7179b0-aae7-a94d-85a1-eae5102299b1"],

