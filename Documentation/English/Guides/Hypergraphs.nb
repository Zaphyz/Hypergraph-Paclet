}], "Text",ExpressionUUID->"58dd2240-dfb8-fd40-9f11-7640705769ae"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["HypergraphLargeQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "7d74dd81-2407-7a47-890a-ce16d9a56642"],
 " \[LongDash] ",
