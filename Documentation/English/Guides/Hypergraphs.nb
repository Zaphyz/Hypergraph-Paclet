Notebook[{
Cell["Hypergraphs", "Title",ExpressionUUID->"1976faf3-5b8a-1e4d-ad83-5a229d986bf6"],

Cell["\<\
WolframInstitute`Hypergraphs` \[LongDash] guide to the implemented functions\
\>", "Subtitle",ExpressionUUID->"298aa259-48c0-8145-9a6a-6d2e56c53c2d"],

Cell["\<\
Hypergraphs as multisets of hyperedges, with independently labelled vertices \
and edges, a symmetry type on every edge, a default graphical display, and \
isomorphism testing that takes labels into account up to renaming.\
\>", "Text",ExpressionUUID->"5441922a-f678-a144-bbef-439eb7ee8905"],

Cell["Loading the package", "Section",ExpressionUUID->"15804840-702b-7843-8219-995ff81b9bfe"],

Cell[TextData[{
 "The whole package is loaded by a single ",
 Cell[BoxData[
  StyleBox["Get", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "087301e1-5fef-884a-b891-c68e9bf3e9cc"],
 " of the core file, which pulls in the plotting code itself:"
}], "Text",ExpressionUUID->"a5798d3f-07b9-1a4f-a2f1-ea4e258a539e"],

Cell["Get[FileNameJoin[{\"<project>\", \"src\", \"Hypergraph.wl\"}]]", "Input",ExpressionUUID->"c9aa25db-24ea-ca47-b0b5-2de0c7ceeeda"],

Cell[TextData[{
 "Everything lives in the context ",
 Cell[BoxData[
  StyleBox["WolframInstitute`Hypergraphs`", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"9d98d81b-7ef5-3f44-bc19-ebe6a2253ee4"],
 ", deliberately distinct from the upstream paclet ",
 Cell[BoxData[
  StyleBox["WolframInstitute`Hypergraph`", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"96fcd1be-3afd-3c42-903b-59e7be44e9f5"],
 " (singular) so that both can be loaded into one kernel."
}], "Text",ExpressionUUID->"a984ce3f-03e9-974c-aad5-6ec75225aa6e"],

Cell["Where the code lives", "Section",ExpressionUUID->"5e24e2ca-f88d-c741-8756-17bab2454c99"],

Cell["\<\
The package proper is the files in src/. Everything else is documentation, \
tests, or earlier research material that predates the rewrite and is kept \
under reference/ for consultation.\
\>", "Text",ExpressionUUID->"01fd575a-8f35-4243-918e-43e927321fef"],

Cell[TextData[{
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 " \[LongDash] ",
 "Vertex, Edge and Hypergraph, their accessors and predicates, \
HypergraphSkeleton, and the canonical form and isomorphism functions. Loads \
the other four files at its end, so this is the only one that has to be read \
in."
}], "Text",ExpressionUUID->"c9728fa3-8e9c-d545-91dd-b7a8b378937e"],

Cell[TextData[{
 StyleBox["src/HypergraphPlot.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 " \[LongDash] ",
 "HypergraphPlot and HypergraphEmbedding, the summary-box thresholds, and the \
MakeBoxes definition that makes a Hypergraph draw itself."
}], "Text",ExpressionUUID->"f3f65814-91aa-b447-8b7f-ab2a939e2075"],

Cell[TextData[{
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 " \[LongDash] ",
 "ArrayObject, GenerateSymbolicArray and Hypermatrix, their accessors and \
predicates."
}], "Text",ExpressionUUID->"be3d6b63-43ac-5344-8b71-65f8911970a5"],

Cell[TextData[{
 StyleBox["src/ArrayAlgebra.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 " \[LongDash] ",
 "The special arrays, the contraction ArrayMultiply, the entry-by-entry \
ArrayAdd and ArrayTimes, and FindArrayEquations."
}], "Text",ExpressionUUID->"aad33418-a9cb-574e-9d6e-a1f117264c16"],

Cell[TextData[{
 StyleBox["src/Rewriting.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 " \[LongDash] ",
 "HypergraphRule and its application: the matcher, and the events a rewrite \
produces."
}], "Text",ExpressionUUID->"bd28f5d5-0745-3548-9b53-8d4bedd2c54b"],

Cell[TextData[{
 StyleBox["src/RewritingGraphics.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 " \[LongDash] ",
 "HypergraphRulePlot and HypergraphEventPlot: a rule and an event as \
pictures, with the match and the creations highlighted."
}], "Text",ExpressionUUID->"6043921e-25fc-5346-839d-81f0e7950910"],

Cell[TextData[{
 StyleBox["src/Causality.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 " \[LongDash] ",
 "HypergraphRewritingSystem: the evolution, the tokens that follow an element \
across a rewrite, and the readings of causal dependence."
}], "Text",ExpressionUUID->"e203fa55-29c9-2a43-adb4-512e5c6db6ec"],

Cell[TextData[{
 StyleBox["src/Adjacency.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 " \[LongDash] ",
 "AdjacencyHypermatrix: the correspondence between edge symmetry types and \
array symmetries, and the passage from one to the other."
}], "Text",ExpressionUUID->"026a7f9b-cead-8542-b386-0f86dc88f4c4"],

Cell[TextData[{
 StyleBox["src/ArrayGraphics.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 " \[LongDash] ",
 "The two families of pictures: ArrayGraphics and HypermatrixGraphics in the \
plane, ArrayGraphics3D and HypermatrixGraphics3D in space, with ArrayNesting \
deciding how the indices are split between them."
}], "Text",ExpressionUUID->"83058b1c-d6c7-754c-8fb9-1ddb6cd7185e"],

Cell[TextData[{
 StyleBox["tests/BasicExamples.wls",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 " \[LongDash] ",
 "Every hypergraph example in the documentation as an assertion, plus several \
