 "something given was not an array"
}], "Text",ExpressionUUID->"84c35719-a3a9-8540-a6db-cc81648a6d41"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayMultiply", "::", "rank"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"98b67424-1826-6a47-b41c-da3c0ee9d39e"],
 " \[LongDash] ",
 "an array has a different number of indices from its specification"
}], "Text",ExpressionUUID->"01301f15-163b-ed40-a57c-aabaf3511638"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayMultiply", "::", "dims"}], "InlineCode"]], "InlineFormula",
