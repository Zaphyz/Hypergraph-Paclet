}], "Text",ExpressionUUID->"d9662f4c-9ea6-4f44-a688-1debd640fdd7"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"FindArrayEquations", "::", "eval"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"0497d747-b964-2e47-966b-5484071f9f23"],
 " \[LongDash] ",
 "no nesting evaluated on arrays of the shape used"
