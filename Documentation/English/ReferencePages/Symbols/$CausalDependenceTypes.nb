(* Beginning of Notebook Content *)
Notebook[{
Cell["$CausalDependenceTypes", "ObjectName",ExpressionUUID->"0b627a57-8c26-ae48-9a2e-88b04e23bb16"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["$CausalDependenceTypes", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"38ba91b4-0c7c-5647-9b4a-8da031659c14"],
 " ",
 "is the list of values the \"CausalDependence\" option takes."
}], "Usage",ExpressionUUID->"c2a7f428-5daa-624e-89e6-7d8e594dc193"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"9885287b-556b-0a4b-b4bb-abc2392c54c9"],

Cell["\<\
\"Elements\", the default, makes two events dependent when what they touch \
overlaps in anything at all, vertex or edge. It is the weakest reading, and \
the one the reference paclets take: two rule applications are related when \
their matched patterns are superposed.\
\>", "Notes",ExpressionUUID->"d50fb6a2-8a77-0540-a687-309e83460fc0"],

Cell["\<\
\"Edges\" counts only whole shared edges, so two events are related only when \
one consumed an edge the other made. It is the strictest of the three.\
\>", "Notes",ExpressionUUID->"00bd279f-708e-994e-a164-a3c2736794ac"],

Cell["\<\
\"Vertices\" counts only shared vertices, and is there for the contrast: \
\"Elements\" is exactly \"Edges\" or \"Vertices\", and the three stand in \
that relation on every system.\
\>", "Notes",ExpressionUUID->"2709b258-28e7-c748-b722-b5b12af3e0cd"],

Cell["\<\
Which reading is wanted is a modelling choice, not a fact about the \
rewriting. Two compositions in disjoint parts of a chain share no arrow but \
do share the object between them: whether that is a causal connection depends \
on what the hypergraph is standing for.\
\>", "Notes",ExpressionUUID->"c5d6e383-43d7-fb40-89a2-cdbebdd29626"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"f4a93af0-7f5c-d04b-8be1-1f5bce4ca2e2"],

Cell["$CausalDependenceTypes", "Input",ExpressionUUID->"621324a5-34ac-b144-8015-e0366d42eb58"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Elements\"\>", ",", "\<\"Edges\"\>", ",", "\<\"Vertices\"\>"}],
   "}"}]], "Output",ExpressionUUID->"43352dc3-b83e-1344-9c09-13c442f16475"],

Cell["The three readings on one system, as sets of related pairs:", \
"ExampleText",ExpressionUUID->"89e3896a-b261-034d-83a6-1ed1d1125dce"],

Cell["\<\
subdivide = HypergraphRule[{{1, 2}}, {{1, 3}, {3, 2}}];
twoEdges = HypergraphRewritingSystem[subdivide, Hypergraph[{{1, 2}, {2, \
3}}]];
pairsOf[l_] := {#[\"From\"], #[\"To\"]} & /@ l;
AssociationMap[pairsOf @ twoEdges[\"CausalEdges\", 2, \"CausalDependence\" -> \
#] &, $CausalDependenceTypes]\
\>", "Input",ExpressionUUID->"27c397a1-5e13-074d-8e9f-a85971148b16"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Elements\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "3"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "4"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "5"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "6"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "7"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "8"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"\<\"Edges\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "3"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "5"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "7"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "8"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"\<\"Vertices\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "3"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "4"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "5"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "6"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "7"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "8"}], "}"}]}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",ExpressionUUID->"b837f39e-8904-ff4a-bce2-\
b9ceb100a332"],

Cell["\<\
Edges and vertices are each a part of elements, and together they are all of \
it:\
\>", "ExampleText",ExpressionUUID->"75516222-1e84-4c41-afd7-59369c86472d"],

Cell["\<\
With[{byType = pairsOf @ twoEdges[\"CausalEdges\", 2, \"CausalDependence\" -> \
#] &},
 {SubsetQ[byType[\"Elements\"], byType[\"Edges\"]],
  SubsetQ[byType[\"Elements\"], byType[\"Vertices\"]],
  Sort @ byType[\"Elements\"] === Sort @ Union[byType[\"Edges\"], \
byType[\"Vertices\"]]}]\
\>", "Input",ExpressionUUID->"0d6abc2f-b047-d649-aea1-cd9450c2b52c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",ExpressionUUID->\
"1e9ca18b-bc8c-9a44-a106-d6bab520dd10"],

Cell["Source", "NotesSection",ExpressionUUID->"3b9765f6-070b-9b41-9d8c-5af4fb847fb4"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Causality.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Causal dependence",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"de69e39e-6825-354c-9171-a93397a63919"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"0435dd09-bcf2-454f-80ca-746d343ea30e"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["HypergraphCausalGraph", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"8ca9f6d5-d453-8b47-abe7-5c3acf1cd136"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphRewritingSystem", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"6bff1f7d-54a4-f442-a8eb-5810ae76c742"]
}], "SeeAlso",ExpressionUUID->"fd76c4d6-24b5-c54f-a8f1-6bbf449c583a"]
},
