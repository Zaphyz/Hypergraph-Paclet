(* Beginning of Notebook Content *)
Notebook[{
Cell["$CausalDependenceTypes", "ObjectName",ExpressionUUID->"2b34be3e-f282-9145-9dea-4ae9f504f359"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["$CausalDependenceTypes", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"24d3a5fd-9bfd-854d-aa3a-a70ed86243eb"],
 " ",
 "is the list of values the \"CausalDependence\" option takes."
}], "Usage",ExpressionUUID->"f050d102-ffad-0244-8f99-4c50b1975358"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"5cc954ee-7e66-1a4e-948a-8f3e029586c9"],

Cell["\<\
\"Elements\", the default, makes two events dependent when what they touch \
overlaps in anything at all, vertex or edge. It is the weakest reading, and \
the one the reference paclets take: two rule applications are related when \
their matched patterns are superposed.\
\>", "Notes",ExpressionUUID->"93eea3bb-8b29-2647-b34f-e1ff307ad557"],

Cell["\<\
\"Edges\" counts only whole shared edges, so two events are related only when \
one consumed an edge the other made. It is the strictest of the three.\
\>", "Notes",ExpressionUUID->"79c4c3b9-4a58-0247-a333-e2ada641cc70"],

Cell["\<\
\"Vertices\" counts only shared vertices, and is there for the contrast: \
\"Elements\" is exactly \"Edges\" or \"Vertices\", and the three stand in \
that relation on every system.\
\>", "Notes",ExpressionUUID->"6536cbbf-c8fc-ca42-b14d-cea9e04478a8"],

Cell["\<\
Which reading is wanted is a modelling choice, not a fact about the \
rewriting. Two compositions in disjoint parts of a chain share no arrow but \
do share the object between them: whether that is a causal connection depends \
on what the hypergraph is standing for.\
\>", "Notes",ExpressionUUID->"692ad277-c538-f045-acc7-c674e4c2b198"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"ebe6bc0e-019d-bd40-9c9a-0a913af7b0c9"],

Cell["$CausalDependenceTypes", "Input",ExpressionUUID->"c5c3a97c-6b19-8a44-8125-ef9e4872d7f1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Elements\"\>", ",", "\<\"Edges\"\>", ",", "\<\"Vertices\"\>"}],
   "}"}]], "Output",ExpressionUUID->"e8c6cdcd-df49-224a-9fe6-4213badf66ab"],

Cell["The three readings on one system, as sets of related pairs:", \
"ExampleText",ExpressionUUID->"d4cfbde8-9e8c-cf42-ab48-a7955cfddf28"],

Cell["\<\
subdivide = HypergraphRule[{{1, 2}}, {{1, 3}, {3, 2}}];
twoEdges = HypergraphRewritingSystem[subdivide, Hypergraph[{{1, 2}, {2, \
3}}]];
pairsOf[l_] := {#[\"From\"], #[\"To\"]} & /@ l;
AssociationMap[pairsOf @ twoEdges[\"CausalEdges\", 2, \"CausalDependence\" -> \
#] &, $CausalDependenceTypes]\
\>", "Input",ExpressionUUID->"0bb07e31-ca45-d642-8f6c-714babc1db87"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Elements\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "3"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "4"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "5"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "6"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "7"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "8"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"\<\"Edges\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "3"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "5"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "7"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "8"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"\<\"Vertices\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "3"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "4"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "5"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "6"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "7"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "8"}], "}"}]}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",ExpressionUUID->"ecc40b93-3b97-aa4c-90cc-\
345d1db25483"],

Cell["\<\
Edges and vertices are each a part of elements, and together they are all of \
it:\
\>", "ExampleText",ExpressionUUID->"5ae427e9-daa4-4f41-8a57-4a6485904148"],

Cell["\<\
With[{byType = pairsOf @ twoEdges[\"CausalEdges\", 2, \"CausalDependence\" -> \
#] &},
 {SubsetQ[byType[\"Elements\"], byType[\"Edges\"]],
  SubsetQ[byType[\"Elements\"], byType[\"Vertices\"]],
  Sort @ byType[\"Elements\"] === Sort @ Union[byType[\"Edges\"], \
byType[\"Vertices\"]]}]\
\>", "Input",ExpressionUUID->"b2457d5e-2b50-724f-a0b7-2db3549c9652"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",ExpressionUUID->\
"5f662755-dda1-b847-bd27-06e20bcae03c"],

Cell["Source", "NotesSection",ExpressionUUID->"6c091a9a-03f4-1a41-8720-0dc1e0ea031e"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Causality.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Causal dependence",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"e927031d-5c63-4442-8310-8e8abf8cc2e2"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"2136c52b-95b4-dc4f-82a3-a16a573f0a46"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["HypergraphCausalGraph", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"3685c775-8345-c94a-9b3a-cbedb48ca692"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphRewritingSystem", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"edd354c3-e2e3-0d40-b8ad-5c183f1d3dd8"]
}], "SeeAlso",ExpressionUUID->"7121b806-c9d5-4e49-9967-47f17b4629f3"]
},
WindowSize->{800, 750},
