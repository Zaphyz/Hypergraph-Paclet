(* Beginning of Notebook Content *)
Notebook[{
Cell["$CausalDependenceTypes", "ObjectName",ExpressionUUID->"2128573b-770d-9e4f-bf34-e277f5f00135"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["$CausalDependenceTypes", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"e5fdb962-099a-4143-bc73-b2daaf3430d5"],
 " ",
 "is the list of values the \"CausalDependence\" option takes."
}], "Usage",ExpressionUUID->"72ac58a8-7da3-f24b-b9c5-c79ac078b703"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"8385077e-5d02-9241-b651-3d61397d47fe"],

Cell["\<\
\"Elements\", the default, makes two events dependent when what they touch \
overlaps in anything at all, vertex or edge. It is the weakest reading, and \
the one the reference paclets take: two rule applications are related when \
their matched patterns are superposed.\
\>", "Notes",ExpressionUUID->"2aaede22-2594-d647-8c39-987d1d7a577a"],

Cell["\<\
\"Edges\" counts only whole shared edges, so two events are related only when \
one consumed an edge the other made. It is the strictest of the three.\
\>", "Notes",ExpressionUUID->"b3bab3a1-a3b0-5d4a-9c6c-aebef7ab67fe"],

Cell["\<\
\"Vertices\" counts only shared vertices, and is there for the contrast: \
\"Elements\" is exactly \"Edges\" or \"Vertices\", and the three stand in \
that relation on every system.\
\>", "Notes",ExpressionUUID->"7d2a922a-967a-fd44-9188-4a9738fa89cb"],

Cell["\<\
Which reading is wanted is a modelling choice, not a fact about the \
rewriting. Two compositions in disjoint parts of a chain share no arrow but \
do share the object between them: whether that is a causal connection depends \
on what the hypergraph is standing for.\
\>", "Notes",ExpressionUUID->"586617d8-7f0a-f047-a0ed-c3b0d63153b9"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"9a74f499-3e7b-f44a-96cd-ac712b1ef918"],

Cell["$CausalDependenceTypes", "Input",ExpressionUUID->"d4f82005-4abb-c245-a97c-c00b42361c5f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Elements\"\>", ",", "\<\"Edges\"\>", ",", "\<\"Vertices\"\>"}],
   "}"}]], "Output",ExpressionUUID->"2e5c729f-0b12-5a46-bb5d-e5a7f1129a53"],

Cell["The three readings on one system, as sets of related pairs:", \
"ExampleText",ExpressionUUID->"91cd17bb-eb69-7948-8049-93d729a3e978"],

Cell["\<\
subdivide = HypergraphRule[{{1, 2}}, {{1, 3}, {3, 2}}];
twoEdges = HypergraphRewritingSystem[subdivide, Hypergraph[{{1, 2}, {2, \
3}}]];
pairsOf[l_] := {#[\"From\"], #[\"To\"]} & /@ l;
AssociationMap[pairsOf @ twoEdges[\"CausalEdges\", 2, \"CausalDependence\" -> \
#] &, $CausalDependenceTypes]\
\>", "Input",ExpressionUUID->"253ea725-97f3-104d-a5cb-d012de0ab63a"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Elements\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "3"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "4"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "5"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "6"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "7"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "8"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"\<\"Edges\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "3"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "5"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "7"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "8"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"\<\"Vertices\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "3"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "4"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "5"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "6"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "7"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "8"}], "}"}]}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",ExpressionUUID->"7cd4e093-c2ec-9642-8ef6-\
16905f60a55e"],

Cell["\<\
Edges and vertices are each a part of elements, and together they are all of \
it:\
\>", "ExampleText",ExpressionUUID->"d300ac3c-a6eb-8747-9aa5-2825fcea616c"],

Cell["\<\
With[{byType = pairsOf @ twoEdges[\"CausalEdges\", 2, \"CausalDependence\" -> \
#] &},
 {SubsetQ[byType[\"Elements\"], byType[\"Edges\"]],
  SubsetQ[byType[\"Elements\"], byType[\"Vertices\"]],
  Sort @ byType[\"Elements\"] === Sort @ Union[byType[\"Edges\"], \
byType[\"Vertices\"]]}]\
\>", "Input",ExpressionUUID->"41716d19-22cb-9b4f-85e6-d55432e90f18"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",ExpressionUUID->\
"e03465ef-75dc-7546-8101-936d2769f828"],

Cell["Source", "NotesSection",ExpressionUUID->"d4e9fd5d-3f99-894f-a1ee-878ee1049ef3"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Causality.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Causal dependence",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"678044b9-5f73-3248-85ba-50f67808639c"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"f19b8a32-edce-034d-b398-35b411701b8a"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["HypergraphCausalGraph", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"bbbe486a-c9a8-6242-96a6-90444a499883"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphRewritingSystem", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"16ff4076-4dd9-af46-80b7-070809ccafe3"]
}], "SeeAlso",ExpressionUUID->"8aa80275-dd52-934b-92b0-c4f052291583"]
},
