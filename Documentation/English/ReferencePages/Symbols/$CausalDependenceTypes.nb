(* Beginning of Notebook Content *)
Notebook[{
Cell["$CausalDependenceTypes", "ObjectName",ExpressionUUID->"c7a74554-17f1-e14b-96b0-cd3a4faaf335"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["$CausalDependenceTypes", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"d0cb76c1-59ff-2341-b081-80b5d52942b0"],
 " ",
 "is the list of values the \"CausalDependence\" option takes."
}], "Usage",ExpressionUUID->"b8ea864c-7116-1549-a90c-70eb49ae1929"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"a84d8881-dfb8-2343-9c80-89816f387e74"],

Cell["\<\
\"Elements\", the default, makes two events dependent when what they touch \
overlaps in anything at all, vertex or edge. It is the weakest reading, and \
the one the reference paclets take: two rule applications are related when \
their matched patterns are superposed.\
\>", "Notes",ExpressionUUID->"47faa62a-2aa5-c74e-af6c-bfb756f9c164"],

Cell["\<\
\"Edges\" counts only whole shared edges, so two events are related only when \
one consumed an edge the other made. It is the strictest of the three.\
\>", "Notes",ExpressionUUID->"2946de6d-f936-a849-915a-964c1b5e82da"],

Cell["\<\
\"Vertices\" counts only shared vertices, and is there for the contrast: \
\"Elements\" is exactly \"Edges\" or \"Vertices\", and the three stand in \
that relation on every system.\
\>", "Notes",ExpressionUUID->"6be570a0-2f2a-d443-bfb1-5bb4c7ae50be"],

Cell["\<\
Which reading is wanted is a modelling choice, not a fact about the \
rewriting. Two compositions in disjoint parts of a chain share no arrow but \
do share the object between them: whether that is a causal connection depends \
on what the hypergraph is standing for.\
\>", "Notes",ExpressionUUID->"ac50d990-b4c2-c64a-9d5b-3a2a950371d0"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"a4ec897e-e965-f94f-8c9f-4e5ec42e53ca"],

Cell["$CausalDependenceTypes", "Input",ExpressionUUID->"f661fe32-7b52-4646-b25c-95ab775198bd"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Elements\"\>", ",", "\<\"Edges\"\>", ",", "\<\"Vertices\"\>"}],
   "}"}]], "Output",ExpressionUUID->"b0598dc3-bedd-b044-ad9b-40e309a14c80"],

Cell["The three readings on one system, as sets of related pairs:", \
"ExampleText",ExpressionUUID->"5c087c07-fa2f-d343-b6ed-a0ed4544ae76"],

Cell["\<\
subdivide = HypergraphRule[{{1, 2}}, {{1, 3}, {3, 2}}];
twoEdges = HypergraphRewritingSystem[subdivide, Hypergraph[{{1, 2}, {2, \
3}}]];
pairsOf[l_] := {#[\"From\"], #[\"To\"]} & /@ l;
AssociationMap[pairsOf @ twoEdges[\"CausalEdges\", 2, \"CausalDependence\" -> \
#] &, $CausalDependenceTypes]\
\>", "Input",ExpressionUUID->"b5a6130f-dcb5-2c4e-b4a2-e7752e7d872f"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Elements\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "3"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "4"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "5"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "6"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "7"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "8"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"\<\"Edges\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "3"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "5"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "7"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "8"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"\<\"Vertices\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "3"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "4"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "5"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "6"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "7"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "8"}], "}"}]}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",ExpressionUUID->"2e3610fe-e961-784c-8bb6-\
f72797c5b066"],

Cell["\<\
Edges and vertices are each a part of elements, and together they are all of \
it:\
\>", "ExampleText",ExpressionUUID->"9c98d1cc-b1d2-7e47-bac1-1c64f5850166"],

Cell["\<\
With[{byType = pairsOf @ twoEdges[\"CausalEdges\", 2, \"CausalDependence\" -> \
#] &},
 {SubsetQ[byType[\"Elements\"], byType[\"Edges\"]],
  SubsetQ[byType[\"Elements\"], byType[\"Vertices\"]],
  Sort @ byType[\"Elements\"] === Sort @ Union[byType[\"Edges\"], \
byType[\"Vertices\"]]}]\
\>", "Input",ExpressionUUID->"ba92812b-7878-6849-8778-648c10d08aaf"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",ExpressionUUID->\
"b7391e7f-1197-5a42-bd22-6d85504fdbdc"],

Cell["Source", "NotesSection",ExpressionUUID->"bfd208f6-49e7-4b46-b930-891386a48632"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Causality.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Causal dependence",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"ff6f9e22-d1e4-cc4e-adda-dd74e8415b67"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"5b46073a-7d46-cc4d-b278-c397c3d17bd5"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["HypergraphCausalGraph", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"025aa783-7349-2643-bffa-e9eaf4995578"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphRewritingSystem", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"0ffd2841-6daa-ce4f-9cdc-755ec87228cb"]
}], "SeeAlso",ExpressionUUID->"32d01be6-4474-7e40-9331-b3837af4ff50"]
},
WindowSize->{800, 750},
FrontEndVersion->"15.0 for Microsoft Windows (64-bit) (July 2, 2026)",
