(* Beginning of Notebook Content *)
Notebook[{
Cell["$HypergraphRewritingOptions", "ObjectName",ExpressionUUID->"992c50e3-a527-1c42-aadc-21b94c2e8c99"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["$HypergraphRewritingOptions", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"66368171-ed7a-0f46-8fd0-38a5d4848dfe"],
 " ",
 "is the registry of options a rewriting system takes, with their defaults."
}], "Usage",ExpressionUUID->"d27895f5-6442-6943-892e-a8cbe132faac"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"612351e2-1ffe-7c46-998f-6f37a9ef18b8"],

Cell["\<\
The options fall into three groups. \"MaxStates\", \"Labeled\", \
\"LabelPatterns\" and \"DistinctVertices\" govern the evolution; \
\"CausalDependence\", \"TransitiveReduction\" and \"CanonicalizeStates\" \
govern what is made of it; \"StateRendering\", \"EventRendering\", \
\"MaxDrawnVertices\", \"PanelSize\" and \"HypergraphPlotOptions\" govern how \
it is drawn.\
\>", "Notes",ExpressionUUID->"a4a36854-18e9-234b-ae73-00b7b559039d"],

Cell[TextData[{
 "Every graph-valued property takes these together with the options of ",
 Cell[BoxData[
  StyleBox["Graph", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "989961e2-49c8-d142-a714-ef742bbeb7e7"],
 ". What the caller passes wins over what the property would have set."
}], "Notes",ExpressionUUID->"1c0ba5c4-4b0f-6b43-840f-aea222f22b17"],

Cell["\<\
A system may hold options of its own, as HypergraphRewritingSystem[rules, \
init, opts], and every property inherits them; an option given to a property \
still wins over one held by the system.\
\>", "Notes",ExpressionUUID->"8fcd5e04-996e-b74e-95af-56ac1992c68c"],

Cell["\<\
sys[\"Options\"] gives the values in force for a particular system: the ones \
it holds, and the defaults for the rest.\
\>", "Notes",ExpressionUUID->"65c243ba-2640-b041-93b5-d99127541803"],

Cell["\<\
\"StateRendering\" and \"EventRendering\" take Automatic, True or False. \
Under Automatic a graph draws its states and events as hypergraph pictures \
while there are at most \"MaxDrawnVertices\" of them, and falls back to plain \
vertices past that with a message rather than spending a long time laying out \
pictures nobody asked for.\
\>", "Notes",ExpressionUUID->"4051d126-470f-634f-8efe-71a467d4af58"],

Cell["\<\
\"HypergraphPlotOptions\" is passed to every hypergraph drawn inside a graph \
vertex.\
\>", "Notes",ExpressionUUID->"7a950c6c-71f9-564b-8156-da341e61e733"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"f01e2e99-e670-6340-8ffb-5a8dbf87494c"],

Cell["$HypergraphRewritingOptions", "Input",ExpressionUUID->"0fbdcdd7-5a34-bb42-972e-a44a1f3a15c5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"MaxStates\"\>", "\[Rule]", "2048"}], ",", 
   RowBox[{"\<\"Labeled\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"LabelPatterns\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"DistinctVertices\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"CausalDependence\"\>", "\[Rule]", "\<\"Elements\"\>"}], ",", 
   RowBox[{"\<\"TransitiveReduction\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"CanonicalizeStates\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"StateRendering\"\>", "\[Rule]", "Automatic"}], ",", 
   RowBox[{"\<\"EventRendering\"\>", "\[Rule]", "Automatic"}], ",", 
   RowBox[{"\<\"MaxDrawnVertices\"\>", "\[Rule]", "24"}], ",", 
   RowBox[{"\<\"PanelSize\"\>", "\[Rule]", "90"}], ",", 
   RowBox[{"\<\"HypergraphPlotOptions\"\>", "\[Rule]", 
    RowBox[{"{", "}"}]}]}], "}"}]], "Output",ExpressionUUID->"f8d636ce-6edb-\
8f46-8a16-b1320d82bf8f"],

Cell["What a particular system is working with:", "ExampleText",ExpressionUUID->"3ffa60f3-9af9-0542-8703-0a14858745d3"],

Cell["\<\
quick = HypergraphRewritingSystem[HypergraphRule[{{1, 2}}, {{1, 3}, {3, 2}}], \
Hypergraph[{{1, 2}}],
  \"CausalDependence\" -> \"Edges\", \"PanelSize\" -> 60];
FilterRules[quick[\"Options\"], {\"CausalDependence\", \"PanelSize\", \
\"MaxDrawnVertices\"}]\
\>", "Input",ExpressionUUID->"e22f93e4-e908-654f-b5d2-8f4abea8adcb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"CausalDependence\"\>", "\[Rule]", "\<\"Edges\"\>"}], ",", 
   RowBox[{"\<\"MaxDrawnVertices\"\>", "\[Rule]", "24"}], ",", 
   RowBox[{"\<\"PanelSize\"\>", "\[Rule]", "60"}]}], "}"}]], "Output",Expressi\
onUUID->"4f25f44f-b986-e449-9725-33faf44af4c6"],

Cell["\<\
The held option is used without being repeated, and an option on the call \
overrides it:\
\>", "ExampleText",ExpressionUUID->"d1960b47-dbb0-6648-9455-37ebdd38b9dd"],

Cell["\<\
{Length @ quick[\"CausalEdges\", 2],
 Length @ quick[\"CausalEdges\", 2, \"CausalDependence\" -> \"Elements\"]}\
\>", "Input",ExpressionUUID->"80993571-af95-2a49-aa4a-b307e00c64fb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "2"}], "}"}]], "Output",ExpressionUUID->"5b587b91-7734-5c43-8284-abee46a55f33"],

Cell["Source", "NotesSection",ExpressionUUID->"ebfcd7c9-1e8b-9647-b242-dfd3fe8602ed"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Causality.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Options",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"2d81a66a-cc71-804f-bcc5-64c56c26684d"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"580a6e8e-ba66-844c-aaf3-0f4f3b52d6bf"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["HypergraphRewritingSystem", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"a8421ae7-c95f-3e4f-ac69-cf49dd21f041"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphCausalGraph", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"906709b3-6de1-a74c-897a-25b1506a4c4b"],
 ", ",
 Cell[BoxData[
  StyleBox["$CausalDependenceTypes", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"c7c7a531-fd68-e54d-89d7-1c8d16d7ff42"]
}], "SeeAlso",ExpressionUUID->"e4062aaa-529b-6942-b451-a5e8f275087e"]
},
WindowSize->{800, 750},
FrontEndVersion->"15.0 for Microsoft Windows (64-bit) (July 2, 2026)",
