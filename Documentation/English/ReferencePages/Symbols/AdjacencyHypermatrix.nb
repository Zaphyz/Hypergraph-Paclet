        DiskBox[{0., 0.530777583334723}, Offset[{2., 2.}, {0., 0.}]]}}, {
       InsetBox[
        StyleBox["1",
         StripOnInput->False,
         LineColor->GrayLevel[0],
         FrontFaceColor->GrayLevel[0],
         BackFaceColor->GrayLevel[0],
         GraphicsColor->GrayLevel[0],
         FontColor->GrayLevel[0]], {1.9987657369935588, 1.061628456550387}, 
        ImageScaled[{0.49997993667560703, -0.49999999979873155}]], InsetBox[
        StyleBox["2",
         StripOnInput->False,
         LineColor->GrayLevel[0],
         FrontFaceColor->GrayLevel[0],
         BackFaceColor->GrayLevel[0],
