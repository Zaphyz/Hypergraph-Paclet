           0.530777583334723}}]], {}}, 
        {Opacity[1]}}}, 
      {Hue[0.63, 0.66, 0.81], Opacity[0.1], 
       FilledCurveBox[{
        BSplineCurve[{{1.9987444371974448`, 0.}, {1.8751044786719961`, 
