Notebook[{
Cell["ArrayAdd", "ObjectName",ExpressionUUID->"21d2c024-3d40-7f46-ad70-97e99099e15f"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayAdd", "[", 
    RowBox[{"arr1", ",", " ", "arr2", ",", " ", "..."}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "c8290360-45fc-3b4d-be46-19db24ae5741"],
 " ",
 "adds the given arrays entry by entry."
}], "Usage",ExpressionUUID->"58f194ec-d3b4-294e-898c-e03461053ede"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"670502f2-eca0-874c-8d8e-fbd786a22fe0"],

Cell["\<\
The arrays are given directly, not in a list: a list of arrays is itself an \
array, and there would be no telling the two readings apart.\
\>", "Notes",ExpressionUUID->"6c951299-20e7-4a4f-8d28-78131f590e21"],

Cell["\<\
Every argument must have the same dimensions, except that an array of order \
zero has no shape of its own and is added to every entry.\
\>", "Notes",ExpressionUUID->"6b5af37f-4219-8f4a-b4b4-784811c46799"],

Cell["\<\
The arrays may be given as array objects or as plain nested lists, and \
entries of any kind may be combined: the operation acts on one entry at a \
time, so a number meeting an expression has the obvious reading. The result \
is an ArrayObject.\
\>", "Notes",ExpressionUUID->"9229d4c9-97ac-7942-9306-aa5398933a57"],

Cell["\<\
A symmetry declared by every argument of order one or more is carried over to \
the result, since an entry-by-entry operation treats each index tuple \
separately. Where the arguments disagree, or where plain entries were given, \
nothing is claimed and the result is \"Rigid\".\
\>", "Notes",ExpressionUUID->"8c2ce227-9b0b-7442-92b7-cbace7a05070"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"arr1", " ", "+", " ", "arr2"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"39788191-438a-ca44-929d-1ec74bd6eb79"],
 " is the same operation: Plus on an array object is ArrayAdd, so arrays may \
be combined in ordinary arithmetic notation."
}], "Notes",ExpressionUUID->"79527eee-0143-3848-9e98-605fd6e6fa23"],

Cell["\<\
Arrays of different dimensions give ArrayAdd::dims and $Failed.\
\>", "Notes",ExpressionUUID->"25663bb6-a6b7-8e43-a460-37edaf92e439"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"931bd4e3-1705-f743-9822-93ee783bf78e"],

Cell["Entry by entry:", "ExampleText",ExpressionUUID->"b482b10d-2735-0d45-bb7f-91d8c3e2cb7f"],

Cell["\<\
u = {{1, 2}, {3, 4}}; v = {{5, 6}, {7, 8}};
Normal @ ArrayAdd[u, v]\
\>", "Input",ExpressionUUID->"5b120b7e-4b12-b04f-82f9-e5d70ba6f9e6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"6", ",", "8"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"10", ",", "12"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"a7fc5d2b-c748-0b40-b1fa-c934d6d2b888"],

Cell["Ordinary arithmetic notation does the same:", "ExampleText",ExpressionUUID->"d6603a2a-52ee-ca43-b374-f459f01bdb5a"],

Cell["Normal[ArrayObject[u] + ArrayObject[v]]", "Input",ExpressionUUID->"f4f76634-6dc1-074e-8761-db3b4776ba5b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"6", ",", "8"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"10", ",", "12"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"a37c559e-6217-ae41-b7d7-25a55746764c"],

Cell["\<\
A difference is a sum with a scalar multiple, so that works too:\
\>", "ExampleText",ExpressionUUID->"b9b11d05-61d2-2b4b-b44b-85651ae73e2c"],

Cell["Normal[ArrayObject[u] - ArrayObject[v]]", "Input",ExpressionUUID->"4bd45b89-2207-f04f-980f-317d1ff3de7d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "4"}], ",", 
     RowBox[{"-", "4"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "4"}], ",", 
     RowBox[{"-", "4"}]}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"344d01c1-39cb-5443-bdf1-a867f5d7e807"],

Cell["\<\
An array of order zero has no shape of its own and reaches every entry:\
\>", "ExampleText",ExpressionUUID->"06362266-5947-e04f-a1a8-23bcecce484c"],

Cell["Normal @ ArrayAdd[1, u]", "Input",ExpressionUUID->"a256f0cd-340a-104f-a389-a47d037c4304"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"4", ",", "5"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"4da7b078-9904-2d41-9d02-f17daa66df46"],

Cell["A symmetry shared by the arguments is carried over:", "ExampleText",ExpressionUUID->"295eae1e-1c46-cc48-9984-3e8a61323cdd"],

Cell["\<\
ArraySymmetry @ ArrayAdd[ArrayObject[{{1, 2}, {2, 3}}, \"Symmetric\"],
                         ArrayObject[{{0, 1}, {1, 0}}, \"Symmetric\"]]\
\>", "Input",ExpressionUUID->"eb6e1488-2ead-9441-991a-11576668bf5f"],

Cell[BoxData["\<\"Symmetric\"\>"], "Output",ExpressionUUID->"8200a9df-5970-604b-af50-74316f618920"],

Cell["Arrays of different dimensions cannot be added:", "ExampleText",ExpressionUUID->"9d3f6f0e-f31e-3c49-9cf9-8226677dd377"],

Cell["Quiet @ ArrayAdd[{1, 2}, {1, 2, 3}]", "Input",ExpressionUUID->"f43e4941-229c-f944-982f-43ca46510249"],

Cell[BoxData["$Failed"], "Output",ExpressionUUID->"2c494ef8-91c3-4f4e-8390-e943c6dbb560"],

Cell["Source", "NotesSection",ExpressionUUID->"ecbf1ce2-5012-d44f-86fe-8787e2bee0fd"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/ArrayAlgebra.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Element-wise operations",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"ad25bde0-8ac8-7b4d-b570-328f6eda96b5"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"c7fda0dc-6a01-c341-ac36-3820c54cb021"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayTimes", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "d52fe5f8-06ca-6942-b449-9f647a42f57d"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayMultiply", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "8503a6cf-5f5a-d547-9f00-7b87f5c57b6a"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayObject", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "4b093b82-aebd-b740-9886-b4c8272e9f9f"],
 ", ",
 Cell[BoxData[
  StyleBox["GenerateSymbolicArray", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"ee0dd832-5173-f44e-801e-7b6cde377f1f"],
 ", ",
 Cell[BoxData[
  StyleBox["ZeroArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "b5128200-d174-b845-be06-04506ebfe874"]
}], "SeeAlso",ExpressionUUID->"dcc4ffd7-d007-8341-9f5d-219e6e1dc415"]
},
WindowSize->{800, 750},
