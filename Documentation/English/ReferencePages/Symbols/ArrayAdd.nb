Notebook[{
Cell["ArrayAdd", "ObjectName",ExpressionUUID->"bd496ac0-295c-6c4a-9159-7a7207c84460"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayAdd", "[", 
    RowBox[{"arr1", ",", " ", "arr2", ",", " ", "..."}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "5e0e7daa-6d8b-d447-ab14-2819896a0aea"],
 " ",
 "adds the given arrays entry by entry."
}], "Usage",ExpressionUUID->"035da3db-29bc-e045-bdb5-e7a105c70012"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"fdb4c885-5d51-db47-a14e-5b515bbd6ff1"],

Cell["\<\
The arrays are given directly, not in a list: a list of arrays is itself an \
array, and there would be no telling the two readings apart.\
\>", "Notes",ExpressionUUID->"af2f27c0-534d-2148-b7c5-4d972ecbac8f"],

Cell["\<\
Every argument must have the same dimensions, except that an array of order \
zero has no shape of its own and is added to every entry.\
\>", "Notes",ExpressionUUID->"23890076-174f-304a-b2b2-25d700cda961"],

Cell["\<\
The arrays may be given as array objects or as plain nested lists, and \
entries of any kind may be combined: the operation acts on one entry at a \
time, so a number meeting an expression has the obvious reading. The result \
is an ArrayObject.\
\>", "Notes",ExpressionUUID->"8052396a-3ccb-4a40-8586-0f5fcd23b5de"],

Cell["\<\
A symmetry declared by every argument of order one or more is carried over to \
the result, since an entry-by-entry operation treats each index tuple \
separately. Where the arguments disagree, or where plain entries were given, \
nothing is claimed and the result is \"Rigid\".\
\>", "Notes",ExpressionUUID->"9c45f054-58c1-8f45-adbd-e3b6aa245ec9"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"arr1", " ", "+", " ", "arr2"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"6423cc93-2f17-e745-8a18-e9167d3d47be"],
 " is the same operation: Plus on an array object is ArrayAdd, so arrays may \
be combined in ordinary arithmetic notation."
}], "Notes",ExpressionUUID->"3cfde265-f24b-5a4e-848e-1032a6ea0856"],

Cell["\<\
Arrays of different dimensions give ArrayAdd::dims and $Failed.\
\>", "Notes",ExpressionUUID->"eff078d0-f061-2d49-9c53-b5e3864a4777"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"acdadf3a-cd71-e44e-80ec-da5ebf077397"],

Cell["Entry by entry:", "ExampleText",ExpressionUUID->"e7b07125-4750-8642-abaa-b54014f2af9c"],

Cell["\<\
u = {{1, 2}, {3, 4}}; v = {{5, 6}, {7, 8}};
Normal @ ArrayAdd[u, v]\
\>", "Input",ExpressionUUID->"1b1bdde4-4552-014d-9869-710169e28089"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"6", ",", "8"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"10", ",", "12"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"3fb78dca-7509-6041-92b1-b1ff43633ab9"],

Cell["Ordinary arithmetic notation does the same:", "ExampleText",ExpressionUUID->"b0714e8d-1659-6f45-bcb0-52f47fb2edad"],

Cell["Normal[ArrayObject[u] + ArrayObject[v]]", "Input",ExpressionUUID->"6576401c-3e58-104d-96ed-2be759244940"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"6", ",", "8"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"10", ",", "12"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"90e25405-28ea-b449-a77a-2201acdff8a7"],

Cell["\<\
A difference is a sum with a scalar multiple, so that works too:\
\>", "ExampleText",ExpressionUUID->"95d85860-1838-c24c-ad83-ab1d5d1ff33b"],

Cell["Normal[ArrayObject[u] - ArrayObject[v]]", "Input",ExpressionUUID->"94ff5899-8c6d-8f48-9ce8-85005e1390ab"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "4"}], ",", 
     RowBox[{"-", "4"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "4"}], ",", 
     RowBox[{"-", "4"}]}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"1ce876a0-fb9f-2c4e-942f-d8ec423f75c3"],

Cell["\<\
An array of order zero has no shape of its own and reaches every entry:\
\>", "ExampleText",ExpressionUUID->"f0b62d33-9856-194c-87ac-afa44b52c86f"],

Cell["Normal @ ArrayAdd[1, u]", "Input",ExpressionUUID->"39fc9e3e-4071-c742-92c5-6179d1719e96"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"4", ",", "5"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"118d1113-42a7-bb48-b641-8c96b6d2f65b"],

Cell["A symmetry shared by the arguments is carried over:", "ExampleText",ExpressionUUID->"68843714-7eb9-7540-a198-73b78d256184"],

Cell["\<\
ArraySymmetry @ ArrayAdd[ArrayObject[{{1, 2}, {2, 3}}, \"Symmetric\"],
                         ArrayObject[{{0, 1}, {1, 0}}, \"Symmetric\"]]\
\>", "Input",ExpressionUUID->"e04dd63f-fb85-ec4e-b5f3-dee0689450ed"],

Cell[BoxData["\<\"Symmetric\"\>"], "Output",ExpressionUUID->"dfb5bff9-0142-bd40-8798-2c1fb7f4e66e"],

Cell["Arrays of different dimensions cannot be added:", "ExampleText",ExpressionUUID->"42d32717-4afb-9d4f-a731-ee3cbf3008cf"],

Cell["Quiet @ ArrayAdd[{1, 2}, {1, 2, 3}]", "Input",ExpressionUUID->"687087a8-2573-c844-8856-4b24901d6669"],

Cell[BoxData["$Failed"], "Output",ExpressionUUID->"5978e333-8a8c-9a45-9557-e5e5294d6190"],

Cell["Source", "NotesSection",ExpressionUUID->"bceb17bc-2937-4346-87e1-e210ddc8c0a6"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/ArrayAlgebra.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Element-wise operations",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"135830b3-6f8e-d545-96ef-65bfc63bc161"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"17847820-f607-a54d-ae03-50b51c5fa502"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayTimes", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "98063fed-7146-0340-9b6b-ddca20ef4f4d"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayMultiply", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "21811be9-330f-dd41-bf5c-d98a6fe18270"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayObject", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "8a61ba59-c41f-6948-b4d0-203fbd474892"],
 ", ",
 Cell[BoxData[
  StyleBox["GenerateSymbolicArray", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"3ddd8af4-df0d-d948-9de2-d4b3776c2de6"],
 ", ",
 Cell[BoxData[
  StyleBox["ZeroArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "b3e92770-bc82-d34f-95f0-e5f217c1c8fa"]
}], "SeeAlso",ExpressionUUID->"1b8ec459-340e-d544-8234-fc40d1e2d6cc"]
},
WindowSize->{800, 750},
