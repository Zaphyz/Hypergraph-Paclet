Notebook[{
Cell["ArrayAdd", "ObjectName",ExpressionUUID->"d85add43-8ce9-f141-90cd-741321f552e1"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayAdd", "[", 
    RowBox[{"arr1", ",", " ", "arr2", ",", " ", "..."}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "38f8e9d9-aa0b-3c4c-bb4c-5b5de5b43d8b"],
 " ",
 "adds the given arrays entry by entry."
}], "Usage",ExpressionUUID->"06959307-e2c8-9944-89d1-6a268d276a67"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"b2ae9881-e037-294f-bdb7-d60e710cc9bb"],

Cell["\<\
The arrays are given directly, not in a list: a list of arrays is itself an \
array, and there would be no telling the two readings apart.\
\>", "Notes",ExpressionUUID->"7dba2751-680a-0d48-bebd-6dc49caac31a"],

Cell["\<\
Every argument must have the same dimensions, except that an array of order \
zero has no shape of its own and is added to every entry.\
\>", "Notes",ExpressionUUID->"d3d0ac82-a2a9-3c43-b30f-a22fa9f9bee7"],

Cell["\<\
The arrays may be given as array objects or as plain nested lists, and \
entries of any kind may be combined: the operation acts on one entry at a \
time, so a number meeting an expression has the obvious reading. The result \
is an ArrayObject.\
\>", "Notes",ExpressionUUID->"75dac5cf-0e5b-1242-92a6-84fc062e62b2"],

Cell["\<\
A symmetry declared by every argument of order one or more is carried over to \
the result, since an entry-by-entry operation treats each index tuple \
separately. Where the arguments disagree, or where plain entries were given, \
nothing is claimed and the result is \"Rigid\".\
\>", "Notes",ExpressionUUID->"e037b321-baf0-2d4a-b8f8-5ccaec6cb881"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"arr1", " ", "+", " ", "arr2"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"41610fa3-ec99-404a-a00a-fceb44badbdd"],
 " is the same operation: Plus on an array object is ArrayAdd, so arrays may \
be combined in ordinary arithmetic notation."
}], "Notes",ExpressionUUID->"a4d9602c-147e-974a-b52c-bde54d8a2474"],

Cell["\<\
Arrays of different dimensions give ArrayAdd::dims and $Failed.\
\>", "Notes",ExpressionUUID->"8712c18d-e4a1-4445-abae-1122fb88759e"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"6e4a5034-f5a5-494a-bbb2-7f766d9e61f6"],

Cell["Entry by entry:", "ExampleText",ExpressionUUID->"43264101-c2b0-894c-8208-7fb98bc3799b"],

Cell["\<\
u = {{1, 2}, {3, 4}}; v = {{5, 6}, {7, 8}};
Normal @ ArrayAdd[u, v]\
\>", "Input",ExpressionUUID->"8078aeba-be03-ae46-a9ae-fc24e43440d7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"6", ",", "8"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"10", ",", "12"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"174012ca-d71b-604b-98ac-c6d96fe0b86f"],

Cell["Ordinary arithmetic notation does the same:", "ExampleText",ExpressionUUID->"2d439bcf-1e8c-fd45-9493-5b86f8724ef5"],

Cell["Normal[ArrayObject[u] + ArrayObject[v]]", "Input",ExpressionUUID->"8befbe1d-aee4-8345-9d9e-6a440df40f38"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"6", ",", "8"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"10", ",", "12"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"d170c8bc-a45e-6241-9b32-a4644c3d2ecb"],

Cell["\<\
A difference is a sum with a scalar multiple, so that works too:\
\>", "ExampleText",ExpressionUUID->"21276ba8-1ee6-444f-bac1-b49a83663b44"],

Cell["Normal[ArrayObject[u] - ArrayObject[v]]", "Input",ExpressionUUID->"27c786bd-7912-5649-abec-6c083c6afa8c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "4"}], ",", 
     RowBox[{"-", "4"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "4"}], ",", 
     RowBox[{"-", "4"}]}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"9c4fd591-a641-cc4b-ab1f-007d7dc23e43"],

Cell["\<\
An array of order zero has no shape of its own and reaches every entry:\
\>", "ExampleText",ExpressionUUID->"4952f853-f981-5344-bed8-cded07d9f727"],

Cell["Normal @ ArrayAdd[1, u]", "Input",ExpressionUUID->"2184ff12-512c-5042-9748-a5d1af10fede"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"4", ",", "5"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"71a3af55-3019-384b-9e4e-4a03e6955ac1"],

Cell["A symmetry shared by the arguments is carried over:", "ExampleText",ExpressionUUID->"0eb97613-64d9-9c4d-bffc-86e3d9c6ecdf"],

Cell["\<\
ArraySymmetry @ ArrayAdd[ArrayObject[{{1, 2}, {2, 3}}, \"Symmetric\"],
                         ArrayObject[{{0, 1}, {1, 0}}, \"Symmetric\"]]\
\>", "Input",ExpressionUUID->"2555a6f3-3626-9748-bc75-6e829f47f52f"],

Cell[BoxData["\<\"Symmetric\"\>"], "Output",ExpressionUUID->"ba5aa99c-58cc-174a-88f4-fd3876036f7e"],

Cell["Arrays of different dimensions cannot be added:", "ExampleText",ExpressionUUID->"30a0fc01-2146-8e4c-8407-c232006c4ba2"],

Cell["Quiet @ ArrayAdd[{1, 2}, {1, 2, 3}]", "Input",ExpressionUUID->"c36ed08d-4c74-7647-b5a5-126e54b3384d"],

Cell[BoxData["$Failed"], "Output",ExpressionUUID->"ae786b8c-7f1f-fd4c-b234-58e1d01a7f42"],

Cell["Source", "NotesSection",ExpressionUUID->"c50f785c-bc19-094c-8ee6-ea6d8cedd4f7"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/ArrayAlgebra.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Element-wise operations",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"0bd21183-2f3b-634f-bc2c-4f04dac74de4"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"4316aec5-8e56-9b4f-9313-00bdda02f3e9"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayTimes", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "582ccdf0-83f8-ea43-83ec-a5ed8dc30d07"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayMultiply", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "e1fdd597-d1ef-2543-8aea-eb208cd60fce"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayObject", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "13061881-a64c-6844-877e-eb8b68fae625"],
 ", ",
 Cell[BoxData[
  StyleBox["GenerateSymbolicArray", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"52a7f6b8-0249-f14c-88c7-b143cd48beb9"],
 ", ",
 Cell[BoxData[
  StyleBox["ZeroArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "95e3a53e-7d47-c145-b705-0a3055dc77be"]
}], "SeeAlso",ExpressionUUID->"09e74a15-ed5e-8249-8f99-290f2290af6b"]
},
