Notebook[{
Cell["ArrayAdd", "ObjectName",ExpressionUUID->"74158ac8-e118-854c-b156-6e03645e96ae"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayAdd", "[", 
    RowBox[{"arr1", ",", " ", "arr2", ",", " ", "..."}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "c9898874-9465-8b4c-bbd2-5fab4ad530c6"],
 " ",
 "adds the given arrays entry by entry."
}], "Usage",ExpressionUUID->"e2fa6a2a-4517-d946-adb3-d2cb9f8d8cea"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"28fb4bda-22be-f347-afd6-2b84f14645d0"],

Cell["\<\
The arrays are given directly, not in a list: a list of arrays is itself an \
array, and there would be no telling the two readings apart.\
\>", "Notes",ExpressionUUID->"5397d035-e7c4-e046-b28a-5b1637fd5520"],

Cell["\<\
Every argument must have the same dimensions, except that an array of order \
zero has no shape of its own and is added to every entry.\
\>", "Notes",ExpressionUUID->"f820b6ae-c4d1-d248-920f-034f18e03d5a"],

Cell["\<\
The arrays may be given as array objects or as plain nested lists, and \
entries of any kind may be combined: the operation acts on one entry at a \
time, so a number meeting an expression has the obvious reading. The result \
is an ArrayObject.\
\>", "Notes",ExpressionUUID->"63a5f029-75ec-234b-a0c3-c9a3c86ed2f2"],

Cell["\<\
A symmetry declared by every argument of order one or more is carried over to \
the result, since an entry-by-entry operation treats each index tuple \
separately. Where the arguments disagree, or where plain entries were given, \
nothing is claimed and the result is \"Rigid\".\
\>", "Notes",ExpressionUUID->"544eaeb6-bea6-7d49-960d-d6c6bcd043da"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"arr1", " ", "+", " ", "arr2"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"270b5b84-3bde-1a45-b9d6-f45bb49c99cf"],
 " is the same operation: Plus on an array object is ArrayAdd, so arrays may \
be combined in ordinary arithmetic notation."
}], "Notes",ExpressionUUID->"d5d65296-795a-5242-a305-3c0f6ad68eb5"],

Cell["\<\
Arrays of different dimensions give ArrayAdd::dims and $Failed.\
\>", "Notes",ExpressionUUID->"7f4e9dc5-582a-1242-b48e-9664161674c6"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"e7f45f3c-3652-b240-aa5b-6cf7c5becf16"],

Cell["Entry by entry:", "ExampleText",ExpressionUUID->"e90b9905-5c35-e849-b6ff-ce6916f282d9"],

Cell["\<\
u = {{1, 2}, {3, 4}}; v = {{5, 6}, {7, 8}};
Normal @ ArrayAdd[u, v]\
\>", "Input",ExpressionUUID->"02149d4e-3a59-aa49-bacd-fbdc2e688cce"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"6", ",", "8"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"10", ",", "12"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"5d191576-e409-3046-ac9c-2ea8b80464f7"],

Cell["Ordinary arithmetic notation does the same:", "ExampleText",ExpressionUUID->"4d0b88fd-0582-4b4d-a840-95cf193d37a4"],

Cell["Normal[ArrayObject[u] + ArrayObject[v]]", "Input",ExpressionUUID->"31ddce48-15b1-694d-afb9-3b8227c167f5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"6", ",", "8"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"10", ",", "12"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"330157d7-1112-7a4b-9227-f71ca44d10df"],

Cell["\<\
A difference is a sum with a scalar multiple, so that works too:\
\>", "ExampleText",ExpressionUUID->"04269630-b446-6d4c-8ca5-c01c8c9155c3"],

Cell["Normal[ArrayObject[u] - ArrayObject[v]]", "Input",ExpressionUUID->"1be27b24-3cec-f24c-a7e7-6dbcf54b6966"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "4"}], ",", 
     RowBox[{"-", "4"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "4"}], ",", 
     RowBox[{"-", "4"}]}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"4ff03f62-0a8d-a548-8281-b0e43b66f1db"],

Cell["\<\
An array of order zero has no shape of its own and reaches every entry:\
\>", "ExampleText",ExpressionUUID->"580f6cc4-b6de-8841-9df8-7abfadb99de4"],

Cell["Normal @ ArrayAdd[1, u]", "Input",ExpressionUUID->"8902d15b-5f1d-6d4d-a0b6-553648af8579"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"4", ",", "5"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"75be25a0-35ba-9844-8a89-b3cf94ff7624"],

Cell["A symmetry shared by the arguments is carried over:", "ExampleText",ExpressionUUID->"149c44d5-5860-0644-9b94-dd0c9340b39d"],

Cell["\<\
ArraySymmetry @ ArrayAdd[ArrayObject[{{1, 2}, {2, 3}}, \"Symmetric\"],
                         ArrayObject[{{0, 1}, {1, 0}}, \"Symmetric\"]]\
\>", "Input",ExpressionUUID->"58b74eab-7102-0546-bd47-f4a9d3dbed32"],

Cell[BoxData["\<\"Symmetric\"\>"], "Output",ExpressionUUID->"00e2e739-afaf-7d4a-bd97-361b37598cd9"],

Cell["Arrays of different dimensions cannot be added:", "ExampleText",ExpressionUUID->"f1c6fb7f-17fd-d74c-a866-44fb60d3e22c"],

Cell["Quiet @ ArrayAdd[{1, 2}, {1, 2, 3}]", "Input",ExpressionUUID->"27e47fd9-54d3-8e4f-8378-a5d8d8c723c9"],

Cell[BoxData["$Failed"], "Output",ExpressionUUID->"a33f6cd3-da6b-094c-a537-ff4ffbb95fde"],

Cell["Source", "NotesSection",ExpressionUUID->"5292a4f4-a3d4-9244-b938-e5e44b473f14"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/ArrayAlgebra.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Element-wise operations",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"bb4cb12b-3ac1-cf41-a268-929d480c09c1"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"d68032a5-717c-8f45-abfe-c4374c3da42c"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayTimes", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "b202c5e6-258e-3042-b0e2-7065b4699080"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayMultiply", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "a968a249-9f4d-d64e-8c5a-b2d3f386db56"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayObject", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "615ef2ad-a1aa-4047-b60b-5a010faf6412"],
 ", ",
 Cell[BoxData[
  StyleBox["GenerateSymbolicArray", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"4db66e6d-956a-a64b-a7de-91b39e1c5f7a"],
 ", ",
 Cell[BoxData[
  StyleBox["ZeroArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "39781dd8-8cb8-5241-a82e-9ad349abf7d2"]
}], "SeeAlso",ExpressionUUID->"88903980-94ab-7541-89fd-07a0af840902"]
},
