Notebook[{
Cell["ArrayAdd", "ObjectName",ExpressionUUID->"144fdd88-ffb4-f14a-b2d0-9971370e3d65"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayAdd", "[", 
    RowBox[{"arr1", ",", " ", "arr2", ",", " ", "..."}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "66264a67-2026-0b4c-8848-5a4750fe2738"],
 " ",
 "adds the given arrays entry by entry."
}], "Usage",ExpressionUUID->"6c51162a-5948-8f4d-a4dc-965c4debc1ba"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"07809ed0-4a6a-3548-b430-2c1df675a014"],

Cell["\<\
The arrays are given directly, not in a list: a list of arrays is itself an \
array, and there would be no telling the two readings apart.\
\>", "Notes",ExpressionUUID->"017c4ff0-e7fd-ee46-b8aa-b21084f123c5"],

Cell["\<\
Every argument must have the same dimensions, except that an array of order \
zero has no shape of its own and is added to every entry.\
\>", "Notes",ExpressionUUID->"c0af4b50-0446-bc42-b4ff-6bc9bd4cc983"],

Cell["\<\
The arrays may be given as array objects or as plain nested lists, and \
entries of any kind may be combined: the operation acts on one entry at a \
time, so a number meeting an expression has the obvious reading. The result \
is an ArrayObject.\
\>", "Notes",ExpressionUUID->"2326388d-3bf1-da4f-b8fc-5142a061bfc4"],

Cell["\<\
A symmetry declared by every argument of order one or more is carried over to \
the result, since an entry-by-entry operation treats each index tuple \
separately. Where the arguments disagree, or where plain entries were given, \
nothing is claimed and the result is \"Rigid\".\
\>", "Notes",ExpressionUUID->"91890578-6d2f-894c-b82c-39ae89bef360"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"arr1", " ", "+", " ", "arr2"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"5e6fbd07-9bfd-c14b-a238-ce52b1ba710f"],
 " is the same operation: Plus on an array object is ArrayAdd, so arrays may \
be combined in ordinary arithmetic notation."
}], "Notes",ExpressionUUID->"c6cd3c3d-e88b-394b-9e3b-5a3c1ef06d4d"],

Cell["\<\
Arrays of different dimensions give ArrayAdd::dims and $Failed.\
\>", "Notes",ExpressionUUID->"0c872303-1c17-274b-8fc1-b9a4d0d9b458"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"38a0e5f4-d489-e941-9792-269dcc7ce17e"],

Cell["Entry by entry:", "ExampleText",ExpressionUUID->"aae217a6-adc7-b248-b518-5c3192c89962"],

Cell["\<\
u = {{1, 2}, {3, 4}}; v = {{5, 6}, {7, 8}};
Normal @ ArrayAdd[u, v]\
\>", "Input",ExpressionUUID->"b1b677f6-eafa-e94b-8fd6-a17d58a708b3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"6", ",", "8"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"10", ",", "12"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"34b1d6d4-2b48-9745-ae51-22e723c7d4a4"],

Cell["Ordinary arithmetic notation does the same:", "ExampleText",ExpressionUUID->"d0a9c2f0-5f80-534a-814b-62be61786a37"],

Cell["Normal[ArrayObject[u] + ArrayObject[v]]", "Input",ExpressionUUID->"db5e651e-9d0a-6642-92fc-4775762e67a2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"6", ",", "8"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"10", ",", "12"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"45a3fc85-1280-e644-aea4-3488e740ddb5"],

Cell["\<\
A difference is a sum with a scalar multiple, so that works too:\
\>", "ExampleText",ExpressionUUID->"dd0e0731-1624-f249-9b92-efcc1ac03626"],

Cell["Normal[ArrayObject[u] - ArrayObject[v]]", "Input",ExpressionUUID->"72df96d2-d3b6-aa49-8259-5d99cd17ef79"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "4"}], ",", 
     RowBox[{"-", "4"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "4"}], ",", 
     RowBox[{"-", "4"}]}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"479a5ddd-440f-3f4e-869a-90d64170808f"],

Cell["\<\
An array of order zero has no shape of its own and reaches every entry:\
\>", "ExampleText",ExpressionUUID->"af98c5d0-f687-0d48-b4b0-edc1bcfc4c0d"],

Cell["Normal @ ArrayAdd[1, u]", "Input",ExpressionUUID->"b90af3b3-ffb5-184a-bc62-6c075528f4cd"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"4", ",", "5"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"45c2a603-d2ba-304a-9979-6a2cd4b2cbdc"],

Cell["A symmetry shared by the arguments is carried over:", "ExampleText",ExpressionUUID->"a498556a-8a9f-0c4e-8dbb-68df2ec8ceec"],

Cell["\<\
ArraySymmetry @ ArrayAdd[ArrayObject[{{1, 2}, {2, 3}}, \"Symmetric\"],
                         ArrayObject[{{0, 1}, {1, 0}}, \"Symmetric\"]]\
\>", "Input",ExpressionUUID->"b54dbdde-f308-474c-b4dd-2e6acdc35b4c"],

Cell[BoxData["\<\"Symmetric\"\>"], "Output",ExpressionUUID->"c300950d-f4c5-6a4c-8064-84610d1a07c7"],

Cell["Arrays of different dimensions cannot be added:", "ExampleText",ExpressionUUID->"bf758186-b88e-3f43-82d9-595378bb0fda"],

Cell["Quiet @ ArrayAdd[{1, 2}, {1, 2, 3}]", "Input",ExpressionUUID->"01d9aeae-a554-3243-b716-85cd38daa41c"],

Cell[BoxData["$Failed"], "Output",ExpressionUUID->"80813cfa-85bd-1c4c-b295-6185881e57d4"],

Cell["Source", "NotesSection",ExpressionUUID->"f90f71b4-77a2-9547-b744-df9c14bf96ab"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/ArrayAlgebra.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Element-wise operations",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"37cbe82c-28b0-7d46-acc3-020f5e3296cb"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"928a965c-ee2b-7041-804f-2de495715f84"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayTimes", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "ed52a38d-b973-4848-8ab0-c21b7746e050"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayMultiply", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "cb0e484f-2c3f-f247-9416-b0978aeddbbc"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayObject", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "d4a2a6b6-10ff-fb42-abfd-7ad53848d1c0"],
 ", ",
 Cell[BoxData[
  StyleBox["GenerateSymbolicArray", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"4297cabd-4f7c-7244-ba9c-a14a6afb4d48"],
 ", ",
 Cell[BoxData[
  StyleBox["ZeroArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "1377d958-edc2-1a41-99de-c6282786253f"]
}], "SeeAlso",ExpressionUUID->"17d585e6-3917-5545-9c5b-9d6b851bd8d5"]
},
