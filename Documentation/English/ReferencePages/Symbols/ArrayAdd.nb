Notebook[{
Cell["ArrayAdd", "ObjectName",ExpressionUUID->"d2d806f9-2351-4e44-bd3c-0fa8af562497"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayAdd", "[", 
    RowBox[{"arr1", ",", " ", "arr2", ",", " ", "..."}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "f36da217-c949-0940-859f-e821f2aa4445"],
 " ",
 "adds the given arrays entry by entry."
}], "Usage",ExpressionUUID->"2483dba1-582a-ef4c-9bfe-dfced1c6f9ee"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"787afcb0-37d5-0d43-9688-54a17841f4df"],

Cell["\<\
The arrays are given directly, not in a list: a list of arrays is itself an \
array, and there would be no telling the two readings apart.\
\>", "Notes",ExpressionUUID->"7947fc6f-2283-b143-81fe-d7b156e13868"],

Cell["\<\
Every argument must have the same dimensions, except that an array of order \
zero has no shape of its own and is added to every entry.\
\>", "Notes",ExpressionUUID->"4c1ba689-41fb-8a45-9b2b-9e3f1f9a9f0b"],

Cell["\<\
The arrays may be given as array objects or as plain nested lists, and \
entries of any kind may be combined: the operation acts on one entry at a \
time, so a number meeting an expression has the obvious reading. The result \
is an ArrayObject.\
\>", "Notes",ExpressionUUID->"10f11629-85b4-344f-b7eb-e5dd7ce87435"],

Cell["\<\
A symmetry declared by every argument of order one or more is carried over to \
the result, since an entry-by-entry operation treats each index tuple \
separately. Where the arguments disagree, or where plain entries were given, \
nothing is claimed and the result is \"Rigid\".\
\>", "Notes",ExpressionUUID->"7e398fdd-eccb-fb4d-8f8a-861072e9bde2"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"arr1", " ", "+", " ", "arr2"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"cee21c87-f8f7-5340-bbf0-a6a24a097400"],
 " is the same operation: Plus on an array object is ArrayAdd, so arrays may \
be combined in ordinary arithmetic notation."
}], "Notes",ExpressionUUID->"2d4c22dc-b64e-8243-a709-0e6ae416616a"],

Cell["\<\
Arrays of different dimensions give ArrayAdd::dims and $Failed.\
\>", "Notes",ExpressionUUID->"d2f4b866-a342-9143-af04-2630c7ccae01"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"33031470-0050-3d4b-8690-ca6983750d64"],

Cell["Entry by entry:", "ExampleText",ExpressionUUID->"410598ef-bab3-5746-aa19-f3d7fc94d176"],

Cell["\<\
u = {{1, 2}, {3, 4}}; v = {{5, 6}, {7, 8}};
Normal @ ArrayAdd[u, v]\
\>", "Input",ExpressionUUID->"bb603698-0c80-e44c-922b-680fecd74a47"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"6", ",", "8"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"10", ",", "12"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"85a6f394-6d6a-764d-9be1-301767be8ad9"],

Cell["Ordinary arithmetic notation does the same:", "ExampleText",ExpressionUUID->"f4c3be7b-ea44-2145-bc0d-1961433a0aa3"],

Cell["Normal[ArrayObject[u] + ArrayObject[v]]", "Input",ExpressionUUID->"86446264-f96b-f442-b488-df74ee77f55b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"6", ",", "8"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"10", ",", "12"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"c42bfc39-2673-c54d-995a-832a484956a6"],

Cell["\<\
A difference is a sum with a scalar multiple, so that works too:\
\>", "ExampleText",ExpressionUUID->"1b444407-2087-964b-b040-be753d8cf7aa"],

Cell["Normal[ArrayObject[u] - ArrayObject[v]]", "Input",ExpressionUUID->"3a5628ce-eb62-bc4b-9adc-a1fba66a3e75"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "4"}], ",", 
     RowBox[{"-", "4"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "4"}], ",", 
     RowBox[{"-", "4"}]}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"e5614c4e-3dd9-5240-bb1d-d1449ae23868"],

Cell["\<\
An array of order zero has no shape of its own and reaches every entry:\
\>", "ExampleText",ExpressionUUID->"4a075552-9b93-5b4d-901a-df81f10440cf"],

Cell["Normal @ ArrayAdd[1, u]", "Input",ExpressionUUID->"306ce0f6-8cf4-6849-bf3e-67b1d3527750"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"4", ",", "5"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"c9df028a-3342-1043-bdbd-c7aaf8e08055"],

Cell["A symmetry shared by the arguments is carried over:", "ExampleText",ExpressionUUID->"52a102f5-b821-2249-89b7-9f2d69488d7c"],

Cell["\<\
ArraySymmetry @ ArrayAdd[ArrayObject[{{1, 2}, {2, 3}}, \"Symmetric\"],
                         ArrayObject[{{0, 1}, {1, 0}}, \"Symmetric\"]]\
\>", "Input",ExpressionUUID->"1dc36ddd-e6a9-3d46-92b6-483cfbebac59"],

Cell[BoxData["\<\"Symmetric\"\>"], "Output",ExpressionUUID->"61f47fa3-9ad9-d347-9b32-a12018195641"],

Cell["Arrays of different dimensions cannot be added:", "ExampleText",ExpressionUUID->"f1cdc883-3fc2-e743-95f3-e22a18c04142"],

Cell["Quiet @ ArrayAdd[{1, 2}, {1, 2, 3}]", "Input",ExpressionUUID->"c75563f7-6818-8b49-8067-e1543bece0e1"],

Cell[BoxData["$Failed"], "Output",ExpressionUUID->"c92297a8-378f-4143-bafd-dc1f0a68ddb4"],

Cell["Source", "NotesSection",ExpressionUUID->"97c62a31-aa67-6446-aee8-eadb50ab745d"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/ArrayAlgebra.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Element-wise operations",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"d8e3ecaf-f0ce-9148-b3da-a205df49b8f2"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"ac5ecb4f-eeb0-c641-91f7-8d818d0a9b62"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayTimes", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "d037d7c0-6e7c-ab49-a6e8-f0d3739c80f2"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayMultiply", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "10f8b584-6b5b-3644-baf3-e0338fa10d72"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayObject", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "61d1e088-15ce-b94a-b586-2fb5083c362a"],
 ", ",
 Cell[BoxData[
  StyleBox["GenerateSymbolicArray", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"95ea85e2-bafa-6545-a83a-2c599c6c8fce"],
 ", ",
 Cell[BoxData[
  StyleBox["ZeroArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "1ae53aba-6a19-9f44-9c63-ce9c99090012"]
}], "SeeAlso",ExpressionUUID->"75ffc1af-b635-f346-8021-6279763fc33f"]
},
