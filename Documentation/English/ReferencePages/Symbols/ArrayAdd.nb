Notebook[{
Cell["ArrayAdd", "ObjectName",ExpressionUUID->"f8660388-81d3-b742-a1bf-75d5f80fb2da"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayAdd", "[", 
    RowBox[{"arr1", ",", " ", "arr2", ",", " ", "..."}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "c7115238-889a-f847-b99b-816d04fe2e79"],
 " ",
 "adds the given arrays entry by entry."
}], "Usage",ExpressionUUID->"a4972a6b-992f-e646-9577-ce943946de35"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"f0023eef-4176-e04d-bb16-8b5e0a19ca44"],

Cell["\<\
The arrays are given directly, not in a list: a list of arrays is itself an \
array, and there would be no telling the two readings apart.\
\>", "Notes",ExpressionUUID->"a3bbbf66-0055-6d42-a552-6bc280dfdfa9"],

Cell["\<\
Every argument must have the same dimensions, except that an array of order \
zero has no shape of its own and is added to every entry.\
\>", "Notes",ExpressionUUID->"e7a5e4f6-f375-7d48-b67d-8a7ad80ee6ee"],

Cell["\<\
The arrays may be given as array objects or as plain nested lists, and \
entries of any kind may be combined: the operation acts on one entry at a \
time, so a number meeting an expression has the obvious reading. The result \
is an ArrayObject.\
\>", "Notes",ExpressionUUID->"72633f49-59ca-d34f-a6a6-37782e5a4085"],

Cell["\<\
A symmetry declared by every argument of order one or more is carried over to \
the result, since an entry-by-entry operation treats each index tuple \
separately. Where the arguments disagree, or where plain entries were given, \
nothing is claimed and the result is \"Rigid\".\
\>", "Notes",ExpressionUUID->"afb44416-4716-4849-96a8-e067e43c684d"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"arr1", " ", "+", " ", "arr2"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"c658e3ea-b66e-a540-93e7-6b8330d83d46"],
 " is the same operation: Plus on an array object is ArrayAdd, so arrays may \
be combined in ordinary arithmetic notation."
}], "Notes",ExpressionUUID->"07dcfa92-0d43-e843-a9a4-d35eb8fe7b48"],

Cell["\<\
Arrays of different dimensions give ArrayAdd::dims and $Failed.\
\>", "Notes",ExpressionUUID->"25a4c714-5e7a-7d4b-9cf3-ac88dfa810c4"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"0aabc2d0-09f1-0f47-94ce-9f5344e7994d"],

Cell["Entry by entry:", "ExampleText",ExpressionUUID->"858cb8d9-24ac-6943-8db6-8a0f9ee59c84"],

Cell["\<\
u = {{1, 2}, {3, 4}}; v = {{5, 6}, {7, 8}};
Normal @ ArrayAdd[u, v]\
\>", "Input",ExpressionUUID->"b89fe308-cea8-d849-b41c-d0a1d9935e13"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"6", ",", "8"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"10", ",", "12"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"3c915a3f-48c4-4c40-a7b1-224cee5921b0"],

Cell["Ordinary arithmetic notation does the same:", "ExampleText",ExpressionUUID->"310b8425-55b8-6348-8e02-bacc7929ab91"],

Cell["Normal[ArrayObject[u] + ArrayObject[v]]", "Input",ExpressionUUID->"fd079dde-dee4-af45-a438-683acad6bc23"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"6", ",", "8"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"10", ",", "12"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"1052ea69-fab7-2d41-a13b-5252f39d03d0"],

Cell["\<\
A difference is a sum with a scalar multiple, so that works too:\
\>", "ExampleText",ExpressionUUID->"01f28dca-961c-f143-973b-15cd8e4b674b"],

Cell["Normal[ArrayObject[u] - ArrayObject[v]]", "Input",ExpressionUUID->"a8e0cef0-087c-6d4b-9427-333d3738f15d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "4"}], ",", 
     RowBox[{"-", "4"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "4"}], ",", 
     RowBox[{"-", "4"}]}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"3e6c3058-c369-8e49-8121-c1b97b59f7bb"],

Cell["\<\
An array of order zero has no shape of its own and reaches every entry:\
\>", "ExampleText",ExpressionUUID->"6e31313c-32c7-9544-86cc-ab9c74a87f54"],

Cell["Normal @ ArrayAdd[1, u]", "Input",ExpressionUUID->"2692b468-d5a8-0c4d-8271-5d8864593286"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"4", ",", "5"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"aaf1eaec-6f1f-374f-9db9-17d8b78c33de"],

Cell["A symmetry shared by the arguments is carried over:", "ExampleText",ExpressionUUID->"9f63b553-2e7a-4148-9e44-0362b4c8afc8"],

Cell["\<\
ArraySymmetry @ ArrayAdd[ArrayObject[{{1, 2}, {2, 3}}, \"Symmetric\"],
                         ArrayObject[{{0, 1}, {1, 0}}, \"Symmetric\"]]\
\>", "Input",ExpressionUUID->"01840417-91c3-ca4e-bac3-1a4c40408cf7"],

Cell[BoxData["\<\"Symmetric\"\>"], "Output",ExpressionUUID->"89f523a3-c2a4-4444-bc26-687bd6e13e61"],

Cell["Arrays of different dimensions cannot be added:", "ExampleText",ExpressionUUID->"dfbbd0ea-c74a-dd47-b938-d487ec06ecd6"],

Cell["Quiet @ ArrayAdd[{1, 2}, {1, 2, 3}]", "Input",ExpressionUUID->"7308e8f9-d72f-0840-aba4-395fd63c4b48"],

Cell[BoxData["$Failed"], "Output",ExpressionUUID->"2fcfed69-bd2d-f945-9a8f-dd07b0c063eb"],

Cell["Source", "NotesSection",ExpressionUUID->"382efa70-43a5-7042-840d-9f811ee5330f"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/ArrayAlgebra.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Element-wise operations",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"0f370e21-42af-f043-8329-14c7409986a2"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"4e84f74e-bf21-f849-8a32-b382befc242d"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayTimes", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "7c956698-857b-c745-9ecf-9777dc38868a"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayMultiply", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "c99a33d9-7e20-6740-b53c-dcec79613420"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayObject", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "979554ec-4c63-964d-9565-05f39393b215"],
 ", ",
 Cell[BoxData[
  StyleBox["GenerateSymbolicArray", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"bccec6fc-31d9-264c-a6a4-f36d2bc9a273"],
 ", ",
 Cell[BoxData[
  StyleBox["ZeroArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "6d1716b8-b31e-bb4a-9a47-fbc72da8ac8e"]
}], "SeeAlso",ExpressionUUID->"463bade7-a71b-e14e-a583-cbe516ab1770"]
},
