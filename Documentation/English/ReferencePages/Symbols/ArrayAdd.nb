Notebook[{
Cell["ArrayAdd", "ObjectName",ExpressionUUID->"1d90015a-d145-8a4e-882e-fb6eedd39b58"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayAdd", "[", 
    RowBox[{"arr1", ",", " ", "arr2", ",", " ", "..."}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "66c9468c-2031-ae47-ac13-de522865d41d"],
 " ",
 "adds the given arrays entry by entry."
}], "Usage",ExpressionUUID->"afdea550-3aad-fd43-a670-0b2af00f37d0"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"1bb08435-0336-c344-8690-34d40e29199e"],

Cell["\<\
The arrays are given directly, not in a list: a list of arrays is itself an \
array, and there would be no telling the two readings apart.\
\>", "Notes",ExpressionUUID->"7b92222a-ab6e-224f-a216-541e71c8ae62"],

Cell["\<\
Every argument must have the same dimensions, except that an array of order \
zero has no shape of its own and is added to every entry.\
\>", "Notes",ExpressionUUID->"bb352ee4-9da7-2d42-a6f5-2c3c324c10e8"],

Cell["\<\
The arrays may be given as array objects or as plain nested lists, and \
entries of any kind may be combined: the operation acts on one entry at a \
time, so a number meeting an expression has the obvious reading. The result \
is an ArrayObject.\
\>", "Notes",ExpressionUUID->"b6536189-c27b-c043-9cf0-88720a401433"],

Cell["\<\
A symmetry declared by every argument of order one or more is carried over to \
the result, since an entry-by-entry operation treats each index tuple \
separately. Where the arguments disagree, or where plain entries were given, \
nothing is claimed and the result is \"Rigid\".\
\>", "Notes",ExpressionUUID->"37f4f777-95cc-6e42-a684-f5a340d2ff9d"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"arr1", " ", "+", " ", "arr2"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"03d65bee-72a1-ec4b-a74d-3dc9428dbca1"],
 " is the same operation: Plus on an array object is ArrayAdd, so arrays may \
be combined in ordinary arithmetic notation."
}], "Notes",ExpressionUUID->"bfd5cc6b-96c2-b04f-a9e5-732fa447388f"],

Cell["\<\
Arrays of different dimensions give ArrayAdd::dims and $Failed.\
\>", "Notes",ExpressionUUID->"2956b5d1-8d68-b94d-83bc-d2d211a5de0e"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"1a15c4b2-749a-354c-a594-ac865aa29898"],

Cell["Entry by entry:", "ExampleText",ExpressionUUID->"ed6414bb-e70c-804c-b86c-e9303ad6e29e"],

Cell["\<\
u = {{1, 2}, {3, 4}}; v = {{5, 6}, {7, 8}};
Normal @ ArrayAdd[u, v]\
\>", "Input",ExpressionUUID->"e9df570f-5320-984c-bf0a-934c5b8cffcc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"6", ",", "8"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"10", ",", "12"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"757a1236-88de-a448-ba30-122498b9b256"],

Cell["Ordinary arithmetic notation does the same:", "ExampleText",ExpressionUUID->"115d2d09-9201-f043-b6b1-8941a03441b1"],

Cell["Normal[ArrayObject[u] + ArrayObject[v]]", "Input",ExpressionUUID->"2d8de702-327d-ec44-bad1-2d054b3ed158"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"6", ",", "8"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"10", ",", "12"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"98b97b08-1c66-ad4c-ab79-f7e177c388e0"],

Cell["\<\
A difference is a sum with a scalar multiple, so that works too:\
\>", "ExampleText",ExpressionUUID->"08334981-a273-ca45-898d-8a426a040dc3"],

Cell["Normal[ArrayObject[u] - ArrayObject[v]]", "Input",ExpressionUUID->"caf6c10b-2e2c-0647-bb3b-7609687ed082"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "4"}], ",", 
     RowBox[{"-", "4"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "4"}], ",", 
     RowBox[{"-", "4"}]}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"0cf941a0-c87c-6346-bb6b-a991bf21e59d"],

Cell["\<\
An array of order zero has no shape of its own and reaches every entry:\
\>", "ExampleText",ExpressionUUID->"978bbb66-c63a-8a45-9796-c8515b14bc29"],

Cell["Normal @ ArrayAdd[1, u]", "Input",ExpressionUUID->"c6fdc7c7-922a-d24a-8565-a69a08d39ab6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"4", ",", "5"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"87753ec7-8dcd-9a4d-86c6-a9a4e71b962b"],

Cell["A symmetry shared by the arguments is carried over:", "ExampleText",ExpressionUUID->"9ac6b8f2-5a87-c541-b978-d27eb726a10b"],

Cell["\<\
ArraySymmetry @ ArrayAdd[ArrayObject[{{1, 2}, {2, 3}}, \"Symmetric\"],
                         ArrayObject[{{0, 1}, {1, 0}}, \"Symmetric\"]]\
\>", "Input",ExpressionUUID->"bd83d2de-173d-514d-a889-b33c24dfc78f"],

Cell[BoxData["\<\"Symmetric\"\>"], "Output",ExpressionUUID->"ecf16589-05f7-ea40-a9c5-2fa865194d79"],

Cell["Arrays of different dimensions cannot be added:", "ExampleText",ExpressionUUID->"b587a540-b95d-a541-92b7-adfdefb30fa0"],

Cell["Quiet @ ArrayAdd[{1, 2}, {1, 2, 3}]", "Input",ExpressionUUID->"a6286d95-3ae5-4646-9ce1-2ebbc5db1a00"],

Cell[BoxData["$Failed"], "Output",ExpressionUUID->"34342c6c-a338-af49-abb9-4ee716e50339"],

Cell["Source", "NotesSection",ExpressionUUID->"2a940e14-f9e5-cb49-a5d4-4db22ed1b793"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/ArrayAlgebra.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Element-wise operations",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"2d09baff-cbff-eb4a-b005-8579806f5ff1"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"4edbda96-952b-5f46-9c16-7b4668f99800"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayTimes", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "63762ea9-97d5-7746-b9b5-b1664a064b08"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayMultiply", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "b54427c5-702b-3146-9de1-474b3fd7406b"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayObject", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "ef1d7d33-d165-9340-b235-80cd3d4a6568"],
 ", ",
 Cell[BoxData[
  StyleBox["GenerateSymbolicArray", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"2663ca01-78ae-2142-b67a-69b4121cdcaa"],
 ", ",
 Cell[BoxData[
  StyleBox["ZeroArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "fe4cfa94-7006-5946-88a4-7d4f44a6c07e"]
}], "SeeAlso",ExpressionUUID->"320d8e11-18dd-c249-aa71-28fd79146e48"]
},
