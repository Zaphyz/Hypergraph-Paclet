Notebook[{
Cell["ArrayDimensions", "ObjectName",ExpressionUUID->"84b70b1d-074d-674e-8b0c-0b4b0ba11902"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayDimensions", "[", "arr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"60ebf1da-0f7c-d44c-bc74-460d64e832c4"],
 " ",
 "gives the list of lengths of the indices of arr."
}], "Usage",ExpressionUUID->"9ae68e5e-11cc-c14e-8d62-e0d9a31236be"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"c9c9535c-bc1c-f740-9df7-20d0bad106a9"],

Cell["\<\
Dimensions[arr] gives the same list. Dimensions is a protected System` \
symbol, extended here with UpValues on the two array heads rather than \
redefined.\
\>", "Notes",ExpressionUUID->"dd2558b8-216b-e14a-9b92-08de912c4c36"],

Cell["\<\
An array is regular when all of these lengths are equal, and irregular \
otherwise; see RegularArrayQ. An array of order zero has no lengths at all, \
so its list of dimensions is empty and it counts as regular.\
\>", "Notes",ExpressionUUID->"f3cc179c-fbaf-414e-ac7b-2c51bd393802"],

Cell["\<\
Dimensions are the second criterion by which a Hypermatrix orders its arrays, \
compared term by term among arrays of equal order.\
\>", "Notes",ExpressionUUID->"d710a889-1ef0-d245-ae37-27763e11d1c4"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"654a63e9-7f45-ab47-8ccc-fac4f607afcd"],

Cell["ArrayDimensions @ ArrayObject[{{1, 2, 3}, {4, 5, 6}}]", "Input",ExpressionUUID->"7f5df079-73a5-764c-a5ab-65aae0240867"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "3"}], "}"}]], "Output",ExpressionUUID->"17c42636-5bf4-1841-a78c-483e025b3667"],

Cell["Dimensions works directly on an array object:", "ExampleText",ExpressionUUID->"9a03cc42-8574-494b-aec4-89b1cb4b3d13"],

Cell["Dimensions @ GenerateSymbolicArray[a, {2, 3, 4}]", "Input",ExpressionUUID->"ff69e89c-e8cf-8147-b654-164536d2c90a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "3", ",", "4"}], "}"}]], "Output",ExpressionUUID->\
"b07daf4f-91d1-f146-bf05-888d8d28786e"],

Cell["Equal lengths make the array regular:", "ExampleText",ExpressionUUID->"82ad6182-fe68-094e-96d6-2d0e19c000de"],

Cell["\<\
{RegularArrayQ @ ArrayObject[{{1, 2, 3}, {4, 5, 6}}],
 RegularArrayQ @ ArrayObject[{{1, 2}, {3, 4}}]}\
\>", "Input",ExpressionUUID->"2744b993-8531-4a45-87f9-c268207ca655"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "True"}], "}"}]], "Output",ExpressionUUID->"ea4fd339-\
49f8-ed4f-9866-a846619858f8"],

Cell["Source", "NotesSection",ExpressionUUID->"3f365ad5-9e38-624a-95ef-e3acaea5abb5"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Array accessors",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"ef34c82c-6758-a849-9a5d-cb1b68eb6835"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"1eb7216d-5714-ab49-aae1-79cfbd4a745e"],

