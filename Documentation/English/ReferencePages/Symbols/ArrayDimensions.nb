Notebook[{
Cell["ArrayDimensions", "ObjectName",ExpressionUUID->"be6bffcc-1a7a-c443-aa4b-45cc13633843"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayDimensions", "[", "arr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"6abaf2af-0017-a140-ba73-29281d1e2b40"],
 " ",
 "gives the list of lengths of the indices of arr."
}], "Usage",ExpressionUUID->"32762d65-9bb8-f34e-ab4b-b4df0815ec25"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"03c02eb9-40c6-6a4e-a872-615ebfb4fc78"],

Cell["\<\
Dimensions[arr] gives the same list. Dimensions is a protected System` \
symbol, extended here with UpValues on the two array heads rather than \
redefined.\
\>", "Notes",ExpressionUUID->"1b8806a8-1e0c-9949-ae38-6d5cfcd88da3"],

Cell["\<\
An array is regular when all of these lengths are equal, and irregular \
otherwise; see RegularArrayQ. An array of order zero has no lengths at all, \
so its list of dimensions is empty and it counts as regular.\
\>", "Notes",ExpressionUUID->"0aff14b3-535d-7647-b5ac-7e14505aba60"],

Cell["\<\
Dimensions are the second criterion by which a Hypermatrix orders its arrays, \
compared term by term among arrays of equal order.\
\>", "Notes",ExpressionUUID->"17525910-e962-2141-a118-8ee19973ded4"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"36a258de-0049-db4d-8600-fbe8a7869603"],

Cell["ArrayDimensions @ ArrayObject[{{1, 2, 3}, {4, 5, 6}}]", "Input",ExpressionUUID->"52987390-f99c-8e42-aa91-437d0cfff1e4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "3"}], "}"}]], "Output",ExpressionUUID->"0e1685db-1205-eb4b-960c-1c633ae4c97f"],

Cell["Dimensions works directly on an array object:", "ExampleText",ExpressionUUID->"afa894dc-faa9-a04b-8384-d10253b4c790"],

Cell["Dimensions @ GenerateSymbolicArray[a, {2, 3, 4}]", "Input",ExpressionUUID->"f60a2c10-eba2-584d-bc53-e5982e90593d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "3", ",", "4"}], "}"}]], "Output",ExpressionUUID->\
"fc8c9a79-56e0-a549-bb60-546bda93d67e"],

Cell["Equal lengths make the array regular:", "ExampleText",ExpressionUUID->"d8268009-86ba-4244-9574-c9a3d7cf0be8"],

Cell["\<\
{RegularArrayQ @ ArrayObject[{{1, 2, 3}, {4, 5, 6}}],
 RegularArrayQ @ ArrayObject[{{1, 2}, {3, 4}}]}\
\>", "Input",ExpressionUUID->"daeb8cbe-1f41-664d-af0a-b5e078181563"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "True"}], "}"}]], "Output",ExpressionUUID->"68b4965c-\
2fab-3d47-a501-f5ae34c33fe4"],

Cell["Source", "NotesSection",ExpressionUUID->"001aaedf-d10b-df41-9f8c-1a6430173d6c"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Array accessors",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"a29181f7-b688-ed44-9d13-a3cc4090ee94"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"d0e36342-5b02-bb4c-ba9d-0d1fb1888bce"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayOrder", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "cdb93c13-77cb-4e42-b7a6-387bafaadf1c"],
 ", ",
 Cell[BoxData[
  StyleBox["RegularArrayQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "7e0e0efc-f7b6-944f-a083-015a4a71646d"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayObject", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "d97b63cb-a43c-7146-917e-493a3a24acfc"],
 ", ",
 Cell[BoxData[
  StyleBox["GenerateSymbolicArray", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"ef34c0ab-cf39-c446-bfa6-092836673aaa"]
}], "SeeAlso",ExpressionUUID->"b83e2585-75a2-e143-99b3-d16fc809dd40"]
