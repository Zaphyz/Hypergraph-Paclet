Notebook[{
Cell["ArrayDimensions", "ObjectName",ExpressionUUID->"297631bb-73e9-784b-98a4-a02c92a24729"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayDimensions", "[", "arr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"c7d7a09d-4f65-5641-bbf5-dd9e54b60b21"],
 " ",
 "gives the list of lengths of the indices of arr."
}], "Usage",ExpressionUUID->"92f9a519-e14c-ca4d-8ed7-095b7a3f22d2"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"f36b923c-cb2f-734a-b0a1-0571628e7302"],

Cell["\<\
Dimensions[arr] gives the same list. Dimensions is a protected System` \
symbol, extended here with UpValues on the two array heads rather than \
redefined.\
\>", "Notes",ExpressionUUID->"4b2e5453-1023-b149-9d73-e3f2848e4523"],

Cell["\<\
An array is regular when all of these lengths are equal, and irregular \
otherwise; see RegularArrayQ. An array of order zero has no lengths at all, \
so its list of dimensions is empty and it counts as regular.\
\>", "Notes",ExpressionUUID->"cac01408-7aee-dc43-8a36-07d720a2aa0e"],

Cell["\<\
Dimensions are the second criterion by which a Hypermatrix orders its arrays, \
compared term by term among arrays of equal order.\
\>", "Notes",ExpressionUUID->"7fddee65-9991-4146-b8ef-1bba50aa1b77"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"67ce297c-07a2-1548-9fc9-38ac1bed62d0"],

Cell["ArrayDimensions @ ArrayObject[{{1, 2, 3}, {4, 5, 6}}]", "Input",ExpressionUUID->"10de3bb5-6a56-f64c-88c9-a6dce0162158"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "3"}], "}"}]], "Output",ExpressionUUID->"60c6fefa-d7b5-8a4a-8109-fe5edf02a2ec"],

Cell["Dimensions works directly on an array object:", "ExampleText",ExpressionUUID->"42021353-5af1-b346-ada5-ac6a0132385e"],

Cell["Dimensions @ GenerateSymbolicArray[a, {2, 3, 4}]", "Input",ExpressionUUID->"cc165d9e-5150-6147-ac3f-a32a3470ae32"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "3", ",", "4"}], "}"}]], "Output",ExpressionUUID->\
"5767d6ec-b25a-5f46-af82-4b19b7a3fc4e"],

Cell["Equal lengths make the array regular:", "ExampleText",ExpressionUUID->"897bbbea-f68f-8447-ac77-08181b29b37c"],

Cell["\<\
{RegularArrayQ @ ArrayObject[{{1, 2, 3}, {4, 5, 6}}],
 RegularArrayQ @ ArrayObject[{{1, 2}, {3, 4}}]}\
\>", "Input",ExpressionUUID->"76fe811f-df25-db43-b17d-2ef96dd2626e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "True"}], "}"}]], "Output",ExpressionUUID->"e4a63919-\
5ca1-e542-89ed-01c6d2b43aea"],

Cell["Source", "NotesSection",ExpressionUUID->"ab04889f-7a3e-bc40-bab3-27da55c42666"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Array accessors",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"31cab21b-de9c-c449-b54b-19066446eff2"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"ecb9f21c-942c-b342-91af-ac3c0cbd4bbf"],

