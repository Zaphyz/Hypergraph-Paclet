Notebook[{
Cell["ArrayDimensions", "ObjectName",ExpressionUUID->"a6246165-d24d-b443-b616-740ad16fb706"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayDimensions", "[", "arr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"85ac7be2-4448-a245-9d21-15a31b563dc6"],
 " ",
 "gives the list of lengths of the indices of arr."
}], "Usage",ExpressionUUID->"0bc81619-b0d2-f24c-b840-27e5ce7824cc"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"f39000b8-ca0f-274d-a844-ab4392482bd9"],

Cell["\<\
Dimensions[arr] gives the same list. Dimensions is a protected System` \
symbol, extended here with UpValues on the two array heads rather than \
redefined.\
\>", "Notes",ExpressionUUID->"306700f0-3d2e-4a47-b107-6ae7dbc76fb7"],

Cell["\<\
An array is regular when all of these lengths are equal, and irregular \
otherwise; see RegularArrayQ. An array of order zero has no lengths at all, \
so its list of dimensions is empty and it counts as regular.\
\>", "Notes",ExpressionUUID->"9a0d9186-de2b-a547-a033-db81cfd0661f"],

Cell["\<\
Dimensions are the second criterion by which a Hypermatrix orders its arrays, \
compared term by term among arrays of equal order.\
\>", "Notes",ExpressionUUID->"cc7fd238-5758-3641-a1bd-eca8100c55ed"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"3afc0db7-9742-be42-87e0-f5cc592c77cf"],

Cell["ArrayDimensions @ ArrayObject[{{1, 2, 3}, {4, 5, 6}}]", "Input",ExpressionUUID->"bfc05c66-6ff8-7341-8288-aad90ea3b227"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "3"}], "}"}]], "Output",ExpressionUUID->"8b687d02-e30f-1d47-b5bd-347195607a33"],

Cell["Dimensions works directly on an array object:", "ExampleText",ExpressionUUID->"21db72fa-5846-384b-8aa6-71809a3bb370"],

Cell["Dimensions @ GenerateSymbolicArray[a, {2, 3, 4}]", "Input",ExpressionUUID->"570bfe98-36e6-8847-9d3b-3c7fe106c8cd"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "3", ",", "4"}], "}"}]], "Output",ExpressionUUID->\
"54339311-d365-a64f-b5b6-24239c0d21f5"],

Cell["Equal lengths make the array regular:", "ExampleText",ExpressionUUID->"12ef0e70-4859-8244-afde-8debcd52ca2b"],

Cell["\<\
{RegularArrayQ @ ArrayObject[{{1, 2, 3}, {4, 5, 6}}],
 RegularArrayQ @ ArrayObject[{{1, 2}, {3, 4}}]}\
\>", "Input",ExpressionUUID->"4f34cf2f-d6a2-e940-b821-3214fb17a20f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "True"}], "}"}]], "Output",ExpressionUUID->"53dd902f-\
51e4-9a43-87f8-70a4b972d838"],

Cell["Source", "NotesSection",ExpressionUUID->"fc8c391f-3ffc-6b48-8b53-d7831a6ed898"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Array accessors",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"be4460df-fc93-d547-94b8-ef1145006d23"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"94f357fa-0299-6e44-b251-a6e9cd9fb7ef"],

