Notebook[{
Cell["ArrayDimensions", "ObjectName",ExpressionUUID->"d03a0fc1-3031-9f47-b87d-24c21baff4f6"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayDimensions", "[", "arr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"7fe5869d-cdbc-384a-add3-342a16f51113"],
 " ",
 "gives the list of lengths of the indices of arr."
}], "Usage",ExpressionUUID->"bb18c253-f146-6440-9d47-653d89e181fc"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"be3b5726-dfba-c342-95bd-ad9342e7d1cd"],

Cell["\<\
Dimensions[arr] gives the same list. Dimensions is a protected System` \
symbol, extended here with UpValues on the two array heads rather than \
redefined.\
\>", "Notes",ExpressionUUID->"87c6a8ae-488f-da47-9b10-94ba0b9f70cb"],

Cell["\<\
An array is regular when all of these lengths are equal, and irregular \
otherwise; see RegularArrayQ. An array of order zero has no lengths at all, \
so its list of dimensions is empty and it counts as regular.\
\>", "Notes",ExpressionUUID->"72f29f2b-b121-6847-9de4-4fa0107f2fc8"],

Cell["\<\
Dimensions are the second criterion by which a Hypermatrix orders its arrays, \
compared term by term among arrays of equal order.\
\>", "Notes",ExpressionUUID->"627ef3dc-bc05-014f-8a32-0750358c769e"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"7e7bb30c-5213-9546-8047-54abeceb7a08"],

Cell["ArrayDimensions @ ArrayObject[{{1, 2, 3}, {4, 5, 6}}]", "Input",ExpressionUUID->"098f6500-976a-314d-bcae-b08f58c4245d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "3"}], "}"}]], "Output",ExpressionUUID->"0e332e27-0c30-fa4b-88e5-e1020065b468"],

Cell["Dimensions works directly on an array object:", "ExampleText",ExpressionUUID->"8924fa11-6540-7d4e-87da-b8f09a554561"],

Cell["Dimensions @ GenerateSymbolicArray[a, {2, 3, 4}]", "Input",ExpressionUUID->"c95c0dc2-d94e-6b47-a03d-1110466610ce"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "3", ",", "4"}], "}"}]], "Output",ExpressionUUID->\
"87832f24-c113-e34d-b7ec-7861e2f537ad"],

Cell["Equal lengths make the array regular:", "ExampleText",ExpressionUUID->"9c03bc35-fe40-6c41-9674-0e5958fc1a5f"],

Cell["\<\
{RegularArrayQ @ ArrayObject[{{1, 2, 3}, {4, 5, 6}}],
 RegularArrayQ @ ArrayObject[{{1, 2}, {3, 4}}]}\
\>", "Input",ExpressionUUID->"b2aaa61b-b041-1d4a-8bc6-62a353a6fde9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "True"}], "}"}]], "Output",ExpressionUUID->"4de33b51-\
4654-ad4b-b514-e07c568b9174"],

Cell["Source", "NotesSection",ExpressionUUID->"0473f7a0-8d71-3f4a-a6e6-4276d5698331"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Array accessors",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"2c5fd018-c30a-a248-bc0d-bc2f777b0996"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"1e368406-af74-1949-a033-e7b64b155f5f"],

