Notebook[{
Cell["ArrayDimensions", "ObjectName",ExpressionUUID->"5b5e2be5-7ed4-f445-8f00-d04913aa6b75"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayDimensions", "[", "arr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"7699e9ef-9489-2840-b49a-39972c97cd6d"],
 " ",
 "gives the list of lengths of the indices of arr."
}], "Usage",ExpressionUUID->"017cab16-93be-f648-81a8-b8ca9f2408ba"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"e5ea37b6-6a3d-6e4c-9d7c-121ce121aeb2"],

Cell["\<\
Dimensions[arr] gives the same list. Dimensions is a protected System` \
symbol, extended here with UpValues on the two array heads rather than \
redefined.\
\>", "Notes",ExpressionUUID->"5c502b3d-246b-0d44-b1ae-2cf57e52c472"],

Cell["\<\
An array is regular when all of these lengths are equal, and irregular \
otherwise; see RegularArrayQ. An array of order zero has no lengths at all, \
so its list of dimensions is empty and it counts as regular.\
\>", "Notes",ExpressionUUID->"059e9ff4-cb83-9344-9dde-7a95d90ea141"],

Cell["\<\
Dimensions are the second criterion by which a Hypermatrix orders its arrays, \
compared term by term among arrays of equal order.\
\>", "Notes",ExpressionUUID->"af417a92-d940-7745-980a-4f4271348a3d"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"b819f339-7ab5-6c40-bb25-eb740a64f290"],

Cell["ArrayDimensions @ ArrayObject[{{1, 2, 3}, {4, 5, 6}}]", "Input",ExpressionUUID->"b235149f-d170-104e-bf97-ac4227a67c92"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "3"}], "}"}]], "Output",ExpressionUUID->"cbad9265-9dae-cf45-adfe-efee43f8e016"],

Cell["Dimensions works directly on an array object:", "ExampleText",ExpressionUUID->"b743efc5-0d98-9649-b795-d5d516b3b2bf"],

Cell["Dimensions @ GenerateSymbolicArray[a, {2, 3, 4}]", "Input",ExpressionUUID->"343a978a-bf79-7246-b0f1-423e0a20282a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "3", ",", "4"}], "}"}]], "Output",ExpressionUUID->\
"f3a136bb-0e39-9c4b-8f06-21df110d473d"],

Cell["Equal lengths make the array regular:", "ExampleText",ExpressionUUID->"c29fc929-ec45-3b48-8840-95ef9eab1b09"],

Cell["\<\
{RegularArrayQ @ ArrayObject[{{1, 2, 3}, {4, 5, 6}}],
 RegularArrayQ @ ArrayObject[{{1, 2}, {3, 4}}]}\
\>", "Input",ExpressionUUID->"6d1a95ba-366b-044e-a4e9-41a21b1015f7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "True"}], "}"}]], "Output",ExpressionUUID->"7ede4737-\
4663-8d43-b733-bc3258e25a12"],

Cell["Source", "NotesSection",ExpressionUUID->"c245e763-8146-b64e-9cbe-98bd738b275c"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Array accessors",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"e83f547d-5b1b-a74d-b3e4-d3824ae4fe02"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"ea955969-1435-c24d-8a52-915b62531401"],

