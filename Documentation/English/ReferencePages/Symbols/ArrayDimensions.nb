Notebook[{
Cell["ArrayDimensions", "ObjectName",ExpressionUUID->"b472f2c2-f91f-b241-bcb6-d9890a6f61fc"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayDimensions", "[", "arr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"3dec8ab3-e75f-6840-87c4-281cda75c0b5"],
 " ",
 "gives the list of lengths of the indices of arr."
}], "Usage",ExpressionUUID->"1a5aaae4-fb3a-4942-8b15-755575e229fd"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"8f184713-ce57-5a4a-8634-9062f09b1d7d"],

Cell["\<\
Dimensions[arr] gives the same list. Dimensions is a protected System` \
symbol, extended here with UpValues on the two array heads rather than \
redefined.\
\>", "Notes",ExpressionUUID->"f8fc08dd-f2d9-d74b-8808-1b908b81b794"],

Cell["\<\
An array is regular when all of these lengths are equal, and irregular \
otherwise; see RegularArrayQ. An array of order zero has no lengths at all, \
so its list of dimensions is empty and it counts as regular.\
\>", "Notes",ExpressionUUID->"cb167a2f-9afb-fa44-a0f2-e24bc23642e3"],

Cell["\<\
Dimensions are the second criterion by which a Hypermatrix orders its arrays, \
compared term by term among arrays of equal order.\
\>", "Notes",ExpressionUUID->"90c2c4c9-a10d-ce42-96d9-72fc437e5a2f"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"eacbd4be-cf29-d940-a1fd-f2c3861c9a17"],

Cell["ArrayDimensions @ ArrayObject[{{1, 2, 3}, {4, 5, 6}}]", "Input",ExpressionUUID->"1be5e786-c479-1940-bbed-a0c9575c7557"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "3"}], "}"}]], "Output",ExpressionUUID->"dfef3b4e-a50a-9b49-b7de-fc6546d2067e"],

Cell["Dimensions works directly on an array object:", "ExampleText",ExpressionUUID->"15df238a-fc37-6749-8ce8-b027b5aaf55f"],

Cell["Dimensions @ GenerateSymbolicArray[a, {2, 3, 4}]", "Input",ExpressionUUID->"f5d08ae3-d963-1548-9283-8d1bf3217fbd"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "3", ",", "4"}], "}"}]], "Output",ExpressionUUID->\
"127efc85-161b-9940-acda-e95f8857b493"],

Cell["Equal lengths make the array regular:", "ExampleText",ExpressionUUID->"28a0a337-2972-2b4d-8aa1-652087f08f34"],

Cell["\<\
{RegularArrayQ @ ArrayObject[{{1, 2, 3}, {4, 5, 6}}],
 RegularArrayQ @ ArrayObject[{{1, 2}, {3, 4}}]}\
\>", "Input",ExpressionUUID->"c2acfe3f-d57a-ac41-991a-2469365c4b12"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "True"}], "}"}]], "Output",ExpressionUUID->"23566dec-\
1bec-7045-bbb2-d628b2717f58"],

Cell["Source", "NotesSection",ExpressionUUID->"16f76cdd-347e-4346-9460-8040c4ac83ac"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Array accessors",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"17f17024-1862-0a4c-95db-4b99b7b69649"],

