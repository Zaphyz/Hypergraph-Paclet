Notebook[{
Cell["ArrayDimensions", "ObjectName",ExpressionUUID->"130936ea-3a5c-784f-b9a0-559e2a643bf4"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayDimensions", "[", "arr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"65b2eef2-bc99-7d46-9437-bace022799e2"],
 " ",
 "gives the list of lengths of the indices of arr."
}], "Usage",ExpressionUUID->"e75eae22-134d-044b-a4f7-1d02bf3100af"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"e4e130e0-a1ef-344d-931d-7f6e2acd8f5a"],

Cell["\<\
Dimensions[arr] gives the same list. Dimensions is a protected System` \
symbol, extended here with UpValues on the two array heads rather than \
redefined.\
\>", "Notes",ExpressionUUID->"71882f52-7117-f14d-b88b-4f1237e8be73"],

Cell["\<\
An array is regular when all of these lengths are equal, and irregular \
otherwise; see RegularArrayQ. An array of order zero has no lengths at all, \
so its list of dimensions is empty and it counts as regular.\
\>", "Notes",ExpressionUUID->"f5d670d8-ed79-ac49-a87c-91bd249ec608"],

Cell["\<\
Dimensions are the second criterion by which a Hypermatrix orders its arrays, \
compared term by term among arrays of equal order.\
\>", "Notes",ExpressionUUID->"60ef7bc3-1172-264f-bd8f-4557b5a0645d"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"74782f27-a984-9541-a962-f754b6cacad9"],

Cell["ArrayDimensions @ ArrayObject[{{1, 2, 3}, {4, 5, 6}}]", "Input",ExpressionUUID->"bdc323b5-fa26-c444-a961-eee13391fc27"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "3"}], "}"}]], "Output",ExpressionUUID->"fc05ebed-dd33-5e46-b56d-428ffd541bc3"],

Cell["Dimensions works directly on an array object:", "ExampleText",ExpressionUUID->"902a80e4-14bd-c541-8fdd-5dd71a50f048"],

Cell["Dimensions @ GenerateSymbolicArray[a, {2, 3, 4}]", "Input",ExpressionUUID->"60c96477-4256-0f43-b852-fd06e5783619"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "3", ",", "4"}], "}"}]], "Output",ExpressionUUID->\
"aa33cd1d-3c84-d045-9e61-511131db4efa"],

Cell["Equal lengths make the array regular:", "ExampleText",ExpressionUUID->"e54dcb45-d1fb-6540-842a-933cd37c3e8e"],

Cell["\<\
{RegularArrayQ @ ArrayObject[{{1, 2, 3}, {4, 5, 6}}],
 RegularArrayQ @ ArrayObject[{{1, 2}, {3, 4}}]}\
\>", "Input",ExpressionUUID->"a6d916f5-e09d-4840-9904-5dec820cb78f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "True"}], "}"}]], "Output",ExpressionUUID->"82210a91-\
1679-a64d-8080-1877ddcb0310"],

Cell["Source", "NotesSection",ExpressionUUID->"aaaf11cc-f775-a644-9af6-5bfb3778cb7c"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Array accessors",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"75c913c5-8a3a-e24e-9e1a-3c439abcbc13"],

