37e793e423d5"],

Cell["Entries belonging to no recognized domain are expressions:", \
"ExampleText",ExpressionUUID->"fd6ffa91-d95a-e746-8655-2ea4b35e6e08"],

Cell["\<\
{ArrayDomain @ GenerateSymbolicArray[a, {2, 2}], ArrayDomain @ \
ArrayObject[{\"x\", \"y\"}],
 ArrayDomain @ ArrayObject[{1, \"x\"}]}\
\>", "Input",ExpressionUUID->"881bc1c4-47a8-0245-9c9f-106be676a1c7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Expression\"\>", ",", "\<\"Expression\"\>", 
   ",", "\<\"Expression\"\>"}], "}"}]], "Output",ExpressionUUID->"c20e6dfc-\
0d52-a74e-a09d-e1e9c5627f19"],

Cell["The domains of a whole hypermatrix:", "ExampleText",ExpressionUUID->"03fa108b-0f7f-a94a-ba09-6c0c498fde3a"],

Cell["\<\
Hypermatrix[{{1, 2}, {1.5, 2.5}, GenerateSymbolicArray[a, {2}]}][\"Domains\"]\
\
\>", "Input",ExpressionUUID->"e70816a4-cea4-7f4e-9258-9217547f483e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Integer\"\>", ",", "\<\"Real\"\>", ",", "\<\"Expression\"\>"}],
   "}"}]], "Output",ExpressionUUID->"bb899b8f-bdb0-fa48-ba28-b733d71b7ca0"],

