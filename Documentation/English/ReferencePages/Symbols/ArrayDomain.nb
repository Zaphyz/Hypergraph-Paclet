56a6cc294e3c"],

Cell["Entries belonging to no recognized domain are expressions:", \
"ExampleText",ExpressionUUID->"5f220a45-77dd-3c44-ac2a-4465656f7f94"],

Cell["\<\
{ArrayDomain @ GenerateSymbolicArray[a, {2, 2}], ArrayDomain @ \
ArrayObject[{\"x\", \"y\"}],
 ArrayDomain @ ArrayObject[{1, \"x\"}]}\
\>", "Input",ExpressionUUID->"012298b8-e446-8646-879b-aaabbeceea71"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Expression\"\>", ",", "\<\"Expression\"\>", 
   ",", "\<\"Expression\"\>"}], "}"}]], "Output",ExpressionUUID->"97261d0e-\
7cfb-f34d-920c-e94b4ee23630"],

Cell["The domains of a whole hypermatrix:", "ExampleText",ExpressionUUID->"b1f410d6-f6e2-f642-84ff-514234591255"],

Cell["\<\
Hypermatrix[{{1, 2}, {1.5, 2.5}, GenerateSymbolicArray[a, {2}]}][\"Domains\"]\
\
\>", "Input",ExpressionUUID->"3d246f53-cfb9-4846-9d22-83229dd0e870"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Integer\"\>", ",", "\<\"Real\"\>", ",", "\<\"Expression\"\>"}],
   "}"}]], "Output",ExpressionUUID->"079eb7dc-e3a1-4644-a60e-02b3c972b90a"],

