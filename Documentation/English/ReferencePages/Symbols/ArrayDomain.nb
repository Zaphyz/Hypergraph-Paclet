ca6844b4bfef"],

Cell["Entries belonging to no recognized domain are expressions:", \
"ExampleText",ExpressionUUID->"36beeab9-f0b8-f34c-979b-1e801e3650dd"],

Cell["\<\
{ArrayDomain @ GenerateSymbolicArray[a, {2, 2}], ArrayDomain @ \
ArrayObject[{\"x\", \"y\"}],
 ArrayDomain @ ArrayObject[{1, \"x\"}]}\
\>", "Input",ExpressionUUID->"bc12680c-cd8d-1345-a6c3-b49ebfe827ee"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Expression\"\>", ",", "\<\"Expression\"\>", 
   ",", "\<\"Expression\"\>"}], "}"}]], "Output",ExpressionUUID->"d0996ca0-\
771b-2f49-bd46-5567c55891a1"],

Cell["The domains of a whole hypermatrix:", "ExampleText",ExpressionUUID->"e1f58925-a205-9a4a-a1fe-7e8d2c42fa58"],

Cell["\<\
Hypermatrix[{{1, 2}, {1.5, 2.5}, GenerateSymbolicArray[a, {2}]}][\"Domains\"]\
\
\>", "Input",ExpressionUUID->"0c4b6c43-378e-3a48-82d5-190aea8d5dcc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Integer\"\>", ",", "\<\"Real\"\>", ",", "\<\"Expression\"\>"}],
   "}"}]], "Output",ExpressionUUID->"6b44cc02-a684-1944-b0a1-8c81eb6ffc36"],

