     "SummaryPanel"],
    DynamicModuleValues:>{}], "]"}],
  FiniteField[2, 1 + #& , "Polynomial"],
  Editable->False,
  SelectWithContents->True,
  Selectable->False]], "Output",ExpressionUUID->"2bef5797-d940-284f-a49d-\
a88c102cfe21"],

Cell["Entries belonging to no recognized domain are expressions:", \
"ExampleText",ExpressionUUID->"31de9e82-d6d6-e243-a5ff-d9f6d8d65aa1"],

Cell["\<\
{ArrayDomain @ GenerateSymbolicArray[a, {2, 2}], ArrayDomain @ \
ArrayObject[{\"x\", \"y\"}],
 ArrayDomain @ ArrayObject[{1, \"x\"}]}\
\>", "Input",ExpressionUUID->"ced2fe88-2410-f540-8e55-5f8fbfcabf35"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Expression\"\>", ",", "\<\"Expression\"\>", 
   ",", "\<\"Expression\"\>"}], "}"}]], "Output",ExpressionUUID->"5a18298f-\
2f0b-9148-83de-3bd3d1e0e3e5"],

Cell["The domains of a whole hypermatrix:", "ExampleText",ExpressionUUID->"849ee629-fac2-0641-9173-9b8bccae368d"],

Cell["\<\
Hypermatrix[{{1, 2}, {1.5, 2.5}, GenerateSymbolicArray[a, {2}]}][\"Domains\"]\
\
\>", "Input",ExpressionUUID->"c414d170-52c0-f444-8069-cc2a2314d5cf"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Integer\"\>", ",", "\<\"Real\"\>", ",", "\<\"Expression\"\>"}],
   "}"}]], "Output",ExpressionUUID->"d6621ee3-6bbf-1746-84ef-0bf4dc3951bd"],

