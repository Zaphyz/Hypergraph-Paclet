3c5fed5a37e0"],

Cell["Entries belonging to no recognized domain are expressions:", \
"ExampleText",ExpressionUUID->"48065028-35ec-0e47-a179-944fdbe8c567"],

Cell["\<\
{ArrayDomain @ GenerateSymbolicArray[a, {2, 2}], ArrayDomain @ \
ArrayObject[{\"x\", \"y\"}],
 ArrayDomain @ ArrayObject[{1, \"x\"}]}\
\>", "Input",ExpressionUUID->"37486fde-3802-ed49-ad53-e46d340148d8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Expression\"\>", ",", "\<\"Expression\"\>", 
   ",", "\<\"Expression\"\>"}], "}"}]], "Output",ExpressionUUID->"c1f76908-\
1aa2-e142-98a0-87668b8339ee"],

Cell["The domains of a whole hypermatrix:", "ExampleText",ExpressionUUID->"fc50d823-c454-4142-8d53-b1a26c5c3207"],

Cell["\<\
Hypermatrix[{{1, 2}, {1.5, 2.5}, GenerateSymbolicArray[a, {2}]}][\"Domains\"]\
\
\>", "Input",ExpressionUUID->"ed38c27b-b21f-3847-b09a-42b4dc01d814"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Integer\"\>", ",", "\<\"Real\"\>", ",", "\<\"Expression\"\>"}],
   "}"}]], "Output",ExpressionUUID->"7484f10b-5e27-0c46-8f0b-bb47cf074240"],

