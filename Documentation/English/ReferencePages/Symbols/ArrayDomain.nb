e0ddc9161a12"],

Cell["Entries belonging to no recognized domain are expressions:", \
"ExampleText",ExpressionUUID->"462f0f50-28cc-d245-b3d7-3219f37066a8"],

Cell["\<\
{ArrayDomain @ GenerateSymbolicArray[a, {2, 2}], ArrayDomain @ \
ArrayObject[{\"x\", \"y\"}],
 ArrayDomain @ ArrayObject[{1, \"x\"}]}\
\>", "Input",ExpressionUUID->"61ef94f2-e767-7842-ad3c-da333dbe1427"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Expression\"\>", ",", "\<\"Expression\"\>", 
   ",", "\<\"Expression\"\>"}], "}"}]], "Output",ExpressionUUID->"459d1c46-\
a635-5b40-a8f8-805186f91e3d"],

Cell["The domains of a whole hypermatrix:", "ExampleText",ExpressionUUID->"6735cac8-5ecf-4a4c-8ca6-1e8b54e2df62"],

Cell["\<\
Hypermatrix[{{1, 2}, {1.5, 2.5}, GenerateSymbolicArray[a, {2}]}][\"Domains\"]\
\
\>", "Input",ExpressionUUID->"977bea20-42df-e748-8284-b2d5ec17eb7d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Integer\"\>", ",", "\<\"Real\"\>", ",", "\<\"Expression\"\>"}],
   "}"}]], "Output",ExpressionUUID->"3ef64320-b660-ab4c-be60-63c65da524ee"],

