ca683f42ffd7"],

Cell["Entries belonging to no recognized domain are expressions:", \
"ExampleText",ExpressionUUID->"3c2b3585-f058-a84e-9415-cbfebc5660ef"],

Cell["\<\
{ArrayDomain @ GenerateSymbolicArray[a, {2, 2}], ArrayDomain @ \
ArrayObject[{\"x\", \"y\"}],
 ArrayDomain @ ArrayObject[{1, \"x\"}]}\
\>", "Input",ExpressionUUID->"dec7b9ed-b647-c741-874f-5f216b41a293"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Expression\"\>", ",", "\<\"Expression\"\>", 
   ",", "\<\"Expression\"\>"}], "}"}]], "Output",ExpressionUUID->"98edf228-\
676c-854e-a25c-ddb909a1528e"],

Cell["The domains of a whole hypermatrix:", "ExampleText",ExpressionUUID->"f206bdf1-6e92-a245-b372-1c23244ce41b"],

Cell["\<\
Hypermatrix[{{1, 2}, {1.5, 2.5}, GenerateSymbolicArray[a, {2}]}][\"Domains\"]\
\
\>", "Input",ExpressionUUID->"b656e121-705e-e248-9ecf-823cef2bcb57"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Integer\"\>", ",", "\<\"Real\"\>", ",", "\<\"Expression\"\>"}],
   "}"}]], "Output",ExpressionUUID->"5c8f2bee-ebf6-8d4d-9009-e4e0c07a8ded"],

