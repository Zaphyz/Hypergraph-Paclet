62a86a896201"],

Cell["Entries belonging to no recognized domain are expressions:", \
"ExampleText",ExpressionUUID->"e317e483-5655-804a-8a39-e2ad9a74bdaa"],

Cell["\<\
{ArrayDomain @ GenerateSymbolicArray[a, {2, 2}], ArrayDomain @ \
ArrayObject[{\"x\", \"y\"}],
 ArrayDomain @ ArrayObject[{1, \"x\"}]}\
\>", "Input",ExpressionUUID->"a8bc80d0-7d1d-bb49-aa3e-c4df0185ca27"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Expression\"\>", ",", "\<\"Expression\"\>", 
   ",", "\<\"Expression\"\>"}], "}"}]], "Output",ExpressionUUID->"19595092-\
1116-e346-9b1f-b1fa9ec36c64"],

Cell["The domains of a whole hypermatrix:", "ExampleText",ExpressionUUID->"278d4fe1-cf62-d642-bdc5-abd62b8a1a6b"],

Cell["\<\
Hypermatrix[{{1, 2}, {1.5, 2.5}, GenerateSymbolicArray[a, {2}]}][\"Domains\"]\
\
\>", "Input",ExpressionUUID->"6ba0f37f-8346-c94e-8309-fc295c48f639"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Integer\"\>", ",", "\<\"Real\"\>", ",", "\<\"Expression\"\>"}],
   "}"}]], "Output",ExpressionUUID->"1814be7f-f7a4-d648-8034-831b7a1e4b0b"],

