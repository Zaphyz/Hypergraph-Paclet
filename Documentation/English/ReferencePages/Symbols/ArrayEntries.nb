Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "4"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"c5837e59-3027-bf4e-9d30-3ab1c13c2efd"],

Cell["Generated entries, here with a symmetry:", "ExampleText",ExpressionUUID->"2b242354-d446-5246-bc16-07d3580156c2"],

Cell["ArrayEntries @ GenerateSymbolicArray[a, {2, 2}, \"Symmetric\"]", "Input",ExpressionUUID->"ace6fcb7-03eb-cd47-8cda-daf7c2378165"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "1"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "2"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "2"}], "]"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"3b92441f-a2f6-8443-9430-24b5d40006f2"],

Cell["Normal is equivalent, and works on a hypermatrix too:", "ExampleText",ExpressionUUID->"9825f310-bd4a-644d-8378-f870511561b0"],

Cell["\<\
Normal @ Hypermatrix[{ArrayObject[{{1, 2}, {3, 4}}], ArrayObject[{1, 2}]}]\
