Notebook[{
Cell["ArrayEntries", "ObjectName",ExpressionUUID->"11067625-9145-a44e-b485-f0586927dfce"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayEntries", "[", "arr", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"f729d5b9-e29a-8041-b295-f2736a32908f"],
 " ",
 "gives the entries of arr as a nested list."
}], "Usage",ExpressionUUID->"cdf49bcc-2fb2-c04b-8ad5-2d69d4e7968d"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"ebc852e3-82f7-0b4b-9ce6-f61b8859eb0d"],

Cell["Normal[arr] gives the same list.", "Notes",ExpressionUUID->"c3beebbe-0f38-184e-8ce9-8c495359bd40"],

Cell["\<\
The entries are whatever the array was built from, generated or given.\
\>", "Notes",ExpressionUUID->"461b997d-f312-3c4f-97f1-a1ef2965d47a"],

Cell["\<\
Normal of a Hypermatrix gives the entries of each of its arrays, in canonical \
order.\
\>", "Notes",ExpressionUUID->"27d197bc-7502-dc46-92d7-556fe49b3276"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"70203c01-1db6-614a-abad-94325c486da3"],

Cell["ArrayEntries @ ArrayObject[{{1, 2}, {3, 4}}]", "Input",ExpressionUUID->"8159ba0d-ebed-f944-9583-6de7f37e6527"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "4"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"ce73d024-15ff-324b-b62f-70c02ad88bf3"],

Cell["Generated entries, here with a symmetry:", "ExampleText",ExpressionUUID->"6d64aab7-491b-5d4a-ad4e-8843322ec1a3"],

Cell["ArrayEntries @ GenerateSymbolicArray[a, {2, 2}, \"Symmetric\"]", "Input",ExpressionUUID->"7166a614-528d-fd41-bfd4-8e643a58fd16"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "1"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "2"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "2"}], "]"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"ea3a38e4-3c7a-1347-b683-c7f16ad782c1"],

Cell["Normal is equivalent, and works on a hypermatrix too:", "ExampleText",ExpressionUUID->"9e4c1565-1a22-5f40-abe9-91ec8cad73b2"],

Cell["\<\
Normal @ Hypermatrix[{ArrayObject[{{1, 2}, {3, 4}}], ArrayObject[{1, 2}]}]\
\>", "Input",ExpressionUUID->"f5b23b6d-6f74-6444-b10b-9f3a9f5c96d9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
