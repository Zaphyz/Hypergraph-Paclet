Notebook[{
Cell["ArrayEntries", "ObjectName",ExpressionUUID->"73161193-884d-c04a-932b-4b1eaec06225"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayEntries", "[", "arr", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"49a4f729-afbf-7545-9848-85e392ea135c"],
 " ",
 "gives the entries of arr as a nested list."
}], "Usage",ExpressionUUID->"04765e06-6b52-d141-8eba-7c5b0b016de0"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"d2f2da72-a2ea-c647-befb-2f6a2ad913a2"],

Cell["Normal[arr] gives the same list.", "Notes",ExpressionUUID->"358c8a1e-5bb7-9040-98ba-be82a4a16be2"],

Cell["\<\
The entries are whatever the array was built from, generated or given.\
\>", "Notes",ExpressionUUID->"9c0f30bb-f232-1b4a-ac15-2663584c8b53"],

Cell["\<\
Normal of a Hypermatrix gives the entries of each of its arrays, in canonical \
order.\
\>", "Notes",ExpressionUUID->"5f0e26e5-1e08-1b4c-be09-ead0be8a83aa"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"03a8f275-753d-ea4f-9884-b2be47fdc30b"],

