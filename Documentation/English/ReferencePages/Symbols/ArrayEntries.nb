Notebook[{
Cell["ArrayEntries", "ObjectName",ExpressionUUID->"1227d587-fd30-f044-a965-81817a437132"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayEntries", "[", "arr", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"e3c5958e-e3b5-b740-bf64-60c586dc4c7a"],
 " ",
 "gives the entries of arr as a nested list."
}], "Usage",ExpressionUUID->"f4f3b3a5-75c4-c642-aca3-ccfde4776272"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"f6bdd375-3f79-0241-993c-44d3021b707a"],

Cell["Normal[arr] gives the same list.", "Notes",ExpressionUUID->"1938bfb5-abd9-d644-9b0b-59954ba6b6e2"],

Cell["\<\
The entries are whatever the array was built from, generated or given.\
\>", "Notes",ExpressionUUID->"4892b313-4f66-3042-aa4a-1261e68b17c6"],

Cell["\<\
Normal of a Hypermatrix gives the entries of each of its arrays, in canonical \
order.\
\>", "Notes",ExpressionUUID->"a19ab030-6f56-7e43-8a66-058a2d299aed"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"78a2781f-6c62-354a-b11f-5ece3c011a3c"],

Cell["ArrayEntries @ ArrayObject[{{1, 2}, {3, 4}}]", "Input",ExpressionUUID->"692c9644-e6f0-dd4f-93b8-c1fe103df6d6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "4"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"e70da255-1ce6-a54e-a0d8-9313d26736b4"],

Cell["Generated entries, here with a symmetry:", "ExampleText",ExpressionUUID->"0ce4fd80-cbf9-a84b-a00d-acf46d6346d8"],

Cell["ArrayEntries @ GenerateSymbolicArray[a, {2, 2}, \"Symmetric\"]", "Input",ExpressionUUID->"ed622ba7-448c-5047-a5ab-f0a1051ef071"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "1"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "2"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "2"}], "]"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"b6c47efb-672f-3c47-bf4f-6df107ae8b3b"],

Cell["Normal is equivalent, and works on a hypermatrix too:", "ExampleText",ExpressionUUID->"60f18016-0a34-2e43-8e65-fcbb93e7c2fb"],

Cell["\<\
Normal @ Hypermatrix[{ArrayObject[{{1, 2}, {3, 4}}], ArrayObject[{1, 2}]}]\
\>", "Input",ExpressionUUID->"20edd90d-ce13-8047-a991-29d6d79a97bd"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "4"}], "}"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"3d32bdf8-7f38-324f-9658-bbe790c176a1"],

