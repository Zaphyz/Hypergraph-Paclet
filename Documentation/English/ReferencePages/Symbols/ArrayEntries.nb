Notebook[{
Cell["ArrayEntries", "ObjectName",ExpressionUUID->"35b45853-576b-124e-b0c3-09d82fb360a4"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayEntries", "[", "arr", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"d360e95b-df03-ca43-a141-76d4c02b1776"],
 " ",
 "gives the entries of arr as a nested list."
}], "Usage",ExpressionUUID->"bda8bfb1-9e30-c74b-9a06-79e97ecef731"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"68264fe4-ea95-a545-89c3-bb1cbd90038f"],

Cell["Normal[arr] gives the same list.", "Notes",ExpressionUUID->"99f281b4-5731-7344-9ff3-712160d5e618"],

Cell["\<\
For a numerical array these are the stored entries. For a symbolic array they \
are generated on demand from the name and the indices, respecting the array's \
symmetry.\
\>", "Notes",ExpressionUUID->"43875702-0e71-8246-abea-bc72540250c2"],

Cell["\<\
Normal of a Hypermatrix gives the entries of each of its arrays, in canonical \
order.\
\>", "Notes",ExpressionUUID->"222700ea-96e4-f544-99e7-fcefd8461e38"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"a29eabef-08d4-c04d-8541-33928b74407b"],

Cell["ArrayEntries @ NumericalArray[{{1, 2}, {3, 4}}]", "Input",ExpressionUUID->"bbd66d0f-e922-1e4a-95be-fec28c5b83ab"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "4"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"2e559e31-bb61-284c-8489-41d328ca5da0"],

Cell["Generated entries, here with a symmetry:", "ExampleText",ExpressionUUID->"0a2b4454-0516-a748-afa7-ef6b61250ee3"],

Cell["ArrayEntries @ SymbolicArray[a, {2, 2}, \"Symmetric\"]", "Input",ExpressionUUID->"e3f064b2-5016-5646-8e25-07b49103afc9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "1"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "2"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "2"}], "]"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"3f06a640-ed91-3341-befd-40f764cf316a"],

Cell["Normal is equivalent, and works on a hypermatrix too:", "ExampleText",ExpressionUUID->"18932d2e-6711-a44c-9503-380c669e8f78"],

Cell["\<\
Normal @ Hypermatrix[{NumericalArray[{{1, 2}, {3, 4}}], NumericalArray[{1, \
2}]}]\
\>", "Input",ExpressionUUID->"7a8028e1-dfaa-884f-95bd-5fc46d4d60da"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "4"}], "}"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"61b360b6-955e-a742-b6d5-e762abcf3f68"],

Cell["Source", "NotesSection",ExpressionUUID->"46a39c4a-34ba-3546-bada-b45f836e0c4c"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
