Notebook[{
Cell["ArrayEntries", "ObjectName",ExpressionUUID->"3adedc97-d732-9d42-bb1a-cd4986cefd2b"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayEntries", "[", "arr", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"6a8dab13-3186-d743-928e-3965bd56c7cb"],
 " ",
 "gives the entries of arr as a nested list."
}], "Usage",ExpressionUUID->"c78bb0ac-56ad-0943-bc88-955180130b76"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"2574602d-9d29-304e-9d48-b91189bb351f"],

Cell["Normal[arr] gives the same list.", "Notes",ExpressionUUID->"62763b2d-8b27-8043-b288-aaaf4d198cf5"],

Cell["\<\
The entries are whatever the array was built from, generated or given.\
\>", "Notes",ExpressionUUID->"f3d230a1-351b-0447-b06b-15947e56bfac"],

Cell["\<\
Normal of a Hypermatrix gives the entries of each of its arrays, in canonical \
order.\
\>", "Notes",ExpressionUUID->"357796ae-abb9-eb4f-b6cb-c4ade90919b6"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"5daa8365-d90e-954d-9eea-cea0f3fb6cdf"],

Cell["ArrayEntries @ ArrayObject[{{1, 2}, {3, 4}}]", "Input",ExpressionUUID->"39ad3d3a-0ac3-b049-b6b3-00ec6b8bf775"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "4"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"efa781cf-954d-3b47-86da-9f9a3c473bd4"],

Cell["Generated entries, here with a symmetry:", "ExampleText",ExpressionUUID->"70a5a8d5-3074-c14c-be34-037cf156d5f1"],

Cell["ArrayEntries @ GenerateSymbolicArray[a, {2, 2}, \"Symmetric\"]", "Input",ExpressionUUID->"a454be7a-aabc-c846-a0af-d5e5efa71922"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "1"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "2"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "2"}], "]"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"6e028700-050a-fe45-a2a9-b29151ec792e"],

Cell["Normal is equivalent, and works on a hypermatrix too:", "ExampleText",ExpressionUUID->"e1de1af3-b74b-1a41-aab4-f09de316683f"],

Cell["\<\
Normal @ Hypermatrix[{ArrayObject[{{1, 2}, {3, 4}}], ArrayObject[{1, 2}]}]\
\>", "Input",ExpressionUUID->"6b4311ed-212f-6649-9c4d-87515b9ffcf7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "4"}], "}"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"1b41c51f-a368-3b42-b250-e3bdbfd9a0d6"],

