Notebook[{
Cell["ArrayEntries", "ObjectName",ExpressionUUID->"0569e1d9-feec-4c4e-935d-6bfcfe823493"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayEntries", "[", "arr", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"ba8f8124-517b-eb41-b22e-08a1dea01424"],
 " ",
 "gives the entries of arr as a nested list."
}], "Usage",ExpressionUUID->"2089e717-89e9-1446-b316-9974f40608bd"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"9d74f36d-8026-e949-89dc-5d22c9487f8e"],

Cell["Normal[arr] gives the same list.", "Notes",ExpressionUUID->"a16c9a69-979c-4845-b03a-f41b3e887d12"],

Cell["\<\
The entries are whatever the array was built from, generated or given.\
\>", "Notes",ExpressionUUID->"d75fd37e-c6a6-d541-b306-3e1695f0a265"],

Cell["\<\
Normal of a Hypermatrix gives the entries of each of its arrays, in canonical \
order.\
\>", "Notes",ExpressionUUID->"7a8d3aad-995b-174c-886c-f28f6be28cf4"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"8be358eb-d96a-a04a-bf20-f500d08f96e7"],

