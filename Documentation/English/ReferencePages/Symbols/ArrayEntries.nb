Notebook[{
Cell["ArrayEntries", "ObjectName",ExpressionUUID->"f629f8de-09df-c542-81bb-84a8967f9f77"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayEntries", "[", "arr", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"83a49ba2-4b4e-564f-83fe-d50c6f781878"],
 " ",
 "gives the entries of arr as a nested list."
}], "Usage",ExpressionUUID->"7a90a86f-6c6f-5d4b-a8f9-caea5b2a58d2"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"20a6c175-2488-ad43-8ef0-e0fdb0894a9b"],

Cell["Normal[arr] gives the same list.", "Notes",ExpressionUUID->"db26dc6a-7fc3-754e-90c8-e5017bfbfc0a"],

Cell["\<\
The entries are whatever the array was built from, generated or given.\
\>", "Notes",ExpressionUUID->"6d4eabc3-3475-9945-a1e9-76ed382541ba"],

Cell["\<\
Normal of a Hypermatrix gives the entries of each of its arrays, in canonical \
order.\
\>", "Notes",ExpressionUUID->"bb7ca6a8-e86d-f84d-bbfd-87241aea77be"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"de04a499-f0f1-a044-a54a-e6735bf583e5"],

Cell["ArrayEntries @ ArrayObject[{{1, 2}, {3, 4}}]", "Input",ExpressionUUID->"0dc480be-b244-fe42-a416-a3fcd1544515"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "4"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"ce9eaddf-3613-2147-ac5a-6ec4e70f40dd"],

Cell["Generated entries, here with a symmetry:", "ExampleText",ExpressionUUID->"f8d179da-5778-b745-ab1f-2ab82cb083a3"],

Cell["ArrayEntries @ GenerateSymbolicArray[a, {2, 2}, \"Symmetric\"]", "Input",ExpressionUUID->"2057cdbe-45fe-b340-a163-ebeb274e75b2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "1"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "2"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "2"}], "]"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"41be17f9-56c9-ea4d-ac12-04e3b17fcfdc"],

Cell["Normal is equivalent, and works on a hypermatrix too:", "ExampleText",ExpressionUUID->"945768ab-077f-9b43-9898-6ef6d0592182"],

Cell["\<\
Normal @ Hypermatrix[{ArrayObject[{{1, 2}, {3, 4}}], ArrayObject[{1, 2}]}]\
