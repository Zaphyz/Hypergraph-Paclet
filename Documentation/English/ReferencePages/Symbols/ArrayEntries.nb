Notebook[{
Cell["ArrayEntries", "ObjectName",ExpressionUUID->"d4a767df-2c73-d546-9f4e-2f1463a2e83a"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayEntries", "[", "arr", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"1a4a3258-5d5d-b14b-a9dd-2147eee2af06"],
 " ",
 "gives the entries of arr as a nested list."
}], "Usage",ExpressionUUID->"2d05afd6-cc94-064f-a7ee-7c0d2c8ddfce"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"7623b551-48a7-1249-a2c0-9d8198f361b9"],

Cell["Normal[arr] gives the same list.", "Notes",ExpressionUUID->"c1a13d04-76bb-c044-8e02-0a47b9c38557"],

Cell["\<\
The entries are whatever the array was built from, generated or given.\
\>", "Notes",ExpressionUUID->"97ab1aa8-0fcc-534f-9072-36c61b4fc383"],

Cell["\<\
Normal of a Hypermatrix gives the entries of each of its arrays, in canonical \
order.\
\>", "Notes",ExpressionUUID->"70fd8e92-9903-0b4f-86bf-b68df357dbf6"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"663d8ec0-5724-a345-8260-22119d54f9cd"],

Cell["ArrayEntries @ ArrayObject[{{1, 2}, {3, 4}}]", "Input",ExpressionUUID->"3268bfeb-2531-c941-89ad-4e0e1a87a036"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "4"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"bb5cdaf9-cac8-a34d-8c44-9700e7538b00"],

Cell["Generated entries, here with a symmetry:", "ExampleText",ExpressionUUID->"89b8eff7-0433-2745-8fb2-a3b10c93292a"],

Cell["ArrayEntries @ GenerateSymbolicArray[a, {2, 2}, \"Symmetric\"]", "Input",ExpressionUUID->"758fe58e-4743-4c4f-ba30-42d1f9110e11"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "1"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "2"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "2"}], "]"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"b7d7639e-49ea-9247-9d7d-818b6ac8ac8e"],

Cell["Normal is equivalent, and works on a hypermatrix too:", "ExampleText",ExpressionUUID->"cc13c1b4-2f28-084a-be48-e493918e43c3"],

Cell["\<\
Normal @ Hypermatrix[{ArrayObject[{{1, 2}, {3, 4}}], ArrayObject[{1, 2}]}]\
