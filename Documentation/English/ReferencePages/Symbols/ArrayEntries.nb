Notebook[{
Cell["ArrayEntries", "ObjectName",ExpressionUUID->"fc5f47e0-6314-0547-8cb1-2b13bc6da642"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayEntries", "[", "arr", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"e6196ba5-8447-9f40-98f1-4ebd104d3996"],
 " ",
 "gives the entries of arr as a nested list."
}], "Usage",ExpressionUUID->"6f9edf76-334f-e145-87da-b9998b95ebee"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"9bb518bd-cf08-4f40-bb7b-588fbab73b91"],

Cell["Normal[arr] gives the same list.", "Notes",ExpressionUUID->"c10d054d-8293-a845-b5a2-17a45cd36429"],

Cell["\<\
The entries are whatever the array was built from, generated or given.\
\>", "Notes",ExpressionUUID->"2cff7815-7c26-5e4a-8298-74dc9fabccfe"],

Cell["\<\
Normal of a Hypermatrix gives the entries of each of its arrays, in canonical \
order.\
\>", "Notes",ExpressionUUID->"a5a9f90e-3635-774a-a4cb-da420151dc42"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"a1b48b98-2eef-6940-8d25-e8a63f8a517c"],

Cell["ArrayEntries @ ArrayObject[{{1, 2}, {3, 4}}]", "Input",ExpressionUUID->"d865e737-f84b-b54f-8bc8-d3c62a77e6d5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "4"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"583c88f0-2935-4a48-92b3-0d3867dbeabc"],

Cell["Generated entries, here with a symmetry:", "ExampleText",ExpressionUUID->"be586081-f22b-524b-af14-f0fe4571b3f1"],

Cell["ArrayEntries @ GenerateSymbolicArray[a, {2, 2}, \"Symmetric\"]", "Input",ExpressionUUID->"390e5547-6548-4347-a905-48face5be456"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "1"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "2"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "2"}], "]"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"eb501304-e883-9742-a466-82e65c947fd2"],

Cell["Normal is equivalent, and works on a hypermatrix too:", "ExampleText",ExpressionUUID->"06b73472-df4a-3a46-946e-34bc1a1b8343"],

Cell["\<\
Normal @ Hypermatrix[{ArrayObject[{{1, 2}, {3, 4}}], ArrayObject[{1, 2}]}]\
\>", "Input",ExpressionUUID->"e37af5fe-0695-944b-90c1-c336a23f7304"],

Cell[BoxData[
 RowBox[{"{", 
