Cell["\<\
A 3-array has no flat picture of its own, so it is drawn as a row of \
matrices, the first index choosing the matrix:\
\>", "ExampleText",ExpressionUUID->"5c02d45b-d97e-7241-a60f-1e272d8b3093"],

Cell["ArrayGraphics[Array[#1 + #2 + #3 &, {2, 2, 2}]]", "Input",ExpressionUUID->"5d82d4b7-ff69-324f-8c99-9ff7bd381bfd"],

