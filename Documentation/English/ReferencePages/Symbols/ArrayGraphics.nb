(* Beginning of Notebook Content *)
Notebook[{
Cell["ArrayGraphics", "ObjectName",ExpressionUUID->"f3821dc0-e3b3-d54e-8fe7-e08850ef9539"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayGraphics", "[", "arr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"7355bdcc-49ba-364d-b143-0d8852f98faf"],
 " ",
 "draws the array arr in the plane."
}], "Usage",ExpressionUUID->"50426eed-c7e2-2d4b-8a79-03d152d4e6f5"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayGraphics", "[", 
    RowBox[{"arr", ",", " ", "opts"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"39114f79-2e01-854f-9e6e-5aea9fd57a66"],
 " ",
 "draws it with the given options."
}], "Usage",ExpressionUUID->"264c1a1e-6112-3542-b7b5-6e25dc564ba2"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"a39a8800-6f59-5e4f-b06a-61371a3d7ce8"],

Cell["\<\
An array of order one is drawn as a row of cells and one of order two as a \
grid; an array of order zero is a single cell.\
\>", "Notes",ExpressionUUID->"3151af8b-c6f5-fb49-988e-1de67c01952c"],

Cell["\<\
Only those orders have a flat picture of their own. Anything higher is drawn \
as a nesting of them: the first block of indices gives the outer picture, and \
each of its cells holds the picture of the indices that remain. A 3-array is \
a row of grids, a 4-array a grid of grids.\
\>", "Notes",ExpressionUUID->"49f1559a-3a77-c84a-a8dd-ae1412647826"],

Cell[TextData[{
 "The result is always a two-dimensional ",
 Cell[BoxData[
  StyleBox["Graphics", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "5004d6fa-c12d-e049-8c93-f6dbd2b9f80e"],
 ". For cubes arranged in space, at every order, see ",
 Cell[BoxData[
  StyleBox["ArrayGraphics3D", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "3b193684-9174-5047-91bc-bc4a001b03c1"],
 "."
}], "Notes",ExpressionUUID->"c213d189-201a-6c49-bc21-76aad99415db"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"\"\<Nesting\>\"", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"k1", ",", " ", "k2", ",", " ", "..."}], "}"}]}], "InlineCode"]],
   "InlineFormula",ExpressionUUID->"1fb1ab18-e607-3e4a-9607-3424b6f677bb"],
 " says how to split the indices: the blocks must sum to the order of the \
array and each must be one or two, since a flat picture holds no more. The \
default, ",
 Cell[BoxData[
  StyleBox["Automatic", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "22033616-2979-3e41-a0e2-f2016c3f34f0"],
 ", uses ",
 Cell[BoxData[
  StyleBox["ArrayNesting", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "6dd7c35f-d072-5d43-a2ac-062de230ea49"],
 "."
}], "Notes",ExpressionUUID->"5e889402-732c-8f4d-a44c-959087697496"],

Cell["\<\
The cells of the innermost block are sized to the widest entry, so that the \
entries of a symbolic array do not overflow one another.\
\>", "Notes",ExpressionUUID->"c7aef1a7-18b6-1c47-bb60-0f344ef297a2"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"\"\<Framed\>\"", " ", "->", " ", "False"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"c450d211-adcd-bc4a-b237-c5f8cf29aff1"],
 " leaves the entries on the background with no cell drawn around them."
}], "Notes",ExpressionUUID->"77445e3a-a745-4c42-9430-8797d39476f9"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["\"\<Indices\>\"", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "04e795a7-7858-6e42-8789-235807e28345"],
 " is ",
 Cell[BoxData[
  StyleBox["Automatic", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "34d6de2a-7ba2-644d-a801-7d40e1282729"],
 ", which labels the rows and columns; ",
 Cell[BoxData[
  StyleBox["None", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "d8f3cb49-78d2-ff42-8f09-4510ecf2dd0f"],
 ", which labels nothing; or ",
 Cell[BoxData[
  StyleBox["\"\<Colored\>\"", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "a3be17f3-b4f4-524c-83b3-db12c836f8a1"],
 ", which gives each axis a colour of its own."
}], "Notes",ExpressionUUID->"acba83bf-3e7f-4d4d-83b5-a40404e6014b"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["\"\<PlotTheme\>\"", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"03671d36-8fcc-7746-ac45-5dc958902f7b"],
 " is ",
 Cell[BoxData[
  StyleBox["\"\<Light\>\"", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "7042fa35-869b-204e-a65d-9260bffffa30"],
 " or ",
 Cell[BoxData[
  StyleBox["\"\<Dark\>\"", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "da02a16f-6a83-ec4e-9428-fcf167897f7d"],
 "."
}], "Notes",ExpressionUUID->"553323a0-0fa0-9e4d-a869-7f0d2299890b"],

Cell[TextData[{
 "An array of more than ",
 Cell[BoxData[
  StyleBox["\"\<MaxEntries\>\"", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"0729c7d2-da99-934d-8ba9-53a2178e4133"],
 " entries, 512 by default, is refused with ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayGraphics", "::", "big"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"7f3155af-69f5-4244-ae2b-07830d4f1e52"],
 " rather than drawn illegibly."
}], "Notes",ExpressionUUID->"fdcfb5f0-7fea-d945-be44-a228fe5f6ef6"],

Cell["\<\
Array objects and plain nested lists are both accepted, and Graphics options \
are passed through.\
\>", "Notes",ExpressionUUID->"6e112c47-0bf6-fe4b-9942-8b8941e8a8d8"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"1a71d227-df32-454f-9335-fe4626195021"],

Cell["A 1-array is a row of cells, and a 2-array a grid:", "ExampleText",ExpressionUUID->"e315e8d7-d5df-6042-bd19-abac51eff816"],

Cell["\<\
{ArrayGraphics[{1, 2, 3, 4}], ArrayGraphics[{{1, 2, 3}, {4, 5, 6}}]}\
\>", "Input",ExpressionUUID->"be9827b2-4146-fd41-8985-9eb7579f2fb9"],

