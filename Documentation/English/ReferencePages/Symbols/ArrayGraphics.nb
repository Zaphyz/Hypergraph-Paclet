(* Beginning of Notebook Content *)
Notebook[{
Cell["ArrayGraphics", "ObjectName",ExpressionUUID->"031d9208-6ee6-1d4e-9fac-13bddf3e7fb5"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayGraphics", "[", "arr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"74b9b3d2-2fd4-664a-bb34-752981ddaf40"],
 " ",
 "draws the array arr in the plane."
}], "Usage",ExpressionUUID->"f8872776-78e8-bd4d-8851-35e41c9dba00"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayGraphics", "[", 
    RowBox[{"arr", ",", " ", "opts"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"d54b5cd0-99d9-7a41-bee5-cfa0829f31fa"],
 " ",
 "draws it with the given options."
}], "Usage",ExpressionUUID->"f9b15672-9a3d-a74e-9270-8b336e9bd279"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"d2cc09cf-cde9-e347-992b-9eb54910bad3"],

Cell["\<\
An array of order one is drawn as a row of cells and one of order two as a \
grid; an array of order zero is a single cell.\
\>", "Notes",ExpressionUUID->"8e3f3c2d-cded-6842-943e-625196c76a8c"],

Cell["\<\
Only those orders have a flat picture of their own. Anything higher is drawn \
as a nesting of them: the first block of indices gives the outer picture, and \
each of its cells holds the picture of the indices that remain. A 3-array is \
a row of grids, a 4-array a grid of grids.\
\>", "Notes",ExpressionUUID->"0ab0afe1-251c-cb49-9201-ec6b3ac999f6"],

Cell[TextData[{
 "The result is always a two-dimensional ",
 Cell[BoxData[
  StyleBox["Graphics", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "f34a98b2-bf93-af4d-8657-534988e93749"],
 ". For cubes arranged in space, at every order, see ",
 Cell[BoxData[
  StyleBox["ArrayGraphics3D", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "37208cb0-786d-624c-9aa2-4dcb390f99ed"],
 "."
}], "Notes",ExpressionUUID->"53639bda-7819-1f47-b89f-8b79cc1d238e"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"\"\<Nesting\>\"", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"k1", ",", " ", "k2", ",", " ", "..."}], "}"}]}], "InlineCode"]],
   "InlineFormula",ExpressionUUID->"89f0b5c3-2f3a-7347-bf5d-a3917aef8239"],
 " says how to split the indices: the blocks must sum to the order of the \
array and each must be one or two, since a flat picture holds no more. The \
default, ",
 Cell[BoxData[
  StyleBox["Automatic", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "0fe2dde4-b34a-7a49-838a-0fbe4d008a1b"],
 ", uses ",
 Cell[BoxData[
  StyleBox["ArrayNesting", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "a8f07e96-b0c9-8145-bf31-dd62b3595a7a"],
 "."
}], "Notes",ExpressionUUID->"a425050e-b5ac-4249-a857-54e3a59f225f"],

Cell["\<\
The cells of the innermost block are sized to the widest entry, so that the \
entries of a symbolic array do not overflow one another.\
\>", "Notes",ExpressionUUID->"269ed332-291b-9948-a6bf-ef47f054eab3"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"\"\<Framed\>\"", " ", "->", " ", "False"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"6fcd8e1a-e4ca-de41-bdb3-44afd41d6aa6"],
 " leaves the entries on the background with no cell drawn around them."
}], "Notes",ExpressionUUID->"f0f47b32-de34-3248-81ff-e19191cfbec5"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["\"\<Indices\>\"", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "a26948d2-fb8c-b344-b1c1-efd8fc5874cf"],
 " is ",
 Cell[BoxData[
  StyleBox["Automatic", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "4f641fb7-705e-1d40-ab68-fd62f28053f6"],
 ", which labels the rows and columns; ",
 Cell[BoxData[
  StyleBox["None", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "093d1022-0124-5248-8c3d-97fbe3cb0026"],
 ", which labels nothing; or ",
 Cell[BoxData[
  StyleBox["\"\<Colored\>\"", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "1a2af151-a488-5542-9352-2e212662e159"],
 ", which gives each axis a colour of its own."
}], "Notes",ExpressionUUID->"730bf9fc-86fe-834c-aac9-0d74fcb85f83"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["\"\<PlotTheme\>\"", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"c0ff7581-4921-304e-898d-b7fb822d1d2b"],
 " is ",
 Cell[BoxData[
  StyleBox["\"\<Light\>\"", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "383039e5-e264-614b-8cba-0ce78d4c1b9b"],
 " or ",
 Cell[BoxData[
  StyleBox["\"\<Dark\>\"", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "3c039ab7-196b-314d-a16e-4a5495e3c339"],
 "."
}], "Notes",ExpressionUUID->"519be166-786d-2242-857c-2fb31350929a"],

Cell[TextData[{
 "An array of more than ",
 Cell[BoxData[
  StyleBox["\"\<MaxEntries\>\"", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"dda1012c-9ef4-3c49-8b7c-e088e77c4ddf"],
 " entries, 512 by default, is refused with ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayGraphics", "::", "big"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"3f6ffd5c-b975-1a4a-b4ac-8d37f5d8fd88"],
 " rather than drawn illegibly."
}], "Notes",ExpressionUUID->"3d643a12-b885-574c-87c1-ad0a59062aec"],

Cell["\<\
Array objects and plain nested lists are both accepted, and Graphics options \
are passed through.\
\>", "Notes",ExpressionUUID->"0dc2278a-42cf-3c47-bda3-af3e63327dfd"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"8faaaad3-3be8-af4a-9a1d-78aaaac477d1"],

Cell["A 1-array is a row of cells, and a 2-array a grid:", "ExampleText",ExpressionUUID->"cf8f242f-ddda-9049-873a-6d5b9cdc5b3a"],

Cell["\<\
{ArrayGraphics[{1, 2, 3, 4}], ArrayGraphics[{{1, 2, 3}, {4, 5, 6}}]}\
\>", "Input",ExpressionUUID->"de8afa19-1cc3-c146-80f2-e42a3c2ac0c9"],

