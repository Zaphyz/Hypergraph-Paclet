(* Beginning of Notebook Content *)
Notebook[{
Cell["ArrayGraphics", "ObjectName",ExpressionUUID->"4d1af47b-7df5-0c47-83c5-44d248314ef4"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayGraphics", "[", "arr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"59e89ce8-51eb-eb48-9261-a09466339fef"],
 " ",
 "draws the array arr in the plane."
}], "Usage",ExpressionUUID->"f48b8b5b-a189-0444-a11d-aaab3c14d445"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayGraphics", "[", 
    RowBox[{"arr", ",", " ", "opts"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"70848a23-91a1-a94b-8070-564924375ec3"],
 " ",
 "draws it with the given options."
}], "Usage",ExpressionUUID->"9dc94936-fa4b-f843-bf14-f98265fb7a4e"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"3b455ea3-2bb4-9746-9797-e60e4c564610"],

Cell["\<\
An array of order one is drawn as a row of cells and one of order two as a \
grid; an array of order zero is a single cell.\
\>", "Notes",ExpressionUUID->"e0cc9d6f-1bae-3747-9e9a-6509a0a27e53"],

Cell["\<\
Only those orders have a flat picture of their own. Anything higher is drawn \
as a nesting of them: the first block of indices gives the outer picture, and \
each of its cells holds the picture of the indices that remain. A 3-array is \
a row of grids, a 4-array a grid of grids.\
\>", "Notes",ExpressionUUID->"cb4232dd-0cc0-af46-b954-50fc434c9fde"],

Cell[TextData[{
 "The result is always a two-dimensional ",
 Cell[BoxData[
  StyleBox["Graphics", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "9c7e9ecf-ce75-a546-98e5-929d7cc69d76"],
 ". For cubes arranged in space, at every order, see ",
 Cell[BoxData[
  StyleBox["ArrayGraphics3D", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "fa2adc9a-f5d0-fd4c-82d8-a8c1bb9e260a"],
 "."
}], "Notes",ExpressionUUID->"86f1d15e-f1e4-9d4c-bb32-d2b6a85e1208"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"\"\<Nesting\>\"", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"k1", ",", " ", "k2", ",", " ", "..."}], "}"}]}], "InlineCode"]],
   "InlineFormula",ExpressionUUID->"7a249861-b84e-9a4e-bed3-8789f0154336"],
 " says how to split the indices: the blocks must sum to the order of the \
array and each must be one or two, since a flat picture holds no more. The \
default, ",
 Cell[BoxData[
  StyleBox["Automatic", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "442605a8-d4d9-f641-93a8-2f1d7c2d1717"],
 ", uses ",
 Cell[BoxData[
  StyleBox["ArrayNesting", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "7412909a-b71c-0141-ae03-bc192d826aa0"],
 "."
}], "Notes",ExpressionUUID->"a113cb15-7994-9945-b102-2348e47d1aba"],

Cell["\<\
The cells of the innermost block are sized to the widest entry, so that the \
entries of a symbolic array do not overflow one another.\
\>", "Notes",ExpressionUUID->"75af5c15-1924-ba47-87f7-c1739935e3b2"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"\"\<Framed\>\"", " ", "->", " ", "False"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"a5b6bfc5-a71f-3844-b7c0-ca5f5b45b408"],
 " leaves the entries on the background with no cell drawn around them."
}], "Notes",ExpressionUUID->"7e134190-03e4-0944-ad11-1cce25a27e04"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["\"\<Indices\>\"", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "85f75b16-9cb8-3342-92e5-85314f9ecbbd"],
 " is ",
 Cell[BoxData[
  StyleBox["Automatic", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "18c2989d-f594-2d4d-8423-96a557388591"],
 ", which labels the rows and columns; ",
 Cell[BoxData[
  StyleBox["None", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "cfdd0891-cb8f-f941-9ff2-f3536754432f"],
 ", which labels nothing; or ",
 Cell[BoxData[
  StyleBox["\"\<Colored\>\"", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "25c49883-09a6-254c-9ef0-91b4238b7636"],
 ", which gives each axis a colour of its own."
}], "Notes",ExpressionUUID->"47dc0bb5-f071-4a40-a3ef-9f39825fb67d"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["\"\<PlotTheme\>\"", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"df368abe-07b4-524f-8596-1b7140445e05"],
 " is ",
 Cell[BoxData[
  StyleBox["\"\<Light\>\"", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "2b27f666-62d0-534d-9891-64564c58bbed"],
 " or ",
 Cell[BoxData[
  StyleBox["\"\<Dark\>\"", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "c2a11eb4-e742-f14e-9673-0124d0953eb4"],
 "."
}], "Notes",ExpressionUUID->"1aa7e46c-3307-364f-a9df-de10169d9c17"],

Cell[TextData[{
 "An array of more than ",
 Cell[BoxData[
  StyleBox["\"\<MaxEntries\>\"", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"61d75960-f61a-874d-8845-367361eb96af"],
 " entries, 512 by default, is refused with ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayGraphics", "::", "big"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"1ce0c94d-c5f4-ae4c-ac9b-34373848b664"],
 " rather than drawn illegibly."
}], "Notes",ExpressionUUID->"ab69e647-e999-a247-a474-6bd4d356f25b"],

Cell["\<\
Array objects and plain nested lists are both accepted, and Graphics options \
are passed through.\
\>", "Notes",ExpressionUUID->"3faadbaa-ec9a-1343-9978-c7d8f7fcdc4a"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"46407fa5-ff80-d242-bcd6-472c525b6e6f"],

Cell["A 1-array is a row of cells, and a 2-array a grid:", "ExampleText",ExpressionUUID->"a951561d-b319-5146-a751-26e92c4ae3b1"],

Cell["\<\
{ArrayGraphics[{1, 2, 3, 4}], ArrayGraphics[{{1, 2, 3}, {4, 5, 6}}]}\
\>", "Input",ExpressionUUID->"d0196ed6-115b-7e46-a37c-ff3b8ecc0caf"],

