Notebook[{
Cell["ArrayGraphics", "ObjectName",ExpressionUUID->"25f1bae7-a743-9842-a842-a894b6853883"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayGraphics", "[", "arr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"46739f84-aae6-464d-9930-75d0c8f74086"],
 " ",
 "draws the array arr in the plane."
}], "Usage",ExpressionUUID->"635f84d7-fc05-6c49-9b9a-28d4ab9d1ae9"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayGraphics", "[", 
    RowBox[{"arr", ",", " ", "opts"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"3c2cf432-1d6c-f247-87b0-dfae51ab0bd7"],
 " ",
 "draws it with the given options."
}], "Usage",ExpressionUUID->"38b45fda-6cb4-374a-bd22-88fb86f9ea92"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"9b587d4b-d051-4742-a655-099162fb7e78"],

Cell["\<\
An array of order one is drawn as a row of cells and one of order two as a \
grid; an array of order zero is a single cell.\
\>", "Notes",ExpressionUUID->"9fe9eeef-2deb-a342-8cc5-889d0679bda0"],

Cell["\<\
Only those orders have a flat picture of their own. Anything higher is drawn \
as a nesting of them: the first block of indices gives the outer picture, and \
each of its cells holds the picture of the indices that remain. A 3-array is \
a row of grids, a 4-array a grid of grids.\
\>", "Notes",ExpressionUUID->"014b22b4-0466-5249-bf14-c0a55588aed9"],

Cell[TextData[{
 "The result is always a two-dimensional ",
 Cell[BoxData[
  StyleBox["Graphics", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "881b3eb0-3a12-2b47-941e-1f7bfd1eda85"],
 ". For cubes arranged in space, at every order, see ",
 Cell[BoxData[
  StyleBox["ArrayGraphics3D", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "2b5670eb-5ede-c24c-be9d-4098a8f9fc43"],
 "."
}], "Notes",ExpressionUUID->"d73075b2-e351-d74f-a4ed-20b7c16f2456"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"\"\<Nesting\>\"", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"k1", ",", " ", "k2", ",", " ", "..."}], "}"}]}], "InlineCode"]],
   "InlineFormula",ExpressionUUID->"364a4a3e-c42a-4b40-8343-b45493324c8e"],
 " says how to split the indices: the blocks must sum to the order of the \
array and each must be one or two, since a flat picture holds no more. The \
default, ",
 Cell[BoxData[
  StyleBox["Automatic", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "6bf23345-31dd-0f41-9a72-e55797b71389"],
 ", uses ",
 Cell[BoxData[
  StyleBox["ArrayNesting", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "45f9f8a4-1747-1047-9a4a-70a99b71ced8"],
 "."
}], "Notes",ExpressionUUID->"8031c1f9-7135-1049-8757-9babd0791d35"],

Cell["\<\
The cells of the innermost block are sized to the widest entry, so that the \
entries of a symbolic array do not overflow one another.\
\>", "Notes",ExpressionUUID->"411bbc2a-07bf-5e41-840d-3789cad29397"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"\"\<Framed\>\"", " ", "->", " ", "False"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"baf43387-6baf-7143-a669-8ba117edc93a"],
 " leaves the entries on the background with no cell drawn around them."
}], "Notes",ExpressionUUID->"cf4be447-b9ba-9e4b-8ed6-724687b769c7"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["\"\<Indices\>\"", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "1ac005e2-42cb-e547-b321-c400beddded9"],
 " is ",
 Cell[BoxData[
  StyleBox["Automatic", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "5a7f22e9-025a-7444-97aa-0bce7333a2bc"],
 ", which labels the rows and columns; ",
 Cell[BoxData[
  StyleBox["None", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "a0ba9d22-7ba2-e84c-b0d9-dc8fa53c3eda"],
 ", which labels nothing; or ",
 Cell[BoxData[
  StyleBox["\"\<Colored\>\"", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "127f79a4-f07a-4041-a1bd-9b65e1ae3f3f"],
 ", which gives each axis a colour of its own."
}], "Notes",ExpressionUUID->"31683274-b18e-3f48-bd16-fca6cccc3dea"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["\"\<PlotTheme\>\"", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"61fe8d86-22ad-ed49-8501-1ec229802116"],
 " is ",
 Cell[BoxData[
  StyleBox["\"\<Light\>\"", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "c6146529-1032-0a49-b051-15e5b244b2f3"],
 " or ",
 Cell[BoxData[
  StyleBox["\"\<Dark\>\"", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "bb158a7b-9ac8-d043-b96e-2a7a154290d1"],
 "."
}], "Notes",ExpressionUUID->"45ab6ace-6628-bf4a-8533-211ef34980aa"],

Cell[TextData[{
 "An array of more than ",
 Cell[BoxData[
  StyleBox["\"\<MaxEntries\>\"", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"0891e79f-fa30-5241-9bc9-e4ca68e7b22e"],
 " entries, 512 by default, is refused with ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayGraphics", "::", "big"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"fa739c6c-4ac2-ed4f-912e-cbb16a113384"],
 " rather than drawn illegibly."
}], "Notes",ExpressionUUID->"62f0d33a-e514-5049-bb84-3aad1c9384ff"],

Cell["\<\
Array objects and plain nested lists are both accepted, and Graphics options \
are passed through.\
\>", "Notes",ExpressionUUID->"553b5a50-09bd-a448-86a5-b41bd8e76a53"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"0bae1260-0516-f64f-8842-5127a1ee6ada"],

Cell["A 1-array is a row of cells, and a 2-array a grid:", "ExampleText",ExpressionUUID->"1ea8effc-9dd4-f145-8cad-6170cfa800e8"],

Cell["\<\
{ArrayGraphics[{1, 2, 3, 4}], ArrayGraphics[{{1, 2, 3}, {4, 5, 6}}]}\
\>", "Input",ExpressionUUID->"d80bb135-88de-6040-be80-77b4bf5fb5c0"],

