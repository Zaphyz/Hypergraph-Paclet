(* Beginning of Notebook Content *)
Notebook[{
Cell["ArrayGraphics", "ObjectName",ExpressionUUID->"208e2039-5cfe-914e-a250-bb1d03687650"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayGraphics", "[", "arr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"6f19a567-cc6a-a34b-ba69-8bb1eb8dbc39"],
 " ",
 "draws the array arr in the plane."
}], "Usage",ExpressionUUID->"91eeaaa3-1fcc-a34c-bf7b-d99bc199d418"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayGraphics", "[", 
    RowBox[{"arr", ",", " ", "opts"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"0fade457-12ce-1543-8c7d-49f20724f511"],
 " ",
 "draws it with the given options."
}], "Usage",ExpressionUUID->"151f64c9-e780-434c-9dbf-0edf77891a0d"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"85c2d6bb-3fc9-0249-a25b-43b31a335c7a"],

Cell["\<\
An array of order one is drawn as a row of cells and one of order two as a \
grid; an array of order zero is a single cell.\
\>", "Notes",ExpressionUUID->"2dea9a03-860c-c241-b52c-6db30ffb9485"],

Cell["\<\
Only those orders have a flat picture of their own. Anything higher is drawn \
as a nesting of them: the first block of indices gives the outer picture, and \
each of its cells holds the picture of the indices that remain. A 3-array is \
a row of grids, a 4-array a grid of grids.\
\>", "Notes",ExpressionUUID->"7cc7e2df-238f-054c-803c-c91773ce8bdf"],

Cell[TextData[{
 "The result is always a two-dimensional ",
 Cell[BoxData[
  StyleBox["Graphics", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "1ca22320-47b8-f14d-94af-e26631741893"],
 ". For cubes arranged in space, at every order, see ",
 Cell[BoxData[
  StyleBox["ArrayGraphics3D", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "3ef0f76a-a5bb-f14c-8879-83d25c3a9e79"],
 "."
}], "Notes",ExpressionUUID->"8f2a327f-c01e-3e49-bbe2-6b5fb8a5ae89"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"\"\<Nesting\>\"", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"k1", ",", " ", "k2", ",", " ", "..."}], "}"}]}], "InlineCode"]],
   "InlineFormula",ExpressionUUID->"e6b3f8cb-c010-5742-a14c-1d9ab8f55e33"],
 " says how to split the indices: the blocks must sum to the order of the \
array and each must be one or two, since a flat picture holds no more. The \
default, ",
 Cell[BoxData[
  StyleBox["Automatic", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "446ef2af-9f3b-914c-8140-71a33353673c"],
 ", uses ",
 Cell[BoxData[
  StyleBox["ArrayNesting", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "f2b75c1b-a90b-784b-b445-130f59f71552"],
 "."
}], "Notes",ExpressionUUID->"6a3cf84c-0caa-954f-8dbd-19736c300427"],

Cell["\<\
The cells of the innermost block are sized to the widest entry, so that the \
entries of a symbolic array do not overflow one another.\
\>", "Notes",ExpressionUUID->"ef4b7ba7-279c-794c-9a9a-4ec914aca048"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"\"\<Framed\>\"", " ", "->", " ", "False"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"8f38b26b-d792-1247-8882-2bf379b7afc0"],
 " leaves the entries on the background with no cell drawn around them."
}], "Notes",ExpressionUUID->"e31fdddf-f46e-d444-bd79-31bc24c9b9fc"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["\"\<Indices\>\"", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "238c5241-659e-8d4f-a789-74893c2ec157"],
 " is ",
 Cell[BoxData[
  StyleBox["Automatic", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "3c260e0f-132d-664b-8972-e9e7a9135f34"],
 ", which labels the rows and columns; ",
 Cell[BoxData[
  StyleBox["None", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "c2e38b20-2b45-1945-b4aa-fdac58a99aed"],
 ", which labels nothing; or ",
 Cell[BoxData[
  StyleBox["\"\<Colored\>\"", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "54555081-9758-5746-96f8-2be67b16aef0"],
 ", which gives each axis a colour of its own."
}], "Notes",ExpressionUUID->"1ae1ef66-a4bb-ab4d-8f29-e909f9f7dd3b"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["\"\<PlotTheme\>\"", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"46d2be04-8728-8240-8ba8-7caa93bddf5f"],
 " is ",
 Cell[BoxData[
  StyleBox["\"\<Light\>\"", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "2f3fd86d-e181-3a46-a8b2-3c12cdad8f88"],
 " or ",
 Cell[BoxData[
  StyleBox["\"\<Dark\>\"", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "6a43be24-e874-ee44-9abb-69084c352b01"],
 "."
}], "Notes",ExpressionUUID->"b56691a6-6b6d-ba48-a27c-5df870a22ce0"],

Cell[TextData[{
 "An array of more than ",
 Cell[BoxData[
  StyleBox["\"\<MaxEntries\>\"", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"74365be6-e0c2-5741-bc36-edc265f46f68"],
 " entries, 512 by default, is refused with ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayGraphics", "::", "big"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"bb83dbdd-85cc-9b4d-a03b-752383590805"],
 " rather than drawn illegibly."
}], "Notes",ExpressionUUID->"0a90d531-1f78-bc43-976e-1f74b24bab4c"],

Cell["\<\
Array objects and plain nested lists are both accepted, and Graphics options \
are passed through.\
\>", "Notes",ExpressionUUID->"2ba0013c-fba0-3746-a41f-11912c22cf0d"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"9f55bb43-935a-8a46-a7e1-1f154428a2a1"],

Cell["A 1-array is a row of cells, and a 2-array a grid:", "ExampleText",ExpressionUUID->"b09f9c9d-0daa-6e4f-8a4f-e545d5d3f397"],

Cell["\<\
{ArrayGraphics[{1, 2, 3, 4}], ArrayGraphics[{{1, 2, 3}, {4, 5, 6}}]}\
\>", "Input",ExpressionUUID->"d12d7d8e-6411-fd4e-a10a-50627d244533"],

