(* Beginning of Notebook Content *)
Notebook[{
Cell["ArrayGraphics", "ObjectName",ExpressionUUID->"195d3e78-ef03-6b4d-8d76-bb0b6349bc63"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayGraphics", "[", "arr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"edd5fc3c-9123-d047-aa8f-1bc6195a3dca"],
 " ",
 "draws the array arr in the plane."
}], "Usage",ExpressionUUID->"2500f494-2dc9-f949-a22b-b49d805b85d6"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayGraphics", "[", 
    RowBox[{"arr", ",", " ", "opts"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"35a8b855-fcb9-c84d-a880-37fc300b28c1"],
 " ",
 "draws it with the given options."
}], "Usage",ExpressionUUID->"bba3179e-04e3-9342-9a39-6d7502bbecc0"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"cea1f1b2-5e94-694c-81cf-2189d833a4ea"],

Cell["\<\
An array of order one is drawn as a row of cells and one of order two as a \
grid; an array of order zero is a single cell.\
\>", "Notes",ExpressionUUID->"c1d84adf-2c74-824b-8600-0f435be3bc85"],

Cell["\<\
Only those orders have a flat picture of their own. Anything higher is drawn \
as a nesting of them: the first block of indices gives the outer picture, and \
each of its cells holds the picture of the indices that remain. A 3-array is \
a row of grids, a 4-array a grid of grids.\
\>", "Notes",ExpressionUUID->"b8bb0dfb-e3c3-2b40-a7be-8a26f98e2524"],

Cell[TextData[{
 "The result is always a two-dimensional ",
 Cell[BoxData[
  StyleBox["Graphics", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "23922267-9a55-2d4c-972c-2cee8a533954"],
 ". For cubes arranged in space, at every order, see ",
 Cell[BoxData[
  StyleBox["ArrayGraphics3D", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "3024fdd8-ed72-5b4e-a9b8-d24e156c11aa"],
 "."
}], "Notes",ExpressionUUID->"e0337340-5c77-8e4a-a915-45fd9e0d4a8d"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"\"\<Nesting\>\"", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"k1", ",", " ", "k2", ",", " ", "..."}], "}"}]}], "InlineCode"]],
   "InlineFormula",ExpressionUUID->"59a611d0-203d-4141-bc7f-ab65feb4eb18"],
 " says how to split the indices: the blocks must sum to the order of the \
array and each must be one or two, since a flat picture holds no more. The \
default, ",
 Cell[BoxData[
  StyleBox["Automatic", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "232675fa-5537-6446-8806-8f295d50343f"],
 ", uses ",
 Cell[BoxData[
  StyleBox["ArrayNesting", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "bbb5d0de-a679-ef46-bfb8-31765b47b78f"],
 "."
}], "Notes",ExpressionUUID->"36f6179c-060b-404d-af49-a1199cc787e2"],

Cell["\<\
The cells of the innermost block are sized to the widest entry, so that the \
entries of a symbolic array do not overflow one another.\
\>", "Notes",ExpressionUUID->"acc587cd-4dc8-4840-95b5-3e11b64a4592"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"\"\<Framed\>\"", " ", "->", " ", "False"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"fc814d8d-a05b-454b-98c4-e6938e06d166"],
 " leaves the entries on the background with no cell drawn around them."
}], "Notes",ExpressionUUID->"7b8035e8-76a9-a143-bfcf-5f644e1d1e07"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["\"\<Indices\>\"", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "7fcd4286-2721-8040-96a6-4f4069a0b8ce"],
 " is ",
 Cell[BoxData[
  StyleBox["Automatic", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "23a01374-bd22-864d-bf5d-35f164244cb8"],
 ", which labels the rows and columns; ",
 Cell[BoxData[
  StyleBox["None", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "a108c878-010f-0145-a322-a8d741e121a7"],
 ", which labels nothing; or ",
 Cell[BoxData[
  StyleBox["\"\<Colored\>\"", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "bd8dbf44-9577-3e4a-a6fd-e0feafcb8ab4"],
 ", which gives each axis a colour of its own."
}], "Notes",ExpressionUUID->"aac128ab-dc54-2044-9e60-fd63689334d3"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["\"\<PlotTheme\>\"", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"e05f6b6e-f6fa-d148-a115-3da89319e0ab"],
 " is ",
 Cell[BoxData[
  StyleBox["\"\<Light\>\"", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "02491bad-29ac-0f49-8e41-a1b61d87f805"],
 " or ",
 Cell[BoxData[
  StyleBox["\"\<Dark\>\"", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "aeec991e-65df-5e47-a08b-c46dffe82a6b"],
 "."
}], "Notes",ExpressionUUID->"c4192a29-2500-a043-ad6a-c19965264b29"],

Cell[TextData[{
 "An array of more than ",
 Cell[BoxData[
  StyleBox["\"\<MaxEntries\>\"", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"973c88d7-b26f-7d49-b33c-cf3d888e147c"],
 " entries, 512 by default, is refused with ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayGraphics", "::", "big"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"9dd669ce-c813-be4a-b536-7795f65c09ca"],
 " rather than drawn illegibly."
}], "Notes",ExpressionUUID->"8dcb68b8-db83-fe47-9734-10efdc2d8b97"],

Cell["\<\
Array objects and plain nested lists are both accepted, and Graphics options \
are passed through.\
\>", "Notes",ExpressionUUID->"6bd71826-1e1f-c940-bbf4-61ddc60bad34"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"60eaffaa-50cb-c344-990a-311220c90597"],

Cell["A 1-array is a row of cells, and a 2-array a grid:", "ExampleText",ExpressionUUID->"d7e8f715-8093-984e-bcae-37ff4d572d52"],

Cell["\<\
{ArrayGraphics[{1, 2, 3, 4}], ArrayGraphics[{{1, 2, 3}, {4, 5, 6}}]}\
\>", "Input",ExpressionUUID->"4a671d59-d70f-c542-8071-0aa88e5817c6"],

