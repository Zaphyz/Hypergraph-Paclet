(* Beginning of Notebook Content *)
Notebook[{
Cell["ArrayGraphics", "ObjectName",ExpressionUUID->"dd44cedc-64c8-4a44-808e-f6d3bf4356f8"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayGraphics", "[", "arr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"f35dddee-84fe-0248-8d5a-220f61b88ce9"],
 " ",
 "draws the array arr in the plane."
}], "Usage",ExpressionUUID->"12d180c0-7dfb-894a-af35-84aa7a968dd5"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayGraphics", "[", 
    RowBox[{"arr", ",", " ", "opts"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"1aa66289-1698-184d-b97c-354df29fb218"],
 " ",
 "draws it with the given options."
}], "Usage",ExpressionUUID->"d4642b32-a416-ab48-804f-c0360dd13bda"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"147597f3-68d9-784d-accb-b0181bdd8782"],

Cell["\<\
An array of order one is drawn as a row of cells and one of order two as a \
grid; an array of order zero is a single cell.\
\>", "Notes",ExpressionUUID->"2a97fdf8-c2b4-3e46-b52b-958ccf9547ed"],

Cell["\<\
Only those orders have a flat picture of their own. Anything higher is drawn \
as a nesting of them: the first block of indices gives the outer picture, and \
each of its cells holds the picture of the indices that remain. A 3-array is \
a row of grids, a 4-array a grid of grids.\
\>", "Notes",ExpressionUUID->"feee270c-48cf-6a49-b01a-8bac99a82f42"],

Cell[TextData[{
 "The result is always a two-dimensional ",
 Cell[BoxData[
  StyleBox["Graphics", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "371f36f8-1068-1344-add7-b6c5bb634b42"],
 ". For cubes arranged in space, at every order, see ",
 Cell[BoxData[
  StyleBox["ArrayGraphics3D", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "59d24879-8fe8-bf45-8a23-7307b3154836"],
 "."
}], "Notes",ExpressionUUID->"1f5547a8-f4e2-0744-bb6b-8b6670c6f90f"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"\"\<Nesting\>\"", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"k1", ",", " ", "k2", ",", " ", "..."}], "}"}]}], "InlineCode"]],
   "InlineFormula",ExpressionUUID->"a8ad0d44-d2ba-644f-9158-57890d36d30c"],
 " says how to split the indices: the blocks must sum to the order of the \
array and each must be one or two, since a flat picture holds no more. The \
default, ",
 Cell[BoxData[
  StyleBox["Automatic", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "dd4078fa-b2f5-d042-86c3-480bfb92dfad"],
 ", uses ",
 Cell[BoxData[
  StyleBox["ArrayNesting", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "8a1afae5-38bd-7d4d-86bb-f755a382a15f"],
 "."
}], "Notes",ExpressionUUID->"a241dade-b549-414c-b841-c446c7d3d839"],

Cell["\<\
The cells of the innermost block are sized to the widest entry, so that the \
entries of a symbolic array do not overflow one another.\
\>", "Notes",ExpressionUUID->"a01407bd-8e95-324a-a29d-2fe5c7bca530"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"\"\<Framed\>\"", " ", "->", " ", "False"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"6e533f1b-cdc4-0a40-b71f-d09ff85a99d9"],
 " leaves the entries on the background with no cell drawn around them."
}], "Notes",ExpressionUUID->"77bbe958-08b5-d942-b104-3dbed69155bd"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["\"\<Indices\>\"", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "31e68f4c-42b6-cd4f-bcf5-83d18f60ecbd"],
 " is ",
 Cell[BoxData[
  StyleBox["Automatic", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "5db35f2b-e448-dc40-8f7f-72e7b9c14b62"],
 ", which labels the rows and columns; ",
 Cell[BoxData[
  StyleBox["None", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "326a6a53-b3be-f543-96dd-5ffd64ea2885"],
 ", which labels nothing; or ",
 Cell[BoxData[
  StyleBox["\"\<Colored\>\"", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "dbf5ae32-e308-6d44-a49e-dbec18bb09d7"],
 ", which gives each axis a colour of its own."
}], "Notes",ExpressionUUID->"98a38bac-17fd-9d48-8558-7a368a08f838"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["\"\<PlotTheme\>\"", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"5601d3af-9e21-c645-8325-f110f5c2bef1"],
 " is ",
 Cell[BoxData[
  StyleBox["\"\<Light\>\"", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "ff243ad1-d7bf-3542-aac8-f76a43f015ab"],
 " or ",
 Cell[BoxData[
  StyleBox["\"\<Dark\>\"", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "92f7c222-b63c-d640-a0e9-f8246b8c3d61"],
 "."
}], "Notes",ExpressionUUID->"b3a5b9f4-b8dc-094c-9c6c-52da11d43f3b"],

Cell[TextData[{
 "An array of more than ",
 Cell[BoxData[
  StyleBox["\"\<MaxEntries\>\"", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"6bf555bd-90d7-5e44-b419-1f135d87cba8"],
 " entries, 512 by default, is refused with ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayGraphics", "::", "big"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"94bdfc65-7c2f-3f41-b6ba-19227d8eae22"],
 " rather than drawn illegibly."
}], "Notes",ExpressionUUID->"b3ab0a11-186f-2747-a3ac-ed9e00d93c0d"],

Cell["\<\
Array objects and plain nested lists are both accepted, and Graphics options \
are passed through.\
\>", "Notes",ExpressionUUID->"3716484e-91ee-0345-a6d3-724cc0230db1"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"87e30f5c-9563-e044-8772-df500c219854"],

Cell["A 1-array is a row of cells, and a 2-array a grid:", "ExampleText",ExpressionUUID->"42982f27-c139-614b-881d-470fde1b5e5e"],

Cell["\<\
{ArrayGraphics[{1, 2, 3, 4}], ArrayGraphics[{{1, 2, 3}, {4, 5, 6}}]}\
\>", "Input",ExpressionUUID->"cb4fa0da-69c5-6141-9aa9-81a750deb8b5"],

