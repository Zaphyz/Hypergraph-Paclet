(* Beginning of Notebook Content *)
Notebook[{
Cell["ArrayGraphics", "ObjectName",ExpressionUUID->"1ec271fc-c85f-a941-8d89-24cf57dc96e7"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayGraphics", "[", "arr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"49e0d2dc-b247-1847-b615-c354ab232da9"],
 " ",
 "draws the array arr in the plane."
}], "Usage",ExpressionUUID->"362145e4-825f-dd46-99cc-03d225a56111"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayGraphics", "[", 
    RowBox[{"arr", ",", " ", "opts"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"e41220e3-61bc-b541-aa06-af91555348de"],
 " ",
 "draws it with the given options."
}], "Usage",ExpressionUUID->"c0668e5b-5c6b-ff47-8544-1918fa46b62a"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"9c61e736-733e-f642-b7cb-62cfe66325e3"],

Cell["\<\
An array of order one is drawn as a row of cells and one of order two as a \
grid; an array of order zero is a single cell.\
\>", "Notes",ExpressionUUID->"67227932-c741-5246-aab1-7f44b5a073a6"],

Cell["\<\
Only those orders have a flat picture of their own. Anything higher is drawn \
as a nesting of them: the first block of indices gives the outer picture, and \
each of its cells holds the picture of the indices that remain. A 3-array is \
a row of grids, a 4-array a grid of grids.\
\>", "Notes",ExpressionUUID->"c58338e7-fe23-0142-821e-eed4bb33a5d6"],

Cell[TextData[{
 "The result is always a two-dimensional ",
 Cell[BoxData[
  StyleBox["Graphics", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "3c50b3f7-d3b6-fa49-b7f3-d0af68d596f0"],
 ". For cubes arranged in space, at every order, see ",
 Cell[BoxData[
  StyleBox["ArrayGraphics3D", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "a6de2f26-9038-3f4b-a4e4-377fb5d3112b"],
 "."
}], "Notes",ExpressionUUID->"fc55fe26-a5d5-7b4f-be5d-0050619776b6"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"\"\<Nesting\>\"", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"k1", ",", " ", "k2", ",", " ", "..."}], "}"}]}], "InlineCode"]],
   "InlineFormula",ExpressionUUID->"405107ad-d358-7c42-8a30-67982b578f2a"],
 " says how to split the indices: the blocks must sum to the order of the \
array and each must be one or two, since a flat picture holds no more. The \
default, ",
 Cell[BoxData[
  StyleBox["Automatic", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "01bb4262-d90e-3e4e-9aea-c119abeef813"],
 ", uses ",
 Cell[BoxData[
  StyleBox["ArrayNesting", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "b47ad4a8-6d4d-4e44-a500-82cb88305633"],
 "."
}], "Notes",ExpressionUUID->"0515c007-0b06-aa41-b0d0-a8b746c545d7"],

Cell["\<\
The cells of the innermost block are sized to the widest entry, so that the \
entries of a symbolic array do not overflow one another.\
\>", "Notes",ExpressionUUID->"bf3dea2d-d6cc-9b41-a296-3af4fd13726c"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"\"\<Framed\>\"", " ", "->", " ", "False"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"d48b93f3-ef6d-5f40-8cd6-d861ed3dcc39"],
 " leaves the entries on the background with no cell drawn around them."
}], "Notes",ExpressionUUID->"f06d0bab-1d5d-6043-8b8b-7fb8665200bc"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["\"\<Indices\>\"", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "96e69aad-17c3-7447-8e5b-5b247415bd8a"],
 " is ",
 Cell[BoxData[
  StyleBox["Automatic", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "b8f9dcee-4fb0-5547-a393-9382ecdf773d"],
 ", which labels the rows and columns; ",
 Cell[BoxData[
  StyleBox["None", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "4d3dcf02-08c1-9244-b9a9-1f2fcd8c1597"],
 ", which labels nothing; or ",
 Cell[BoxData[
  StyleBox["\"\<Colored\>\"", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "0fc78754-793a-be41-9891-0ac26cf72293"],
 ", which gives each axis a colour of its own."
}], "Notes",ExpressionUUID->"1d025850-1611-cd47-bcaf-721550cebb0c"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["\"\<PlotTheme\>\"", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"006c0673-73f9-4d4b-82cb-4846d8d6b143"],
 " is ",
 Cell[BoxData[
  StyleBox["\"\<Light\>\"", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "c3ce0079-7646-c247-a6f8-d26ba4a6c601"],
 " or ",
 Cell[BoxData[
  StyleBox["\"\<Dark\>\"", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "4ec97d97-ae2c-4147-82a2-bc80b2eb1599"],
 "."
}], "Notes",ExpressionUUID->"b7548194-2869-7046-b3c8-1492aa722523"],

Cell[TextData[{
 "An array of more than ",
 Cell[BoxData[
  StyleBox["\"\<MaxEntries\>\"", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"919284e0-5978-b342-becf-e9ad57725513"],
 " entries, 512 by default, is refused with ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayGraphics", "::", "big"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"dcfaf4cf-976e-ab4d-a8f4-8cad6bd8e8d5"],
 " rather than drawn illegibly."
}], "Notes",ExpressionUUID->"dd1e1f0a-3ca5-2242-881c-605ebfa7a97d"],

Cell["\<\
Array objects and plain nested lists are both accepted, and Graphics options \
are passed through.\
\>", "Notes",ExpressionUUID->"d11bc268-76ed-6547-9b0a-a730b807bcde"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"3c0d93ef-bae0-5e42-9f7f-5353fae41855"],

Cell["A 1-array is a row of cells, and a 2-array a grid:", "ExampleText",ExpressionUUID->"5fca11a4-f91a-4c49-9e6e-e58c1cf70d8f"],

Cell["\<\
{ArrayGraphics[{1, 2, 3, 4}], ArrayGraphics[{{1, 2, 3}, {4, 5, 6}}]}\
\>", "Input",ExpressionUUID->"104d24aa-f3d1-dc44-a2ef-f645e565c7cc"],

