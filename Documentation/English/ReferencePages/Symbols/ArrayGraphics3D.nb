(* Beginning of Notebook Content *)
Notebook[{
Cell["ArrayGraphics3D", "ObjectName",ExpressionUUID->"989cc18f-9319-c646-8f01-09aa2ac388c1"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayGraphics3D", "[", "arr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"b65afaf7-86fe-384a-9b58-7760ddc7c140"],
 " ",
 "draws the array arr as cubes arranged in space."
}], "Usage",ExpressionUUID->"552ec6c5-4c8b-a04b-a66f-e057330133cb"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayGraphics3D", "[", 
    RowBox[{"arr", ",", " ", "opts"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"ee9addd1-75ee-2841-b7cf-a35ba8aa7339"],
 " ",
 "draws it with the given options."
}], "Usage",ExpressionUUID->"7867be9e-b0b8-a944-bcfd-01cdad5c57fc"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"93962faf-bd95-084b-9b66-4653de4fc3be"],

Cell["\<\
An array of order one is drawn as a line of cubes, one of order two as a \
plane of them, and one of order three as a lattice. The entry at index tuple \
(i, j, k) sits at the point {i, j, k}, an index the array does not have \
standing at one.\
\>", "Notes",ExpressionUUID->"ae72b66b-6b40-0643-a39a-e65f1f628fc3"],

Cell["\<\
An array of higher order is drawn by tiling: the inner block of indices is \
drawn as a lattice, and the outer block repeats that lattice through space, \
shifted by its own extent and a gap. Everything ends up in one picture, since \
space has no room for pictures inset into pictures.\
\>", "Notes",ExpressionUUID->"966fdf97-5a9f-4242-8396-9150cdbd684b"],

Cell[TextData[{
 "The result is always a three-dimensional ",
 Cell[BoxData[
  StyleBox["Graphics3D", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "6d99252b-ed25-624a-bf1c-20f5d4f4a84d"],
 ". For plane pictures at every order see ",
 Cell[BoxData[
  StyleBox["ArrayGraphics", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "0649bb8f-938e-8d46-b8c7-97fb574d3956"],
 "."
}], "Notes",ExpressionUUID->"7897fe2e-621e-574a-b43f-d3f8b4ec708d"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"\"\<Nesting\>\"", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"k1", ",", " ", "k2", ",", " ", "..."}], "}"}]}], "InlineCode"]],
   "InlineFormula",ExpressionUUID->"d4a1f258-17a1-1741-a06b-a6e61b8397cb"],
 " says how to split the indices: the blocks must sum to the order of the \
array and each must be one, two or three, space holding no more at a time. \
The default uses ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayNesting", "[", 
    RowBox[{"n", ",", " ", "3"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"c949460c-d476-9440-8218-f01dd750dde5"],
 "."
}], "Notes",ExpressionUUID->"26724770-b6c0-ba45-9734-7fb1eb23ac4e"],

Cell["\<\
The cubes have translucent faces and no outline, so that the entries behind \
them can still be read; an outline on every cube of a lattice reads as a mesh \
rather than as a set of cells.\
\>", "Notes",ExpressionUUID->"285cca1e-d8a4-104f-871e-31344d3de26b"],

Cell[TextData[{
 "A gnomon in the near corner marks as many axes as the picture uses; ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"\"\<Gnomon\>\"", " ", "->", " ", "False"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"8340588f-1347-7c4a-90eb-e35ada9b809b"],
 " drops it. ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"\"\<Indices\>\"", " ", "->", " ", "\"\<Colored\>\""}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "80edb976-7091-c747-baf2-9106e96999fb"],
 " gives each axis a colour of its own."
}], "Notes",ExpressionUUID->"20548888-289e-eb4b-b1fe-254b25c4b9f2"],

Cell["\<\
The reference implementation this package grew out of drew only the \
order-three case, and called such a picture a cubix; the name is not kept, \
but the look of it is.\
\>", "Notes",ExpressionUUID->"5212b3cb-55d1-2346-a02d-69b2ce293a30"],

Cell["The other options are shared with ArrayGraphics.", "Notes",ExpressionUUID->"dcfa0993-44b3-ae4a-b8fd-d274a5e546cf"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"ce238a7f-0159-0c46-895e-b84ac336fc2c"],

Cell["At order one a line of cubes, at order two a plane of them:", \
"ExampleText",ExpressionUUID->"e943720f-e1c1-0a4d-b82a-6cda35b0d08d"],

Cell["\<\
{ArrayGraphics3D[{1, 2, 3, 4}], ArrayGraphics3D[{{1, 2, 3}, {4, 5, 6}}]}\
\>", "Input",ExpressionUUID->"cbeef33a-d790-5841-8f0d-64d1ca40ee9c"],

