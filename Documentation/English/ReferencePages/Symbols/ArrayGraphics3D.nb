(* Beginning of Notebook Content *)
Notebook[{
Cell["ArrayGraphics3D", "ObjectName",ExpressionUUID->"623099fe-1ad4-d548-9245-4aa3cd34d9f3"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayGraphics3D", "[", "arr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"ed7216e2-6853-de43-b7fe-b37220313ba4"],
 " ",
 "draws the array arr as cubes arranged in space."
}], "Usage",ExpressionUUID->"3e92c7d4-5144-f841-86ce-e480ecd127bf"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayGraphics3D", "[", 
    RowBox[{"arr", ",", " ", "opts"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"897f8ce6-c886-8043-bd9d-f54c85371dd9"],
 " ",
 "draws it with the given options."
}], "Usage",ExpressionUUID->"bc2015ca-ee12-4940-8132-e320d695599f"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"1a02134d-685b-9c4a-b5dd-da454617f691"],

Cell["\<\
An array of order one is drawn as a line of cubes, one of order two as a \
plane of them, and one of order three as a lattice. The entry at index tuple \
(i, j, k) sits at the point {i, j, k}, an index the array does not have \
standing at one.\
\>", "Notes",ExpressionUUID->"059fb2fe-8abe-c746-bd15-a0a4bdc17816"],

Cell["\<\
An array of higher order is drawn by tiling: the inner block of indices is \
drawn as a lattice, and the outer block repeats that lattice through space, \
shifted by its own extent and a gap. Everything ends up in one picture, since \
space has no room for pictures inset into pictures.\
\>", "Notes",ExpressionUUID->"6780f462-65bd-ad4e-b4de-fcc52aa81bf2"],

Cell[TextData[{
 "The result is always a three-dimensional ",
 Cell[BoxData[
  StyleBox["Graphics3D", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "5ac125e5-24a3-cf48-9c94-a4b5a367a6dc"],
 ". For plane pictures at every order see ",
 Cell[BoxData[
  StyleBox["ArrayGraphics", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "32ebbf17-39b3-244f-8d6c-d8cffd922fa4"],
 "."
}], "Notes",ExpressionUUID->"42fbcf70-b2f8-4d49-b13d-2abf761ca6b3"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"\"\<Nesting\>\"", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"k1", ",", " ", "k2", ",", " ", "..."}], "}"}]}], "InlineCode"]],
   "InlineFormula",ExpressionUUID->"9864c183-f544-6444-9602-d73d523a6c2e"],
 " says how to split the indices: the blocks must sum to the order of the \
array and each must be one, two or three, space holding no more at a time. \
The default uses ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayNesting", "[", 
    RowBox[{"n", ",", " ", "3"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"b5b7103e-0f14-4049-b33d-69f9dd0912c4"],
 "."
}], "Notes",ExpressionUUID->"556b1b40-5ff3-fd43-8a06-7ea0a4a4789c"],

Cell["\<\
The cubes have translucent faces and no outline, so that the entries behind \
them can still be read; an outline on every cube of a lattice reads as a mesh \
rather than as a set of cells.\
\>", "Notes",ExpressionUUID->"c0a0673e-0b5f-514a-8e11-06d5f03adf14"],

Cell[TextData[{
 "A gnomon in the near corner marks as many axes as the picture uses; ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"\"\<Gnomon\>\"", " ", "->", " ", "False"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"a201048d-f145-b64f-9bfe-6652708789a6"],
 " drops it. ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"\"\<Indices\>\"", " ", "->", " ", "\"\<Colored\>\""}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "6420a016-7a33-7242-88e3-feb83f3fa65e"],
 " gives each axis a colour of its own."
}], "Notes",ExpressionUUID->"6fb1d4c1-bc07-b14e-8295-49d4d5b164a5"],

Cell["\<\
The reference implementation this package grew out of drew only the \
order-three case, and called such a picture a cubix; the name is not kept, \
but the look of it is.\
\>", "Notes",ExpressionUUID->"625b3b57-572a-d946-af9a-83646d3b97d2"],

Cell["The other options are shared with ArrayGraphics.", "Notes",ExpressionUUID->"de0f30ee-8d10-6248-87ab-15f245ad87e3"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"8114fcb8-42f0-914f-979b-9cc3ed1b5641"],

Cell["At order one a line of cubes, at order two a plane of them:", \
"ExampleText",ExpressionUUID->"25823147-77f0-1d43-b6be-c195c4e74667"],

Cell["\<\
{ArrayGraphics3D[{1, 2, 3, 4}], ArrayGraphics3D[{{1, 2, 3}, {4, 5, 6}}]}\
\>", "Input",ExpressionUUID->"8e16a0aa-5f38-0148-9a17-4c38db72fc6b"],

