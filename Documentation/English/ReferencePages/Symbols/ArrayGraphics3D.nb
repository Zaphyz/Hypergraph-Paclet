(* Beginning of Notebook Content *)
Notebook[{
Cell["ArrayGraphics3D", "ObjectName",ExpressionUUID->"5eae4c41-2694-6649-a140-2b78b08e3402"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayGraphics3D", "[", "arr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"220af809-78be-c046-b020-67fdb86b023b"],
 " ",
 "draws the array arr as cubes arranged in space."
}], "Usage",ExpressionUUID->"6ce45354-b8fe-344e-9d1e-f923c1e3245d"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayGraphics3D", "[", 
    RowBox[{"arr", ",", " ", "opts"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"aeadc126-eaaa-714c-9cb4-a34baaf2a6a2"],
 " ",
 "draws it with the given options."
}], "Usage",ExpressionUUID->"9f5b9950-bb51-a047-92da-0f7ad7d24d34"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"7fc39cbd-0afa-8e42-a277-fb28ad7d953a"],

Cell["\<\
An array of order one is drawn as a line of cubes, one of order two as a \
plane of them, and one of order three as a lattice. The entry at index tuple \
(i, j, k) sits at the point {i, j, k}, an index the array does not have \
standing at one.\
\>", "Notes",ExpressionUUID->"724896cb-4959-1941-a4b6-2f2753099565"],

Cell["\<\
An array of higher order is drawn by tiling: the inner block of indices is \
drawn as a lattice, and the outer block repeats that lattice through space, \
shifted by its own extent and a gap. Everything ends up in one picture, since \
space has no room for pictures inset into pictures.\
\>", "Notes",ExpressionUUID->"4c4f32b9-e1cf-ff4c-a129-305911e6f9d7"],

Cell[TextData[{
 "The result is always a three-dimensional ",
 Cell[BoxData[
  StyleBox["Graphics3D", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "064200c1-4c2d-f244-a924-848ef4e9c9f0"],
 ". For plane pictures at every order see ",
 Cell[BoxData[
  StyleBox["ArrayGraphics", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "84e5433b-62be-7547-9dd1-9438882c212a"],
 "."
}], "Notes",ExpressionUUID->"654e7c3e-6605-a040-ab5f-23f08b1a4c58"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"\"\<Nesting\>\"", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"k1", ",", " ", "k2", ",", " ", "..."}], "}"}]}], "InlineCode"]],
   "InlineFormula",ExpressionUUID->"763058e0-cd13-8943-969f-88a8d143319f"],
 " says how to split the indices: the blocks must sum to the order of the \
array and each must be one, two or three, space holding no more at a time. \
The default uses ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayNesting", "[", 
    RowBox[{"n", ",", " ", "3"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"d52936cd-c352-0f45-94ca-2db850ee64e3"],
 "."
}], "Notes",ExpressionUUID->"ef713071-5e7a-a745-9fdd-990d2d527b0b"],

Cell["\<\
The cubes have translucent faces and no outline, so that the entries behind \
them can still be read; an outline on every cube of a lattice reads as a mesh \
rather than as a set of cells.\
\>", "Notes",ExpressionUUID->"c7fcc982-d9c6-a945-a3b7-fc64a4fb956d"],

Cell[TextData[{
 "A gnomon in the near corner marks as many axes as the picture uses; ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"\"\<Gnomon\>\"", " ", "->", " ", "False"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"92a89489-0070-b942-b06e-9512738f90d7"],
 " drops it. ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"\"\<Indices\>\"", " ", "->", " ", "\"\<Colored\>\""}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "d447f038-7ea0-2f40-a6b3-9df1b1135195"],
 " gives each axis a colour of its own."
}], "Notes",ExpressionUUID->"a2f6ace1-1df0-d94f-9c7e-7881d97e4bca"],

Cell["\<\
The reference implementation this package grew out of drew only the \
order-three case, and called such a picture a cubix; the name is not kept, \
but the look of it is.\
\>", "Notes",ExpressionUUID->"efd9fcdc-a570-5d41-9439-c9c3b8fd12a2"],

Cell["The other options are shared with ArrayGraphics.", "Notes",ExpressionUUID->"b5bbc9d3-257a-0d49-9c46-bd257728a696"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"c2936007-75b3-eb42-aa7b-9dd9b3088a20"],

Cell["At order one a line of cubes, at order two a plane of them:", \
"ExampleText",ExpressionUUID->"da240850-e7f6-4349-9ede-b890ce8733c6"],

Cell["\<\
{ArrayGraphics3D[{1, 2, 3, 4}], ArrayGraphics3D[{{1, 2, 3}, {4, 5, 6}}]}\
\>", "Input",ExpressionUUID->"fadd14b8-03c2-aa4f-8c77-f858d65f4273"],

