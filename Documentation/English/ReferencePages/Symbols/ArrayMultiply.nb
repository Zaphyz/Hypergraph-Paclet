Cell["\<\
A symbolic array comes through as its list of lists of terms, and the \
contraction builds the corresponding expressions:\
\>", "ExampleText",ExpressionUUID->"56b15a74-c862-e340-8c6c-bff49eb2b443"],

Cell["\<\
sa = Normal @ SymbolicArray[p, {2, 2}]; sb = Normal @ SymbolicArray[q, {2, 2}];
ArrayMultiply[{sa, sb}, \"ij,jk->ik\"]\
\>", "Input",ExpressionUUID->"d825454e-90e9-364e-a541-5168db701f87"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"p", "[", 
        RowBox[{"1", ",", "1"}], "]"}], " ", 
       RowBox[{"q", "[", 
        RowBox[{"1", ",", "1"}], "]"}]}], "+", 
      RowBox[{
       RowBox[{"p", "[", 
        RowBox[{"1", ",", "2"}], "]"}], " ", 
       RowBox[{"q", "[", 
        RowBox[{"2", ",", "1"}], "]"}]}]}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"p", "[", 
        RowBox[{"1", ",", "1"}], "]"}], " ", 
       RowBox[{"q", "[", 
        RowBox[{"1", ",", "2"}], "]"}]}], "+", 
      RowBox[{
       RowBox[{"p", "[", 
        RowBox[{"1", ",", "2"}], "]"}], " ", 
       RowBox[{"q", "[", 
        RowBox[{"2", ",", "2"}], "]"}]}]}]}], "}"}], ",", 
   RowBox[{"{", 
