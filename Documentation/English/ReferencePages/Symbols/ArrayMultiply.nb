ID->"9eba8870-2328-8a4f-808c-40b5c82c1b26"],

Cell["\<\
Repeating an index within one array takes a diagonal, and dropping it from \
the output sums it:\
\>", "ExampleText",ExpressionUUID->"5ea826b3-aa15-b740-9030-2871c14df32a"],

Cell["\<\
{Normal @ ArrayMultiply[{a}, \"ii->i\"], Normal @ ArrayMultiply[{a}, \
\"ii->\"]}\
\>", "Input",ExpressionUUID->"6934d160-a34d-c343-8ea6-c9ed07474f9f"],

