D->"70445ed9-f0aa-4a4c-af25-1441ed1e6ee0"],

Cell["A transpose is a contraction that sums nothing:", "ExampleText",ExpressionUUID->"dd25b399-4aee-9f4e-bc31-a90a7985edb3"],

Cell["Normal @ ArrayMultiply[{a}, \"ij->ji\"]", "Input",ExpressionUUID->"1b8683fe-ee45-ee47-a2fb-68d7229b6868"],

