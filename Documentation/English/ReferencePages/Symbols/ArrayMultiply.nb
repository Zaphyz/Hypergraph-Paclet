Cell["\<\
Contracting one array onto no indices at all gives the trace, on numerical \
and symbolic entries alike:\
\>", "ExampleText",ExpressionUUID->"c276eab2-8486-9042-aa6f-3f5f4d398eb5"],

Cell["\<\
trace[u_List] := Normal @ ArrayMultiply[{u}, \"pp->\"];
{trace[a], trace[sa]}\
\>", "Input",ExpressionUUID->"1dc523fb-27f7-6c4a-b4fb-a062e317c272"],

