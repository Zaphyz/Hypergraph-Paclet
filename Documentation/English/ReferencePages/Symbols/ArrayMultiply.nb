Cell["\<\
Its entries, and the same contraction written with index lists:\
\>", "ExampleText",ExpressionUUID->"b212be42-3be6-fe43-8730-c610f8ab69a2"],

Cell["\<\
a = {{1, 2}, {3, 4}}; b = {{0, 1}, {1, 0}};
{Normal @ ArrayMultiply[{a, b}, \"ij,jk->ik\"], Normal @ ArrayMultiply[{a, \
b}, {{1, 2}, {2, 3}} -> {1, 3}]}\
\>", "Input",ExpressionUUID->"0890b602-8e8c-1949-bf2d-a9fb63dd88e3"],

