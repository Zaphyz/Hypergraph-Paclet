ID->"4714d90a-10eb-584e-a7c3-fdd39dbb9756"],

Cell["\<\
Repeating an index within one array takes a diagonal, and dropping it from \
the output sums it:\
\>", "ExampleText",ExpressionUUID->"0d34bd38-e6de-d248-aa49-9045daa0b96e"],

Cell["\<\
{Normal @ ArrayMultiply[{a}, \"ii->i\"], Normal @ ArrayMultiply[{a}, \
\"ii->\"]}\
\>", "Input",ExpressionUUID->"81561db0-717a-2942-81a8-fa0900ae9ee4"],

