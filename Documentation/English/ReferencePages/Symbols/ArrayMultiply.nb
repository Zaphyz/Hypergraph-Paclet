Cell["\<\
Its entries, and the same contraction written with index lists:\
\>", "ExampleText",ExpressionUUID->"a1820f03-cf5f-694f-9712-22679f7eafe5"],

Cell["\<\
a = {{1, 2}, {3, 4}}; b = {{0, 1}, {1, 0}};
{Normal @ ArrayMultiply[{a, b}, \"ij,jk->ik\"], Normal @ ArrayMultiply[{a, \
b}, {{1, 2}, {2, 3}} -> {1, 3}]}\
\>", "Input",ExpressionUUID->"b092ca68-a269-df4b-b427-2545fa6fb5df"],

