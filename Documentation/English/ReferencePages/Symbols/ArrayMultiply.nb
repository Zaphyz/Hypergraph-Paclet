Cell["\<\
An index may join three arrays at once. This is the Bhattacharya-Mesner \
product of three 3-arrays:\
\>", "ExampleText",ExpressionUUID->"e75da950-caba-f74b-b240-a1178ed6a74f"],

Cell["\<\
x = Array[#1 + #2 + #3 &, {2, 2, 2}];
Normal @ ArrayMultiply[{x, x, x}, \"ijp,ipk,pjk->ijk\"]\
\>", "Input",ExpressionUUID->"b4eba01f-bcd4-7640-88d5-5b5f155bdaf4"],

