Cell["\<\
Its entries, and the same contraction written with index lists:\
\>", "ExampleText",ExpressionUUID->"4e8d9886-df02-a546-8376-fa477060a6e3"],

Cell["\<\
a = {{1, 2}, {3, 4}}; b = {{0, 1}, {1, 0}};

{Normal @ ArrayMultiply[{a, b}, \"ij,jk->ik\"], Normal @ ArrayMultiply[{a, \
b}, {{1, 2}, {2, 3}} -> {1, 3}]}\
\>", "Input",ExpressionUUID->"da168844-d126-8248-9a75-398f77516aa1"],

