Cell["\<\
An index may join three arrays at once. This is the Bhattacharya-Mesner \
product of three 3-arrays:\
\>", "ExampleText",ExpressionUUID->"63e82c2b-ac86-1d48-8d6f-2451f97b2c5e"],

Cell["\<\
x = Array[#1 + #2 + #3 &, {2, 2, 2}];
Normal @ ArrayMultiply[{x, x, x}, \"ijp,ipk,pjk->ijk\"]\
\>", "Input",ExpressionUUID->"fa78dd00-fcd7-3340-8d3a-399c4ccd69cd"],

