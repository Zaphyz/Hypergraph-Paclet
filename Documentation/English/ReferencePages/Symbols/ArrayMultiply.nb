"a96a9e5a-902e-2f4d-a2a2-99b2bd176bf0"],

Cell["\<\
An index may join three arrays at once. This is the Bhattacharya-Mesner \
product of three 3-arrays:\
\>", "ExampleText",ExpressionUUID->"fd62d555-a21c-e44f-b370-225d9148963b"],

Cell["\<\
x = Array[#1 + #2 + #3 &, {2, 2, 2}];
Normal @ ArrayMultiply[{x, x, x}, \"ijp,ipk,pjk->ijk\"]\
\>", "Input",ExpressionUUID->"ba475eb5-b205-7e4f-ae81-ce666bc969b2"],

