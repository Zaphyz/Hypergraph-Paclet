Cell["\<\
Its entries, and the same contraction written with index lists:\
\>", "ExampleText",ExpressionUUID->"f0a6f056-7fa2-c447-8a2d-9b44cc3c17ee"],

Cell["\<\
a = {{1, 2}, {3, 4}}; b = {{0, 1}, {1, 0}};
{Normal @ ArrayMultiply[{a, b}, \"ij,jk->ik\"], Normal @ ArrayMultiply[{a, \
b}, {{1, 2}, {2, 3}} -> {1, 3}]}\
\>", "Input",ExpressionUUID->"50987431-be79-6c47-96e2-c2c9f9eace59"],

