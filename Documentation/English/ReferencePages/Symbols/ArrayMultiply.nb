Cell["\<\
A symbolic array comes through as its list of lists of terms, and the \
contraction builds the corresponding expressions:\
\>", "ExampleText",ExpressionUUID->"c9487ae9-e50a-4e4b-95f1-bf21a9fdc415"],

Cell["\<\
sa = Normal @ GenerateSymbolicArray[p, {2, 2}]; sb = Normal @ \
GenerateSymbolicArray[q, {2, 2}];
ArrayMultiply[{sa, sb}, \"ij,jk->ik\"]\
\>", "Input",ExpressionUUID->"31218d66-807f-2641-bbe3-16842be648ab"],

