ID->"5f9bbbf8-e18e-5d42-9f86-5c9139af09df"],

Cell["\<\
Repeating an index within one array takes a diagonal, and dropping it from \
the output sums it:\
\>", "ExampleText",ExpressionUUID->"98855f15-2129-274f-a17f-6c5cd167a7f9"],

Cell["\<\
{Normal @ ArrayMultiply[{a}, \"ii->i\"], Normal @ ArrayMultiply[{a}, \
\"ii->\"]}\
\>", "Input",ExpressionUUID->"2578e62d-6ab0-1f40-baa2-ba125ad90a71"],

