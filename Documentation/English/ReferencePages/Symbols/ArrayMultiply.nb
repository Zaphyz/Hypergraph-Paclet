sionUUID->"319220a9-1aff-3a4c-a28f-c745f94670e8"],

Cell["\<\
Numerical and symbolic arrays may not be mixed in one contraction:\
\>", "ExampleText",ExpressionUUID->"96763b46-f9b2-4445-adee-beb640becc3f"],

Cell["Quiet @ ArrayMultiply[{a, sb}, \"ij,jk->ik\"]", "Input",ExpressionUUID->"b5bd3907-bad1-a040-975a-dd67d6bad207"],

Cell[BoxData["$Failed"], "Output",ExpressionUUID->"4a463df0-8523-354d-9f1d-02afb3c3aa5f"],

Cell["\<\
Contracting one array onto no indices at all gives the trace, on numerical \
and symbolic entries alike:\
\>", "ExampleText",ExpressionUUID->"7e44135d-e736-d04c-afbe-b88ba7f2bd14"],

Cell["\<\
trace[u_List] := Normal @ ArrayMultiply[{u}, \"pp->\"];
{trace[a], trace[sa]}\
\>", "Input",ExpressionUUID->"41c9b2f9-d740-5f49-890e-667b38fc8611"],

