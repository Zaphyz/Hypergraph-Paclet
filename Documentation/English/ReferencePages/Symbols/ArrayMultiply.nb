Cell["\<\
With the output part omitted, whatever occurs exactly once survives; here \
nothing does, so the result is the 0-array:\
\>", "ExampleText",ExpressionUUID->"b5b188ba-1a7a-6640-9056-5dc16ffcc1a0"],

Cell["ArrayMultiply[{{1, 2, 3}, {4, 5, 6}}, \"i,i\"]", "Input",ExpressionUUID->"0f65e8b1-b87e-3f4b-ba3b-a59cd08c29bd"],

