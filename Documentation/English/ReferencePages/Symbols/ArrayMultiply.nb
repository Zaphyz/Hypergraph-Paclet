ID->"f56d9e49-75c7-3544-ad6d-1153fce74f46"],

Cell["\<\
Repeating an index within one array takes a diagonal, and dropping it from \
the output sums it:\
\>", "ExampleText",ExpressionUUID->"b75d0177-e3ab-454a-bd21-0328353ea6e3"],

Cell["\<\
{Normal @ ArrayMultiply[{a}, \"ii->i\"], Normal @ ArrayMultiply[{a}, \
\"ii->\"]}\
\>", "Input",ExpressionUUID->"16638c35-64c6-e54f-9e3e-79fb2999deac"],

