Cell["\<\
An index may join three arrays at once. This is the Bhattacharya-Mesner \
product of three 3-arrays:\
\>", "ExampleText",ExpressionUUID->"6fb8cc87-4e37-cd46-88d8-eeb895f2d479"],

Cell["\<\
x = Array[#1 + #2 + #3 &, {2, 2, 2}];
Normal @ ArrayMultiply[{x, x, x}, \"ijp,ipk,pjk->ijk\"]\
\>", "Input",ExpressionUUID->"8eec7822-46ca-3343-ac59-139f2ba3b6f2"],

