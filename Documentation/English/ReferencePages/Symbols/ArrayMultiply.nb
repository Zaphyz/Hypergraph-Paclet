ID->"aec14f7d-9bbc-8b46-916d-fc09d9569c77"],

Cell["\<\
Repeating an index within one array takes a diagonal, and dropping it from \
the output sums it:\
\>", "ExampleText",ExpressionUUID->"403fc038-2157-2e40-90fe-f5e1d7d8912c"],

Cell["\<\
{Normal @ ArrayMultiply[{a}, \"ii->i\"], Normal @ ArrayMultiply[{a}, \
\"ii->\"]}\
\>", "Input",ExpressionUUID->"a307ad8a-9048-b84e-aae0-c896364e2956"],

