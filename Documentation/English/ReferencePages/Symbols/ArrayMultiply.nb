Cell["\<\
Contracting one array onto no indices at all gives the trace, on numerical \
and symbolic entries alike:\
\>", "ExampleText",ExpressionUUID->"bbc09879-3575-4049-ac61-57cdf24cb59f"],

Cell["\<\
trace[u_List] := Normal @ ArrayMultiply[{u}, \"pp->\"];
{trace[a], trace[sa]}\
\>", "Input",ExpressionUUID->"8a954671-e750-c848-afbc-4e2298f2bbca"],

