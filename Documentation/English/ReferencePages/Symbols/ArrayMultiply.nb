Cell["\<\
Its entries, and the same contraction written with index lists:\
\>", "ExampleText",ExpressionUUID->"7bce62b0-fa26-a245-9f68-7b5120cb5793"],

Cell["\<\
a = {{1, 2}, {3, 4}}; b = {{0, 1}, {1, 0}};
{Normal @ ArrayMultiply[{a, b}, \"ij,jk->ik\"], Normal @ ArrayMultiply[{a, \
b}, {{1, 2}, {2, 3}} -> {1, 3}]}\
\>", "Input",ExpressionUUID->"59fdb6e0-e539-a144-b4c0-98c669022045"],

