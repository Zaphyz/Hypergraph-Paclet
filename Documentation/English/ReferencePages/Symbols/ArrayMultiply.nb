Cell["\<\
Contracting one array onto no indices at all gives the trace, on numerical \
and symbolic entries alike:\
\>", "ExampleText",ExpressionUUID->"606f72cb-4a08-9a48-bb8c-4a782c1e21ff"],

Cell["\<\
trace[u_List] := Normal @ ArrayMultiply[{u}, \"pp->\"];
{trace[a], trace[sa]}\
\>", "Input",ExpressionUUID->"b3bc2d67-a29d-7f46-822a-63f271d4ff8c"],

Cell[BoxData[
