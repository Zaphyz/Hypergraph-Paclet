        RowBox[{"1", ",", "1"}], "]"}]}], "+", 
      RowBox[{
       RowBox[{"p", "[", 
        RowBox[{"2", ",", "2"}], "]"}], " ", 
       RowBox[{"q", "[", 
        RowBox[{"2", ",", "1"}], "]"}]}]}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"p", "[", 
        RowBox[{"2", ",", "1"}], "]"}], " ", 
       RowBox[{"q", "[", 
        RowBox[{"1", ",", "2"}], "]"}]}], "+", 
