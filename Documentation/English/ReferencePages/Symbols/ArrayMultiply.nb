Cell["\<\
Contracting one array onto no indices at all gives the trace, on numerical \
and symbolic entries alike:\
\>", "ExampleText",ExpressionUUID->"ea22a4c8-f785-a74c-bda7-56f3be8a3b99"],

Cell["\<\
trace[u_List] := Normal @ ArrayMultiply[{u}, \"pp->\"];
{trace[a], trace[sa]}\
\>", "Input",ExpressionUUID->"1105c595-0434-3649-a65a-8c96b5cb4f88"],

