ID->"3daa1ad1-5eea-9940-b5f4-15ef6524f72c"],

Cell["\<\
Repeating an index within one array takes a diagonal, and dropping it from \
the output sums it:\
\>", "ExampleText",ExpressionUUID->"585120d4-bde7-7243-a3ad-516e25c03457"],

Cell["\<\
{Normal @ ArrayMultiply[{a}, \"ii->i\"], Normal @ ArrayMultiply[{a}, \
\"ii->\"]}\
\>", "Input",ExpressionUUID->"c2833b91-9328-2e43-97f9-57c8a7bc6f9a"],

