ID->"ce08e902-0c13-da4a-b432-c08e2e5d58ec"],

Cell["\<\
Repeating an index within one array takes a diagonal, and dropping it from \
the output sums it:\
\>", "ExampleText",ExpressionUUID->"cbde03bd-7e31-b241-b8c5-24a65338ea36"],

Cell["\<\
{Normal @ ArrayMultiply[{a}, \"ii->i\"], Normal @ ArrayMultiply[{a}, \
\"ii->\"]}\
\>", "Input",ExpressionUUID->"5cb8b972-7332-5145-a8d3-f4b38766c2a1"],

