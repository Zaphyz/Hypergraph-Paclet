Cell["\<\
An index may join three arrays at once. This is the Bhattacharya-Mesner \
product of three 3-arrays:\
\>", "ExampleText",ExpressionUUID->"04a81f3a-cbd0-7148-933f-1e8882e7ef5b"],

Cell["\<\
x = Array[#1 + #2 + #3 &, {2, 2, 2}];
Normal @ ArrayMultiply[{x, x, x}, \"ijp,ipk,pjk->ijk\"]\
\>", "Input",ExpressionUUID->"5fe9a25e-13ed-864b-8174-98f553cdf7b5"],

