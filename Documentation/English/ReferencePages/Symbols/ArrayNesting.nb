Notebook[{
Cell["ArrayNesting", "ObjectName",ExpressionUUID->"63fa992d-a788-8743-add7-4e966225afa5"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayNesting", "[", "n", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"f59302b9-1f00-1b47-9f61-a84b8623b12d"],
 " ",
 "gives the way ArrayGraphics splits the indices of an array of order n by \
default: blocks of at most two."
}], "Usage",ExpressionUUID->"dc8bd6d9-b185-bd4b-ad31-9620d198ada6"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayNesting", "[", 
    RowBox[{"n", ",", " ", "b"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"c8935775-3a92-5a44-800f-fd7a28454183"],
 " ",
 "allows blocks of up to b indices."
}], "Usage",ExpressionUUID->"7ad54ed1-dcbe-7340-9dd8-e77ba37e5cf4"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayNesting", "[", "arr", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"cfdc2941-28d7-e147-956c-d63a7b084ba2"],
 " ",
 "gives the splitting for the order of arr."
}], "Usage",ExpressionUUID->"d59924a9-3c13-684b-99d1-cbd2139f089f"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"6dfb57e6-709a-db42-a28b-2bea8f195f88"],

Cell["\<\
The result is a list of block sizes summing to n: the first block is the \
outer picture, and each block after it is drawn inside the cells of the one \
before, or tiled by it.\
\>", "Notes",ExpressionUUID->"d6c388dc-4eaa-d242-b29c-b9c58ac3d27a"],

Cell[TextData[{
 "A flat picture holds one or two indices and a spatial one holds three, so \
the two families differ only in the largest block: ",
 Cell[BoxData[
  StyleBox["ArrayGraphics", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "3458cc1a-145a-b34c-a105-9e74cde57b51"],
 " uses ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayNesting", "[", "n", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"9d1ebaf1-9319-5647-93c9-3c33904a598c"],
 " and ",
 Cell[BoxData[
  StyleBox["ArrayGraphics3D", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "47b8b922-ec14-4d47-92ff-65dd17f71132"],
 " uses ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayNesting", "[", 
    RowBox[{"n", ",", " ", "3"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"1975bd57-5e2e-2e4a-b543-312a2d4fa0cb"],
 "."
}], "Notes",ExpressionUUID->"531014ad-4847-f14f-8342-c60bcd883590"],

Cell["\<\
The blocks are of the largest size allowed, with any remainder taken off the \
front. The remainder goes first so that a 3-array drawn flat comes out as a \
row of matrices, the first index choosing the matrix, which is the familiar \
reading.\
\>", "Notes",ExpressionUUID->"e0dd3fd3-11d3-9048-b9da-469f2213bf8d"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"f41a7c70-11b7-f44d-bfed-db4945f339b9"],

Cell["The flat splitting, in blocks of at most two:", "ExampleText",ExpressionUUID->"be4c9b8f-03a3-9042-91e2-0a79686c6be2"],

Cell["Table[ArrayNesting[n], {n, 0, 8}]", "Input",ExpressionUUID->"9b9a6c3b-bee8-5247-ae9d-59fa11ee173c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", "1", "}"}], ",", 
   RowBox[{"{", "2", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "2", ",", "2", ",", "2"}], "}"}]}], "}"}]], "Output",Exp\
ressionUUID->"4985398a-0c5c-3146-8182-58cdfcacb0b1"],

Cell["The spatial one, in blocks of at most three:", "ExampleText",ExpressionUUID->"99350eaf-0a39-264d-8a6b-905496d7fdfe"],

Cell["Table[ArrayNesting[n, 3], {n, 0, 8}]", "Input",ExpressionUUID->"36d7f4d3-9098-504f-b23b-2da1c8db6168"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", "1", "}"}], ",", 
   RowBox[{"{", "2", "}"}], ",", 
   RowBox[{"{", "3", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "3", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3", ",", "3"}], "}"}]}], "}"}]], "Output",ExpressionUUI\
D->"46714971-f4c6-e644-aa20-0c9b053bb2dc"],

Cell["Taken from an array, it reads the order off it:", "ExampleText",ExpressionUUID->"77c914ed-0f3b-c041-ba4e-15940f391683"],

Cell["\<\
{ArrayNesting @ GenerateSymbolicArray[b, {2, 2, 2, 2}],
 ArrayNesting[GenerateSymbolicArray[b, {2, 2, 2, 2}], 3]}\
\>", "Input",ExpressionUUID->"a7f8ab34-a1bc-864f-86b7-2239ed483db7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "3"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"077a32ce-19d5-464e-918c-d79c037ac384"],

Cell["Source", "NotesSection",ExpressionUUID->"6f992644-5d01-c746-962b-dc2368d9e982"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/ArrayGraphics.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Nesting",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"62a31f7e-bf32-f943-9842-9d1feb08efc0"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"a6cd85f8-2828-4343-9231-8d6cf71638a3"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayGraphics", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "6fd9e4b2-b324-a34b-8cad-f684e15ecd51"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayGraphics3D", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "b8a4765d-d95c-a943-8bcf-af9bae156dad"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayOrder", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "ae5fe12e-695a-b449-87b2-84f88aa9dbea"]
}], "SeeAlso",ExpressionUUID->"244e92f8-8e41-ef4e-8952-a9cc983fae4b"]
},
