Notebook[{
Cell["ArrayNesting", "ObjectName",ExpressionUUID->"9a9c2ff8-dfff-8d49-8f34-fe1e571003d1"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayNesting", "[", "n", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"a12abbfe-d265-c64f-82df-087bb5bac354"],
 " ",
 "gives the way ArrayGraphics splits the indices of an array of order n by \
default: blocks of at most two."
}], "Usage",ExpressionUUID->"9427caeb-c8a0-7544-bbd7-74401f9cbcf6"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayNesting", "[", 
    RowBox[{"n", ",", " ", "b"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"d878c520-d62d-2045-b0ae-e85a70913c4d"],
 " ",
 "allows blocks of up to b indices."
}], "Usage",ExpressionUUID->"f8001167-3d0a-4644-8c97-a6f3bad84ed9"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayNesting", "[", "arr", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"50c999ca-9354-c04f-8328-bfc9ef1cddbd"],
 " ",
 "gives the splitting for the order of arr."
}], "Usage",ExpressionUUID->"38f0093d-6149-b54d-a7cf-4b2c39521fbd"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"7f6208af-d6f2-ad4d-8648-7e629ffdc73c"],

Cell["\<\
The result is a list of block sizes summing to n: the first block is the \
outer picture, and each block after it is drawn inside the cells of the one \
before, or tiled by it.\
\>", "Notes",ExpressionUUID->"380cf6ef-b2e7-ba4f-bcd7-f6900de6a52e"],

Cell[TextData[{
 "A flat picture holds one or two indices and a spatial one holds three, so \
the two families differ only in the largest block: ",
 Cell[BoxData[
  StyleBox["ArrayGraphics", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "422a82c3-919d-5449-b498-f1a62c5d1fbd"],
 " uses ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayNesting", "[", "n", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"ee5b01e0-f999-9841-bac8-e6c1c49acbb8"],
 " and ",
 Cell[BoxData[
  StyleBox["ArrayGraphics3D", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "35c383f3-d860-8540-8a8b-d1c70e0e9ff8"],
 " uses ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayNesting", "[", 
    RowBox[{"n", ",", " ", "3"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"fd51fd90-5201-ce45-9e6d-98d7ff1445ae"],
 "."
}], "Notes",ExpressionUUID->"3a074f74-c291-a647-80c3-63dafb73c537"],

Cell["\<\
The blocks are of the largest size allowed, with any remainder taken off the \
front. The remainder goes first so that a 3-array drawn flat comes out as a \
row of matrices, the first index choosing the matrix, which is the familiar \
reading.\
\>", "Notes",ExpressionUUID->"6e98f4d7-5959-7f4a-821e-36bc603d78b4"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"36e1a35b-6ddb-6949-8994-2b2e3cbe5959"],

Cell["The flat splitting, in blocks of at most two:", "ExampleText",ExpressionUUID->"17446702-4da3-e949-ac59-881f62c034f6"],

Cell["Table[ArrayNesting[n], {n, 0, 8}]", "Input",ExpressionUUID->"424c565a-aa33-e040-8a37-624de8190706"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", "1", "}"}], ",", 
   RowBox[{"{", "2", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "2", ",", "2", ",", "2"}], "}"}]}], "}"}]], "Output",Exp\
ressionUUID->"be7442c0-4477-b144-b33b-a9148bd4922b"],

Cell["The spatial one, in blocks of at most three:", "ExampleText",ExpressionUUID->"14d7bd8b-e436-774e-8106-c4601e79cadf"],

Cell["Table[ArrayNesting[n, 3], {n, 0, 8}]", "Input",ExpressionUUID->"c845466a-d562-b340-8e24-414c3706ecc2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", "1", "}"}], ",", 
   RowBox[{"{", "2", "}"}], ",", 
   RowBox[{"{", "3", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "3", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3", ",", "3"}], "}"}]}], "}"}]], "Output",ExpressionUUI\
D->"3306ec6d-4546-9f43-8cfc-ccb7a975d932"],

Cell["Taken from an array, it reads the order off it:", "ExampleText",ExpressionUUID->"8da67732-ef0d-1449-afe2-f9bd9c9ac751"],

Cell["\<\
{ArrayNesting @ GenerateSymbolicArray[b, {2, 2, 2, 2}],
 ArrayNesting[GenerateSymbolicArray[b, {2, 2, 2, 2}], 3]}\
\>", "Input",ExpressionUUID->"608d209e-0edc-814c-a5fe-9ba3f2a68710"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "3"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"cad627d0-c33a-be4b-a609-f823f1fdb733"],

Cell["Source", "NotesSection",ExpressionUUID->"7b4e2b84-5232-9649-8351-d4a7e79207ea"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/ArrayGraphics.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Nesting",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"14526016-17c4-c44b-a989-8b46cde13cb8"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"6e651e77-6bd8-984f-874b-03bf4de088bd"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayGraphics", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "7a49d5d0-2c85-b34f-b478-4e2b01908acd"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayGraphics3D", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "e330e658-0738-af40-bdb5-239a4965b924"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayOrder", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "9809cee9-0e1d-1142-a1d0-43f7237c0e4f"]
}], "SeeAlso",ExpressionUUID->"92b4d51c-ec49-ab4b-af16-4f4a6efcfb6e"]
},
