Notebook[{
Cell["ArrayNesting", "ObjectName",ExpressionUUID->"5cb62992-1393-9440-b015-a72cdac8018f"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayNesting", "[", "n", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"cb772533-dfe4-d749-a8cb-749e635bfa85"],
 " ",
 "gives the way ArrayGraphics splits the indices of an array of order n by \
default: blocks of at most two."
}], "Usage",ExpressionUUID->"9313477e-7644-3a4b-8323-4ad7d8cdfbee"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayNesting", "[", 
    RowBox[{"n", ",", " ", "b"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"e963c3f2-2ecd-634c-a495-c8609806750e"],
 " ",
 "allows blocks of up to b indices."
}], "Usage",ExpressionUUID->"48399a08-7b99-0347-a170-85cc6fb2e547"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayNesting", "[", "arr", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"667567d0-92fb-244f-a9fe-9c6e29812012"],
 " ",
 "gives the splitting for the order of arr."
}], "Usage",ExpressionUUID->"d82b4d6d-a31c-8440-a5a3-a642c42e6fbd"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"9a91e44e-340d-284f-8a3b-b9f46496c36f"],

Cell["\<\
The result is a list of block sizes summing to n: the first block is the \
outer picture, and each block after it is drawn inside the cells of the one \
before, or tiled by it.\
\>", "Notes",ExpressionUUID->"5127bb57-5b3e-a145-9c1a-255c29cb4375"],

Cell[TextData[{
 "A flat picture holds one or two indices and a spatial one holds three, so \
the two families differ only in the largest block: ",
 Cell[BoxData[
  StyleBox["ArrayGraphics", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "cf04973d-f4e4-0c4e-8e39-0c6bae245b3a"],
 " uses ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayNesting", "[", "n", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"a256bb82-7f45-1b43-b8d3-c8eafc321890"],
 " and ",
 Cell[BoxData[
  StyleBox["ArrayGraphics3D", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "9d7e41ad-bab7-294d-8ff4-4a7664fa72ad"],
 " uses ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayNesting", "[", 
    RowBox[{"n", ",", " ", "3"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"da8612ef-af50-934a-8f85-4ab999b63b75"],
 "."
}], "Notes",ExpressionUUID->"cde70504-c7f8-a241-93d0-1e5dc63aa372"],

Cell["\<\
The blocks are of the largest size allowed, with any remainder taken off the \
front. The remainder goes first so that a 3-array drawn flat comes out as a \
row of matrices, the first index choosing the matrix, which is the familiar \
reading.\
\>", "Notes",ExpressionUUID->"efa31a04-e6b1-d441-909e-206341132175"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"5333b972-b5fe-0a48-88db-d7e6af3b75df"],

Cell["The flat splitting, in blocks of at most two:", "ExampleText",ExpressionUUID->"03308cae-2b09-a042-85ae-359cc4008764"],

Cell["Table[ArrayNesting[n], {n, 0, 8}]", "Input",ExpressionUUID->"d3e991f3-2c29-2f47-a647-c0be97d05580"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", "1", "}"}], ",", 
   RowBox[{"{", "2", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "2", ",", "2", ",", "2"}], "}"}]}], "}"}]], "Output",Exp\
ressionUUID->"66684b6b-6d80-eb4c-aaa3-a27e4e8d6f64"],

Cell["The spatial one, in blocks of at most three:", "ExampleText",ExpressionUUID->"7f90b9bf-5bea-5047-806a-6d0842985dbc"],

Cell["Table[ArrayNesting[n, 3], {n, 0, 8}]", "Input",ExpressionUUID->"55a833fe-b868-1842-871d-a17831ae486e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", "1", "}"}], ",", 
   RowBox[{"{", "2", "}"}], ",", 
   RowBox[{"{", "3", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "3", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3", ",", "3"}], "}"}]}], "}"}]], "Output",ExpressionUUI\
D->"1e276dbe-0c16-fc49-a1cd-a9920057656e"],

Cell["Taken from an array, it reads the order off it:", "ExampleText",ExpressionUUID->"e22b8d82-bb54-e044-955e-b6ae2370a433"],

Cell["\<\
{ArrayNesting @ GenerateSymbolicArray[b, {2, 2, 2, 2}],
 ArrayNesting[GenerateSymbolicArray[b, {2, 2, 2, 2}], 3]}\
\>", "Input",ExpressionUUID->"db115a59-b6b1-cc41-9679-3f101328e2a0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "3"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"ef93e40e-13a9-bf4c-b559-c42a799b421c"],

Cell["Source", "NotesSection",ExpressionUUID->"605104cc-5394-f641-aa2b-bccadaee4bf1"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/ArrayGraphics.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Nesting",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"89689445-c78d-cc45-8d51-e999bf23a9be"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"db8b38b9-9d6a-c945-90fb-72893f6994ab"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayGraphics", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "01984dde-f965-0d4d-a05a-8af895688805"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayGraphics3D", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "53b1e7b8-268f-8b4f-8891-73106a32b80d"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayOrder", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "7f690d16-29d3-944d-b26a-0c9fe42026ce"]
}], "SeeAlso",ExpressionUUID->"50653240-c11b-f94a-9b3d-c1e9c31520f4"]
},
