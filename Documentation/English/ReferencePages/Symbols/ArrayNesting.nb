Notebook[{
Cell["ArrayNesting", "ObjectName",ExpressionUUID->"fac3fe36-d87a-0544-857a-c7376c2f7556"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayNesting", "[", "n", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"e7e0f97e-fd36-534b-a93a-3b18a71ae24a"],
 " ",
 "gives the way ArrayGraphics splits the indices of an array of order n by \
default: blocks of at most two."
}], "Usage",ExpressionUUID->"d61428f5-1ea3-ae41-b806-37c3a6e7e9f6"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayNesting", "[", 
    RowBox[{"n", ",", " ", "b"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"ee3e80af-394b-a34d-8571-2f2a0a074fbf"],
 " ",
 "allows blocks of up to b indices."
}], "Usage",ExpressionUUID->"af9d05c8-7cba-264a-ab6c-e762d4f2ded0"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayNesting", "[", "arr", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"bdd10329-6697-8041-978c-c3a9c0cbee58"],
 " ",
 "gives the splitting for the order of arr."
}], "Usage",ExpressionUUID->"27530cc3-cb3d-d64a-9b57-73a1a4daba9e"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"bea95547-c91f-bb4a-939c-e096af943b95"],

Cell["\<\
The result is a list of block sizes summing to n: the first block is the \
outer picture, and each block after it is drawn inside the cells of the one \
before, or tiled by it.\
\>", "Notes",ExpressionUUID->"94b2ba52-b620-3446-8164-b0f1d44da849"],

Cell[TextData[{
 "A flat picture holds one or two indices and a spatial one holds three, so \
the two families differ only in the largest block: ",
 Cell[BoxData[
  StyleBox["ArrayGraphics", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "1d71cfe4-9052-7b41-ad67-21e642cc70c8"],
 " uses ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayNesting", "[", "n", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"fc1afafc-9b1e-9b47-8c01-c809c27a1d50"],
 " and ",
 Cell[BoxData[
  StyleBox["ArrayGraphics3D", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "33b1921a-7ae8-c948-bb54-b655c3fbba64"],
 " uses ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayNesting", "[", 
    RowBox[{"n", ",", " ", "3"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"e402af94-52cd-224c-ae9c-10269743c50c"],
 "."
}], "Notes",ExpressionUUID->"0c3b59f0-31f7-5a4e-9d5f-a28401500a75"],

Cell["\<\
The blocks are of the largest size allowed, with any remainder taken off the \
front. The remainder goes first so that a 3-array drawn flat comes out as a \
row of matrices, the first index choosing the matrix, which is the familiar \
reading.\
\>", "Notes",ExpressionUUID->"abc82ec4-b36c-9440-b0d2-971aed4f2153"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"110dc5ff-162f-2045-a01e-b1c073bc42f2"],

Cell["The flat splitting, in blocks of at most two:", "ExampleText",ExpressionUUID->"0d391805-6ab1-6942-ac5e-2624c3313779"],

Cell["Table[ArrayNesting[n], {n, 0, 8}]", "Input",ExpressionUUID->"acf6137f-5a8d-2448-b7f3-1a2f554da3db"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", "1", "}"}], ",", 
   RowBox[{"{", "2", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "2", ",", "2", ",", "2"}], "}"}]}], "}"}]], "Output",Exp\
ressionUUID->"27de0151-769a-b44d-9a41-f9456d7b04ae"],

Cell["The spatial one, in blocks of at most three:", "ExampleText",ExpressionUUID->"1dee3739-da26-714d-a99d-200367a26e36"],

Cell["Table[ArrayNesting[n, 3], {n, 0, 8}]", "Input",ExpressionUUID->"7e0420cd-5c36-bf43-9bd4-7b03c84980c7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", "1", "}"}], ",", 
   RowBox[{"{", "2", "}"}], ",", 
   RowBox[{"{", "3", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "3", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3", ",", "3"}], "}"}]}], "}"}]], "Output",ExpressionUUI\
D->"57833ba0-3e0b-4a4e-989c-354a46774b73"],

Cell["Taken from an array, it reads the order off it:", "ExampleText",ExpressionUUID->"9c2457cc-2e06-bf48-a2f3-fc9b9f753007"],

Cell["\<\
{ArrayNesting @ GenerateSymbolicArray[b, {2, 2, 2, 2}],
 ArrayNesting[GenerateSymbolicArray[b, {2, 2, 2, 2}], 3]}\
\>", "Input",ExpressionUUID->"69b1c01a-704e-ee47-b1b6-b892b02c8104"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "3"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"4460906d-b5ce-884b-a075-60975dacae43"],

Cell["Source", "NotesSection",ExpressionUUID->"8f54af8b-2b56-f049-951a-c077d1be1a82"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/ArrayGraphics.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Nesting",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"48ce455f-5811-8941-9773-7545818c17ad"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"636e6c5d-25d1-fd47-b0a6-88646aa42b2c"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayGraphics", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "ecdcb89e-1675-be4e-a208-3696818d39c0"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayGraphics3D", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "88065691-0f5a-a646-a898-a6414feb969b"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayOrder", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "6e0d7dfe-a0e1-674c-b177-fcf4edb19839"]
}], "SeeAlso",ExpressionUUID->"16db92c2-2b61-c24f-a840-56b6842b1ee7"]
},
