Notebook[{
Cell["ArrayNesting", "ObjectName",ExpressionUUID->"c8971fa0-bb3d-b04a-a315-3d30fae8846c"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayNesting", "[", "n", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"bd162b0f-13fa-7349-b4e5-5cf25e966113"],
 " ",
 "gives the way ArrayGraphics splits the indices of an array of order n by \
default: blocks of at most two."
}], "Usage",ExpressionUUID->"049cd5c6-1caf-214c-9e54-12fc231f0459"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayNesting", "[", 
    RowBox[{"n", ",", " ", "b"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"86bea47c-1bf0-ad4c-9c88-eebb2f4fdc6a"],
 " ",
 "allows blocks of up to b indices."
}], "Usage",ExpressionUUID->"6b34c238-3013-5046-b9e1-34e07cb46281"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayNesting", "[", "arr", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"24c254c9-56a4-eb44-80fa-e7abb605fcdc"],
 " ",
 "gives the splitting for the order of arr."
}], "Usage",ExpressionUUID->"f6e000a7-9928-a148-9181-0b23e7b7e9fa"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"15513a72-d256-3246-925b-96b01ce87ecb"],

Cell["\<\
The result is a list of block sizes summing to n: the first block is the \
outer picture, and each block after it is drawn inside the cells of the one \
before, or tiled by it.\
\>", "Notes",ExpressionUUID->"68e49237-b27a-e448-89ec-0dffb6981a05"],

Cell[TextData[{
 "A flat picture holds one or two indices and a spatial one holds three, so \
the two families differ only in the largest block: ",
 Cell[BoxData[
  StyleBox["ArrayGraphics", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "380eb81c-6943-6a43-bbd7-8e8036a35ca7"],
 " uses ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayNesting", "[", "n", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"8c884e74-4849-f34f-bf25-df83f1eab032"],
 " and ",
 Cell[BoxData[
  StyleBox["ArrayGraphics3D", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "a44437cc-d98d-0443-81be-f869aa56a7e0"],
 " uses ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayNesting", "[", 
    RowBox[{"n", ",", " ", "3"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"d8e090ed-85fd-1e4c-81f0-0e881fedc7f4"],
 "."
}], "Notes",ExpressionUUID->"fa495b45-8f39-d644-9e45-4896842a364c"],

Cell["\<\
The blocks are of the largest size allowed, with any remainder taken off the \
front. The remainder goes first so that a 3-array drawn flat comes out as a \
row of matrices, the first index choosing the matrix, which is the familiar \
reading.\
\>", "Notes",ExpressionUUID->"4d0dd7fe-dbd3-df44-8a8f-ca9ca280a3a1"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"bd476954-0176-e940-a252-329853d9b931"],

Cell["The flat splitting, in blocks of at most two:", "ExampleText",ExpressionUUID->"4352bae2-2f10-9440-b962-ba66dd804bf4"],

Cell["Table[ArrayNesting[n], {n, 0, 8}]", "Input",ExpressionUUID->"4cc40b20-0fe2-f445-9575-10f7a1acfa2f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", "1", "}"}], ",", 
   RowBox[{"{", "2", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "2", ",", "2", ",", "2"}], "}"}]}], "}"}]], "Output",Exp\
ressionUUID->"8a2403f2-146f-8b4e-9309-2f954feb1ff7"],

Cell["The spatial one, in blocks of at most three:", "ExampleText",ExpressionUUID->"fe0b508c-5acd-9e4d-91bf-43a64f7d4709"],

Cell["Table[ArrayNesting[n, 3], {n, 0, 8}]", "Input",ExpressionUUID->"7cac74b8-14e7-f14a-b65d-342867408a16"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", "1", "}"}], ",", 
   RowBox[{"{", "2", "}"}], ",", 
   RowBox[{"{", "3", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "3", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3", ",", "3"}], "}"}]}], "}"}]], "Output",ExpressionUUI\
D->"fbb5812a-e1b0-c346-afbc-8d4c6f3ee058"],

Cell["Taken from an array, it reads the order off it:", "ExampleText",ExpressionUUID->"aa987b65-6ada-e64d-b5a3-0318a0b5b96e"],

Cell["\<\
{ArrayNesting @ GenerateSymbolicArray[b, {2, 2, 2, 2}],
 ArrayNesting[GenerateSymbolicArray[b, {2, 2, 2, 2}], 3]}\
\>", "Input",ExpressionUUID->"809a5032-a8f4-5341-8835-298e36e5bc87"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "3"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"494fd96d-2321-e043-982d-40a1e02d3f48"],

Cell["Source", "NotesSection",ExpressionUUID->"f24718e6-dd21-ff47-83d2-101617acb580"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/ArrayGraphics.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Nesting",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"4407f4cc-613f-b54f-a035-93343c195ffd"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"713a0e8f-7a0d-0144-90ac-3d44566ffd90"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayGraphics", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "ee2b921b-7c4c-b640-a62b-928ec00b96bf"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayGraphics3D", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "9d4a6963-be7d-a948-8db3-393f68e3c145"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayOrder", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "a8d88b6e-cdd9-f348-a89e-2855a67c510f"]
}], "SeeAlso",ExpressionUUID->"da05bb56-5b2d-9343-92b8-686a7efdbc8a"]
},
