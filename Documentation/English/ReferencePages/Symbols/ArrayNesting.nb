Notebook[{
Cell["ArrayNesting", "ObjectName",ExpressionUUID->"4055607f-8b03-2343-969c-34cc58a77639"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayNesting", "[", "n", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"5853165c-26c3-0848-a813-863130c453f3"],
 " ",
 "gives the way ArrayGraphics splits the indices of an array of order n by \
default: blocks of at most two."
}], "Usage",ExpressionUUID->"c513b60d-7dbd-3442-acbe-7e447987df9f"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayNesting", "[", 
    RowBox[{"n", ",", " ", "b"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"d6861342-df65-6349-a70d-63d4fc54a609"],
 " ",
 "allows blocks of up to b indices."
}], "Usage",ExpressionUUID->"e061620a-b4d8-cf45-b091-aa528c66e9ec"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayNesting", "[", "arr", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"672c3b51-0607-084c-b782-e979a88f9238"],
 " ",
 "gives the splitting for the order of arr."
}], "Usage",ExpressionUUID->"cb454b6d-a45e-a542-a6ef-b1cb7c6879cd"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"51698373-1dbb-9c44-8f4c-5c7e25587b75"],

Cell["\<\
The result is a list of block sizes summing to n: the first block is the \
outer picture, and each block after it is drawn inside the cells of the one \
before, or tiled by it.\
\>", "Notes",ExpressionUUID->"e8c2189f-8d62-774d-b7a5-7802f48e9dad"],

Cell[TextData[{
 "A flat picture holds one or two indices and a spatial one holds three, so \
the two families differ only in the largest block: ",
 Cell[BoxData[
  StyleBox["ArrayGraphics", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "ae39a799-22fb-754c-9453-4752d47aa78b"],
 " uses ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayNesting", "[", "n", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"eeb72174-7d9d-6e40-92bd-457e38d9495e"],
 " and ",
 Cell[BoxData[
  StyleBox["ArrayGraphics3D", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "5bebde3c-ba79-2b47-a109-e1a5dcacf2ec"],
 " uses ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayNesting", "[", 
    RowBox[{"n", ",", " ", "3"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"52b48cd0-ba04-5f43-967b-04977b4a05d6"],
 "."
}], "Notes",ExpressionUUID->"e601af5e-328d-8043-94c2-a8d8eb9913fd"],

Cell["\<\
The blocks are of the largest size allowed, with any remainder taken off the \
front. The remainder goes first so that a 3-array drawn flat comes out as a \
row of matrices, the first index choosing the matrix, which is the familiar \
reading.\
\>", "Notes",ExpressionUUID->"362557b7-9171-014d-acd8-7de64fbfd547"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"442884a4-9d28-8047-8834-ad7b9d6b5833"],

Cell["The flat splitting, in blocks of at most two:", "ExampleText",ExpressionUUID->"a0f69ae0-d20a-374f-a742-3229d144346a"],

Cell["Table[ArrayNesting[n], {n, 0, 8}]", "Input",ExpressionUUID->"55f38270-b313-2245-8f08-d5f89a6b42d5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", "1", "}"}], ",", 
   RowBox[{"{", "2", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "2", ",", "2", ",", "2"}], "}"}]}], "}"}]], "Output",Exp\
ressionUUID->"0d93a42b-324a-e643-863f-2c5162fb0c10"],

Cell["The spatial one, in blocks of at most three:", "ExampleText",ExpressionUUID->"4956a441-e0d7-d943-8065-dedef2cf3fee"],

Cell["Table[ArrayNesting[n, 3], {n, 0, 8}]", "Input",ExpressionUUID->"b1bd9a4a-25f7-af40-95f8-f4c1aaa516df"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", "1", "}"}], ",", 
   RowBox[{"{", "2", "}"}], ",", 
   RowBox[{"{", "3", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "3", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3", ",", "3"}], "}"}]}], "}"}]], "Output",ExpressionUUI\
D->"dfc9563f-d559-544e-81c6-d6874d475de6"],

Cell["Taken from an array, it reads the order off it:", "ExampleText",ExpressionUUID->"26681065-d228-e04c-822c-3d7d4173dd84"],

Cell["\<\
{ArrayNesting @ GenerateSymbolicArray[b, {2, 2, 2, 2}],
 ArrayNesting[GenerateSymbolicArray[b, {2, 2, 2, 2}], 3]}\
\>", "Input",ExpressionUUID->"a9bc602a-0ada-2f4a-a505-8624a6fc9956"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "3"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"37bff6c8-e2da-4143-ab32-cfbd0fb75aff"],

Cell["Source", "NotesSection",ExpressionUUID->"40505bb8-e7dc-974a-b03d-d2a0872655cc"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/ArrayGraphics.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Nesting",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"b3f45d5b-b873-b246-b254-1faca0c0a25d"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"414f0f91-841d-854c-b244-feeaa2833821"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayGraphics", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "ade59fe0-1f2c-b649-bef3-faa35f6f2ff6"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayGraphics3D", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "e58380ea-fb70-6e4b-a69b-22fb274bb44d"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayOrder", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "45dbad4c-a6a5-eb45-9b7c-05349ae241ce"]
}], "SeeAlso",ExpressionUUID->"8f6a1c97-d1e0-ac41-9f90-4665851a3afe"]
},
