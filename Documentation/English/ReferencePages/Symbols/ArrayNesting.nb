Notebook[{
Cell["ArrayNesting", "ObjectName",ExpressionUUID->"dfa4e84a-c8d2-014e-86d2-11be3b243301"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayNesting", "[", "n", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"98dfed2c-5928-b249-a845-6bd550a78ab0"],
 " ",
 "gives the way ArrayGraphics splits the indices of an array of order n by \
default: blocks of at most two."
}], "Usage",ExpressionUUID->"4aa283dd-cbd3-f748-923b-507760838511"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayNesting", "[", 
    RowBox[{"n", ",", " ", "b"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"2543847d-e88c-d44b-9972-302959a6d52e"],
 " ",
 "allows blocks of up to b indices."
}], "Usage",ExpressionUUID->"a3bed152-c58b-4c45-b42f-7f5f90f5f530"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayNesting", "[", "arr", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"d371ab8d-48a6-bd49-af1b-2c4c8b387d8b"],
 " ",
 "gives the splitting for the order of arr."
}], "Usage",ExpressionUUID->"d5b3c499-11e8-4844-b9c2-78761327299f"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"f36f61c2-f013-2047-91c5-4127a35ac9a5"],

Cell["\<\
The result is a list of block sizes summing to n: the first block is the \
outer picture, and each block after it is drawn inside the cells of the one \
before, or tiled by it.\
\>", "Notes",ExpressionUUID->"4ad56d69-6018-354a-a8e8-c19aaa770887"],

Cell[TextData[{
 "A flat picture holds one or two indices and a spatial one holds three, so \
the two families differ only in the largest block: ",
 Cell[BoxData[
  StyleBox["ArrayGraphics", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "02131544-75fb-8c49-8489-d3e42a1870c1"],
 " uses ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayNesting", "[", "n", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"86c5eab2-b16a-d649-a78c-34433aee8f2e"],
 " and ",
 Cell[BoxData[
  StyleBox["ArrayGraphics3D", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "8f58dfa9-f917-5546-9b90-6157ea1d755a"],
 " uses ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayNesting", "[", 
    RowBox[{"n", ",", " ", "3"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"a44921ad-7e78-7b46-bc26-da46313fdb16"],
 "."
}], "Notes",ExpressionUUID->"2c8a307b-2dba-874e-b489-6c15c588c99f"],

Cell["\<\
The blocks are of the largest size allowed, with any remainder taken off the \
front. The remainder goes first so that a 3-array drawn flat comes out as a \
row of matrices, the first index choosing the matrix, which is the familiar \
reading.\
\>", "Notes",ExpressionUUID->"fd44c7d7-ead6-a140-a3c6-1f8a954dc110"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"7bbeec37-3307-bc4c-8239-50c3becb611e"],

Cell["The flat splitting, in blocks of at most two:", "ExampleText",ExpressionUUID->"9e2b0103-fb5e-f349-9f9f-25d45aec11eb"],

Cell["Table[ArrayNesting[n], {n, 0, 8}]", "Input",ExpressionUUID->"1044521b-818b-874e-b8af-4ea01ea4d354"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", "1", "}"}], ",", 
   RowBox[{"{", "2", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "2", ",", "2", ",", "2"}], "}"}]}], "}"}]], "Output",Exp\
ressionUUID->"b1cca49a-7198-7e4d-9dd0-24fc682ad456"],

Cell["The spatial one, in blocks of at most three:", "ExampleText",ExpressionUUID->"25c78dfd-40b8-d348-854a-23d5afa5d43c"],

Cell["Table[ArrayNesting[n, 3], {n, 0, 8}]", "Input",ExpressionUUID->"9c9c24f0-d31b-1d4f-b467-0f7852753101"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", "1", "}"}], ",", 
   RowBox[{"{", "2", "}"}], ",", 
   RowBox[{"{", "3", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "3", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3", ",", "3"}], "}"}]}], "}"}]], "Output",ExpressionUUI\
D->"f54665b6-98ab-9d4a-82bc-fde5856fee86"],

Cell["Taken from an array, it reads the order off it:", "ExampleText",ExpressionUUID->"2104459e-f625-7c4c-9098-16d9ac24fac8"],

Cell["\<\
{ArrayNesting @ GenerateSymbolicArray[b, {2, 2, 2, 2}],
 ArrayNesting[GenerateSymbolicArray[b, {2, 2, 2, 2}], 3]}\
\>", "Input",ExpressionUUID->"2237a03c-89be-e54c-b176-90566b313d38"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "3"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"0011bac6-0cb2-1942-bf87-b92397c1f96f"],

Cell["Source", "NotesSection",ExpressionUUID->"ad8e01c0-f40c-4d4e-bc48-936c18f5565a"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/ArrayGraphics.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Nesting",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"c0dd068c-204d-224d-8acd-b71f49db7163"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"7d40cced-bf12-f247-8ee9-7077f61502bd"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayGraphics", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "8487c423-f7ee-2547-827c-3a3d1fd47aec"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayGraphics3D", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "05ce1929-46b3-0c4f-9730-b5fc4c7007fa"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayOrder", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "07a7179c-1a17-c949-adcd-480c5a2aa355"]
}], "SeeAlso",ExpressionUUID->"54e3f28c-e78c-4f41-9fb3-e4998fa0f70c"]
},
