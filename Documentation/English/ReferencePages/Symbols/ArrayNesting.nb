Notebook[{
Cell["ArrayNesting", "ObjectName",ExpressionUUID->"19c9cb42-2c50-7a49-95c5-a3b9fa325e3a"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayNesting", "[", "n", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"c8e242c9-4a5f-e244-b960-7b559f0611ba"],
 " ",
 "gives the way ArrayGraphics splits the indices of an array of order n by \
default: blocks of at most two."
}], "Usage",ExpressionUUID->"e52f9070-37d0-8d4d-960b-5fa37f6b5435"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayNesting", "[", 
    RowBox[{"n", ",", " ", "b"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"34c6b0e0-42e3-a349-bd03-2ac6fb09a025"],
 " ",
 "allows blocks of up to b indices."
}], "Usage",ExpressionUUID->"3448023d-8aec-bf47-a9cd-194734e2ef31"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayNesting", "[", "arr", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"ab6f979b-c148-b14d-9ca5-3b05cfaea315"],
 " ",
 "gives the splitting for the order of arr."
}], "Usage",ExpressionUUID->"3e56fd6d-4e6d-1443-8b5b-a331b14738d6"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"8eeb432f-e6c3-754e-b2e3-15b99001f3f4"],

Cell["\<\
The result is a list of block sizes summing to n: the first block is the \
outer picture, and each block after it is drawn inside the cells of the one \
before, or tiled by it.\
\>", "Notes",ExpressionUUID->"982afb1f-4ece-cb43-81b5-7a3ceb7c7f83"],

Cell[TextData[{
 "A flat picture holds one or two indices and a spatial one holds three, so \
the two families differ only in the largest block: ",
 Cell[BoxData[
  StyleBox["ArrayGraphics", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "c60a00ad-6127-084d-831b-42f2f17c6cd9"],
 " uses ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayNesting", "[", "n", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"97bb0da5-6edc-4943-b0a4-9195f64c5c32"],
 " and ",
 Cell[BoxData[
  StyleBox["ArrayGraphics3D", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "2c7d8db2-b722-cd47-b588-bf38a99d67fc"],
 " uses ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayNesting", "[", 
    RowBox[{"n", ",", " ", "3"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"262be289-a326-be40-8d23-42c8506d5562"],
 "."
}], "Notes",ExpressionUUID->"0bb1c931-4bf6-4349-86ab-826298b7093e"],

Cell["\<\
The blocks are of the largest size allowed, with any remainder taken off the \
front. The remainder goes first so that a 3-array drawn flat comes out as a \
row of matrices, the first index choosing the matrix, which is the familiar \
reading.\
\>", "Notes",ExpressionUUID->"ad36bd6a-0349-ae42-b746-a7b166c836ed"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"c1ac33f4-1034-6f4c-8c2c-db079c40ea42"],

Cell["The flat splitting, in blocks of at most two:", "ExampleText",ExpressionUUID->"f6372821-2481-3343-b7d6-9b1d4b7e35a2"],

Cell["Table[ArrayNesting[n], {n, 0, 8}]", "Input",ExpressionUUID->"9dfdd1d6-c860-604d-b56f-88ede8c6ccee"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", "1", "}"}], ",", 
   RowBox[{"{", "2", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "2", ",", "2", ",", "2"}], "}"}]}], "}"}]], "Output",Exp\
ressionUUID->"216d5930-3316-e543-8d11-831764e165f8"],

Cell["The spatial one, in blocks of at most three:", "ExampleText",ExpressionUUID->"5f661cd7-c0a7-c248-bd29-fda04a2af12c"],

Cell["Table[ArrayNesting[n, 3], {n, 0, 8}]", "Input",ExpressionUUID->"ff308c1e-63c1-cf43-a528-39559e3ede4d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", "1", "}"}], ",", 
   RowBox[{"{", "2", "}"}], ",", 
   RowBox[{"{", "3", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "3", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3", ",", "3"}], "}"}]}], "}"}]], "Output",ExpressionUUI\
D->"7aa77a3e-099d-264a-8dcd-69daefc88dfe"],

Cell["Taken from an array, it reads the order off it:", "ExampleText",ExpressionUUID->"cdd673d6-6760-e247-833c-8473da3a287b"],

Cell["\<\
{ArrayNesting @ GenerateSymbolicArray[b, {2, 2, 2, 2}],
 ArrayNesting[GenerateSymbolicArray[b, {2, 2, 2, 2}], 3]}\
\>", "Input",ExpressionUUID->"01bbb75b-54cb-8245-bc52-253eac13cbc2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "3"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"5932998e-a170-624d-8277-0c5b7b89ec26"],

Cell["Source", "NotesSection",ExpressionUUID->"e3ffe854-4715-d840-8b8c-0c771f7ffde2"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/ArrayGraphics.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Nesting",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"39695981-81a5-4749-8e01-b26352d07d3d"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"d7a9a69c-7def-874f-8763-29d5081c32c7"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayGraphics", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "71381c75-4f01-f347-a652-28d6a810ac0b"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayGraphics3D", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "479659a4-58f1-1e44-bb4f-2d44916c301c"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayOrder", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "dfc46898-a80e-9149-8673-b72367748f22"]
}], "SeeAlso",ExpressionUUID->"67097ccb-269d-4542-b085-20a65d1b244f"]
},
