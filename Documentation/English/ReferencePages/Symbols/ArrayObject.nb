Cell["\<\
Entries that answer to none of them are simply expressions, and make a \
perfectly good array:\
\>", "ExampleText",ExpressionUUID->"0d76640b-9438-7f41-a22c-2380c2cc382c"],

Cell["\<\
{ArrayDomain @ ArrayObject[{\"a\", \"b\"}], ArrayDomain @ ArrayObject[{x, \
y}],
 ArrayDomain @ ArrayObject[{1, \"a\"}]}\
\>", "Input",ExpressionUUID->"b272340a-7132-c948-9d3b-6d4467ae0cf8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Expression\"\>", ",", "\<\"Expression\"\>", 
   ",", "\<\"Expression\"\>"}], "}"}]], "Output",ExpressionUUID->"20356b93-\
6cb5-364e-a577-b39b953e4ea8"],

Cell["\<\
A declared symmetry is verified. These entries are symmetric:\
\>", "ExampleText",ExpressionUUID->"029b6209-0996-7247-8781-8d699b846de2"],

Cell["ArraySymmetry @ ArrayObject[{{1, 2}, {2, 1}}, \"Symmetric\"]", "Input",ExpressionUUID->"9e6c9a40-4003-2640-8a21-a4bbde4b4666"],

Cell[BoxData["\<\"Symmetric\"\>"], "Output",ExpressionUUID->"bd303fca-dad2-7e4e-9ae1-3b6757dea598"],

Cell["\[Ellipsis] and these are not, so the declaration is refused:", \
"ExampleText",ExpressionUUID->"4f89a08e-691b-bd42-9e20-588d0b4ab66c"],

Cell["Quiet @ ArrayObject[{{1, 2}, {3, 4}}, \"Symmetric\"]", "Input",ExpressionUUID->"cf5c1902-97c1-9a47-ae7c-adb05c99b55b"],

Cell[BoxData["$Failed"], "Output",ExpressionUUID->"c64215df-4d81-1c42-ba48-862d3f5246ec"],

Cell["The same entries are perfectly good as a rigid array:", "ExampleText",ExpressionUUID->"6ad56903-34d4-8041-8779-3feccd3a9d23"],

Cell["ArraySymmetry @ ArrayObject[{{1, 2}, {3, 4}}]", "Input",ExpressionUUID->"4216832e-221d-0041-ab10-0f881352aab6"],

Cell[BoxData["\<\"Rigid\"\>"], "Output",ExpressionUUID->"24b206af-1262-504f-8908-df5eb27db069"],

Cell["\<\
A scalar is the array of order zero, with no dimensions and one entry:\
\>", "ExampleText",ExpressionUUID->"ec52e7a9-3305-8a4d-86d2-405fc3462500"],

Cell["\<\
{ArrayOrder @ ArrayObject[5], ArrayDimensions @ ArrayObject[5],
 Normal @ ArrayObject[5]}\
\>", "Input",ExpressionUUID->"668e9b0f-8f63-204e-b188-bdc5aac03b26"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", 
   RowBox[{"{", "}"}], ",", "5"}], "}"}]], "Output",ExpressionUUID->"a6fb2d88-\
316e-7640-a7bb-02d8ff3dc66b"],

