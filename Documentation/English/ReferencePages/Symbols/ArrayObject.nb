Cell["\<\
The domain is read off the entries, and it is the narrowest that contains \
them all:\
\>", "ExampleText",ExpressionUUID->"cd5982ce-8a70-5049-9318-80564aa35589"],

Cell["\<\
ArrayDomain @ ArrayObject[#] & /@ {{True, False}, {1, 2}, {1/2, 3}, {1.5, 2}, \
{1 + I, 2}}\
\>", "Input",ExpressionUUID->"4eddd56f-1fb8-1249-8c3f-501982ff9785"],

