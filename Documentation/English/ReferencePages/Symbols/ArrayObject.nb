UID->"41589f8d-9e95-d743-b9b9-bf4df38b1b90"],

Cell["Entries of a finite field are recognized too:", "ExampleText",ExpressionUUID->"804d7b62-b1b0-0e41-ba23-f42d885b3bf0"],

Cell["\<\
ArrayDomain @ ArrayObject[{FiniteField[2, 1][0], FiniteField[2, 1][1]}]\
\>", "Input",ExpressionUUID->"33d8093c-3b05-7f48-9cbf-ac2adda4bda3"],

Cell[BoxData[
 InterpretationBox[
