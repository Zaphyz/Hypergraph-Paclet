Cell["\<\
The domain is read off the entries, and it is the narrowest that contains \
them all:\
\>", "ExampleText",ExpressionUUID->"88871392-9ed6-8240-82f3-7d26cfd11a5f"],

Cell["\<\
ArrayDomain @ ArrayObject[#] & /@ {{True, False}, {1, 2}, {1/2, 3}, {1.5, 2}, \
{1 + I, 2}}\
\>", "Input",ExpressionUUID->"ad2ab1d9-81c0-ee44-afcb-5db1d5c0d9dc"],

