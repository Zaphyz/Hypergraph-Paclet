UID->"296076e9-610d-fa42-94fd-080684750c0d"],

Cell["Entries of a finite field are recognized too:", "ExampleText",ExpressionUUID->"921c4da2-dd9e-d04d-8ad0-d4afd3f4037e"],

Cell["\<\
ArrayDomain @ ArrayObject[{FiniteField[2, 1][0], FiniteField[2, 1][1]}]\
\>", "Input",ExpressionUUID->"9736b278-5077-1f49-889e-d7565ca845dc"],

Cell[BoxData[
 InterpretationBox[
