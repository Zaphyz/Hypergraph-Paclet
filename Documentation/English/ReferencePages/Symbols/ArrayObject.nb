UID->"d5d51a0d-dcf7-5b45-aa35-de299f5076e8"],

Cell["Entries of a finite field are recognized too:", "ExampleText",ExpressionUUID->"d84ee5b0-76e6-7340-91b2-d6dfd9480275"],

Cell["\<\
ArrayDomain @ ArrayObject[{FiniteField[2, 1][0], FiniteField[2, 1][1]}]\
\>", "Input",ExpressionUUID->"df981a3e-5844-ae42-9c42-58b2bafa20b8"],

Cell[BoxData[
