Cell["\<\
Entries that answer to none of them are simply expressions, and make a \
perfectly good array:\
\>", "ExampleText",ExpressionUUID->"bec5997b-affe-1f40-8a0d-a6e2558822a9"],

Cell["\<\
{ArrayDomain @ ArrayObject[{\"a\", \"b\"}], ArrayDomain @ ArrayObject[{x, \
y}],
 ArrayDomain @ ArrayObject[{1, \"a\"}]}\
\>", "Input",ExpressionUUID->"fa641f4c-d6eb-0741-b20f-0d9b54bac2bb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Expression\"\>", ",", "\<\"Expression\"\>", 
   ",", "\<\"Expression\"\>"}], "}"}]], "Output",ExpressionUUID->"77fd91b2-\
4f9f-7a4e-8c35-0480ff4a375f"],

Cell["\<\
A declared symmetry is verified. These entries are symmetric:\
\>", "ExampleText",ExpressionUUID->"8cc1599c-ba65-8f45-9254-f82679f46598"],

Cell["ArraySymmetry @ ArrayObject[{{1, 2}, {2, 1}}, \"Symmetric\"]", "Input",ExpressionUUID->"54408053-1ab2-5d47-805c-168c84728d18"],

Cell[BoxData["\<\"Symmetric\"\>"], "Output",ExpressionUUID->"95d65499-7741-4f49-a0fd-0a53b21afbfc"],

Cell["\[Ellipsis] and these are not, so the declaration is refused:", \
"ExampleText",ExpressionUUID->"9d6df90c-b09d-4345-a852-a97a3c7fcde3"],

Cell["Quiet @ ArrayObject[{{1, 2}, {3, 4}}, \"Symmetric\"]", "Input",ExpressionUUID->"f41eee0f-13dd-e445-9a3c-59a50a925595"],

Cell[BoxData["$Failed"], "Output",ExpressionUUID->"0a540270-a570-6643-9fa2-ccf6d074f310"],

Cell["The same entries are perfectly good as a rigid array:", "ExampleText",ExpressionUUID->"5ff38160-d05c-b240-b94d-a76fd2b31f88"],

Cell["ArraySymmetry @ ArrayObject[{{1, 2}, {3, 4}}]", "Input",ExpressionUUID->"ab095a4b-4ea9-d241-ac1b-a2247311d0a0"],

Cell[BoxData["\<\"Rigid\"\>"], "Output",ExpressionUUID->"93d51690-71cc-bd47-9fce-a0590e6053dc"],

Cell["\<\
A scalar is the array of order zero, with no dimensions and one entry:\
\>", "ExampleText",ExpressionUUID->"68ea04f5-b0ea-3e45-899b-7686b4586e0a"],

Cell["\<\
{ArrayOrder @ ArrayObject[5], ArrayDimensions @ ArrayObject[5],
 Normal @ ArrayObject[5]}\
\>", "Input",ExpressionUUID->"955070b4-04ef-0d41-b17b-c385fa8bd108"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", 
   RowBox[{"{", "}"}], ",", "5"}], "}"}]], "Output",ExpressionUUID->"527c6539-\
b762-1042-9175-1ed08c666892"],

