UID->"978e615d-b8be-674a-979b-f9804c1410fc"],

Cell["Entries of a finite field are recognized too:", "ExampleText",ExpressionUUID->"1ff27a14-a378-e34b-9688-05dc6b49cec5"],

Cell["\<\
ArrayDomain @ ArrayObject[{FiniteField[2, 1][0], FiniteField[2, 1][1]}]\
\>", "Input",ExpressionUUID->"440856a7-109b-3f46-af75-642a92aea399"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
