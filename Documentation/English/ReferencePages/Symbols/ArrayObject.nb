Cell["\<\
Entries that answer to none of them are simply expressions, and make a \
perfectly good array:\
\>", "ExampleText",ExpressionUUID->"d36e19e3-6dca-4a42-bc1f-250ec2909aa6"],

Cell["\<\
{ArrayDomain @ ArrayObject[{\"a\", \"b\"}], ArrayDomain @ ArrayObject[{x, \
y}],
 ArrayDomain @ ArrayObject[{1, \"a\"}]}\
\>", "Input",ExpressionUUID->"5842a0ef-d639-ca4d-834c-00b5b56635d1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Expression\"\>", ",", "\<\"Expression\"\>", 
   ",", "\<\"Expression\"\>"}], "}"}]], "Output",ExpressionUUID->"4c6d825c-\
1a81-d14c-9548-28785b577203"],

Cell["\<\
A declared symmetry is verified. These entries are symmetric:\
\>", "ExampleText",ExpressionUUID->"3ade7b56-9874-a048-82ab-48814af79068"],

Cell["ArraySymmetry @ ArrayObject[{{1, 2}, {2, 1}}, \"Symmetric\"]", "Input",ExpressionUUID->"59dc2dac-7d06-1c48-b5d8-b25653674351"],

Cell[BoxData["\<\"Symmetric\"\>"], "Output",ExpressionUUID->"dd800f27-6391-774c-adae-12c4cf710131"],

Cell["\[Ellipsis] and these are not, so the declaration is refused:", \
"ExampleText",ExpressionUUID->"0591991d-043c-7641-bdaf-9be37b8e17d2"],

Cell["Quiet @ ArrayObject[{{1, 2}, {3, 4}}, \"Symmetric\"]", "Input",ExpressionUUID->"378d445c-e98e-1946-9e09-b3c2be543a7c"],

Cell[BoxData["$Failed"], "Output",ExpressionUUID->"bce44239-4c69-5b4f-b025-bbacfe5e0266"],

Cell["The same entries are perfectly good as a rigid array:", "ExampleText",ExpressionUUID->"755ec49c-58c5-b54a-a042-e87538e5a8b1"],

Cell["ArraySymmetry @ ArrayObject[{{1, 2}, {3, 4}}]", "Input",ExpressionUUID->"3f2df3bc-53ac-3e4c-a684-56f91f449f2d"],

Cell[BoxData["\<\"Rigid\"\>"], "Output",ExpressionUUID->"1b2b9716-5834-1249-b84a-7fe8ee8e2a63"],

Cell["\<\
A scalar is the array of order zero, with no dimensions and one entry:\
\>", "ExampleText",ExpressionUUID->"fbc366a0-a12a-c34e-9e75-903474fffc2b"],

Cell["\<\
{ArrayOrder @ ArrayObject[5], ArrayDimensions @ ArrayObject[5],
 Normal @ ArrayObject[5]}\
\>", "Input",ExpressionUUID->"e244a570-287c-c74a-9d9f-01d6b2a09cd7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", 
   RowBox[{"{", "}"}], ",", "5"}], "}"}]], "Output",ExpressionUUID->"82a0dc22-\
e8a1-4a40-9481-d67bb9df1a30"],

