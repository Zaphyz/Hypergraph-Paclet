Cell["\<\
The domain is read off the entries, and it is the narrowest that contains \
them all:\
\>", "ExampleText",ExpressionUUID->"9d9fbd10-895b-a040-b616-f014d6ae603f"],

Cell["\<\
ArrayDomain @ ArrayObject[#] & /@ {{True, False}, {1, 2}, {1/2, 3}, {1.5, 2}, \
{1 + I, 2}}\
\>", "Input",ExpressionUUID->"b7d9a5f6-f905-704d-90b6-95a6bdfb761f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Boolean\"\>", ",", "\<\"Integer\"\>", ",", "\<\"Rational\"\>", 
   ",", "\<\"Real\"\>", ",", "\<\"Complex\"\>"}], "}"}]], "Output",ExpressionU\
UID->"8325a488-aa86-af4b-96a0-272ce5a60072"],

Cell["Entries of a finite field are recognized too:", "ExampleText",ExpressionUUID->"bcc8c06c-028b-ed45-acc0-4b607a81a53f"],

Cell["\<\
ArrayDomain @ ArrayObject[{FiniteField[2, 1][0], FiniteField[2, 1][1]}]\
\>", "Input",ExpressionUUID->"6dc4e4a5-0628-0741-a055-9bababe1c5e6"],

Cell[BoxData[
