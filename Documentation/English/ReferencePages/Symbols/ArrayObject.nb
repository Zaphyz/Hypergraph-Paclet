Cell["\<\
Entries that answer to none of them are simply expressions, and make a \
perfectly good array:\
\>", "ExampleText",ExpressionUUID->"ad1b2e9b-7ece-c74a-8a11-cb51cf18fb2d"],

Cell["\<\
{ArrayDomain @ ArrayObject[{\"a\", \"b\"}], ArrayDomain @ ArrayObject[{x, \
y}],
 ArrayDomain @ ArrayObject[{1, \"a\"}]}\
\>", "Input",ExpressionUUID->"46d1cbcf-b639-bf47-b1c8-9ed033125ab4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Expression\"\>", ",", "\<\"Expression\"\>", 
   ",", "\<\"Expression\"\>"}], "}"}]], "Output",ExpressionUUID->"338a1b09-\
e24c-9f42-aac5-77887bb96797"],

Cell["\<\
A declared symmetry is verified. These entries are symmetric:\
\>", "ExampleText",ExpressionUUID->"cdd1dc88-6157-3841-bc64-35ac8ba74a56"],

Cell["ArraySymmetry @ ArrayObject[{{1, 2}, {2, 1}}, \"Symmetric\"]", "Input",ExpressionUUID->"29b9185f-8baf-f54b-9864-55f07b8fccb9"],

Cell[BoxData["\<\"Symmetric\"\>"], "Output",ExpressionUUID->"8f2760a8-bc5d-b24b-9967-95aa4d6e7319"],

Cell["\[Ellipsis] and these are not, so the declaration is refused:", \
"ExampleText",ExpressionUUID->"b9dfe4d5-42dc-034a-82ee-5396913ed9be"],

Cell["Quiet @ ArrayObject[{{1, 2}, {3, 4}}, \"Symmetric\"]", "Input",ExpressionUUID->"7bed87d4-bd56-9249-9267-dac0bb143978"],

Cell[BoxData["$Failed"], "Output",ExpressionUUID->"24ff85e2-60b5-3940-b023-9bf9b25d8364"],

Cell["The same entries are perfectly good as a rigid array:", "ExampleText",ExpressionUUID->"18c23da6-7c79-5b4d-8449-eeb53233e9bd"],

Cell["ArraySymmetry @ ArrayObject[{{1, 2}, {3, 4}}]", "Input",ExpressionUUID->"2a0160a3-931c-794e-ba15-5d28bee50faf"],

Cell[BoxData["\<\"Rigid\"\>"], "Output",ExpressionUUID->"053583bf-8547-d049-a694-407a93adb6ae"],

Cell["\<\
A scalar is the array of order zero, with no dimensions and one entry:\
\>", "ExampleText",ExpressionUUID->"fc4bf21c-c207-024d-b0fc-3f4086fcae3d"],

Cell["\<\
{ArrayOrder @ ArrayObject[5], ArrayDimensions @ ArrayObject[5],
 Normal @ ArrayObject[5]}\
\>", "Input",ExpressionUUID->"76fe43da-c1a4-7849-a01d-34a59a395840"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", 
   RowBox[{"{", "}"}], ",", "5"}], "}"}]], "Output",ExpressionUUID->"4e4bcb72-\
a410-e74b-9fa0-6f7479716b11"],

