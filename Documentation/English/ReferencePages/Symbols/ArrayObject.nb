Cell["\<\
The domain is read off the entries, and it is the narrowest that contains \
them all:\
\>", "ExampleText",ExpressionUUID->"02f8effc-0b63-8c44-8633-3abcd799bb4f"],

Cell["\<\
ArrayDomain @ ArrayObject[#] & /@ {{True, False}, {1, 2}, {1/2, 3}, {1.5, 2}, \
{1 + I, 2}}\
\>", "Input",ExpressionUUID->"bb3b8146-230d-2f4c-8920-f94fdccad371"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Boolean\"\>", ",", "\<\"Integer\"\>", ",", "\<\"Rational\"\>", 
   ",", "\<\"Real\"\>", ",", "\<\"Complex\"\>"}], "}"}]], "Output",ExpressionU\
UID->"742da7ee-d293-f846-8b0a-68ffa5927034"],

Cell["Entries of a finite field are recognized too:", "ExampleText",ExpressionUUID->"594fa4cb-a16e-794c-83eb-80147a571251"],

Cell["\<\
ArrayDomain @ ArrayObject[{FiniteField[2, 1][0], FiniteField[2, 1][1]}]\
\>", "Input",ExpressionUUID->"8eea32f1-55ca-e54d-8e67-d8245f7b4663"],

