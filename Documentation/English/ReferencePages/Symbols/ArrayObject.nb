Cell["The entries come back with Normal:", "ExampleText",ExpressionUUID->"1262be5b-75ce-9a4d-a281-9f94a7f2195e"],

Cell["Normal @ ArrayObject[{{1, 2}, {3, 4}}]", "Input",ExpressionUUID->"4af0eb67-856d-c54f-a2dd-e643f9a7b6e6"],

