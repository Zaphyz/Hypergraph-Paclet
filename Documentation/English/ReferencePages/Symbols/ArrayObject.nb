UID->"45286b09-debb-c14d-84f6-91d394e445f3"],

Cell["Entries of a finite field are recognized too:", "ExampleText",ExpressionUUID->"36e33f0c-ead9-9940-96c5-b35bb8c5e04d"],

Cell["\<\
ArrayDomain @ ArrayObject[{FiniteField[2, 1][0], FiniteField[2, 1][1]}]\
\>", "Input",ExpressionUUID->"21aa21f6-3f6b-314d-bfae-4d79b4dfd368"],

Cell[BoxData[
