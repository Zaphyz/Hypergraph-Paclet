UID->"87855502-05e1-424d-b216-9cdb90c0bb75"],

Cell["Entries of a finite field are recognized too:", "ExampleText",ExpressionUUID->"bfe7d7b4-6f1d-af4b-aca5-25b807863067"],

Cell["\<\
ArrayDomain @ ArrayObject[{FiniteField[2, 1][0], FiniteField[2, 1][1]}]\
\>", "Input",ExpressionUUID->"5e2455c0-6142-3345-b89f-67fed984049f"],

Cell[BoxData[
