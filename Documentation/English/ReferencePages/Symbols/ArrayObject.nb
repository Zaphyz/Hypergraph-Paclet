Cell["\<\
Entries that answer to none of them are simply expressions, and make a \
perfectly good array:\
\>", "ExampleText",ExpressionUUID->"8c0ee18e-3f47-6f44-a206-edea84b9c842"],

Cell["\<\
{ArrayDomain @ ArrayObject[{\"a\", \"b\"}], ArrayDomain @ ArrayObject[{x, \
y}],
 ArrayDomain @ ArrayObject[{1, \"a\"}]}\
\>", "Input",ExpressionUUID->"04b1ae6f-0f86-614f-8a71-56de09fe8e9c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Expression\"\>", ",", "\<\"Expression\"\>", 
   ",", "\<\"Expression\"\>"}], "}"}]], "Output",ExpressionUUID->"241cbdb0-\
1b05-7b44-9a0b-f09d585152f8"],

Cell["\<\
A declared symmetry is verified. These entries are symmetric:\
\>", "ExampleText",ExpressionUUID->"5e264e0a-ddab-2340-8bbf-8ca53c55e0cb"],

Cell["ArraySymmetry @ ArrayObject[{{1, 2}, {2, 1}}, \"Symmetric\"]", "Input",ExpressionUUID->"a213f49f-a563-d94e-840d-b3de3883cc85"],

Cell[BoxData["\<\"Symmetric\"\>"], "Output",ExpressionUUID->"a8e4d5f3-f3e1-4c40-8a78-d223c5b8c3ad"],

Cell["\[Ellipsis] and these are not, so the declaration is refused:", \
"ExampleText",ExpressionUUID->"83255e40-3532-9e40-af8b-a1b49b2cbbe5"],

Cell["Quiet @ ArrayObject[{{1, 2}, {3, 4}}, \"Symmetric\"]", "Input",ExpressionUUID->"480a9ba2-3d41-a749-b766-1a01e4bf392d"],

Cell[BoxData["$Failed"], "Output",ExpressionUUID->"29cdbd20-bcbf-134c-824c-c18b436c7cd9"],

Cell["The same entries are perfectly good as a rigid array:", "ExampleText",ExpressionUUID->"7508aab3-e152-5c40-a3a6-7d7fc1c7b610"],

Cell["ArraySymmetry @ ArrayObject[{{1, 2}, {3, 4}}]", "Input",ExpressionUUID->"dbe14c46-6286-b94b-aa4b-3eb48397fc8a"],

Cell[BoxData["\<\"Rigid\"\>"], "Output",ExpressionUUID->"ac325c91-c0d4-3d4b-982a-2ee93231d0d3"],

Cell["\<\
A scalar is the array of order zero, with no dimensions and one entry:\
\>", "ExampleText",ExpressionUUID->"0a79d823-a487-004d-aa51-6c651cc8219d"],

Cell["\<\
{ArrayOrder @ ArrayObject[5], ArrayDimensions @ ArrayObject[5],
 Normal @ ArrayObject[5]}\
\>", "Input",ExpressionUUID->"095c407d-c665-6349-8cd6-59b0b2a9f995"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", 
   RowBox[{"{", "}"}], ",", "5"}], "}"}]], "Output",ExpressionUUID->"0e7b507c-\
14c2-804b-b82f-35b206415f07"],

