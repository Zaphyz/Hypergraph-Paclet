Cell["\<\
Entries that answer to none of them are simply expressions, and make a \
perfectly good array:\
\>", "ExampleText",ExpressionUUID->"b6775c60-4123-f74e-91bd-e74f751caaa8"],

Cell["\<\
{ArrayDomain @ ArrayObject[{\"a\", \"b\"}], ArrayDomain @ ArrayObject[{x, \
y}],
 ArrayDomain @ ArrayObject[{1, \"a\"}]}\
\>", "Input",ExpressionUUID->"ab7f2381-0a80-6646-bc2f-5e9612d5a72b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Expression\"\>", ",", "\<\"Expression\"\>", 
   ",", "\<\"Expression\"\>"}], "}"}]], "Output",ExpressionUUID->"a9b27fb0-\
33e6-3b41-ae6d-974c38d44ca7"],

Cell["\<\
A declared symmetry is verified. These entries are symmetric:\
\>", "ExampleText",ExpressionUUID->"d74ecc2e-84b1-9b44-ba61-52f52623192d"],

Cell["ArraySymmetry @ ArrayObject[{{1, 2}, {2, 1}}, \"Symmetric\"]", "Input",ExpressionUUID->"7a90c778-2b96-f847-8b67-d2a8b190649b"],

Cell[BoxData["\<\"Symmetric\"\>"], "Output",ExpressionUUID->"a0aded5a-1a00-2a44-b22e-15044640ab7c"],

Cell["\[Ellipsis] and these are not, so the declaration is refused:", \
"ExampleText",ExpressionUUID->"fea43803-5ed0-584f-bd5f-2d00ab5dbf9b"],

Cell["Quiet @ ArrayObject[{{1, 2}, {3, 4}}, \"Symmetric\"]", "Input",ExpressionUUID->"85765834-8533-9e40-ba8b-65a01fa42b22"],

Cell[BoxData["$Failed"], "Output",ExpressionUUID->"47aa8a74-eb81-fd47-bf78-1ccc95baae52"],

Cell["The same entries are perfectly good as a rigid array:", "ExampleText",ExpressionUUID->"ad1e2783-6722-cc4a-a0e0-6ef89c3112bb"],

Cell["ArraySymmetry @ ArrayObject[{{1, 2}, {3, 4}}]", "Input",ExpressionUUID->"7b713735-762d-3946-aa36-ef088e98e5ff"],

Cell[BoxData["\<\"Rigid\"\>"], "Output",ExpressionUUID->"ddc0b453-1ecd-9d44-a71e-58c3bfe35585"],

Cell["\<\
A scalar is the array of order zero, with no dimensions and one entry:\
\>", "ExampleText",ExpressionUUID->"c1c81f8f-06d1-9d40-a530-08d1c0a4c6a1"],

Cell["\<\
{ArrayOrder @ ArrayObject[5], ArrayDimensions @ ArrayObject[5],
 Normal @ ArrayObject[5]}\
\>", "Input",ExpressionUUID->"adaffb1c-3f9e-b245-be5e-fa503255b78d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", 
   RowBox[{"{", "}"}], ",", "5"}], "}"}]], "Output",ExpressionUUID->"bbb5e6ae-\
0146-d04b-b070-ec17bf7fe625"],

