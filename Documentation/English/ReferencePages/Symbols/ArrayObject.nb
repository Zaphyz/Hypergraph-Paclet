Cell["\<\
Entries that answer to none of them are simply expressions, and make a \
perfectly good array:\
\>", "ExampleText",ExpressionUUID->"0ba3ce40-9766-2e49-beee-9e28fce56944"],

Cell["\<\
{ArrayDomain @ ArrayObject[{\"a\", \"b\"}], ArrayDomain @ ArrayObject[{x, \
y}],
 ArrayDomain @ ArrayObject[{1, \"a\"}]}\
\>", "Input",ExpressionUUID->"617ac3e8-66a3-0f4a-aee8-dc387832dd08"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Expression\"\>", ",", "\<\"Expression\"\>", 
   ",", "\<\"Expression\"\>"}], "}"}]], "Output",ExpressionUUID->"40e41254-\
cfa3-c64e-90be-9bcceadfa4d3"],

Cell["\<\
A declared symmetry is verified. These entries are symmetric:\
\>", "ExampleText",ExpressionUUID->"327a8c57-c1c0-8149-b08c-6ba7b8b37f8d"],

Cell["ArraySymmetry @ ArrayObject[{{1, 2}, {2, 1}}, \"Symmetric\"]", "Input",ExpressionUUID->"747fb92c-831c-4a4b-abdf-1d818e048a56"],

Cell[BoxData["\<\"Symmetric\"\>"], "Output",ExpressionUUID->"c30bf37b-6bac-dd45-ae0d-87387dc3d585"],

Cell["\[Ellipsis] and these are not, so the declaration is refused:", \
"ExampleText",ExpressionUUID->"d4633a71-4cfb-8a43-979f-0a97ec3e0e1c"],

Cell["Quiet @ ArrayObject[{{1, 2}, {3, 4}}, \"Symmetric\"]", "Input",ExpressionUUID->"c9ab5441-8631-f34d-9559-b5e1e1f92e6e"],

Cell[BoxData["$Failed"], "Output",ExpressionUUID->"e0ea61ba-46a0-fd49-a4b7-b364a2590f34"],

Cell["The same entries are perfectly good as a rigid array:", "ExampleText",ExpressionUUID->"31ffa53d-9b9c-1040-a374-e0814cabb150"],

Cell["ArraySymmetry @ ArrayObject[{{1, 2}, {3, 4}}]", "Input",ExpressionUUID->"f62cd9ce-a388-4145-8330-79da819d2332"],

Cell[BoxData["\<\"Rigid\"\>"], "Output",ExpressionUUID->"b5fed9c2-fac9-9a42-a339-4ea172e4d08e"],

Cell["\<\
A scalar is the array of order zero, with no dimensions and one entry:\
\>", "ExampleText",ExpressionUUID->"f57c9916-5345-c845-8279-77c6e0c75722"],

Cell["\<\
{ArrayOrder @ ArrayObject[5], ArrayDimensions @ ArrayObject[5],
 Normal @ ArrayObject[5]}\
\>", "Input",ExpressionUUID->"b28317fd-891d-fc4c-be08-42291471fe85"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", 
   RowBox[{"{", "}"}], ",", "5"}], "}"}]], "Output",ExpressionUUID->"53ddea00-\
a660-7a45-a90f-4858efa1386e"],

Cell["Source", "NotesSection",ExpressionUUID->"1914f71c-d31a-7145-b188-b2504d58cee7"],

