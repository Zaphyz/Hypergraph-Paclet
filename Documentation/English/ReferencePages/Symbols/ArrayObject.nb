Cell["\<\
Entries that answer to none of them are simply expressions, and make a \
perfectly good array:\
\>", "ExampleText",ExpressionUUID->"99263c31-1b68-4347-9e6d-63f4632e8ce0"],

Cell["\<\
{ArrayDomain @ ArrayObject[{\"a\", \"b\"}], ArrayDomain @ ArrayObject[{x, \
y}],
 ArrayDomain @ ArrayObject[{1, \"a\"}]}\
\>", "Input",ExpressionUUID->"06115c0c-fc9c-9341-9ad3-d0dcb15c2b70"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Expression\"\>", ",", "\<\"Expression\"\>", 
   ",", "\<\"Expression\"\>"}], "}"}]], "Output",ExpressionUUID->"c518b966-\
0b96-6146-966e-cb3a5503d996"],

Cell["\<\
A declared symmetry is verified. These entries are symmetric:\
\>", "ExampleText",ExpressionUUID->"089793d6-abce-444e-a072-0154617e6c12"],

Cell["ArraySymmetry @ ArrayObject[{{1, 2}, {2, 1}}, \"Symmetric\"]", "Input",ExpressionUUID->"9cdba20d-3d79-6a4d-b372-5463ed678c13"],

Cell[BoxData["\<\"Symmetric\"\>"], "Output",ExpressionUUID->"f8361b26-14a6-3349-a934-f300c10313c3"],

Cell["\[Ellipsis] and these are not, so the declaration is refused:", \
"ExampleText",ExpressionUUID->"fd78cea5-1533-fe42-9715-eba89f296885"],

Cell["Quiet @ ArrayObject[{{1, 2}, {3, 4}}, \"Symmetric\"]", "Input",ExpressionUUID->"57b01ce1-651f-3d49-877a-d40afbf41bcb"],

Cell[BoxData["$Failed"], "Output",ExpressionUUID->"ffd6cb55-6360-174e-a804-d777b113a11d"],

Cell["The same entries are perfectly good as a rigid array:", "ExampleText",ExpressionUUID->"d13d09da-7200-da4a-a3c7-9a888c575021"],

Cell["ArraySymmetry @ ArrayObject[{{1, 2}, {3, 4}}]", "Input",ExpressionUUID->"2161bb49-d2c5-b046-96f9-b7de4177bf97"],

Cell[BoxData["\<\"Rigid\"\>"], "Output",ExpressionUUID->"e60b5f36-a609-5c45-b236-c6d690e16422"],

Cell["\<\
A scalar is the array of order zero, with no dimensions and one entry:\
\>", "ExampleText",ExpressionUUID->"826dc108-06da-f145-bdc1-4d5983fecc4e"],

Cell["\<\
{ArrayOrder @ ArrayObject[5], ArrayDimensions @ ArrayObject[5],
 Normal @ ArrayObject[5]}\
\>", "Input",ExpressionUUID->"33bac47f-7dba-2b47-8d14-8a2d69a33b8f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", 
   RowBox[{"{", "}"}], ",", "5"}], "}"}]], "Output",ExpressionUUID->"9c4f5709-\
0df4-7f48-8f5e-3e8bb881e632"],

Cell["Source", "NotesSection",ExpressionUUID->"ab201ca6-baf3-9643-a591-5134d97b6118"],

