Cell["\<\
The domain is read off the entries, and it is the narrowest that contains \
them all:\
\>", "ExampleText",ExpressionUUID->"76973423-a046-e544-b386-22090852b2ee"],

Cell["\<\
ArrayDomain @ ArrayObject[#] & /@ {{True, False}, {1, 2}, {1/2, 3}, {1.5, 2}, \
{1 + I, 2}}\
\>", "Input",ExpressionUUID->"be91b05d-cde8-6246-bb8a-2816aaa61fd3"],

