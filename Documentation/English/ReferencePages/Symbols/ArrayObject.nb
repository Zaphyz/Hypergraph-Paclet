Cell["\<\
The domain is read off the entries, and it is the narrowest that contains \
them all:\
\>", "ExampleText",ExpressionUUID->"7f0fe394-871f-854b-8066-67b5f77be387"],

Cell["\<\
ArrayDomain @ ArrayObject[#] & /@ {{True, False}, {1, 2}, {1/2, 3}, {1.5, 2}, \
{1 + I, 2}}\
\>", "Input",ExpressionUUID->"4c4fdee3-6693-c243-84d1-1e452134ebf6"],

