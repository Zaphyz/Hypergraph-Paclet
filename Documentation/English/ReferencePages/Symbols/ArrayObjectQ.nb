Notebook[{
Cell["ArrayObjectQ", "ObjectName",ExpressionUUID->"aa950a3b-ba4d-b944-808d-b37ac2b16274"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayObjectQ", "[", "expr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"6f1a05ec-e957-ec40-8a1b-0b3a338c2b67"],
 " ",
 "gives True if expr is a valid ArrayObject or GenerateSymbolicArray, and \
False otherwise."
}], "Usage",ExpressionUUID->"3b96e859-a5dd-4447-b6eb-e07f7d00e6fa"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"dc7096ce-7685-6d4b-8b19-0903d97d0eef"],

Cell["\<\
A ArrayObject or GenerateSymbolicArray expression that fails to be built \
evaluates to $Failed rather than remaining as one, so any surviving array \
object is in canonical form.\
\>", "Notes",ExpressionUUID->"fdf99ea2-ebe7-df4c-8dee-89ecd4c3821f"],

Cell["\<\
A bare nested list is not an array object, though Hypermatrix promotes one to \
an ArrayObject.\
\>", "Notes",ExpressionUUID->"a2cefd66-b811-6644-a5ce-86a0795d0d2b"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"5fe6877c-af84-4a4a-bae4-62bc57584acf"],

Cell["\<\
{ArrayObjectQ @ ArrayObject[{1, 2}], ArrayObjectQ @ GenerateSymbolicArray[a, \
{2}],
 ArrayObjectQ[{1, 2}], ArrayObjectQ[5]}\
\>", "Input",ExpressionUUID->"9c51420e-550e-134e-bbb8-f54376be17c1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "False", ",", "False"}], "}"}]], "Output",\
ExpressionUUID->"538f6c3d-1d2b-e34d-a074-de19dee0f086"],

Cell["Source", "NotesSection",ExpressionUUID->"3346eaef-8e92-df4d-ab74-774e05c56572"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Array accessors",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"0151ebb2-4c69-7444-a3e1-42a30e27c064"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"90195e79-5fcc-6e45-9268-86ee3cca2807"],

