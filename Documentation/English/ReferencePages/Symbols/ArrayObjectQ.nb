Notebook[{
Cell["ArrayObjectQ", "ObjectName",ExpressionUUID->"75556ad9-7048-004e-8e3c-4944456dfd3f"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayObjectQ", "[", "expr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"8e23f7bf-a504-3c4b-a80d-96499bfd02cc"],
 " ",
 "gives True if expr is a valid ArrayObject or GenerateSymbolicArray, and \
False otherwise."
}], "Usage",ExpressionUUID->"9a5654b6-584e-2547-9cf3-a2273e5f5d9b"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"fef8236c-67b7-5943-aaee-b88458ed4681"],

Cell["\<\
A ArrayObject or GenerateSymbolicArray expression that fails to be built \
evaluates to $Failed rather than remaining as one, so any surviving array \
object is in canonical form.\
\>", "Notes",ExpressionUUID->"e51974f3-f40e-4043-817b-bfaa4f7eff3e"],

Cell["\<\
A bare nested list is not an array object, though Hypermatrix promotes one to \
an ArrayObject.\
\>", "Notes",ExpressionUUID->"782c4176-3d2f-1146-8fe7-0624c379be0e"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"135d23ac-4e47-6244-a2d6-b2ddbc4f4ec0"],

Cell["\<\
{ArrayObjectQ @ ArrayObject[{1, 2}], ArrayObjectQ @ GenerateSymbolicArray[a, \
{2}],
 ArrayObjectQ[{1, 2}], ArrayObjectQ[5]}\
\>", "Input",ExpressionUUID->"b82027bd-6fcf-df4d-b026-76c7a200dc20"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "False", ",", "False"}], "}"}]], "Output",\
ExpressionUUID->"8fcef850-1b88-c94d-898d-a0210d7c8b48"],

Cell["Source", "NotesSection",ExpressionUUID->"592aac11-7082-a541-b8e0-528fb1de2e94"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Array accessors",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"d5df036c-5bee-7a44-8f00-79cecb39987c"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"3c3047fd-62c4-d948-b2e0-47da1d8f5e2a"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayObject", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "1da5f0bc-59a4-d44f-8a01-77954cb22607"],
