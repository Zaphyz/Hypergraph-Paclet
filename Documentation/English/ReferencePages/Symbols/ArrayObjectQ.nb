Notebook[{
Cell["ArrayObjectQ", "ObjectName",ExpressionUUID->"c4ba4114-772c-9040-abe8-1640b9da96d9"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayObjectQ", "[", "expr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"8616a7e4-c0ca-4546-8901-bc9cffdf247e"],
 " ",
 "gives True if expr is a valid ArrayObject or GenerateSymbolicArray, and \
False otherwise."
}], "Usage",ExpressionUUID->"f88a109e-5a98-6e41-aebc-7269e7d195bc"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"61b591b7-3bcf-b043-a355-e48d4347a5a2"],

Cell["\<\
A ArrayObject or GenerateSymbolicArray expression that fails to be built \
evaluates to $Failed rather than remaining as one, so any surviving array \
object is in canonical form.\
\>", "Notes",ExpressionUUID->"b09ffe7b-d1a0-9543-8c4a-14a0ddaaa1dc"],

Cell["\<\
A bare nested list is not an array object, though Hypermatrix promotes one to \
an ArrayObject.\
\>", "Notes",ExpressionUUID->"28696d85-a6ec-054a-b084-e2039500d287"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"65214dd6-23cc-6c4c-bec3-2418ffac9aaa"],

Cell["\<\
{ArrayObjectQ @ ArrayObject[{1, 2}], ArrayObjectQ @ GenerateSymbolicArray[a, \
{2}],
 ArrayObjectQ[{1, 2}], ArrayObjectQ[5]}\
\>", "Input",ExpressionUUID->"2724e10c-4426-aa41-9f1f-d7f472561648"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "False", ",", "False"}], "}"}]], "Output",\
ExpressionUUID->"233f1d12-61b2-4e42-98ab-eaf4c7378af2"],

Cell["Source", "NotesSection",ExpressionUUID->"247ae4d7-3955-5e42-aa66-2d487953c996"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Array accessors",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"3b7dc4f7-ceb4-ed44-9c98-ca4b4ee96a9a"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"0bbff0b6-e0bf-c249-9c32-62a00e170b41"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayObject", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "d95b6ffd-f250-4f4c-b854-9b78f8afe78a"],
