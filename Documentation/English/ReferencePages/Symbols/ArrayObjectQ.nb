Notebook[{
Cell["ArrayObjectQ", "ObjectName",ExpressionUUID->"fdf8502c-c76e-734a-a250-cb2755cbf7a5"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayObjectQ", "[", "expr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"8bcd1b7a-14af-a34f-835f-96e57ff5cc58"],
 " ",
 "gives True if expr is a valid ArrayObject or GenerateSymbolicArray, and \
False otherwise."
}], "Usage",ExpressionUUID->"40cd3c6a-e7af-1e4d-b28a-9fd54b66a3d5"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"06cd9df2-e949-a343-a06d-1e5ae0f21c2a"],

Cell["\<\
A ArrayObject or GenerateSymbolicArray expression that fails to be built \
evaluates to $Failed rather than remaining as one, so any surviving array \
object is in canonical form.\
\>", "Notes",ExpressionUUID->"af8bac66-32b3-594a-a27b-6fa82fb2c443"],

Cell["\<\
A bare nested list is not an array object, though Hypermatrix promotes one to \
an ArrayObject.\
\>", "Notes",ExpressionUUID->"8c563e1a-19f3-2e4f-9afa-982beb22fa5f"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"9491d69d-dbb3-9f4d-b90e-74e4cfde2c3f"],

Cell["\<\
{ArrayObjectQ @ ArrayObject[{1, 2}], ArrayObjectQ @ GenerateSymbolicArray[a, \
{2}],
 ArrayObjectQ[{1, 2}], ArrayObjectQ[5]}\
\>", "Input",ExpressionUUID->"b3f50b6a-c4ae-7040-9f4b-143ef63138ba"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "False", ",", "False"}], "}"}]], "Output",\
ExpressionUUID->"9c2d1c4c-8915-2349-8904-3785413d4803"],

Cell["Source", "NotesSection",ExpressionUUID->"e7056dee-4391-fd4a-a929-4926093fe7a9"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Array accessors",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"c9b8cf2a-34f5-b846-a5a7-74eb22e49dd4"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"a63080c0-89a5-914b-b0cc-39ea7c7df239"],

