Notebook[{
Cell["ArrayObjectQ", "ObjectName",ExpressionUUID->"3b11d5a2-f704-2e4e-8204-5caa65503e96"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayObjectQ", "[", "expr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"3a86f3f9-d6ba-2040-833a-b823fbdc85df"],
 " ",
 "gives True if expr is a valid NumericalArray or SymbolicArray, and False \
otherwise."
}], "Usage",ExpressionUUID->"154624b8-ed85-6245-9242-bcc7edfa297b"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"f6692e1a-7e5b-6249-84f7-8a9901f4e9bd"],

Cell["\<\
A NumericalArray or SymbolicArray expression that fails to be built evaluates \
to $Failed rather than remaining as one, so any surviving array object is in \
canonical form.\
\>", "Notes",ExpressionUUID->"ac5165fc-6317-9f4a-8820-d9f77e966238"],

Cell["\<\
A bare nested list is not an array object, though Hypermatrix promotes one to \
a NumericalArray.\
\>", "Notes",ExpressionUUID->"7f3902f3-c000-8040-8834-1601bd043d03"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"ec71dbe7-7a56-a048-b3c0-0edda5522a5b"],

Cell["\<\
{ArrayObjectQ @ NumericalArray[{1, 2}], ArrayObjectQ @ SymbolicArray[a, {2}],
 ArrayObjectQ[{1, 2}], ArrayObjectQ[5]}\
\>", "Input",ExpressionUUID->"565c2ed6-b0a2-8b4f-a4d2-abba678f539e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "False", ",", "False"}], "}"}]], "Output",\
ExpressionUUID->"ac97e8ab-0139-964b-82f7-8d716cc7c621"],

Cell["Source", "NotesSection",ExpressionUUID->"2ebeb982-e431-0c46-a5ce-e24b2a629ddb"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Array accessors",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"89707abb-ad2c-2249-81ea-4212d993f652"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"8e0c8a58-9b02-8d4f-82da-3998a97d54a3"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["NumericalArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "5d2828c0-b798-864f-8b94-8d1e57db00ad"],
