Notebook[{
Cell["ArrayObjectQ", "ObjectName",ExpressionUUID->"f1e8284c-9e6c-7045-86b1-97914c8716ad"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayObjectQ", "[", "expr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"893c9df6-8a62-5e4c-af11-ea51b4f1ce45"],
 " ",
 "gives True if expr is a valid ArrayObject or GenerateSymbolicArray, and \
False otherwise."
}], "Usage",ExpressionUUID->"ff10a3e4-98ae-8e46-ad0f-2234911e57bf"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"3a33159f-ac30-654e-a3da-f8834cfdecbe"],

Cell["\<\
A ArrayObject or GenerateSymbolicArray expression that fails to be built \
evaluates to $Failed rather than remaining as one, so any surviving array \
object is in canonical form.\
\>", "Notes",ExpressionUUID->"e75c21eb-271e-c748-8315-d8edf831b3b9"],

Cell["\<\
A bare nested list is not an array object, though Hypermatrix promotes one to \
an ArrayObject.\
\>", "Notes",ExpressionUUID->"dde562cd-3e39-ef44-9842-0434554fb347"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"d6b4e6ba-872d-2740-bd72-c2334e092af5"],

Cell["\<\
{ArrayObjectQ @ ArrayObject[{1, 2}], ArrayObjectQ @ GenerateSymbolicArray[a, \
{2}],
 ArrayObjectQ[{1, 2}], ArrayObjectQ[5]}\
\>", "Input",ExpressionUUID->"66edbe60-ce61-6844-aaf4-ac113a136e52"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "False", ",", "False"}], "}"}]], "Output",\
ExpressionUUID->"e419ea27-3d31-ee40-b4eb-3f08370c1825"],

Cell["Source", "NotesSection",ExpressionUUID->"2e7eb3a4-cb87-b04b-8361-8bd183fcd8f8"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Array accessors",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"4b683eb3-5379-3246-b592-0e4bb2a6f35d"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"e3db182f-2d37-2441-bab9-9ac2cc61bb04"],

