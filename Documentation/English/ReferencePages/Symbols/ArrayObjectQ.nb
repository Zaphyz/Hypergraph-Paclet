Notebook[{
Cell["ArrayObjectQ", "ObjectName",ExpressionUUID->"6664b8c9-68ae-0b41-8a00-f1f09d3e95b8"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayObjectQ", "[", "expr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"b3ea9a34-3dce-0b47-ba10-57eef60cd801"],
 " ",
 "gives True if expr is a valid ArrayObject or GenerateSymbolicArray, and \
False otherwise."
}], "Usage",ExpressionUUID->"a4d6d4b4-cb47-d949-9c0c-e837f7cc699a"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"6dafdf1e-d705-8143-8124-349f6f70e80c"],

Cell["\<\
A ArrayObject or GenerateSymbolicArray expression that fails to be built \
evaluates to $Failed rather than remaining as one, so any surviving array \
object is in canonical form.\
\>", "Notes",ExpressionUUID->"afd9c7ad-939a-3846-83a5-80b4bb318e46"],

Cell["\<\
A bare nested list is not an array object, though Hypermatrix promotes one to \
an ArrayObject.\
\>", "Notes",ExpressionUUID->"86736747-2706-3042-ae98-e1363803c2dc"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"9e12d34b-448b-1746-8abc-65f05688d70e"],

Cell["\<\
{ArrayObjectQ @ ArrayObject[{1, 2}], ArrayObjectQ @ GenerateSymbolicArray[a, \
{2}],
 ArrayObjectQ[{1, 2}], ArrayObjectQ[5]}\
\>", "Input",ExpressionUUID->"25efcfa3-51e2-bd41-bdb4-476ab1188938"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "False", ",", "False"}], "}"}]], "Output",\
ExpressionUUID->"26964226-fd5e-e34d-9dcb-6fbd922dfc5a"],

Cell["Source", "NotesSection",ExpressionUUID->"6fe49374-1989-9d48-a919-c4ee6f238dbe"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Array accessors",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"892ffa43-a31d-cb4b-b4ec-15c40550bf87"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"1082a7f3-894e-8b4f-bbf4-83b193bad800"],

