Notebook[{
Cell["ArrayObjectQ", "ObjectName",ExpressionUUID->"b369127d-5308-6c4b-a6b6-f74097bba6cb"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayObjectQ", "[", "expr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"b0e8c674-4c0a-e147-8a5a-ae9ab50d1daf"],
 " ",
 "gives True if expr is a valid ArrayObject or GenerateSymbolicArray, and \
False otherwise."
}], "Usage",ExpressionUUID->"6e4c05cb-986e-1241-9bef-58bc30c29cc7"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"c4d4b5b0-f41a-5d4e-8a9a-4b5d34d69143"],

Cell["\<\
A ArrayObject or GenerateSymbolicArray expression that fails to be built \
evaluates to $Failed rather than remaining as one, so any surviving array \
object is in canonical form.\
\>", "Notes",ExpressionUUID->"72722e4d-d9a8-0349-beac-b553e3dab2a0"],

Cell["\<\
A bare nested list is not an array object, though Hypermatrix promotes one to \
an ArrayObject.\
\>", "Notes",ExpressionUUID->"f36d1f04-cc51-ba40-9065-25e9e9366641"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"0d0ec0f9-8401-6a4f-a043-c487d4e35cdf"],

Cell["\<\
{ArrayObjectQ @ ArrayObject[{1, 2}], ArrayObjectQ @ GenerateSymbolicArray[a, \
{2}],
 ArrayObjectQ[{1, 2}], ArrayObjectQ[5]}\
\>", "Input",ExpressionUUID->"c66b2745-7153-fd47-b8b0-5fe6740fd8b1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "False", ",", "False"}], "}"}]], "Output",\
ExpressionUUID->"f2784243-1195-bd49-9a6f-5254599adf2d"],

Cell["Source", "NotesSection",ExpressionUUID->"4052d032-c051-8241-9d9b-361656eefd65"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Array accessors",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"0ee744e4-74bd-0843-8b9f-0f4cd238f8f7"],

