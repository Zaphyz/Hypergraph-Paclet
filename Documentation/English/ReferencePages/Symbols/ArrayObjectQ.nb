Notebook[{
Cell["ArrayObjectQ", "ObjectName",ExpressionUUID->"5c54b0de-bbb7-e54c-a0ae-c18d6608e6aa"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayObjectQ", "[", "expr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"df483226-2d92-f949-a9c6-8f875a86c0ba"],
 " ",
 "gives True if expr is a valid ArrayObject or GenerateSymbolicArray, and \
False otherwise."
}], "Usage",ExpressionUUID->"52afc59e-43b1-484b-8a90-9579297a9db2"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"4612203e-542e-bb4e-87cf-e021153fa966"],

Cell["\<\
A ArrayObject or GenerateSymbolicArray expression that fails to be built \
evaluates to $Failed rather than remaining as one, so any surviving array \
object is in canonical form.\
\>", "Notes",ExpressionUUID->"161ad04b-f571-0f47-b3a5-856ccc7fb46d"],

Cell["\<\
A bare nested list is not an array object, though Hypermatrix promotes one to \
an ArrayObject.\
\>", "Notes",ExpressionUUID->"1dc87424-8b7b-1f41-8700-668f13a287df"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"1660de2a-c1cd-124a-aedc-926de41c8f51"],

Cell["\<\
{ArrayObjectQ @ ArrayObject[{1, 2}], ArrayObjectQ @ GenerateSymbolicArray[a, \
{2}],
 ArrayObjectQ[{1, 2}], ArrayObjectQ[5]}\
\>", "Input",ExpressionUUID->"274b4745-8b84-c644-80d4-4e2a5ec32548"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "False", ",", "False"}], "}"}]], "Output",\
ExpressionUUID->"15a809c4-9a11-d542-a63b-806523b65a09"],

Cell["Source", "NotesSection",ExpressionUUID->"037c5a50-8ec4-6a47-bed1-9a01339bb5a7"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Array accessors",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"7c51da56-bb67-a846-a257-83d99febcfba"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"4dcdebd2-7bfe-3a46-8b41-653db489edbf"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayObject", "InlineCode"]], "InlineFormula",ExpressionUUID->
