Notebook[{
Cell["ArrayOrder", "ObjectName",ExpressionUUID->"7653499f-2949-4c48-a045-53658568a0f3"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayOrder", "[", "arr", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"87b299fe-9c1d-6f48-a541-5d918edf2c39"],
 " ",
 "gives the number of indices of arr."
}], "Usage",ExpressionUUID->"5e2886b5-3abb-fd42-b05e-262ee53b398f"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"e22a96dc-ac93-aa4a-9e30-d0155c24a2be"],

Cell["\<\
An array of order n is also called an n-array. A component vector is a \
1-array and a matrix is a 2-array.\
\>", "Notes",ExpressionUUID->"d69a4f7b-133a-3b4f-980a-d42b340251c4"],

Cell["\<\
A scalar is the 0-array: it has no indices, and its list of dimensions is \
empty.\
\>", "Notes",ExpressionUUID->"2c8218a4-f511-c04d-9e74-f4651d156e4b"],

Cell["The order is the length of ArrayDimensions[arr].", "Notes",ExpressionUUID->"180c3b25-6546-994f-abfe-655575f53fd3"],

Cell["\<\
It is the first criterion by which a Hypermatrix orders its arrays.\
\>", "Notes",ExpressionUUID->"bb459484-7f96-ba48-a603-3d9bf7cf5ba8"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"ca4dc367-e533-1249-99db-31b947c9b41a"],

Cell["\<\
ArrayOrder @ NumericalArray[#] & /@ {5, {1, 2, 3}, {{1, 2}, {3, 4}}, Array[1 \
&, {2, 2, 2}]}\
\>", "Input",ExpressionUUID->"a2d6a86b-dfeb-1442-bb92-b8468edec66b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "1", ",", "2", ",", "3"}], "}"}]], "Output",ExpressionUUID\
->"5ac82d9c-10f9-ca46-a821-24e9d09ed54a"],

Cell["Also available as a property, and for a whole hypermatrix:", \
"ExampleText",ExpressionUUID->"ab5eecde-0be0-2c49-b1bc-7aa3cd165eef"],

Cell["\<\
{NumericalArray[{{1, 2}, {3, 4}}][\"Order\"],
 Hypermatrix[{{1, 2}, {{1, 2}, {3, 4}}}][\"Orders\"]}\
\>", "Input",ExpressionUUID->"6010f529-5aa2-e24b-bbfd-f616474c8a30"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"4f53cd68-4dc9-894e-85bc-debffc1a2eac"],

Cell["Source", "NotesSection",ExpressionUUID->"33ec1630-2533-ec4c-9bf4-b846436514e6"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Array accessors",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"fb358cab-5c71-084a-a927-4c76602186da"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"0e23682d-bec5-f440-b098-dec3ea97b7a5"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayDimensions", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "06154938-ee32-8444-a1a2-7e61836d815d"],
 ", ",
 Cell[BoxData[
  StyleBox["ArraySymmetry", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "16180db3-881d-8c48-9a66-e56e1f2b5993"],
 ", ",
 Cell[BoxData[
  StyleBox["NumericalArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "2941fdaf-8c2c-4341-a935-906826891917"],
 ", ",
 Cell[BoxData[
  StyleBox["SymbolicArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "74046f8f-0afb-9347-8eed-d2bd48c38b74"],
 ", ",
 Cell[BoxData[
  StyleBox["Hypermatrix", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "d5538570-dc8f-e841-8b4a-86c6a96d38a6"]
}], "SeeAlso",ExpressionUUID->"6d210ab6-b9b7-534b-a3a4-c134389182b9"]
},
