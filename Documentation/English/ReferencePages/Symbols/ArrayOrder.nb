Notebook[{
Cell["ArrayOrder", "ObjectName",ExpressionUUID->"3fe42162-f07b-354e-a2ff-d9da26228e9a"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayOrder", "[", "arr", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"b1b991b8-63c3-7b47-ab20-3779353cc412"],
 " ",
 "gives the number of indices of arr."
}], "Usage",ExpressionUUID->"c8dce71e-7a9d-9a49-b45a-b107f4da177e"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"e4f5121d-f499-3d47-a1ba-350265e7bf58"],

Cell["\<\
An array of order n is also called an n-array. A component vector is a \
1-array and a matrix is a 2-array.\
\>", "Notes",ExpressionUUID->"08bc4201-2ddb-684b-870e-233d84912de5"],

Cell["\<\
A scalar is the 0-array: it has no indices, and its list of dimensions is \
empty.\
\>", "Notes",ExpressionUUID->"2fffb25c-d1ff-4d4c-8970-495956ec854f"],

Cell["The order is the length of ArrayDimensions[arr].", "Notes",ExpressionUUID->"eb2f6470-c225-9a4b-9c54-cbb980b3dedf"],

Cell["\<\
It is the first criterion by which a Hypermatrix orders its arrays.\
\>", "Notes",ExpressionUUID->"a4507d44-c41b-2242-b785-9fe025d1b832"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"39778f97-a5cb-1d4e-87b4-ebc52e55b8c5"],

Cell["\<\
ArrayOrder @ ArrayObject[#] & /@ {5, {1, 2, 3}, {{1, 2}, {3, 4}}, Array[1 &, \
{2, 2, 2}]}\
\>", "Input",ExpressionUUID->"44c21333-a8f6-e047-9756-8c2aeb5495b6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "1", ",", "2", ",", "3"}], "}"}]], "Output",ExpressionUUID\
->"81902483-9728-3e44-9fb6-ef219a0167af"],

Cell["Also available as a property, and for a whole hypermatrix:", \
"ExampleText",ExpressionUUID->"29898a62-4cab-e74f-93bc-767166c9df55"],

Cell["\<\
{ArrayObject[{{1, 2}, {3, 4}}][\"Order\"],
 Hypermatrix[{{1, 2}, {{1, 2}, {3, 4}}}][\"Orders\"]}\
\>", "Input",ExpressionUUID->"42ec5e68-2899-1547-8b42-8c72fbbd7104"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"6dce4d12-d39c-c44b-aef4-b2bd2813e54f"],

Cell["Source", "NotesSection",ExpressionUUID->"37e73950-16ae-1040-8d47-1588eb97ba2e"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Array accessors",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"2818e960-5417-c54a-b23d-114cfc7112b9"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"bd4798ed-654a-3341-8944-32f6bcdc2c56"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayDimensions", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "d43b01b2-2140-cb4b-8521-a9fd9cfcf0cd"],
 ", ",
 Cell[BoxData[
  StyleBox["ArraySymmetry", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "5bceae84-1114-174e-86b7-be09d94b78fc"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayObject", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "dc195605-99bf-f745-82ee-e907d93e5168"],
 ", ",
 Cell[BoxData[
  StyleBox["GenerateSymbolicArray", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"c6d0738e-b460-2740-953d-1fc250647e74"],
 ", ",
 Cell[BoxData[
  StyleBox["Hypermatrix", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "6f3f5ba2-a958-c947-adca-28e5a9cf333e"]
}], "SeeAlso",ExpressionUUID->"8d64709b-8a20-d34c-b3ee-c736c89dda28"]
},
