Notebook[{
Cell["ArrayOrder", "ObjectName",ExpressionUUID->"99e191c3-787d-0148-9ec6-cfddd5d09378"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayOrder", "[", "arr", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"1ba50916-ad31-5341-b379-4026da580b95"],
 " ",
 "gives the number of indices of arr."
}], "Usage",ExpressionUUID->"c1872c0f-0564-3642-9d5c-1bf24d79decb"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"e2e14ae7-3cdb-f84c-99ee-be2550ab540b"],

Cell["\<\
An array of order n is also called an n-array. A component vector is a \
1-array and a matrix is a 2-array.\
\>", "Notes",ExpressionUUID->"943cbcb7-1316-d946-b323-f963f94914bc"],

Cell["\<\
A scalar is the 0-array: it has no indices, and its list of dimensions is \
empty.\
\>", "Notes",ExpressionUUID->"6f1b1c43-3a06-1841-8165-e12025a2b50c"],

Cell["The order is the length of ArrayDimensions[arr].", "Notes",ExpressionUUID->"21794c2b-557d-ae46-ac66-96fa8d2d99fd"],

Cell["\<\
It is the first criterion by which a Hypermatrix orders its arrays.\
\>", "Notes",ExpressionUUID->"b51ede4f-3efc-5644-8886-4b4df93bdfe6"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"2485c4c9-c19e-cb45-8801-4f51e5f51fff"],

Cell["\<\
ArrayOrder @ ArrayObject[#] & /@ {5, {1, 2, 3}, {{1, 2}, {3, 4}}, Array[1 &, \
{2, 2, 2}]}\
\>", "Input",ExpressionUUID->"61dc2f5b-9b66-334e-bf0d-05ec1106ce4d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "1", ",", "2", ",", "3"}], "}"}]], "Output",ExpressionUUID\
->"b011e134-716b-f040-9e1d-5475ea564c8e"],

Cell["Also available as a property, and for a whole hypermatrix:", \
"ExampleText",ExpressionUUID->"1aebb895-a696-e648-9837-011ce37578c2"],

Cell["\<\
{ArrayObject[{{1, 2}, {3, 4}}][\"Order\"],
 Hypermatrix[{{1, 2}, {{1, 2}, {3, 4}}}][\"Orders\"]}\
\>", "Input",ExpressionUUID->"174d24c8-a5c7-8548-a0ed-7bbb78e2d811"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"80d16af1-4a1c-534a-b298-c71048964bde"],

Cell["Source", "NotesSection",ExpressionUUID->"99a7480f-1a38-6a44-8a00-374a88af840d"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Array accessors",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"05317fe8-a83f-c34a-9733-40524c60c1d3"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"54798b64-7e8c-6047-a09d-df00b4e3f5ed"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayDimensions", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "0c9e7c51-c83f-8b46-96bb-58aa26090357"],
 ", ",
 Cell[BoxData[
  StyleBox["ArraySymmetry", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "47692d8e-21ee-6541-a65c-d14a8d792be1"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayObject", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "1a3271c8-5a76-c548-acd6-f49c37d40c15"],
 ", ",
 Cell[BoxData[
  StyleBox["GenerateSymbolicArray", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"2bacbfdc-d9da-444d-8877-8e05d6a4084b"],
 ", ",
 Cell[BoxData[
  StyleBox["Hypermatrix", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "9ea9f3fb-e016-5b4b-9b68-37a92769d4f7"]
}], "SeeAlso",ExpressionUUID->"2fa90b48-34b6-ac40-b3e5-607a232fb870"]
