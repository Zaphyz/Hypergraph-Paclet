Notebook[{
Cell["ArrayOrder", "ObjectName",ExpressionUUID->"607b8a8b-e940-0041-bd34-c6c6b05598cd"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayOrder", "[", "arr", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"718b7300-de39-3d4a-bd21-d21b192e8734"],
 " ",
 "gives the number of indices of arr."
}], "Usage",ExpressionUUID->"6fed18ef-86b4-f046-b763-3feea865cf7b"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"a08ca427-10a1-6242-8f17-45431d8524bd"],

Cell["\<\
An array of order n is also called an n-array. A component vector is a \
1-array and a matrix is a 2-array.\
\>", "Notes",ExpressionUUID->"68b97ccf-9c9c-5f41-afc8-3bdbda4b8934"],

Cell["\<\
A scalar is the 0-array: it has no indices, and its list of dimensions is \
empty.\
\>", "Notes",ExpressionUUID->"2424d72c-17fa-1b41-915b-e46b71c7e80b"],

Cell["The order is the length of ArrayDimensions[arr].", "Notes",ExpressionUUID->"3ebd36ab-00e2-a648-b018-bdcf65d0ba92"],

Cell["\<\
It is the first criterion by which a Hypermatrix orders its arrays.\
\>", "Notes",ExpressionUUID->"a718be9d-2ac0-824f-a43b-168608ce292a"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"2dc10e88-789c-e140-b39d-2808a55a7608"],

Cell["\<\
ArrayOrder @ ArrayObject[#] & /@ {5, {1, 2, 3}, {{1, 2}, {3, 4}}, Array[1 &, \
{2, 2, 2}]}\
\>", "Input",ExpressionUUID->"6f43aaf7-8f32-8a42-8aa2-b1f96437e460"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "1", ",", "2", ",", "3"}], "}"}]], "Output",ExpressionUUID\
->"4eb27ae8-2e25-c542-b3bb-3ec306d05cdc"],

Cell["Also available as a property, and for a whole hypermatrix:", \
"ExampleText",ExpressionUUID->"4c9416d1-256f-0947-9e5f-b58200f8522d"],

Cell["\<\
{ArrayObject[{{1, 2}, {3, 4}}][\"Order\"],
 Hypermatrix[{{1, 2}, {{1, 2}, {3, 4}}}][\"Orders\"]}\
\>", "Input",ExpressionUUID->"f10b0853-d707-bf4f-a441-c85ce5f36c68"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"984e324f-71e1-1b4c-9147-30bc6240a579"],

Cell["Source", "NotesSection",ExpressionUUID->"44bb87a5-db41-ce45-adc2-b3591045e2b7"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Array accessors",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"f8a8f54e-b60c-a84d-a33a-59e1d05b6ee8"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"e10da0d3-772d-2b4d-8842-e05747b3b5a0"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayDimensions", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "3f606333-6794-1044-a284-34830a478189"],
 ", ",
 Cell[BoxData[
  StyleBox["ArraySymmetry", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "e6e96c3f-007d-9948-a622-bd9c625c67cc"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayObject", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "a2a38af6-379e-9b49-bf4f-74775cb6ac08"],
 ", ",
 Cell[BoxData[
  StyleBox["GenerateSymbolicArray", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"42241e86-3456-e243-a1bf-f9443856140e"],
 ", ",
 Cell[BoxData[
  StyleBox["Hypermatrix", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "84337b9d-1268-b34d-9cde-ede438480977"]
}], "SeeAlso",ExpressionUUID->"7ee21f29-b8e8-8d4a-bc1a-002b94696b0d"]
},
