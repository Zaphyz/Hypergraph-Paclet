Notebook[{
Cell["ArrayOrder", "ObjectName",ExpressionUUID->"e8d5c8f2-42ac-034c-8698-2af7b9b27eb4"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayOrder", "[", "arr", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"5c42d146-7ded-9148-b6ed-c6cf2eb7a677"],
 " ",
 "gives the number of indices of arr."
}], "Usage",ExpressionUUID->"a8c2c4ea-9854-1941-a7c1-ee349f1991d1"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"9a49bc13-d4a1-b247-a517-07faee192809"],

Cell["\<\
An array of order n is also called an n-array. A component vector is a \
1-array and a matrix is a 2-array.\
\>", "Notes",ExpressionUUID->"ccf4c6ec-4cb3-754d-aa63-8ba4f08a9216"],

Cell["\<\
A scalar is the 0-array: it has no indices, and its list of dimensions is \
empty.\
\>", "Notes",ExpressionUUID->"25fd30fb-3da0-4642-8b90-6af35df461d2"],

Cell["The order is the length of ArrayDimensions[arr].", "Notes",ExpressionUUID->"c3bab932-2804-b441-8f82-b4eac513ade2"],

Cell["\<\
It is the first criterion by which a Hypermatrix orders its arrays.\
\>", "Notes",ExpressionUUID->"b63f86f2-45ba-834c-b360-febed59c5cd1"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"6f348c30-6443-4a4e-9778-a9b753f3ba0d"],

Cell["\<\
ArrayOrder @ ArrayObject[#] & /@ {5, {1, 2, 3}, {{1, 2}, {3, 4}}, Array[1 &, \
{2, 2, 2}]}\
\>", "Input",ExpressionUUID->"20403a27-a991-2648-ac58-583b1de6b180"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "1", ",", "2", ",", "3"}], "}"}]], "Output",ExpressionUUID\
->"0c6b25d7-0f01-1049-8947-a2e86d0a33e2"],

Cell["Also available as a property, and for a whole hypermatrix:", \
"ExampleText",ExpressionUUID->"25f42afb-a87e-e346-a2d3-8fba51fad3a3"],

Cell["\<\
{ArrayObject[{{1, 2}, {3, 4}}][\"Order\"],
 Hypermatrix[{{1, 2}, {{1, 2}, {3, 4}}}][\"Orders\"]}\
\>", "Input",ExpressionUUID->"c06d255d-99da-974a-a2de-b0a6919bb35b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"e29f482b-f977-bd46-b7a9-47d6baeeeb22"],

Cell["Source", "NotesSection",ExpressionUUID->"04affaf7-d2c1-9040-9e18-2014c8263012"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Array accessors",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"de23f579-55d9-f94c-a64c-b9f7b3fbed2c"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"cd404ee9-eaa5-c144-ae69-841c87170fc8"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayDimensions", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "472f92cf-dbcc-7547-8105-3a33a01d1256"],
