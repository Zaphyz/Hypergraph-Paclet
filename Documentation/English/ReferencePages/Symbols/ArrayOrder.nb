Notebook[{
Cell["ArrayOrder", "ObjectName",ExpressionUUID->"6fe93469-5433-a34a-a9c6-035d2318333f"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayOrder", "[", "arr", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"f9e1e63e-464d-eb42-b5c2-ff30431346cf"],
 " ",
 "gives the number of indices of arr."
}], "Usage",ExpressionUUID->"99f1c076-1dea-0941-971f-19cd149ab20b"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"78f3baad-a63d-914f-8400-d59d5faae26a"],

Cell["\<\
An array of order n is also called an n-array. A component vector is a \
1-array and a matrix is a 2-array.\
\>", "Notes",ExpressionUUID->"ee461fdc-5589-c040-b641-afd1455c42f4"],

Cell["\<\
A scalar is the 0-array: it has no indices, and its list of dimensions is \
empty.\
\>", "Notes",ExpressionUUID->"4ecf0dff-60c1-204b-b85e-ba12ffe820da"],

Cell["The order is the length of ArrayDimensions[arr].", "Notes",ExpressionUUID->"f0f34132-e871-7145-8b7f-39aafcb36ba8"],

Cell["\<\
It is the first criterion by which a Hypermatrix orders its arrays.\
\>", "Notes",ExpressionUUID->"23becab4-8bd5-454a-ae3e-0f79c9bd5248"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"8041cd2c-660b-664c-8a3a-6f2bbc91fccd"],

Cell["\<\
ArrayOrder @ ArrayObject[#] & /@ {5, {1, 2, 3}, {{1, 2}, {3, 4}}, Array[1 &, \
{2, 2, 2}]}\
\>", "Input",ExpressionUUID->"2790c46a-4478-2442-8679-ca8257a0084e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "1", ",", "2", ",", "3"}], "}"}]], "Output",ExpressionUUID\
->"b23b1425-f83f-1c40-9465-22206f196cf2"],

Cell["Also available as a property, and for a whole hypermatrix:", \
"ExampleText",ExpressionUUID->"83f9dc46-04fc-524c-812e-079978c7bc29"],

Cell["\<\
{ArrayObject[{{1, 2}, {3, 4}}][\"Order\"],
 Hypermatrix[{{1, 2}, {{1, 2}, {3, 4}}}][\"Orders\"]}\
\>", "Input",ExpressionUUID->"37cd3f50-d1be-d041-bf95-636b4a7a917d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"174def4d-c524-3a4b-8327-37e82a6136bc"],

Cell["Source", "NotesSection",ExpressionUUID->"028f6df0-ba51-a646-b08f-4053b7a48164"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Array accessors",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"ebd187f3-31c5-e446-b635-ec1e64e6c5f3"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"01946705-a482-0a48-a737-c1499de0fcdb"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayDimensions", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "afe153a4-883a-144f-a861-fface3284bba"],
 ", ",
 Cell[BoxData[
  StyleBox["ArraySymmetry", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "6535ce84-eaa3-9742-b9de-c281a5c152df"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayObject", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "9d7857bc-70f3-db43-8f91-bf4aca97ac32"],
 ", ",
 Cell[BoxData[
  StyleBox["GenerateSymbolicArray", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"cd7e6875-777c-184c-b814-73950a919294"],
 ", ",
 Cell[BoxData[
  StyleBox["Hypermatrix", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "e275573f-281a-404d-9c6c-6559731db1d8"]
}], "SeeAlso",ExpressionUUID->"d3e0a90d-eef2-654a-9519-b61de9eeb958"]
},
