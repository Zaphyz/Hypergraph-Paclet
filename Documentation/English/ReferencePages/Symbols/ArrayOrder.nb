Notebook[{
Cell["ArrayOrder", "ObjectName",ExpressionUUID->"aeb8ec39-94bb-f449-9dc3-dab4f1d3ee3d"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayOrder", "[", "arr", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"4574aa05-3082-bf41-a9f8-26dd227d5984"],
 " ",
 "gives the number of indices of arr."
}], "Usage",ExpressionUUID->"1c33f616-7598-8046-a2db-88c6be4391ac"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"6becbd3c-55f0-d049-93d0-73153df81bf1"],

Cell["\<\
An array of order n is also called an n-array. A component vector is a \
1-array and a matrix is a 2-array.\
\>", "Notes",ExpressionUUID->"969de64c-0b4c-1341-a98a-29e58b8ad4cd"],

Cell["\<\
A scalar is the 0-array: it has no indices, and its list of dimensions is \
empty.\
\>", "Notes",ExpressionUUID->"f44fb131-bfab-f44e-9faa-fbcf947275c9"],

Cell["The order is the length of ArrayDimensions[arr].", "Notes",ExpressionUUID->"18a2589e-5bb0-9747-9ae8-ecd47cd44485"],

Cell["\<\
It is the first criterion by which a Hypermatrix orders its arrays.\
\>", "Notes",ExpressionUUID->"4982878c-3f6e-6643-92db-c36cc10c86c8"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"0c8def90-7627-6c4f-818f-3f6a1b9c1b91"],

Cell["\<\
ArrayOrder @ ArrayObject[#] & /@ {5, {1, 2, 3}, {{1, 2}, {3, 4}}, Array[1 &, \
{2, 2, 2}]}\
\>", "Input",ExpressionUUID->"20939915-2383-6c41-bc64-4e2df1be3281"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "1", ",", "2", ",", "3"}], "}"}]], "Output",ExpressionUUID\
->"d1d10461-e8c4-bb4f-84ad-879b9d9ab09e"],

Cell["Also available as a property, and for a whole hypermatrix:", \
"ExampleText",ExpressionUUID->"3c92d9df-fa3d-874c-a0b5-91afbd8bd6f8"],

Cell["\<\
{ArrayObject[{{1, 2}, {3, 4}}][\"Order\"],
 Hypermatrix[{{1, 2}, {{1, 2}, {3, 4}}}][\"Orders\"]}\
\>", "Input",ExpressionUUID->"9257c511-682b-c647-a8d5-265938cc8e08"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"c56375a6-dce6-e34e-94d3-3086d4991fbe"],

Cell["Source", "NotesSection",ExpressionUUID->"0611e7a2-b737-594f-a397-7084ff0303fb"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Array accessors",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"e7bf5cd5-5674-f344-b5da-56b7c6057e8d"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"2dfba71d-a93f-e04c-b54f-b90fbaae572f"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayDimensions", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "ee7c1210-f7f5-c44e-8299-96eeb49e9d39"],
 ", ",
