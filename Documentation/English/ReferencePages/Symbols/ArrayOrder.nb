Notebook[{
Cell["ArrayOrder", "ObjectName",ExpressionUUID->"a666babc-86c2-dd47-aa6e-c93f70f8af88"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayOrder", "[", "arr", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"28b591c9-0aca-6e40-a885-563dfd2e19dd"],
 " ",
 "gives the number of indices of arr."
}], "Usage",ExpressionUUID->"88a5c064-5a88-e94b-8558-0a0da391ea8a"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"d749009b-6051-8449-9165-98909dee1d8f"],

Cell["\<\
An array of order n is also called an n-array. A component vector is a \
1-array and a matrix is a 2-array.\
\>", "Notes",ExpressionUUID->"68047855-179e-884d-a678-010acdda49b1"],

Cell["\<\
A scalar is the 0-array: it has no indices, and its list of dimensions is \
empty.\
\>", "Notes",ExpressionUUID->"0d6dc99d-ea33-474b-957a-838a05248130"],

Cell["The order is the length of ArrayDimensions[arr].", "Notes",ExpressionUUID->"4f17ca90-b27e-c24e-a0ac-99ee113a9179"],

Cell["\<\
It is the first criterion by which a Hypermatrix orders its arrays.\
\>", "Notes",ExpressionUUID->"e55040ef-0f79-6a4a-8e6b-2fdf7912bc25"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"d1fb7f4a-1449-7841-ba40-b7be768c0f4f"],

Cell["\<\
ArrayOrder @ ArrayObject[#] & /@ {5, {1, 2, 3}, {{1, 2}, {3, 4}}, Array[1 &, \
{2, 2, 2}]}\
\>", "Input",ExpressionUUID->"bafb1bb7-0e4f-3948-ae79-a541ad138408"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "1", ",", "2", ",", "3"}], "}"}]], "Output",ExpressionUUID\
->"3d86fc52-3120-864a-b421-a4869ef919af"],

Cell["Also available as a property, and for a whole hypermatrix:", \
"ExampleText",ExpressionUUID->"003b140b-382b-1346-a4cc-a1dabc8a6a18"],

Cell["\<\
{ArrayObject[{{1, 2}, {3, 4}}][\"Order\"],
 Hypermatrix[{{1, 2}, {{1, 2}, {3, 4}}}][\"Orders\"]}\
\>", "Input",ExpressionUUID->"173de1c4-5dc0-d847-a566-b8904d5315cc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"4c66c089-e5ab-4d46-86ad-1badd1355cca"],

Cell["Source", "NotesSection",ExpressionUUID->"58ae6d75-0ddd-e644-a99d-a67bf7098969"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Array accessors",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"3aeccf4a-3c17-9a49-9c87-46640b9c6fcf"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"8056884a-f599-7a43-ae6b-1e19932f8ac4"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayDimensions", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "ff9f6389-a846-8c4c-b980-c68758f0e0b2"],
 ", ",
 Cell[BoxData[
  StyleBox["ArraySymmetry", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "36efeb3c-66d1-7b48-a020-d34c6ed1cae4"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayObject", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "7499ea20-9e0f-d249-8ee9-bfe46676c79c"],
 ", ",
 Cell[BoxData[
  StyleBox["GenerateSymbolicArray", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"271a9300-e8a1-3d4b-a219-46ec4857d288"],
 ", ",
 Cell[BoxData[
  StyleBox["Hypermatrix", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "1ae46637-7c02-1a4d-b019-75b70d41b93f"]
}], "SeeAlso",ExpressionUUID->"7a39b4f6-7259-4e4c-b9b9-e7ad1f610e9b"]
