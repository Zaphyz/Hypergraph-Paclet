Notebook[{
Cell["ArrayOrder", "ObjectName",ExpressionUUID->"133ebc23-cbbc-474e-be5c-1ab6abc4e159"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayOrder", "[", "arr", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"f14b26ea-948b-9e47-8ded-650d3572c63f"],
 " ",
 "gives the number of indices of arr."
}], "Usage",ExpressionUUID->"1b311a86-f4a2-3548-8fe4-d7696b086391"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"31e4a149-f591-7845-87d6-006817eae416"],

Cell["\<\
An array of order n is also called an n-array. A component vector is a \
1-array and a matrix is a 2-array.\
\>", "Notes",ExpressionUUID->"0736ad10-5d61-b04f-8464-07bea3c3e232"],

Cell["\<\
A scalar is the 0-array: it has no indices, and its list of dimensions is \
empty.\
\>", "Notes",ExpressionUUID->"01ac9cc7-e296-de46-996f-046a1d9393f4"],

Cell["The order is the length of ArrayDimensions[arr].", "Notes",ExpressionUUID->"1c0ddbe1-40f2-6d43-8a54-8464c371b3af"],

Cell["\<\
It is the first criterion by which a Hypermatrix orders its arrays.\
\>", "Notes",ExpressionUUID->"5d6ea924-a7d8-a74a-bfde-d5bb7ff4dbdc"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"4e6b8668-13b6-514c-a6bc-49d9723e27e3"],

Cell["\<\
ArrayOrder @ ArrayObject[#] & /@ {5, {1, 2, 3}, {{1, 2}, {3, 4}}, Array[1 &, \
{2, 2, 2}]}\
\>", "Input",ExpressionUUID->"1fdfd8d6-ca0d-694b-b94d-64b7d9c4e746"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "1", ",", "2", ",", "3"}], "}"}]], "Output",ExpressionUUID\
->"6441b8e2-da33-2a4e-b913-600effc2525b"],

Cell["Also available as a property, and for a whole hypermatrix:", \
"ExampleText",ExpressionUUID->"4dd0cff9-abb1-8e40-b55a-71285355504a"],

Cell["\<\
{ArrayObject[{{1, 2}, {3, 4}}][\"Order\"],
 Hypermatrix[{{1, 2}, {{1, 2}, {3, 4}}}][\"Orders\"]}\
\>", "Input",ExpressionUUID->"08f1d393-f0b8-3c46-b76a-75e624669232"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"aec60d7c-9216-f84b-b2d3-c96e217e1d99"],

Cell["Source", "NotesSection",ExpressionUUID->"b37007f8-d9a2-334d-bddf-b160259b0489"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Array accessors",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"97e3f08b-b0c7-6c45-920f-884f03111241"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"fbd6f1d0-4934-4e4c-9c02-c6bdd3e8ecf4"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayDimensions", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "e8476675-4706-6a48-845a-2f6a45860aef"],
 ", ",
 Cell[BoxData[
  StyleBox["ArraySymmetry", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "85211a05-d259-b74a-b774-e5dbb5b1d091"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayObject", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "e6442311-63c0-e141-9e5e-7b4c51418d90"],
 ", ",
 Cell[BoxData[
  StyleBox["GenerateSymbolicArray", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"33492388-5d06-1640-b4f9-02a16c414b6a"],
 ", ",
 Cell[BoxData[
  StyleBox["Hypermatrix", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "58128a8a-a4a9-1743-a493-19394dcd8c9b"]
}], "SeeAlso",ExpressionUUID->"c2feb442-bb80-1745-a206-cf0a2ef9fce5"]
