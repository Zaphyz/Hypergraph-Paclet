Notebook[{
Cell["ArraySymmetry", "ObjectName",ExpressionUUID->"0199aa94-fb2e-b246-86c0-7c2c2bfb2686"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArraySymmetry", "[", "arr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"f8e9751f-c9af-4c42-98e6-e02816ca3daf"],
 " ",
 "gives the declared index symmetry of arr."
}], "Usage",ExpressionUUID->"3650397b-e721-4940-8570-5f419620360f"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"ac48b166-2f76-7244-92d4-40dc8cbd080c"],

Cell["\<\
The result is one of \"Rigid\", meaning no symmetry is claimed; \"Cyclic\", \
meaning the entries are invariant under cyclic permutation of the indices; or \
\"Symmetric\", meaning they are invariant under all permutations.\
\>", "Notes",ExpressionUUID->"6a195826-0bd5-3746-a5e9-26a648157715"],

Cell["\<\
Only a regular array can carry a symmetry other than \"Rigid\".\
\>", "Notes",ExpressionUUID->"8cd7dbb7-83b6-e347-b48b-ac5508dc465c"],

Cell[TextData[{
 "The symmetry is the one thing an array is told rather than asked: \
ArraySymmetry reports what was declared, and the declaration is verified \
against the entries when the array is built. ",
 Cell[BoxData[
  StyleBox["GenerateSymbolicArray", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"d863140d-7a5c-7c49-9fe9-2480b6385965"],
 " builds entries that honour it by construction, equivalent index tuples \
naming the same entry, so there is nothing for the check to catch."
}], "Notes",ExpressionUUID->"1a462e1b-069f-4140-9f38-dff071a5b33e"],

Cell["\<\
A symmetric array is also cyclic, so the same entries may be declared either \
way. At order two the cyclic group is the symmetric group and the two \
coincide exactly.\
\>", "Notes",ExpressionUUID->"d16ce92f-24cb-044e-b5e8-424d9a60a216"],

Cell["\<\
Symmetry is the third criterion by which a Hypermatrix orders its arrays, \
taking \"Symmetric\" before \"Cyclic\" before \"Rigid\".\
\>", "Notes",ExpressionUUID->"6bae848c-52eb-554a-b32b-b84fc76a60fc"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"4299fd6a-8b86-6449-98b8-1e3a8e5cf5a0"],

Cell["\<\
ArraySymmetry @ ArrayObject[{{1, 2}, {2, 1}}, #] & /@ {\"Rigid\", \"Cyclic\", \
\"Symmetric\"}\
\>", "Input",ExpressionUUID->"f6cf951a-4ce5-c842-998c-c08a1f196f64"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Rigid\"\>", ",", "\<\"Cyclic\"\>", ",", "\<\"Symmetric\"\>"}], 
  "}"}]], "Output",ExpressionUUID->"23898f02-8484-bc42-9d6a-d45aeec8187f"],

Cell["\<\
The entries of the cyclic orbit of (1, 2, 3) are invariant under rotation but \
not under reflection, so they are cyclic and not symmetric:\
\>", "ExampleText",ExpressionUUID->"5be31e8c-9b4d-0b48-a9b7-d3c36f8e4ca4"],

Cell["\<\
cyc = Array[If[MemberQ[{{1, 2, 3}, {2, 3, 1}, {3, 1, 2}}, {##}], 1, 0] &, {3, \
3, 3}];
{ArraySymmetry @ ArrayObject[cyc, \"Cyclic\"],
 Quiet @ ArrayObject[cyc, \"Symmetric\"]}\
\>", "Input",ExpressionUUID->"5fad6e6b-b996-254c-a31b-108c69db76a6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Cyclic\"\>", ",", "$Failed"}], "}"}]], "Output",ExpressionUUID->\
"f062493c-bd4f-7d48-b223-8a39bf29182c"],

Cell["Source", "NotesSection",ExpressionUUID->"3078797d-d674-e54e-aafc-6e06e79768fe"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Array accessors",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"1d43d356-02cd-8d48-a630-c7d087e16bb6"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"63126a25-a5fe-6142-b51b-028f36385912"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayOrder", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "8300fa34-f9d2-fd4a-b783-66936b25930e"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayDimensions", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "2828d150-2db8-8f49-942f-8a6766972c92"],
 ", ",
 Cell[BoxData[
  StyleBox["RegularArrayQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "466dda5f-ea5f-2c4b-b1c7-2c207da89289"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayObject", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "0820a4a2-1f74-e14c-bf21-1050dea9ede6"],
 ", ",
 Cell[BoxData[
  StyleBox["GenerateSymbolicArray", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"74668dec-5061-a445-a615-5b30805f6a76"],
 ", ",
 Cell[BoxData[
  StyleBox["Hypermatrix", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "89e5286a-972f-0443-af73-aadcae014112"]
}], "SeeAlso",ExpressionUUID->"ec5c1639-bf92-1f44-a368-a4e695e9df25"]
},
