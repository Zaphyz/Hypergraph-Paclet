Notebook[{
Cell["ArraySymmetry", "ObjectName",ExpressionUUID->"eb400755-672a-1644-9c29-08ef108238f5"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArraySymmetry", "[", "arr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"fc771ea0-84b0-9441-8f4b-2a113164f8e9"],
 " ",
 "gives the declared index symmetry of arr."
}], "Usage",ExpressionUUID->"88e9bdb7-38ff-dd4e-992e-47905dbd814f"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"3001e94c-90ee-f243-a786-f292d807464e"],

Cell["\<\
The result is one of \"Rigid\", meaning no symmetry is claimed; \"Cyclic\", \
meaning the entries are invariant under cyclic permutation of the indices; or \
\"Symmetric\", meaning they are invariant under all permutations.\
\>", "Notes",ExpressionUUID->"fe6d9e71-2b0a-104a-a058-1860ee34d518"],

Cell["\<\
Only a regular array can carry a symmetry other than \"Rigid\".\
\>", "Notes",ExpressionUUID->"9a7e90d3-0d26-8c4c-b362-76ac0104ce75"],

Cell[TextData[{
 "The symmetry is the one thing an array is told rather than asked: \
ArraySymmetry reports what was declared, and the declaration is verified \
against the entries when the array is built. ",
 Cell[BoxData[
  StyleBox["GenerateSymbolicArray", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"1bbf9f07-f6d6-5e43-a874-62343b243f13"],
 " builds entries that honour it by construction, equivalent index tuples \
naming the same entry, so there is nothing for the check to catch."
}], "Notes",ExpressionUUID->"42bd31cc-52a4-8949-afe1-30440187f6b0"],

Cell["\<\
A symmetric array is also cyclic, so the same entries may be declared either \
way. At order two the cyclic group is the symmetric group and the two \
coincide exactly.\
\>", "Notes",ExpressionUUID->"bcbe820e-5a26-a04d-b587-bf3b17052fbb"],

Cell["\<\
Symmetry is the third criterion by which a Hypermatrix orders its arrays, \
taking \"Symmetric\" before \"Cyclic\" before \"Rigid\".\
\>", "Notes",ExpressionUUID->"8cc020ee-ae6b-d948-9ab6-2ec72a8eb6b3"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"297a09b3-8f76-5c44-bdaa-e8c482f6ad84"],

Cell["\<\
ArraySymmetry @ ArrayObject[{{1, 2}, {2, 1}}, #] & /@ {\"Rigid\", \"Cyclic\", \
\"Symmetric\"}\
\>", "Input",ExpressionUUID->"1fe1ce7a-16a9-a949-bf97-091cba56859d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Rigid\"\>", ",", "\<\"Cyclic\"\>", ",", "\<\"Symmetric\"\>"}], 
  "}"}]], "Output",ExpressionUUID->"baf9dee9-b6df-6a48-ae05-e814dadc7cda"],

Cell["\<\
The entries of the cyclic orbit of (1, 2, 3) are invariant under rotation but \
not under reflection, so they are cyclic and not symmetric:\
\>", "ExampleText",ExpressionUUID->"dc28e383-595b-e440-8da9-3a496751ebeb"],

Cell["\<\
cyc = Array[If[MemberQ[{{1, 2, 3}, {2, 3, 1}, {3, 1, 2}}, {##}], 1, 0] &, {3, \
3, 3}];
{ArraySymmetry @ ArrayObject[cyc, \"Cyclic\"],
 Quiet @ ArrayObject[cyc, \"Symmetric\"]}\
\>", "Input",ExpressionUUID->"28d73a7b-54b9-da4d-8ce0-2970dab50ecf"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Cyclic\"\>", ",", "$Failed"}], "}"}]], "Output",ExpressionUUID->\
"0d13f28a-4630-8b42-9ace-e457701da06c"],

Cell["Source", "NotesSection",ExpressionUUID->"bf4f0dbe-6d4a-dc49-9d72-20583d34c704"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Array accessors",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"ab030a22-9faa-eb4f-9351-7a78242806fe"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"1e5bb211-c4a1-a84c-928d-e3bb05246e6f"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayOrder", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "cdd215f3-e7d5-5c44-a933-84386baefdf0"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayDimensions", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "42f5cfd2-414f-0846-b8ee-865017d1ac7b"],
 ", ",
 Cell[BoxData[
  StyleBox["RegularArrayQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "af6db567-0480-0845-935c-c2829ef0a1c9"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayObject", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "bfdc2a2b-8004-554e-91b5-f6161b48647f"],
 ", ",
 Cell[BoxData[
  StyleBox["GenerateSymbolicArray", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"f968e4a0-3c57-334c-baab-a130eb1c2de7"],
 ", ",
 Cell[BoxData[
  StyleBox["Hypermatrix", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "09e05197-3c97-e242-a05f-b4013a0f9c47"]
}], "SeeAlso",ExpressionUUID->"9203293f-368f-8a48-bd00-90c2fb48b056"]
},
