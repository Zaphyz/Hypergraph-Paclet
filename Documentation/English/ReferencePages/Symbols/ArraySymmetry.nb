Notebook[{
Cell["ArraySymmetry", "ObjectName",ExpressionUUID->"18027d79-1459-d64c-925a-f1ad339fa7c6"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArraySymmetry", "[", "arr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"8066c7d0-c689-184b-ad39-787ba292e1b1"],
 " ",
 "gives the declared index symmetry of arr."
}], "Usage",ExpressionUUID->"be3ed6bf-fa29-ad41-84cf-2b539aa1a539"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"82b667c6-667d-a74e-a1bb-0a71b3f647f4"],

Cell["\<\
The result is one of \"Rigid\", meaning no symmetry is claimed; \"Cyclic\", \
meaning the entries are invariant under cyclic permutation of the indices; or \
\"Symmetric\", meaning they are invariant under all permutations.\
\>", "Notes",ExpressionUUID->"61183aae-a6d4-c440-8aeb-ad22750ee026"],

Cell["\<\
Only a regular array can carry a symmetry other than \"Rigid\".\
\>", "Notes",ExpressionUUID->"fce0fd94-34be-334f-ae3c-bafa4f13ecbd"],

Cell[TextData[{
 "The symmetry is the one thing an array is told rather than asked: \
ArraySymmetry reports what was declared, and the declaration is verified \
against the entries when the array is built. ",
 Cell[BoxData[
  StyleBox["GenerateSymbolicArray", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"21f2fa72-5d2a-6b48-b093-8ef8723931dc"],
 " builds entries that honour it by construction, equivalent index tuples \
naming the same entry, so there is nothing for the check to catch."
}], "Notes",ExpressionUUID->"03b73211-720c-cd48-8310-108c7be0d9ea"],

Cell["\<\
A symmetric array is also cyclic, so the same entries may be declared either \
way. At order two the cyclic group is the symmetric group and the two \
coincide exactly.\
\>", "Notes",ExpressionUUID->"9118fb11-4759-4c42-83da-c0f2a1111524"],

Cell["\<\
Symmetry is the third criterion by which a Hypermatrix orders its arrays, \
taking \"Symmetric\" before \"Cyclic\" before \"Rigid\".\
\>", "Notes",ExpressionUUID->"d19f173c-bfb7-6549-aa62-cf235c9a3c69"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"7f3acac8-e411-5740-bb3b-b01455574614"],

Cell["\<\
ArraySymmetry @ ArrayObject[{{1, 2}, {2, 1}}, #] & /@ {\"Rigid\", \"Cyclic\", \
\"Symmetric\"}\
\>", "Input",ExpressionUUID->"f0b1b3ad-4ac6-3147-b707-cdbe81836de2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Rigid\"\>", ",", "\<\"Cyclic\"\>", ",", "\<\"Symmetric\"\>"}], 
  "}"}]], "Output",ExpressionUUID->"76ed0d18-624c-a145-a1e5-56c0fdf5f4c6"],

Cell["\<\
The entries of the cyclic orbit of (1, 2, 3) are invariant under rotation but \
not under reflection, so they are cyclic and not symmetric:\
\>", "ExampleText",ExpressionUUID->"1cd898b5-5ef1-ff42-b867-2aba5551b796"],

Cell["\<\
cyc = Array[If[MemberQ[{{1, 2, 3}, {2, 3, 1}, {3, 1, 2}}, {##}], 1, 0] &, {3, \
3, 3}];
{ArraySymmetry @ ArrayObject[cyc, \"Cyclic\"],
 Quiet @ ArrayObject[cyc, \"Symmetric\"]}\
\>", "Input",ExpressionUUID->"5b917681-a75c-f147-9c64-62b78bb28cbf"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Cyclic\"\>", ",", "$Failed"}], "}"}]], "Output",ExpressionUUID->\
"6b1a3a58-2d68-dc46-913c-205f53bb4d44"],

Cell["Source", "NotesSection",ExpressionUUID->"1b284854-5db3-f241-a12c-5dfdcb4cf3d3"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Array accessors",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"b0ae001d-9826-5d48-9e0f-2d864a912fae"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"59308f33-70fd-b747-b5e0-07ed1862fca9"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayOrder", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "7a4b1bb8-99ff-8040-8477-b0d9f50c4e25"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayDimensions", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "564acf04-7d9e-b142-af10-444d0216ee4b"],
 ", ",
 Cell[BoxData[
  StyleBox["RegularArrayQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "5e2610d6-3edd-0c4e-bf69-d8ccf1809208"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayObject", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "907d7898-cd19-114e-822e-d387a60b7f9a"],
 ", ",
 Cell[BoxData[
  StyleBox["GenerateSymbolicArray", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"5e547d61-2257-2b4b-a8a8-6c005634977d"],
 ", ",
 Cell[BoxData[
  StyleBox["Hypermatrix", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "f66201a0-cf74-bd4d-abe7-210a1c7d9faa"]
}], "SeeAlso",ExpressionUUID->"f48e8885-0bab-3e4d-9ba0-1be3e7fb8ad2"]
},
