Notebook[{
Cell["ArraySymmetry", "ObjectName",ExpressionUUID->"2a25a143-21f6-654d-aab4-2667e68ea420"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArraySymmetry", "[", "arr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"3031fdea-8921-c349-9f0b-5e35226ad83c"],
 " ",
 "gives the declared index symmetry of arr."
}], "Usage",ExpressionUUID->"b4189884-1e92-8346-9d54-b4d6e68f803b"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"66fe527f-ec6f-594f-89cd-bdd7d22ccd34"],

Cell["\<\
The result is one of \"Rigid\", meaning no symmetry is claimed; \"Cyclic\", \
meaning the entries are invariant under cyclic permutation of the indices; or \
\"Symmetric\", meaning they are invariant under all permutations.\
\>", "Notes",ExpressionUUID->"f2fcdc60-e41c-004e-b922-1e2ae6233e56"],

Cell["\<\
Only a regular array can carry a symmetry other than \"Rigid\".\
\>", "Notes",ExpressionUUID->"ad608f75-200c-d442-9192-86896296b8f1"],

Cell[TextData[{
 "The symmetry is the one thing an array is told rather than asked: \
ArraySymmetry reports what was declared, and the declaration is verified \
against the entries when the array is built. ",
 Cell[BoxData[
  StyleBox["GenerateSymbolicArray", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"b125dbc8-9dac-8341-aae0-c4000c408ffa"],
 " builds entries that honour it by construction, equivalent index tuples \
naming the same entry, so there is nothing for the check to catch."
}], "Notes",ExpressionUUID->"b438e570-6844-ef47-8bfe-45eddd5b7d4b"],

Cell["\<\
A symmetric array is also cyclic, so the same entries may be declared either \
way. At order two the cyclic group is the symmetric group and the two \
coincide exactly.\
\>", "Notes",ExpressionUUID->"be92f4d0-634f-114d-a90e-836eec3bb321"],

Cell["\<\
Symmetry is the third criterion by which a Hypermatrix orders its arrays, \
taking \"Symmetric\" before \"Cyclic\" before \"Rigid\".\
\>", "Notes",ExpressionUUID->"e3ff4f0d-20be-c642-b9bd-6b8a7f7e764d"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"494b6763-5ddc-2042-b151-588c9757b2f5"],

Cell["\<\
ArraySymmetry @ ArrayObject[{{1, 2}, {2, 1}}, #] & /@ {\"Rigid\", \"Cyclic\", \
\"Symmetric\"}\
\>", "Input",ExpressionUUID->"055ad0da-7daa-ec46-8070-97f5d031ce98"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Rigid\"\>", ",", "\<\"Cyclic\"\>", ",", "\<\"Symmetric\"\>"}], 
  "}"}]], "Output",ExpressionUUID->"cc09c95c-f16d-1a42-b0a1-7b8c6c94642e"],

Cell["\<\
The entries of the cyclic orbit of (1, 2, 3) are invariant under rotation but \
not under reflection, so they are cyclic and not symmetric:\
\>", "ExampleText",ExpressionUUID->"36ef043b-35bf-fd4d-8829-d748428e0eb5"],

Cell["\<\
cyc = Array[If[MemberQ[{{1, 2, 3}, {2, 3, 1}, {3, 1, 2}}, {##}], 1, 0] &, {3, \
3, 3}];
{ArraySymmetry @ ArrayObject[cyc, \"Cyclic\"],
 Quiet @ ArrayObject[cyc, \"Symmetric\"]}\
\>", "Input",ExpressionUUID->"5157c61f-bdc4-be43-948c-d6bafee6909f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Cyclic\"\>", ",", "$Failed"}], "}"}]], "Output",ExpressionUUID->\
"1fb64ea1-0286-8d42-988a-7cf9fcd896d2"],

Cell["Source", "NotesSection",ExpressionUUID->"ba8ed8c3-e3fb-0348-a0fd-75883a15630e"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Array accessors",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"a82e8c27-838f-9c4e-81bd-d06e6e2bddc5"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"90a17505-f747-a24e-9918-ca363dbb7d74"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayOrder", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "91124740-7a71-814a-a859-70cce7b95afb"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayDimensions", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "ad3d143b-371e-6844-8319-0f56f51d7293"],
 ", ",
 Cell[BoxData[
  StyleBox["RegularArrayQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "f96abef3-9e73-d94a-850d-63561785536a"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayObject", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "813fdc29-c18f-f142-afb6-1df5751a9024"],
 ", ",
 Cell[BoxData[
  StyleBox["GenerateSymbolicArray", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"65d2dff1-aae7-1048-ad01-221f95cb7383"],
 ", ",
 Cell[BoxData[
  StyleBox["Hypermatrix", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "4f4338d9-cf0b-174f-a333-dd108dbab3f5"]
}], "SeeAlso",ExpressionUUID->"736fd1e9-558f-ba41-9503-5d4a55884375"]
},
