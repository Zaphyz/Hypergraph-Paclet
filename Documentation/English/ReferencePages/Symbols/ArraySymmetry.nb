Notebook[{
Cell["ArraySymmetry", "ObjectName",ExpressionUUID->"1ce68b03-1636-1f45-a4b2-03db5aa8df0d"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArraySymmetry", "[", "arr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"9084fcf6-b912-2e43-ab70-2a0214f76afc"],
 " ",
 "gives the declared index symmetry of arr."
}], "Usage",ExpressionUUID->"dd662b14-e57a-2040-843d-47f7fce38a45"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"2d91427b-a4a0-7545-82f7-9ddac1a432a0"],

Cell["\<\
The result is one of \"Rigid\", meaning no symmetry is claimed; \"Cyclic\", \
meaning the entries are invariant under cyclic permutation of the indices; or \
\"Symmetric\", meaning they are invariant under all permutations.\
\>", "Notes",ExpressionUUID->"29802397-7c86-c943-ad87-0e42427bf056"],

Cell["\<\
Only a regular array can carry a symmetry other than \"Rigid\".\
\>", "Notes",ExpressionUUID->"784fc978-aaab-c448-8bd6-ebee7ef8ab88"],

Cell[TextData[{
 "The symmetry is the one thing an array is told rather than asked: \
ArraySymmetry reports what was declared, and the declaration is verified \
against the entries when the array is built. ",
 Cell[BoxData[
  StyleBox["GenerateSymbolicArray", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"81ff5f6b-e137-f94e-a990-60e7ad92f837"],
 " builds entries that honour it by construction, equivalent index tuples \
naming the same entry, so there is nothing for the check to catch."
}], "Notes",ExpressionUUID->"e9598b02-eed7-854e-ac3e-cb143895072e"],

Cell["\<\
A symmetric array is also cyclic, so the same entries may be declared either \
way. At order two the cyclic group is the symmetric group and the two \
coincide exactly.\
\>", "Notes",ExpressionUUID->"9a541a7f-660b-5544-80dd-4a07ef862fd5"],

Cell["\<\
Symmetry is the third criterion by which a Hypermatrix orders its arrays, \
taking \"Symmetric\" before \"Cyclic\" before \"Rigid\".\
\>", "Notes",ExpressionUUID->"96e8ee55-67b9-034b-b84a-fdb301ecf6af"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"ebafb886-9fe6-164d-917b-fc1b42fec344"],

Cell["\<\
ArraySymmetry @ ArrayObject[{{1, 2}, {2, 1}}, #] & /@ {\"Rigid\", \"Cyclic\", \
\"Symmetric\"}\
\>", "Input",ExpressionUUID->"3acd2a52-d93c-7e4a-b27e-1afdffc84ddb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Rigid\"\>", ",", "\<\"Cyclic\"\>", ",", "\<\"Symmetric\"\>"}], 
  "}"}]], "Output",ExpressionUUID->"04911917-7bb9-a440-9ea5-4f528971cae6"],

Cell["\<\
The entries of the cyclic orbit of (1, 2, 3) are invariant under rotation but \
not under reflection, so they are cyclic and not symmetric:\
\>", "ExampleText",ExpressionUUID->"9fe616a0-4bbb-524e-881d-f0bd9ffc4846"],

Cell["\<\
cyc = Array[If[MemberQ[{{1, 2, 3}, {2, 3, 1}, {3, 1, 2}}, {##}], 1, 0] &, {3, \
3, 3}];
{ArraySymmetry @ ArrayObject[cyc, \"Cyclic\"],
 Quiet @ ArrayObject[cyc, \"Symmetric\"]}\
\>", "Input",ExpressionUUID->"169077b9-d4f9-8c46-9202-d278375726df"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Cyclic\"\>", ",", "$Failed"}], "}"}]], "Output",ExpressionUUID->\
"3b17be38-8cec-9f4a-bbd2-be9841b341f3"],

Cell["Source", "NotesSection",ExpressionUUID->"a4561650-bdb9-314c-9c85-2867f5979fb2"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Array accessors",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"f561fe4c-1653-d841-9316-3670a4f481ca"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"f3c6ccba-8b12-084f-b7b9-8e8e46ae818d"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayOrder", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "42932750-6918-ac4a-b482-03b8addee016"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayDimensions", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "538e7284-010a-4344-9f77-c6e13251a5ff"],
 ", ",
 Cell[BoxData[
  StyleBox["RegularArrayQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "f3f5d938-561e-e541-9dce-4e6a2e38eed1"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayObject", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "74c5bd9e-d600-a946-8218-acd960239836"],
 ", ",
 Cell[BoxData[
  StyleBox["GenerateSymbolicArray", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"1fbffe06-11c9-e342-81ed-66ae3915e587"],
 ", ",
 Cell[BoxData[
  StyleBox["Hypermatrix", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "0b1ad34d-dc56-2a4a-bb66-4c1eeabd8835"]
}], "SeeAlso",ExpressionUUID->"3dc5ce7e-d95c-1747-8fed-3afbc84c98eb"]
},
