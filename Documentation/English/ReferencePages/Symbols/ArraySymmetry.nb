(* Beginning of Notebook Content *)
Notebook[{
Cell["ArraySymmetry", "ObjectName",ExpressionUUID->"ea3b62a6-44c3-214f-b6a2-391d024d56f8"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArraySymmetry", "[", "arr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"8cf3e0c5-f5f8-af48-af5d-0c65e930b34d"],
 " ",
 "gives the declared index symmetry of arr."
}], "Usage",ExpressionUUID->"4e62eb93-e71c-1847-80e8-b8ee9cfa810a"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"1ad9bdba-fcbe-134a-9375-e109dd10f536"],

Cell["\<\
The result is one of \"Rigid\", meaning no symmetry is claimed; \"Cyclic\", \
meaning the entries are invariant under cyclic permutation of the indices; or \
\"Symmetric\", meaning they are invariant under all permutations.\
\>", "Notes",ExpressionUUID->"bab95597-2b9f-6b4a-8752-2b70b4ea6b5a"],

Cell["\<\
Only a regular array can carry a symmetry other than \"Rigid\".\
\>", "Notes",ExpressionUUID->"25202e46-fbdb-c040-958a-185466945729"],

Cell[TextData[{
 "The symmetry is the one thing an array is told rather than asked: \
ArraySymmetry reports what was declared, and the declaration is verified \
against the entries when the array is built. ",
 Cell[BoxData[
  StyleBox["GenerateSymbolicArray", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"e30cf111-156d-6346-a52e-81ba3bf1be5b"],
 " builds entries that honour it by construction, equivalent index tuples \
naming the same entry, so there is nothing for the check to catch."
}], "Notes",ExpressionUUID->"701f4a28-431d-0145-8de0-d639997f37e8"],

Cell["\<\
A symmetric array is also cyclic, so the same entries may be declared either \
way. At order two the cyclic group is the symmetric group and the two \
coincide exactly.\
\>", "Notes",ExpressionUUID->"9926f0d5-52e8-fe4c-ad4a-09dbc4f389d2"],

Cell["\<\
Symmetry is the third criterion by which a Hypermatrix orders its arrays, \
taking \"Symmetric\" before \"Cyclic\" before \"Rigid\".\
\>", "Notes",ExpressionUUID->"7999c497-8a6a-4f47-9e32-f040d45d75a0"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"578912e9-f635-2d4f-b0cb-c9d3c185b956"],

Cell["\<\
ArraySymmetry @ ArrayObject[{{1, 2}, {2, 1}}, #] & /@ {\"Rigid\", \"Cyclic\", \
\"Symmetric\"}\
\>", "Input",ExpressionUUID->"cdb58c60-b8ae-5244-9421-0cf74ec7a851"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Rigid\"\>", ",", "\<\"Cyclic\"\>", ",", "\<\"Symmetric\"\>"}], 
  "}"}]], "Output",ExpressionUUID->"39863107-359d-0145-814f-7cf50de91585"],

Cell["\<\
The entries of the cyclic orbit of (1, 2, 3) are invariant under rotation but \
not under reflection, so they are cyclic and not symmetric:\
\>", "ExampleText",ExpressionUUID->"7d0c01c0-52b8-ac4c-8fdc-a77ab55d4d4d"],

Cell["\<\
cyc = Array[If[MemberQ[{{1, 2, 3}, {2, 3, 1}, {3, 1, 2}}, {##}], 1, 0] &, {3, \
3, 3}];
{ArraySymmetry @ ArrayObject[cyc, \"Cyclic\"],
 Quiet @ ArrayObject[cyc, \"Symmetric\"]}\
\>", "Input",ExpressionUUID->"53836a17-7aae-1948-acfd-4c34a36ce882"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Cyclic\"\>", ",", "$Failed"}], "}"}]], "Output",ExpressionUUID->\
"8d683528-df78-0e43-a879-c80e232c1981"],

Cell["Source", "NotesSection",ExpressionUUID->"b702d8f6-6e84-934b-83b1-f90de582f8b1"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Array accessors",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"a02ecb80-adfa-814b-a64b-286b6dc3a1d5"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"ff4de042-810d-744a-9fe8-311ea09e43ca"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayOrder", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "d86547fc-9d91-bd42-a7f1-5b938438eec3"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayDimensions", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "6b1c7033-6de1-4243-b386-6c3b923f5f55"],
 ", ",
 Cell[BoxData[
  StyleBox["RegularArrayQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "b51f3c14-e45a-314e-a9cd-94f0bf1a69b1"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayObject", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "692894a8-2e6b-3c4b-82d1-86ae1fe1595a"],
 ", ",
 Cell[BoxData[
  StyleBox["GenerateSymbolicArray", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"57636460-2a75-1d41-af99-1b8521b0d752"],
 ", ",
 Cell[BoxData[
  StyleBox["Hypermatrix", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "cf432a8b-a413-e64f-a760-638174ce0324"]
}], "SeeAlso",ExpressionUUID->"f9b70d30-ac65-a94c-869a-22dd9044e183"]
},
