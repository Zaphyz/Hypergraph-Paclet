Notebook[{
Cell["ArraySymmetry", "ObjectName",ExpressionUUID->"cd7f5d7e-679d-0940-8f0f-53c77063889a"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArraySymmetry", "[", "arr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"ed31eede-1ee9-f34b-bb2f-bb364cb1d875"],
 " ",
 "gives the declared index symmetry of arr."
}], "Usage",ExpressionUUID->"c7e540dd-a31a-3343-9190-444b1c0dda6b"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"13e3287b-8ea6-9a47-94c7-854b5be42c6d"],

Cell["\<\
The result is one of \"Rigid\", meaning no symmetry is claimed; \"Cyclic\", \
meaning the entries are invariant under cyclic permutation of the indices; or \
\"Symmetric\", meaning they are invariant under all permutations.\
\>", "Notes",ExpressionUUID->"b05b0b25-0e9b-7649-b214-3009520b58be"],

Cell["\<\
Only a regular array can carry a symmetry other than \"Rigid\".\
\>", "Notes",ExpressionUUID->"a558921c-4abe-794f-851d-5d4def47b6d9"],

Cell[TextData[{
 "The symmetry is the one thing an array is told rather than asked: \
ArraySymmetry reports what was declared, and the declaration is verified \
against the entries when the array is built. ",
 Cell[BoxData[
  StyleBox["GenerateSymbolicArray", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"3c3ab62f-a396-394b-89af-501708bec38d"],
 " builds entries that honour it by construction, equivalent index tuples \
naming the same entry, so there is nothing for the check to catch."
}], "Notes",ExpressionUUID->"c50ea407-8e0f-534d-bfb9-97746d65b1d1"],

Cell["\<\
A symmetric array is also cyclic, so the same entries may be declared either \
way. At order two the cyclic group is the symmetric group and the two \
coincide exactly.\
\>", "Notes",ExpressionUUID->"7fceace2-3b74-e242-8404-4b07f7b55f51"],

Cell["\<\
Symmetry is the third criterion by which a Hypermatrix orders its arrays, \
taking \"Symmetric\" before \"Cyclic\" before \"Rigid\".\
\>", "Notes",ExpressionUUID->"b94eb4f7-04e0-a04a-b16b-d485ae049447"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"ab6685e8-03c6-2544-a289-d24bf00610bc"],

Cell["\<\
ArraySymmetry @ ArrayObject[{{1, 2}, {2, 1}}, #] & /@ {\"Rigid\", \"Cyclic\", \
\"Symmetric\"}\
\>", "Input",ExpressionUUID->"1846df3c-8830-044f-9676-11db607b965c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Rigid\"\>", ",", "\<\"Cyclic\"\>", ",", "\<\"Symmetric\"\>"}], 
  "}"}]], "Output",ExpressionUUID->"f4a87dc5-984f-dc42-8018-be0ab51f9231"],

Cell["\<\
The entries of the cyclic orbit of (1, 2, 3) are invariant under rotation but \
not under reflection, so they are cyclic and not symmetric:\
\>", "ExampleText",ExpressionUUID->"9605e97c-542d-6948-ab9b-1f6890623863"],

Cell["\<\
cyc = Array[If[MemberQ[{{1, 2, 3}, {2, 3, 1}, {3, 1, 2}}, {##}], 1, 0] &, {3, \
3, 3}];
{ArraySymmetry @ ArrayObject[cyc, \"Cyclic\"],
 Quiet @ ArrayObject[cyc, \"Symmetric\"]}\
\>", "Input",ExpressionUUID->"b45b0d1b-7f67-9d42-b52d-0f76da6fcc1d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Cyclic\"\>", ",", "$Failed"}], "}"}]], "Output",ExpressionUUID->\
"aa1d14e9-d6ab-e149-b27c-557141723fde"],

Cell["Source", "NotesSection",ExpressionUUID->"8470d24a-94af-9147-83a8-2f50a2fbe80f"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Array accessors",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"280c16d6-c49c-a147-a2d7-4d46efdef264"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"f76ed592-33a3-a247-80c9-e32ce0b726f3"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayOrder", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "5a435709-0daa-7d40-902f-9bd163a89ac2"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayDimensions", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "64f03db4-5f26-ee4b-b639-bc693cad1efa"],
 ", ",
 Cell[BoxData[
  StyleBox["RegularArrayQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "be658fc0-377e-604f-8235-0293eed56aab"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayObject", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "d052f203-d116-844f-845c-fdee22da656d"],
 ", ",
 Cell[BoxData[
  StyleBox["GenerateSymbolicArray", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"8ac65001-b1fd-c94a-be24-e50ac0400d64"],
 ", ",
 Cell[BoxData[
  StyleBox["Hypermatrix", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "126974e4-c4f7-d340-b63b-1e4c26778efc"]
}], "SeeAlso",ExpressionUUID->"8973b0cb-7a82-e845-ba5b-d3540b28c2e3"]
},
