Notebook[{
Cell["ArraySymmetry", "ObjectName",ExpressionUUID->"0cda5099-1484-0c49-98fd-7d21548e9ebf"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArraySymmetry", "[", "arr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"2042ccf1-b153-7f44-bd00-f28a6b6ad2e3"],
 " ",
 "gives the declared index symmetry of arr."
}], "Usage",ExpressionUUID->"59164b6b-769d-bc40-bdf0-69e46d995028"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"27effe6e-8970-1a49-9e8a-2877e3af414f"],

Cell["\<\
The result is one of \"Rigid\", meaning no symmetry is claimed; \"Cyclic\", \
meaning the entries are invariant under cyclic permutation of the indices; or \
\"Symmetric\", meaning they are invariant under all permutations.\
\>", "Notes",ExpressionUUID->"5a35d029-fe3d-644a-b30f-536137098418"],

Cell["\<\
Only a regular array can carry a symmetry other than \"Rigid\".\
\>", "Notes",ExpressionUUID->"0a3fb2a4-dcaa-5443-a020-bd023d86572a"],

Cell[TextData[{
 "The symmetry is the one thing an array is told rather than asked: \
ArraySymmetry reports what was declared, and the declaration is verified \
against the entries when the array is built. ",
 Cell[BoxData[
  StyleBox["GenerateSymbolicArray", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"48079a76-96e1-854f-8f9f-9fca9c4ddd7a"],
 " builds entries that honour it by construction, equivalent index tuples \
naming the same entry, so there is nothing for the check to catch."
}], "Notes",ExpressionUUID->"ecb33934-d3b2-a944-b27f-294b1d816657"],

Cell["\<\
A symmetric array is also cyclic, so the same entries may be declared either \
way. At order two the cyclic group is the symmetric group and the two \
coincide exactly.\
\>", "Notes",ExpressionUUID->"d483ccd0-195e-1646-841d-fd0f7780ad25"],

Cell["\<\
Symmetry is the third criterion by which a Hypermatrix orders its arrays, \
taking \"Symmetric\" before \"Cyclic\" before \"Rigid\".\
\>", "Notes",ExpressionUUID->"4433eb66-bf38-b744-a2d5-e7238834f421"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"9bac2e00-b7a7-0e48-ab64-14df3ba43fe6"],

Cell["\<\
ArraySymmetry @ ArrayObject[{{1, 2}, {2, 1}}, #] & /@ {\"Rigid\", \"Cyclic\", \
\"Symmetric\"}\
\>", "Input",ExpressionUUID->"9cba22b1-805d-3e49-a1aa-fc80e3ce43e3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Rigid\"\>", ",", "\<\"Cyclic\"\>", ",", "\<\"Symmetric\"\>"}], 
  "}"}]], "Output",ExpressionUUID->"48b9d82e-25e8-934d-96e0-aecd76c2a858"],

Cell["\<\
The entries of the cyclic orbit of (1, 2, 3) are invariant under rotation but \
not under reflection, so they are cyclic and not symmetric:\
\>", "ExampleText",ExpressionUUID->"f776b027-e2d5-2649-896e-19d8792ae6b8"],

Cell["\<\
cyc = Array[If[MemberQ[{{1, 2, 3}, {2, 3, 1}, {3, 1, 2}}, {##}], 1, 0] &, {3, \
3, 3}];
{ArraySymmetry @ ArrayObject[cyc, \"Cyclic\"],
 Quiet @ ArrayObject[cyc, \"Symmetric\"]}\
\>", "Input",ExpressionUUID->"c1804c51-658e-084f-81c8-c0e93aeb67de"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Cyclic\"\>", ",", "$Failed"}], "}"}]], "Output",ExpressionUUID->\
"cfb6c175-ac3b-1f46-b311-d8e3efb50c2f"],

Cell["Source", "NotesSection",ExpressionUUID->"6add75a6-71e2-6a4c-a171-3a034ef0e612"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Array accessors",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"e73737f2-4c30-8245-a7e7-e7991b846b6d"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"135dc31b-0fde-cf40-a3a5-73f77b29b865"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayOrder", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "894d6650-dd8f-7a48-b4b3-3c3e92649b26"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayDimensions", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "b8f63948-e159-954b-b7d9-f527b619c03b"],
 ", ",
 Cell[BoxData[
  StyleBox["RegularArrayQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "4a68e66a-5e43-264a-bba2-2d55a7106fb9"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayObject", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "c565b105-c140-d14d-a604-0ff7585c88f1"],
 ", ",
 Cell[BoxData[
  StyleBox["GenerateSymbolicArray", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"53614c7c-cf6f-ca48-9d65-7226ba52d0c2"],
 ", ",
 Cell[BoxData[
  StyleBox["Hypermatrix", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "d3781c22-2df8-204e-9121-6848328802e9"]
}], "SeeAlso",ExpressionUUID->"9c727d7e-2b34-df4e-ba42-17c6f270c513"]
},
