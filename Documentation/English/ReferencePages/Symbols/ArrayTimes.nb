Notebook[{
Cell["ArrayTimes", "ObjectName",ExpressionUUID->"de931912-ddbb-594f-bba9-b7cb31f61673"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayTimes", "[", 
    RowBox[{"arr1", ",", " ", "arr2", ",", " ", "..."}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "af2c2844-1962-c547-8399-3b78a6d09616"],
 " ",
 "multiplies the given arrays entry by entry."
}], "Usage",ExpressionUUID->"4f45dec6-bcd4-c645-8d70-b076fdbc25c2"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"e5645608-1593-9f4f-9508-78a05f9b436d"],

Cell["\<\
The arrays are given directly, not in a list, as with ArrayAdd.\
\>", "Notes",ExpressionUUID->"246f1ebe-b499-584c-a3ee-204f3e94a94f"],

Cell["\<\
Every argument must have the same dimensions, except that an array of order \
zero multiplies every entry. Scalar multiplication is therefore the same \
operation, with no separate name: ArrayTimes[2, arr] and ArrayTimes with the \
0-array ArrayObject[2] are one and the same.\
\>", "Notes",ExpressionUUID->"9dabdda1-4c48-3442-aed0-c2b6e2d01318"],

Cell["\<\
Entries of any kind may be combined, and the result is an ArrayObject, \
exactly as for ArrayAdd.\
\>", "Notes",ExpressionUUID->"1dd34676-89c3-7f45-bc03-4e1b7045df26"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"arr1", " ", "arr2"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"bb4b30e5-6de7-434c-93e7-222223eff1f6"],
 " is the same operation, as is ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"2", " ", "arr"}], "InlineCode"]], "InlineFormula",ExpressionUUID->
  "5ba9c2c0-2acb-9948-8840-d8138c429631"],
 " and ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"arr", " ", "/", " ", "2"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"29aa09f2-a304-2042-a778-6d7ecb34d1e9"],
 "."
}], "Notes",ExpressionUUID->"ee86f0e8-2008-2940-b03e-89034868ae60"],

Cell["\<\
This is multiplication entry by entry, which is not a contraction. For the \
matrix product, and for Einstein summation generally, see ArrayMultiply.\
\>", "Notes",ExpressionUUID->"24ef3d1d-4bdc-e948-bf1d-89d19e2e8a80"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"3d1e80fa-e5e3-b643-97fa-caf0e6e0125f"],

Cell["Entry by entry:", "ExampleText",ExpressionUUID->"e1487df7-3582-7d4a-8ed4-0aa40701b73f"],

Cell["\<\
u = {{1, 2}, {3, 4}}; v = {{5, 6}, {7, 8}};
Normal @ ArrayTimes[u, v]\
\>", "Input",ExpressionUUID->"bbdf617b-3806-c948-89c6-67d8ece014ad"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"5", ",", "12"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"21", ",", "32"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"e7026160-b4be-6341-ae91-d0e911d2f411"],

Cell["\<\
A scalar multiplies every entry, and it is the same operation:\
\>", "ExampleText",ExpressionUUID->"7868d699-8750-a146-9a5a-839f664b37d2"],

Cell["\<\
{Normal @ ArrayTimes[2, u], Normal @ ArrayTimes[ArrayObject[2], u]}\
\>", "Input",ExpressionUUID->"daf7fbc7-d64e-014a-989f-712278dbcd67"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"6", ",", "8"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"6", ",", "8"}], "}"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"d80d3ea0-c575-5b42-bac3-1c4d8aead96e"],

Cell["In ordinary notation:", "ExampleText",ExpressionUUID->"e2c7f0dc-678d-1e4b-85e6-2bf908cb5e0c"],

Cell["Normal[2 ArrayObject[u]]", "Input",ExpressionUUID->"58eefc55-02ad-474d-b050-b40972e6a9f5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"6", ",", "8"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"295f04c8-fe7c-bb4c-b530-37de92f718e7"],

Cell["Entries of different kinds may be combined:", "ExampleText",ExpressionUUID->"e32e92e5-6e74-3b46-a5c0-f05f1c8c4c64"],

Cell["2 GenerateSymbolicArray[c, {2}]", "Input",ExpressionUUID->"65fb8bb2-cff7-614d-bd3d-86bfbe45aec1"],

