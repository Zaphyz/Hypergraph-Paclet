Notebook[{
Cell["ArrayTimes", "ObjectName",ExpressionUUID->"ab37f874-9ed6-1f41-b375-0a1a9e74193e"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayTimes", "[", 
    RowBox[{"arr1", ",", " ", "arr2", ",", " ", "..."}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "b27b559b-1a42-da4b-9f55-2a30a07eb4e3"],
 " ",
 "multiplies the given arrays entry by entry."
}], "Usage",ExpressionUUID->"1af19310-7e79-eb45-91da-d9fbf6a17d9b"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"a77b636b-ef74-7042-b6b6-3e12495bb079"],

Cell["\<\
The arrays are given directly, not in a list, as with ArrayAdd.\
\>", "Notes",ExpressionUUID->"dc9300f5-e592-6a4f-b24e-7a7e803e036e"],

Cell["\<\
Every argument must have the same dimensions, except that an array of order \
zero multiplies every entry. Scalar multiplication is therefore the same \
operation, with no separate name: ArrayTimes[2, arr] and ArrayTimes with the \
0-array ArrayObject[2] are one and the same.\
\>", "Notes",ExpressionUUID->"3235a423-dae9-4c42-b496-72d0515714b5"],

Cell["\<\
Entries of any kind may be combined, and the result is an ArrayObject, \
exactly as for ArrayAdd.\
\>", "Notes",ExpressionUUID->"62bcec77-ba15-8d4c-8043-206c75e1e4bb"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"arr1", " ", "arr2"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"2e9924ad-b3df-7a44-8da5-0d42ffc0ba32"],
 " is the same operation, as is ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"2", " ", "arr"}], "InlineCode"]], "InlineFormula",ExpressionUUID->
  "4cb0b790-d0c1-fc47-8576-a50e4f02cfb9"],
 " and ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"arr", " ", "/", " ", "2"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"2d88f2ee-5a7a-3044-bc83-7e79f1b22aef"],
 "."
}], "Notes",ExpressionUUID->"021edf4a-c2ef-634f-8907-89dcdf43a7b9"],

Cell["\<\
This is multiplication entry by entry, which is not a contraction. For the \
matrix product, and for Einstein summation generally, see ArrayMultiply.\
\>", "Notes",ExpressionUUID->"fc4b4e8d-43b7-8f42-9130-78ef1929a409"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"2ee524c9-c93e-a447-a8ff-802a5298f9ae"],

Cell["Entry by entry:", "ExampleText",ExpressionUUID->"0f673218-e522-4142-9094-3014bad49e7a"],

Cell["\<\
u = {{1, 2}, {3, 4}}; v = {{5, 6}, {7, 8}};
Normal @ ArrayTimes[u, v]\
\>", "Input",ExpressionUUID->"43c5de23-f5f1-b646-b0fc-2708175a4ede"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"5", ",", "12"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"21", ",", "32"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"d2201c84-e392-b84f-8f8e-1933fc0b1469"],

Cell["\<\
A scalar multiplies every entry, and it is the same operation:\
\>", "ExampleText",ExpressionUUID->"93af7b6a-e881-6c48-89aa-0b56ca5d2c13"],

Cell["\<\
{Normal @ ArrayTimes[2, u], Normal @ ArrayTimes[ArrayObject[2], u]}\
\>", "Input",ExpressionUUID->"8d6c5d58-d022-5b43-b93a-ee8f6c4bd2c9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"6", ",", "8"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"6", ",", "8"}], "}"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"574e936f-5e1c-a049-aee9-e5fcdfa995ec"],

Cell["In ordinary notation:", "ExampleText",ExpressionUUID->"26a7b0f2-a162-f949-b9df-7c35bb109fc4"],

Cell["Normal[2 ArrayObject[u]]", "Input",ExpressionUUID->"60e077ef-c525-1a4c-b73a-9917489ecfe4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"6", ",", "8"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"41febd87-1b5d-e74b-b646-902accd27cf8"],

Cell["Entries of different kinds may be combined:", "ExampleText",ExpressionUUID->"a06a76f5-847b-dc48-8b27-ed465d19ad0b"],

Cell["2 GenerateSymbolicArray[c, {2}]", "Input",ExpressionUUID->"92817b1e-ca8a-4f44-8278-1edcc9da7f6a"],

