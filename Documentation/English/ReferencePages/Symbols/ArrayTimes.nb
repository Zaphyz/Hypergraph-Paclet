Notebook[{
Cell["ArrayTimes", "ObjectName",ExpressionUUID->"d4005373-19e6-7f4d-9d54-b91fd445665f"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayTimes", "[", 
    RowBox[{"arr1", ",", " ", "arr2", ",", " ", "..."}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "9ef439b5-7734-1a4e-97a0-25278faa1761"],
 " ",
 "multiplies the given arrays entry by entry."
}], "Usage",ExpressionUUID->"954e7d5c-cc80-fc4c-87ad-fa9fe64b50bf"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"cf375878-1964-e649-8a87-22733d80dba7"],

Cell["\<\
The arrays are given directly, not in a list, as with ArrayAdd.\
\>", "Notes",ExpressionUUID->"f04cce98-ffc9-694c-aec0-5c2f01ebeef3"],

Cell["\<\
Every argument must have the same dimensions, except that an array of order \
zero multiplies every entry. Scalar multiplication is therefore the same \
operation, with no separate name: ArrayTimes[2, arr] and ArrayTimes with the \
0-array ArrayObject[2] are one and the same.\
\>", "Notes",ExpressionUUID->"7ba18c63-f12d-c44c-ac44-741f352ccbc9"],

Cell["\<\
Entries of any kind may be combined, and the result is an ArrayObject, \
exactly as for ArrayAdd.\
\>", "Notes",ExpressionUUID->"0a2fcf6b-8ead-da44-962d-a660b84477c4"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"arr1", " ", "arr2"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"6d9687cc-6843-2842-96af-2410166714c6"],
 " is the same operation, as is ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"2", " ", "arr"}], "InlineCode"]], "InlineFormula",ExpressionUUID->
  "d7fcdb53-dbad-2242-96fc-7486c56ebd4f"],
 " and ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"arr", " ", "/", " ", "2"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"e3cac69f-c425-9c44-a467-f1ee0ffc84c5"],
 "."
}], "Notes",ExpressionUUID->"91f9dbd3-a9a1-0048-9412-59567d12d388"],

Cell["\<\
This is multiplication entry by entry, which is not a contraction. For the \
matrix product, and for Einstein summation generally, see ArrayMultiply.\
\>", "Notes",ExpressionUUID->"8f784726-f7d9-c74b-93fa-e931bb4389fa"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"3ec8e137-a3c6-5946-90c6-600035e8dadb"],

Cell["Entry by entry:", "ExampleText",ExpressionUUID->"19553e88-896e-764f-bf34-5c32cccf9ae9"],

Cell["\<\
u = {{1, 2}, {3, 4}}; v = {{5, 6}, {7, 8}};
Normal @ ArrayTimes[u, v]\
\>", "Input",ExpressionUUID->"b0613d27-b6a7-bb41-a34a-64dedd81afbb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"5", ",", "12"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"21", ",", "32"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"a99b696e-2142-6541-88d2-11906493e522"],

Cell["\<\
A scalar multiplies every entry, and it is the same operation:\
\>", "ExampleText",ExpressionUUID->"927b45d7-a6f3-644a-a3f7-23e88599bdc8"],

Cell["\<\
{Normal @ ArrayTimes[2, u], Normal @ ArrayTimes[ArrayObject[2], u]}\
\>", "Input",ExpressionUUID->"8704858e-0bd2-0e4a-bfe8-a16581b8eca9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"6", ",", "8"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"6", ",", "8"}], "}"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"785e499c-3564-7644-a2b5-705181a962de"],

Cell["In ordinary notation:", "ExampleText",ExpressionUUID->"060da831-d13a-4343-82c6-278e2fc26ec7"],

Cell["Normal[2 ArrayObject[u]]", "Input",ExpressionUUID->"9109d607-48d4-de4c-a844-95ff74d50e24"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"6", ",", "8"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"66773db3-09dd-3642-80ac-68e1fe4d34a9"],

Cell["Entries of different kinds may be combined:", "ExampleText",ExpressionUUID->"7a8cbb36-3df9-1148-9a60-b1711a5465b0"],

Cell["2 GenerateSymbolicArray[c, {2}]", "Input",ExpressionUUID->"e11681b7-1e6a-9d4a-aa2f-52ff77610c8e"],

