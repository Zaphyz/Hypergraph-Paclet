Notebook[{
Cell["ArrayTimes", "ObjectName",ExpressionUUID->"6f82828a-152d-b845-89cc-bd59750b6be2"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayTimes", "[", 
    RowBox[{"arr1", ",", " ", "arr2", ",", " ", "..."}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "5810ce71-d2a6-d64d-b504-5432b8c16564"],
 " ",
 "multiplies the given arrays entry by entry."
}], "Usage",ExpressionUUID->"3ebf9d76-f0fe-0c44-b3aa-9ee28015a093"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"d395a685-8557-054d-b2eb-dfef381a755b"],

Cell["\<\
The arrays are given directly, not in a list, as with ArrayAdd.\
\>", "Notes",ExpressionUUID->"38e47115-35a1-4c48-8313-642ab67be179"],

Cell["\<\
Every argument must have the same dimensions, except that an array of order \
zero multiplies every entry. Scalar multiplication is therefore the same \
operation, with no separate name: ArrayTimes[2, arr] and ArrayTimes with the \
0-array ArrayObject[2] are one and the same.\
\>", "Notes",ExpressionUUID->"4580273f-dfb3-4242-b643-6e9f6e55eebf"],

Cell["\<\
Entries of any kind may be combined, and the result is an ArrayObject, \
exactly as for ArrayAdd.\
\>", "Notes",ExpressionUUID->"d1a1e4db-5df4-3c40-afa7-cfa71cffd758"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"arr1", " ", "arr2"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"f02035bd-9eda-b042-8964-0efb85693562"],
 " is the same operation, as is ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"2", " ", "arr"}], "InlineCode"]], "InlineFormula",ExpressionUUID->
  "cb1f090d-cdfe-034d-b118-e3f343812a66"],
 " and ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"arr", " ", "/", " ", "2"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"cb358860-03e1-cb47-88f6-6de1866f2c20"],
 "."
}], "Notes",ExpressionUUID->"a60b65b8-e1e0-474b-846d-d3c2e2788062"],

Cell["\<\
This is multiplication entry by entry, which is not a contraction. For the \
matrix product, and for Einstein summation generally, see ArrayMultiply.\
\>", "Notes",ExpressionUUID->"94bc9955-4f88-c242-8269-bdca1b8c87f4"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"01e59313-1a5a-7043-93fd-26cb069ccb7b"],

Cell["Entry by entry:", "ExampleText",ExpressionUUID->"ac1f4da0-803c-8447-9b56-75c4e7426441"],

Cell["\<\
u = {{1, 2}, {3, 4}}; v = {{5, 6}, {7, 8}};
Normal @ ArrayTimes[u, v]\
\>", "Input",ExpressionUUID->"581b5671-f376-ec46-bf6b-19c34fe7c53c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"5", ",", "12"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"21", ",", "32"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"9ace73cc-796e-ce44-b096-e06774478875"],

Cell["\<\
A scalar multiplies every entry, and it is the same operation:\
\>", "ExampleText",ExpressionUUID->"30c0e6dd-47c5-3a45-987f-d088432e26ad"],

Cell["\<\
{Normal @ ArrayTimes[2, u], Normal @ ArrayTimes[ArrayObject[2], u]}\
\>", "Input",ExpressionUUID->"f3e76d04-45a7-434d-9a31-c29bb8d3d906"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"6", ",", "8"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"6", ",", "8"}], "}"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"77bd9ec8-c773-7a4a-820c-863c26484dbc"],

Cell["In ordinary notation:", "ExampleText",ExpressionUUID->"37562c7f-a007-0f4c-827a-00bdc5779234"],

Cell["Normal[2 ArrayObject[u]]", "Input",ExpressionUUID->"dabc6f61-6e26-764f-92cb-cbfdec53c1d1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"6", ",", "8"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"2b6ae358-826e-fd43-bf92-e1b5d094ad6e"],

Cell["Entries of different kinds may be combined:", "ExampleText",ExpressionUUID->"af9045c0-8d02-0b43-9f66-8f991b205dbb"],

Cell["2 GenerateSymbolicArray[c, {2}]", "Input",ExpressionUUID->"b755f77d-e2d5-7a4e-85f6-cbd44d1e3736"],

