Notebook[{
Cell["ArrayTimes", "ObjectName",ExpressionUUID->"b955e2c9-3687-5e48-8143-a9c0e1052b6b"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayTimes", "[", 
    RowBox[{"arr1", ",", " ", "arr2", ",", " ", "..."}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "d16ad54b-c09c-fc42-8d5a-295a4ad42dab"],
 " ",
 "multiplies the given arrays entry by entry."
}], "Usage",ExpressionUUID->"43d79af3-9bb5-4a44-ab4f-3b296fc42159"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"f6109bfc-2b47-4e4e-a83d-959cb695859d"],

Cell["\<\
The arrays are given directly, not in a list, as with ArrayAdd.\
\>", "Notes",ExpressionUUID->"5c113f0c-9082-c14c-a931-91d969759752"],

Cell["\<\
Every argument must have the same dimensions, except that an array of order \
zero multiplies every entry. Scalar multiplication is therefore the same \
operation, with no separate name: ArrayTimes[2, arr] and ArrayTimes with the \
0-array ArrayObject[2] are one and the same.\
\>", "Notes",ExpressionUUID->"57cfd328-4963-2a40-912a-6fd117aea6ef"],

Cell["\<\
Entries of any kind may be combined, and the result is an ArrayObject, \
exactly as for ArrayAdd.\
\>", "Notes",ExpressionUUID->"489421d0-9b27-9442-9972-17cd74d11df5"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"arr1", " ", "arr2"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"a29612ff-9158-b54c-9f70-8632d84706b8"],
 " is the same operation, as is ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"2", " ", "arr"}], "InlineCode"]], "InlineFormula",ExpressionUUID->
  "1c6321eb-bcce-274e-bd9d-e9d57ef773ab"],
 " and ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"arr", " ", "/", " ", "2"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"8411f412-63e5-3446-894a-40cfd6aac4c9"],
 "."
}], "Notes",ExpressionUUID->"a1e67b7a-ece7-0f46-a983-f86c6f1616c4"],

Cell["\<\
This is multiplication entry by entry, which is not a contraction. For the \
matrix product, and for Einstein summation generally, see ArrayMultiply.\
\>", "Notes",ExpressionUUID->"6a23c15d-8ced-1347-b9e8-09cc1f50b554"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"78a1ff4a-0bdf-2b41-b241-c274d09f1cbe"],

Cell["Entry by entry:", "ExampleText",ExpressionUUID->"af766216-f808-c440-b3b1-8e6715e7dcc0"],

Cell["\<\
u = {{1, 2}, {3, 4}}; v = {{5, 6}, {7, 8}};
Normal @ ArrayTimes[u, v]\
\>", "Input",ExpressionUUID->"713e40b1-0596-7d40-83d3-d996518f73b1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"5", ",", "12"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"21", ",", "32"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"ff19b991-6a8e-0c4b-b220-18fe7a9b1d41"],

Cell["\<\
A scalar multiplies every entry, and it is the same operation:\
\>", "ExampleText",ExpressionUUID->"a0dd5414-0387-2445-99ff-3634b3f8401e"],

Cell["\<\
{Normal @ ArrayTimes[2, u], Normal @ ArrayTimes[ArrayObject[2], u]}\
\>", "Input",ExpressionUUID->"10e2e360-b84e-c34c-bda4-4dd56d4b152d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"6", ",", "8"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"6", ",", "8"}], "}"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"6992363e-6c03-2d40-bcd0-e6479328c06c"],

Cell["In ordinary notation:", "ExampleText",ExpressionUUID->"fad7c251-dca2-244a-841d-2136647a4f22"],

Cell["Normal[2 ArrayObject[u]]", "Input",ExpressionUUID->"0b74c877-8862-4243-bc17-869c3f94f08d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"6", ",", "8"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"2342a5d9-44d4-bc4f-a178-d15c4f4e182d"],

Cell["Entries of different kinds may be combined:", "ExampleText",ExpressionUUID->"99230109-4768-6a46-bab4-a2cef33c472f"],

Cell["2 GenerateSymbolicArray[c, {2}]", "Input",ExpressionUUID->"78631131-a397-c94b-93c5-127e9590a57d"],

