Notebook[{
Cell["ArrayTimes", "ObjectName",ExpressionUUID->"f171f337-0afe-0a4c-b1f0-a2d9bef11326"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayTimes", "[", 
    RowBox[{"arr1", ",", " ", "arr2", ",", " ", "..."}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "445319f5-eaf0-7f49-842b-552a72808bab"],
 " ",
 "multiplies the given arrays entry by entry."
}], "Usage",ExpressionUUID->"01790513-3116-ea4c-b10d-93b5e331a555"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"4c13d322-1e22-1047-97dd-e7ec0adb0fc8"],

Cell["\<\
The arrays are given directly, not in a list, as with ArrayAdd.\
\>", "Notes",ExpressionUUID->"7217c95d-2153-1247-8260-c868f0a09bea"],

Cell["\<\
Every argument must have the same dimensions, except that an array of order \
zero multiplies every entry. Scalar multiplication is therefore the same \
operation, with no separate name: ArrayTimes[2, arr] and ArrayTimes with the \
0-array ArrayObject[2] are one and the same.\
\>", "Notes",ExpressionUUID->"d08d2551-1c57-714d-b72b-d320a166067d"],

Cell["\<\
Entries of any kind may be combined, and the result is an ArrayObject, \
exactly as for ArrayAdd.\
\>", "Notes",ExpressionUUID->"dc249f9b-ef2d-524d-bbd3-0d3e870ac1f3"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"arr1", " ", "arr2"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"38cdbb31-15d9-0541-9d32-7a705af6e2c1"],
 " is the same operation, as is ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"2", " ", "arr"}], "InlineCode"]], "InlineFormula",ExpressionUUID->
  "ad1d98ec-b097-ee42-b958-da843ef253ba"],
 " and ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"arr", " ", "/", " ", "2"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"48bac88d-c96b-184c-81c8-f88bbeba7100"],
 "."
}], "Notes",ExpressionUUID->"c554f359-869c-6145-b04d-0a0f3a3c5546"],

Cell["\<\
This is multiplication entry by entry, which is not a contraction. For the \
matrix product, and for Einstein summation generally, see ArrayMultiply.\
\>", "Notes",ExpressionUUID->"9f1b911b-3ee8-f947-ba11-5d16b59f2192"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"ca6069f1-7af0-3244-989c-b3fb6889e06c"],

Cell["Entry by entry:", "ExampleText",ExpressionUUID->"927d05a0-d178-5a44-ab09-f436d5d2d938"],

Cell["\<\
u = {{1, 2}, {3, 4}}; v = {{5, 6}, {7, 8}};
Normal @ ArrayTimes[u, v]\
\>", "Input",ExpressionUUID->"b1e77cee-29d7-af4c-bf09-5f26dc5cbfd6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"5", ",", "12"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"21", ",", "32"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"a0bf9747-b4a1-a145-b63f-25dc9a689ffc"],

Cell["\<\
A scalar multiplies every entry, and it is the same operation:\
\>", "ExampleText",ExpressionUUID->"3a88de34-9f78-2d4b-b38c-f2f8d9abae64"],

Cell["\<\
{Normal @ ArrayTimes[2, u], Normal @ ArrayTimes[ArrayObject[2], u]}\
\>", "Input",ExpressionUUID->"fded44dc-3f3c-f24b-8132-462a6b876dbe"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"6", ",", "8"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"6", ",", "8"}], "}"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"65914509-e68d-5c47-9df1-15a4c3ee8368"],

Cell["In ordinary notation:", "ExampleText",ExpressionUUID->"7dada526-8630-d040-81ee-c4ca0193feaa"],

Cell["Normal[2 ArrayObject[u]]", "Input",ExpressionUUID->"3f503439-3ece-0346-b1dc-c5943d8240ef"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"6", ",", "8"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"7868200b-8051-da49-a9c1-650611937d53"],

Cell["Entries of different kinds may be combined:", "ExampleText",ExpressionUUID->"22bfde92-4701-d74e-b778-b2a7177ef93f"],

Cell["2 GenerateSymbolicArray[c, {2}]", "Input",ExpressionUUID->"011e7085-31e5-c949-be30-92a41c8cde5e"],

