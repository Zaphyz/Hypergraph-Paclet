Notebook[{
Cell["ArrayTimes", "ObjectName",ExpressionUUID->"82173bb6-b561-624c-94a2-790e82019c7f"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayTimes", "[", 
    RowBox[{"arr1", ",", " ", "arr2", ",", " ", "..."}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "ec39047a-9c15-e345-925f-cc5ea59a1c92"],
 " ",
 "multiplies the given arrays entry by entry."
}], "Usage",ExpressionUUID->"795c508d-3412-b74c-9a9a-637533cf222f"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"d8701657-d8a5-4240-93da-43fa3da23d07"],

Cell["\<\
The arrays are given directly, not in a list, as with ArrayAdd.\
\>", "Notes",ExpressionUUID->"40b02d66-9d8e-9649-abf0-f2f7e135c71d"],

Cell["\<\
Every argument must have the same dimensions, except that an array of order \
zero multiplies every entry. Scalar multiplication is therefore the same \
operation, with no separate name: ArrayTimes[2, arr] and ArrayTimes with the \
0-array ArrayObject[2] are one and the same.\
\>", "Notes",ExpressionUUID->"1770ca68-a625-0c48-ab97-7f5fa0fb48d8"],

Cell["\<\
Entries of any kind may be combined, and the result is an ArrayObject, \
exactly as for ArrayAdd.\
\>", "Notes",ExpressionUUID->"84559145-0480-cb49-bd79-37cee4bcb6e0"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"arr1", " ", "arr2"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"d47b4def-2b62-9d4c-9ddc-d4db0770f891"],
 " is the same operation, as is ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"2", " ", "arr"}], "InlineCode"]], "InlineFormula",ExpressionUUID->
  "747424c1-fb1e-f542-b000-d9e3b2120656"],
 " and ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"arr", " ", "/", " ", "2"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"a91d2ae5-f076-0d4d-bcd8-40f7a18f9968"],
 "."
}], "Notes",ExpressionUUID->"f2bb6d50-8fec-674b-919e-43b358acf5c5"],

Cell["\<\
This is multiplication entry by entry, which is not a contraction. For the \
matrix product, and for Einstein summation generally, see ArrayMultiply.\
\>", "Notes",ExpressionUUID->"c3791b39-995c-1f4d-a149-0f493c242b3a"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"f59226bd-65ae-2a4f-918c-e8cff9df9009"],

Cell["Entry by entry:", "ExampleText",ExpressionUUID->"9fbfca1f-42d8-b649-8e04-7daa50d9441a"],

Cell["\<\
u = {{1, 2}, {3, 4}}; v = {{5, 6}, {7, 8}};
Normal @ ArrayTimes[u, v]\
\>", "Input",ExpressionUUID->"d73666e7-1030-3c4c-a24a-76660735e231"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"5", ",", "12"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"21", ",", "32"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"bb97d91a-464b-3f4a-bc41-4c73415140ee"],

Cell["\<\
A scalar multiplies every entry, and it is the same operation:\
\>", "ExampleText",ExpressionUUID->"5e2aecbf-c4e1-bd40-a0f3-c97975e60763"],

Cell["\<\
{Normal @ ArrayTimes[2, u], Normal @ ArrayTimes[ArrayObject[2], u]}\
\>", "Input",ExpressionUUID->"5c93993d-8fe4-d34f-a7e5-6726cc52e427"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"6", ",", "8"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"6", ",", "8"}], "}"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"b0e48454-eb90-284a-a2f4-36207afd7187"],

Cell["In ordinary notation:", "ExampleText",ExpressionUUID->"0f60c536-45ca-f742-a3d1-2ac05de22bbd"],

Cell["Normal[2 ArrayObject[u]]", "Input",ExpressionUUID->"d2d7179e-ae7f-5046-8ea4-845223fbd410"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"6", ",", "8"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"ef0bb249-76f1-3e48-89fd-64397ee1b531"],

Cell["Entries of different kinds may be combined:", "ExampleText",ExpressionUUID->"bb5fbbc5-c681-4447-8a4c-fc6ac5d41875"],

Cell["2 GenerateSymbolicArray[c, {2}]", "Input",ExpressionUUID->"a2edc3ab-5dcd-a548-a26c-4c83a19d1765"],

