Notebook[{
Cell["ArrayTimes", "ObjectName",ExpressionUUID->"58fb64c9-797e-4f49-960d-29e66340888c"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ArrayTimes", "[", 
    RowBox[{"arr1", ",", " ", "arr2", ",", " ", "..."}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "eeea782b-5811-0443-a46b-a7ab69413f31"],
 " ",
 "multiplies the given arrays entry by entry."
}], "Usage",ExpressionUUID->"00f43783-87ae-6e41-b351-61575880bc17"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"db85572c-d47b-7c49-8d68-5a5413bb4344"],

Cell["\<\
The arrays are given directly, not in a list, as with ArrayAdd.\
\>", "Notes",ExpressionUUID->"1108019b-61d9-9344-852c-a1128e046b0b"],

Cell["\<\
Every argument must have the same dimensions, except that an array of order \
zero multiplies every entry. Scalar multiplication is therefore the same \
operation, with no separate name: ArrayTimes[2, arr] and ArrayTimes with the \
0-array ArrayObject[2] are one and the same.\
\>", "Notes",ExpressionUUID->"e4db2830-81b2-b347-9fe7-3d01b167216e"],

Cell["\<\
Entries of any kind may be combined, and the result is an ArrayObject, \
exactly as for ArrayAdd.\
\>", "Notes",ExpressionUUID->"f3132c52-4eff-4948-9c62-aaec4cf8ebde"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"arr1", " ", "arr2"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"9385ebea-1672-9a4b-a356-2177c37428c4"],
 " is the same operation, as is ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"2", " ", "arr"}], "InlineCode"]], "InlineFormula",ExpressionUUID->
  "9dfb80f4-1018-1643-bd6e-6744edab5749"],
 " and ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"arr", " ", "/", " ", "2"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"fc5dd3ae-3f69-4042-9898-17380d2a13d2"],
 "."
}], "Notes",ExpressionUUID->"e6a357f0-b888-f54b-86fe-8354500cab36"],

Cell["\<\
This is multiplication entry by entry, which is not a contraction. For the \
matrix product, and for Einstein summation generally, see ArrayMultiply.\
\>", "Notes",ExpressionUUID->"09f8800a-10f9-4b4a-a45d-fbb3c1e3adca"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"67524786-46b1-3649-93b2-43781ab3d03e"],

Cell["Entry by entry:", "ExampleText",ExpressionUUID->"4741f72f-2b8b-8b4e-8dcd-0972bc43353e"],

Cell["\<\
u = {{1, 2}, {3, 4}}; v = {{5, 6}, {7, 8}};
Normal @ ArrayTimes[u, v]\
\>", "Input",ExpressionUUID->"d35694da-0013-a543-83b1-64dffe52fa5c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"5", ",", "12"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"21", ",", "32"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"9008a26a-450c-bb45-83ef-97033b84c924"],

Cell["\<\
A scalar multiplies every entry, and it is the same operation:\
\>", "ExampleText",ExpressionUUID->"bedca719-425a-8947-b032-c16df6b540ba"],

Cell["\<\
{Normal @ ArrayTimes[2, u], Normal @ ArrayTimes[ArrayObject[2], u]}\
\>", "Input",ExpressionUUID->"475c66ff-ea24-6f4f-ac76-4a460e1250e6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"6", ",", "8"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"6", ",", "8"}], "}"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"c0994e3b-1801-0042-b612-5c33f853dc0f"],

Cell["In ordinary notation:", "ExampleText",ExpressionUUID->"ac1f5f89-f44a-4a46-9546-33648bfeb524"],

Cell["Normal[2 ArrayObject[u]]", "Input",ExpressionUUID->"3dacfa8f-387d-2540-85fb-3c883563afbb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"6", ",", "8"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"b492fdba-66e9-9144-9b46-218fb6cc4df8"],

Cell["Entries of different kinds may be combined:", "ExampleText",ExpressionUUID->"e835d36a-9978-2f41-bf02-37ddb9c47324"],

Cell["2 GenerateSymbolicArray[c, {2}]", "Input",ExpressionUUID->"36c5a97b-12bd-4549-b5b8-a4496cf2b9ba"],

