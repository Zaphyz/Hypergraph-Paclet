Cell["CanonicalHypergraph[a] === CanonicalHypergraph[b]", "Input",ExpressionUUID->"a28aaff1-fd30-0045-82b7-2c45cd34ba8b"],

Cell[BoxData["True"], "Output",ExpressionUUID->"4b3b1d03-4720-af4f-80eb-46e446154e90"],

Cell["\<\
Labels become numbered placeholders, which is what makes two hypergraphs \
differing only by a renaming of labels reduce to the same form:\
\>", "ExampleText",ExpressionUUID->"04881df4-81dd-1c40-9b6a-d8eb742476d2"],

Cell["\<\
h1 = Hypergraph[{Edge[{1, 2}, \"Directed\", \"a\"], Edge[{2, 3}, \
\"Directed\", \"b\"]}];
h2 = Hypergraph[{Edge[{4, 5}, \"Directed\", \"x\"], Edge[{5, 6}, \
\"Directed\", \"y\"]}];
InputForm /@ {CanonicalHypergraph[h1], CanonicalHypergraph[h2]}\
\>", "Input",ExpressionUUID->"27562032-e6c9-fc4b-9420-afa87528ad9d"],

