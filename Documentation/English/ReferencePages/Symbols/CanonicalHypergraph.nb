(* Beginning of Notebook Content *)
Notebook[{
Cell["CanonicalHypergraph", "ObjectName",ExpressionUUID->"3cb20b66-c8a3-6d45-b45f-d5088623ebea"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"CanonicalHypergraph", "[", "hg", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"c3817598-67e7-1240-b4f2-5264f2f2fe27"],
 " ",
 "gives a canonical representative of the isomorphism class of hg."
}], "Usage",ExpressionUUID->"f323f7d2-39e9-a847-95ae-fe87a7e805a0"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"3b177563-587c-7048-bb17-fae6047419bf"],

Cell["\<\
The vertices of the result are renamed to 1, 2, ... and the labels are \
replaced by the placeholders \[FormalL][1], \[FormalL][2], ..., since labels \
count only up to renaming.\
\>", "Notes",ExpressionUUID->"440ddb45-0a10-ae48-a907-4f65320d6163"],

Cell["\<\
Two hypergraphs are isomorphic exactly when their canonical forms are \
identical.\
\>", "Notes",ExpressionUUID->"f6ccbdf9-f686-d449-a524-54c84093f46c"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"\"\<Labeled\>\"", " ", "->", " ", "False"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"1cf7bdf3-93ae-f044-9f6f-4106719ceb4a"],
 " the skeleton is canonicalized instead, and the result carries no labels at \
all."
}], "Notes",ExpressionUUID->"d5367a41-3547-1843-93d7-b915ff4239af"],

Cell[TextData[{
 "The setting ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"Method", " ", "->", " ", "Automatic"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"b526a8a6-38cb-4b4a-b049-129dbcdd1c9c"],
 " narrows the search by grouping vertices into classes that no isomorphism \
can mix up. ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"Method", " ", "->", " ", "\"\<BruteForce\>\""}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"74a664c5-6772-a646-84a5-5d746738c7ba"],
 " searches every ordering of the vertices instead, and exists to cross-check \
the default."
}], "Notes",ExpressionUUID->"e404aaee-be11-664f-a054-ddad930d03a1"],

Cell["\<\
Both Method settings are functions of the isomorphism class alone, so they \
always agree about whether two hypergraphs are isomorphic, but they settle on \
different representatives of the same class. The two settings must therefore \
not be mixed within a single comparison.\
\>", "Notes",ExpressionUUID->"e90a87f9-a3df-7e49-b7a7-82d584909e61"],

Cell["\<\
The search is exhaustive. When it would exceed 40320 candidate orderings the \
message CanonicalHypergraph::large is produced and the computation proceeds.\
\>", "Notes",ExpressionUUID->"56be4f87-8ea3-6b4e-b23d-1b9b6e28664f"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"63b96fbd-1183-b74f-98a9-f29e856b7c12"],

Cell["\<\
Two spellings of the same directed path have the same canonical form:\
\>", "ExampleText",ExpressionUUID->"0535811c-a301-7040-9424-ae04fd18363b"],

Cell["\<\
a = Hypergraph[{{1, 2}, {2, 3}}];
b = Hypergraph[{{10, 20}, {20, 30}}];
{CanonicalHypergraph[a], CanonicalHypergraph[b]}\
\>", "Input",ExpressionUUID->"7675c078-ac89-8a4f-b0ef-8dc79b3a2f46"],

