(* Beginning of Notebook Content *)
Notebook[{
Cell["CanonicalHypergraph", "ObjectName",ExpressionUUID->"b044e57c-50d6-bf4e-ac4b-2b8b200da0d1"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"CanonicalHypergraph", "[", "hg", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"d6575c33-af17-f546-8607-7fd7602a1004"],
 " ",
 "gives a canonical representative of the isomorphism class of hg."
}], "Usage",ExpressionUUID->"8914d675-e5c2-804c-8cc5-cfb54e7d73c5"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"72b08291-d6be-304f-b819-b005e02c91e4"],

Cell["\<\
The vertices of the result are renamed to 1, 2, ... and the labels are \
replaced by the placeholders \[FormalL][1], \[FormalL][2], ..., since labels \
count only up to renaming.\
\>", "Notes",ExpressionUUID->"2d0a3ed4-a607-6648-8ddb-edda5b5a7b1c"],

Cell["\<\
Two hypergraphs are isomorphic exactly when their canonical forms are \
identical.\
\>", "Notes",ExpressionUUID->"7b71c9a3-3602-ce41-bcc2-3dbcef596fbd"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"\"\<Labeled\>\"", " ", "->", " ", "False"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"b0cb3e70-86de-7545-95c2-8a41dd39778e"],
 " the skeleton is canonicalized instead, and the result carries no labels at \
all."
}], "Notes",ExpressionUUID->"7f5c05db-dab1-4a48-aec6-afd2039a289f"],

Cell[TextData[{
 "The setting ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"Method", " ", "->", " ", "Automatic"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"28ec221f-3e84-be42-89a8-3b0604a6fba6"],
 " narrows the search by grouping vertices into classes that no isomorphism \
can mix up. ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"Method", " ", "->", " ", "\"\<BruteForce\>\""}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"8c5a6cc3-b2fb-7848-a92c-a08a86f12cee"],
 " searches every ordering of the vertices instead, and exists to cross-check \
the default."
}], "Notes",ExpressionUUID->"2a84e9a0-e04c-7642-b29b-f77585f33459"],

Cell["\<\
Both Method settings are functions of the isomorphism class alone, so they \
always agree about whether two hypergraphs are isomorphic, but they settle on \
different representatives of the same class. The two settings must therefore \
not be mixed within a single comparison.\
\>", "Notes",ExpressionUUID->"bbf105a0-3004-5246-96d5-65ce445dae5a"],

Cell["\<\
The search is exhaustive. When it would exceed 40320 candidate orderings the \
message CanonicalHypergraph::large is produced and the computation proceeds.\
\>", "Notes",ExpressionUUID->"36b7c3e6-2d9c-e24e-a594-cf2ad193d9fd"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"464df0aa-a16f-754e-93b5-146d4517ef98"],

Cell["\<\
Two spellings of the same directed path have the same canonical form:\
\>", "ExampleText",ExpressionUUID->"a56d4efa-2592-e44c-8aab-449604810f1c"],

Cell["\<\
a = Hypergraph[{{1, 2}, {2, 3}}];
b = Hypergraph[{{10, 20}, {20, 30}}];
{CanonicalHypergraph[a], CanonicalHypergraph[b]}\
\>", "Input",ExpressionUUID->"4a147666-d714-7c48-9b60-5b845fd2dba0"],

