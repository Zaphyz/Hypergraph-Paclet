Cell["CanonicalHypergraph[a] === CanonicalHypergraph[b]", "Input",ExpressionUUID->"665dd565-c1ee-e54e-84c1-851a50cd81d8"],

Cell[BoxData["True"], "Output",ExpressionUUID->"873babe8-b1e7-fd47-bbb5-e4e87a16467c"],

Cell["\<\
Labels become numbered placeholders, which is what makes two hypergraphs \
differing only by a renaming of labels reduce to the same form:\
\>", "ExampleText",ExpressionUUID->"4d34be46-6144-974a-9ca7-90e3fb2bdbad"],

Cell["\<\
h1 = Hypergraph[{Edge[{1, 2}, \"Directed\", \"a\"], Edge[{2, 3}, \
\"Directed\", \"b\"]}];
h2 = Hypergraph[{Edge[{4, 5}, \"Directed\", \"x\"], Edge[{5, 6}, \
\"Directed\", \"y\"]}];
InputForm /@ {CanonicalHypergraph[h1], CanonicalHypergraph[h2]}\
\>", "Input",ExpressionUUID->"bd241816-2f3f-974c-8085-8a165e92fd11"],

