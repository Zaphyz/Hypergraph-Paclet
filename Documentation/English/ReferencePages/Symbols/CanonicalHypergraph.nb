(* Beginning of Notebook Content *)
Notebook[{
Cell["CanonicalHypergraph", "ObjectName",ExpressionUUID->"d10b6bea-7bea-1048-aa54-5cb858a6c3e9"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"CanonicalHypergraph", "[", "hg", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"db67d3dd-a4e9-db45-a23b-db8a7cd13252"],
 " ",
 "gives a canonical representative of the isomorphism class of hg."
}], "Usage",ExpressionUUID->"13708fd2-1707-8744-afc4-570107f865c2"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"e750fe39-9c8b-5847-b5a7-02d38dedd568"],

Cell["\<\
The vertices of the result are renamed to 1, 2, ... and the labels are \
replaced by the placeholders \[FormalL][1], \[FormalL][2], ..., since labels \
count only up to renaming.\
\>", "Notes",ExpressionUUID->"d5548bb8-402d-1c4e-9b8c-3273f4e8b5a5"],

Cell["\<\
Two hypergraphs are isomorphic exactly when their canonical forms are \
identical.\
\>", "Notes",ExpressionUUID->"576514b4-5f97-9749-95c7-1795357f817e"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"\"\<Labeled\>\"", " ", "->", " ", "False"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"0f6dbbff-3f08-3648-be16-c4d00e95a69b"],
 " the skeleton is canonicalized instead, and the result carries no labels at \
all."
}], "Notes",ExpressionUUID->"68fe0fb8-5a19-5248-a08e-38af9d278055"],

Cell[TextData[{
 "The setting ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"Method", " ", "->", " ", "Automatic"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"72545f9f-24aa-dd41-a1c4-015bb50c9259"],
 " narrows the search by grouping vertices into classes that no isomorphism \
can mix up. ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"Method", " ", "->", " ", "\"\<BruteForce\>\""}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"1d28ada7-99b4-114c-a758-e095e9d45cd6"],
 " searches every ordering of the vertices instead, and exists to cross-check \
the default."
}], "Notes",ExpressionUUID->"47d6afc6-6fd0-4247-b2c3-d3cb4e11e879"],

Cell["\<\
Both Method settings are functions of the isomorphism class alone, so they \
always agree about whether two hypergraphs are isomorphic, but they settle on \
different representatives of the same class. The two settings must therefore \
not be mixed within a single comparison.\
\>", "Notes",ExpressionUUID->"51c06f1a-3501-544d-82f8-3b7ab5f09ea7"],

Cell["\<\
The search is exhaustive. When it would exceed 40320 candidate orderings the \
message CanonicalHypergraph::large is produced and the computation proceeds.\
\>", "Notes",ExpressionUUID->"220c2c84-c2a7-ab44-b21a-1b9442c31d71"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"01ef2341-3b1a-bc4a-b6d2-ee73be9cf8d6"],

Cell["\<\
Two spellings of the same directed path have the same canonical form:\
\>", "ExampleText",ExpressionUUID->"df9bb751-9ebe-fe47-a246-c9604360ea20"],

Cell["\<\
a = Hypergraph[{{1, 2}, {2, 3}}];
b = Hypergraph[{{10, 20}, {20, 30}}];
{CanonicalHypergraph[a], CanonicalHypergraph[b]}\
\>", "Input",ExpressionUUID->"a67be0a3-9a6e-0f40-9ee0-915b3d71b774"],

