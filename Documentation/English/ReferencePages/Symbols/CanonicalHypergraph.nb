Cell["CanonicalHypergraph[a] === CanonicalHypergraph[b]", "Input",ExpressionUUID->"6d963ed7-4e1d-c046-9a6e-29741ed5b893"],

Cell[BoxData["True"], "Output",ExpressionUUID->"9d5e249c-1c4a-2e47-bc96-405799d2a905"],

Cell["\<\
Labels become numbered placeholders, which is what makes two hypergraphs \
differing only by a renaming of labels reduce to the same form:\
\>", "ExampleText",ExpressionUUID->"392aa46e-e987-af49-ac7c-7982b20824de"],

Cell["\<\
h1 = Hypergraph[{Edge[{1, 2}, \"Directed\", \"a\"], Edge[{2, 3}, \
\"Directed\", \"b\"]}];
h2 = Hypergraph[{Edge[{4, 5}, \"Directed\", \"x\"], Edge[{5, 6}, \
\"Directed\", \"y\"]}];
InputForm /@ {CanonicalHypergraph[h1], CanonicalHypergraph[h2]}\
\>", "Input",ExpressionUUID->"96919438-a66b-3544-afda-1c28ba9b13c3"],

