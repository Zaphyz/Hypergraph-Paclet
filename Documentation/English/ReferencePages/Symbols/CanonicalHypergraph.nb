(* Beginning of Notebook Content *)
Notebook[{
Cell["CanonicalHypergraph", "ObjectName",ExpressionUUID->"f5465727-81c6-5848-b054-e3059c584b07"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"CanonicalHypergraph", "[", "hg", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"22862b4e-afd0-6144-9a4d-cdc14ef01771"],
 " ",
 "gives a canonical representative of the isomorphism class of hg."
}], "Usage",ExpressionUUID->"f3f7de1b-0482-fb47-bb12-827f29e91bd6"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"8b097db1-c7dc-5b48-a210-2004d4e0283e"],

Cell["\<\
The vertices of the result are renamed to 1, 2, ... and the labels are \
replaced by the placeholders \[FormalL][1], \[FormalL][2], ..., since labels \
count only up to renaming.\
\>", "Notes",ExpressionUUID->"0aa53711-df72-d541-a15c-a7e2ee2b1a13"],

Cell["\<\
Two hypergraphs are isomorphic exactly when their canonical forms are \
identical.\
\>", "Notes",ExpressionUUID->"fe8fa903-ac73-fe40-a0f9-9c2813161e63"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"\"\<Labeled\>\"", " ", "->", " ", "False"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"bf5b8a43-f677-5a40-9dce-ea4e89d6134c"],
 " the skeleton is canonicalized instead, and the result carries no labels at \
all."
}], "Notes",ExpressionUUID->"cbb6e8e2-66d7-f445-b427-8c9a4e2b6a2e"],

Cell[TextData[{
 "The setting ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"Method", " ", "->", " ", "Automatic"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"57551b3a-e545-e74a-abc7-e5b0973071c3"],
 " narrows the search by grouping vertices into classes that no isomorphism \
can mix up. ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"Method", " ", "->", " ", "\"\<BruteForce\>\""}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"33efbe63-425f-2a45-8c96-634cc8182e26"],
 " searches every ordering of the vertices instead, and exists to cross-check \
the default."
}], "Notes",ExpressionUUID->"a82aa2bf-9b72-ad47-b5fb-75761751cbb7"],

Cell["\<\
Both Method settings are functions of the isomorphism class alone, so they \
always agree about whether two hypergraphs are isomorphic, but they settle on \
different representatives of the same class. The two settings must therefore \
not be mixed within a single comparison.\
\>", "Notes",ExpressionUUID->"9495eef4-b775-a54f-ae91-a8f640c2ff06"],

Cell["\<\
The search is exhaustive. When it would exceed 40320 candidate orderings the \
message CanonicalHypergraph::large is produced and the computation proceeds.\
\>", "Notes",ExpressionUUID->"8a07165a-af4c-0c4c-9064-56d79c3cca16"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"8768e997-683f-ba4c-a0cd-8ce6095c09b5"],

Cell["\<\
Two spellings of the same directed path have the same canonical form:\
\>", "ExampleText",ExpressionUUID->"4b522f92-8456-8e4c-9880-592d49368be2"],

Cell["\<\
a = Hypergraph[{{1, 2}, {2, 3}}];
b = Hypergraph[{{10, 20}, {20, 30}}];
{CanonicalHypergraph[a], CanonicalHypergraph[b]}\
\>", "Input",ExpressionUUID->"95d48a01-f902-1146-a77a-933f8f4aef80"],

