Cell["CanonicalHypergraph[a] === CanonicalHypergraph[b]", "Input",ExpressionUUID->"fa8cbf14-27f2-1d4c-9012-7f56a94a46a1"],

Cell[BoxData["True"], "Output",ExpressionUUID->"229a90fb-24ac-3141-aa3f-ac8ee5706c61"],

Cell["\<\
Labels become numbered placeholders, which is what makes two hypergraphs \
differing only by a renaming of labels reduce to the same form:\
\>", "ExampleText",ExpressionUUID->"4aba31bb-4e62-9441-8612-67674c92b057"],

Cell["\<\
h1 = Hypergraph[{Edge[{1, 2}, \"Directed\", \"a\"], Edge[{2, 3}, \
\"Directed\", \"b\"]}];
h2 = Hypergraph[{Edge[{4, 5}, \"Directed\", \"x\"], Edge[{5, 6}, \
\"Directed\", \"y\"]}];
InputForm /@ {CanonicalHypergraph[h1], CanonicalHypergraph[h2]}\
\>", "Input",ExpressionUUID->"da2d8ca9-e56e-164e-be61-4c93461d6b4f"],

