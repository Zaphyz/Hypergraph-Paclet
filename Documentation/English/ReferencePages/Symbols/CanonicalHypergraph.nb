(* Beginning of Notebook Content *)
Notebook[{
Cell["CanonicalHypergraph", "ObjectName",ExpressionUUID->"b3240b52-f376-714d-aa8f-e20caa6275b7"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"CanonicalHypergraph", "[", "hg", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"b32bb069-e708-444c-be32-a2a6f9672bf0"],
 " ",
 "gives a canonical representative of the isomorphism class of hg."
}], "Usage",ExpressionUUID->"435ad94c-6967-a843-a8a8-b3f13b2c7a26"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"8ef5c353-4fe0-a341-8b59-2fab0b061898"],

Cell["\<\
The vertices of the result are renamed to 1, 2, ... and the labels are \
replaced by the placeholders \[FormalL][1], \[FormalL][2], ..., since labels \
count only up to renaming.\
\>", "Notes",ExpressionUUID->"fa8c97e0-425a-634b-b289-f8372aa861d0"],

Cell["\<\
Two hypergraphs are isomorphic exactly when their canonical forms are \
identical.\
\>", "Notes",ExpressionUUID->"13911911-8353-9a4c-9735-ccc2e23ef35c"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"\"\<Labeled\>\"", " ", "->", " ", "False"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"c2d47f0e-0f88-6d44-b4a6-c3f4a025c447"],
 " the skeleton is canonicalized instead, and the result carries no labels at \
all."
}], "Notes",ExpressionUUID->"8237a077-9e43-944e-9068-1092bcc73ec6"],

Cell[TextData[{
 "The setting ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"Method", " ", "->", " ", "Automatic"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"6fac3a74-66a3-ee4f-88ff-48ede9661bee"],
 " narrows the search by grouping vertices into classes that no isomorphism \
can mix up. ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"Method", " ", "->", " ", "\"\<BruteForce\>\""}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"74b6bf59-ea1a-8040-8ef4-2c87b644a14d"],
 " searches every ordering of the vertices instead, and exists to cross-check \
the default."
}], "Notes",ExpressionUUID->"8ce97a38-9aaa-8346-a75c-f8fc1d549307"],

Cell["\<\
Both Method settings are functions of the isomorphism class alone, so they \
always agree about whether two hypergraphs are isomorphic, but they settle on \
different representatives of the same class. The two settings must therefore \
not be mixed within a single comparison.\
\>", "Notes",ExpressionUUID->"068e4d6d-d2a3-cb4f-bcfe-19dcdf57bc05"],

Cell["\<\
The search is exhaustive. When it would exceed 40320 candidate orderings the \
message CanonicalHypergraph::large is produced and the computation proceeds.\
\>", "Notes",ExpressionUUID->"0346d711-4aa3-e147-b96d-5050e913a118"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"b7bfaf21-0695-1947-b870-cdb03b12a8da"],

Cell["\<\
Two spellings of the same directed path have the same canonical form:\
\>", "ExampleText",ExpressionUUID->"ffce19b6-bc02-1b4d-8667-d082d199f9f7"],

Cell["\<\
a = Hypergraph[{{1, 2}, {2, 3}}];
b = Hypergraph[{{10, 20}, {20, 30}}];
{CanonicalHypergraph[a], CanonicalHypergraph[b]}\
\>", "Input",ExpressionUUID->"5f5be042-26f3-1d48-bed8-5b7b6f36a7ec"],

