Cell["CanonicalHypergraph[a] === CanonicalHypergraph[b]", "Input",ExpressionUUID->"e33b7cf3-6bd0-8e4f-a6e8-7196aa7e5ec5"],

Cell[BoxData["True"], "Output",ExpressionUUID->"da48272b-a657-014d-8e97-057b7175ffcb"],

Cell["\<\
Labels become numbered placeholders, which is what makes two hypergraphs \
differing only by a renaming of labels reduce to the same form:\
\>", "ExampleText",ExpressionUUID->"86b7628f-f4c6-be41-afd8-0dbea427460e"],

Cell["\<\
h1 = Hypergraph[{Edge[{1, 2}, \"Directed\", \"a\"], Edge[{2, 3}, \
\"Directed\", \"b\"]}];
h2 = Hypergraph[{Edge[{4, 5}, \"Directed\", \"x\"], Edge[{5, 6}, \
\"Directed\", \"y\"]}];
InputForm /@ {CanonicalHypergraph[h1], CanonicalHypergraph[h2]}\
\>", "Input",ExpressionUUID->"06cdf721-e133-dc4b-846b-ff9e662862f6"],

