(* Beginning of Notebook Content *)
Notebook[{
Cell["CanonicalHypergraph", "ObjectName",ExpressionUUID->"c3c70c17-d364-db40-baab-04fa412b15a8"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"CanonicalHypergraph", "[", "hg", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"9498cbea-9fc1-2742-988c-9e028ea2d017"],
 " ",
 "gives a canonical representative of the isomorphism class of hg."
}], "Usage",ExpressionUUID->"d7f98d2f-b721-9946-b655-8b1613b94161"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"f548e088-4dfd-ee4c-b627-f177067824f3"],

Cell["\<\
The vertices of the result are renamed to 1, 2, ... and the labels are \
replaced by the placeholders \[FormalL][1], \[FormalL][2], ..., since labels \
count only up to renaming.\
\>", "Notes",ExpressionUUID->"38742e8e-879c-b440-b248-8b8b95536719"],

Cell["\<\
Two hypergraphs are isomorphic exactly when their canonical forms are \
identical.\
\>", "Notes",ExpressionUUID->"06a67117-097f-fa47-9425-790b4c6e86b2"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"\"\<Labeled\>\"", " ", "->", " ", "False"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"76627848-3bc6-3c45-a2c4-325c743b66b7"],
 " the skeleton is canonicalized instead, and the result carries no labels at \
all."
}], "Notes",ExpressionUUID->"4a5576c9-ee4a-6246-9a25-9f6f8d3979d0"],

Cell[TextData[{
 "The setting ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"Method", " ", "->", " ", "Automatic"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"2fd179d5-72f8-c843-9358-bfae1a2db873"],
 " narrows the search by grouping vertices into classes that no isomorphism \
can mix up. ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"Method", " ", "->", " ", "\"\<BruteForce\>\""}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"1f99ed2a-d440-cd4c-a8bc-be0a017641dd"],
 " searches every ordering of the vertices instead, and exists to cross-check \
the default."
}], "Notes",ExpressionUUID->"139609bd-8e94-fa45-a328-f5ff6e64eb43"],

Cell["\<\
Both Method settings are functions of the isomorphism class alone, so they \
always agree about whether two hypergraphs are isomorphic, but they settle on \
different representatives of the same class. The two settings must therefore \
not be mixed within a single comparison.\
\>", "Notes",ExpressionUUID->"cf99c3b8-6767-5443-8b3b-8f53ef3a99a3"],

Cell["\<\
The search is exhaustive. When it would exceed 40320 candidate orderings the \
message CanonicalHypergraph::large is produced and the computation proceeds.\
\>", "Notes",ExpressionUUID->"10ee341e-57b5-624a-aa49-5dd2782ff475"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"ec877da6-05d6-3644-96b3-ccf89cb2a80e"],

Cell["\<\
Two spellings of the same directed path have the same canonical form:\
\>", "ExampleText",ExpressionUUID->"7779c3b2-e899-2340-8821-b952f558262d"],

Cell["\<\
a = Hypergraph[{{1, 2}, {2, 3}}];
b = Hypergraph[{{10, 20}, {20, 30}}];
{CanonicalHypergraph[a], CanonicalHypergraph[b]}\
\>", "Input",ExpressionUUID->"e5d99a0b-0c4b-3344-a96a-b22b19e78c0c"],

