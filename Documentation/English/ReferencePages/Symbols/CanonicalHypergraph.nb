Cell["CanonicalHypergraph[a] === CanonicalHypergraph[b]", "Input",ExpressionUUID->"ae7875f6-aae0-e045-9be5-69328a5d4f19"],

Cell[BoxData["True"], "Output",ExpressionUUID->"501dbdab-f52a-4843-85fa-b1e9a3b7c1ac"],

Cell["\<\
Labels become numbered placeholders, which is what makes two hypergraphs \
differing only by a renaming of labels reduce to the same form:\
\>", "ExampleText",ExpressionUUID->"598bd6e8-747e-ab45-98d0-17841bd33741"],

Cell["\<\
h1 = Hypergraph[{Edge[{1, 2}, \"Directed\", \"a\"], Edge[{2, 3}, \
\"Directed\", \"b\"]}];
h2 = Hypergraph[{Edge[{4, 5}, \"Directed\", \"x\"], Edge[{5, 6}, \
\"Directed\", \"y\"]}];
InputForm /@ {CanonicalHypergraph[h1], CanonicalHypergraph[h2]}\
\>", "Input",ExpressionUUID->"94fc4a11-8d3c-9648-b092-b0e8c0cfc8d0"],

