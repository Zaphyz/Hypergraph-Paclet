Notebook[{
Cell["Edge", "ObjectName",ExpressionUUID->"9419a9ed-5611-7244-8e36-77493955899b"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Edge", "[", 
    RowBox[{"{", 
     RowBox[{"v1", ",", " ", "v2", ",", " ", "..."}], "}"}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "6d778c48-66b5-0e46-8020-7149e108cc0a"],
 " ",
 "represents a directed, unlabelled hyperedge on the given vertices."
}], "Usage",ExpressionUUID->"7a0a3c09-f6c9-f04f-a0d0-ae4be27f41fe"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Edge", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v1", ",", " ", "v2", ",", " ", "..."}], "}"}], ",", " ", 
     "sym"}], "]"}], "InlineCode"]], "InlineFormula",ExpressionUUID->
  "f8af22ad-dba3-4547-9880-41904e80886d"],
 " ",
 "gives the hyperedge the symmetry type sym."
}], "Usage",ExpressionUUID->"ca032360-b79e-934a-82b0-b03785969f5b"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Edge", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v1", ",", " ", "v2", ",", " ", "..."}], "}"}], ",", " ", "sym",
      ",", " ", "lab"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"77baaf87-f37b-7444-aa41-4e2a8112fd65"],
 " ",
 "additionally labels the hyperedge with lab."
}], "Usage",ExpressionUUID->"08c0c103-e5db-8d4e-b773-b45832070b6f"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"b075fe1d-ce43-fe4b-ab05-a7952870159a"],

Cell["\<\
The symmetry type sym is one of \"Directed\" (the default), \"Unordered\" or \
\"Cyclic\".\
\>", "Notes",ExpressionUUID->"d7eac12e-4924-144b-a776-9258945aaace"],

Cell["\<\
The symmetry types are strings rather than symbols because Cyclic is already \
a protected System` symbol. \"Ordered\" is accepted as a synonym for \
\"Directed\", and the spelling is case-insensitive on input, but the stored \
form is always one of the three canonical strings.\
\>", "Notes",ExpressionUUID->"80e59ddc-347e-5446-871a-2aead29561df"],

Cell["\<\
Vertices may be given as bare identifiers or as Vertex objects.\
\>", "Notes",ExpressionUUID->"43109307-9dea-0749-9228-915eaffbec40"],

Cell["\<\
The stored vertex list is put into the canonical order of its symmetry type: \
an unordered edge is sorted, a cyclic edge is rotated to its least rotation, \
and a directed edge is left as given. Two Edge objects are therefore \
identical exactly when they are the same hyperedge.\
\>", "Notes",ExpressionUUID->"ffc77a15-9edf-5846-b716-e0896b8b3ea3"],

Cell["\<\
The symmetry type and the label are both part of an edge's identity. The \
symmetry type is always shown in the stored form, even when it is the \
default, because it changes the mathematics of the edge; the label is omitted \
when absent.\
\>", "Notes",ExpressionUUID->"6dcbf982-e9a3-2b4e-be7b-0f6bddddcd5b"],

Cell["\<\
An edge may repeat a vertex, and may have any arity, including zero.\
\>", "Notes",ExpressionUUID->"03efd105-1733-a84a-9489-47f7ffe617cd"],

Cell["\<\
An unrecognized symmetry type produces the message Edge::sym and returns \
$Failed.\
\>", "Notes",ExpressionUUID->"40249249-4026-8f42-896c-fe77468a8150"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"03d28072-40c3-8f47-aca1-9d4fe5c53ce1"],

Cell["The default symmetry type is \"Directed\":", "ExampleText",ExpressionUUID->"52e378a2-2cf7-b342-9399-9807d6043d01"],

Cell["Edge[{1, 2, 3}]", "Input",ExpressionUUID->"32b170d6-9e09-4942-81a9-e2b2810cbf4c"],

Cell[BoxData[
 RowBox[{"Edge", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Vertex", "[", "1", "]"}], ",", 
     RowBox[{"Vertex", "[", "2", "]"}], ",", 
     RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", "\<\"Directed\"\>"}], 
  "]"}]], "Output",ExpressionUUID->"07898d29-f04a-d24e-b739-455cab6f9192"],

Cell["The three symmetry types:", "ExampleText",ExpressionUUID->"18962849-dd35-f04a-ac2e-488e0e337126"],

Cell["\<\
{Edge[{1, 2, 3}, \"Directed\"], Edge[{1, 2, 3}, \"Unordered\"], Edge[{1, 2, \
3}, \"Cyclic\"]}\
\>", "Input",ExpressionUUID->"43d2ff31-8d0c-3a48-b147-a592219d75ce"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Edge", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Vertex", "[", "1", "]"}], ",", 
       RowBox[{"Vertex", "[", "2", "]"}], ",", 
       RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", "\<\"Directed\"\>"}], 
    "]"}], ",", 
   RowBox[{"Edge", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Vertex", "[", "1", "]"}], ",", 
       RowBox[{"Vertex", "[", "2", "]"}], ",", 
       RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", "\<\"Unordered\"\>"}],
     "]"}], ",", 
   RowBox[{"Edge", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Vertex", "[", "1", "]"}], ",", 
       RowBox[{"Vertex", "[", "2", "]"}], ",", 
       RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", "\<\"Cyclic\"\>"}], 
    "]"}]}], "}"}]], "Output",ExpressionUUID->"d2fb1193-7ca2-b74f-a4ac-\
3296dd6493bd"],

Cell["A labelled edge:", "ExampleText",ExpressionUUID->"133d69f2-0f50-6244-a958-39bcdf3f4b77"],

Cell["Edge[{1, 2, 3}, \"Cyclic\", \"f\"]", "Input",ExpressionUUID->"9304dcb8-100f-844e-a26e-6938fad0673d"],

Cell[BoxData[
 RowBox[{"Edge", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Vertex", "[", "1", "]"}], ",", 
     RowBox[{"Vertex", "[", "2", "]"}], ",", 
     RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", "\<\"Cyclic\"\>", 
   ",", "\<\"f\"\>"}], "]"}]], "Output",ExpressionUUID->"10637a59-00e3-7148-\
ae53-11151fe51f48"],

Cell["\<\
The stored vertex order is the least member of the symmetry orbit:\
\>", "ExampleText",ExpressionUUID->"21f61665-eb4a-1948-a89e-f160b78b2b4d"],

Cell["\<\
{Edge[{3, 2, 1}, \"Unordered\"], Edge[{3, 1, 2}, \"Cyclic\"], Edge[{3, 2, 1}]}\
\>", "Input",ExpressionUUID->"afdcabc7-8222-e642-a424-353ebfd4ef63"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Edge", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Vertex", "[", "1", "]"}], ",", 
       RowBox[{"Vertex", "[", "2", "]"}], ",", 
       RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", "\<\"Unordered\"\>"}],
     "]"}], ",", 
   RowBox[{"Edge", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Vertex", "[", "1", "]"}], ",", 
       RowBox[{"Vertex", "[", "2", "]"}], ",", 
       RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", "\<\"Cyclic\"\>"}], 
    "]"}], ",", 
   RowBox[{"Edge", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Vertex", "[", "3", "]"}], ",", 
       RowBox[{"Vertex", "[", "2", "]"}], ",", 
       RowBox[{"Vertex", "[", "1", "]"}]}], "}"}], ",", "\<\"Directed\"\>"}], 
    "]"}]}], "}"}]], "Output",ExpressionUUID->"c603aec0-9e41-534b-b95d-\
79459fd98389"],

Cell["\<\
A rotation of a cyclic edge is the same edge, but a reflection is not, since \
the cyclic group contains rotations only:\
\>", "ExampleText",ExpressionUUID->"fabdcd2f-2e27-7e45-8685-5937394765b7"],

Cell["\<\
{Edge[{1, 2, 3}, \"Cyclic\"] === Edge[{3, 1, 2}, \"Cyclic\"],
 Edge[{1, 2, 3}, \"Cyclic\"] === Edge[{1, 3, 2}, \"Cyclic\"]}\
\>", "Input",ExpressionUUID->"862f302e-da0f-d047-880f-28d99f68433e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",ExpressionUUID->"ae2d09c7-\
d085-594c-87f5-67fdb3dfaf49"],

Cell["The symmetry type and the label are part of the identity:", \
"ExampleText",ExpressionUUID->"2a19e48b-5b21-2944-adbb-8ea9caba528d"],

Cell["\<\
{Edge[{1, 2}] === Edge[{1, 2}, \"Unordered\"],
 Edge[{1, 2}, \"Directed\", \"f\"] === Edge[{1, 2}]}\
\>", "Input",ExpressionUUID->"c2ce389e-cb0c-a14f-af38-dd1d57b7c45a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "False"}], "}"}]], "Output",ExpressionUUID->"4260a279-\
de75-0447-9ec4-ffdbf41eaae9"],

Cell["An edge of arity zero, and one that repeats a vertex:", "ExampleText",ExpressionUUID->"2cb9b9cd-a84f-7b47-ba02-cc31380db296"],

Cell["{Edge[{}], Edge[{1, 1, 2}, \"Unordered\"]}", "Input",ExpressionUUID->"018345b3-a1d7-b34d-a074-565d865d6d2a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Edge", "[", 
    RowBox[{
     RowBox[{"{", "}"}], ",", "\<\"Directed\"\>"}], "]"}], ",", 
   RowBox[{"Edge", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Vertex", "[", "1", "]"}], ",", 
       RowBox[{"Vertex", "[", "1", "]"}], ",", 
       RowBox[{"Vertex", "[", "2", "]"}]}], "}"}], ",", "\<\"Unordered\"\>"}],
     "]"}]}], "}"}]], "Output",ExpressionUUID->"f6e5737e-634d-394f-95ef-\
1d25a839b608"],

Cell["An unrecognized symmetry type is rejected:", "ExampleText",ExpressionUUID->"263132a0-11c5-ab4d-8c11-92764096e581"],

Cell["Quiet @ Edge[{1, 2}, \"Sideways\"]", "Input",ExpressionUUID->"2569fe60-3ffa-ee48-82a9-4141f677e059"],

Cell[BoxData["$Failed"], "Output",ExpressionUUID->"20862287-a3c8-f943-8696-546e136b2c37"],

Cell["Source", "NotesSection",ExpressionUUID->"a03958be-676f-ab40-8752-72870fe31a6c"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
