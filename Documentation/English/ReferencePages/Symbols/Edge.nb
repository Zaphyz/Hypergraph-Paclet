Notebook[{
Cell["Edge", "ObjectName",ExpressionUUID->"921dc29e-e6cb-8f4f-b626-2aef6290f9d4"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Edge", "[", 
    RowBox[{"{", 
     RowBox[{"v1", ",", " ", "v2", ",", " ", "..."}], "}"}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "2c6dab20-c6d0-6a49-adef-a8eaac17f03c"],
 " ",
 "represents a directed, unlabelled hyperedge on the given vertices."
}], "Usage",ExpressionUUID->"bae2c665-12c0-464a-b69c-26e11b211c71"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Edge", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v1", ",", " ", "v2", ",", " ", "..."}], "}"}], ",", " ", 
     "sym"}], "]"}], "InlineCode"]], "InlineFormula",ExpressionUUID->
  "3106d917-2417-6843-b542-9072898f627b"],
 " ",
 "gives the hyperedge the symmetry type sym."
}], "Usage",ExpressionUUID->"2be9d3de-7232-cd41-b3f5-8425747f2ec1"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Edge", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v1", ",", " ", "v2", ",", " ", "..."}], "}"}], ",", " ", "sym",
      ",", " ", "lab"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"317af563-7af6-6843-918d-8c177506d07c"],
 " ",
 "additionally labels the hyperedge with lab."
}], "Usage",ExpressionUUID->"246902bd-576c-6d4a-a5c6-64a40f8f0837"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"dac34107-1288-9c49-a4d1-b21d3d6ac5c0"],

Cell["\<\
The symmetry type sym is one of \"Directed\" (the default), \"Unordered\" or \
\"Cyclic\".\
\>", "Notes",ExpressionUUID->"cb658de0-ebc8-5a48-a46c-58149832e563"],

Cell["\<\
The symmetry types are strings rather than symbols because Cyclic is already \
a protected System` symbol. \"Ordered\" is accepted as a synonym for \
\"Directed\", and the spelling is case-insensitive on input, but the stored \
form is always one of the three canonical strings.\
\>", "Notes",ExpressionUUID->"179d9680-b8b4-214f-957d-dd6fdf4e7e1c"],

Cell["\<\
Vertices may be given as bare identifiers or as Vertex objects.\
\>", "Notes",ExpressionUUID->"24fd1081-260b-6748-8c1d-fbc979787c82"],

Cell["\<\
The stored vertex list is put into the canonical order of its symmetry type: \
an unordered edge is sorted, a cyclic edge is rotated to its least rotation, \
and a directed edge is left as given. Two Edge objects are therefore \
identical exactly when they are the same hyperedge.\
\>", "Notes",ExpressionUUID->"bd33390b-0def-7e4d-94a3-e4e5a0fb7edd"],

Cell["\<\
The symmetry type and the label are both part of an edge's identity. The \
symmetry type is always shown in the stored form, even when it is the \
default, because it changes the mathematics of the edge; the label is omitted \
when absent.\
\>", "Notes",ExpressionUUID->"ca038d17-dbad-c64d-b519-da801a9f68a7"],

Cell["\<\
An edge may repeat a vertex, and may have any arity, including zero.\
\>", "Notes",ExpressionUUID->"947a5bf0-0767-a743-82e9-1303391b7339"],

Cell["\<\
An unrecognized symmetry type produces the message Edge::sym and returns \
$Failed.\
\>", "Notes",ExpressionUUID->"3160fd2a-9e61-9f40-8e5b-6fdc6a087acf"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"6057e2e6-2daa-634d-ae9c-49a2b758824e"],

Cell["The default symmetry type is \"Directed\":", "ExampleText",ExpressionUUID->"275f76fc-149f-4846-97cf-1b9bdef38f99"],

Cell["Edge[{1, 2, 3}]", "Input",ExpressionUUID->"4da44739-a118-5c4f-9f61-61bc5f328983"],

Cell[BoxData[
 RowBox[{"Edge", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Vertex", "[", "1", "]"}], ",", 
     RowBox[{"Vertex", "[", "2", "]"}], ",", 
     RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", "\<\"Directed\"\>"}], 
  "]"}]], "Output",ExpressionUUID->"0049398e-89d3-ec4a-a9b4-0d41a466872e"],

Cell["The three symmetry types:", "ExampleText",ExpressionUUID->"c403edeb-ce03-c346-b3ef-c0272ccf3b41"],

Cell["\<\
{Edge[{1, 2, 3}, \"Directed\"], Edge[{1, 2, 3}, \"Unordered\"], Edge[{1, 2, \
3}, \"Cyclic\"]}\
\>", "Input",ExpressionUUID->"461fd246-cd9f-9f41-b2d6-27e9d7b41056"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Edge", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Vertex", "[", "1", "]"}], ",", 
       RowBox[{"Vertex", "[", "2", "]"}], ",", 
       RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", "\<\"Directed\"\>"}], 
    "]"}], ",", 
   RowBox[{"Edge", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Vertex", "[", "1", "]"}], ",", 
       RowBox[{"Vertex", "[", "2", "]"}], ",", 
       RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", "\<\"Unordered\"\>"}],
     "]"}], ",", 
   RowBox[{"Edge", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Vertex", "[", "1", "]"}], ",", 
       RowBox[{"Vertex", "[", "2", "]"}], ",", 
       RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", "\<\"Cyclic\"\>"}], 
    "]"}]}], "}"}]], "Output",ExpressionUUID->"62fee7a1-c30b-8b4c-94fc-\
c9d34edb1184"],

Cell["A labelled edge:", "ExampleText",ExpressionUUID->"3ba1d6ee-222e-6647-8961-a469eb9574b6"],

Cell["Edge[{1, 2, 3}, \"Cyclic\", \"f\"]", "Input",ExpressionUUID->"be7dcc91-da48-c649-b7b9-66748aa7967f"],

Cell[BoxData[
 RowBox[{"Edge", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Vertex", "[", "1", "]"}], ",", 
     RowBox[{"Vertex", "[", "2", "]"}], ",", 
     RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", "\<\"Cyclic\"\>", 
   ",", "\<\"f\"\>"}], "]"}]], "Output",ExpressionUUID->"b580b080-074f-9644-\
88ae-ab136688f238"],

Cell["\<\
The stored vertex order is the least member of the symmetry orbit:\
\>", "ExampleText",ExpressionUUID->"b4e07491-1103-5c4e-9b5e-f0bb2d77e5b7"],

Cell["\<\
{Edge[{3, 2, 1}, \"Unordered\"], Edge[{3, 1, 2}, \"Cyclic\"], Edge[{3, 2, 1}]}\
\>", "Input",ExpressionUUID->"cb4190b7-a00f-824b-8e95-24c481df4708"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Edge", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Vertex", "[", "1", "]"}], ",", 
       RowBox[{"Vertex", "[", "2", "]"}], ",", 
       RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", "\<\"Unordered\"\>"}],
     "]"}], ",", 
   RowBox[{"Edge", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Vertex", "[", "1", "]"}], ",", 
       RowBox[{"Vertex", "[", "2", "]"}], ",", 
       RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", "\<\"Cyclic\"\>"}], 
    "]"}], ",", 
   RowBox[{"Edge", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Vertex", "[", "3", "]"}], ",", 
       RowBox[{"Vertex", "[", "2", "]"}], ",", 
       RowBox[{"Vertex", "[", "1", "]"}]}], "}"}], ",", "\<\"Directed\"\>"}], 
    "]"}]}], "}"}]], "Output",ExpressionUUID->"7a664d38-6407-6b49-a436-\
84087dd1eb1b"],

Cell["\<\
A rotation of a cyclic edge is the same edge, but a reflection is not, since \
the cyclic group contains rotations only:\
\>", "ExampleText",ExpressionUUID->"96271f18-d93e-3249-a5a1-69b7e8b2b543"],

Cell["\<\
{Edge[{1, 2, 3}, \"Cyclic\"] === Edge[{3, 1, 2}, \"Cyclic\"],
 Edge[{1, 2, 3}, \"Cyclic\"] === Edge[{1, 3, 2}, \"Cyclic\"]}\
\>", "Input",ExpressionUUID->"ebc85f1b-a1d0-0941-95da-bec0b25e0209"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",ExpressionUUID->"caa01055-\
f99a-6342-b6ba-3094945a6f73"],

Cell["The symmetry type and the label are part of the identity:", \
"ExampleText",ExpressionUUID->"33b595ed-6f17-a44e-9114-61b868b0f3b3"],

Cell["\<\
{Edge[{1, 2}] === Edge[{1, 2}, \"Unordered\"],
 Edge[{1, 2}, \"Directed\", \"f\"] === Edge[{1, 2}]}\
\>", "Input",ExpressionUUID->"14e744b6-49ee-6a43-80fe-0c767c7ad689"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "False"}], "}"}]], "Output",ExpressionUUID->"a4dcd9df-\
73ad-f749-a3d7-fd71c63765f9"],

Cell["An edge of arity zero, and one that repeats a vertex:", "ExampleText",ExpressionUUID->"ef46b12a-2ead-f444-9a3f-7fae2743e222"],

Cell["{Edge[{}], Edge[{1, 1, 2}, \"Unordered\"]}", "Input",ExpressionUUID->"b4df9c0f-699d-e247-b671-c545eabaf867"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Edge", "[", 
    RowBox[{
     RowBox[{"{", "}"}], ",", "\<\"Directed\"\>"}], "]"}], ",", 
   RowBox[{"Edge", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Vertex", "[", "1", "]"}], ",", 
       RowBox[{"Vertex", "[", "1", "]"}], ",", 
       RowBox[{"Vertex", "[", "2", "]"}]}], "}"}], ",", "\<\"Unordered\"\>"}],
     "]"}]}], "}"}]], "Output",ExpressionUUID->"3124ef30-5144-d941-b78d-\
c00cf6a3154f"],

Cell["An unrecognized symmetry type is rejected:", "ExampleText",ExpressionUUID->"349d5270-f938-5a4e-a9af-4dbf9c3cb000"],

Cell["Quiet @ Edge[{1, 2}, \"Sideways\"]", "Input",ExpressionUUID->"13a932e0-8739-fd47-a003-dbd9cc6fef82"],

Cell[BoxData["$Failed"], "Output",ExpressionUUID->"e10f3aa5-2790-2c4e-9b08-ce8b3d389b03"],

Cell["Source", "NotesSection",ExpressionUUID->"a4891ee1-c02a-874c-95e5-914c87edb11b"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
