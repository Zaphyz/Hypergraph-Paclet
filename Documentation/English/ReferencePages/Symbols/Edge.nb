Notebook[{
Cell["Edge", "ObjectName",ExpressionUUID->"301a86d7-78d0-8a49-9635-11589e1dd427"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Edge", "[", 
    RowBox[{"{", 
     RowBox[{"v1", ",", " ", "v2", ",", " ", "..."}], "}"}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "4bafb454-4b03-e240-be45-e19b719e236d"],
 " ",
 "represents a directed, unlabelled hyperedge on the given vertices."
}], "Usage",ExpressionUUID->"2373284b-26ad-574c-b8ff-b6769ba0ba35"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Edge", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v1", ",", " ", "v2", ",", " ", "..."}], "}"}], ",", " ", 
     "sym"}], "]"}], "InlineCode"]], "InlineFormula",ExpressionUUID->
  "4ed6565a-76e1-bd47-96ee-8022ae052b94"],
 " ",
 "gives the hyperedge the symmetry type sym."
}], "Usage",ExpressionUUID->"48a58918-9b26-9c4e-bdd5-657522553b90"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Edge", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v1", ",", " ", "v2", ",", " ", "..."}], "}"}], ",", " ", "sym",
      ",", " ", "lab"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"cffe9785-fb94-1f4a-9b27-f7dd01d90e44"],
 " ",
 "additionally labels the hyperedge with lab."
}], "Usage",ExpressionUUID->"546872eb-a950-8848-a4a0-43785fc8ed89"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"32bf9399-a23e-4e4d-8d81-3fdf1b736f04"],

Cell["\<\
The symmetry type sym is one of \"Directed\" (the default), \"Unordered\" or \
\"Cyclic\".\
\>", "Notes",ExpressionUUID->"ba9196fa-df8a-6a45-9335-9abf65d350da"],

Cell["\<\
The symmetry types are strings rather than symbols because Cyclic is already \
a protected System` symbol. \"Ordered\" is accepted as a synonym for \
\"Directed\", and the spelling is case-insensitive on input, but the stored \
form is always one of the three canonical strings.\
\>", "Notes",ExpressionUUID->"b324f25c-3095-614e-bfb7-3c9b62f4eb67"],

Cell["\<\
Vertices may be given as bare identifiers or as Vertex objects.\
\>", "Notes",ExpressionUUID->"bfbef843-3698-ac47-bdf0-fe40a79e49b4"],

Cell["\<\
The stored vertex list is put into the canonical order of its symmetry type: \
an unordered edge is sorted, a cyclic edge is rotated to its least rotation, \
and a directed edge is left as given. Two Edge objects are therefore \
identical exactly when they are the same hyperedge.\
\>", "Notes",ExpressionUUID->"74d72a46-683b-914d-a472-2f8620be8abb"],

Cell["\<\
The symmetry type and the label are both part of an edge's identity. The \
symmetry type is always shown in the stored form, even when it is the \
default, because it changes the mathematics of the edge; the label is omitted \
when absent.\
\>", "Notes",ExpressionUUID->"0fb0c2b8-491b-2945-b2be-2b547c2800f7"],

Cell["\<\
An edge may repeat a vertex, and may have any arity, including zero.\
\>", "Notes",ExpressionUUID->"51622856-f782-f14b-9c44-05f59e03faea"],

Cell["\<\
An unrecognized symmetry type produces the message Edge::sym and returns \
$Failed.\
\>", "Notes",ExpressionUUID->"aedcb95c-8653-264c-abc3-e61c2cd4db03"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"09ac8cd2-c88e-f443-bde1-cd0c882d564d"],

Cell["The default symmetry type is \"Directed\":", "ExampleText",ExpressionUUID->"37ce70c1-a5a4-6c43-adbb-c80770519b96"],

Cell["Edge[{1, 2, 3}]", "Input",ExpressionUUID->"42845100-63c5-0941-9098-718a0b99780f"],

Cell[BoxData[
 RowBox[{"Edge", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Vertex", "[", "1", "]"}], ",", 
     RowBox[{"Vertex", "[", "2", "]"}], ",", 
     RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", "\<\"Directed\"\>"}], 
  "]"}]], "Output",ExpressionUUID->"fabdb812-f78c-b44a-930f-8746a0ff886b"],

Cell["The three symmetry types:", "ExampleText",ExpressionUUID->"71b5fc5f-6ef3-aa41-8fd2-488661e32c47"],

Cell["\<\
{Edge[{1, 2, 3}, \"Directed\"], Edge[{1, 2, 3}, \"Unordered\"], Edge[{1, 2, \
3}, \"Cyclic\"]}\
\>", "Input",ExpressionUUID->"64c1c129-195f-dc4e-95d3-76841bed8aa1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Edge", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Vertex", "[", "1", "]"}], ",", 
       RowBox[{"Vertex", "[", "2", "]"}], ",", 
       RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", "\<\"Directed\"\>"}], 
    "]"}], ",", 
   RowBox[{"Edge", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Vertex", "[", "1", "]"}], ",", 
       RowBox[{"Vertex", "[", "2", "]"}], ",", 
       RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", "\<\"Unordered\"\>"}],
     "]"}], ",", 
   RowBox[{"Edge", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Vertex", "[", "1", "]"}], ",", 
       RowBox[{"Vertex", "[", "2", "]"}], ",", 
       RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", "\<\"Cyclic\"\>"}], 
    "]"}]}], "}"}]], "Output",ExpressionUUID->"f011de41-0db9-e740-9ba6-\
bfe1246a261c"],

Cell["A labelled edge:", "ExampleText",ExpressionUUID->"8d083c2a-60e7-b34c-a27a-c3abed152e60"],

Cell["Edge[{1, 2, 3}, \"Cyclic\", \"f\"]", "Input",ExpressionUUID->"9c8afd29-5b46-3545-b899-12eb9fccf774"],

Cell[BoxData[
 RowBox[{"Edge", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Vertex", "[", "1", "]"}], ",", 
     RowBox[{"Vertex", "[", "2", "]"}], ",", 
     RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", "\<\"Cyclic\"\>", 
   ",", "\<\"f\"\>"}], "]"}]], "Output",ExpressionUUID->"b14dcaaf-7bd1-eb43-\
8f6a-c0fed0f1b41f"],

Cell["\<\
The stored vertex order is the least member of the symmetry orbit:\
\>", "ExampleText",ExpressionUUID->"c0215743-9573-d64f-842b-82ee3d15b408"],

Cell["\<\
{Edge[{3, 2, 1}, \"Unordered\"], Edge[{3, 1, 2}, \"Cyclic\"], Edge[{3, 2, 1}]}\
\>", "Input",ExpressionUUID->"ab8f230d-cf5d-7144-9d2f-38196ce9d6aa"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Edge", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Vertex", "[", "1", "]"}], ",", 
       RowBox[{"Vertex", "[", "2", "]"}], ",", 
       RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", "\<\"Unordered\"\>"}],
     "]"}], ",", 
   RowBox[{"Edge", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Vertex", "[", "1", "]"}], ",", 
       RowBox[{"Vertex", "[", "2", "]"}], ",", 
       RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", "\<\"Cyclic\"\>"}], 
    "]"}], ",", 
   RowBox[{"Edge", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Vertex", "[", "3", "]"}], ",", 
       RowBox[{"Vertex", "[", "2", "]"}], ",", 
       RowBox[{"Vertex", "[", "1", "]"}]}], "}"}], ",", "\<\"Directed\"\>"}], 
    "]"}]}], "}"}]], "Output",ExpressionUUID->"0d6790fc-529e-d349-8468-\
c7baf6081a22"],

Cell["\<\
A rotation of a cyclic edge is the same edge, but a reflection is not, since \
the cyclic group contains rotations only:\
\>", "ExampleText",ExpressionUUID->"99a45af5-94b7-e44f-9cfd-e846a3f81d86"],

Cell["\<\
{Edge[{1, 2, 3}, \"Cyclic\"] === Edge[{3, 1, 2}, \"Cyclic\"],
 Edge[{1, 2, 3}, \"Cyclic\"] === Edge[{1, 3, 2}, \"Cyclic\"]}\
\>", "Input",ExpressionUUID->"36eaf6f7-7100-8a4a-bde3-6c28528a7591"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",ExpressionUUID->"c02a1c4c-\
2a33-194c-a234-1b7ad0c84e0d"],

Cell["The symmetry type and the label are part of the identity:", \
"ExampleText",ExpressionUUID->"5676d3de-71d8-e443-8c46-844b77f49906"],

Cell["\<\
{Edge[{1, 2}] === Edge[{1, 2}, \"Unordered\"],
 Edge[{1, 2}, \"Directed\", \"f\"] === Edge[{1, 2}]}\
\>", "Input",ExpressionUUID->"c9684888-7c61-9244-af85-a6f225eb42f9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "False"}], "}"}]], "Output",ExpressionUUID->"5ee57088-\
850a-634b-8b57-668913920372"],

Cell["An edge of arity zero, and one that repeats a vertex:", "ExampleText",ExpressionUUID->"6ebbdb42-f75e-994e-9906-cc3f6ef2cb2d"],

Cell["{Edge[{}], Edge[{1, 1, 2}, \"Unordered\"]}", "Input",ExpressionUUID->"e079ab01-5a57-7046-a8bb-36a4a0172c3a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Edge", "[", 
    RowBox[{
     RowBox[{"{", "}"}], ",", "\<\"Directed\"\>"}], "]"}], ",", 
   RowBox[{"Edge", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Vertex", "[", "1", "]"}], ",", 
       RowBox[{"Vertex", "[", "1", "]"}], ",", 
       RowBox[{"Vertex", "[", "2", "]"}]}], "}"}], ",", "\<\"Unordered\"\>"}],
     "]"}]}], "}"}]], "Output",ExpressionUUID->"e87fa4d4-3f3c-c543-a594-\
339917c5ff07"],

Cell["An unrecognized symmetry type is rejected:", "ExampleText",ExpressionUUID->"fbf82721-2625-8a4d-a4d6-e58cc9848010"],

Cell["Quiet @ Edge[{1, 2}, \"Sideways\"]", "Input",ExpressionUUID->"70f23dbc-9d23-fd47-90c8-5228895d8a38"],

Cell[BoxData["$Failed"], "Output",ExpressionUUID->"e34e91e5-add3-2546-80df-46b04b93a3fb"],

Cell["Source", "NotesSection",ExpressionUUID->"8a882e46-92db-8f49-ad3c-91d884673a85"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Edges",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"0022134e-82f5-8646-8e54-94e1cb0ef326"],

