Notebook[{
Cell["Edge", "ObjectName",ExpressionUUID->"76ba0090-4b3a-eb49-8299-39f026f3dd39"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Edge", "[", 
    RowBox[{"{", 
     RowBox[{"v1", ",", " ", "v2", ",", " ", "..."}], "}"}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "987039f6-8dda-2944-a2bf-b22bb774c374"],
 " ",
 "represents a directed, unlabelled hyperedge on the given vertices."
}], "Usage",ExpressionUUID->"9936314e-2595-0d4a-954f-652b769942f6"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Edge", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v1", ",", " ", "v2", ",", " ", "..."}], "}"}], ",", " ", 
     "sym"}], "]"}], "InlineCode"]], "InlineFormula",ExpressionUUID->
  "4c6fe3a5-cd56-bf47-bc8e-36ee4ca3c603"],
 " ",
 "gives the hyperedge the symmetry type sym."
}], "Usage",ExpressionUUID->"c4635712-7d76-724f-b271-925f0c2fe24c"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Edge", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v1", ",", " ", "v2", ",", " ", "..."}], "}"}], ",", " ", "sym",
      ",", " ", "lab"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"ca5d049a-5bc4-f34d-92c6-557f05ce5d52"],
 " ",
 "additionally labels the hyperedge with lab."
}], "Usage",ExpressionUUID->"fe56e788-93a9-2c43-ac62-2243426c34df"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"faa9cfa6-3ae2-b841-aef6-7459019d446d"],

Cell["\<\
The symmetry type sym is one of \"Directed\" (the default), \"Unordered\" or \
\"Cyclic\".\
\>", "Notes",ExpressionUUID->"7a3ea5f5-8e6b-0b48-b5ce-f9fb421eff2b"],

Cell["\<\
The symmetry types are strings rather than symbols because Cyclic is already \
a protected System` symbol. \"Ordered\" is accepted as a synonym for \
\"Directed\", and the spelling is case-insensitive on input, but the stored \
form is always one of the three canonical strings.\
\>", "Notes",ExpressionUUID->"b1b96df3-8451-3e49-85d9-3f88815e4516"],

Cell["\<\
Vertices may be given as bare identifiers or as Vertex objects.\
\>", "Notes",ExpressionUUID->"4793e1f0-0dc6-684d-af35-6365e1e8e022"],

Cell["\<\
The stored vertex list is put into the canonical order of its symmetry type: \
an unordered edge is sorted, a cyclic edge is rotated to its least rotation, \
and a directed edge is left as given. Two Edge objects are therefore \
identical exactly when they are the same hyperedge.\
\>", "Notes",ExpressionUUID->"97cc9db1-2329-b94b-a76f-f6223515d27b"],

Cell["\<\
The symmetry type and the label are both part of an edge's identity. The \
symmetry type is always shown in the stored form, even when it is the \
default, because it changes the mathematics of the edge; the label is omitted \
when absent.\
\>", "Notes",ExpressionUUID->"cfe5764a-a38a-1d44-ba94-6b6c3759310a"],

Cell["\<\
An edge may repeat a vertex, and may have any arity, including zero.\
\>", "Notes",ExpressionUUID->"0e110d38-efeb-1e4b-8edc-02d571a10783"],

Cell["\<\
An unrecognized symmetry type produces the message Edge::sym and returns \
$Failed.\
\>", "Notes",ExpressionUUID->"317065b7-cbe3-5a4c-8068-5398a05febe8"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"1d55706f-c09c-fe42-9372-3b7fbeb5cf87"],

Cell["The default symmetry type is \"Directed\":", "ExampleText",ExpressionUUID->"0bc5d0c6-86d1-c340-874c-bfde4a748378"],

Cell["Edge[{1, 2, 3}]", "Input",ExpressionUUID->"42e0a90a-f469-a44b-a61a-2ec14fa7f789"],

Cell[BoxData[
 RowBox[{"Edge", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Vertex", "[", "1", "]"}], ",", 
     RowBox[{"Vertex", "[", "2", "]"}], ",", 
     RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", "\<\"Directed\"\>"}], 
  "]"}]], "Output",ExpressionUUID->"a81a6588-620f-4949-8b13-67a81a3b0f9e"],

Cell["The three symmetry types:", "ExampleText",ExpressionUUID->"5f89553b-4147-e641-bfa3-4d4a82c5b2ff"],

Cell["\<\
{Edge[{1, 2, 3}, \"Directed\"], Edge[{1, 2, 3}, \"Unordered\"], Edge[{1, 2, \
3}, \"Cyclic\"]}\
\>", "Input",ExpressionUUID->"611a782c-b9e5-634f-b395-43fddb5f7df2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Edge", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Vertex", "[", "1", "]"}], ",", 
       RowBox[{"Vertex", "[", "2", "]"}], ",", 
       RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", "\<\"Directed\"\>"}], 
    "]"}], ",", 
   RowBox[{"Edge", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Vertex", "[", "1", "]"}], ",", 
       RowBox[{"Vertex", "[", "2", "]"}], ",", 
       RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", "\<\"Unordered\"\>"}],
     "]"}], ",", 
   RowBox[{"Edge", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Vertex", "[", "1", "]"}], ",", 
       RowBox[{"Vertex", "[", "2", "]"}], ",", 
       RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", "\<\"Cyclic\"\>"}], 
    "]"}]}], "}"}]], "Output",ExpressionUUID->"30c40e51-b177-5349-9b02-\
51ca76fb9149"],

Cell["A labelled edge:", "ExampleText",ExpressionUUID->"5ec87630-5237-af45-bd56-c26217f52886"],

Cell["Edge[{1, 2, 3}, \"Cyclic\", \"f\"]", "Input",ExpressionUUID->"7cb8ec91-5230-d34a-aee8-85f78a2ff0ec"],

Cell[BoxData[
 RowBox[{"Edge", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Vertex", "[", "1", "]"}], ",", 
     RowBox[{"Vertex", "[", "2", "]"}], ",", 
     RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", "\<\"Cyclic\"\>", 
   ",", "\<\"f\"\>"}], "]"}]], "Output",ExpressionUUID->"ab44a024-5770-7346-\
ad5d-67af8ff3c8bf"],

Cell["\<\
The stored vertex order is the least member of the symmetry orbit:\
\>", "ExampleText",ExpressionUUID->"c72a3087-bd5c-874f-bafb-bf4b6bc43a00"],

Cell["\<\
{Edge[{3, 2, 1}, \"Unordered\"], Edge[{3, 1, 2}, \"Cyclic\"], Edge[{3, 2, 1}]}\
\>", "Input",ExpressionUUID->"3c495bec-45bd-974b-b117-5de7df3bc624"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Edge", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Vertex", "[", "1", "]"}], ",", 
       RowBox[{"Vertex", "[", "2", "]"}], ",", 
       RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", "\<\"Unordered\"\>"}],
     "]"}], ",", 
   RowBox[{"Edge", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Vertex", "[", "1", "]"}], ",", 
       RowBox[{"Vertex", "[", "2", "]"}], ",", 
       RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", "\<\"Cyclic\"\>"}], 
    "]"}], ",", 
   RowBox[{"Edge", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Vertex", "[", "3", "]"}], ",", 
       RowBox[{"Vertex", "[", "2", "]"}], ",", 
       RowBox[{"Vertex", "[", "1", "]"}]}], "}"}], ",", "\<\"Directed\"\>"}], 
    "]"}]}], "}"}]], "Output",ExpressionUUID->"5bb96fe8-23b1-c94e-aaa8-\
1baa24f5b7b8"],

Cell["\<\
A rotation of a cyclic edge is the same edge, but a reflection is not, since \
the cyclic group contains rotations only:\
\>", "ExampleText",ExpressionUUID->"28a03e8a-22b2-9f49-9d1c-91c281001527"],

Cell["\<\
{Edge[{1, 2, 3}, \"Cyclic\"] === Edge[{3, 1, 2}, \"Cyclic\"],
 Edge[{1, 2, 3}, \"Cyclic\"] === Edge[{1, 3, 2}, \"Cyclic\"]}\
\>", "Input",ExpressionUUID->"2ad52491-fc29-ab41-99de-0d912fbd9e4f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",ExpressionUUID->"6ed4ffa5-\
a341-1940-8ab9-ebcee9736c67"],

Cell["The symmetry type and the label are part of the identity:", \
"ExampleText",ExpressionUUID->"3c55293d-63a8-2046-b7eb-d7bf44197cef"],

Cell["\<\
{Edge[{1, 2}] === Edge[{1, 2}, \"Unordered\"],
 Edge[{1, 2}, \"Directed\", \"f\"] === Edge[{1, 2}]}\
\>", "Input",ExpressionUUID->"69ebd75c-d1e3-9a47-8f57-331fc93a8575"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "False"}], "}"}]], "Output",ExpressionUUID->"77c8b7a8-\
ac5d-ff44-9de0-1578a7231920"],

Cell["An edge of arity zero, and one that repeats a vertex:", "ExampleText",ExpressionUUID->"81419b8e-19ed-6d4f-867b-b4416e42afb7"],

Cell["{Edge[{}], Edge[{1, 1, 2}, \"Unordered\"]}", "Input",ExpressionUUID->"dbb74193-302b-1745-b377-665039358c14"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Edge", "[", 
    RowBox[{
     RowBox[{"{", "}"}], ",", "\<\"Directed\"\>"}], "]"}], ",", 
   RowBox[{"Edge", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Vertex", "[", "1", "]"}], ",", 
       RowBox[{"Vertex", "[", "1", "]"}], ",", 
       RowBox[{"Vertex", "[", "2", "]"}]}], "}"}], ",", "\<\"Unordered\"\>"}],
     "]"}]}], "}"}]], "Output",ExpressionUUID->"57fd2732-73a4-ff42-861e-\
5c21ad49eb51"],

Cell["An unrecognized symmetry type is rejected:", "ExampleText",ExpressionUUID->"026d2acb-148b-3346-92bb-8954a55ad2a0"],

Cell["Quiet @ Edge[{1, 2}, \"Sideways\"]", "Input",ExpressionUUID->"9d75d015-5c39-174f-91a0-2b1200c8d1c4"],

Cell[BoxData["$Failed"], "Output",ExpressionUUID->"8313c5c3-3ea1-7845-a564-1176c8f1ffc2"],

Cell["Source", "NotesSection",ExpressionUUID->"033904ea-44db-ef4d-a284-7e4dd8efbdb9"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
