Notebook[{
Cell["EdgeLabel", "ObjectName",ExpressionUUID->"743bd70f-7e01-c94b-ae6f-1dfb25f79cf8"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"EdgeLabel", "[", "e", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"9d819e3e-3fa1-4045-a6d5-6b7f895a6c33"],
 " ",
 "gives the label of the hyperedge e, or None if it is unlabelled."
}], "Usage",ExpressionUUID->"f389f035-8960-2d4a-8bcc-bb7617f2b488"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"702409b4-c4d1-f840-95e9-1b8529cf6c0d"],

Cell["\<\
Edge labels take part in labelled isomorphism, where they must correspond one \
to one; see IsomorphicHypergraphQ.\
\>", "Notes",ExpressionUUID->"f75ccbab-7022-7743-8294-823402ff0575"],

Cell["\<\
Edge labels and vertex labels are put in correspondence independently of one \
another.\
\>", "Notes",ExpressionUUID->"01f62e1b-2dea-014e-9503-0528df631071"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"c3dfc32d-ea9a-5548-8061-44fd05713c59"],

Cell["\<\
{EdgeLabel[Edge[{1, 2}, \"Directed\", \"f\"]], EdgeLabel[Edge[{1, 2}]]}\
\>", "Input",ExpressionUUID->"4c9add30-c3f3-3d40-bbf8-0485a358b704"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"f\"\>", ",", "None"}], "}"}]], "Output",ExpressionUUID->\
"d24e6155-7fe1-5849-92ed-e21d42122db1"],

Cell["\<\
The labels of a whole hypergraph, in the order of its edge list:\
\>", "ExampleText",ExpressionUUID->"726a7933-d49d-4646-b6a4-2f1d31f15e4e"],

Cell["\<\
Hypergraph[{Edge[{1, 2}, \"Directed\", \"f\"], Edge[{2, 3}]}][\"EdgeLabels\"]\
\
\>", "Input",ExpressionUUID->"cd33468e-8b8a-fe46-aaf2-842b2dbecffd"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"None", ",", "\<\"f\"\>"}], "}"}]], "Output",ExpressionUUID->\
"29795916-d696-cb49-895a-c249e671534e"],

Cell["Source", "NotesSection",ExpressionUUID->"4c424567-aa0f-8a46-aa8f-28ef0ea754a9"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Edges",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"19657a39-003a-3442-af99-773f687c136b"],

