Notebook[{
Cell["EdgeLabel", "ObjectName",ExpressionUUID->"8f56d66d-ae41-d640-89a0-80f62e110586"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"EdgeLabel", "[", "e", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"38708462-2b67-4443-b456-f0224e28bb00"],
 " ",
 "gives the label of the hyperedge e, or None if it is unlabelled."
}], "Usage",ExpressionUUID->"c18e5146-6e98-f042-8a7e-817e565ba3ea"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"6c0c0f60-9e92-8447-83a5-c4be3b9cb78c"],

Cell["\<\
Edge labels take part in labelled isomorphism, where they must correspond one \
to one; see IsomorphicHypergraphQ.\
\>", "Notes",ExpressionUUID->"9e3b1270-a64e-eb42-999b-56e56a58e42c"],

Cell["\<\
Edge labels and vertex labels are put in correspondence independently of one \
another.\
\>", "Notes",ExpressionUUID->"625648d6-b01d-6f4b-908e-660b7ae18063"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"7cca003d-5fc9-ef4e-b48e-42320f5e84f0"],

Cell["\<\
{EdgeLabel[Edge[{1, 2}, \"Directed\", \"f\"]], EdgeLabel[Edge[{1, 2}]]}\
\>", "Input",ExpressionUUID->"0a5b7e66-b516-9647-9bbb-6b42041f090d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"f\"\>", ",", "None"}], "}"}]], "Output",ExpressionUUID->\
"5986a507-3edb-4a41-85b1-af76078df6e3"],

Cell["\<\
The labels of a whole hypergraph, in the order of its edge list:\
\>", "ExampleText",ExpressionUUID->"8b3280b3-2bc7-f043-8c58-35c66d58d92e"],

Cell["\<\
Hypergraph[{Edge[{1, 2}, \"Directed\", \"f\"], Edge[{2, 3}]}][\"EdgeLabels\"]\
\
\>", "Input",ExpressionUUID->"5675cb6f-ee8c-b847-aab8-7d35a77f33f5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"None", ",", "\<\"f\"\>"}], "}"}]], "Output",ExpressionUUID->\
"34545bf7-5283-f74b-a1e9-d06810ab9e06"],

Cell["Source", "NotesSection",ExpressionUUID->"717440d9-2ae3-104a-9e9b-19d8de5af061"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Edges",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"110c0981-c673-a048-96c0-304b7e5e4211"],

