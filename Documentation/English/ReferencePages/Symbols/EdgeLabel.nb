Notebook[{
Cell["EdgeLabel", "ObjectName",ExpressionUUID->"e9f43986-a4f2-ef44-b645-a2c787b9f48b"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"EdgeLabel", "[", "e", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"d29b7db9-8183-a341-b317-617922953a15"],
 " ",
 "gives the label of the hyperedge e, or None if it is unlabelled."
}], "Usage",ExpressionUUID->"09b79861-18ae-ae42-9cc2-b7683313c625"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"b312ddd6-7d4e-d244-8eaa-e0c437055ce6"],

Cell["\<\
Edge labels take part in labelled isomorphism, where they must correspond one \
to one; see IsomorphicHypergraphQ.\
\>", "Notes",ExpressionUUID->"8dda1597-558d-9f4a-8ee1-807708955e6e"],

Cell["\<\
Edge labels and vertex labels are put in correspondence independently of one \
another.\
\>", "Notes",ExpressionUUID->"1f2a5b13-9614-c74c-996c-ef52087e5503"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"4ebb3975-1131-5145-a08c-a152e3df48db"],

Cell["\<\
{EdgeLabel[Edge[{1, 2}, \"Directed\", \"f\"]], EdgeLabel[Edge[{1, 2}]]}\
\>", "Input",ExpressionUUID->"fd9b13d3-20e8-7949-97f4-7f4ee6f1f817"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"f\"\>", ",", "None"}], "}"}]], "Output",ExpressionUUID->\
"a307ad3f-3127-ff48-abc9-6f99824b1dcc"],

Cell["\<\
The labels of a whole hypergraph, in the order of its edge list:\
\>", "ExampleText",ExpressionUUID->"f91c7555-ac40-c640-9f14-54b901fb86de"],

Cell["\<\
Hypergraph[{Edge[{1, 2}, \"Directed\", \"f\"], Edge[{2, 3}]}][\"EdgeLabels\"]\
\
\>", "Input",ExpressionUUID->"581b840f-1f38-2445-80a8-a729a4beecfe"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"None", ",", "\<\"f\"\>"}], "}"}]], "Output",ExpressionUUID->\
"dc7af7ba-5fd3-7c46-be4d-0672b1185185"],

Cell["Source", "NotesSection",ExpressionUUID->"a6d7ca1e-1bcc-7f43-83dd-34b453f8080a"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Edges",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"542e046b-c494-704c-adb8-5dca7c67086c"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"ef2f58a2-56fb-5f43-b0e0-e89c9eb8efb0"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["Edge", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "fd4f5396-a3b7-aa42-9f9d-ef5f7dc9be4f"],
 ", ",
 Cell[BoxData[
  StyleBox["VertexLabel", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "4212964f-939d-994d-961d-5223cc0ee046"],
 ", ",
 Cell[BoxData[
  StyleBox["IsomorphicHypergraphQ", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"91a325fc-56d5-4946-981e-d78697325ae3"],
