Notebook[{
Cell["EdgeLabel", "ObjectName",ExpressionUUID->"2420ff39-30a5-924b-87ed-141279ca6090"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"EdgeLabel", "[", "e", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"147c7a1c-42d5-fe47-8b61-36f87c2ea279"],
 " ",
 "gives the label of the hyperedge e, or None if it is unlabelled."
}], "Usage",ExpressionUUID->"121e2f3a-4e69-bd4f-a227-ee9a3cbae41e"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"b06b450b-af55-ff49-8682-6e512637159b"],

Cell["\<\
Edge labels take part in labelled isomorphism, where they must correspond one \
to one; see IsomorphicHypergraphQ.\
\>", "Notes",ExpressionUUID->"3e691d1b-1c69-e74b-9d14-4fe0068d568d"],

Cell["\<\
Edge labels and vertex labels are put in correspondence independently of one \
another.\
\>", "Notes",ExpressionUUID->"a5d5f15d-1582-e14c-846f-ec1d6a5e6c2b"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"dcde648f-1338-404f-9965-8c02f2664c64"],

Cell["\<\
{EdgeLabel[Edge[{1, 2}, \"Directed\", \"f\"]], EdgeLabel[Edge[{1, 2}]]}\
\>", "Input",ExpressionUUID->"776b4866-2da7-ce49-8d3e-ff2f65a3420f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"f\"\>", ",", "None"}], "}"}]], "Output",ExpressionUUID->\
"f33e5eae-361e-184c-b8d7-3ffe8b24f3b3"],

Cell["\<\
The labels of a whole hypergraph, in the order of its edge list:\
\>", "ExampleText",ExpressionUUID->"c23f0c5b-d7fd-f442-a584-484251d12818"],

Cell["\<\
Hypergraph[{Edge[{1, 2}, \"Directed\", \"f\"], Edge[{2, 3}]}][\"EdgeLabels\"]\
\
\>", "Input",ExpressionUUID->"b11c3aee-17c1-574d-ac9a-879dde4c76dc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"None", ",", "\<\"f\"\>"}], "}"}]], "Output",ExpressionUUID->\
"c30d793c-4af5-0b49-8efb-4efdebac12ff"],

Cell["Source", "NotesSection",ExpressionUUID->"4ba31893-03ec-0e4c-9733-d99103ceb923"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Edges",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"79e915d4-f3d4-1343-bddb-52339fffed6a"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"f514abcf-e957-5a4b-9d44-487c6f94d9f8"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["Edge", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "9dc41a76-088f-384c-b722-c0c95112af4f"],
 ", ",
 Cell[BoxData[
  StyleBox["VertexLabel", "InlineCode"]], "InlineFormula",ExpressionUUID->
