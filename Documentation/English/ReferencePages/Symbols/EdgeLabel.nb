Notebook[{
Cell["EdgeLabel", "ObjectName",ExpressionUUID->"55bbee9a-63cf-b14c-9524-9aeca6746ee0"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"EdgeLabel", "[", "e", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"b2538b27-3e02-d246-95be-f6834ea03666"],
 " ",
 "gives the label of the hyperedge e, or None if it is unlabelled."
}], "Usage",ExpressionUUID->"a7eb4142-e3f9-db4a-bff0-5f4b7cc5b456"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"e08c2fdc-431a-e644-8fe4-e6da5b07c7af"],

Cell["\<\
Edge labels take part in labelled isomorphism, where they must correspond one \
to one; see IsomorphicHypergraphQ.\
\>", "Notes",ExpressionUUID->"a0066f51-dbb4-f94d-8214-0e80862c7fb1"],

Cell["\<\
Edge labels and vertex labels are put in correspondence independently of one \
another.\
\>", "Notes",ExpressionUUID->"ee847290-fd93-d340-988a-e38a8939733c"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"dd1e7d71-1e25-9e42-9487-3eda252a2a7c"],

Cell["\<\
{EdgeLabel[Edge[{1, 2}, \"Directed\", \"f\"]], EdgeLabel[Edge[{1, 2}]]}\
\>", "Input",ExpressionUUID->"cba7cca0-2149-7b46-89c8-d0885afc6256"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"f\"\>", ",", "None"}], "}"}]], "Output",ExpressionUUID->\
"907d316d-218f-2341-8ecb-59b72df07cb2"],

Cell["\<\
The labels of a whole hypergraph, in the order of its edge list:\
\>", "ExampleText",ExpressionUUID->"024e1bfb-855d-a84f-9944-f345bf2620bc"],

Cell["\<\
Hypergraph[{Edge[{1, 2}, \"Directed\", \"f\"], Edge[{2, 3}]}][\"EdgeLabels\"]\
\
\>", "Input",ExpressionUUID->"599b7312-0e02-ef44-9303-de921b2ebfb4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"None", ",", "\<\"f\"\>"}], "}"}]], "Output",ExpressionUUID->\
"56477783-f311-1a4c-960b-7644df4f3abd"],

Cell["Source", "NotesSection",ExpressionUUID->"e79549ab-7452-244a-a84f-403f9bcfcf83"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Edges",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"83f35f21-d9f8-fa4c-be12-349ca16c3027"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"9e5cede4-e468-b94e-bbdd-17a9ee93485d"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["Edge", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "3778fd69-aa89-ea49-be6c-3276b7949e63"],
 ", ",
