Notebook[{
Cell["EdgeLabel", "ObjectName",ExpressionUUID->"f4a9e058-b7c1-8247-b8c9-c812b814ca36"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"EdgeLabel", "[", "e", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"80eac224-9064-b74b-aa0d-801476a03c0a"],
 " ",
 "gives the label of the hyperedge e, or None if it is unlabelled."
}], "Usage",ExpressionUUID->"3c3ff470-c8a3-a745-a6eb-1f81f86f020b"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"0000421d-056c-bf4b-a295-7d9fdf74f403"],

Cell["\<\
Edge labels take part in labelled isomorphism, where they must correspond one \
to one; see IsomorphicHypergraphQ.\
\>", "Notes",ExpressionUUID->"3d247797-973f-d141-ad17-c4ea60641aaa"],

Cell["\<\
Edge labels and vertex labels are put in correspondence independently of one \
another.\
\>", "Notes",ExpressionUUID->"aea0a9e4-5d6f-7847-bb59-b0a11d82a709"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"195a07c2-0b65-5f49-8d73-9d592e7c2749"],

Cell["\<\
{EdgeLabel[Edge[{1, 2}, \"Directed\", \"f\"]], EdgeLabel[Edge[{1, 2}]]}\
\>", "Input",ExpressionUUID->"431f9572-6b10-c049-b113-1874cb90d721"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"f\"\>", ",", "None"}], "}"}]], "Output",ExpressionUUID->\
"ac118eaa-97f4-8f40-a857-41125fd1fadc"],

Cell["\<\
The labels of a whole hypergraph, in the order of its edge list:\
\>", "ExampleText",ExpressionUUID->"a224632b-c07c-ca4c-b698-2493019b05c7"],

Cell["\<\
Hypergraph[{Edge[{1, 2}, \"Directed\", \"f\"], Edge[{2, 3}]}][\"EdgeLabels\"]\
\
\>", "Input",ExpressionUUID->"8275e628-8850-e240-a2a5-5b767c201262"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"None", ",", "\<\"f\"\>"}], "}"}]], "Output",ExpressionUUID->\
"fe1b1a97-514a-fd4d-8b53-0ecb9f31c8a2"],

Cell["Source", "NotesSection",ExpressionUUID->"9245609a-e8f1-884f-9765-82125395ceb7"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Edges",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"87334b67-fd22-0848-b303-9afff687225d"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"1ce357bb-8021-2b46-b33e-5bfa9585a30a"],

