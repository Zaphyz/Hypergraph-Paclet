Notebook[{
Cell["EdgeLabel", "ObjectName",ExpressionUUID->"b0fc2a60-417b-d545-a2c0-c73ec5b530f6"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"EdgeLabel", "[", "e", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"4b5b7354-d5d1-604d-af0e-b81226ad0533"],
 " ",
 "gives the label of the hyperedge e, or None if it is unlabelled."
}], "Usage",ExpressionUUID->"e73b16d2-da58-cb49-9e7d-ec43c8718f4d"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"b43fbadb-2b57-544b-8ede-a249de4b5d22"],

Cell["\<\
Edge labels take part in labelled isomorphism, where they must correspond one \
to one; see IsomorphicHypergraphQ.\
\>", "Notes",ExpressionUUID->"c39b9395-58d4-f646-a890-e6175838e10e"],

Cell["\<\
Edge labels and vertex labels are put in correspondence independently of one \
another.\
\>", "Notes",ExpressionUUID->"da897b62-334f-484f-807c-ae72a75bfade"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"d5b854f5-c6d7-2646-a2e8-875245beaf0e"],

Cell["\<\
{EdgeLabel[Edge[{1, 2}, \"Directed\", \"f\"]], EdgeLabel[Edge[{1, 2}]]}\
\>", "Input",ExpressionUUID->"9f58111d-757a-4446-9845-9665b6957d59"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"f\"\>", ",", "None"}], "}"}]], "Output",ExpressionUUID->\
"eff70811-090a-eb4d-9298-413908993570"],

Cell["\<\
The labels of a whole hypergraph, in the order of its edge list:\
\>", "ExampleText",ExpressionUUID->"2bf1249c-ab19-cd4d-8756-34c4724a5edd"],

Cell["\<\
Hypergraph[{Edge[{1, 2}, \"Directed\", \"f\"], Edge[{2, 3}]}][\"EdgeLabels\"]\
\
\>", "Input",ExpressionUUID->"1ba3745b-5977-b349-a74e-ab11939c2d03"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"None", ",", "\<\"f\"\>"}], "}"}]], "Output",ExpressionUUID->\
"81fe7415-4569-0543-8599-29aea935a102"],

Cell["Source", "NotesSection",ExpressionUUID->"dccaa926-3927-0544-b63a-f691bc190f99"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Edges",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"6e4bc0a2-bcdb-6f48-8276-eeb3ec56e9c0"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"d92f7214-0ab2-6645-8c8b-125bf5b1f2d4"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["Edge", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "eb1d80bc-bacb-1444-be23-abe7bd314bc5"],
 ", ",
