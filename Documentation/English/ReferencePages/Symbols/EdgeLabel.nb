Notebook[{
Cell["EdgeLabel", "ObjectName",ExpressionUUID->"1cc370e5-cd3b-0846-8f5f-7aba7bdbdabe"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"EdgeLabel", "[", "e", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"91df5195-d3be-c148-86e1-6ac3735b1c1d"],
 " ",
 "gives the label of the hyperedge e, or None if it is unlabelled."
}], "Usage",ExpressionUUID->"ca22d223-9fb2-1d4c-99a1-e28a0a9cdd22"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"087394eb-d0a8-324e-9bf7-e396461f6b90"],

Cell["\<\
Edge labels take part in labelled isomorphism, where they must correspond one \
to one; see IsomorphicHypergraphQ.\
\>", "Notes",ExpressionUUID->"c849cb13-5195-6849-8d9d-e47cb43cc226"],

Cell["\<\
Edge labels and vertex labels are put in correspondence independently of one \
another.\
\>", "Notes",ExpressionUUID->"76261258-8fb8-db4d-99b9-f76133d32b9c"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"f4e10440-81a2-7f40-a1e0-588accb1e65e"],

Cell["\<\
{EdgeLabel[Edge[{1, 2}, \"Directed\", \"f\"]], EdgeLabel[Edge[{1, 2}]]}\
\>", "Input",ExpressionUUID->"9b71aca1-e95d-0c4e-ae18-4eae4210e3e2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"f\"\>", ",", "None"}], "}"}]], "Output",ExpressionUUID->\
"31a8f9d1-ad41-fc4c-a958-aa8cc10f16bc"],

Cell["\<\
The labels of a whole hypergraph, in the order of its edge list:\
\>", "ExampleText",ExpressionUUID->"b36480ec-c8b0-b149-8476-2554ed2c1902"],

Cell["\<\
Hypergraph[{Edge[{1, 2}, \"Directed\", \"f\"], Edge[{2, 3}]}][\"EdgeLabels\"]\
\
\>", "Input",ExpressionUUID->"4e2f3495-8684-7d4c-bb5b-c428403c28d3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"None", ",", "\<\"f\"\>"}], "}"}]], "Output",ExpressionUUID->\
"12754199-3ffb-5848-a983-b55a2009ac5b"],

Cell["Source", "NotesSection",ExpressionUUID->"d76ca141-390a-fc4f-9d48-a6d585da47da"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Edges",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"3e234c7a-65b2-ff43-b1d2-95dc0ca63979"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"62a13031-a4f5-c24d-9d55-0a62eba455db"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["Edge", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "00a9f3d3-344c-cb4d-81b5-cd3bced5128a"],
 ", ",
 Cell[BoxData[
  StyleBox["VertexLabel", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "f90175e0-fe15-bd43-aa66-59401d41e087"],
 ", ",
 Cell[BoxData[
  StyleBox["IsomorphicHypergraphQ", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"5cf19b0e-1915-c742-a63f-4d8d968894a1"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphSkeleton", "InlineCode"]], "InlineFormula",
