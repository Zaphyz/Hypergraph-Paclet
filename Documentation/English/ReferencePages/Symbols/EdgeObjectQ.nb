Notebook[{
Cell["EdgeObjectQ", "ObjectName",ExpressionUUID->"e0d2f592-e4ea-b54a-86f1-d2c938761eb4"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"EdgeObjectQ", "[", "expr", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"0e9c2df6-6eff-e24d-af54-ff02aa29af57"],
 " ",
 "gives True if expr is a valid Edge object, and False otherwise."
}], "Usage",ExpressionUUID->"f69be8ec-210f-fa45-b3fe-956533f73956"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"26350b13-e3ae-1240-a366-fe1965de7925"],

Cell["\<\
An Edge expression that fails to be built evaluates to $Failed rather than \
remaining as an Edge, so any surviving Edge object is in canonical form.\
\>", "Notes",ExpressionUUID->"05fe693b-d639-044b-abe9-fc795d82b453"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"dd57b45a-0eab-e84f-ab35-c1e82f91ee4b"],

Cell["\<\
{EdgeObjectQ[Edge[{1, 2}]], EdgeObjectQ[{1, 2}], EdgeObjectQ[Vertex[1]]}\
\>", "Input",ExpressionUUID->"0739907d-d4a0-3d4e-8ddd-9fb4c957f026"],

Cell[BoxData[
 RowBox[{"{", 
