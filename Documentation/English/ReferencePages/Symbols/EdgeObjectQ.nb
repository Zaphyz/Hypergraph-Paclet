   RowBox[{"EdgeObjectQ", "[", "expr", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"38f12406-582b-5244-a6e3-4555fe16e9e2"],
 " ",
 "gives True if expr is a valid Edge object, and False otherwise."
}], "Usage",ExpressionUUID->"dfc2a21c-bf05-dd44-b50c-225b142b7769"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"d4ee40ed-f14c-354e-9550-1e7e735f5c27"],

Cell["\<\
An Edge expression that fails to be built evaluates to $Failed rather than \
remaining as an Edge, so any surviving Edge object is in canonical form.\
\>", "Notes",ExpressionUUID->"7f128dc8-f58f-274e-a45a-bcc2b2ba3128"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"6542eedb-b700-bb40-bde7-e4fea637c024"],

Cell["\<\
{EdgeObjectQ[Edge[{1, 2}]], EdgeObjectQ[{1, 2}], EdgeObjectQ[Vertex[1]]}\
\>", "Input",ExpressionUUID->"176df7cf-dea1-aa4f-8377-7b3822bf4ec1"],

