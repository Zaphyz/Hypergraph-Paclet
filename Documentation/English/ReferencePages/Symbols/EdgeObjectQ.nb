Notebook[{
Cell["EdgeObjectQ", "ObjectName",ExpressionUUID->"7a4e1d1a-62f8-3544-a8d2-7d9681fd8947"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"EdgeObjectQ", "[", "expr", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"bec9fb9f-6a48-754c-ab66-e18c019a852b"],
 " ",
 "gives True if expr is a valid Edge object, and False otherwise."
}], "Usage",ExpressionUUID->"883a5837-7e47-244d-bb5e-bf8271bcc05f"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"d6e70cfa-bf67-c64b-8adf-a98af9c7a379"],

Cell["\<\
An Edge expression that fails to be built evaluates to $Failed rather than \
remaining as an Edge, so any surviving Edge object is in canonical form.\
\>", "Notes",ExpressionUUID->"08f528e0-2ee9-194d-990f-f0a5906f1c91"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"ee1d2b6e-cf21-9b49-8af3-f4d4c0cc4981"],

Cell["\<\
{EdgeObjectQ[Edge[{1, 2}]], EdgeObjectQ[{1, 2}], EdgeObjectQ[Vertex[1]]}\
\>", "Input",ExpressionUUID->"a3ed2c7f-a926-e84c-b55b-f2f8a2f10727"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False", ",", "False"}], "}"}]], "Output",ExpressionUUI\
D->"6dbc4a4b-0520-4547-afff-b132b83f1ef7"],

