  ExpressionUUID->"a1b2de55-d85e-584a-8383-542dec9f7f1b"],
 " ",
 "gives True if expr is a valid Edge object, and False otherwise."
}], "Usage",ExpressionUUID->"a99fbfe2-e2fb-6641-87e1-b58366a1f0d3"],

