Cell["\<\
An Edge expression that fails to be built evaluates to $Failed rather than \
remaining as an Edge, so any surviving Edge object is in canonical form.\
\>", "Notes",ExpressionUUID->"601c2e75-7f36-a24d-b911-addcf1533891"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"2ae1b997-1630-4347-a059-e7e6ce0e0a6d"],

Cell["\<\
