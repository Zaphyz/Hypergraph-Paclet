Notebook[{
Cell["EdgeObjectQ", "ObjectName",ExpressionUUID->"3cf461d8-11f5-bf4e-bc36-b9235a493588"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"EdgeObjectQ", "[", "expr", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"b49fa38a-d105-df40-bcae-4df6cafe4604"],
 " ",
 "gives True if expr is a valid Edge object, and False otherwise."
}], "Usage",ExpressionUUID->"9acae18f-0b1d-2048-9094-d731ccb4dd82"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"c559d20c-4257-5945-9d1f-0d15a3e555c1"],

Cell["\<\
An Edge expression that fails to be built evaluates to $Failed rather than \
remaining as an Edge, so any surviving Edge object is in canonical form.\
\>", "Notes",ExpressionUUID->"13f017b4-991e-944a-bac8-2b44ada6ad00"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"1fe6e6dc-108e-924d-ba24-404ac642e2a3"],

Cell["\<\
{EdgeObjectQ[Edge[{1, 2}]], EdgeObjectQ[{1, 2}], EdgeObjectQ[Vertex[1]]}\
\>", "Input",ExpressionUUID->"73ede57e-63cf-3b47-8f8a-1795b74a0445"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False", ",", "False"}], "}"}]], "Output",ExpressionUUI\
D->"cddeb28a-5323-434b-8b53-32f84919314b"],

