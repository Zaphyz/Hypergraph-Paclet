Notebook[{
Cell["EdgeObjectQ", "ObjectName",ExpressionUUID->"27a7ea18-6b95-384a-bae1-8f5960be0e75"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"EdgeObjectQ", "[", "expr", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"67049c2b-d575-e844-84db-721607b530c8"],
 " ",
 "gives True if expr is a valid Edge object, and False otherwise."
}], "Usage",ExpressionUUID->"ece3bfd4-a8fb-1949-aa30-2a51ccc805f9"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"0a78ff4c-a5ce-804f-ad84-6d358b73dc06"],

Cell["\<\
An Edge expression that fails to be built evaluates to $Failed rather than \
remaining as an Edge, so any surviving Edge object is in canonical form.\
\>", "Notes",ExpressionUUID->"07bb84e0-df06-ca4a-bf51-81fca153652b"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"89e23bef-1adc-904e-aeb3-03fd6dece10b"],

Cell["\<\
{EdgeObjectQ[Edge[{1, 2}]], EdgeObjectQ[{1, 2}], EdgeObjectQ[Vertex[1]]}\
\>", "Input",ExpressionUUID->"95ee38d5-bd41-1e48-80d6-60ce887e22e0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False", ",", "False"}], "}"}]], "Output",ExpressionUUI\
D->"8562415b-6d92-3e45-b388-350a69ae4bfc"],

