Notebook[{
Cell["EdgeObjectQ", "ObjectName",ExpressionUUID->"88cf2568-eb9f-e244-89a8-d5bc0225092e"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"EdgeObjectQ", "[", "expr", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"f7e5f6e4-604d-8644-9c52-afd835280ee4"],
 " ",
 "gives True if expr is a valid Edge object, and False otherwise."
}], "Usage",ExpressionUUID->"014e64a2-2d69-d746-a403-b7df17bf6f37"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"65513031-9f66-0843-a07f-a507e99cb567"],

Cell["\<\
An Edge expression that fails to be built evaluates to $Failed rather than \
remaining as an Edge, so any surviving Edge object is in canonical form.\
\>", "Notes",ExpressionUUID->"a2250469-0602-ac47-b32b-a5d755d47ee2"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"42fcb9c1-76f1-5f49-b5b6-c3ce8055cb32"],

Cell["\<\
{EdgeObjectQ[Edge[{1, 2}]], EdgeObjectQ[{1, 2}], EdgeObjectQ[Vertex[1]]}\
\>", "Input",ExpressionUUID->"fa4cf91a-0e79-b34a-a8c7-8c5bf250334d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False", ",", "False"}], "}"}]], "Output",ExpressionUUI\
D->"49b1ccf1-0efb-7e43-aa4a-e8b5d7f1e825"],

