Cell["\<\
An Edge expression that fails to be built evaluates to $Failed rather than \
remaining as an Edge, so any surviving Edge object is in canonical form.\
\>", "Notes",ExpressionUUID->"95178ef1-59de-d54f-8dd6-b603f0d45955"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"d3b996ae-d78e-934f-bb9e-cb09e5f9dce3"],

Cell["\<\
{EdgeObjectQ[Edge[{1, 2}]], EdgeObjectQ[{1, 2}], EdgeObjectQ[Vertex[1]]}\
\>", "Input",ExpressionUUID->"6d4bd00e-d3a2-c243-8707-1551cff249be"],

