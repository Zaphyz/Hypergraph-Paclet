Notebook[{
Cell["EdgeSymmetry", "ObjectName",ExpressionUUID->"1e012773-74d1-9847-8a1b-efff41d9535c"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"EdgeSymmetry", "[", "e", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"5570b3d6-5dba-d243-8de4-5b108e0d8a1b"],
 " ",
 "gives the symmetry type of the hyperedge e."
}], "Usage",ExpressionUUID->"f6943448-2db1-a04f-9486-ce2580be657f"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"2f97176f-e3bc-fd4f-842a-8f5b39ed6070"],

Cell["The result is one of \"Directed\", \"Unordered\" or \"Cyclic\".", \
"Notes",ExpressionUUID->"34559441-bdae-cb43-bd9a-f383559f7f68"],

Cell["\<\
The symmetry type governs which reorderings of the vertex list denote the \
same hyperedge: none for \"Directed\", all of them for \"Unordered\", and the \
rotations for \"Cyclic\".\
\>", "Notes",ExpressionUUID->"e270331b-a4f9-7a4e-b22f-4ebcb4053154"],

Cell["\<\
It also governs how the edge is drawn: a directed edge carries arrowheads \
along its sides, an unordered edge carries none, and a cyclic edge is marked \
with a small circular arrow.\
\>", "Notes",ExpressionUUID->"44820a03-e77b-f140-b172-8ac27f437446"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"be019cc1-1e40-6c44-81c6-20b7b9a0ca7d"],

Cell["\<\
EdgeSymmetry /@ {Edge[{1, 2}], Edge[{1, 2}, \"Unordered\"], Edge[{1, 2}, \
\"Cyclic\"]}\
\>", "Input",ExpressionUUID->"2e8089a7-4d0c-464e-9f1b-22f4e14089a9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Directed\"\>", ",", "\<\"Unordered\"\>", 
   ",", "\<\"Cyclic\"\>"}], "}"}]], "Output",ExpressionUUID->"b1f7c3da-d6d0-\
d74b-922a-513a4f6c3372"],

Cell["The symmetry types of a whole hypergraph:", "ExampleText",ExpressionUUID->"4ad21c32-afe3-5446-be6e-379667b9b44f"],

Cell["\<\
Hypergraph[{Edge[{1, 2}], Edge[{2, 3}, \"Unordered\"]}][\"EdgeSymmetries\"]\
\>", "Input",ExpressionUUID->"ee1e7e29-7b52-a647-9d37-2513f4a5daa8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Directed\"\>", ",", "\<\"Unordered\"\>"}], "}"}]], "Output",Exp\
ressionUUID->"a068d1f0-de2a-2f42-b9e0-ba73b1dea907"],

Cell["Symmetry types are respected by the isomorphism test:", "ExampleText",ExpressionUUID->"c778f1e6-8c5f-294f-ac11-486cf879f4cb"],

Cell["\<\
IsomorphicHypergraphQ[Hypergraph[{Edge[{1, 2}]}], Hypergraph[{Edge[{1, 2}, \
\"Unordered\"]}]]\
\>", "Input",ExpressionUUID->"893e3e9f-d217-ef49-8ef8-2d447513881b"],

Cell[BoxData["False"], "Output",ExpressionUUID->"2015d5ca-4b25-dc40-b05c-0e67f9345678"],

Cell["Source", "NotesSection",ExpressionUUID->"5a732e46-85cd-8f41-9934-f9652cf0bb53"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Edges",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"afb8f384-7f0a-9c4c-8d02-e2544f1ec6af"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"170ee0f8-1fe7-5943-858e-7b774adc8999"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["Edge", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "398bf1a6-82e8-004f-a96d-5d5fa153847c"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeVertices", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "93dd8a71-5dfa-f64c-af6a-ca07c013da5d"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeLabel", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "c45cdb79-6502-0e49-967a-47a982dcd75f"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphPlot", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "a5f9dad0-f4a1-084e-8bbe-5d081f3287a4"]
}], "SeeAlso",ExpressionUUID->"1c280a34-b03a-4c40-bfb0-beff948ba972"]
},
