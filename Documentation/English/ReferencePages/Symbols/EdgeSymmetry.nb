Notebook[{
Cell["EdgeSymmetry", "ObjectName",ExpressionUUID->"b74fb3db-8347-bd43-84ae-d462610f40b8"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"EdgeSymmetry", "[", "e", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"af996313-fbe6-0c4d-8d67-997acff2cce5"],
 " ",
 "gives the symmetry type of the hyperedge e."
}], "Usage",ExpressionUUID->"82549f38-2937-2f49-9941-d37357f5e6b4"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"c393cf45-4af3-ba46-af08-bc4ee3ce75be"],

Cell["The result is one of \"Directed\", \"Unordered\" or \"Cyclic\".", \
"Notes",ExpressionUUID->"d0bdbe2c-e925-5e43-b9b9-11207eaf0016"],

Cell["\<\
The symmetry type governs which reorderings of the vertex list denote the \
same hyperedge: none for \"Directed\", all of them for \"Unordered\", and the \
rotations for \"Cyclic\".\
\>", "Notes",ExpressionUUID->"cfa1a029-41c9-a940-9773-af7b8f63af7a"],

Cell["\<\
It also governs how the edge is drawn: a directed edge carries arrowheads \
along its sides, an unordered edge carries none, and a cyclic edge is marked \
with a small circular arrow.\
\>", "Notes",ExpressionUUID->"4deff566-825b-cb44-ad1b-7cd97700832e"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"778cf654-8999-d440-ab6a-7c5585aabb99"],

Cell["\<\
EdgeSymmetry /@ {Edge[{1, 2}], Edge[{1, 2}, \"Unordered\"], Edge[{1, 2}, \
\"Cyclic\"]}\
\>", "Input",ExpressionUUID->"74141919-66a6-f142-b1e0-09228dca3e43"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Directed\"\>", ",", "\<\"Unordered\"\>", 
   ",", "\<\"Cyclic\"\>"}], "}"}]], "Output",ExpressionUUID->"0e2a2de0-bcfe-\
7347-bac7-37913d8c2720"],

Cell["The symmetry types of a whole hypergraph:", "ExampleText",ExpressionUUID->"be6f9b36-9904-c94b-86d7-d18ae9561eb5"],

Cell["\<\
Hypergraph[{Edge[{1, 2}], Edge[{2, 3}, \"Unordered\"]}][\"EdgeSymmetries\"]\
\>", "Input",ExpressionUUID->"adda8b0d-fbfb-904d-b6c0-3a1b6270809e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Directed\"\>", ",", "\<\"Unordered\"\>"}], "}"}]], "Output",Exp\
ressionUUID->"ee422dae-e11f-9043-917d-581a2c638917"],

Cell["Symmetry types are respected by the isomorphism test:", "ExampleText",ExpressionUUID->"da48d847-b68f-164f-a3e0-64908b0c8105"],

Cell["\<\
IsomorphicHypergraphQ[Hypergraph[{Edge[{1, 2}]}], Hypergraph[{Edge[{1, 2}, \
\"Unordered\"]}]]\
\>", "Input",ExpressionUUID->"0a349b59-9bee-284b-881e-0ca890c1f180"],

Cell[BoxData["False"], "Output",ExpressionUUID->"25437426-e2bf-6b42-8fdf-890e9c6921f4"],

Cell["Source", "NotesSection",ExpressionUUID->"d532764b-ab7d-4345-ab76-f313a7308b85"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Edges",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"12c41c32-c255-3f40-86ae-598afb8c5c56"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"02d1481a-0f2d-a848-8416-e4d41a63e4b8"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["Edge", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "84fa4a23-c588-7343-b90a-caa84d9efcb5"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeVertices", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "fd5aedda-a2c5-e54f-b965-4b0faaf98390"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeLabel", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "7209db9a-3133-d643-9215-c12b5289c307"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphPlot", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "16323f7e-8af6-934b-8166-908dd1c720e0"]
}], "SeeAlso",ExpressionUUID->"7b334efb-6de1-b747-8aa8-b40b258b561c"]
},
