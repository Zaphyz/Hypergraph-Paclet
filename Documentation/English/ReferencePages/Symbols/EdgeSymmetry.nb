Notebook[{
Cell["EdgeSymmetry", "ObjectName",ExpressionUUID->"f8a7d9c0-7251-a044-b4bb-9262abc113b8"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"EdgeSymmetry", "[", "e", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"369e5084-b6ef-9840-b184-2b78744bada5"],
 " ",
 "gives the symmetry type of the hyperedge e."
}], "Usage",ExpressionUUID->"177538a8-3ee2-ad4d-a59d-8a5b6a7ca317"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"7dbb5393-7012-f64a-ac4c-1fd4063aed3a"],

Cell["The result is one of \"Directed\", \"Unordered\" or \"Cyclic\".", \
"Notes",ExpressionUUID->"891303d8-a49c-1e45-a57b-ead20e5cc67b"],

Cell["\<\
The symmetry type governs which reorderings of the vertex list denote the \
same hyperedge: none for \"Directed\", all of them for \"Unordered\", and the \
rotations for \"Cyclic\".\
\>", "Notes",ExpressionUUID->"ebfbd072-f4bf-b345-9032-e2dfa5d0305c"],

Cell["\<\
It also governs how the edge is drawn: a directed edge carries arrowheads \
along its sides, an unordered edge carries none, and a cyclic edge is marked \
with a small circular arrow.\
\>", "Notes",ExpressionUUID->"505a0992-69f9-684f-aa0d-6a9bbf94a01b"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"7e15642c-ab3c-cf42-b61a-ab74269e5785"],

Cell["\<\
EdgeSymmetry /@ {Edge[{1, 2}], Edge[{1, 2}, \"Unordered\"], Edge[{1, 2}, \
\"Cyclic\"]}\
\>", "Input",ExpressionUUID->"e3c1e1e8-0422-fc4b-8f13-7b0393bca430"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Directed\"\>", ",", "\<\"Unordered\"\>", 
   ",", "\<\"Cyclic\"\>"}], "}"}]], "Output",ExpressionUUID->"30f0d021-b2f4-\
cc4f-96fe-cc0aad68e26f"],

Cell["The symmetry types of a whole hypergraph:", "ExampleText",ExpressionUUID->"50bd88bd-de69-0441-8bd9-ff96867c1552"],

Cell["\<\
Hypergraph[{Edge[{1, 2}], Edge[{2, 3}, \"Unordered\"]}][\"EdgeSymmetries\"]\
\>", "Input",ExpressionUUID->"285c67e3-73a7-4948-a8f3-7c6e775adfa5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Directed\"\>", ",", "\<\"Unordered\"\>"}], "}"}]], "Output",Exp\
ressionUUID->"76e05bc3-168c-2647-9c49-5652b6a38f3e"],

Cell["Symmetry types are respected by the isomorphism test:", "ExampleText",ExpressionUUID->"58285006-3e3a-2443-8ce6-2a9b805b7e5f"],

Cell["\<\
IsomorphicHypergraphQ[Hypergraph[{Edge[{1, 2}]}], Hypergraph[{Edge[{1, 2}, \
\"Unordered\"]}]]\
\>", "Input",ExpressionUUID->"ede41907-9eb9-f748-aa3f-e7551a6daa05"],

Cell[BoxData["False"], "Output",ExpressionUUID->"1ba62e38-a3ec-454a-b98d-1c2d197d1b0c"],

Cell["Source", "NotesSection",ExpressionUUID->"dfd795ca-93ea-ce41-a8d9-ae7ba870bec2"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Edges",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"65b7e38d-8469-d246-b004-3066a38a4d33"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"bf1941a6-f6fa-3549-a951-e5b55e420d49"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["Edge", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "1460fb4b-9745-7340-8b04-39ab6dfc4a64"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeVertices", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "00c58a51-81e7-c548-9270-072df7b774f0"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeLabel", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "6d689e49-9f19-7247-890a-440f766d7536"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphPlot", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "e4331cd9-d66c-b64a-be3e-61338edf6f21"]
}], "SeeAlso",ExpressionUUID->"e05ef4ed-180c-5f4d-a87d-1259005b8a9f"]
},
