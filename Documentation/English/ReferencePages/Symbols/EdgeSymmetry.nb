Notebook[{
Cell["EdgeSymmetry", "ObjectName",ExpressionUUID->"68a2d3e6-1462-d144-83eb-781f20ec9106"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"EdgeSymmetry", "[", "e", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"ba0efe8a-e786-cb4e-8dd1-ea8a37d7fa53"],
 " ",
 "gives the symmetry type of the hyperedge e."
}], "Usage",ExpressionUUID->"30ac72b6-7b7a-464c-a9ed-acfad15aabab"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"5493afcc-b9f0-3648-95aa-b5a844a86539"],

Cell["The result is one of \"Directed\", \"Unordered\" or \"Cyclic\".", \
"Notes",ExpressionUUID->"dd6d09ad-78fb-d945-95a0-b53b48df1aac"],

Cell["\<\
The symmetry type governs which reorderings of the vertex list denote the \
same hyperedge: none for \"Directed\", all of them for \"Unordered\", and the \
rotations for \"Cyclic\".\
\>", "Notes",ExpressionUUID->"a2999829-6115-a64b-b452-a729d77c22fb"],

Cell["\<\
It also governs how the edge is drawn: a directed edge carries arrowheads \
along its sides, an unordered edge carries none, and a cyclic edge is marked \
with a small circular arrow.\
\>", "Notes",ExpressionUUID->"877009e2-7470-9c44-ab1a-ae04b549d57a"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"f4217653-aed0-a64d-ab97-ce16b5821623"],

Cell["\<\
EdgeSymmetry /@ {Edge[{1, 2}], Edge[{1, 2}, \"Unordered\"], Edge[{1, 2}, \
\"Cyclic\"]}\
\>", "Input",ExpressionUUID->"8e94d627-8f7c-5744-bf55-3b8bf46d4462"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Directed\"\>", ",", "\<\"Unordered\"\>", 
   ",", "\<\"Cyclic\"\>"}], "}"}]], "Output",ExpressionUUID->"78bd58b5-7e32-\
6444-9cf4-eaf04c927a80"],

Cell["The symmetry types of a whole hypergraph:", "ExampleText",ExpressionUUID->"96992477-45b5-bf48-85ae-bd702094029f"],

Cell["\<\
Hypergraph[{Edge[{1, 2}], Edge[{2, 3}, \"Unordered\"]}][\"EdgeSymmetries\"]\
\>", "Input",ExpressionUUID->"cd362001-b210-734c-b78c-71ffcb0b2972"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Directed\"\>", ",", "\<\"Unordered\"\>"}], "}"}]], "Output",Exp\
ressionUUID->"e5bc6c12-15ef-f44c-8bd2-c0329f5851ad"],

Cell["Symmetry types are respected by the isomorphism test:", "ExampleText",ExpressionUUID->"723b8d8b-9256-cd46-afb5-663c103edc68"],

Cell["\<\
IsomorphicHypergraphQ[Hypergraph[{Edge[{1, 2}]}], Hypergraph[{Edge[{1, 2}, \
\"Unordered\"]}]]\
\>", "Input",ExpressionUUID->"c3c72394-2424-f641-b1e9-4064de54b01f"],

Cell[BoxData["False"], "Output",ExpressionUUID->"540f19a4-eb60-354d-bb5c-459519b90950"],

Cell["Source", "NotesSection",ExpressionUUID->"d16bfe79-f17f-c642-8481-5795d7d2639e"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Edges",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"a71854d1-9363-6248-bd21-86570b85e263"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"4327f39a-48ed-5742-8016-9ddc3b4ca5ab"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["Edge", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "d3106d9c-1470-5947-8148-38046db0fe31"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeVertices", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "5f558955-5818-6d42-8e7e-bf47f51933e2"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeLabel", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "5cf975a4-6bb2-4b4c-a5ea-4994796aa00f"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphPlot", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "5734984c-f602-4e4a-b5e6-93ac25843e48"]
}], "SeeAlso",ExpressionUUID->"4dabfb67-62f5-e84a-990f-61798795e607"]
},
