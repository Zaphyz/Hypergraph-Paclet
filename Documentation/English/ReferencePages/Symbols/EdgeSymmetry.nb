Notebook[{
Cell["EdgeSymmetry", "ObjectName",ExpressionUUID->"89c629e5-e8a8-df4b-8faa-90775d21b925"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"EdgeSymmetry", "[", "e", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"923f3d33-8eed-6f4a-a76b-f42e7fcd9571"],
 " ",
 "gives the symmetry type of the hyperedge e."
}], "Usage",ExpressionUUID->"29b6e127-40bb-6649-bd05-6824211b0664"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"174447ac-6201-6c42-9f35-458222c40fc2"],

Cell["The result is one of \"Directed\", \"Unordered\" or \"Cyclic\".", \
"Notes",ExpressionUUID->"fa32b3c3-d468-d94b-a489-aeb6472087ab"],

Cell["\<\
The symmetry type governs which reorderings of the vertex list denote the \
same hyperedge: none for \"Directed\", all of them for \"Unordered\", and the \
rotations for \"Cyclic\".\
\>", "Notes",ExpressionUUID->"7397c713-6bf7-b94e-b5e7-d3bd4a4658f9"],

Cell["\<\
It also governs how the edge is drawn: a directed edge carries arrowheads \
along its sides, an unordered edge carries none, and a cyclic edge is marked \
with a small circular arrow.\
\>", "Notes",ExpressionUUID->"c4501695-f40f-c147-97f9-4b6d60c14a97"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"27f1ce6e-9c22-2543-bf1f-04b12b0fad77"],

Cell["\<\
EdgeSymmetry /@ {Edge[{1, 2}], Edge[{1, 2}, \"Unordered\"], Edge[{1, 2}, \
\"Cyclic\"]}\
\>", "Input",ExpressionUUID->"67c99900-c08c-de45-b11e-f4e0579fea2a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Directed\"\>", ",", "\<\"Unordered\"\>", 
   ",", "\<\"Cyclic\"\>"}], "}"}]], "Output",ExpressionUUID->"b31faa8d-c835-\
7e4b-a5de-e643dfc33031"],

Cell["The symmetry types of a whole hypergraph:", "ExampleText",ExpressionUUID->"2ea414c2-7179-2d4d-a5b1-3c2053803bb7"],

Cell["\<\
Hypergraph[{Edge[{1, 2}], Edge[{2, 3}, \"Unordered\"]}][\"EdgeSymmetries\"]\
\>", "Input",ExpressionUUID->"5c21a4f5-1fc5-874e-8ba9-ed0fb2586540"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Directed\"\>", ",", "\<\"Unordered\"\>"}], "}"}]], "Output",Exp\
ressionUUID->"6641ca88-d2e2-ca46-980d-85c1311bad73"],

Cell["Symmetry types are respected by the isomorphism test:", "ExampleText",ExpressionUUID->"a4387e44-6802-c742-b34e-7d9f8cce6ba6"],

Cell["\<\
IsomorphicHypergraphQ[Hypergraph[{Edge[{1, 2}]}], Hypergraph[{Edge[{1, 2}, \
\"Unordered\"]}]]\
\>", "Input",ExpressionUUID->"3f3d9ed1-2538-9044-b702-72fc54b6a697"],

Cell[BoxData["False"], "Output",ExpressionUUID->"61365812-afbf-9c44-a1e8-25aceddbe1d9"],

Cell["Source", "NotesSection",ExpressionUUID->"5ae94eb8-c032-e447-87b4-2f5e653291a5"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Edges",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"69d6ffd3-f577-a645-80f3-794f1fdfe7a4"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"10aacbbe-6108-a043-bf90-b0f91ebc486e"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["Edge", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "47b983c5-06e8-044e-b0da-87379ddd484d"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeVertices", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "9fab6dd8-4ed1-6247-8954-a24c3c393ebc"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeLabel", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "a05d8109-8bf6-3a4a-8509-ba52ee56e3dd"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphPlot", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "dd047cb2-b4ed-6b41-a761-ab2f2df388a8"]
}], "SeeAlso",ExpressionUUID->"e10b4a3c-e1a8-eb47-ac7c-9222e276b8cb"]
},
