Notebook[{
Cell["EdgeSymmetry", "ObjectName",ExpressionUUID->"61559e26-2629-4946-9766-e12febb72689"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"EdgeSymmetry", "[", "e", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"1b25e48c-13a7-5b47-b11e-c17c035c967a"],
 " ",
 "gives the symmetry type of the hyperedge e."
}], "Usage",ExpressionUUID->"4394e1aa-29d4-774f-a943-f11a9e69099e"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"ab445531-4b72-764b-8ff2-d9e0aeb18dd1"],

Cell["The result is one of \"Directed\", \"Unordered\" or \"Cyclic\".", \
"Notes",ExpressionUUID->"10d4306e-a797-6243-9444-60c6a84c8dd1"],

Cell["\<\
The symmetry type governs which reorderings of the vertex list denote the \
same hyperedge: none for \"Directed\", all of them for \"Unordered\", and the \
rotations for \"Cyclic\".\
\>", "Notes",ExpressionUUID->"10ed64d3-b3a6-1e41-b489-392af1dea951"],

Cell["\<\
It also governs how the edge is drawn: a directed edge carries arrowheads \
along its sides, an unordered edge carries none, and a cyclic edge is marked \
with a small circular arrow.\
\>", "Notes",ExpressionUUID->"4330977a-5c95-e948-827c-f046777baf54"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"ef1b3cfc-1231-fd46-9463-5f47d59f6dd2"],

Cell["\<\
EdgeSymmetry /@ {Edge[{1, 2}], Edge[{1, 2}, \"Unordered\"], Edge[{1, 2}, \
\"Cyclic\"]}\
\>", "Input",ExpressionUUID->"e2fcfc73-0497-0d48-86f1-9e8a45d2eae6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Directed\"\>", ",", "\<\"Unordered\"\>", 
   ",", "\<\"Cyclic\"\>"}], "}"}]], "Output",ExpressionUUID->"aa1f6573-1185-\
0d45-a76b-7c486542a241"],

Cell["The symmetry types of a whole hypergraph:", "ExampleText",ExpressionUUID->"a816eb22-67af-2449-866c-425c09662f4c"],

Cell["\<\
Hypergraph[{Edge[{1, 2}], Edge[{2, 3}, \"Unordered\"]}][\"EdgeSymmetries\"]\
\>", "Input",ExpressionUUID->"59c084c8-b7ef-d14e-97ae-141ff0668ee6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Directed\"\>", ",", "\<\"Unordered\"\>"}], "}"}]], "Output",Exp\
ressionUUID->"1b7a779c-f491-cf43-9270-fc2adaddd992"],

Cell["Symmetry types are respected by the isomorphism test:", "ExampleText",ExpressionUUID->"56f6cd9c-87d8-2a47-aedd-01cd9715ad78"],

Cell["\<\
IsomorphicHypergraphQ[Hypergraph[{Edge[{1, 2}]}], Hypergraph[{Edge[{1, 2}, \
\"Unordered\"]}]]\
\>", "Input",ExpressionUUID->"262bd4dd-2faa-c847-8b0f-28bf6747b573"],

Cell[BoxData["False"], "Output",ExpressionUUID->"f4116095-540f-8549-a27f-e15685b3085a"],

Cell["Source", "NotesSection",ExpressionUUID->"d49cb6c2-269a-5646-b895-731d285a4d9a"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Edges",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"e51dc494-5acf-8142-b247-9904e8c26166"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"1c520bd4-e65b-b645-ae70-c7e24b75a61e"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["Edge", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "ac957b5e-a000-2942-a73b-5fa8a1fb3d04"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeVertices", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "7ebc63b9-5ade-aa4d-95ae-551744830b5a"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeLabel", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "7f3ce2e2-f198-6b40-8df3-f953fe8dd773"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphPlot", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "5381dab5-4efa-3b4a-b602-500c2ba097d7"]
}], "SeeAlso",ExpressionUUID->"0c339d84-132d-2b44-8e2d-27681a6f51fc"]
},
