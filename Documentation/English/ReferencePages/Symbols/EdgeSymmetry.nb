Notebook[{
Cell["EdgeSymmetry", "ObjectName",ExpressionUUID->"e46b0506-ecd4-e64a-84d4-e4262d4d64ca"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"EdgeSymmetry", "[", "e", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"b9751447-a864-0849-92cb-201215c02213"],
 " ",
 "gives the symmetry type of the hyperedge e."
}], "Usage",ExpressionUUID->"fd2a5e11-85ac-2840-af43-a3e1dd607664"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"18af84f9-82f8-bb4e-9c9f-609b464fd191"],

Cell["The result is one of \"Directed\", \"Unordered\" or \"Cyclic\".", \
"Notes",ExpressionUUID->"28fedeb6-32c4-1e45-8e10-3f2bde8376b4"],

Cell["\<\
The symmetry type governs which reorderings of the vertex list denote the \
same hyperedge: none for \"Directed\", all of them for \"Unordered\", and the \
rotations for \"Cyclic\".\
\>", "Notes",ExpressionUUID->"7fcd6d12-4b9a-274a-885e-389d779c7694"],

Cell["\<\
It also governs how the edge is drawn: a directed edge carries arrowheads \
along its sides, an unordered edge carries none, and a cyclic edge is marked \
with a small circular arrow.\
\>", "Notes",ExpressionUUID->"cca5aa6e-fe54-3549-b124-fa2f7f8258b7"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"7275e5bf-9191-de4b-a938-430435bdffa6"],

Cell["\<\
EdgeSymmetry /@ {Edge[{1, 2}], Edge[{1, 2}, \"Unordered\"], Edge[{1, 2}, \
\"Cyclic\"]}\
\>", "Input",ExpressionUUID->"0335e963-510b-6a4c-a4f8-7f00920a083d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Directed\"\>", ",", "\<\"Unordered\"\>", 
   ",", "\<\"Cyclic\"\>"}], "}"}]], "Output",ExpressionUUID->"a5d3c42d-231f-\
7847-8c2c-784d0523fd87"],

Cell["The symmetry types of a whole hypergraph:", "ExampleText",ExpressionUUID->"48bea339-4683-434e-935d-d37d0034d1b2"],

Cell["\<\
Hypergraph[{Edge[{1, 2}], Edge[{2, 3}, \"Unordered\"]}][\"EdgeSymmetries\"]\
\>", "Input",ExpressionUUID->"a0a678cf-f445-9d47-9c27-fcd19f82e466"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Directed\"\>", ",", "\<\"Unordered\"\>"}], "}"}]], "Output",Exp\
ressionUUID->"d0f18ce1-9ae3-7d4d-b832-f7975548ce5f"],

Cell["Symmetry types are respected by the isomorphism test:", "ExampleText",ExpressionUUID->"bbc0cd96-b876-a749-9f75-adddf6197fa0"],

Cell["\<\
IsomorphicHypergraphQ[Hypergraph[{Edge[{1, 2}]}], Hypergraph[{Edge[{1, 2}, \
\"Unordered\"]}]]\
\>", "Input",ExpressionUUID->"3b482d21-20ad-f248-98db-c93bb634bfa0"],

Cell[BoxData["False"], "Output",ExpressionUUID->"5ba52fef-309f-cc40-bc7e-60997d7ee4ca"],

Cell["Source", "NotesSection",ExpressionUUID->"f4fe0c48-d0b3-df48-b092-4cc8e7826691"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Edges",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"e7dca1b4-54fa-7342-8d21-127841152701"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"69d451da-9af4-ee4e-8241-ced67cbd9a44"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["Edge", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "b369e57d-73cb-8542-a58e-3954ad1b7608"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeVertices", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "d47c77f3-5c4f-7b46-b71e-b93ffb8de2d3"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeLabel", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "e265d510-24b0-0b4b-8250-33a4275188bc"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphPlot", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "c8fef5dd-0a8a-8c4c-968f-f68119b19122"]
}], "SeeAlso",ExpressionUUID->"2467f8ca-a1ad-834c-a622-29e2ab5626bb"]
},
