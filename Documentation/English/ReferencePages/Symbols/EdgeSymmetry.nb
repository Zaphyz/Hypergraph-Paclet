Notebook[{
Cell["EdgeSymmetry", "ObjectName",ExpressionUUID->"54c9964f-ebe3-d241-89d1-ceb85bf2ac36"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"EdgeSymmetry", "[", "e", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"cde6cc48-8484-0c47-b096-2a794f7c3327"],
 " ",
 "gives the symmetry type of the hyperedge e."
}], "Usage",ExpressionUUID->"505f85ff-fdb0-bc48-b3ba-2d41338cd488"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"e9cff931-7eb2-ba43-9dfb-6c19f23b923c"],

Cell["The result is one of \"Directed\", \"Unordered\" or \"Cyclic\".", \
"Notes",ExpressionUUID->"53d88cdd-bbed-af41-b85a-f772cffd1777"],

Cell["\<\
The symmetry type governs which reorderings of the vertex list denote the \
same hyperedge: none for \"Directed\", all of them for \"Unordered\", and the \
rotations for \"Cyclic\".\
\>", "Notes",ExpressionUUID->"6baf6c3d-4c71-ac43-bd43-1f49c114bfed"],

Cell["\<\
It also governs how the edge is drawn: a directed edge carries arrowheads \
along its sides, an unordered edge carries none, and a cyclic edge is marked \
with a small circular arrow.\
\>", "Notes",ExpressionUUID->"0a0607ba-ea53-5245-b4c3-844a8aad2c37"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"478e42fe-8169-a545-9b43-6caf6674dac1"],

Cell["\<\
EdgeSymmetry /@ {Edge[{1, 2}], Edge[{1, 2}, \"Unordered\"], Edge[{1, 2}, \
\"Cyclic\"]}\
\>", "Input",ExpressionUUID->"d996625b-2bb3-6543-afe3-08f73ad21ab8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Directed\"\>", ",", "\<\"Unordered\"\>", 
   ",", "\<\"Cyclic\"\>"}], "}"}]], "Output",ExpressionUUID->"02eb75f1-bad8-\
8d40-aa5a-b5d9ecce6b6f"],

Cell["The symmetry types of a whole hypergraph:", "ExampleText",ExpressionUUID->"40af110c-287a-ea4f-886b-8f5b7650edab"],

Cell["\<\
Hypergraph[{Edge[{1, 2}], Edge[{2, 3}, \"Unordered\"]}][\"EdgeSymmetries\"]\
\>", "Input",ExpressionUUID->"ce679a2f-d096-1d45-8595-36c2f16f0430"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Directed\"\>", ",", "\<\"Unordered\"\>"}], "}"}]], "Output",Exp\
ressionUUID->"3eb580f8-5966-a346-b4c7-32b6732c869c"],

Cell["Symmetry types are respected by the isomorphism test:", "ExampleText",ExpressionUUID->"ddcfdfae-bbec-b441-a6ab-b5eb8568aadf"],

Cell["\<\
IsomorphicHypergraphQ[Hypergraph[{Edge[{1, 2}]}], Hypergraph[{Edge[{1, 2}, \
\"Unordered\"]}]]\
\>", "Input",ExpressionUUID->"11f6b2e1-5c5c-b145-9e06-fb173cc96c22"],

Cell[BoxData["False"], "Output",ExpressionUUID->"87ccd67e-668e-4a46-b821-a7c4d940fe1b"],

Cell["Source", "NotesSection",ExpressionUUID->"b6fd85cf-5c98-a04a-8878-841829fbb95e"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Edges",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"675920d1-0366-0d41-a08f-7329dbc22b66"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"f4979529-969e-eb4f-b1ff-4f7fff21d0a9"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["Edge", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "4c2e51d4-7f05-4a4a-9cc5-56549b91073f"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeVertices", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "d9b981a6-37e9-4c47-a794-e92905345f33"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeLabel", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "130b6339-a4b3-2c46-9be9-92b94a727580"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphPlot", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "682b4dd1-420b-854a-bf87-9f533271e4b3"]
}], "SeeAlso",ExpressionUUID->"28ff1d7a-85f3-2446-8b6b-2c61ce7ae40d"]
},
