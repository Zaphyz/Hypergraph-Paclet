Notebook[{
Cell["EdgeVertices", "ObjectName",ExpressionUUID->"06f7175f-13a1-7c47-b3e3-46888d593c6a"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"EdgeVertices", "[", "e", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"c268466c-aa95-be43-99d1-9d68903d5dc9"],
 " ",
 "gives the list of Vertex objects of the hyperedge e."
}], "Usage",ExpressionUUID->"4d65a6a2-67b2-3548-b887-774b06f2808a"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"823d8edf-b73a-c64f-8633-a7732712ef5b"],

Cell["\<\
The list is in the canonical order of the edge's symmetry type, which is not \
necessarily the order in which the edge was written.\
\>", "Notes",ExpressionUUID->"02e5b638-bd5a-1543-b9b6-ff659dd461f9"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"490c6d3a-f214-d941-9986-48a7b20c5e37"],

Cell["EdgeVertices[Edge[{1, 2, 3}, \"Cyclic\", \"f\"]]", "Input",ExpressionUUID->"9254f37a-a22e-c64d-8a53-36985f9a1c6a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Vertex", "[", "1", "]"}], ",", 
   RowBox[{"Vertex", "[", "2", "]"}], ",", 
   RowBox[{"Vertex", "[", "3", "]"}]}], "}"}]], "Output",ExpressionUUID->\
"1d51e715-1965-0748-8432-6cc52dbf26f6"],

Cell["The arity of an edge is the length of this list:", "ExampleText",ExpressionUUID->"66f55bff-ca57-914f-90c7-e6d45585b9b1"],

Cell["Length @ EdgeVertices @ Edge[{1, 2, 3}]", "Input",ExpressionUUID->"2ff7e97a-3e5d-2049-9398-5db08e41fee8"],

Cell[BoxData["3"], "Output",ExpressionUUID->"4c81085b-b35b-444f-9e75-0697027d7f5d"],

Cell["Arities of a whole hypergraph:", "ExampleText",ExpressionUUID->"159fb425-44f6-9548-9b53-0f07f4c0d072"],

Cell["\<\
Hypergraph[{Edge[{1}], Edge[{1, 2}], Edge[{1, 2, 3}]}][\"Arity\"]\
\>", "Input",ExpressionUUID->"70dc3b79-ecf8-514f-bd6b-33453ee27edf"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3"}], "}"}]], "Output",ExpressionUUID->\
"74487d73-ef2e-3d48-90b1-9f7cfd82f8e3"],

Cell["Source", "NotesSection",ExpressionUUID->"2e52f39c-1b4c-ba4a-845a-99796317ca1a"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Edges",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"16c6ed95-f3c9-7341-93fe-6c94a3ffdbad"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"7939aa7a-4f8b-3b4a-83d0-44817dd5c894"],

