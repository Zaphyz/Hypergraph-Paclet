Notebook[{
Cell["EdgeVertices", "ObjectName",ExpressionUUID->"110f887b-5f45-1a49-8d25-0d3774ee50c4"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"EdgeVertices", "[", "e", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"97a5bb19-6363-9b4f-bc4a-ba9a19328f0b"],
 " ",
 "gives the list of Vertex objects of the hyperedge e."
}], "Usage",ExpressionUUID->"7e4e7d8b-e6ed-884b-8c4d-d4fc81e05d1e"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"cca6f283-5855-ea42-8e66-77487c35b947"],

Cell["\<\
The list is in the canonical order of the edge's symmetry type, which is not \
necessarily the order in which the edge was written.\
\>", "Notes",ExpressionUUID->"7e452021-dfa0-b847-8de4-1c6949260d8b"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"cd327b8d-14d7-db46-8293-ec6c033ae66e"],

Cell["EdgeVertices[Edge[{1, 2, 3}, \"Cyclic\", \"f\"]]", "Input",ExpressionUUID->"933d9cc3-14ee-3e44-a181-a194e5977032"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Vertex", "[", "1", "]"}], ",", 
   RowBox[{"Vertex", "[", "2", "]"}], ",", 
   RowBox[{"Vertex", "[", "3", "]"}]}], "}"}]], "Output",ExpressionUUID->\
"a75dce94-ffa0-7d40-b711-4e5530871546"],

Cell["The arity of an edge is the length of this list:", "ExampleText",ExpressionUUID->"1f5068a7-f4a3-b240-afc4-30c8bcadb8d7"],

Cell["Length @ EdgeVertices @ Edge[{1, 2, 3}]", "Input",ExpressionUUID->"e747560e-5ad7-b340-87bc-227cae1194c3"],

Cell[BoxData["3"], "Output",ExpressionUUID->"98d4b1bf-f78b-9749-9a07-90571adc0cd8"],

Cell["Arities of a whole hypergraph:", "ExampleText",ExpressionUUID->"fae20087-77f0-3849-b12c-3afdd23ebdce"],

Cell["\<\
Hypergraph[{Edge[{1}], Edge[{1, 2}], Edge[{1, 2, 3}]}][\"Arity\"]\
\>", "Input",ExpressionUUID->"80929991-1015-1f41-bdc3-82f3af3a9f0a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3"}], "}"}]], "Output",ExpressionUUID->\
"64f82e82-a1e4-a24d-9dba-5b0f7a1bb46b"],

Cell["Source", "NotesSection",ExpressionUUID->"6efbc9ac-65c6-fb4f-9e6a-2dfbd2bbd2fb"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Edges",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"4dcc6495-54da-274d-8082-ce0b7f3bdc74"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"22bdce99-ef63-c742-9c8f-6041d2f31c0a"],

