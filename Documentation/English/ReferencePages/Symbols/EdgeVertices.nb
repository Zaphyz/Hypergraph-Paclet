Notebook[{
Cell["EdgeVertices", "ObjectName",ExpressionUUID->"af37ca29-2192-2a4b-b4fc-574a9414332f"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"EdgeVertices", "[", "e", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"51b8b92d-0cb6-ca45-9e7e-76cc257f88fd"],
 " ",
 "gives the list of Vertex objects of the hyperedge e."
}], "Usage",ExpressionUUID->"3bc62b79-d6dd-aa4b-8b63-be6fd2bde8de"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"52c8a099-9d18-1a4a-81e2-eb8e7c1d7129"],

Cell["\<\
The list is in the canonical order of the edge's symmetry type, which is not \
necessarily the order in which the edge was written.\
\>", "Notes",ExpressionUUID->"f80b0d0e-b52d-e249-b503-68ae904f63b4"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"ed2d29aa-2147-aa4f-a0c4-f5f836836281"],

Cell["EdgeVertices[Edge[{1, 2, 3}, \"Cyclic\", \"f\"]]", "Input",ExpressionUUID->"7f4dc7c5-7a87-f442-8b11-3e7fcf6218d1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Vertex", "[", "1", "]"}], ",", 
   RowBox[{"Vertex", "[", "2", "]"}], ",", 
   RowBox[{"Vertex", "[", "3", "]"}]}], "}"}]], "Output",ExpressionUUID->\
"3e773652-c80c-7544-96af-72bcaa8b9b59"],

Cell["The arity of an edge is the length of this list:", "ExampleText",ExpressionUUID->"2453e686-7de6-9042-ac6d-77cc9432dd3a"],

Cell["Length @ EdgeVertices @ Edge[{1, 2, 3}]", "Input",ExpressionUUID->"a8740409-b761-6640-938e-f01f7a17f228"],

Cell[BoxData["3"], "Output",ExpressionUUID->"593c6322-4c76-f347-91eb-140cd03d2357"],

Cell["Arities of a whole hypergraph:", "ExampleText",ExpressionUUID->"867c8ef0-2279-e247-ba24-61e21fa02396"],

Cell["\<\
Hypergraph[{Edge[{1}], Edge[{1, 2}], Edge[{1, 2, 3}]}][\"Arity\"]\
\>", "Input",ExpressionUUID->"b802cfe4-e9c9-f041-a28f-a9f0ee4f563c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3"}], "}"}]], "Output",ExpressionUUID->\
"26e368bc-d6cf-444e-8761-781d9c30a4aa"],

Cell["Source", "NotesSection",ExpressionUUID->"d6ae2fbf-3b5e-f342-aa17-2843bd578c53"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Edges",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"dfce7dc0-55d7-214a-98eb-62c870d62db8"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"f26698b7-f250-3946-b4ee-8de2fbfadc2a"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["Edge", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "8a6ed8a4-1378-be4e-a1db-79dbf3f9be68"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeSymmetry", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "fff9c252-f518-9e4d-b9a5-bc852bf99ce1"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeLabel", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "befa7cb5-4493-664a-ba4c-739babbd8fc0"],
 ", ",
 Cell[BoxData[
  StyleBox["VertexID", "InlineCode"]], "InlineFormula",ExpressionUUID->
