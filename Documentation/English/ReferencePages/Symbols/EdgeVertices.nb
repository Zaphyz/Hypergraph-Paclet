Notebook[{
Cell["EdgeVertices", "ObjectName",ExpressionUUID->"1b3f13c5-ab26-7247-89d5-0dd2071b087b"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"EdgeVertices", "[", "e", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"1480ba86-1d1b-e641-a5a3-26e70db7e701"],
 " ",
 "gives the list of Vertex objects of the hyperedge e."
}], "Usage",ExpressionUUID->"4fa00a0c-177e-a148-b3e3-459241317ecd"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"b424f612-c31e-b842-a20f-a23933d1a173"],

Cell["\<\
The list is in the canonical order of the edge's symmetry type, which is not \
necessarily the order in which the edge was written.\
\>", "Notes",ExpressionUUID->"20aa0238-1b7c-e644-89b9-75ceab14cf81"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"8bee746f-f74c-ff4f-8e90-0472ba4a76eb"],

Cell["EdgeVertices[Edge[{1, 2, 3}, \"Cyclic\", \"f\"]]", "Input",ExpressionUUID->"76c4f032-efa1-fc4e-907e-24f5d9ce2fdc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Vertex", "[", "1", "]"}], ",", 
   RowBox[{"Vertex", "[", "2", "]"}], ",", 
   RowBox[{"Vertex", "[", "3", "]"}]}], "}"}]], "Output",ExpressionUUID->\
"f29d93ef-812a-b647-916c-a3aebe855f24"],

Cell["The arity of an edge is the length of this list:", "ExampleText",ExpressionUUID->"17681c8d-5eef-ae49-aa1d-2f24f395acaa"],

Cell["Length @ EdgeVertices @ Edge[{1, 2, 3}]", "Input",ExpressionUUID->"c645d66f-079e-5c42-8803-1f2a57fba255"],

Cell[BoxData["3"], "Output",ExpressionUUID->"e75b8638-41f7-9e4c-9348-d19d17b5a678"],

Cell["Arities of a whole hypergraph:", "ExampleText",ExpressionUUID->"63049aef-ef02-8c4e-8b0d-35daa249fe53"],

Cell["\<\
Hypergraph[{Edge[{1}], Edge[{1, 2}], Edge[{1, 2, 3}]}][\"Arity\"]\
\>", "Input",ExpressionUUID->"0413414f-4b13-524b-ba71-5994a6ed2817"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3"}], "}"}]], "Output",ExpressionUUID->\
"a59a85a5-4091-d947-8c46-f6b2f243e709"],

Cell["Source", "NotesSection",ExpressionUUID->"09daaaea-b791-d947-a5b4-8aaee3dd5edc"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Edges",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"01292556-bcc0-f943-932f-286879512f2f"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"f64601f3-5323-cc45-8965-2baa5b897abe"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["Edge", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "77b70bcf-f22a-c94b-be32-942e9bcc234c"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeSymmetry", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "0cf9e114-0b63-d947-9049-8c11994702ab"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeLabel", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "83782673-e218-ed4b-8503-0bb24d1a248f"],
 ", ",
 Cell[BoxData[
  StyleBox["VertexID", "InlineCode"]], "InlineFormula",ExpressionUUID->
