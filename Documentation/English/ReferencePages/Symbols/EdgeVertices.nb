Notebook[{
Cell["EdgeVertices", "ObjectName",ExpressionUUID->"cc43b76f-e072-7d45-a95f-b4d79c8de390"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"EdgeVertices", "[", "e", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"734fc76d-5b97-f549-86ae-d1e1e3075ed8"],
 " ",
 "gives the list of Vertex objects of the hyperedge e."
}], "Usage",ExpressionUUID->"d72541ff-26cc-f74f-8b9d-348fd6ec1e25"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"9bc047c3-b0fd-5b48-8f9b-d3f6ccab93d2"],

Cell["\<\
The list is in the canonical order of the edge's symmetry type, which is not \
necessarily the order in which the edge was written.\
\>", "Notes",ExpressionUUID->"80a47965-badd-734a-be08-4da9422369aa"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"8ee200b1-5a8b-2e4f-884e-4ae65e425834"],

Cell["EdgeVertices[Edge[{1, 2, 3}, \"Cyclic\", \"f\"]]", "Input",ExpressionUUID->"cf84eff6-8353-a549-ab19-9e0e5ea56dca"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Vertex", "[", "1", "]"}], ",", 
   RowBox[{"Vertex", "[", "2", "]"}], ",", 
   RowBox[{"Vertex", "[", "3", "]"}]}], "}"}]], "Output",ExpressionUUID->\
"36225e6d-a56b-134b-8aae-b19c8fca89fb"],

Cell["The arity of an edge is the length of this list:", "ExampleText",ExpressionUUID->"e206d0bc-09fe-ba42-bca4-95f11025e5c8"],

Cell["Length @ EdgeVertices @ Edge[{1, 2, 3}]", "Input",ExpressionUUID->"a5202e6b-2db7-1143-a801-d18f590a9a3e"],

Cell[BoxData["3"], "Output",ExpressionUUID->"d2e2e8e1-1b15-1049-98a6-1373ceb57f89"],

Cell["Arities of a whole hypergraph:", "ExampleText",ExpressionUUID->"604bef67-513e-a948-bf36-ea9d189f0c12"],

Cell["\<\
Hypergraph[{Edge[{1}], Edge[{1, 2}], Edge[{1, 2, 3}]}][\"Arity\"]\
\>", "Input",ExpressionUUID->"1fa3b82a-9bcd-6845-89af-e959f6479aa9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3"}], "}"}]], "Output",ExpressionUUID->\
"ce0c8e87-0578-3b47-89a1-bca9f84f9998"],

Cell["Source", "NotesSection",ExpressionUUID->"72b29d31-c939-0843-8bff-eed15140c0e2"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Edges",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"498872cb-424c-3c46-b71e-415ffe9a3112"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"2c5e0873-b178-ae40-9f67-2b071eb4e8be"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["Edge", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "bb0bf87a-c371-d24f-b32d-538aefc940ca"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeSymmetry", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "1591cd17-4022-c244-9d9a-b075d2794720"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeLabel", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "c0719756-25bf-d844-8fc8-0d609a777749"],
 ", ",
 Cell[BoxData[
  StyleBox["VertexID", "InlineCode"]], "InlineFormula",ExpressionUUID->
