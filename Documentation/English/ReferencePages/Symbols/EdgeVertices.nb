Notebook[{
Cell["EdgeVertices", "ObjectName",ExpressionUUID->"16cee3c6-b21b-2f42-98b4-f54609c70ce7"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"EdgeVertices", "[", "e", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"589cbd41-76f8-0e4b-a4f2-54bc17bd025b"],
 " ",
 "gives the list of Vertex objects of the hyperedge e."
}], "Usage",ExpressionUUID->"387dc945-336a-f040-aa08-a0c8922c8273"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"c019e8cb-7ceb-5e4e-8e1f-6bd69109fa7a"],

Cell["\<\
The list is in the canonical order of the edge's symmetry type, which is not \
necessarily the order in which the edge was written.\
\>", "Notes",ExpressionUUID->"446fbdeb-7900-534d-a7e7-3a8dc3b73ce7"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"a4695049-ad33-c34c-8add-3110103a98c3"],

Cell["EdgeVertices[Edge[{1, 2, 3}, \"Cyclic\", \"f\"]]", "Input",ExpressionUUID->"60e74600-2c27-a849-a45a-c60a88df0943"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Vertex", "[", "1", "]"}], ",", 
   RowBox[{"Vertex", "[", "2", "]"}], ",", 
   RowBox[{"Vertex", "[", "3", "]"}]}], "}"}]], "Output",ExpressionUUID->\
"91ac9096-e2c9-f549-aa80-d37bb23810e2"],

Cell["The arity of an edge is the length of this list:", "ExampleText",ExpressionUUID->"8089d872-92c8-5d4e-9ab1-19fa7e6c5482"],

Cell["Length @ EdgeVertices @ Edge[{1, 2, 3}]", "Input",ExpressionUUID->"469c39cf-365a-e44a-93b4-4ecd221b3d86"],

Cell[BoxData["3"], "Output",ExpressionUUID->"a0313a09-5933-8347-b533-738973528817"],

Cell["Arities of a whole hypergraph:", "ExampleText",ExpressionUUID->"26544889-adde-a443-ae12-97382d949f30"],

Cell["\<\
Hypergraph[{Edge[{1}], Edge[{1, 2}], Edge[{1, 2, 3}]}][\"Arity\"]\
\>", "Input",ExpressionUUID->"d63dc603-1323-f846-b583-66a7824f11e2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3"}], "}"}]], "Output",ExpressionUUID->\
"28dc9b75-f0b5-a742-9915-729f3e70b828"],

Cell["Source", "NotesSection",ExpressionUUID->"69f0d7e0-889e-f94f-9b9e-eafe1a278437"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Edges",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"512ddce2-ae38-d943-98d2-b79151e2dd1b"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"2debc2c1-21fc-7340-b459-e6093f937d8d"],

