Notebook[{
Cell["EdgeVertices", "ObjectName",ExpressionUUID->"389a155d-a286-5746-b9a7-75fcc1d75ed2"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"EdgeVertices", "[", "e", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"796b4345-9470-c045-a443-c70a9c8ce616"],
 " ",
 "gives the list of Vertex objects of the hyperedge e."
}], "Usage",ExpressionUUID->"04e342cf-b4b5-fe44-98fb-9d5ee9224e26"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"63959c21-68cf-6343-9e05-8a06b208a2aa"],

Cell["\<\
The list is in the canonical order of the edge's symmetry type, which is not \
necessarily the order in which the edge was written.\
\>", "Notes",ExpressionUUID->"ced6e76a-b0b7-0a4e-a744-731871fce51a"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"849b3770-8cb6-a541-8f68-bc610c5b4526"],

Cell["EdgeVertices[Edge[{1, 2, 3}, \"Cyclic\", \"f\"]]", "Input",ExpressionUUID->"57dc0c62-e629-5641-8d11-30b6d4f39112"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Vertex", "[", "1", "]"}], ",", 
   RowBox[{"Vertex", "[", "2", "]"}], ",", 
   RowBox[{"Vertex", "[", "3", "]"}]}], "}"}]], "Output",ExpressionUUID->\
"11c19515-0a76-5142-af86-5b6091e0d65b"],

Cell["The arity of an edge is the length of this list:", "ExampleText",ExpressionUUID->"e7736e35-3218-bc47-8751-2254ce733438"],

Cell["Length @ EdgeVertices @ Edge[{1, 2, 3}]", "Input",ExpressionUUID->"615fb103-f74e-5745-9611-483c9b3ea015"],

Cell[BoxData["3"], "Output",ExpressionUUID->"c5ea45db-4598-ff4a-a3d3-afa9e6388831"],

Cell["Arities of a whole hypergraph:", "ExampleText",ExpressionUUID->"2f8e647f-b965-3a4a-8f40-993427d5d143"],

Cell["\<\
Hypergraph[{Edge[{1}], Edge[{1, 2}], Edge[{1, 2, 3}]}][\"Arity\"]\
\>", "Input",ExpressionUUID->"12c8ca03-6984-1849-af3f-56f0da788495"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3"}], "}"}]], "Output",ExpressionUUID->\
"f81959cc-9757-a244-adbc-0bf6435d0dbb"],

Cell["Source", "NotesSection",ExpressionUUID->"c507ba36-fc6e-1448-a1ba-4b8fc78eca92"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Edges",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"e7f84b49-4567-c645-85bc-d07adc349628"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"adc931a7-b69f-db4a-8ee4-04d1dc47d078"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["Edge", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "2637b3f0-fcaf-954a-ac9d-57d3987e1f9e"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeSymmetry", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "e1de9b60-83c2-8d4e-8bfd-ff00aa750326"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeLabel", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "3c41eda5-0d81-a340-b897-d3e6de9d4186"],
 ", ",
 Cell[BoxData[
  StyleBox["VertexID", "InlineCode"]], "InlineFormula",ExpressionUUID->
