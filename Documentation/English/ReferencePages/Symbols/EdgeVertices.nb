Notebook[{
Cell["EdgeVertices", "ObjectName",ExpressionUUID->"86bcc35a-4647-8642-8e5d-cf414107f0d5"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"EdgeVertices", "[", "e", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"b7e973c0-8371-e341-a8ad-f1a90438f81e"],
 " ",
 "gives the list of Vertex objects of the hyperedge e."
}], "Usage",ExpressionUUID->"20226d98-e0b9-4a46-a015-5b36e97b9183"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"dc96ca6a-05fc-544e-9326-fded62673463"],

Cell["\<\
The list is in the canonical order of the edge's symmetry type, which is not \
necessarily the order in which the edge was written.\
\>", "Notes",ExpressionUUID->"57ebd67f-866e-4f4e-9d2e-e4e0e48d84d8"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"798293fc-407c-7840-827b-5872c77baf86"],

Cell["EdgeVertices[Edge[{1, 2, 3}, \"Cyclic\", \"f\"]]", "Input",ExpressionUUID->"59451840-dc02-6147-ab62-cae9a859a7b1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Vertex", "[", "1", "]"}], ",", 
   RowBox[{"Vertex", "[", "2", "]"}], ",", 
   RowBox[{"Vertex", "[", "3", "]"}]}], "}"}]], "Output",ExpressionUUID->\
"26d065cc-f490-f541-bf64-b1692a82d868"],

Cell["The arity of an edge is the length of this list:", "ExampleText",ExpressionUUID->"170e2233-7841-294f-a4be-c637aec61201"],

Cell["Length @ EdgeVertices @ Edge[{1, 2, 3}]", "Input",ExpressionUUID->"65f856c6-6609-2d4c-ab8b-33930d2b630c"],

Cell[BoxData["3"], "Output",ExpressionUUID->"2ca0367d-d031-694d-9051-e83553354dfb"],

Cell["Arities of a whole hypergraph:", "ExampleText",ExpressionUUID->"57947639-576c-a647-9d45-5390c43432a9"],

Cell["\<\
Hypergraph[{Edge[{1}], Edge[{1, 2}], Edge[{1, 2, 3}]}][\"Arity\"]\
\>", "Input",ExpressionUUID->"7d887b70-cae9-f94a-88f4-d09c2d8c548a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3"}], "}"}]], "Output",ExpressionUUID->\
"e3ddaaa4-9a47-c347-bd8b-5a4d49b5a64a"],

Cell["Source", "NotesSection",ExpressionUUID->"e4fb9c1f-d0cd-a445-bb83-baed01ee65be"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Edges",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"8b16be4f-dec8-a346-9d3d-89b2d0429f0c"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"1c8e19b6-5a62-4347-b034-56519b05a7a9"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["Edge", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "d746637b-ed55-004f-be2a-b7155dfa9b19"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeSymmetry", "InlineCode"]], "InlineFormula",ExpressionUUID->
