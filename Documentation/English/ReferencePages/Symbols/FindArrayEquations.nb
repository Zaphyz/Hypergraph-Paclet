Notebook[{
Cell[554, 20, 95, 0, 70, "ObjectName",ExpressionUUID->"940167c8-c4e7-0e49-b318-09b7b04e6143"],
Cell[652, 22, 463, 10, 70, "Usage",ExpressionUUID->"fbb90c78-bcfe-0643-9e3b-e959b8f7331c"],
Cell[1108, 34, 98, 0, 70, "NotesSection",ExpressionUUID->"484c0194-b3b3-f24d-84be-7e4249b09edf"],
Cell[1209, 36, 249, 4, 70, "Notes",ExpressionUUID->"2ba10e91-5ea5-6e41-b8b3-ad1c44d73271"],
Cell[1457, 42, 351, 5, 70, "Notes",ExpressionUUID->"1b8c4526-2a56-ef45-8fd5-e7fe477e8c28"],
Cell[1806, 49, 670, 13, 70, "Notes",ExpressionUUID->"87e9d3f8-ff6a-6743-b38b-66ef4ddfc808"],
Cell[2466, 64, 429, 8, 70, "Notes",ExpressionUUID->"cd1e96a9-343a-5e4c-a5c7-f31a36470a14"],
