Notebook[{
Cell[554, 20, 95, 0, 70, "ObjectName",ExpressionUUID->"bdb2b9d5-ab19-fe4d-8734-3ce7c20e4dab"],
Cell[652, 22, 463, 10, 70, "Usage",ExpressionUUID->"0680ea6e-d973-fe40-ae0d-151ecd65a13a"],
Cell[1108, 34, 98, 0, 70, "NotesSection",ExpressionUUID->"c8b96ace-b2a9-8341-9ff5-b145ee3ab854"],
Cell[1209, 36, 249, 4, 70, "Notes",ExpressionUUID->"ad1d0fd7-5f5c-c44f-9918-b1c5cb6d0382"],
Cell[1457, 42, 351, 5, 70, "Notes",ExpressionUUID->"98058ec1-17fc-3b41-ad49-af553f836dcb"],
Cell[1806, 49, 670, 13, 70, "Notes",ExpressionUUID->"6c97ac6b-27ee-bd49-b5f7-0cfe75b154cb"],
Cell[2466, 64, 429, 8, 70, "Notes",ExpressionUUID->"18bf3023-2b06-e940-9c7d-efa8d48f09c8"],
