Cell[554, 20, 95, 0, 70, "ObjectName",ExpressionUUID->"f413b9ef-d105-fc4e-becf-be283feea4fe"],
Cell[652, 22, 463, 10, 70, "Usage",ExpressionUUID->"330e7d96-cde0-1d4a-9912-73f687be04be"],
Cell[1108, 34, 98, 0, 70, "NotesSection",ExpressionUUID->"572b53b0-fd4f-ee47-87ea-f85df9d9c139"],
Cell[1209, 36, 249, 4, 70, "Notes",ExpressionUUID->"d1d8317c-caeb-0b42-9134-1c6bbdbd03ca"],
Cell[1457, 42, 351, 5, 70, "Notes",ExpressionUUID->"4312aad2-53a7-2046-bcd3-9fda82533eb8"],
Cell[1806, 49, 670, 13, 70, "Notes",ExpressionUUID->"88ae2295-eda9-674e-8fa1-c697704ea02d"],
Cell[2466, 64, 429, 8, 70, "Notes",ExpressionUUID->"f6195111-0eaf-4743-bb12-c021ea606702"],
