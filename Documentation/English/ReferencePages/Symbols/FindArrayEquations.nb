 Cell[BoxData[
  StyleBox["IdentityArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "55718179-4eee-1e49-9301-295f08736567"]
}], "SeeAlso",ExpressionUUID->"b8830d41-eeb6-fb41-8dc9-f215faf73c8b"]
