Notebook[{
Cell[554, 20, 95, 0, 70, "ObjectName",ExpressionUUID->"16d6cb55-2269-f542-9575-9af0f64c66d5"],
Cell[652, 22, 463, 10, 70, "Usage",ExpressionUUID->"71b9329a-bb3b-4446-ba9d-54f9f90756c6"],
Cell[1108, 34, 98, 0, 70, "NotesSection",ExpressionUUID->"e69a7215-538c-c34d-97e4-bc7c8281afd5"],
Cell[1209, 36, 249, 4, 70, "Notes",ExpressionUUID->"4001cffe-7cab-b54e-b842-5400248f580a"],
Cell[1457, 42, 351, 5, 70, "Notes",ExpressionUUID->"8b781885-1aa3-f04d-9b14-d498c6a117ce"],
Cell[1806, 49, 670, 13, 70, "Notes",ExpressionUUID->"86091c18-1c37-d246-93bf-3687cb7475c7"],
Cell[2466, 64, 429, 8, 70, "Notes",ExpressionUUID->"a8d24484-1c27-484a-900d-603302e62a86"],
Cell[2890, 74, 422, 6, 70, "Notes",ExpressionUUID->"7bbc2683-3744-d140-a47d-5c31b3927fe4"],
