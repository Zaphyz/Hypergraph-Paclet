Cell[652, 22, 463, 10, 70, "Usage",ExpressionUUID->"730a9db8-5cb4-5642-a66c-3f36662fc62c"],
Cell[1108, 34, 98, 0, 70, "NotesSection",ExpressionUUID->"5120b39e-7d3d-7b41-8c07-053dbba0274e"],
Cell[1209, 36, 249, 4, 70, "Notes",ExpressionUUID->"be0caa80-8460-0d4e-9867-8093b5ef770d"],
Cell[1457, 42, 351, 5, 70, "Notes",ExpressionUUID->"c6f89d78-247d-3947-9cbb-0a2ac881434c"],
Cell[1806, 49, 670, 13, 70, "Notes",ExpressionUUID->"61ba5d58-4c74-774e-9343-1d152b8b66a9"],
Cell[2466, 64, 429, 8, 70, "Notes",ExpressionUUID->"1fae7da0-4a1a-074b-9ada-416d350d0a50"],
