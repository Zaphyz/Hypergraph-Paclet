Notebook[{
Cell[554, 20, 95, 0, 70, "ObjectName",ExpressionUUID->"ba28efe8-de6e-5b4b-9c1b-89ec44ca8e71"],
Cell[652, 22, 463, 10, 70, "Usage",ExpressionUUID->"3255955d-b533-1841-9810-f75fee5929fb"],
Cell[1108, 34, 98, 0, 70, "NotesSection",ExpressionUUID->"e0e8c8b6-d43a-9f4d-9ec4-6346aef836c9"],
Cell[1209, 36, 249, 4, 70, "Notes",ExpressionUUID->"0e8b20b2-d7ef-de48-bf62-73bd3553c00e"],
Cell[1457, 42, 351, 5, 70, "Notes",ExpressionUUID->"753f6f5f-24f0-9643-bdea-733c43b11879"],
Cell[1806, 49, 670, 13, 70, "Notes",ExpressionUUID->"535119e3-84c5-a845-94f9-e03aaf750782"],
Cell[2466, 64, 429, 8, 70, "Notes",ExpressionUUID->"a6a13b19-57dd-954b-8a51-d6cdbf884c6a"],
