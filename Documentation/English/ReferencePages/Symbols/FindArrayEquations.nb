Notebook[{
Cell[554, 20, 95, 0, 70, "ObjectName",ExpressionUUID->"fb0b4943-4a73-c043-9761-1c28c05f47b0"],
Cell[652, 22, 463, 10, 70, "Usage",ExpressionUUID->"618bdba1-5a03-1643-a019-10eb6923389b"],
Cell[1108, 34, 98, 0, 70, "NotesSection",ExpressionUUID->"729d0b3e-2912-c84f-87c7-200b205cf610"],
Cell[1209, 36, 249, 4, 70, "Notes",ExpressionUUID->"32159277-4119-b347-acba-6a69328924f4"],
Cell[1457, 42, 351, 5, 70, "Notes",ExpressionUUID->"686a135c-3387-b848-b3d7-880ab76faeeb"],
Cell[1806, 49, 670, 13, 70, "Notes",ExpressionUUID->"1df1689c-f823-d041-81ff-3c9c43e5ea9c"],
Cell[2466, 64, 429, 8, 70, "Notes",ExpressionUUID->"809edffd-0765-c248-adc6-bd69af3d3921"],
Cell[2890, 74, 422, 6, 70, "Notes",ExpressionUUID->"f46fae09-7b9d-4044-aece-c83672775f68"],
