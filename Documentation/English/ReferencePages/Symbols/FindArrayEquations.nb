Notebook[{
Cell[554, 20, 95, 0, 70, "ObjectName",ExpressionUUID->"a34cd5d6-7ab7-d746-8e0c-1ebcd7f957e7"],
Cell[652, 22, 463, 10, 70, "Usage",ExpressionUUID->"c7d4844c-ee28-5a40-9bb5-7dc397110ace"],
Cell[1108, 34, 98, 0, 70, "NotesSection",ExpressionUUID->"90ebcb07-89e6-0945-bb19-7713fa59ac49"],
Cell[1209, 36, 249, 4, 70, "Notes",ExpressionUUID->"f23b1eec-1803-7048-8639-0fe0a640858a"],
Cell[1457, 42, 351, 5, 70, "Notes",ExpressionUUID->"f43a6e37-af0d-d745-977b-9855d45672a8"],
Cell[1806, 49, 670, 13, 70, "Notes",ExpressionUUID->"3464b550-7410-f64e-9159-f59290234a21"],
Cell[2466, 64, 429, 8, 70, "Notes",ExpressionUUID->"c691b33c-4013-614e-b715-a64f65e5eebe"],
