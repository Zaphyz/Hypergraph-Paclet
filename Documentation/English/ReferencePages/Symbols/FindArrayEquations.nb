Cell[652, 22, 463, 10, 70, "Usage",ExpressionUUID->"a5f0eb56-f3d0-b748-94b7-ceddb60e484b"],
Cell[1108, 34, 98, 0, 70, "NotesSection",ExpressionUUID->"690593e2-e20f-1245-b309-7cfaae60b6ca"],
Cell[1209, 36, 249, 4, 70, "Notes",ExpressionUUID->"0c4fdc1e-ad5a-e14b-af24-1d8df09f70d3"],
Cell[1457, 42, 351, 5, 70, "Notes",ExpressionUUID->"ca187b22-b5c3-cd4d-9253-616d3acb8bb6"],
Cell[1806, 49, 670, 13, 70, "Notes",ExpressionUUID->"431c0572-d5aa-7245-b2a0-f264a10aab27"],
Cell[2466, 64, 429, 8, 70, "Notes",ExpressionUUID->"af11f7b7-e901-0e4d-9a2f-e42163c3c97d"],
