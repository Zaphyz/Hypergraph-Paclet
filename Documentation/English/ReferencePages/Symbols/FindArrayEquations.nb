 Cell[BoxData[
  StyleBox["IdentityArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "0d27e0b3-e9e7-ee4b-8d4f-217b136650c0"]
}], "SeeAlso",ExpressionUUID->"adfaa605-12fe-274a-95ee-355ea3ea091c"]
