(* Beginning of Notebook Content *)
Notebook[{
Cell["FindHypergraphIsomorphism", "ObjectName",ExpressionUUID->"2a2d40bd-bde5-954c-9077-03cb488bf68c"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"FindHypergraphIsomorphism", "[", 
    RowBox[{"hg1", ",", " ", "hg2"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"35b50043-87ed-8149-95ea-b25df946db98"],
 " ",
 "gives an association of vertex identifiers of hg1 to those of hg2 realizing \
an isomorphism, or an empty association if there is none."
}], "Usage",ExpressionUUID->"218764cf-c21b-5549-9cc0-c5daf30af70c"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"FindHypergraphIsomorphism", "[", 
    RowBox[{"hg1", ",", " ", "hg2", ",", " ", 
     RowBox[{"\"\<Labels\>\"", " ", "->", " ", "True"}]}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "f0c20703-e7d6-8b49-9178-9df505bf52ce"],
 " ",
 "gives instead an association with keys \"Vertices\", \"VertexLabels\" and \
\"EdgeLabels\", holding the vertex renaming and the two label correspondences \
that go with it."
}], "Usage",ExpressionUUID->"87cecd40-a250-b545-b6f8-1cafcc6f5779"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"1f37988f-a09c-2d4e-9008-bd0ce3e9d605"],

Cell["\<\
The notion of isomorphism is that of IsomorphicHypergraphQ, and the options \
are the same, with \"Labels\" added.\
\>", "Notes",ExpressionUUID->"d84af23a-4258-5541-8bbc-6eff1e79cdbd"],

Cell["\<\
The result is sorted by key. When a hypergraph has a non-trivial automorphism \
group there are several valid witnesses, and which one is returned is not \
specified.\
\>", "Notes",ExpressionUUID->"f3a06504-75f4-f746-8e18-ef6560707d27"],

Cell["\<\
With \"Labels\" -> True and no isomorphism, all three associations come back \
empty.\
\>", "Notes",ExpressionUUID->"f689fe61-c81f-0340-a72d-20195a3c5c71"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"d8f26868-3a69-e54c-95e6-c5acd0e07fbf"],

Cell["The vertex renaming alone:", "ExampleText",ExpressionUUID->"9ab37f3b-7b57-8b41-b856-3a903e531fad"],

Cell["\<\
FindHypergraphIsomorphism[Hypergraph[{{1, 2}, {2, 3}}], Hypergraph[{{10, 20}, \
{20, 30}}]]\
\>", "Input",ExpressionUUID->"1c9eda02-e3cb-8c4d-b1c6-870e80964a78"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"1", "\[Rule]", "10"}], ",", 
   RowBox[{"2", "\[Rule]", "20"}], ",", 
   RowBox[{"3", "\[Rule]", "30"}]}], "\[RightAssociation]"}]], "Output",Expres\
sionUUID->"808e6447-e9ce-ad4b-a0f5-20117a05667f"],

Cell["An empty association when there is none:", "ExampleText",ExpressionUUID->"0b2adbaa-074e-ca46-9266-59d222692e82"],

Cell["\<\
FindHypergraphIsomorphism[Hypergraph[{{1, 2}, {2, 3}}], Hypergraph[{{1, 2}, \
{1, 3}}]]\
\>", "Input",ExpressionUUID->"33882896-b14d-8948-ada2-8d99fa55b83b"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]], "Output",ExpressionUU\
ID->"7a25be8a-4aff-6941-9386-8c20afd19f57"],

Cell["Asking for the label correspondences as well:", "ExampleText",ExpressionUUID->"a2019e95-5e12-2040-97f4-2b8d7db1fa96"],

Cell["\<\
h1 = Hypergraph[{Edge[{1, 2}, \"Directed\", \"a\"], Edge[{2, 3}, \
\"Directed\", \"b\"]}];
h2 = Hypergraph[{Edge[{4, 5}, \"Directed\", \"x\"], Edge[{5, 6}, \
\"Directed\", \"y\"]}];
FindHypergraphIsomorphism[h1, h2, \"Labels\" -> True]\
\>", "Input",ExpressionUUID->"99bc267d-be5a-314b-bb52-fe6da0d49b71"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Vertices\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"1", "\[Rule]", "4"}], ",", 
      RowBox[{"2", "\[Rule]", "5"}], ",", 
      RowBox[{"3", "\[Rule]", "6"}]}], "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"VertexLabels\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"EdgeLabels\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"a\"\>", "\[Rule]", "\<\"x\"\>"}], ",", 
      RowBox[{"\<\"b\"\>", "\[Rule]", "\<\"y\"\>"}]}], 
     "\[RightAssociation]"}]}]}], "\[RightAssociation]"}]], "Output",Expressio\
nUUID->"80ccf6e2-0125-cb47-a4e1-f79e1da7fa5b"],

Cell["Vertex labels and edge labels are corresponded separately:", \
"ExampleText",ExpressionUUID->"24f34f7b-5bdd-4248-9767-dc66704cd5b8"],

Cell["\<\
i1 = Hypergraph[{Edge[{Vertex[1, \"A\"], Vertex[2, \"A\"]}, \"Directed\", \"f\
\"],
                 Edge[{Vertex[2, \"A\"], Vertex[3, \"B\"]}, \"Directed\", \"g\
\"]}];
i2 = Hypergraph[{Edge[{Vertex[1, \"P\"], Vertex[2, \"P\"]}, \"Directed\", \"g\
\"],
                 Edge[{Vertex[2, \"P\"], Vertex[3, \"Q\"]}, \"Directed\", \"f\
\"]}];
FindHypergraphIsomorphism[i1, i2, \"Labels\" -> True]\
\>", "Input",ExpressionUUID->"0d590c53-2bf4-ce49-8370-166ae17591ca"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Vertices\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"1", "\[Rule]", "1"}], ",", 
      RowBox[{"2", "\[Rule]", "2"}], ",", 
      RowBox[{"3", "\[Rule]", "3"}]}], "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"VertexLabels\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"A\"\>", "\[Rule]", "\<\"P\"\>"}], ",", 
      RowBox[{"\<\"B\"\>", "\[Rule]", "\<\"Q\"\>"}]}], 
     "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"EdgeLabels\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"f\"\>", "\[Rule]", "\<\"g\"\>"}], ",", 
      RowBox[{"\<\"g\"\>", "\[Rule]", "\<\"f\"\>"}]}], 
     "\[RightAssociation]"}]}]}], "\[RightAssociation]"}]], "Output",Expressio\
nUUID->"6d935dd4-9f2c-0f40-81f4-5c41c622f4ee"],

Cell["\<\
The labels can oblige the vertices to move. Here f is on two edges and g on \
one, while it is q that is on two and p on one, so vertex 4 must go to vertex \
2:\
\>", "ExampleText",ExpressionUUID->"d356df6b-88f5-2d49-9120-6b9e75e76fa5"],

Cell["\<\
k1 = Hypergraph[{Edge[{1, 2}, \"Directed\", \"f\"], Edge[{1, 3}, \
\"Directed\", \"f\"],
                 Edge[{1, 4}, \"Directed\", \"g\"]}];
k2 = Hypergraph[{Edge[{1, 2}, \"Directed\", \"p\"], Edge[{1, 3}, \
\"Directed\", \"q\"],
                 Edge[{1, 4}, \"Directed\", \"q\"]}];
FindHypergraphIsomorphism[k1, k2, \"Labels\" -> True]\
\>", "Input",ExpressionUUID->"917e5c98-1f86-a745-b5ce-3178c7e0d518"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Vertices\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"1", "\[Rule]", "1"}], ",", 
      RowBox[{"2", "\[Rule]", "3"}], ",", 
      RowBox[{"3", "\[Rule]", "4"}], ",", 
      RowBox[{"4", "\[Rule]", "2"}]}], "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"VertexLabels\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"EdgeLabels\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"f\"\>", "\[Rule]", "\<\"q\"\>"}], ",", 
      RowBox[{"\<\"g\"\>", "\[Rule]", "\<\"p\"\>"}]}], 
     "\[RightAssociation]"}]}]}], "\[RightAssociation]"}]], "Output",Expressio\
nUUID->"b7f63af2-7349-3a4e-a46e-93be92878f01"],

Cell["Source", "NotesSection",ExpressionUUID->"06c7d50b-e926-8c46-8c56-1ff8e6bc4999"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Canonical form and isomorphism",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"f3119e68-f9cd-f547-8b80-73452b8f5274"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"7241d4c6-447d-7849-879a-b08601503b7e"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["IsomorphicHypergraphQ", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"c489e575-59d1-ad4c-9ab1-5d833db52f37"],
 ", ",
 Cell[BoxData[
  StyleBox["CanonicalHypergraph", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"0c1142bd-9ae1-4444-9046-46833a8a43ce"],
 ", ",
 Cell[BoxData[
  StyleBox["Hypergraph", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "ea3b0994-7f62-564a-88ab-13713ba76487"]
}], "SeeAlso",ExpressionUUID->"593db11e-9f06-7842-b56e-a8e64721f288"]
},
WindowSize->{800, 750},
