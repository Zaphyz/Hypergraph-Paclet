Notebook[{
Cell["FindHypergraphIsomorphism", "ObjectName",ExpressionUUID->"a8de1de6-443e-e248-9720-7f95ec1fb179"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"FindHypergraphIsomorphism", "[", 
    RowBox[{"hg1", ",", " ", "hg2"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"43558049-2380-bc4b-b276-9f7d41ae3c9e"],
 " ",
 "gives an association of vertex identifiers of hg1 to those of hg2 realizing \
an isomorphism, or an empty association if there is none."
}], "Usage",ExpressionUUID->"65e0a4e7-22cd-6a4d-ae2e-b7d7f5893f64"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"FindHypergraphIsomorphism", "[", 
    RowBox[{"hg1", ",", " ", "hg2", ",", " ", 
     RowBox[{"\"\<Labels\>\"", " ", "->", " ", "True"}]}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "818eb408-ed42-1b41-8cab-830a1a7a7801"],
 " ",
 "gives instead an association with keys \"Vertices\", \"VertexLabels\" and \
\"EdgeLabels\", holding the vertex renaming and the two label correspondences \
that go with it."
}], "Usage",ExpressionUUID->"69acc349-d5c8-6d4b-933d-dcf10a3d0a84"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"63cebaf4-32fb-bb45-814c-1f5b93cb2fde"],

Cell["\<\
The notion of isomorphism is that of IsomorphicHypergraphQ, and the options \
are the same, with \"Labels\" added.\
\>", "Notes",ExpressionUUID->"095da10a-6cbf-9648-b296-84efccc8c511"],

Cell["\<\
The result is sorted by key. When a hypergraph has a non-trivial automorphism \
group there are several valid witnesses, and which one is returned is not \
specified.\
\>", "Notes",ExpressionUUID->"b1212f31-bd35-164e-a859-82d9642246d5"],

Cell["\<\
With \"Labels\" -> True and no isomorphism, all three associations come back \
empty.\
\>", "Notes",ExpressionUUID->"9ddc9ee1-b10b-6740-a5a9-4e187217fe6c"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"f42248ec-eb06-184a-a863-76c8c3b00766"],

Cell["The vertex renaming alone:", "ExampleText",ExpressionUUID->"c7ebedb2-153b-fa4f-9000-2e74e5cce6fd"],

Cell["\<\
FindHypergraphIsomorphism[Hypergraph[{{1, 2}, {2, 3}}], Hypergraph[{{10, 20}, \
{20, 30}}]]\
\>", "Input",ExpressionUUID->"5b905150-0e2b-e040-9d9c-41d7a6c735c6"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"1", "\[Rule]", "10"}], ",", 
   RowBox[{"2", "\[Rule]", "20"}], ",", 
   RowBox[{"3", "\[Rule]", "30"}]}], "\[RightAssociation]"}]], "Output",Expres\
sionUUID->"002c50d7-0432-c942-af4c-0b4007d402bd"],

Cell["An empty association when there is none:", "ExampleText",ExpressionUUID->"6b4e9db7-09d0-744c-bb28-b4f54ae908e3"],

Cell["\<\
FindHypergraphIsomorphism[Hypergraph[{{1, 2}, {2, 3}}], Hypergraph[{{1, 2}, \
{1, 3}}]]\
\>", "Input",ExpressionUUID->"72516b94-9bb2-2740-bd07-fa800233aa9f"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]], "Output",ExpressionUU\
ID->"3bd22269-64ec-cd49-915c-e82583f5d842"],

Cell["Asking for the label correspondences as well:", "ExampleText",ExpressionUUID->"b38a8145-161a-a243-8c87-fd889d677cc9"],

Cell["\<\
h1 = Hypergraph[{Edge[{1, 2}, \"Directed\", \"a\"], Edge[{2, 3}, \
\"Directed\", \"b\"]}];
h2 = Hypergraph[{Edge[{4, 5}, \"Directed\", \"x\"], Edge[{5, 6}, \
\"Directed\", \"y\"]}];
FindHypergraphIsomorphism[h1, h2, \"Labels\" -> True]\
\>", "Input",ExpressionUUID->"5653ba0e-7efd-6a49-85f7-0255423be2cf"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Vertices\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"1", "\[Rule]", "4"}], ",", 
      RowBox[{"2", "\[Rule]", "5"}], ",", 
      RowBox[{"3", "\[Rule]", "6"}]}], "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"VertexLabels\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"EdgeLabels\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"a\"\>", "\[Rule]", "\<\"x\"\>"}], ",", 
      RowBox[{"\<\"b\"\>", "\[Rule]", "\<\"y\"\>"}]}], 
     "\[RightAssociation]"}]}]}], "\[RightAssociation]"}]], "Output",Expressio\
nUUID->"4309784e-ae40-6b45-b3ba-6951d4c3482e"],

Cell["Vertex labels and edge labels are corresponded separately:", \
"ExampleText",ExpressionUUID->"be495850-a5be-2347-a2c2-88d51f804051"],

Cell["\<\
i1 = Hypergraph[{Edge[{Vertex[1, \"A\"], Vertex[2, \"A\"]}, \"Directed\", \"f\
\"],
                 Edge[{Vertex[2, \"A\"], Vertex[3, \"B\"]}, \"Directed\", \"g\
\"]}];
i2 = Hypergraph[{Edge[{Vertex[1, \"P\"], Vertex[2, \"P\"]}, \"Directed\", \"g\
\"],
                 Edge[{Vertex[2, \"P\"], Vertex[3, \"Q\"]}, \"Directed\", \"f\
\"]}];
FindHypergraphIsomorphism[i1, i2, \"Labels\" -> True]\
\>", "Input",ExpressionUUID->"a4dc608d-a945-6140-aba7-7ed6eba79c82"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Vertices\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"1", "\[Rule]", "1"}], ",", 
      RowBox[{"2", "\[Rule]", "2"}], ",", 
      RowBox[{"3", "\[Rule]", "3"}]}], "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"VertexLabels\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"A\"\>", "\[Rule]", "\<\"P\"\>"}], ",", 
      RowBox[{"\<\"B\"\>", "\[Rule]", "\<\"Q\"\>"}]}], 
     "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"EdgeLabels\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"f\"\>", "\[Rule]", "\<\"g\"\>"}], ",", 
      RowBox[{"\<\"g\"\>", "\[Rule]", "\<\"f\"\>"}]}], 
     "\[RightAssociation]"}]}]}], "\[RightAssociation]"}]], "Output",Expressio\
nUUID->"0fa9c16d-a363-c143-9880-b082992c4855"],

Cell["\<\
The labels can oblige the vertices to move. Here f is on two edges and g on \
one, while it is q that is on two and p on one, so vertex 4 must go to vertex \
2:\
\>", "ExampleText",ExpressionUUID->"3b2be625-7830-524a-8297-34295d64985b"],

Cell["\<\
k1 = Hypergraph[{Edge[{1, 2}, \"Directed\", \"f\"], Edge[{1, 3}, \
\"Directed\", \"f\"],
                 Edge[{1, 4}, \"Directed\", \"g\"]}];
k2 = Hypergraph[{Edge[{1, 2}, \"Directed\", \"p\"], Edge[{1, 3}, \
\"Directed\", \"q\"],
                 Edge[{1, 4}, \"Directed\", \"q\"]}];
FindHypergraphIsomorphism[k1, k2, \"Labels\" -> True]\
\>", "Input",ExpressionUUID->"bff61ef1-189a-dd4b-ac28-9ac4d9bd427f"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Vertices\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"1", "\[Rule]", "1"}], ",", 
      RowBox[{"2", "\[Rule]", "3"}], ",", 
      RowBox[{"3", "\[Rule]", "4"}], ",", 
      RowBox[{"4", "\[Rule]", "2"}]}], "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"VertexLabels\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"EdgeLabels\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"f\"\>", "\[Rule]", "\<\"q\"\>"}], ",", 
      RowBox[{"\<\"g\"\>", "\[Rule]", "\<\"p\"\>"}]}], 
     "\[RightAssociation]"}]}]}], "\[RightAssociation]"}]], "Output",Expressio\
nUUID->"379e4d86-20bc-1747-9bee-a7c2274e03a5"],

Cell["Source", "NotesSection",ExpressionUUID->"641980cf-9ebf-d646-8b09-2833c9316f67"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Canonical form and isomorphism",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"9357a8e2-21e6-994d-896e-e8e274ab16c2"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"5728b240-4ebb-e84f-8f95-ca710bad92fa"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["IsomorphicHypergraphQ", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"33d808c4-deb1-0e4a-bf9b-073dcc3858af"],
 ", ",
 Cell[BoxData[
  StyleBox["CanonicalHypergraph", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"61f3c6e2-95ae-0c48-bef8-b93de2997c69"],
 ", ",
 Cell[BoxData[
  StyleBox["Hypergraph", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "6026cb3d-c2e7-f346-87ec-f13f17701a26"]
}], "SeeAlso",ExpressionUUID->"267c047d-0882-4645-9a93-c9f87e8e5720"]
},
