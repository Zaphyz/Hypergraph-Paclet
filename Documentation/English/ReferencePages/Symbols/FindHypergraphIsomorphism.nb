(* Beginning of Notebook Content *)
Notebook[{
Cell["FindHypergraphIsomorphism", "ObjectName",ExpressionUUID->"d166f317-05fa-ec42-9394-e5b51bd65498"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"FindHypergraphIsomorphism", "[", 
    RowBox[{"hg1", ",", " ", "hg2"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"22caac3e-b2ed-294a-ab86-def88b5bb81d"],
 " ",
 "gives an association of vertex identifiers of hg1 to those of hg2 realizing \
an isomorphism, or an empty association if there is none."
}], "Usage",ExpressionUUID->"2fff4838-daa2-a14f-91ab-bd60830c83ce"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"FindHypergraphIsomorphism", "[", 
    RowBox[{"hg1", ",", " ", "hg2", ",", " ", 
     RowBox[{"\"\<Labels\>\"", " ", "->", " ", "True"}]}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "787a7e4b-3104-9e48-ae80-9cf21a4479ee"],
 " ",
 "gives instead an association with keys \"Vertices\", \"VertexLabels\" and \
\"EdgeLabels\", holding the vertex renaming and the two label correspondences \
that go with it."
}], "Usage",ExpressionUUID->"c3012a9c-b26b-f446-949a-af26b59ac13e"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"1b9df6a0-24f7-4644-a48c-0a5772018b9c"],

Cell["\<\
The notion of isomorphism is that of IsomorphicHypergraphQ, and the options \
are the same, with \"Labels\" added.\
\>", "Notes",ExpressionUUID->"ac77e959-ed4d-7241-b32d-e20f266a5be4"],

Cell["\<\
The result is sorted by key. When a hypergraph has a non-trivial automorphism \
group there are several valid witnesses, and which one is returned is not \
specified.\
\>", "Notes",ExpressionUUID->"77812d17-68c5-fa4e-bee6-4ee4bf6e90ef"],

Cell["\<\
With \"Labels\" -> True and no isomorphism, all three associations come back \
empty.\
\>", "Notes",ExpressionUUID->"af0eb4ed-c651-c542-a385-6430a82ffe9c"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"a997a0aa-8a21-954d-838f-49341f31c798"],

Cell["The vertex renaming alone:", "ExampleText",ExpressionUUID->"92564858-386b-cd4b-844c-28a50d2ba346"],

Cell["\<\
FindHypergraphIsomorphism[Hypergraph[{{1, 2}, {2, 3}}], Hypergraph[{{10, 20}, \
{20, 30}}]]\
\>", "Input",ExpressionUUID->"378e7ed2-ff93-0c45-8a6b-98fc9c588e2a"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"1", "\[Rule]", "10"}], ",", 
   RowBox[{"2", "\[Rule]", "20"}], ",", 
   RowBox[{"3", "\[Rule]", "30"}]}], "\[RightAssociation]"}]], "Output",Expres\
sionUUID->"eb02f7c6-226e-e047-b428-ca995e0b4fc7"],

Cell["An empty association when there is none:", "ExampleText",ExpressionUUID->"210402f1-dfb6-294b-8932-4b828fb81b6b"],

Cell["\<\
FindHypergraphIsomorphism[Hypergraph[{{1, 2}, {2, 3}}], Hypergraph[{{1, 2}, \
{1, 3}}]]\
\>", "Input",ExpressionUUID->"a9fbe579-bfc2-0040-9ab9-873f723ff2b3"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]], "Output",ExpressionUU\
ID->"5a4e9664-b8a9-8c4e-b9d5-14bfef238167"],

Cell["Asking for the label correspondences as well:", "ExampleText",ExpressionUUID->"d2e9a0c0-e3df-084d-a24a-8b8ca610cb91"],

Cell["\<\
h1 = Hypergraph[{Edge[{1, 2}, \"Directed\", \"a\"], Edge[{2, 3}, \
\"Directed\", \"b\"]}];
h2 = Hypergraph[{Edge[{4, 5}, \"Directed\", \"x\"], Edge[{5, 6}, \
\"Directed\", \"y\"]}];
FindHypergraphIsomorphism[h1, h2, \"Labels\" -> True]\
\>", "Input",ExpressionUUID->"5439ed06-4b02-1145-b305-e653248eb100"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Vertices\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"1", "\[Rule]", "4"}], ",", 
      RowBox[{"2", "\[Rule]", "5"}], ",", 
      RowBox[{"3", "\[Rule]", "6"}]}], "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"VertexLabels\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"EdgeLabels\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"a\"\>", "\[Rule]", "\<\"x\"\>"}], ",", 
      RowBox[{"\<\"b\"\>", "\[Rule]", "\<\"y\"\>"}]}], 
     "\[RightAssociation]"}]}]}], "\[RightAssociation]"}]], "Output",Expressio\
nUUID->"a34f9eb3-bb0a-5f45-b7b4-69394e054dfe"],

Cell["Vertex labels and edge labels are corresponded separately:", \
"ExampleText",ExpressionUUID->"0fe1c92b-27b4-354a-a3e1-a3e5caceecdf"],

Cell["\<\
i1 = Hypergraph[{Edge[{Vertex[1, \"A\"], Vertex[2, \"A\"]}, \"Directed\", \"f\
\"],
                 Edge[{Vertex[2, \"A\"], Vertex[3, \"B\"]}, \"Directed\", \"g\
\"]}];
i2 = Hypergraph[{Edge[{Vertex[1, \"P\"], Vertex[2, \"P\"]}, \"Directed\", \"g\
\"],
                 Edge[{Vertex[2, \"P\"], Vertex[3, \"Q\"]}, \"Directed\", \"f\
\"]}];
FindHypergraphIsomorphism[i1, i2, \"Labels\" -> True]\
\>", "Input",ExpressionUUID->"4ff56fef-19d6-b34b-9aa2-8ddd28a02823"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Vertices\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"1", "\[Rule]", "1"}], ",", 
      RowBox[{"2", "\[Rule]", "2"}], ",", 
      RowBox[{"3", "\[Rule]", "3"}]}], "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"VertexLabels\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"A\"\>", "\[Rule]", "\<\"P\"\>"}], ",", 
      RowBox[{"\<\"B\"\>", "\[Rule]", "\<\"Q\"\>"}]}], 
     "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"EdgeLabels\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"f\"\>", "\[Rule]", "\<\"g\"\>"}], ",", 
      RowBox[{"\<\"g\"\>", "\[Rule]", "\<\"f\"\>"}]}], 
     "\[RightAssociation]"}]}]}], "\[RightAssociation]"}]], "Output",Expressio\
nUUID->"cba3ccdb-2a06-d04f-8597-70a82a368a95"],

Cell["\<\
The labels can oblige the vertices to move. Here f is on two edges and g on \
one, while it is q that is on two and p on one, so vertex 4 must go to vertex \
2:\
\>", "ExampleText",ExpressionUUID->"4f6421aa-5e3e-8a49-9a4f-bca1990206e0"],

Cell["\<\
k1 = Hypergraph[{Edge[{1, 2}, \"Directed\", \"f\"], Edge[{1, 3}, \
\"Directed\", \"f\"],
                 Edge[{1, 4}, \"Directed\", \"g\"]}];
k2 = Hypergraph[{Edge[{1, 2}, \"Directed\", \"p\"], Edge[{1, 3}, \
\"Directed\", \"q\"],
                 Edge[{1, 4}, \"Directed\", \"q\"]}];
FindHypergraphIsomorphism[k1, k2, \"Labels\" -> True]\
\>", "Input",ExpressionUUID->"256738b4-5a13-f046-92ce-37cd51e95ea1"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Vertices\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"1", "\[Rule]", "1"}], ",", 
      RowBox[{"2", "\[Rule]", "3"}], ",", 
      RowBox[{"3", "\[Rule]", "4"}], ",", 
      RowBox[{"4", "\[Rule]", "2"}]}], "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"VertexLabels\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"EdgeLabels\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"f\"\>", "\[Rule]", "\<\"q\"\>"}], ",", 
      RowBox[{"\<\"g\"\>", "\[Rule]", "\<\"p\"\>"}]}], 
     "\[RightAssociation]"}]}]}], "\[RightAssociation]"}]], "Output",Expressio\
nUUID->"2f14724e-d7bd-d447-b514-ef14b109478f"],

Cell["Source", "NotesSection",ExpressionUUID->"d16c1c7f-7035-434b-b974-9058695057ab"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Canonical form and isomorphism",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"0d0e7497-01c9-6541-980a-1c2191f97960"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"6cea76f3-7acc-194d-9368-f68af9bcfe15"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["IsomorphicHypergraphQ", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"54b0cc85-62b8-1043-ab5e-610a4677f8f8"],
 ", ",
 Cell[BoxData[
  StyleBox["CanonicalHypergraph", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"78d28f7e-bd98-1d40-82bc-cb61c6741d4b"],
 ", ",
 Cell[BoxData[
  StyleBox["Hypergraph", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "044b1a5d-fd27-f44d-8932-301d19e1593f"]
}], "SeeAlso",ExpressionUUID->"a0c3248d-a656-2a41-bd27-390f3581e776"]
},
