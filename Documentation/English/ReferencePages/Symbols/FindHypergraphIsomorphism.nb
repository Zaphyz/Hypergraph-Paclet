(* Beginning of Notebook Content *)
Notebook[{
Cell["FindHypergraphIsomorphism", "ObjectName",ExpressionUUID->"c079cb0e-1263-9346-a3c3-9beee82a12dd"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"FindHypergraphIsomorphism", "[", 
    RowBox[{"hg1", ",", " ", "hg2"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"bf05a148-5e65-a343-a1f1-8358bde98d99"],
 " ",
 "gives an association of vertex identifiers of hg1 to those of hg2 realizing \
an isomorphism, or an empty association if there is none."
}], "Usage",ExpressionUUID->"9c818673-5ff7-314b-bc1b-519d83a640cb"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"FindHypergraphIsomorphism", "[", 
    RowBox[{"hg1", ",", " ", "hg2", ",", " ", 
     RowBox[{"\"\<Labels\>\"", " ", "->", " ", "True"}]}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "687a9fac-efcc-d543-8eb3-358881511229"],
 " ",
 "gives instead an association with keys \"Vertices\", \"VertexLabels\" and \
\"EdgeLabels\", holding the vertex renaming and the two label correspondences \
that go with it."
}], "Usage",ExpressionUUID->"daa26f2e-5c53-c241-a00c-a4ea27e73a65"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"79514b66-453e-d84a-962f-d978c44e0d33"],

Cell["\<\
The notion of isomorphism is that of IsomorphicHypergraphQ, and the options \
are the same, with \"Labels\" added.\
\>", "Notes",ExpressionUUID->"8422a768-39a9-e447-bac5-783bab9c2122"],

Cell["\<\
The result is sorted by key. When a hypergraph has a non-trivial automorphism \
group there are several valid witnesses, and which one is returned is not \
specified.\
\>", "Notes",ExpressionUUID->"d3376fb7-af95-984c-83e9-dbff9289d639"],

Cell["\<\
With \"Labels\" -> True and no isomorphism, all three associations come back \
empty.\
\>", "Notes",ExpressionUUID->"1525f479-6bbe-2646-bed7-af6c9f76985a"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"12ae72a0-ad51-8244-97cb-7f23301e244b"],

Cell["The vertex renaming alone:", "ExampleText",ExpressionUUID->"825e44e1-98d3-ad4a-8eae-1ec976e9288b"],

Cell["\<\
FindHypergraphIsomorphism[Hypergraph[{{1, 2}, {2, 3}}], Hypergraph[{{10, 20}, \
{20, 30}}]]\
\>", "Input",ExpressionUUID->"42006a26-7ced-af41-81c1-790f7bdc3d22"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"1", "\[Rule]", "10"}], ",", 
   RowBox[{"2", "\[Rule]", "20"}], ",", 
   RowBox[{"3", "\[Rule]", "30"}]}], "\[RightAssociation]"}]], "Output",Expres\
sionUUID->"b3bb8fad-96c1-0b44-8d94-dff721cac9e9"],

Cell["An empty association when there is none:", "ExampleText",ExpressionUUID->"bfc42339-86b2-c147-b714-56e9f3ecf044"],

Cell["\<\
FindHypergraphIsomorphism[Hypergraph[{{1, 2}, {2, 3}}], Hypergraph[{{1, 2}, \
{1, 3}}]]\
\>", "Input",ExpressionUUID->"8d85206b-487f-cb4f-be74-e84234890ea0"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]], "Output",ExpressionUU\
ID->"295985bf-df33-2f48-b1a0-fcdd4289c117"],

Cell["Asking for the label correspondences as well:", "ExampleText",ExpressionUUID->"8aa89725-9de4-ec4a-9fa9-63b484b6abb1"],

Cell["\<\
h1 = Hypergraph[{Edge[{1, 2}, \"Directed\", \"a\"], Edge[{2, 3}, \
\"Directed\", \"b\"]}];
h2 = Hypergraph[{Edge[{4, 5}, \"Directed\", \"x\"], Edge[{5, 6}, \
\"Directed\", \"y\"]}];
FindHypergraphIsomorphism[h1, h2, \"Labels\" -> True]\
\>", "Input",ExpressionUUID->"f8855eb9-b79a-c54b-a428-bd77e83ec410"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Vertices\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"1", "\[Rule]", "4"}], ",", 
      RowBox[{"2", "\[Rule]", "5"}], ",", 
      RowBox[{"3", "\[Rule]", "6"}]}], "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"VertexLabels\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"EdgeLabels\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"a\"\>", "\[Rule]", "\<\"x\"\>"}], ",", 
      RowBox[{"\<\"b\"\>", "\[Rule]", "\<\"y\"\>"}]}], 
     "\[RightAssociation]"}]}]}], "\[RightAssociation]"}]], "Output",Expressio\
nUUID->"70a0a560-9e5e-604d-a5f3-447fc8483439"],

Cell["Vertex labels and edge labels are corresponded separately:", \
"ExampleText",ExpressionUUID->"a6ceb465-c65b-934a-9176-0e4b30a9de6c"],

Cell["\<\
i1 = Hypergraph[{Edge[{Vertex[1, \"A\"], Vertex[2, \"A\"]}, \"Directed\", \"f\
\"],
                 Edge[{Vertex[2, \"A\"], Vertex[3, \"B\"]}, \"Directed\", \"g\
\"]}];
i2 = Hypergraph[{Edge[{Vertex[1, \"P\"], Vertex[2, \"P\"]}, \"Directed\", \"g\
\"],
                 Edge[{Vertex[2, \"P\"], Vertex[3, \"Q\"]}, \"Directed\", \"f\
\"]}];
FindHypergraphIsomorphism[i1, i2, \"Labels\" -> True]\
\>", "Input",ExpressionUUID->"261c2792-55d6-6448-933c-4beb53b7fb5b"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Vertices\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"1", "\[Rule]", "1"}], ",", 
      RowBox[{"2", "\[Rule]", "2"}], ",", 
      RowBox[{"3", "\[Rule]", "3"}]}], "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"VertexLabels\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"A\"\>", "\[Rule]", "\<\"P\"\>"}], ",", 
      RowBox[{"\<\"B\"\>", "\[Rule]", "\<\"Q\"\>"}]}], 
     "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"EdgeLabels\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"f\"\>", "\[Rule]", "\<\"g\"\>"}], ",", 
      RowBox[{"\<\"g\"\>", "\[Rule]", "\<\"f\"\>"}]}], 
     "\[RightAssociation]"}]}]}], "\[RightAssociation]"}]], "Output",Expressio\
nUUID->"e67ec55c-f068-ac43-b397-16da365e9199"],

Cell["\<\
The labels can oblige the vertices to move. Here f is on two edges and g on \
one, while it is q that is on two and p on one, so vertex 4 must go to vertex \
2:\
\>", "ExampleText",ExpressionUUID->"ad298eeb-ba8a-b043-84b2-0c4ea49805d9"],

Cell["\<\
k1 = Hypergraph[{Edge[{1, 2}, \"Directed\", \"f\"], Edge[{1, 3}, \
\"Directed\", \"f\"],
                 Edge[{1, 4}, \"Directed\", \"g\"]}];
k2 = Hypergraph[{Edge[{1, 2}, \"Directed\", \"p\"], Edge[{1, 3}, \
\"Directed\", \"q\"],
                 Edge[{1, 4}, \"Directed\", \"q\"]}];
FindHypergraphIsomorphism[k1, k2, \"Labels\" -> True]\
\>", "Input",ExpressionUUID->"c9e9f957-e5fd-9143-9b3b-466c832c9a91"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Vertices\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"1", "\[Rule]", "1"}], ",", 
      RowBox[{"2", "\[Rule]", "3"}], ",", 
      RowBox[{"3", "\[Rule]", "4"}], ",", 
      RowBox[{"4", "\[Rule]", "2"}]}], "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"VertexLabels\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"EdgeLabels\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"f\"\>", "\[Rule]", "\<\"q\"\>"}], ",", 
      RowBox[{"\<\"g\"\>", "\[Rule]", "\<\"p\"\>"}]}], 
     "\[RightAssociation]"}]}]}], "\[RightAssociation]"}]], "Output",Expressio\
nUUID->"5654da01-a9e2-6642-b84c-ee3bca3347ed"],

Cell["Source", "NotesSection",ExpressionUUID->"e024b18c-5e5e-204c-b400-285a090507ab"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Canonical form and isomorphism",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"05988a0b-e60f-c840-a504-5d0bf61d25eb"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"edf2bb5e-dc9e-1147-b685-ca36a9028ab0"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["IsomorphicHypergraphQ", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"622ce705-54dc-c24c-9109-c53488c9483f"],
 ", ",
 Cell[BoxData[
  StyleBox["CanonicalHypergraph", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"f9e61963-7d8a-c844-8d08-7efbaea28997"],
 ", ",
 Cell[BoxData[
  StyleBox["Hypergraph", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "60183db1-50ce-c142-abd1-4a30a9de5140"]
}], "SeeAlso",ExpressionUUID->"816c2260-4512-8d42-a8e5-40e6cf092ea2"]
},
