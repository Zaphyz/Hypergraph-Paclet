(* Beginning of Notebook Content *)
Notebook[{
Cell["FindHypergraphIsomorphism", "ObjectName",ExpressionUUID->"c1cc12e5-aa55-7240-b0f6-2ffcf7277f0d"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"FindHypergraphIsomorphism", "[", 
    RowBox[{"hg1", ",", " ", "hg2"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"943b40a4-3103-6349-a096-b100c0707b32"],
 " ",
 "gives an association of vertex identifiers of hg1 to those of hg2 realizing \
an isomorphism, or an empty association if there is none."
}], "Usage",ExpressionUUID->"73f547e4-ea7d-9a40-a6cf-3dd47a9de68b"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"FindHypergraphIsomorphism", "[", 
    RowBox[{"hg1", ",", " ", "hg2", ",", " ", 
     RowBox[{"\"\<Labels\>\"", " ", "->", " ", "True"}]}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "f2935b28-d0e0-724e-9a5a-e47c31b59b39"],
 " ",
 "gives instead an association with keys \"Vertices\", \"VertexLabels\" and \
\"EdgeLabels\", holding the vertex renaming and the two label correspondences \
that go with it."
}], "Usage",ExpressionUUID->"c29686f4-a95a-a94b-ac20-9dbe5a6afa5f"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"82fb78d3-b250-9441-a6ed-0f6ede2b2d14"],

Cell["\<\
The notion of isomorphism is that of IsomorphicHypergraphQ, and the options \
are the same, with \"Labels\" added.\
\>", "Notes",ExpressionUUID->"7e39da63-fb3a-fb40-ab7a-6a7c71c22859"],

Cell["\<\
The result is sorted by key. When a hypergraph has a non-trivial automorphism \
group there are several valid witnesses, and which one is returned is not \
specified.\
\>", "Notes",ExpressionUUID->"b7b6ccde-bbbe-684d-93a3-be6450f6bd99"],

Cell["\<\
With \"Labels\" -> True and no isomorphism, all three associations come back \
empty.\
\>", "Notes",ExpressionUUID->"9d6231f9-2956-5d4c-8761-b0e49ec1ae16"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"90bf5f71-5830-714f-a6ef-f790bc50cc22"],

Cell["The vertex renaming alone:", "ExampleText",ExpressionUUID->"42e1ac4b-9179-4e4c-89a6-1686204c2f25"],

Cell["\<\
FindHypergraphIsomorphism[Hypergraph[{{1, 2}, {2, 3}}], Hypergraph[{{10, 20}, \
{20, 30}}]]\
\>", "Input",ExpressionUUID->"6221c79b-4dad-9d42-8a11-e85f33547791"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"1", "\[Rule]", "10"}], ",", 
   RowBox[{"2", "\[Rule]", "20"}], ",", 
   RowBox[{"3", "\[Rule]", "30"}]}], "\[RightAssociation]"}]], "Output",Expres\
sionUUID->"7486407a-2838-684d-a881-99eec716f335"],

Cell["An empty association when there is none:", "ExampleText",ExpressionUUID->"784e46ec-744f-704e-aed7-f3d779738128"],

Cell["\<\
FindHypergraphIsomorphism[Hypergraph[{{1, 2}, {2, 3}}], Hypergraph[{{1, 2}, \
{1, 3}}]]\
\>", "Input",ExpressionUUID->"1467c8c6-465c-9648-bde5-63b4871b4784"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]], "Output",ExpressionUU\
ID->"c0614c69-b520-f04d-8cfd-fbf569bbbf66"],

Cell["Asking for the label correspondences as well:", "ExampleText",ExpressionUUID->"c31ede91-2ffa-5d40-8167-6684b48462eb"],

Cell["\<\
h1 = Hypergraph[{Edge[{1, 2}, \"Directed\", \"a\"], Edge[{2, 3}, \
\"Directed\", \"b\"]}];
h2 = Hypergraph[{Edge[{4, 5}, \"Directed\", \"x\"], Edge[{5, 6}, \
\"Directed\", \"y\"]}];
FindHypergraphIsomorphism[h1, h2, \"Labels\" -> True]\
\>", "Input",ExpressionUUID->"6e4fb2b6-eeda-544d-b905-41623d334d46"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Vertices\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"1", "\[Rule]", "4"}], ",", 
      RowBox[{"2", "\[Rule]", "5"}], ",", 
      RowBox[{"3", "\[Rule]", "6"}]}], "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"VertexLabels\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"EdgeLabels\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"a\"\>", "\[Rule]", "\<\"x\"\>"}], ",", 
      RowBox[{"\<\"b\"\>", "\[Rule]", "\<\"y\"\>"}]}], 
     "\[RightAssociation]"}]}]}], "\[RightAssociation]"}]], "Output",Expressio\
nUUID->"a686187f-e355-914f-984a-f5b82ec53f96"],

Cell["Vertex labels and edge labels are corresponded separately:", \
"ExampleText",ExpressionUUID->"b9135808-ceba-cd48-8ce1-8afc3416f195"],

Cell["\<\
i1 = Hypergraph[{Edge[{Vertex[1, \"A\"], Vertex[2, \"A\"]}, \"Directed\", \"f\
\"],
                 Edge[{Vertex[2, \"A\"], Vertex[3, \"B\"]}, \"Directed\", \"g\
\"]}];
i2 = Hypergraph[{Edge[{Vertex[1, \"P\"], Vertex[2, \"P\"]}, \"Directed\", \"g\
\"],
                 Edge[{Vertex[2, \"P\"], Vertex[3, \"Q\"]}, \"Directed\", \"f\
\"]}];
FindHypergraphIsomorphism[i1, i2, \"Labels\" -> True]\
\>", "Input",ExpressionUUID->"1e441ec4-c1fa-534e-9021-72b028a3c103"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Vertices\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"1", "\[Rule]", "1"}], ",", 
      RowBox[{"2", "\[Rule]", "2"}], ",", 
      RowBox[{"3", "\[Rule]", "3"}]}], "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"VertexLabels\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"A\"\>", "\[Rule]", "\<\"P\"\>"}], ",", 
      RowBox[{"\<\"B\"\>", "\[Rule]", "\<\"Q\"\>"}]}], 
     "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"EdgeLabels\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"f\"\>", "\[Rule]", "\<\"g\"\>"}], ",", 
      RowBox[{"\<\"g\"\>", "\[Rule]", "\<\"f\"\>"}]}], 
     "\[RightAssociation]"}]}]}], "\[RightAssociation]"}]], "Output",Expressio\
nUUID->"a59ad542-c0a9-ff4f-aabc-1a80f17a8c18"],

Cell["\<\
The labels can oblige the vertices to move. Here f is on two edges and g on \
one, while it is q that is on two and p on one, so vertex 4 must go to vertex \
2:\
\>", "ExampleText",ExpressionUUID->"93ebf1bd-7781-ee4c-9f76-47d3c60efcc9"],

Cell["\<\
k1 = Hypergraph[{Edge[{1, 2}, \"Directed\", \"f\"], Edge[{1, 3}, \
\"Directed\", \"f\"],
                 Edge[{1, 4}, \"Directed\", \"g\"]}];
k2 = Hypergraph[{Edge[{1, 2}, \"Directed\", \"p\"], Edge[{1, 3}, \
\"Directed\", \"q\"],
                 Edge[{1, 4}, \"Directed\", \"q\"]}];
FindHypergraphIsomorphism[k1, k2, \"Labels\" -> True]\
\>", "Input",ExpressionUUID->"c029bff2-1926-2048-a770-35b24ced9ff4"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Vertices\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"1", "\[Rule]", "1"}], ",", 
      RowBox[{"2", "\[Rule]", "3"}], ",", 
      RowBox[{"3", "\[Rule]", "4"}], ",", 
      RowBox[{"4", "\[Rule]", "2"}]}], "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"VertexLabels\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"EdgeLabels\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"f\"\>", "\[Rule]", "\<\"q\"\>"}], ",", 
      RowBox[{"\<\"g\"\>", "\[Rule]", "\<\"p\"\>"}]}], 
     "\[RightAssociation]"}]}]}], "\[RightAssociation]"}]], "Output",Expressio\
nUUID->"44c04aa7-4c55-ad49-ac3d-8434d1884274"],

Cell["Source", "NotesSection",ExpressionUUID->"604bbeb5-01a2-c841-ae4f-189b2a4e4910"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Canonical form and isomorphism",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"f5ea7758-ed6d-b144-8a39-d70aedaedbf8"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"67ff6191-4b75-5e40-ae16-2fe49ea82df7"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["IsomorphicHypergraphQ", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"e0875ec2-83fb-3548-9f38-b2c1fb7305cc"],
 ", ",
 Cell[BoxData[
  StyleBox["CanonicalHypergraph", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"e98aa0d4-742b-c24c-8459-f26392cd71b4"],
 ", ",
 Cell[BoxData[
  StyleBox["Hypergraph", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "e9ec0485-77fd-014a-8aeb-23393bad3ac6"]
}], "SeeAlso",ExpressionUUID->"324c291b-6d43-d647-82d0-031c551efa76"]
},
