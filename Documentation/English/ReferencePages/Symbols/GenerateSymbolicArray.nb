Notebook[{
Cell["GenerateSymbolicArray", "ObjectName",ExpressionUUID->"da116bc2-8544-e342-8530-5dbe910b3bfe"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"GenerateSymbolicArray", "[", 
    RowBox[{"name", ",", " ", "dims"}], "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"e4b61ff0-4e58-c149-97f7-34de3a821096"],
 " ",
 "represents an array of the given dimensions whose entries are the \
expressions name[i1, i2, ...] formed from name and the indices."
}], "Usage",ExpressionUUID->"2f688122-3fb6-1444-93c5-2feadabd9908"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"GenerateSymbolicArray", "[", 
    RowBox[{"name", ",", " ", "dims", ",", " ", "sym"}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "0946a809-824b-524e-a612-9db2ec636be9"],
 " ",
 "additionally declares the index symmetry sym."
}], "Usage",ExpressionUUID->"a5b8ab46-7c11-a847-af97-5658441778db"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"261e9a08-7a11-7d48-b3c9-e33ec4d1a1ae"],

Cell["\<\
The entries are not stored. They are generated on demand by ArrayEntries or \
Normal, so a symbolic array of any size costs nothing to hold.\
\>", "Notes",ExpressionUUID->"14498fe3-8bf8-554e-bab9-9f7b19374618"],

Cell["\<\
The name must be a symbol or a string. The dimensions must be a list of \
positive integers. The empty list gives the array of order zero, whose single \
entry is the bare name.\
\>", "Notes",ExpressionUUID->"6c3fd3df-464a-7947-819d-931dbbca641b"],

Cell["\<\
The index symmetry sym is one of \"Rigid\" (the default), \"Cyclic\" or \
\"Symmetric\", and only a regular array can carry one other than \"Rigid\".\
\>", "Notes",ExpressionUUID->"178b7eb0-234f-234d-9258-08799c8a9210"],

Cell["\<\
Under a symmetry, index tuples that are equivalent name the same entry: the \
entry at a given tuple is the name applied to the least tuple in its orbit. A \
symmetric or cyclic symbolic array is therefore symmetric or cyclic by \
construction, with no checking needed.\
\>", "Notes",ExpressionUUID->"ec2ccd37-8daf-2b4a-9d03-10655ade8dc5"],

Cell[TextData[{
 "The generated entries answer to no numeric domain, so ",
 Cell[BoxData[
  StyleBox["ArrayDomain", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "73772bb8-f34b-5a4d-aecf-6a9d726e2f4e"],
 " of such an array is ",
 Cell[BoxData[
  StyleBox["\"\<Expression\>\"", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"a7159c7c-e52e-6d4e-b800-6ff3c6f277dc"],
 "."
}], "Notes",ExpressionUUID->"8de10cd6-b1bc-b841-aac1-6305b6f30bf0"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"a7a06c16-e3b6-a041-9034-0d3d9644db5d"],

Cell["The entries are the name applied to the indices:", "ExampleText",ExpressionUUID->"1230829e-0d97-6d47-a443-063455c0a8d8"],

Cell["Normal @ GenerateSymbolicArray[a, {2, 3}]", "Input",ExpressionUUID->"e7ce7afe-fc09-fb4d-8940-710b80d03179"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "1"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "3"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "1"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "3"}], "]"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"f49fea48-ddc9-af4c-8742-d6670d117cdc"],

Cell["Under a symmetry, equivalent index tuples name one entry:", \
"ExampleText",ExpressionUUID->"ff6afec0-c4d2-bb4f-a048-d2e485cfc6c0"],

Cell["Normal @ GenerateSymbolicArray[a, {3, 3}, \"Symmetric\"]", "Input",ExpressionUUID->"bf1e7a85-20a0-b849-92f7-56325fa8f305"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "1"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "3"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "3"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "3"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "3"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"3", ",", "3"}], "]"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"8029634d-457f-8643-8e99-dbae01c0cc36"],

Cell["So the generated array really is symmetric:", "ExampleText",ExpressionUUID->"b6e22473-fb48-9548-bc6b-2db101774a41"],

Cell["\<\
With[{e = Normal @ GenerateSymbolicArray[a, {3, 3}, \"Symmetric\"]}, e === \
Transpose[e]]\
\>", "Input",ExpressionUUID->"98dfc1c3-326a-ac49-bff5-22e5b44ed9c1"],

Cell[BoxData["True"], "Output",ExpressionUUID->"f470c71a-6a88-994f-ac84-a0cc334906c5"],

Cell["\<\
At order three the three symmetries give different numbers of distinct \
entries:\
\>", "ExampleText",ExpressionUUID->"08d8136e-5ded-8940-96ec-0dac1741e13b"],

Cell["\<\
Length @ DeleteDuplicates @ Flatten @ Normal @ GenerateSymbolicArray[a, {3, \
3, 3}, #] & /@
  {\"Rigid\", \"Cyclic\", \"Symmetric\"}\
\>", "Input",ExpressionUUID->"88e28dec-7d7f-b246-a98d-07b7edf6f85f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"27", ",", "11", ",", "10"}], "}"}]], "Output",ExpressionUUID->\
"5f6aa6e2-c5b1-5c48-9fde-0c15d1e268a7"],

Cell["\<\
At order two the cyclic group is the symmetric group, so the two coincide:\
\>", "ExampleText",ExpressionUUID->"03ef2082-f32d-b942-b649-f61447e2c508"],

Cell["\<\
Normal[GenerateSymbolicArray[a, {3, 3}, \"Cyclic\"]] === \
Normal[GenerateSymbolicArray[a, {3, 3}, \"Symmetric\"]]\
\>", "Input",ExpressionUUID->"fe59d8eb-2e23-9640-a603-8d43ed5801c1"],

Cell[BoxData["True"], "Output",ExpressionUUID->"54c5dffe-db4b-e940-ad75-719b1c9ef886"],

Cell["\<\
What comes back is an ordinary array, and its domain is read off those \
entries:\
\>", "ExampleText",ExpressionUUID->"2fee6a19-c46a-0a4f-8860-8981b049e387"],

Cell["\<\
{Head @ GenerateSymbolicArray[a, {2}], ArrayDomain @ GenerateSymbolicArray[a, \
{2}]}\
\>", "Input",ExpressionUUID->"89ee6d82-4a9e-8e4d-a5ac-3c88a84098a5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"ArrayObject", ",", "\<\"Expression\"\>"}], "}"}]], "Output",Express\
ionUUID->"07e3bbd8-22d0-654e-a4cf-51f4dd947965"],

Cell["An irregular array cannot carry a symmetry:", "ExampleText",ExpressionUUID->"a35866be-77cb-b14f-a661-ec89122b8db6"],

Cell["Quiet @ GenerateSymbolicArray[a, {2, 3}, \"Symmetric\"]", "Input",ExpressionUUID->"f4f862b3-5a58-a644-b89e-b8738c97e960"],

Cell[BoxData["$Failed"], "Output",ExpressionUUID->"a6e229f2-8914-5b4a-b8d9-175d0d5c6101"],

Cell["With no indices the single entry is the name itself:", "ExampleText",ExpressionUUID->"093db429-2655-ec4d-8925-1e958f9a8023"],

Cell["Normal @ GenerateSymbolicArray[a, {}]", "Input",ExpressionUUID->"1f99af4d-c4a3-ba40-a148-c499a39b33a2"],

Cell[BoxData["a"], "Output",ExpressionUUID->"17ebfbcc-8ee2-e347-8a8c-3f661112d542"],

Cell["Source", "NotesSection",ExpressionUUID->"0fe3e93d-8537-f84e-b8c3-1521bad56e7b"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "GenerateSymbolicArray",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"0229af68-915a-b747-836f-17a26085deeb"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"2cf7f9b8-af57-2e4a-abb3-fd7779e0f2e8"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayObject", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "158853fc-6110-064f-8115-c355505ca33b"],
 ", ",
 Cell[BoxData[
  StyleBox["Hypermatrix", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "ff027500-589a-4149-93d9-cfa7e7da700b"],
 ", ",
 Cell[BoxData[
  StyleBox["ArraySymmetry", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "7538dc37-e256-b34f-9b2e-5fb604d94a06"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayEntries", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "533e7c43-d527-a14a-b553-1b60cf4d67fe"],
 ", ",
 Cell[BoxData[
  StyleBox["RegularArrayQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "1158b1c8-9b73-0a43-87e1-d06a431b2356"]
}], "SeeAlso",ExpressionUUID->"baf30a9b-1dfb-4349-82b3-46c725f9a4a0"]
},
