Notebook[{
Cell["GenerateSymbolicArray", "ObjectName",ExpressionUUID->"8d0e1443-a205-fb46-b729-3695f6f38fdc"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"GenerateSymbolicArray", "[", 
    RowBox[{"name", ",", " ", "dims"}], "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"c0f6beb4-d7ce-9d40-8b6b-f2e1bb9b6163"],
 " ",
 "represents an array of the given dimensions whose entries are the \
expressions name[i1, i2, ...] formed from name and the indices."
}], "Usage",ExpressionUUID->"1f2aff58-b105-704b-8e65-5ca62cc78bb5"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"GenerateSymbolicArray", "[", 
    RowBox[{"name", ",", " ", "dims", ",", " ", "sym"}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "771a954c-4895-8e43-ae82-cc7035abd4fc"],
 " ",
 "additionally declares the index symmetry sym."
}], "Usage",ExpressionUUID->"22714a6d-4ae4-3a46-8af0-085b53f62de2"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"b2ddb64f-0ad5-a14d-b7a7-3ff94cb5b846"],

Cell["\<\
The entries are not stored. They are generated on demand by ArrayEntries or \
Normal, so a symbolic array of any size costs nothing to hold.\
\>", "Notes",ExpressionUUID->"c1df8451-c1da-3e47-88f1-5e2487cbdbf2"],

Cell["\<\
The name must be a symbol or a string. The dimensions must be a list of \
positive integers. The empty list gives the array of order zero, whose single \
entry is the bare name.\
\>", "Notes",ExpressionUUID->"82e5717c-04ff-9a4c-a714-9a573da33783"],

Cell["\<\
The index symmetry sym is one of \"Rigid\" (the default), \"Cyclic\" or \
\"Symmetric\", and only a regular array can carry one other than \"Rigid\".\
\>", "Notes",ExpressionUUID->"d2d15dfd-b3fb-2641-88ee-4941e9bb3443"],

Cell["\<\
Under a symmetry, index tuples that are equivalent name the same entry: the \
entry at a given tuple is the name applied to the least tuple in its orbit. A \
symmetric or cyclic symbolic array is therefore symmetric or cyclic by \
construction, with no checking needed.\
\>", "Notes",ExpressionUUID->"e6b818b1-f54e-2c4b-bc22-31391d6cdbab"],

Cell[TextData[{
 "The generated entries answer to no numeric domain, so ",
 Cell[BoxData[
  StyleBox["ArrayDomain", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "78fbb810-3ce6-f04e-940f-3958e69c1e77"],
 " of such an array is ",
 Cell[BoxData[
  StyleBox["\"\<Expression\>\"", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"b672b7bc-b15e-3346-8d34-320adc31875c"],
 "."
}], "Notes",ExpressionUUID->"454eb3f7-262e-914a-b3a7-67e0600c8424"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"a6c0d344-6c87-f94a-b154-0d2833684877"],

Cell["The entries are the name applied to the indices:", "ExampleText",ExpressionUUID->"1cad0ca1-70e0-5a41-8dea-ac53a101a9ae"],

Cell["Normal @ GenerateSymbolicArray[a, {2, 3}]", "Input",ExpressionUUID->"c28939c0-c92e-2042-9842-50b41d7d1669"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "1"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "3"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "1"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "3"}], "]"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"9121eac0-0f93-8748-930b-fad0e1346414"],

Cell["Under a symmetry, equivalent index tuples name one entry:", \
"ExampleText",ExpressionUUID->"e01471b8-9062-b74f-911c-77d50093f751"],

Cell["Normal @ GenerateSymbolicArray[a, {3, 3}, \"Symmetric\"]", "Input",ExpressionUUID->"6a8a1ad1-ed89-8446-9b7c-5f1e5d8dd4d7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "1"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "3"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "3"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "3"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "3"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"3", ",", "3"}], "]"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"d9dba906-736c-1143-9519-1a1db95f4069"],

Cell["So the generated array really is symmetric:", "ExampleText",ExpressionUUID->"c35f3f0f-6773-904f-a2ed-6568dbf19820"],

Cell["\<\
With[{e = Normal @ GenerateSymbolicArray[a, {3, 3}, \"Symmetric\"]}, e === \
Transpose[e]]\
\>", "Input",ExpressionUUID->"7c610cfc-0390-4546-9105-28171fea597a"],

Cell[BoxData["True"], "Output",ExpressionUUID->"63da9ce1-1866-3b45-a321-e98667cd64d8"],

Cell["\<\
At order three the three symmetries give different numbers of distinct \
entries:\
\>", "ExampleText",ExpressionUUID->"0b9ef2ba-7725-614d-97c9-c9d8fa1ece83"],

Cell["\<\
Length @ DeleteDuplicates @ Flatten @ Normal @ GenerateSymbolicArray[a, {3, \
3, 3}, #] & /@
  {\"Rigid\", \"Cyclic\", \"Symmetric\"}\
\>", "Input",ExpressionUUID->"8d50bf82-1862-1b4d-a2f4-d675ee70e7fd"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"27", ",", "11", ",", "10"}], "}"}]], "Output",ExpressionUUID->\
"ba3a541a-d8a3-a646-965a-fe295fd8f46e"],

Cell["\<\
At order two the cyclic group is the symmetric group, so the two coincide:\
\>", "ExampleText",ExpressionUUID->"6c05eb9c-4271-f944-85df-2e676b75673a"],

Cell["\<\
Normal[GenerateSymbolicArray[a, {3, 3}, \"Cyclic\"]] === \
Normal[GenerateSymbolicArray[a, {3, 3}, \"Symmetric\"]]\
\>", "Input",ExpressionUUID->"be41eb2f-f9ba-a74c-8625-0cc3ba9b15ad"],

Cell[BoxData["True"], "Output",ExpressionUUID->"14b9e39c-db2a-3b43-89b3-19cbe115bf2b"],

Cell["\<\
What comes back is an ordinary array, and its domain is read off those \
entries:\
\>", "ExampleText",ExpressionUUID->"6649744d-b79d-a54c-a3d5-8d86a80f1f86"],

Cell["\<\
{Head @ GenerateSymbolicArray[a, {2}], ArrayDomain @ GenerateSymbolicArray[a, \
{2}]}\
\>", "Input",ExpressionUUID->"5c5ce697-ac8a-294d-86dd-85443f52cb9b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"ArrayObject", ",", "\<\"Expression\"\>"}], "}"}]], "Output",Express\
ionUUID->"f6b58adf-f9e7-c744-a0fb-1ac78d1d023d"],

Cell["An irregular array cannot carry a symmetry:", "ExampleText",ExpressionUUID->"38aec78d-6caf-9c43-a1ef-b5adabff5a97"],

Cell["Quiet @ GenerateSymbolicArray[a, {2, 3}, \"Symmetric\"]", "Input",ExpressionUUID->"72952496-0bee-b042-a97e-6331e094261c"],

Cell[BoxData["$Failed"], "Output",ExpressionUUID->"23e309f0-f05f-9846-89a9-6da9df41b57f"],

Cell["With no indices the single entry is the name itself:", "ExampleText",ExpressionUUID->"d45131f8-f50b-404a-b016-0e4397d68ff8"],

Cell["Normal @ GenerateSymbolicArray[a, {}]", "Input",ExpressionUUID->"e861da38-c2ed-8549-8e3d-f1f67ea7b4a6"],

Cell[BoxData["a"], "Output",ExpressionUUID->"94395172-3ded-c241-999c-7313d96be787"],

Cell["Source", "NotesSection",ExpressionUUID->"980cbd31-ca17-1843-a7bd-2ff01dae543d"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "GenerateSymbolicArray",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"7afcae4c-0491-4947-ad5b-84cd045401b0"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"35d702b6-51b6-e64e-b98e-df02664ca480"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayObject", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "a0ede76b-72fe-ad47-83c5-3b6241bcf31f"],
 ", ",
 Cell[BoxData[
  StyleBox["Hypermatrix", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "c9319a8f-1820-e44a-b552-eae2345375b6"],
 ", ",
 Cell[BoxData[
  StyleBox["ArraySymmetry", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "1f5c01b8-ae0b-c146-b27b-d47a8b8812fe"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayEntries", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "6a185346-fbd1-b54c-8aa5-f44e5d7c5a7a"],
 ", ",
 Cell[BoxData[
  StyleBox["RegularArrayQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "e063c3b8-16fe-4f44-b089-0728f4a84cb5"]
}], "SeeAlso",ExpressionUUID->"c94f902a-6d85-e64f-8aac-a549ecf5de12"]
},
