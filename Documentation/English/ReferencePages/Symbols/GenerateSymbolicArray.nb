Notebook[{
Cell["GenerateSymbolicArray", "ObjectName",ExpressionUUID->"36c0e087-d98f-e44d-b103-60c01278ae71"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"GenerateSymbolicArray", "[", 
    RowBox[{"name", ",", " ", "dims"}], "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"b232d603-b0e0-4040-8e59-d7b3911d6601"],
 " ",
 "represents an array of the given dimensions whose entries are the \
expressions name[i1, i2, ...] formed from name and the indices."
}], "Usage",ExpressionUUID->"6bd55ccc-d38b-c044-afc5-079be130a728"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"GenerateSymbolicArray", "[", 
    RowBox[{"name", ",", " ", "dims", ",", " ", "sym"}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "9d56f19d-37b2-0147-9aca-6487d09d9567"],
 " ",
 "additionally declares the index symmetry sym."
}], "Usage",ExpressionUUID->"9509dc18-dd10-3447-98c6-e5c159fe63fa"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"67992f8a-eb3e-4a4b-91c5-2ac8abea7364"],

Cell["\<\
The entries are not stored. They are generated on demand by ArrayEntries or \
Normal, so a symbolic array of any size costs nothing to hold.\
\>", "Notes",ExpressionUUID->"b50f1f68-98bb-1f46-87e4-3dfa12ff7cf0"],

Cell["\<\
The name must be a symbol or a string. The dimensions must be a list of \
positive integers. The empty list gives the array of order zero, whose single \
entry is the bare name.\
\>", "Notes",ExpressionUUID->"67c8240c-2c6b-4847-9904-37dffc6f1486"],

Cell["\<\
The index symmetry sym is one of \"Rigid\" (the default), \"Cyclic\" or \
\"Symmetric\", and only a regular array can carry one other than \"Rigid\".\
\>", "Notes",ExpressionUUID->"b7d5908d-be7e-a642-aab1-67b50ff991c8"],

Cell["\<\
Under a symmetry, index tuples that are equivalent name the same entry: the \
entry at a given tuple is the name applied to the least tuple in its orbit. A \
symmetric or cyclic symbolic array is therefore symmetric or cyclic by \
construction, with no checking needed.\
\>", "Notes",ExpressionUUID->"fd2c86a7-cb6d-924b-aa02-beb9c8cfa065"],

Cell[TextData[{
 "The generated entries answer to no numeric domain, so ",
 Cell[BoxData[
  StyleBox["ArrayDomain", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "cd31e924-33ef-4c4d-a605-e1e52039335f"],
 " of such an array is ",
 Cell[BoxData[
  StyleBox["\"\<Expression\>\"", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"3456f1a9-6d9c-e443-85f6-5bfc0804677a"],
 "."
}], "Notes",ExpressionUUID->"f2c4c150-ad73-5642-a8b6-170cec09ae3e"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"0b1a1246-2aae-8e4a-a8b0-b2c5429071c4"],

Cell["The entries are the name applied to the indices:", "ExampleText",ExpressionUUID->"90059ee0-e6dc-6642-82e9-3a90f2f547b7"],

Cell["Normal @ GenerateSymbolicArray[a, {2, 3}]", "Input",ExpressionUUID->"40f88b30-a96e-b045-bad1-704df05fc06a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "1"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "3"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "1"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "3"}], "]"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"ce72c0bf-8d4e-d54e-a5fe-8ec43be78799"],

Cell["Under a symmetry, equivalent index tuples name one entry:", \
"ExampleText",ExpressionUUID->"dc524c8b-aefb-1f42-a68e-9f72b7475a84"],

Cell["Normal @ GenerateSymbolicArray[a, {3, 3}, \"Symmetric\"]", "Input",ExpressionUUID->"e19690f7-36db-3148-a32a-449f83e5d778"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "1"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "3"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "3"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "3"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "3"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"3", ",", "3"}], "]"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"cd9bfa0b-ad0e-154c-9116-75d4a576716a"],

Cell["So the generated array really is symmetric:", "ExampleText",ExpressionUUID->"d344ab5c-7257-3b48-a460-420bf083ae17"],

Cell["\<\
With[{e = Normal @ GenerateSymbolicArray[a, {3, 3}, \"Symmetric\"]}, e === \
Transpose[e]]\
\>", "Input",ExpressionUUID->"716b3d35-9f94-434d-abe9-22f2601ce869"],

Cell[BoxData["True"], "Output",ExpressionUUID->"9bb48e7c-0ae5-284d-9cbf-6759e422bd8a"],

Cell["\<\
At order three the three symmetries give different numbers of distinct \
entries:\
\>", "ExampleText",ExpressionUUID->"84ca5981-b553-1e40-b20c-3175cdc73543"],

Cell["\<\
Length @ DeleteDuplicates @ Flatten @ Normal @ GenerateSymbolicArray[a, {3, \
3, 3}, #] & /@
  {\"Rigid\", \"Cyclic\", \"Symmetric\"}\
\>", "Input",ExpressionUUID->"405984e3-bbaf-c04d-9ffb-bb188358b8ca"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"27", ",", "11", ",", "10"}], "}"}]], "Output",ExpressionUUID->\
"68415735-6a17-354e-8c51-b40cf2754ca1"],

Cell["\<\
At order two the cyclic group is the symmetric group, so the two coincide:\
\>", "ExampleText",ExpressionUUID->"cc259561-da4b-534a-b8df-01b6e68e870f"],

Cell["\<\
Normal[GenerateSymbolicArray[a, {3, 3}, \"Cyclic\"]] === \
Normal[GenerateSymbolicArray[a, {3, 3}, \"Symmetric\"]]\
\>", "Input",ExpressionUUID->"111f44e3-67cb-e747-a424-687396591b4c"],

Cell[BoxData["True"], "Output",ExpressionUUID->"c69d7d69-18ec-8d43-a909-e45d38491c05"],

Cell["\<\
What comes back is an ordinary array, and its domain is read off those \
entries:\
\>", "ExampleText",ExpressionUUID->"ad534967-2387-c149-8406-a5e8605c1a23"],

Cell["\<\
{Head @ GenerateSymbolicArray[a, {2}], ArrayDomain @ GenerateSymbolicArray[a, \
{2}]}\
\>", "Input",ExpressionUUID->"c53da1db-9340-b14f-acc9-9d5d50508209"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"ArrayObject", ",", "\<\"Expression\"\>"}], "}"}]], "Output",Express\
ionUUID->"3cbc408b-2203-d242-b327-d300dcc6b77f"],

Cell["An irregular array cannot carry a symmetry:", "ExampleText",ExpressionUUID->"dc756946-5868-4542-8cd6-7d8b04075256"],

Cell["Quiet @ GenerateSymbolicArray[a, {2, 3}, \"Symmetric\"]", "Input",ExpressionUUID->"52755513-3eb5-1842-8c75-7ce8b3c1161f"],

Cell[BoxData["$Failed"], "Output",ExpressionUUID->"f0961ef7-c862-7440-812d-3a283d77fdbb"],

Cell["With no indices the single entry is the name itself:", "ExampleText",ExpressionUUID->"1869007c-310d-9844-a3a8-b13b8b7760b3"],

Cell["Normal @ GenerateSymbolicArray[a, {}]", "Input",ExpressionUUID->"95fa51b8-0cff-1347-8e35-15a72cc4c1e2"],

Cell[BoxData["a"], "Output",ExpressionUUID->"29e374d3-11d8-6543-8f07-7248479b0514"],

Cell["Source", "NotesSection",ExpressionUUID->"905c807d-7c09-ab4e-8f08-47bba9d48573"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "GenerateSymbolicArray",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"bce795ca-f372-504c-b1c2-c4abdd6fdf88"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"de9fd802-ec58-5847-9da2-799c776b640f"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayObject", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "6df5579c-8a6d-f643-ad6a-e63404f32496"],
 ", ",
 Cell[BoxData[
  StyleBox["Hypermatrix", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "db7d2164-e8f4-784d-ab29-39422cf846de"],
 ", ",
 Cell[BoxData[
  StyleBox["ArraySymmetry", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "7a0b085d-b5c2-b948-a9eb-1ca7d85f7b9f"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayEntries", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "cd4eb825-05e6-8d42-8dff-8f8c3c9c3f4a"],
 ", ",
 Cell[BoxData[
  StyleBox["RegularArrayQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "384402c9-d9ea-e84c-bd7d-0d2cbd9675aa"]
}], "SeeAlso",ExpressionUUID->"e377fbcf-61ce-7041-9a19-e3c7542eeeb4"]
},
