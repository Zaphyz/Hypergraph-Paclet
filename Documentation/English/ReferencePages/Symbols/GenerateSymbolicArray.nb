Notebook[{
Cell["GenerateSymbolicArray", "ObjectName",ExpressionUUID->"19c2dd2a-c27e-a64b-8bad-48d6087dc8ac"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"GenerateSymbolicArray", "[", 
    RowBox[{"name", ",", " ", "dims"}], "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"cb7285d4-bb30-b946-885e-1dbe72436c9c"],
 " ",
 "represents an array of the given dimensions whose entries are the \
expressions name[i1, i2, ...] formed from name and the indices."
}], "Usage",ExpressionUUID->"e4d74ecf-5239-6640-9fab-7d11f5461e40"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"GenerateSymbolicArray", "[", 
    RowBox[{"name", ",", " ", "dims", ",", " ", "sym"}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "4b7cca30-6dde-e149-a89e-3f2b5f7cfa93"],
 " ",
 "additionally declares the index symmetry sym."
}], "Usage",ExpressionUUID->"222b2492-c879-8941-bd9f-12302052ae7c"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"382ab6a5-bd9f-7f4a-8b35-38e257629e20"],

Cell["\<\
The entries are not stored. They are generated on demand by ArrayEntries or \
Normal, so a symbolic array of any size costs nothing to hold.\
\>", "Notes",ExpressionUUID->"a7681e5e-3a5f-224c-8c44-53a4f219a66b"],

Cell["\<\
The name must be a symbol or a string. The dimensions must be a list of \
positive integers. The empty list gives the array of order zero, whose single \
entry is the bare name.\
\>", "Notes",ExpressionUUID->"54821047-facc-ba4a-9dce-d17bcf72e5e3"],

Cell["\<\
The index symmetry sym is one of \"Rigid\" (the default), \"Cyclic\" or \
\"Symmetric\", and only a regular array can carry one other than \"Rigid\".\
\>", "Notes",ExpressionUUID->"5646c097-ac7d-0c41-b270-ece2c429a63b"],

Cell["\<\
Under a symmetry, index tuples that are equivalent name the same entry: the \
entry at a given tuple is the name applied to the least tuple in its orbit. A \
symmetric or cyclic symbolic array is therefore symmetric or cyclic by \
construction, with no checking needed.\
\>", "Notes",ExpressionUUID->"2df48e0f-f1d6-bb4c-91bc-85be0e31797d"],

Cell[TextData[{
 "The generated entries answer to no numeric domain, so ",
 Cell[BoxData[
  StyleBox["ArrayDomain", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "ded93bcb-46cd-e14b-913e-8d5b71642469"],
 " of such an array is ",
 Cell[BoxData[
  StyleBox["\"\<Expression\>\"", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"c27654ce-7fe1-ba4e-b4ed-65c1e58777e9"],
 "."
}], "Notes",ExpressionUUID->"3363cb11-03f5-1846-8095-c258ec229a30"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"f59b98ab-bbb1-664f-b0c2-da73fb6f43c7"],

Cell["The entries are the name applied to the indices:", "ExampleText",ExpressionUUID->"c503fba9-88f1-9748-8057-547e31398588"],

Cell["Normal @ GenerateSymbolicArray[a, {2, 3}]", "Input",ExpressionUUID->"56a06475-ad76-4944-a3b5-40deb7b1a183"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "1"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "3"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "1"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "3"}], "]"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"3608fa30-24fc-964d-b668-030bcb3ac96f"],

Cell["Under a symmetry, equivalent index tuples name one entry:", \
"ExampleText",ExpressionUUID->"8add39e6-68ab-044e-a73b-d038b285b140"],

Cell["Normal @ GenerateSymbolicArray[a, {3, 3}, \"Symmetric\"]", "Input",ExpressionUUID->"789c9aa5-5cf6-7048-b5b5-62ae7c8a5bcd"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "1"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "3"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "3"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "3"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "3"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"3", ",", "3"}], "]"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"35311aae-2131-7648-a3d4-09abd1e6cc6f"],

Cell["So the generated array really is symmetric:", "ExampleText",ExpressionUUID->"58a22f7f-54a5-7240-9e0c-de3ea7ef4bec"],

Cell["\<\
With[{e = Normal @ GenerateSymbolicArray[a, {3, 3}, \"Symmetric\"]}, e === \
Transpose[e]]\
\>", "Input",ExpressionUUID->"c97ad70a-9035-2d4b-af83-dfb0c08640d2"],

Cell[BoxData["True"], "Output",ExpressionUUID->"5753e64f-d933-d94e-a956-a415dd27fedb"],

Cell["\<\
At order three the three symmetries give different numbers of distinct \
entries:\
\>", "ExampleText",ExpressionUUID->"4f7fbf35-12fe-9a45-84cc-f3ee3630c302"],

Cell["\<\
Length @ DeleteDuplicates @ Flatten @ Normal @ GenerateSymbolicArray[a, {3, \
3, 3}, #] & /@
  {\"Rigid\", \"Cyclic\", \"Symmetric\"}\
\>", "Input",ExpressionUUID->"fc52a5c7-6762-7b47-be4c-4f51fb193d2c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"27", ",", "11", ",", "10"}], "}"}]], "Output",ExpressionUUID->\
"c5d682c2-68eb-4241-a894-fa3d321b8176"],

Cell["\<\
At order two the cyclic group is the symmetric group, so the two coincide:\
\>", "ExampleText",ExpressionUUID->"fbc7c7e5-12c2-5744-a02e-63daf925df93"],

Cell["\<\
Normal[GenerateSymbolicArray[a, {3, 3}, \"Cyclic\"]] === \
Normal[GenerateSymbolicArray[a, {3, 3}, \"Symmetric\"]]\
\>", "Input",ExpressionUUID->"525c0d7a-233a-4947-ac33-b2d8d7d9f434"],

Cell[BoxData["True"], "Output",ExpressionUUID->"e56ef383-3aa8-b346-a2fc-3bd26e58dc8a"],

Cell["\<\
What comes back is an ordinary array, and its domain is read off those \
entries:\
\>", "ExampleText",ExpressionUUID->"43997181-c6f3-3b40-8079-27c01ef31e5c"],

Cell["\<\
{Head @ GenerateSymbolicArray[a, {2}], ArrayDomain @ GenerateSymbolicArray[a, \
{2}]}\
\>", "Input",ExpressionUUID->"a3322d9c-7ae5-8f48-a6af-d7915b68ac82"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"ArrayObject", ",", "\<\"Expression\"\>"}], "}"}]], "Output",Express\
ionUUID->"b39aab25-f04c-8a4c-b709-56f3165c9c33"],

Cell["An irregular array cannot carry a symmetry:", "ExampleText",ExpressionUUID->"e4dbdc9a-1a0e-3242-abae-29b1ec4899a1"],

Cell["Quiet @ GenerateSymbolicArray[a, {2, 3}, \"Symmetric\"]", "Input",ExpressionUUID->"61a9c8da-7756-a64b-a3b9-f13692b7bb55"],

Cell[BoxData["$Failed"], "Output",ExpressionUUID->"29d19b37-17f6-2748-949b-54f500ddc1da"],

Cell["With no indices the single entry is the name itself:", "ExampleText",ExpressionUUID->"059f6d5f-0bec-9c4c-b9bd-fe19ede64316"],

Cell["Normal @ GenerateSymbolicArray[a, {}]", "Input",ExpressionUUID->"88f245fe-45f7-284b-a976-3442097ae9a7"],

Cell[BoxData["a"], "Output",ExpressionUUID->"61e3ea00-b5ff-f74f-983f-0bd3254f3068"],

Cell["Source", "NotesSection",ExpressionUUID->"b4c35a7f-d834-064d-97ac-0896dd108738"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "GenerateSymbolicArray",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"6f36bcb9-cd08-1143-a355-9e10f77bac1e"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"a8292352-93e6-5447-a8b6-0ce6133cfc79"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayObject", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "60a6b82b-8b93-884b-a82a-ae3ac0dc43a1"],
 ", ",
 Cell[BoxData[
  StyleBox["Hypermatrix", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "de0fcb6a-94ab-984f-b0f9-15d2522151b7"],
 ", ",
 Cell[BoxData[
  StyleBox["ArraySymmetry", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "674c8c6a-0795-6343-8069-95e3f24ec2d0"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayEntries", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "6d4f22d4-af8c-754d-93c5-3882a22bfd05"],
 ", ",
 Cell[BoxData[
  StyleBox["RegularArrayQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "9fa6556e-2f49-424a-8176-21c6b49bd646"]
}], "SeeAlso",ExpressionUUID->"3c2e1bbc-11e8-194f-8d3c-e9710a710f15"]
},
