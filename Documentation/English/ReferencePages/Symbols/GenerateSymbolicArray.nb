Notebook[{
Cell["GenerateSymbolicArray", "ObjectName",ExpressionUUID->"e0d556a4-169c-8c49-b4db-fb9af8b3be0f"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"GenerateSymbolicArray", "[", 
    RowBox[{"name", ",", " ", "dims"}], "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"f02169fd-35a9-5e44-a236-e44060e96d7d"],
 " ",
 "represents an array of the given dimensions whose entries are the \
expressions name[i1, i2, ...] formed from name and the indices."
}], "Usage",ExpressionUUID->"078380db-72d1-ec47-b168-390cba673af3"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"GenerateSymbolicArray", "[", 
    RowBox[{"name", ",", " ", "dims", ",", " ", "sym"}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "556418a2-9e70-204d-aebe-e1102fd27dc0"],
 " ",
 "additionally declares the index symmetry sym."
}], "Usage",ExpressionUUID->"bf83b591-a1f4-b240-b01f-f70bf73d0ec7"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"d102f3ae-6ca9-a243-a0bf-6dcaf8d1c150"],

Cell["\<\
The entries are not stored. They are generated on demand by ArrayEntries or \
Normal, so a symbolic array of any size costs nothing to hold.\
\>", "Notes",ExpressionUUID->"d646c533-0f46-7f4c-9d8a-1cc42390f143"],

Cell["\<\
The name must be a symbol or a string. The dimensions must be a list of \
positive integers. The empty list gives the array of order zero, whose single \
entry is the bare name.\
\>", "Notes",ExpressionUUID->"a86180ff-406d-a346-8f8f-c2511c0ef601"],

Cell["\<\
The index symmetry sym is one of \"Rigid\" (the default), \"Cyclic\" or \
\"Symmetric\", and only a regular array can carry one other than \"Rigid\".\
\>", "Notes",ExpressionUUID->"81a853bb-7f7b-104c-92fd-bcf78e438e1a"],

Cell["\<\
Under a symmetry, index tuples that are equivalent name the same entry: the \
entry at a given tuple is the name applied to the least tuple in its orbit. A \
symmetric or cyclic symbolic array is therefore symmetric or cyclic by \
construction, with no checking needed.\
\>", "Notes",ExpressionUUID->"25de5af2-8973-b94f-9dbf-7e3870f75a08"],

Cell[TextData[{
 "The generated entries answer to no numeric domain, so ",
 Cell[BoxData[
  StyleBox["ArrayDomain", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "451524fb-6a2e-2245-b1d5-d83339f4ec84"],
 " of such an array is ",
 Cell[BoxData[
  StyleBox["\"\<Expression\>\"", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"667c0bdb-4424-5648-8f99-a920a0823bbc"],
 "."
}], "Notes",ExpressionUUID->"8211f12d-09be-cd42-96cb-05b62fd58114"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"fb96e00c-67b9-ae4a-8e00-3cb7bcd72c06"],

Cell["The entries are the name applied to the indices:", "ExampleText",ExpressionUUID->"22109ebe-4c6a-0241-bfa7-2757588c8351"],

Cell["Normal @ GenerateSymbolicArray[a, {2, 3}]", "Input",ExpressionUUID->"5c69955e-afb1-0a4b-9b73-f3fa1b63cd49"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "1"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "3"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "1"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "3"}], "]"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"44cc8cfd-08e1-2a42-a159-27237a7a299b"],

Cell["Under a symmetry, equivalent index tuples name one entry:", \
"ExampleText",ExpressionUUID->"b9145c9f-f0ba-c04c-8327-0a11882792c6"],

Cell["Normal @ GenerateSymbolicArray[a, {3, 3}, \"Symmetric\"]", "Input",ExpressionUUID->"8dab8b08-c7e5-2b45-aff5-238a25867184"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "1"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "3"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "3"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "3"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "3"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"3", ",", "3"}], "]"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"68e35a68-3699-a14e-a0bf-69e7ec926c37"],

Cell["So the generated array really is symmetric:", "ExampleText",ExpressionUUID->"4b37455e-64e9-074e-9885-ba337fac78d3"],

Cell["\<\
With[{e = Normal @ GenerateSymbolicArray[a, {3, 3}, \"Symmetric\"]}, e === \
Transpose[e]]\
\>", "Input",ExpressionUUID->"c37e417a-2d50-a645-9ead-ff8be274990c"],

Cell[BoxData["True"], "Output",ExpressionUUID->"5c976d87-4d43-3141-9c55-3f093df3f8ae"],

Cell["\<\
At order three the three symmetries give different numbers of distinct \
entries:\
\>", "ExampleText",ExpressionUUID->"5c6dad4a-0893-fa4c-87ac-261288ac764a"],

Cell["\<\
Length @ DeleteDuplicates @ Flatten @ Normal @ GenerateSymbolicArray[a, {3, \
3, 3}, #] & /@
  {\"Rigid\", \"Cyclic\", \"Symmetric\"}\
\>", "Input",ExpressionUUID->"93db1318-33d2-fb4a-a510-c7c14fb3d826"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"27", ",", "11", ",", "10"}], "}"}]], "Output",ExpressionUUID->\
"9e84ba25-43d3-414b-a7f3-60568bb4d543"],

Cell["\<\
At order two the cyclic group is the symmetric group, so the two coincide:\
\>", "ExampleText",ExpressionUUID->"56ea2375-9eba-ad49-a04a-6e701711dbc7"],

Cell["\<\
Normal[GenerateSymbolicArray[a, {3, 3}, \"Cyclic\"]] === \
Normal[GenerateSymbolicArray[a, {3, 3}, \"Symmetric\"]]\
\>", "Input",ExpressionUUID->"6c24fee6-79dc-204a-a9d8-cfe1f2bbdb8e"],

Cell[BoxData["True"], "Output",ExpressionUUID->"81f3b893-7dff-7f41-a2fd-3349624661aa"],

Cell["\<\
What comes back is an ordinary array, and its domain is read off those \
entries:\
\>", "ExampleText",ExpressionUUID->"ca713b1f-9111-cf4e-ba9a-77372cd9f7a4"],

Cell["\<\
{Head @ GenerateSymbolicArray[a, {2}], ArrayDomain @ GenerateSymbolicArray[a, \
{2}]}\
\>", "Input",ExpressionUUID->"4525b07a-84f2-e344-9918-23842e36a41f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"ArrayObject", ",", "\<\"Expression\"\>"}], "}"}]], "Output",Express\
ionUUID->"59b840b4-5db9-1443-8324-dcd384bef5ec"],

Cell["An irregular array cannot carry a symmetry:", "ExampleText",ExpressionUUID->"d87d6878-ce25-b747-b843-b7ee5248a99e"],

Cell["Quiet @ GenerateSymbolicArray[a, {2, 3}, \"Symmetric\"]", "Input",ExpressionUUID->"1edb933a-213d-3c47-bb8d-1377838f7d14"],

Cell[BoxData["$Failed"], "Output",ExpressionUUID->"735cff0b-4be7-c148-9d9c-11ebe9e6621c"],

Cell["With no indices the single entry is the name itself:", "ExampleText",ExpressionUUID->"e64cfab7-b99c-6d42-9f25-cc13e42b9213"],

Cell["Normal @ GenerateSymbolicArray[a, {}]", "Input",ExpressionUUID->"fecd92fd-7f53-244c-be10-3ee7b98cd8e5"],

Cell[BoxData["a"], "Output",ExpressionUUID->"b99bc8a9-2ec2-2b4d-a6d9-d3f9ab8cdfe3"],

Cell["Source", "NotesSection",ExpressionUUID->"d4177a1a-8c06-8947-95ab-ece31a341593"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "GenerateSymbolicArray",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"ad7c6f37-a834-5d4c-a18d-e39e0a5613ac"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"ee86a59d-ef2a-b349-a351-87ca29b9197d"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayObject", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "393553f6-612e-8f4d-aa2d-04ba27783b0a"],
 ", ",
 Cell[BoxData[
  StyleBox["Hypermatrix", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "12e9ea7e-c953-1e45-82b1-d7c696d52231"],
 ", ",
 Cell[BoxData[
  StyleBox["ArraySymmetry", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "c43c9d14-bd26-e246-bcf0-289f62df6d0a"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayEntries", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "216d149e-f105-2844-aa3a-ee5623ee0f41"],
 ", ",
 Cell[BoxData[
  StyleBox["RegularArrayQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "f17ca1e3-03a9-844e-b1bc-b1541f86db29"]
}], "SeeAlso",ExpressionUUID->"6a5cbee5-bf6c-794e-9037-02f8d9f4d3c6"]
},
