Notebook[{
Cell["GenerateSymbolicArray", "ObjectName",ExpressionUUID->"ae366cf1-3db4-8943-8931-6cd82256f972"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"GenerateSymbolicArray", "[", 
    RowBox[{"name", ",", " ", "dims"}], "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"aecf58b8-0d02-5542-aa78-6bb72c2d80b6"],
 " ",
 "represents an array of the given dimensions whose entries are the \
expressions name[i1, i2, ...] formed from name and the indices."
}], "Usage",ExpressionUUID->"16fdcf48-c416-a646-8c18-769a5a78eba3"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"GenerateSymbolicArray", "[", 
    RowBox[{"name", ",", " ", "dims", ",", " ", "sym"}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "55ab6c6a-dc7a-5d43-bf7a-50c11c13d1a4"],
 " ",
 "additionally declares the index symmetry sym."
}], "Usage",ExpressionUUID->"d5c773fb-ede5-ed42-ad07-a810203a71f0"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"cbe71c46-0776-9649-92e1-d1d477918fa9"],

Cell["\<\
The entries are not stored. They are generated on demand by ArrayEntries or \
Normal, so a symbolic array of any size costs nothing to hold.\
\>", "Notes",ExpressionUUID->"031d6c9c-25bc-8548-9be0-48bcff305c54"],

Cell["\<\
The name must be a symbol or a string. The dimensions must be a list of \
positive integers. The empty list gives the array of order zero, whose single \
entry is the bare name.\
\>", "Notes",ExpressionUUID->"b70c4e3d-65fa-f04a-8760-84b532296119"],

Cell["\<\
The index symmetry sym is one of \"Rigid\" (the default), \"Cyclic\" or \
\"Symmetric\", and only a regular array can carry one other than \"Rigid\".\
\>", "Notes",ExpressionUUID->"29497cff-d77b-eb41-800e-318a039663b6"],

Cell["\<\
Under a symmetry, index tuples that are equivalent name the same entry: the \
entry at a given tuple is the name applied to the least tuple in its orbit. A \
symmetric or cyclic symbolic array is therefore symmetric or cyclic by \
construction, with no checking needed.\
\>", "Notes",ExpressionUUID->"51d87f77-79db-3747-86bf-b8a5e575aad7"],

Cell[TextData[{
 "The generated entries answer to no numeric domain, so ",
 Cell[BoxData[
  StyleBox["ArrayDomain", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "2c1e00ae-ef07-f94d-8bd1-fb4b29759cc7"],
 " of such an array is ",
 Cell[BoxData[
  StyleBox["\"\<Expression\>\"", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"5735d589-1e39-c642-8b01-cc161b8d9fe8"],
 "."
}], "Notes",ExpressionUUID->"9e0b5240-dbf4-f543-8040-a6e06fc95fc8"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"702c6791-04aa-9040-b84c-40143a3405f8"],

Cell["The entries are the name applied to the indices:", "ExampleText",ExpressionUUID->"1e2853ef-8e44-004e-a827-df8574ff6e89"],

Cell["Normal @ GenerateSymbolicArray[a, {2, 3}]", "Input",ExpressionUUID->"d29ded0e-c407-ec4f-8261-ca5de7cc53cc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "1"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "3"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "1"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "3"}], "]"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"20cdb62d-c808-7849-9a0d-0667185d48cf"],

Cell["Under a symmetry, equivalent index tuples name one entry:", \
"ExampleText",ExpressionUUID->"01f7572f-7d06-ba4b-8ec6-7b771fc0dd91"],

Cell["Normal @ GenerateSymbolicArray[a, {3, 3}, \"Symmetric\"]", "Input",ExpressionUUID->"be28d663-6933-5c45-b2ee-32fc150a0fb4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "1"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "3"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "3"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "3"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "3"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"3", ",", "3"}], "]"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"a409a96b-e1f6-1c4c-aa59-4233f0927e86"],

Cell["So the generated array really is symmetric:", "ExampleText",ExpressionUUID->"8fc521bb-6b0c-d34f-8c81-01df3026e0f3"],

Cell["\<\
With[{e = Normal @ GenerateSymbolicArray[a, {3, 3}, \"Symmetric\"]}, e === \
Transpose[e]]\
\>", "Input",ExpressionUUID->"f6484b4a-6b54-2c4f-a42e-c76dc6f262b9"],

Cell[BoxData["True"], "Output",ExpressionUUID->"efde3e8d-190c-c941-83b5-fee0cd61997c"],

Cell["\<\
At order three the three symmetries give different numbers of distinct \
entries:\
\>", "ExampleText",ExpressionUUID->"c1b90a32-ee7b-2440-b5bd-edebfb7d5e5a"],

Cell["\<\
Length @ DeleteDuplicates @ Flatten @ Normal @ GenerateSymbolicArray[a, {3, \
3, 3}, #] & /@
  {\"Rigid\", \"Cyclic\", \"Symmetric\"}\
\>", "Input",ExpressionUUID->"7fa6896a-5a9c-b845-b813-da8bdca63c44"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"27", ",", "11", ",", "10"}], "}"}]], "Output",ExpressionUUID->\
"b7240660-4749-d54b-9c00-bca0f20ae229"],

Cell["\<\
At order two the cyclic group is the symmetric group, so the two coincide:\
\>", "ExampleText",ExpressionUUID->"0fdfed4e-c13d-f245-9621-4f653afec3a9"],

Cell["\<\
Normal[GenerateSymbolicArray[a, {3, 3}, \"Cyclic\"]] === \
Normal[GenerateSymbolicArray[a, {3, 3}, \"Symmetric\"]]\
\>", "Input",ExpressionUUID->"c3ac8dac-ef39-4640-840d-4519ca194d0e"],

Cell[BoxData["True"], "Output",ExpressionUUID->"46985ce9-92ed-3f46-8376-5182737e8f25"],

Cell["\<\
What comes back is an ordinary array, and its domain is read off those \
entries:\
\>", "ExampleText",ExpressionUUID->"2c2e538a-1861-f840-af8b-87cf5d4170c5"],

Cell["\<\
{Head @ GenerateSymbolicArray[a, {2}], ArrayDomain @ GenerateSymbolicArray[a, \
{2}]}\
\>", "Input",ExpressionUUID->"bdd1c981-cefd-744a-b8c4-d8ef957e1b26"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"ArrayObject", ",", "\<\"Expression\"\>"}], "}"}]], "Output",Express\
ionUUID->"63bb4978-04a6-3e40-b676-ad75a236b558"],

Cell["An irregular array cannot carry a symmetry:", "ExampleText",ExpressionUUID->"ba9d97be-53ff-be4d-8c82-aa5b97a805a8"],

Cell["Quiet @ GenerateSymbolicArray[a, {2, 3}, \"Symmetric\"]", "Input",ExpressionUUID->"359c14c0-387b-d348-aa52-48d6e212298b"],

Cell[BoxData["$Failed"], "Output",ExpressionUUID->"ddf46e42-c19d-c749-949d-308d60df0142"],

Cell["With no indices the single entry is the name itself:", "ExampleText",ExpressionUUID->"37052a39-aaea-174c-a314-ffb2adc33542"],

Cell["Normal @ GenerateSymbolicArray[a, {}]", "Input",ExpressionUUID->"ce22c788-5d8c-3943-be1a-b3cd6db44f97"],

Cell[BoxData["a"], "Output",ExpressionUUID->"b9328499-026b-cd47-95da-cd584ed56afe"],

Cell["Source", "NotesSection",ExpressionUUID->"5fd00e75-60ff-f648-b205-463cfc2075c9"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "GenerateSymbolicArray",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"275e7a59-c37f-b848-ae17-e8110d6bbbe1"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"78051948-9fcf-4d40-845d-779f0a48bfe5"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayObject", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "09cef029-0900-a046-b324-2d425592025d"],
 ", ",
 Cell[BoxData[
  StyleBox["Hypermatrix", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "dfa2f697-49ff-1f44-9e0d-79196631a012"],
 ", ",
 Cell[BoxData[
  StyleBox["ArraySymmetry", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "af83d2bb-e102-d84b-86ae-e27ab6e61a47"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayEntries", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "3f4e4a8d-289a-ab40-9b2e-fc859a10b188"],
 ", ",
 Cell[BoxData[
  StyleBox["RegularArrayQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "b44b514f-2fe6-834d-be78-ce74f940318b"]
}], "SeeAlso",ExpressionUUID->"96c04460-c273-8544-ab7e-4cdc6f1ef640"]
},
