Notebook[{
Cell["GenerateSymbolicArray", "ObjectName",ExpressionUUID->"a5c73616-25c5-7042-be4e-8849dfad6b19"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"GenerateSymbolicArray", "[", 
    RowBox[{"name", ",", " ", "dims"}], "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"4feaf37b-7a76-bd47-82ae-37a261d4142f"],
 " ",
 "represents an array of the given dimensions whose entries are the \
expressions name[i1, i2, ...] formed from name and the indices."
}], "Usage",ExpressionUUID->"c0088862-b27b-784f-bcfe-3551d499f984"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"GenerateSymbolicArray", "[", 
    RowBox[{"name", ",", " ", "dims", ",", " ", "sym"}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "7c57d5c7-cb0b-c942-aa51-451528dd553e"],
 " ",
 "additionally declares the index symmetry sym."
}], "Usage",ExpressionUUID->"e9e79f33-2b57-714e-a4af-4eeb8090f7b6"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"9cd6b0b7-7694-0540-97e5-150cceae2e30"],

Cell["\<\
The entries are not stored. They are generated on demand by ArrayEntries or \
Normal, so a symbolic array of any size costs nothing to hold.\
\>", "Notes",ExpressionUUID->"a2677cbb-6e72-5e47-be28-47a0056888bf"],

Cell["\<\
The name must be a symbol or a string. The dimensions must be a list of \
positive integers. The empty list gives the array of order zero, whose single \
entry is the bare name.\
\>", "Notes",ExpressionUUID->"7e711a51-e7fc-174d-b936-c6edbf5dd67d"],

Cell["\<\
The index symmetry sym is one of \"Rigid\" (the default), \"Cyclic\" or \
\"Symmetric\", and only a regular array can carry one other than \"Rigid\".\
\>", "Notes",ExpressionUUID->"69975bce-b6b5-2e44-9b6e-e55086cb86f3"],

Cell["\<\
Under a symmetry, index tuples that are equivalent name the same entry: the \
entry at a given tuple is the name applied to the least tuple in its orbit. A \
symmetric or cyclic symbolic array is therefore symmetric or cyclic by \
construction, with no checking needed.\
\>", "Notes",ExpressionUUID->"17700a88-64c8-e343-9cfa-f8fc7f7b7ce2"],

Cell[TextData[{
 "The generated entries answer to no numeric domain, so ",
 Cell[BoxData[
  StyleBox["ArrayDomain", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "58ab720c-71dc-f443-809b-3035c37f1235"],
 " of such an array is ",
 Cell[BoxData[
  StyleBox["\"\<Expression\>\"", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"bd9ed708-f2b7-a24a-b247-eb8f016594b3"],
 "."
}], "Notes",ExpressionUUID->"1a0b5022-e7d9-ac49-8c06-dc53e43579e8"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"8562c324-ff32-0b4f-bb7a-f943153353e8"],

Cell["The entries are the name applied to the indices:", "ExampleText",ExpressionUUID->"ea97c47e-90a2-b94e-8a6f-4c7f5de785f5"],

Cell["Normal @ GenerateSymbolicArray[a, {2, 3}]", "Input",ExpressionUUID->"dbc21a4e-9737-9344-9394-c844807bf0d4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "1"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "3"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "1"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "3"}], "]"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"6dd9a4cc-7515-c344-8f0e-d43ad723d20d"],

Cell["Under a symmetry, equivalent index tuples name one entry:", \
"ExampleText",ExpressionUUID->"fe87b2ae-7248-574e-ad31-b97cfad17bbf"],

Cell["Normal @ GenerateSymbolicArray[a, {3, 3}, \"Symmetric\"]", "Input",ExpressionUUID->"af6b1af1-cfea-334c-ad6c-c0d6513cda3d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "1"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "3"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "3"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "3"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "3"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"3", ",", "3"}], "]"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"cd0866e2-0a23-8440-84a0-6b9a8899f9ea"],

Cell["So the generated array really is symmetric:", "ExampleText",ExpressionUUID->"c6835999-4bc7-e44f-8d4b-fc8341e941e7"],

Cell["\<\
With[{e = Normal @ GenerateSymbolicArray[a, {3, 3}, \"Symmetric\"]}, e === \
Transpose[e]]\
\>", "Input",ExpressionUUID->"93524dd0-347a-2b4f-bf79-1ae1a4e4e425"],

Cell[BoxData["True"], "Output",ExpressionUUID->"ceea8660-e527-904e-b4ea-2127902542c6"],

Cell["\<\
At order three the three symmetries give different numbers of distinct \
entries:\
\>", "ExampleText",ExpressionUUID->"7f04727c-71a0-4d44-88a5-321f88fbdcdc"],

Cell["\<\
Length @ DeleteDuplicates @ Flatten @ Normal @ GenerateSymbolicArray[a, {3, \
3, 3}, #] & /@
  {\"Rigid\", \"Cyclic\", \"Symmetric\"}\
\>", "Input",ExpressionUUID->"d466c088-773b-b940-a1bf-0da216936aa1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"27", ",", "11", ",", "10"}], "}"}]], "Output",ExpressionUUID->\
"475e54bb-885c-174d-a582-d8b52eaa115e"],

Cell["\<\
At order two the cyclic group is the symmetric group, so the two coincide:\
\>", "ExampleText",ExpressionUUID->"f6bc4030-59af-254e-82dc-836cdbb27be4"],

Cell["\<\
Normal[GenerateSymbolicArray[a, {3, 3}, \"Cyclic\"]] === \
Normal[GenerateSymbolicArray[a, {3, 3}, \"Symmetric\"]]\
\>", "Input",ExpressionUUID->"133cf49d-c112-8e49-baf7-569a1c4c4b2d"],

Cell[BoxData["True"], "Output",ExpressionUUID->"bbd4887e-873b-f246-ad64-6a287f574276"],

Cell["\<\
What comes back is an ordinary array, and its domain is read off those \
entries:\
\>", "ExampleText",ExpressionUUID->"bb39f45d-6e33-334b-a1e1-8249d78215a8"],

Cell["\<\
{Head @ GenerateSymbolicArray[a, {2}], ArrayDomain @ GenerateSymbolicArray[a, \
{2}]}\
\>", "Input",ExpressionUUID->"321ec5e1-bc99-cb45-942e-629d6452a39a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"ArrayObject", ",", "\<\"Expression\"\>"}], "}"}]], "Output",Express\
ionUUID->"c3efe1ed-ae48-bc4f-b75f-2153ad95c6e4"],

Cell["An irregular array cannot carry a symmetry:", "ExampleText",ExpressionUUID->"162457e7-3631-d54b-b2ef-e4a33e330e0b"],

Cell["Quiet @ GenerateSymbolicArray[a, {2, 3}, \"Symmetric\"]", "Input",ExpressionUUID->"bcd1d27b-dce1-a245-90e1-0171e698c144"],

Cell[BoxData["$Failed"], "Output",ExpressionUUID->"94a8fadc-bb29-6347-86a4-086f991a2189"],

Cell["With no indices the single entry is the name itself:", "ExampleText",ExpressionUUID->"dc44604a-2376-9844-ba5e-cbce7bc67d57"],

Cell["Normal @ GenerateSymbolicArray[a, {}]", "Input",ExpressionUUID->"a6d31197-6518-5b4d-b9f0-0b80a4908603"],

Cell[BoxData["a"], "Output",ExpressionUUID->"2c05f2d2-73d8-4444-bae6-08cf7dd7cc8a"],

Cell["Source", "NotesSection",ExpressionUUID->"950fb8d0-a37b-2b4a-93dd-db7e6cc72eef"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "GenerateSymbolicArray",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"d1a0d7ba-9f9c-484e-83e7-8e73f269a371"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"a0e87858-a04c-9746-979f-f9ef5bf42d09"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayObject", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "eba290b0-f8d9-9847-9ea6-77e1addbc364"],
 ", ",
 Cell[BoxData[
  StyleBox["Hypermatrix", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "8292cd65-e53e-624a-83a8-cafe0aac1507"],
 ", ",
 Cell[BoxData[
  StyleBox["ArraySymmetry", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "08724c26-ff6e-6e45-b95a-8ac45d95ad02"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayEntries", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "77f88d13-c32d-da47-adc7-6bab139ecc66"],
 ", ",
 Cell[BoxData[
  StyleBox["RegularArrayQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "ce34baa7-7f93-5c4f-8a2f-be6b1f59d9fd"]
}], "SeeAlso",ExpressionUUID->"ddb4796c-f2c6-504c-8607-ab1465748608"]
},
