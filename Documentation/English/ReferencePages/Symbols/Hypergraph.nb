Cell["\<\
A label given on one occurrence of a vertex propagates to the others:\
\>", "ExampleText",ExpressionUUID->"16065078-8e36-2444-bdc3-37ff2765b93f"],

Cell["\<\
InputForm @ Hypergraph[{Edge[{Vertex[1, \"a\"], 2}], Edge[{1, 3}]}]\
\>", "Input",ExpressionUUID->"0fe54a1c-7b37-c64e-a569-fc6ea2b962e1"],

Cell[BoxData[
 InterpretationBox[
  StyleBox[
   RowBox[{"Hypergraph", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Vertex", "[", "2", "]"}], ",", " ", 
       RowBox[{"Vertex", "[", "3", "]"}], ",", " ", 
       RowBox[{"Vertex", "[", 
        RowBox[{"1", ",", " ", "\"\<a\>\""}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Edge", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Vertex", "[", 
            RowBox[{"1", ",", " ", "\"\<a\>\""}], "]"}], ",", " ", 
           RowBox[{"Vertex", "[", "2", "]"}]}], "}"}], ",", 
         " ", "\"\<Directed\>\""}], "]"}], ",", " ", 
       RowBox[{"Edge", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Vertex", "[", 
            RowBox[{"1", ",", " ", "\"\<a\>\""}], "]"}], ",", " ", 
           RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", 
         " ", "\"\<Directed\>\""}], "]"}]}], "}"}]}], "]"}],
   ShowStringCharacters->True,
