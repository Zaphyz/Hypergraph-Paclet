Cell["\<\
A label given on one occurrence of a vertex propagates to the others:\
\>", "ExampleText",ExpressionUUID->"1a8e90a8-629d-af47-8f4c-b331adcd0520"],

Cell["\<\
InputForm @ Hypergraph[{Edge[{Vertex[1, \"a\"], 2}], Edge[{1, 3}]}]\
\>", "Input",ExpressionUUID->"1ade2d76-eb75-e14d-af7e-55e8aa32eabf"],

Cell[BoxData[
 InterpretationBox[
  StyleBox[
   RowBox[{"Hypergraph", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Vertex", "[", "2", "]"}], ",", " ", 
       RowBox[{"Vertex", "[", "3", "]"}], ",", " ", 
       RowBox[{"Vertex", "[", 
        RowBox[{"1", ",", " ", "\"\<a\>\""}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Edge", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Vertex", "[", 
            RowBox[{"1", ",", " ", "\"\<a\>\""}], "]"}], ",", " ", 
           RowBox[{"Vertex", "[", "2", "]"}]}], "}"}], ",", 
         " ", "\"\<Directed\>\""}], "]"}], ",", " ", 
       RowBox[{"Edge", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Vertex", "[", 
            RowBox[{"1", ",", " ", "\"\<a\>\""}], "]"}], ",", " ", 
           RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", 
         " ", "\"\<Directed\>\""}], "]"}]}], "}"}]}], "]"}],
   ShowStringCharacters->True,
   NumberMarks->True],
  InputForm[
   WolframInstitute`Hypergraphs`Hypergraph[{
     WolframInstitute`Hypergraphs`Vertex[2], 
     WolframInstitute`Hypergraphs`Vertex[3], 
     WolframInstitute`Hypergraphs`Vertex[1, "a"]}, {
     WolframInstitute`Hypergraphs`Edge[{
       WolframInstitute`Hypergraphs`Vertex[1, "a"], 
       WolframInstitute`Hypergraphs`Vertex[2]}, "Directed"], 
     WolframInstitute`Hypergraphs`Edge[{
       WolframInstitute`Hypergraphs`Vertex[1, "a"], 
       WolframInstitute`Hypergraphs`Vertex[3]}, "Directed"]}]],
  AutoDelete->True,
  Editable->True]], "Output",ExpressionUUID->"e722b2d6-677b-784f-8e71-\
fef1b71807cb"],

Cell["Edge order carries no information, but multiplicity does:", \
"ExampleText",ExpressionUUID->"5c386e1a-e211-034a-8501-c9d6e7660065"],

Cell["\<\
{Hypergraph[{Edge[{1, 2}], Edge[{2, 3}]}] === Hypergraph[{Edge[{2, 3}], \
Edge[{1, 2}]}],
 EdgeCount[Hypergraph[{Edge[{1, 2}], Edge[{1, 2}]}]]}\
\>", "Input",ExpressionUUID->"adda579a-38ed-d64f-820a-7e50c7a792aa"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "2"}], "}"}]], "Output",ExpressionUUID->"057c54d6-c2a7-dc47-9e18-5dfcdb475018"],

Cell["The standard graph functions apply directly:", "ExampleText",ExpressionUUID->"339f1e57-a35b-0241-8239-eb1f32bedadd"],

Cell["\<\
h = Hypergraph[{Vertex[1, \"a\"], Vertex[2, \"b\"], 3}, {{1, 2}, {2, 3}}];
{VertexCount[h], EdgeCount[h], VertexList[h]}\
\>", "Input",ExpressionUUID->"b5edf554-734b-3949-8c64-4f97c96479ba"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"3", ",", "2", ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Vertex", "[", "3", "]"}], ",", 
     RowBox[{"Vertex", "[", 
      RowBox[{"1", ",", "\<\"a\"\>"}], "]"}], ",", 
     RowBox[{"Vertex", "[", 
      RowBox[{"2", ",", "\<\"b\"\>"}], "]"}]}], "}"}]}], "}"}]], "Output",Expr\
essionUUID->"2315fd05-7a2a-3046-a75e-a12f22617005"],

Cell["The available properties:", "ExampleText",ExpressionUUID->"bab7cc19-b3e6-c548-88c5-b83a630684a5"],

Cell["h[\"Properties\"]", "Input",ExpressionUUID->"afc0e2a2-410e-704f-b34b-bcedcf4e91dc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"VertexList\"\>", ",", "\<\"EdgeList\"\>", 
   ",", "\<\"VertexCount\"\>", ",", "\<\"EdgeCount\"\>", 
   ",", "\<\"VertexIDs\"\>", ",", "\<\"VertexLabels\"\>", 
   ",", "\<\"EdgeLabels\"\>", ",", "\<\"EdgeSymmetries\"\>", 
   ",", "\<\"Arity\"\>", ",", "\<\"Skeleton\"\>"}], "}"}]], "Output",Expressio\
nUUID->"d93f6b25-e877-7249-89dd-6885c8912356"],

Cell["\<\
{h[\"VertexIDs\"], h[\"VertexLabels\"], h[\"Arity\"], h[\"EdgeSymmetries\"]}\
\>", "Input",ExpressionUUID->"de45885b-b638-ea49-a82e-93d1de908998"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"3", ",", "1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"None", ",", "\<\"a\"\>", ",", "\<\"b\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"Directed\"\>", ",", "\<\"Directed\"\>"}], "}"}]}], 
  "}"}]], "Output",ExpressionUUID->"a263c199-92eb-e341-8703-0967a348b21c"],

