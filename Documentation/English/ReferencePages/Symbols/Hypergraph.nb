Notebook[{
Cell["Hypergraph", "ObjectName",ExpressionUUID->"8c4ff2f1-de0c-3544-aea6-eb2b1c13f910"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Hypergraph", "[", 
    RowBox[{"{", 
     RowBox[{"edge1", ",", " ", "edge2", ",", " ", "..."}], "}"}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "cf7e6887-931e-f64b-8d96-bf52388c06ef"],
 " ",
 "builds a hypergraph from a list of Edge objects; its vertex set is the \
union of the vertices of those edges."
}], "Usage",ExpressionUUID->"233937cd-a4ce-ca48-99b3-b892695f1194"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Hypergraph", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v1", ",", " ", "v2", ",", " ", "..."}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", "...", "}"}], ",", " ", 
       RowBox[{"{", "...", "}"}], ",", " ", "..."}], "}"}]}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "a22a9408-2670-924b-8cc1-f323fd8f6482"],
 " ",
 "builds a hypergraph on an explicit vertex list, with edges given as lists \
of vertex identifiers, directed and unlabelled by default."
}], "Usage",ExpressionUUID->"33f4130d-9ffc-9440-9ce3-b5876199f53f"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Hypergraph", "[", 
    RowBox[{"{", 
     RowBox[{"v1", ",", " ", "v2", ",", " ", "..."}], "}"}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "2fcdfc25-f625-a846-8301-1e4c921471b3"],
 " ",
 "builds an edgeless hypergraph on the given vertices."
}], "Usage",ExpressionUUID->"778ec845-9632-274b-8b1d-e00c55a9ed36"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"96d62cc5-713e-5e45-b7d7-b19c4ff89d7b"],

Cell["\<\
A Hypergraph is a multiset of edges: the order of the edges carries no \
information, and a repeated edge counts once for each occurrence.\
\>", "Notes",ExpressionUUID->"3eef82be-43b2-5a4b-8a40-7a1c0bba960c"],

Cell["\<\
The vertex list and the edge list are both put into a canonical order when \
the hypergraph is built, so two ways of writing the same hypergraph produce \
literally the same expression and may be compared with ===.\
\>", "Notes",ExpressionUUID->"c3886da7-d60a-054f-b70d-0b81f5599e1d"],

Cell["\<\
Vertices occurring only inside edges are absorbed into the vertex set.\
\>", "Notes",ExpressionUUID->"f22fd5d1-3d66-8445-bdc0-4930e47ac276"],

Cell["\<\
A label attached to any occurrence of a vertex propagates to every other \
occurrence of that identifier. If two occurrences disagree, the explicit \
vertex list wins and the message Hypergraph::vlbl is produced.\
\>", "Notes",ExpressionUUID->"467ef19a-acce-7148-8431-f08575874518"],

Cell["\<\
A Hypergraph displays as a drawing of itself, the way a Graph does; see \
HypergraphPlot. Feeding the displayed output back to the kernel recovers the \
object. A hypergraph too large to draw usefully displays as a summary box \
instead; see HypergraphLargeQ.\
\>", "Notes",ExpressionUUID->"5fade7cc-6789-cc4e-9662-136019e56ba4"],

Cell["\<\
VertexList, EdgeList, VertexCount and EdgeCount work directly on a \
Hypergraph. They are protected System` symbols, extended here with UpValues \
rather than redefined.\
\>", "Notes",ExpressionUUID->"678804d0-2a91-4341-89ff-0f083119b704"],

Cell[TextData[{
 "Properties are read as ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"hg", "[", "\"\<prop\>\"", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"6d2073cc-bb53-3d4a-9752-ae7ebd30dd51"],
 ". The available properties are given by ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"hg", "[", "\"\<Properties\>\"", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"51e4633d-45e4-4a41-b7ad-fa8542fdaecd"],
 "."
}], "Notes",ExpressionUUID->"f5e761f8-d719-924a-bb79-34956b0f95ef"],

Cell["\<\
An invalid specification produces the message Hypergraph::spec and returns \
$Failed.\
\>", "Notes",ExpressionUUID->"e2eece2f-1b97-364a-9747-3c172a7cc93f"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"185a4043-29e4-474d-ac4f-1ae0d520184a"],

Cell["From a list of edges; the vertex set is inferred:", "ExampleText",ExpressionUUID->"bb7bf755-778f-a242-9ab9-ea57219ec350"],

