Cell["\<\
A label given on one occurrence of a vertex propagates to the others:\
\>", "ExampleText",ExpressionUUID->"c02c442a-6af9-b843-868a-8764fd520ebf"],

Cell["\<\
InputForm @ Hypergraph[{Edge[{Vertex[1, \"a\"], 2}], Edge[{1, 3}]}]\
\>", "Input",ExpressionUUID->"9e7628ad-0d4d-2242-baa6-45462f70f5ba"],

Cell[BoxData[
 InterpretationBox[
  StyleBox[
   RowBox[{"Hypergraph", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Vertex", "[", "2", "]"}], ",", " ", 
       RowBox[{"Vertex", "[", "3", "]"}], ",", " ", 
       RowBox[{"Vertex", "[", 
        RowBox[{"1", ",", " ", "\"\<a\>\""}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Edge", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Vertex", "[", 
            RowBox[{"1", ",", " ", "\"\<a\>\""}], "]"}], ",", " ", 
           RowBox[{"Vertex", "[", "2", "]"}]}], "}"}], ",", 
         " ", "\"\<Directed\>\""}], "]"}], ",", " ", 
       RowBox[{"Edge", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Vertex", "[", 
            RowBox[{"1", ",", " ", "\"\<a\>\""}], "]"}], ",", " ", 
           RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", 
         " ", "\"\<Directed\>\""}], "]"}]}], "}"}]}], "]"}],
   ShowStringCharacters->True,
   NumberMarks->True],
  InputForm[
   WolframInstitute`Hypergraphs`Hypergraph[{
     WolframInstitute`Hypergraphs`Vertex[2], 
     WolframInstitute`Hypergraphs`Vertex[3], 
     WolframInstitute`Hypergraphs`Vertex[1, "a"]}, {
     WolframInstitute`Hypergraphs`Edge[{
       WolframInstitute`Hypergraphs`Vertex[1, "a"], 
       WolframInstitute`Hypergraphs`Vertex[2]}, "Directed"], 
     WolframInstitute`Hypergraphs`Edge[{
       WolframInstitute`Hypergraphs`Vertex[1, "a"], 
       WolframInstitute`Hypergraphs`Vertex[3]}, "Directed"]}]],
  AutoDelete->True,
  Editable->True]], "Output",ExpressionUUID->"07c3a493-24c8-ed4a-bb0b-\
a8b25ed0c479"],

Cell["Edge order carries no information, but multiplicity does:", \
"ExampleText",ExpressionUUID->"c49deafd-5bd7-854c-a451-42a793417846"],

Cell["\<\
{Hypergraph[{Edge[{1, 2}], Edge[{2, 3}]}] === Hypergraph[{Edge[{2, 3}], \
Edge[{1, 2}]}],
 EdgeCount[Hypergraph[{Edge[{1, 2}], Edge[{1, 2}]}]]}\
\>", "Input",ExpressionUUID->"f82f9798-a946-d345-8972-3efe4ba0103f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "2"}], "}"}]], "Output",ExpressionUUID->"0e7b6a43-20eb-dc48-b5e6-9a975924e8a5"],

Cell["The standard graph functions apply directly:", "ExampleText",ExpressionUUID->"471c180a-3be0-1d49-a25d-e51229cb034f"],

Cell["\<\
h = Hypergraph[{Vertex[1, \"a\"], Vertex[2, \"b\"], 3}, {{1, 2}, {2, 3}}];
{VertexCount[h], EdgeCount[h], VertexList[h]}\
\>", "Input",ExpressionUUID->"b4cbc308-e95c-584e-a4d1-bb8e15b935ff"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"3", ",", "2", ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Vertex", "[", "3", "]"}], ",", 
     RowBox[{"Vertex", "[", 
      RowBox[{"1", ",", "\<\"a\"\>"}], "]"}], ",", 
     RowBox[{"Vertex", "[", 
      RowBox[{"2", ",", "\<\"b\"\>"}], "]"}]}], "}"}]}], "}"}]], "Output",Expr\
essionUUID->"692d247b-5761-144a-9737-718746346132"],

Cell["The available properties:", "ExampleText",ExpressionUUID->"cec241a1-07f1-314c-a569-754de0ac80e0"],

Cell["h[\"Properties\"]", "Input",ExpressionUUID->"93167e1a-061d-af42-b5bc-53f6f8d63956"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"VertexList\"\>", ",", "\<\"EdgeList\"\>", 
   ",", "\<\"VertexCount\"\>", ",", "\<\"EdgeCount\"\>", 
   ",", "\<\"VertexIDs\"\>", ",", "\<\"VertexLabels\"\>", 
   ",", "\<\"EdgeLabels\"\>", ",", "\<\"EdgeSymmetries\"\>", 
   ",", "\<\"Arity\"\>", ",", "\<\"Skeleton\"\>"}], "}"}]], "Output",Expressio\
nUUID->"6f895b9c-259b-fc46-9a7b-314dc95a6494"],

Cell["\<\
{h[\"VertexIDs\"], h[\"VertexLabels\"], h[\"Arity\"], h[\"EdgeSymmetries\"]}\
\>", "Input",ExpressionUUID->"d1e5f764-b430-cb4d-838c-5b70d18838f7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"3", ",", "1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"None", ",", "\<\"a\"\>", ",", "\<\"b\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"Directed\"\>", ",", "\<\"Directed\"\>"}], "}"}]}], 
  "}"}]], "Output",ExpressionUUID->"7f19dfcf-3d7e-f845-b5b1-a75a1e3acc04"],

