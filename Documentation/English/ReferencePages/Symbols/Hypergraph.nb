Cell["\<\
A label given on one occurrence of a vertex propagates to the others:\
\>", "ExampleText",ExpressionUUID->"14d5b6ac-5715-b144-a68d-13aa1f375d4b"],

Cell["\<\
InputForm @ Hypergraph[{Edge[{Vertex[1, \"a\"], 2}], Edge[{1, 3}]}]\
\>", "Input",ExpressionUUID->"1617aa81-de17-3348-b8c5-f9495d787f60"],

Cell[BoxData[
 InterpretationBox[
  StyleBox[
   RowBox[{"Hypergraph", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Vertex", "[", "2", "]"}], ",", " ", 
       RowBox[{"Vertex", "[", "3", "]"}], ",", " ", 
       RowBox[{"Vertex", "[", 
        RowBox[{"1", ",", " ", "\"\<a\>\""}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Edge", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Vertex", "[", 
            RowBox[{"1", ",", " ", "\"\<a\>\""}], "]"}], ",", " ", 
           RowBox[{"Vertex", "[", "2", "]"}]}], "}"}], ",", 
         " ", "\"\<Directed\>\""}], "]"}], ",", " ", 
       RowBox[{"Edge", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Vertex", "[", 
            RowBox[{"1", ",", " ", "\"\<a\>\""}], "]"}], ",", " ", 
           RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", 
         " ", "\"\<Directed\>\""}], "]"}]}], "}"}]}], "]"}],
   ShowStringCharacters->True,
   NumberMarks->True],
  InputForm[
   WolframInstitute`Hypergraphs`Hypergraph[{
     WolframInstitute`Hypergraphs`Vertex[2], 
     WolframInstitute`Hypergraphs`Vertex[3], 
     WolframInstitute`Hypergraphs`Vertex[1, "a"]}, {
     WolframInstitute`Hypergraphs`Edge[{
       WolframInstitute`Hypergraphs`Vertex[1, "a"], 
