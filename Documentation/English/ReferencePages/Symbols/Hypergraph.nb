Cell["Edge order carries no information, but multiplicity does:", \
"ExampleText",ExpressionUUID->"481fc43d-526d-0f47-a60a-d45ab1c26b54"],

Cell["\<\
{Hypergraph[{Edge[{1, 2}], Edge[{2, 3}]}] === Hypergraph[{Edge[{2, 3}], \
Edge[{1, 2}]}],
 EdgeCount[Hypergraph[{Edge[{1, 2}], Edge[{1, 2}]}]]}\
\>", "Input",ExpressionUUID->"7cf25c01-2e83-0f49-bdf7-7449ca686f98"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "2"}], "}"}]], "Output",ExpressionUUID->"e0750281-b4c1-e445-bc00-6cd233baa6c7"],

Cell["The standard graph functions apply directly:", "ExampleText",ExpressionUUID->"584e904f-42dd-aa4c-a2eb-25e8de0eefcd"],

Cell["\<\
h = Hypergraph[{Vertex[1, \"a\"], Vertex[2, \"b\"], 3}, {{1, 2}, {2, 3}}];
{VertexCount[h], EdgeCount[h], VertexList[h]}\
\>", "Input",ExpressionUUID->"9433ccdd-f278-fe48-becf-8687f34b6bfb"],

