Hypergraph[{Edge[{1, 2}], Edge[{2, 3}], Edge[{1, 2, 3}, \"Unordered\"]}]\
\>", "Input",ExpressionUUID->"60e631b2-a4f3-774f-9f98-6be92ae85f48"],

