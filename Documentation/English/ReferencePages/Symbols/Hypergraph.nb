Notebook[{
Cell["Hypergraph", "ObjectName",ExpressionUUID->"23ca2c23-099b-c343-9143-771956ef4151"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Hypergraph", "[", 
    RowBox[{"{", 
     RowBox[{"edge1", ",", " ", "edge2", ",", " ", "..."}], "}"}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "87f6be1c-80e8-4a44-9fe9-e204a5662790"],
 " ",
 "builds a hypergraph from a list of Edge objects; its vertex set is the \
union of the vertices of those edges."
}], "Usage",ExpressionUUID->"28042e5e-8e42-da40-a8ba-67547547e18a"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Hypergraph", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v1", ",", " ", "v2", ",", " ", "..."}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", "...", "}"}], ",", " ", 
       RowBox[{"{", "...", "}"}], ",", " ", "..."}], "}"}]}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "7e80f948-0b13-6c4e-8e46-2610700f80d0"],
 " ",
 "builds a hypergraph on an explicit vertex list, with edges given as lists \
of vertex identifiers, directed and unlabelled by default."
}], "Usage",ExpressionUUID->"a7009a74-825d-6246-8fc6-d8d14ae0aa77"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Hypergraph", "[", 
    RowBox[{"{", 
     RowBox[{"v1", ",", " ", "v2", ",", " ", "..."}], "}"}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "b3bc037a-27d5-5442-be8a-dd22bd14aa6e"],
 " ",
 "builds an edgeless hypergraph on the given vertices."
}], "Usage",ExpressionUUID->"dbc10d8e-d9ee-6d4b-8dba-c45c0b5b9955"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"e253c39e-6c7c-8f4c-a0da-9a67e61d1244"],

Cell["\<\
A Hypergraph is a multiset of edges: the order of the edges carries no \
information, and a repeated edge counts once for each occurrence.\
\>", "Notes",ExpressionUUID->"2b280959-edd7-db46-bdbf-43eddcec9c3e"],

Cell["\<\
The vertex list and the edge list are both put into a canonical order when \
the hypergraph is built, so two ways of writing the same hypergraph produce \
literally the same expression and may be compared with ===.\
\>", "Notes",ExpressionUUID->"dca198d4-6e7a-3e4c-8ce1-1bad666ba259"],

Cell["\<\
Vertices occurring only inside edges are absorbed into the vertex set.\
\>", "Notes",ExpressionUUID->"139620ea-b299-2c46-9af2-02ac577e71e5"],

Cell["\<\
A label attached to any occurrence of a vertex propagates to every other \
occurrence of that identifier. If two occurrences disagree, the explicit \
vertex list wins and the message Hypergraph::vlbl is produced.\
\>", "Notes",ExpressionUUID->"a53b9bed-98fb-b843-84f7-b236a1167aea"],

Cell["\<\
A Hypergraph displays as a drawing of itself, the way a Graph does; see \
HypergraphPlot. Feeding the displayed output back to the kernel recovers the \
object. A hypergraph too large to draw usefully displays as a summary box \
instead; see HypergraphLargeQ.\
\>", "Notes",ExpressionUUID->"362e146b-0d3d-c84d-8b12-cdeca5f6a49e"],

Cell["\<\
VertexList, EdgeList, VertexCount and EdgeCount work directly on a \
Hypergraph. They are protected System` symbols, extended here with UpValues \
rather than redefined.\
\>", "Notes",ExpressionUUID->"7add5d37-94ad-e54b-94b5-ad02f2b531f1"],

Cell[TextData[{
 "Properties are read as ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"hg", "[", "\"\<prop\>\"", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"22a8fe48-00ac-2540-b11f-7f2865405c15"],
 ". The available properties are given by ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"hg", "[", "\"\<Properties\>\"", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"5a6e6c66-1b3c-c94d-a972-d32b7167f10d"],
 "."
}], "Notes",ExpressionUUID->"f712aa0c-07e6-734f-b499-642704952649"],

Cell["\<\
An invalid specification produces the message Hypergraph::spec and returns \
$Failed.\
\>", "Notes",ExpressionUUID->"dea78a82-1114-f64e-b3ba-7fdc8cf64d43"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"ab2d84a9-7590-a749-a3d6-1302f3d727fb"],

Cell["From a list of edges; the vertex set is inferred:", "ExampleText",ExpressionUUID->"408d401f-f7ce-ff4b-a9d3-d9195ce73785"],

Cell["\<\
Hypergraph[{Edge[{1, 2}], Edge[{2, 3}], Edge[{1, 2, 3}, \"Unordered\"]}]\
\>", "Input",ExpressionUUID->"cdd500b3-88dd-ca4a-8738-9044e2444fff"],

