Notebook[{
Cell["Hypergraph", "ObjectName",ExpressionUUID->"7482eece-8b02-7447-9d02-a04afd0dd4e6"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Hypergraph", "[", 
    RowBox[{"{", 
     RowBox[{"edge1", ",", " ", "edge2", ",", " ", "..."}], "}"}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "a5138f9c-acf3-9149-bf43-4864506dd5de"],
 " ",
 "builds a hypergraph from a list of Edge objects; its vertex set is the \
union of the vertices of those edges."
}], "Usage",ExpressionUUID->"28912bcf-5180-f643-a1e4-273143a36ebd"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Hypergraph", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v1", ",", " ", "v2", ",", " ", "..."}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", "...", "}"}], ",", " ", 
       RowBox[{"{", "...", "}"}], ",", " ", "..."}], "}"}]}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "c834c75c-48e9-344a-9d98-544b4375a222"],
 " ",
 "builds a hypergraph on an explicit vertex list, with edges given as lists \
of vertex identifiers, directed and unlabelled by default."
}], "Usage",ExpressionUUID->"528ebf6f-05b0-784b-a79c-73422b393749"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Hypergraph", "[", 
    RowBox[{"{", 
     RowBox[{"v1", ",", " ", "v2", ",", " ", "..."}], "}"}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "b0bd96f9-c205-8846-a966-6deb72b075ce"],
 " ",
 "builds an edgeless hypergraph on the given vertices."
}], "Usage",ExpressionUUID->"a6bdce5f-4dec-9d4e-ac7d-cfd9b9ee6480"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"1ffb41e4-de58-844f-8b53-185d1226c06b"],

Cell["\<\
A Hypergraph is a multiset of edges: the order of the edges carries no \
information, and a repeated edge counts once for each occurrence.\
\>", "Notes",ExpressionUUID->"6f449def-9b7c-ce45-9607-480a76cf4809"],

Cell["\<\
The vertex list and the edge list are both put into a canonical order when \
the hypergraph is built, so two ways of writing the same hypergraph produce \
literally the same expression and may be compared with ===.\
\>", "Notes",ExpressionUUID->"7e15ee74-f03f-1443-908b-0adb70088fad"],

Cell["\<\
Vertices occurring only inside edges are absorbed into the vertex set.\
\>", "Notes",ExpressionUUID->"c7eddd39-b8d6-ae48-be02-c66155303c94"],

Cell["\<\
A label attached to any occurrence of a vertex propagates to every other \
occurrence of that identifier. If two occurrences disagree, the explicit \
vertex list wins and the message Hypergraph::vlbl is produced.\
\>", "Notes",ExpressionUUID->"2944e76c-cdad-0a46-9609-fb2e4870d394"],

Cell["\<\
A Hypergraph displays as a drawing of itself, the way a Graph does; see \
HypergraphPlot. Feeding the displayed output back to the kernel recovers the \
object. A hypergraph too large to draw usefully displays as a summary box \
instead; see HypergraphLargeQ.\
\>", "Notes",ExpressionUUID->"c57391fd-a95a-a445-9b83-834ca7b88ce2"],

Cell["\<\
VertexList, EdgeList, VertexCount and EdgeCount work directly on a \
Hypergraph. They are protected System` symbols, extended here with UpValues \
rather than redefined.\
\>", "Notes",ExpressionUUID->"97b9e2e8-6a17-4446-bebf-b3bd1c46d173"],

Cell[TextData[{
 "Properties are read as ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"hg", "[", "\"\<prop\>\"", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"05c17929-f4e5-5141-93d8-0d363d37eff4"],
 ". The available properties are given by ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"hg", "[", "\"\<Properties\>\"", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"bdf93c66-4ecb-ef40-8c2e-0efeccbcaf2e"],
 "."
}], "Notes",ExpressionUUID->"260a756a-827f-b245-8fd0-61ebd9fb4a3c"],

Cell["\<\
An invalid specification produces the message Hypergraph::spec and returns \
$Failed.\
\>", "Notes",ExpressionUUID->"0dde1243-164e-5446-8240-e3c2578f54e9"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"b039402a-f7e0-b74a-977a-e145a64e1c32"],

Cell["From a list of edges; the vertex set is inferred:", "ExampleText",ExpressionUUID->"f24de229-e4d9-674f-9dbd-45315227238a"],

