Hypergraph[{Edge[{1, 2}], Edge[{2, 3}], Edge[{1, 2, 3}, \"Unordered\"]}]\
\>", "Input",ExpressionUUID->"0bfd7b57-293b-4d41-a542-99202d7be20e"],

