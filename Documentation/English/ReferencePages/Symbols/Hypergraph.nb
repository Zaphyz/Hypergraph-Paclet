Cell["\<\
A label given on one occurrence of a vertex propagates to the others:\
\>", "ExampleText",ExpressionUUID->"1c5dfda3-5660-b644-93d4-a2b22746c060"],

Cell["\<\
InputForm @ Hypergraph[{Edge[{Vertex[1, \"a\"], 2}], Edge[{1, 3}]}]\
\>", "Input",ExpressionUUID->"8dece769-5b0c-a542-914f-fc1d856d7cbe"],

Cell[BoxData[
 InterpretationBox[
  StyleBox[
   RowBox[{"Hypergraph", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Vertex", "[", "2", "]"}], ",", " ", 
       RowBox[{"Vertex", "[", "3", "]"}], ",", " ", 
       RowBox[{"Vertex", "[", 
        RowBox[{"1", ",", " ", "\"\<a\>\""}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Edge", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Vertex", "[", 
            RowBox[{"1", ",", " ", "\"\<a\>\""}], "]"}], ",", " ", 
           RowBox[{"Vertex", "[", "2", "]"}]}], "}"}], ",", 
         " ", "\"\<Directed\>\""}], "]"}], ",", " ", 
       RowBox[{"Edge", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Vertex", "[", 
            RowBox[{"1", ",", " ", "\"\<a\>\""}], "]"}], ",", " ", 
           RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", 
         " ", "\"\<Directed\>\""}], "]"}]}], "}"}]}], "]"}],
   ShowStringCharacters->True,
   NumberMarks->True],
  InputForm[
   WolframInstitute`Hypergraphs`Hypergraph[{
     WolframInstitute`Hypergraphs`Vertex[2], 
     WolframInstitute`Hypergraphs`Vertex[3], 
     WolframInstitute`Hypergraphs`Vertex[1, "a"]}, {
     WolframInstitute`Hypergraphs`Edge[{
       WolframInstitute`Hypergraphs`Vertex[1, "a"], 
       WolframInstitute`Hypergraphs`Vertex[2]}, "Directed"], 
     WolframInstitute`Hypergraphs`Edge[{
       WolframInstitute`Hypergraphs`Vertex[1, "a"], 
       WolframInstitute`Hypergraphs`Vertex[3]}, "Directed"]}]],
  AutoDelete->True,
  Editable->True]], "Output",ExpressionUUID->"1327dd95-b1b8-ab4f-b013-\
32ad163160b8"],

Cell["Edge order carries no information, but multiplicity does:", \
"ExampleText",ExpressionUUID->"8ab6904c-d9c0-e04a-b3b6-7e0aa87fcb87"],

Cell["\<\
{Hypergraph[{Edge[{1, 2}], Edge[{2, 3}]}] === Hypergraph[{Edge[{2, 3}], \
Edge[{1, 2}]}],
 EdgeCount[Hypergraph[{Edge[{1, 2}], Edge[{1, 2}]}]]}\
\>", "Input",ExpressionUUID->"bb1714d0-460d-a347-a339-a82b0cfadae9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "2"}], "}"}]], "Output",ExpressionUUID->"d00a055a-df80-9d4f-8c59-0593ff76872d"],

Cell["The standard graph functions apply directly:", "ExampleText",ExpressionUUID->"8885b691-5b45-0a45-ad86-7a33bfdbe263"],

Cell["\<\
h = Hypergraph[{Vertex[1, \"a\"], Vertex[2, \"b\"], 3}, {{1, 2}, {2, 3}}];
{VertexCount[h], EdgeCount[h], VertexList[h]}\
\>", "Input",ExpressionUUID->"7d166f05-a82d-ce46-8986-991b877dbc8c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"3", ",", "2", ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Vertex", "[", "3", "]"}], ",", 
     RowBox[{"Vertex", "[", 
      RowBox[{"1", ",", "\<\"a\"\>"}], "]"}], ",", 
     RowBox[{"Vertex", "[", 
      RowBox[{"2", ",", "\<\"b\"\>"}], "]"}]}], "}"}]}], "}"}]], "Output",Expr\
essionUUID->"4fae3c7a-aabb-f342-9891-fb1b4bdc9614"],

Cell["The available properties:", "ExampleText",ExpressionUUID->"06384d0f-ed71-8f43-a143-f600bef2e463"],

Cell["h[\"Properties\"]", "Input",ExpressionUUID->"2da68ad6-edd6-7c42-b437-e76893054712"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"VertexList\"\>", ",", "\<\"EdgeList\"\>", 
   ",", "\<\"VertexCount\"\>", ",", "\<\"EdgeCount\"\>", 
   ",", "\<\"VertexIDs\"\>", ",", "\<\"VertexLabels\"\>", 
   ",", "\<\"EdgeLabels\"\>", ",", "\<\"EdgeSymmetries\"\>", 
   ",", "\<\"Arity\"\>", ",", "\<\"Skeleton\"\>"}], "}"}]], "Output",Expressio\
nUUID->"50a86554-a483-a344-b5d8-5cff54da9ba9"],

Cell["\<\
{h[\"VertexIDs\"], h[\"VertexLabels\"], h[\"Arity\"], h[\"EdgeSymmetries\"]}\
\>", "Input",ExpressionUUID->"be86fc55-937c-df45-97f9-a0f901ac8c42"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"3", ",", "1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"None", ",", "\<\"a\"\>", ",", "\<\"b\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"Directed\"\>", ",", "\<\"Directed\"\>"}], "}"}]}], 
  "}"}]], "Output",ExpressionUUID->"a8ee33a8-000a-2e44-8384-3bc0b1d733ea"],

