Cell["\<\
A label given on one occurrence of a vertex propagates to the others:\
\>", "ExampleText",ExpressionUUID->"f817064d-d982-df4e-b63d-2ccc9835d997"],

Cell["\<\
InputForm @ Hypergraph[{Edge[{Vertex[1, \"a\"], 2}], Edge[{1, 3}]}]\
\>", "Input",ExpressionUUID->"1dc4c236-328e-ee4e-a8fc-52918eeb703c"],

Cell[BoxData[
 InterpretationBox[
  StyleBox[
   RowBox[{"Hypergraph", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Vertex", "[", "2", "]"}], ",", " ", 
       RowBox[{"Vertex", "[", "3", "]"}], ",", " ", 
       RowBox[{"Vertex", "[", 
        RowBox[{"1", ",", " ", "\"\<a\>\""}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Edge", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Vertex", "[", 
            RowBox[{"1", ",", " ", "\"\<a\>\""}], "]"}], ",", " ", 
           RowBox[{"Vertex", "[", "2", "]"}]}], "}"}], ",", 
         " ", "\"\<Directed\>\""}], "]"}], ",", " ", 
       RowBox[{"Edge", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Vertex", "[", 
            RowBox[{"1", ",", " ", "\"\<a\>\""}], "]"}], ",", " ", 
           RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", 
         " ", "\"\<Directed\>\""}], "]"}]}], "}"}]}], "]"}],
   ShowStringCharacters->True,
   NumberMarks->True],
  InputForm[
   WolframInstitute`Hypergraphs`Hypergraph[{
     WolframInstitute`Hypergraphs`Vertex[2], 
     WolframInstitute`Hypergraphs`Vertex[3], 
     WolframInstitute`Hypergraphs`Vertex[1, "a"]}, {
     WolframInstitute`Hypergraphs`Edge[{
       WolframInstitute`Hypergraphs`Vertex[1, "a"], 
       WolframInstitute`Hypergraphs`Vertex[2]}, "Directed"], 
     WolframInstitute`Hypergraphs`Edge[{
       WolframInstitute`Hypergraphs`Vertex[1, "a"], 
       WolframInstitute`Hypergraphs`Vertex[3]}, "Directed"]}]],
  AutoDelete->True,
  Editable->True]], "Output",ExpressionUUID->"8d83c3b6-0a5c-1c42-ab1c-\
7714eacb0aaa"],

Cell["Edge order carries no information, but multiplicity does:", \
"ExampleText",ExpressionUUID->"ef62ce88-196b-e54c-809a-ebf243eb3405"],

Cell["\<\
{Hypergraph[{Edge[{1, 2}], Edge[{2, 3}]}] === Hypergraph[{Edge[{2, 3}], \
Edge[{1, 2}]}],
 EdgeCount[Hypergraph[{Edge[{1, 2}], Edge[{1, 2}]}]]}\
\>", "Input",ExpressionUUID->"c49ea4df-f88f-c545-b9b8-8e146d20aeca"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "2"}], "}"}]], "Output",ExpressionUUID->"beb6bbb8-b618-5f48-a899-8f559e618bdf"],

Cell["The standard graph functions apply directly:", "ExampleText",ExpressionUUID->"7cb77777-1a9e-164f-bb3f-b726e86b1e24"],

Cell["\<\
h = Hypergraph[{Vertex[1, \"a\"], Vertex[2, \"b\"], 3}, {{1, 2}, {2, 3}}];
{VertexCount[h], EdgeCount[h], VertexList[h]}\
\>", "Input",ExpressionUUID->"0d86a294-31b9-e34c-822c-9de734613ffe"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"3", ",", "2", ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Vertex", "[", "3", "]"}], ",", 
     RowBox[{"Vertex", "[", 
      RowBox[{"1", ",", "\<\"a\"\>"}], "]"}], ",", 
     RowBox[{"Vertex", "[", 
      RowBox[{"2", ",", "\<\"b\"\>"}], "]"}]}], "}"}]}], "}"}]], "Output",Expr\
essionUUID->"4437a876-a39a-ca40-8a75-696cbb47844e"],

Cell["The available properties:", "ExampleText",ExpressionUUID->"f1928ac1-075d-6e43-a067-65914f52053a"],

Cell["h[\"Properties\"]", "Input",ExpressionUUID->"eba07de8-48ca-ff47-bfaa-964977def164"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"VertexList\"\>", ",", "\<\"EdgeList\"\>", 
   ",", "\<\"VertexCount\"\>", ",", "\<\"EdgeCount\"\>", 
   ",", "\<\"VertexIDs\"\>", ",", "\<\"VertexLabels\"\>", 
   ",", "\<\"EdgeLabels\"\>", ",", "\<\"EdgeSymmetries\"\>", 
   ",", "\<\"Arity\"\>", ",", "\<\"Skeleton\"\>"}], "}"}]], "Output",Expressio\
nUUID->"e078786c-27c9-a741-9ec1-ffe780e21192"],

Cell["\<\
{h[\"VertexIDs\"], h[\"VertexLabels\"], h[\"Arity\"], h[\"EdgeSymmetries\"]}\
\>", "Input",ExpressionUUID->"83c824bb-bf16-5c4a-9474-6d26bda85b10"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"3", ",", "1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"None", ",", "\<\"a\"\>", ",", "\<\"b\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"Directed\"\>", ",", "\<\"Directed\"\>"}], "}"}]}], 
  "}"}]], "Output",ExpressionUUID->"e1cc6261-3cdd-054a-9e7f-f23a4b468fc4"],

