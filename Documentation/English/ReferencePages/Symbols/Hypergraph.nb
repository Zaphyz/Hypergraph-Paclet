Notebook[{
Cell["Hypergraph", "ObjectName",ExpressionUUID->"4c9b09d4-8f6e-da49-9904-ebcdc219d1df"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Hypergraph", "[", 
    RowBox[{"{", 
     RowBox[{"edge1", ",", " ", "edge2", ",", " ", "..."}], "}"}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "96bf963c-096d-3843-b0d6-b4a6f1be084a"],
 " ",
 "builds a hypergraph from a list of Edge objects; its vertex set is the \
union of the vertices of those edges."
}], "Usage",ExpressionUUID->"a050031e-915d-8640-bfee-c8ceaae1172c"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Hypergraph", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v1", ",", " ", "v2", ",", " ", "..."}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", "...", "}"}], ",", " ", 
       RowBox[{"{", "...", "}"}], ",", " ", "..."}], "}"}]}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "a6933ae4-d6f6-4343-beac-a4e7752f82f8"],
 " ",
 "builds a hypergraph on an explicit vertex list, with edges given as lists \
of vertex identifiers, directed and unlabelled by default."
}], "Usage",ExpressionUUID->"c47eedf7-9123-6b4d-9733-165b1ff68479"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Hypergraph", "[", 
    RowBox[{"{", 
     RowBox[{"v1", ",", " ", "v2", ",", " ", "..."}], "}"}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "38911088-322a-ca4f-8cc5-fd84611dd875"],
 " ",
 "builds an edgeless hypergraph on the given vertices."
}], "Usage",ExpressionUUID->"f9284b77-abb5-ce48-b583-ce130011bb93"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"caf239ce-d488-9246-8222-523c200b5b91"],

Cell["\<\
A Hypergraph is a multiset of edges: the order of the edges carries no \
information, and a repeated edge counts once for each occurrence.\
\>", "Notes",ExpressionUUID->"91091c1c-951c-7248-a7b0-959f05c5d099"],

Cell["\<\
The vertex list and the edge list are both put into a canonical order when \
the hypergraph is built, so two ways of writing the same hypergraph produce \
literally the same expression and may be compared with ===.\
\>", "Notes",ExpressionUUID->"04c67ee4-294a-c843-abf9-416e3f96d472"],

Cell["\<\
Vertices occurring only inside edges are absorbed into the vertex set.\
\>", "Notes",ExpressionUUID->"bac9a249-7734-8249-8bab-f1c2ff4e1abe"],

Cell["\<\
A label attached to any occurrence of a vertex propagates to every other \
occurrence of that identifier. If two occurrences disagree, the explicit \
vertex list wins and the message Hypergraph::vlbl is produced.\
\>", "Notes",ExpressionUUID->"42a91a7e-8c70-b541-9543-77be55604937"],

Cell["\<\
A Hypergraph displays as a drawing of itself, the way a Graph does; see \
HypergraphPlot. Feeding the displayed output back to the kernel recovers the \
object. A hypergraph too large to draw usefully displays as a summary box \
instead; see HypergraphLargeQ.\
\>", "Notes",ExpressionUUID->"55654ee5-16ec-e94d-b23e-ef5db50c6fd7"],

Cell["\<\
VertexList, EdgeList, VertexCount and EdgeCount work directly on a \
Hypergraph. They are protected System` symbols, extended here with UpValues \
rather than redefined.\
\>", "Notes",ExpressionUUID->"345cca2b-ab7c-d045-b69b-a8d7ed00bd48"],

Cell[TextData[{
 "Properties are read as ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"hg", "[", "\"\<prop\>\"", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"fb575975-21f0-e049-8afc-90f684a4ccee"],
 ". The available properties are given by ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"hg", "[", "\"\<Properties\>\"", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"a4845ff2-8501-464d-8ff6-d109d5acf2b9"],
 "."
}], "Notes",ExpressionUUID->"86a335ac-bf26-1e48-a787-2935be4cada6"],

Cell["\<\
An invalid specification produces the message Hypergraph::spec and returns \
$Failed.\
\>", "Notes",ExpressionUUID->"e70a49e2-a273-1948-9efc-b4509e536a7d"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"0c976fc0-4f98-9c42-b3f3-716b0345d9bf"],

Cell["From a list of edges; the vertex set is inferred:", "ExampleText",ExpressionUUID->"f30b288a-f78e-4e45-96e2-cdde8ff878c3"],

Cell["\<\
Hypergraph[{Edge[{1, 2}], Edge[{2, 3}], Edge[{1, 2, 3}, \"Unordered\"]}]\
\>", "Input",ExpressionUUID->"a90c1696-2a62-c440-a9f7-2f43ca88ebd6"],

