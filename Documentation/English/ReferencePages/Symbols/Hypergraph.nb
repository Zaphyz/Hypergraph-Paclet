  AutoDelete->True,
  Editable->True]], "Output",ExpressionUUID->"37330052-3897-9744-a448-\
adf1bf54a1b8"],

Cell["Edge order carries no information, but multiplicity does:", \
"ExampleText",ExpressionUUID->"9cc87bb1-3539-f24e-a16d-95cbf35e95dc"],

Cell["\<\
{Hypergraph[{Edge[{1, 2}], Edge[{2, 3}]}] === Hypergraph[{Edge[{2, 3}], \
Edge[{1, 2}]}],
 EdgeCount[Hypergraph[{Edge[{1, 2}], Edge[{1, 2}]}]]}\
\>", "Input",ExpressionUUID->"86f15c81-a254-4945-a593-3a5e5d4168bf"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "2"}], "}"}]], "Output",ExpressionUUID->"01a4b842-8c48-394b-97c5-c0b9c77aa96a"],

Cell["The standard graph functions apply directly:", "ExampleText",ExpressionUUID->"7563b241-56b3-2a49-b479-cb7adb224608"],

Cell["\<\
h = Hypergraph[{Vertex[1, \"a\"], Vertex[2, \"b\"], 3}, {{1, 2}, {2, 3}}];
{VertexCount[h], EdgeCount[h], VertexList[h]}\
\>", "Input",ExpressionUUID->"e5b87049-1ceb-f945-9442-e8b33dcc1174"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"3", ",", "2", ",", 
   RowBox[{"{", 
