  AutoDelete->True,
  Editable->True]], "Output",ExpressionUUID->"526732ca-b15b-194b-ab9a-\
ee693925edf8"],

Cell["Edge order carries no information, but multiplicity does:", \
"ExampleText",ExpressionUUID->"2974e215-7dd4-5846-bb78-ea02478210c2"],

Cell["\<\
{Hypergraph[{Edge[{1, 2}], Edge[{2, 3}]}] === Hypergraph[{Edge[{2, 3}], \
Edge[{1, 2}]}],
 EdgeCount[Hypergraph[{Edge[{1, 2}], Edge[{1, 2}]}]]}\
\>", "Input",ExpressionUUID->"0cbec02b-06f3-ef4e-8fb6-442e553be616"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "2"}], "}"}]], "Output",ExpressionUUID->"4be4ba0d-819f-f94a-9082-7c445995bf8c"],

Cell["The standard graph functions apply directly:", "ExampleText",ExpressionUUID->"964c56d8-8667-d14a-982b-81e5149091b8"],

Cell["\<\
h = Hypergraph[{Vertex[1, \"a\"], Vertex[2, \"b\"], 3}, {{1, 2}, {2, 3}}];
{VertexCount[h], EdgeCount[h], VertexList[h]}\
\>", "Input",ExpressionUUID->"e72f0bee-513d-c048-9431-419879f3233d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"3", ",", "2", ",", 
