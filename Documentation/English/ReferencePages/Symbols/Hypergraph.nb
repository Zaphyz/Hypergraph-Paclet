     RowBox[{"Vertex", "[", "3", "]"}], ",", 
     RowBox[{"Vertex", "[", 
      RowBox[{"1", ",", "\<\"a\"\>"}], "]"}], ",", 
     RowBox[{"Vertex", "[", 
      RowBox[{"2", ",", "\<\"b\"\>"}], "]"}]}], "}"}]}], "}"}]], "Output",Expr\
essionUUID->"a77bba86-d3e7-184d-a854-873bc3cec479"],

Cell["The available properties:", "ExampleText",ExpressionUUID->"64eb9430-41d4-b348-8df0-8b9a88c14248"],

