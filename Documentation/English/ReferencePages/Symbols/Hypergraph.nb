Cell["\<\
A label given on one occurrence of a vertex propagates to the others:\
\>", "ExampleText",ExpressionUUID->"b830e87b-9a24-e44a-a30a-2a4dbd429abe"],

Cell["\<\
InputForm @ Hypergraph[{Edge[{Vertex[1, \"a\"], 2}], Edge[{1, 3}]}]\
\>", "Input",ExpressionUUID->"166103cd-fc42-cb46-a1ef-f440b8acbfb3"],

Cell[BoxData[
 InterpretationBox[
  StyleBox[
   RowBox[{"Hypergraph", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Vertex", "[", "2", "]"}], ",", " ", 
       RowBox[{"Vertex", "[", "3", "]"}], ",", " ", 
       RowBox[{"Vertex", "[", 
        RowBox[{"1", ",", " ", "\"\<a\>\""}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Edge", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Vertex", "[", 
            RowBox[{"1", ",", " ", "\"\<a\>\""}], "]"}], ",", " ", 
           RowBox[{"Vertex", "[", "2", "]"}]}], "}"}], ",", 
         " ", "\"\<Directed\>\""}], "]"}], ",", " ", 
       RowBox[{"Edge", "[", 
        RowBox[{
