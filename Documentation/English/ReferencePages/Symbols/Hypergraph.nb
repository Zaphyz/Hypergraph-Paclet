Notebook[{
Cell["Hypergraph", "ObjectName",ExpressionUUID->"9a6fc3e0-408c-2844-a4d3-3f1dd992d14f"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Hypergraph", "[", 
    RowBox[{"{", 
     RowBox[{"edge1", ",", " ", "edge2", ",", " ", "..."}], "}"}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "ff99b3bf-cde2-f444-bca8-3daed0c26b02"],
 " ",
 "builds a hypergraph from a list of Edge objects; its vertex set is the \
union of the vertices of those edges."
}], "Usage",ExpressionUUID->"10e5716c-a18d-b542-8199-c89771a9575f"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Hypergraph", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v1", ",", " ", "v2", ",", " ", "..."}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", "...", "}"}], ",", " ", 
       RowBox[{"{", "...", "}"}], ",", " ", "..."}], "}"}]}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "2bffa0ef-2bb3-0e4e-bfb5-3882df47694d"],
 " ",
 "builds a hypergraph on an explicit vertex list, with edges given as lists \
of vertex identifiers, directed and unlabelled by default."
}], "Usage",ExpressionUUID->"88c5cc05-d6c4-c24f-ae9b-fc190ac84c05"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Hypergraph", "[", 
    RowBox[{"{", 
     RowBox[{"v1", ",", " ", "v2", ",", " ", "..."}], "}"}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "1dbff9ce-5511-284f-bfcc-ea04e6b158ab"],
 " ",
 "builds an edgeless hypergraph on the given vertices."
}], "Usage",ExpressionUUID->"241079de-a47b-a441-a790-7dad43a01cce"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"3b52f5e4-7817-f444-9bb2-19e5bd4dc905"],

Cell["\<\
A Hypergraph is a multiset of edges: the order of the edges carries no \
information, and a repeated edge counts once for each occurrence.\
\>", "Notes",ExpressionUUID->"82bc587f-b82b-5949-b11b-deb19e98b712"],

Cell["\<\
The vertex list and the edge list are both put into a canonical order when \
the hypergraph is built, so two ways of writing the same hypergraph produce \
literally the same expression and may be compared with ===.\
\>", "Notes",ExpressionUUID->"561acacc-1171-a44b-8c23-a2ec9b7a806f"],

Cell["\<\
Vertices occurring only inside edges are absorbed into the vertex set.\
\>", "Notes",ExpressionUUID->"d13cae02-4c64-7c45-b038-b9f207a6753e"],

Cell["\<\
A label attached to any occurrence of a vertex propagates to every other \
occurrence of that identifier. If two occurrences disagree, the explicit \
vertex list wins and the message Hypergraph::vlbl is produced.\
\>", "Notes",ExpressionUUID->"9570350c-90ed-f54e-bc7e-c77bb67a28e8"],

Cell["\<\
A Hypergraph displays as a drawing of itself, the way a Graph does; see \
HypergraphPlot. Feeding the displayed output back to the kernel recovers the \
object. A hypergraph too large to draw usefully displays as a summary box \
instead; see HypergraphLargeQ.\
\>", "Notes",ExpressionUUID->"a92f3426-308b-cc44-a3b2-17649f779087"],

Cell["\<\
VertexList, EdgeList, VertexCount and EdgeCount work directly on a \
Hypergraph. They are protected System` symbols, extended here with UpValues \
rather than redefined.\
\>", "Notes",ExpressionUUID->"5eb32ee1-ea7e-684f-b096-28ab21f26855"],

Cell[TextData[{
 "Properties are read as ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"hg", "[", "\"\<prop\>\"", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"0eff563a-6a17-0a4f-931a-e8a977113127"],
 ". The available properties are given by ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"hg", "[", "\"\<Properties\>\"", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"567e825b-1af7-5148-8a34-8a05f9519cdb"],
 "."
}], "Notes",ExpressionUUID->"a7f93ba6-a04f-7a41-973e-8fc9f8868678"],

Cell["\<\
An invalid specification produces the message Hypergraph::spec and returns \
$Failed.\
\>", "Notes",ExpressionUUID->"cd1897d5-16e3-9840-8435-41e0816ec879"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"b0ac4541-c953-9d4c-9ebd-fc4ee732ae07"],

Cell["From a list of edges; the vertex set is inferred:", "ExampleText",ExpressionUUID->"d0bba1f8-92af-1a45-aa59-119017116652"],

