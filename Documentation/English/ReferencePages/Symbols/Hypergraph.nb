Notebook[{
Cell["Hypergraph", "ObjectName",ExpressionUUID->"d732acfd-5ded-b54f-a23f-4cc9f8bdb490"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Hypergraph", "[", 
    RowBox[{"{", 
     RowBox[{"edge1", ",", " ", "edge2", ",", " ", "..."}], "}"}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "0a618c20-dc37-2549-b823-a82cad6a5033"],
 " ",
 "builds a hypergraph from a list of Edge objects; its vertex set is the \
union of the vertices of those edges."
}], "Usage",ExpressionUUID->"69d27251-946a-ba49-b3cd-5482c036fe36"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Hypergraph", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v1", ",", " ", "v2", ",", " ", "..."}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", "...", "}"}], ",", " ", 
       RowBox[{"{", "...", "}"}], ",", " ", "..."}], "}"}]}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "4c8793a6-8a2e-184f-a2a5-45619c2418e0"],
 " ",
 "builds a hypergraph on an explicit vertex list, with edges given as lists \
of vertex identifiers, directed and unlabelled by default."
}], "Usage",ExpressionUUID->"4c859da8-180a-0442-aaeb-04c27789e3f0"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Hypergraph", "[", 
    RowBox[{"{", 
     RowBox[{"v1", ",", " ", "v2", ",", " ", "..."}], "}"}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "460cb9da-3cbb-674c-85cb-512fc31baaea"],
 " ",
 "builds an edgeless hypergraph on the given vertices."
}], "Usage",ExpressionUUID->"b8eb22d0-601b-de47-8a08-6f7f3309d8f3"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"845d734f-b3ed-f545-acef-638a9cf44e90"],

Cell["\<\
A Hypergraph is a multiset of edges: the order of the edges carries no \
information, and a repeated edge counts once for each occurrence.\
\>", "Notes",ExpressionUUID->"28b76618-ea01-e74d-86cc-d33366b45f68"],

Cell["\<\
The vertex list and the edge list are both put into a canonical order when \
the hypergraph is built, so two ways of writing the same hypergraph produce \
literally the same expression and may be compared with ===.\
\>", "Notes",ExpressionUUID->"a5544fa4-620d-e040-91a8-fc771fca2647"],

Cell["\<\
Vertices occurring only inside edges are absorbed into the vertex set.\
\>", "Notes",ExpressionUUID->"3a5e37fb-5afa-ee48-b40e-abf825c88ae5"],

Cell["\<\
A label attached to any occurrence of a vertex propagates to every other \
occurrence of that identifier. If two occurrences disagree, the explicit \
vertex list wins and the message Hypergraph::vlbl is produced.\
\>", "Notes",ExpressionUUID->"3c656f17-bd3e-be4e-aab9-a148e32b0103"],

Cell["\<\
A Hypergraph displays as a drawing of itself, the way a Graph does; see \
HypergraphPlot. Feeding the displayed output back to the kernel recovers the \
object. A hypergraph too large to draw usefully displays as a summary box \
instead; see HypergraphLargeQ.\
\>", "Notes",ExpressionUUID->"5a5291da-79d9-7049-8803-a7cf8a8b4cac"],

Cell["\<\
VertexList, EdgeList, VertexCount and EdgeCount work directly on a \
Hypergraph. They are protected System` symbols, extended here with UpValues \
rather than redefined.\
\>", "Notes",ExpressionUUID->"228e7698-ffc9-a341-af4a-dfa38634e2ff"],

Cell[TextData[{
 "Properties are read as ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"hg", "[", "\"\<prop\>\"", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"75e075c2-54ae-e044-88de-db9fee9a6bab"],
 ". The available properties are given by ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"hg", "[", "\"\<Properties\>\"", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"456fd40c-b1f3-ab4e-ac66-b8808ae0ae7f"],
 "."
}], "Notes",ExpressionUUID->"236c774d-4429-9241-b8e1-21797a14a79b"],

Cell["\<\
An invalid specification produces the message Hypergraph::spec and returns \
$Failed.\
\>", "Notes",ExpressionUUID->"b974e7fe-dd74-fa46-a33f-e1c8cb5e42a2"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"889fb365-79ae-8142-80b7-7aebca3caccc"],

Cell["From a list of edges; the vertex set is inferred:", "ExampleText",ExpressionUUID->"822fe171-5ba0-1a40-9917-932cccb4e542"],

Cell["\<\
Hypergraph[{Edge[{1, 2}], Edge[{2, 3}], Edge[{1, 2, 3}, \"Unordered\"]}]\
\>", "Input",ExpressionUUID->"50788d2f-5d6c-1b41-a75d-5cba78c126bb"],

