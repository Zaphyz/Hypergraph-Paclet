Notebook[{
Cell["Hypergraph", "ObjectName",ExpressionUUID->"6c060698-b800-d84c-a87e-36285521e446"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Hypergraph", "[", 
    RowBox[{"{", 
     RowBox[{"edge1", ",", " ", "edge2", ",", " ", "..."}], "}"}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "aacbf304-8f34-8c47-922a-ad8671d6231e"],
 " ",
 "builds a hypergraph from a list of Edge objects; its vertex set is the \
union of the vertices of those edges."
}], "Usage",ExpressionUUID->"74302090-42bb-2f45-9231-05fd310b436c"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Hypergraph", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v1", ",", " ", "v2", ",", " ", "..."}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", "...", "}"}], ",", " ", 
       RowBox[{"{", "...", "}"}], ",", " ", "..."}], "}"}]}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "3b22a72e-09cc-0649-8081-0a2a000e63bb"],
 " ",
 "builds a hypergraph on an explicit vertex list, with edges given as lists \
of vertex identifiers, directed and unlabelled by default."
}], "Usage",ExpressionUUID->"faec8c9e-2876-884f-8143-4eff3e06a4c8"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Hypergraph", "[", 
    RowBox[{"{", 
     RowBox[{"v1", ",", " ", "v2", ",", " ", "..."}], "}"}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "e0107639-0e12-4549-a54e-f8f5436e1c13"],
 " ",
 "builds an edgeless hypergraph on the given vertices."
}], "Usage",ExpressionUUID->"a14cfb56-c873-3f4e-8fe8-de2fc8fbcfb0"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"b36504f2-81fe-4248-bd1b-6ac7467028ea"],

Cell["\<\
A Hypergraph is a multiset of edges: the order of the edges carries no \
information, and a repeated edge counts once for each occurrence.\
\>", "Notes",ExpressionUUID->"d0de2a53-74b1-5d44-8d82-d4e0f859da1a"],

Cell["\<\
The vertex list and the edge list are both put into a canonical order when \
the hypergraph is built, so two ways of writing the same hypergraph produce \
literally the same expression and may be compared with ===.\
\>", "Notes",ExpressionUUID->"50f0b512-adc5-544c-b9ee-512591112a40"],

Cell["\<\
Vertices occurring only inside edges are absorbed into the vertex set.\
\>", "Notes",ExpressionUUID->"c1d135fc-3202-8447-bfc4-f64dc00531f4"],

Cell["\<\
A label attached to any occurrence of a vertex propagates to every other \
occurrence of that identifier. If two occurrences disagree, the explicit \
vertex list wins and the message Hypergraph::vlbl is produced.\
\>", "Notes",ExpressionUUID->"1fb25c62-69b7-ba44-82db-1a427a7fc2e2"],

Cell["\<\
A Hypergraph displays as a drawing of itself, the way a Graph does; see \
HypergraphPlot. Feeding the displayed output back to the kernel recovers the \
object. A hypergraph too large to draw usefully displays as a summary box \
instead; see HypergraphLargeQ.\
\>", "Notes",ExpressionUUID->"5805d084-2662-d945-ad32-47c5157f322f"],

Cell["\<\
VertexList, EdgeList, VertexCount and EdgeCount work directly on a \
Hypergraph. They are protected System` symbols, extended here with UpValues \
rather than redefined.\
\>", "Notes",ExpressionUUID->"ca293718-f923-2d4c-821a-23bf9c6481dc"],

Cell[TextData[{
 "Properties are read as ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"hg", "[", "\"\<prop\>\"", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"39c2b5c3-fd3d-6f46-ba9a-8206256c8247"],
 ". The available properties are given by ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"hg", "[", "\"\<Properties\>\"", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"a1a301cc-167f-7c4c-b538-e3f6f99470cc"],
 "."
}], "Notes",ExpressionUUID->"1fc74edc-6778-f14b-823c-bb9d1f916f4e"],

Cell["\<\
An invalid specification produces the message Hypergraph::spec and returns \
$Failed.\
\>", "Notes",ExpressionUUID->"10a5d114-8aa4-2947-90c6-a6ec59912cb4"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"7ef60b4c-0e84-5a46-bced-fb6a2935aa1e"],

Cell["From a list of edges; the vertex set is inferred:", "ExampleText",ExpressionUUID->"6e9fba46-00a3-8543-9279-c408cb0ac24f"],

Cell["\<\
Hypergraph[{Edge[{1, 2}], Edge[{2, 3}], Edge[{1, 2, 3}, \"Unordered\"]}]\
\>", "Input",ExpressionUUID->"850cf9f4-7551-1a41-98ea-a57c6faf707e"],

