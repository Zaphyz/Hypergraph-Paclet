Cell["\<\
A label given on one occurrence of a vertex propagates to the others:\
\>", "ExampleText",ExpressionUUID->"1889e7cf-a818-c841-b567-6141490910f7"],

Cell["\<\
InputForm @ Hypergraph[{Edge[{Vertex[1, \"a\"], 2}], Edge[{1, 3}]}]\
\>", "Input",ExpressionUUID->"af1e65fc-91b3-e649-b7d8-c2f4b737f508"],

Cell[BoxData[
 InterpretationBox[
  StyleBox[
   RowBox[{"Hypergraph", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Vertex", "[", "2", "]"}], ",", " ", 
       RowBox[{"Vertex", "[", "3", "]"}], ",", " ", 
       RowBox[{"Vertex", "[", 
        RowBox[{"1", ",", " ", "\"\<a\>\""}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Edge", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Vertex", "[", 
            RowBox[{"1", ",", " ", "\"\<a\>\""}], "]"}], ",", " ", 
           RowBox[{"Vertex", "[", "2", "]"}]}], "}"}], ",", 
         " ", "\"\<Directed\>\""}], "]"}], ",", " ", 
       RowBox[{"Edge", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Vertex", "[", 
            RowBox[{"1", ",", " ", "\"\<a\>\""}], "]"}], ",", " ", 
           RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", 
         " ", "\"\<Directed\>\""}], "]"}]}], "}"}]}], "]"}],
   ShowStringCharacters->True,
   NumberMarks->True],
  InputForm[
   WolframInstitute`Hypergraphs`Hypergraph[{
     WolframInstitute`Hypergraphs`Vertex[2], 
     WolframInstitute`Hypergraphs`Vertex[3], 
     WolframInstitute`Hypergraphs`Vertex[1, "a"]}, {
     WolframInstitute`Hypergraphs`Edge[{
       WolframInstitute`Hypergraphs`Vertex[1, "a"], 
       WolframInstitute`Hypergraphs`Vertex[2]}, "Directed"], 
     WolframInstitute`Hypergraphs`Edge[{
       WolframInstitute`Hypergraphs`Vertex[1, "a"], 
       WolframInstitute`Hypergraphs`Vertex[3]}, "Directed"]}]],
  AutoDelete->True,
  Editable->True]], "Output",ExpressionUUID->"aa4c2156-a9cd-6241-b8ad-\
19d45d80ef4f"],

Cell["Edge order carries no information, but multiplicity does:", \
"ExampleText",ExpressionUUID->"d2e64bc7-62f4-8e4f-84f4-863ff9534f82"],

Cell["\<\
{Hypergraph[{Edge[{1, 2}], Edge[{2, 3}]}] === Hypergraph[{Edge[{2, 3}], \
Edge[{1, 2}]}],
 EdgeCount[Hypergraph[{Edge[{1, 2}], Edge[{1, 2}]}]]}\
\>", "Input",ExpressionUUID->"901fd242-2aa6-2640-850f-2c1c85954679"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "2"}], "}"}]], "Output",ExpressionUUID->"47ef65ae-2aba-b74a-9f58-0d627ea15b1a"],

Cell["The standard graph functions apply directly:", "ExampleText",ExpressionUUID->"fc273319-b32d-2b41-a126-50825af9de5f"],

Cell["\<\
h = Hypergraph[{Vertex[1, \"a\"], Vertex[2, \"b\"], 3}, {{1, 2}, {2, 3}}];
{VertexCount[h], EdgeCount[h], VertexList[h]}\
\>", "Input",ExpressionUUID->"adbda031-a29c-cf49-b6d2-5d45e677929e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"3", ",", "2", ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Vertex", "[", "3", "]"}], ",", 
     RowBox[{"Vertex", "[", 
      RowBox[{"1", ",", "\<\"a\"\>"}], "]"}], ",", 
     RowBox[{"Vertex", "[", 
      RowBox[{"2", ",", "\<\"b\"\>"}], "]"}]}], "}"}]}], "}"}]], "Output",Expr\
essionUUID->"67c21b52-ceeb-5c4c-8406-707b66b502d4"],

Cell["The available properties:", "ExampleText",ExpressionUUID->"18848b7a-5dfe-6b40-8cac-511afbb3e31f"],

Cell["h[\"Properties\"]", "Input",ExpressionUUID->"3cd50062-8076-7f48-8db1-f634a6567183"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"VertexList\"\>", ",", "\<\"EdgeList\"\>", 
   ",", "\<\"VertexCount\"\>", ",", "\<\"EdgeCount\"\>", 
   ",", "\<\"VertexIDs\"\>", ",", "\<\"VertexLabels\"\>", 
   ",", "\<\"EdgeLabels\"\>", ",", "\<\"EdgeSymmetries\"\>", 
   ",", "\<\"Arity\"\>", ",", "\<\"Skeleton\"\>"}], "}"}]], "Output",Expressio\
nUUID->"01de8dc2-b968-e04e-ac2f-ccc7d6a29bc3"],

Cell["\<\
{h[\"VertexIDs\"], h[\"VertexLabels\"], h[\"Arity\"], h[\"EdgeSymmetries\"]}\
\>", "Input",ExpressionUUID->"694496e6-3a6b-414d-af33-92e87752b0aa"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"3", ",", "1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"None", ",", "\<\"a\"\>", ",", "\<\"b\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"Directed\"\>", ",", "\<\"Directed\"\>"}], "}"}]}], 
  "}"}]], "Output",ExpressionUUID->"5d5e9626-70b7-0c4d-bec2-e67ffd82eb2c"],

