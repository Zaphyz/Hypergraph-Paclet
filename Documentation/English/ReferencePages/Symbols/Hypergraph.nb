Cell["\<\
A label given on one occurrence of a vertex propagates to the others:\
\>", "ExampleText",ExpressionUUID->"15be3447-96ca-ef40-a4dd-68386ded7fe7"],

Cell["\<\
InputForm @ Hypergraph[{Edge[{Vertex[1, \"a\"], 2}], Edge[{1, 3}]}]\
\>", "Input",ExpressionUUID->"7fb2c758-596c-bf49-bf08-80d55f6f5bfc"],

Cell[BoxData[
 InterpretationBox[
  StyleBox[
   RowBox[{"Hypergraph", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Vertex", "[", "2", "]"}], ",", " ", 
       RowBox[{"Vertex", "[", "3", "]"}], ",", " ", 
       RowBox[{"Vertex", "[", 
        RowBox[{"1", ",", " ", "\"\<a\>\""}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Edge", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Vertex", "[", 
            RowBox[{"1", ",", " ", "\"\<a\>\""}], "]"}], ",", " ", 
           RowBox[{"Vertex", "[", "2", "]"}]}], "}"}], ",", 
         " ", "\"\<Directed\>\""}], "]"}], ",", " ", 
       RowBox[{"Edge", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Vertex", "[", 
            RowBox[{"1", ",", " ", "\"\<a\>\""}], "]"}], ",", " ", 
           RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", 
         " ", "\"\<Directed\>\""}], "]"}]}], "}"}]}], "]"}],
   ShowStringCharacters->True,
   NumberMarks->True],
  InputForm[
   WolframInstitute`Hypergraphs`Hypergraph[{
     WolframInstitute`Hypergraphs`Vertex[2], 
     WolframInstitute`Hypergraphs`Vertex[3], 
     WolframInstitute`Hypergraphs`Vertex[1, "a"]}, {
     WolframInstitute`Hypergraphs`Edge[{
       WolframInstitute`Hypergraphs`Vertex[1, "a"], 
       WolframInstitute`Hypergraphs`Vertex[2]}, "Directed"], 
