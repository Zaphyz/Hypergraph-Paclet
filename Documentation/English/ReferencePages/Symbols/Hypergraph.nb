4993f382907d"],

Cell["Edge order carries no information, but multiplicity does:", \
"ExampleText",ExpressionUUID->"d2fa709f-e05c-ed49-9a8b-d9299c6459f7"],

Cell["\<\
{Hypergraph[{Edge[{1, 2}], Edge[{2, 3}]}] === Hypergraph[{Edge[{2, 3}], \
Edge[{1, 2}]}],
 EdgeCount[Hypergraph[{Edge[{1, 2}], Edge[{1, 2}]}]]}\
\>", "Input",ExpressionUUID->"605d2731-db49-074f-b238-f8c9120004de"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "2"}], "}"}]], "Output",ExpressionUUID->"1cd5e64d-d2da-f04c-b329-9daa4c21d581"],

Cell["The standard graph functions apply directly:", "ExampleText",ExpressionUUID->"0cd01361-4eec-5e40-baea-46c47c721a06"],

Cell["\<\
h = Hypergraph[{Vertex[1, \"a\"], Vertex[2, \"b\"], 3}, {{1, 2}, {2, 3}}];
{VertexCount[h], EdgeCount[h], VertexList[h]}\
\>", "Input",ExpressionUUID->"6679aa27-2bba-b548-9524-a815554d4ca0"],

