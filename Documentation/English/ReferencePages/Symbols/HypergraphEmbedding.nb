Notebook[{
Cell["HypergraphEmbedding", "ObjectName",ExpressionUUID->"c88eba24-1ad7-3f45-9fb4-65dba2d3a830"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypergraphEmbedding", "[", "hg", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"45ad5218-f327-4646-9937-8f06eb9eec38"],
 " ",
 "gives the coordinates chosen for the vertices of hg, in the order of \
VertexList[hg]."
}], "Usage",ExpressionUUID->"42f7dbf8-34c0-5543-94c2-a5179fe11831"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"83295a51-6e27-994f-97f7-134fbdf77a28"],

Cell["\<\
The coordinates are those used by HypergraphPlot, and are obtained by laying \
out an auxiliary graph.\
\>", "Notes",ExpressionUUID->"0c05761d-f744-4d42-8faf-1f5d258863c5"],

Cell["\<\
Any option of HypergraphPlot may be given, and affects the embedding in the \
same way.\
\>", "Notes",ExpressionUUID->"94f12430-3a1e-bf41-b60c-5f28ea0b7eee"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"017450ed-02b1-9841-8d04-4d71a6f17004"],

Cell["HypergraphEmbedding[Hypergraph[{{1, 2}, {2, 3}}]]", "Input",ExpressionUUID->"d2ac4494-1624-254a-bcf9-73ed0615d8e7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0.`", ",", "3.6739403974420594`*^-16"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1.`", ",", "2.4492935982947064`*^-16"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2.`", ",", "0.`"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"68a2a220-622e-5f4e-91b7-8f7ae3c3ff9a"],

Cell["One coordinate per vertex, in the order of the vertex list:", \
"ExampleText",ExpressionUUID->"7834410c-d468-8547-bff7-7504ef0c3446"],

Cell["\<\
h = Hypergraph[{Edge[{1, 2, 3}, \"Unordered\"], Edge[{3, 4}]}];
Thread[h[\"VertexIDs\"] -> HypergraphEmbedding[h]]\
\>", "Input",ExpressionUUID->"d99a6482-ccae-a14c-ae20-7547e6953d85"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"1", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1.9987657369935588`", ",", "1.061628456550387`"}], "}"}]}], ",", 
   RowBox[{"2", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1.9987444371974448`", ",", "0.`"}], "}"}]}], ",", 
   RowBox[{"3", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1.256851436554468`", ",", "0.5308254495580791`"}], "}"}]}], ",", 
   RowBox[{"4", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0.`", ",", "0.530777583334723`"}], "}"}]}]}], "}"}]], "Output",E\
xpressionUUID->"f1ad2c14-2240-1c4f-9257-5931e5b09fb6"],

