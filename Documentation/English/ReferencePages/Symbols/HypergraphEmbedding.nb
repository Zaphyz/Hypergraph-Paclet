Notebook[{
Cell["HypergraphEmbedding", "ObjectName",ExpressionUUID->"0e12d597-29bc-c64d-a58f-eed225bcd8ac"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypergraphEmbedding", "[", "hg", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"7ceb5a0b-9c52-0c45-a148-52f88faae81a"],
 " ",
 "gives the coordinates chosen for the vertices of hg, in the order of \
VertexList[hg]."
}], "Usage",ExpressionUUID->"507041c6-eadf-f747-88da-d8415ba09882"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"5cec6b66-5e48-e946-bffe-5091982b4e63"],

Cell["\<\
The coordinates are those used by HypergraphPlot, and are obtained by laying \
out an auxiliary graph.\
\>", "Notes",ExpressionUUID->"5159ed05-a5ea-4b4f-8a1a-b6aff7ea51ab"],

Cell["\<\
Any option of HypergraphPlot may be given, and affects the embedding in the \
same way.\
\>", "Notes",ExpressionUUID->"4a0871db-826d-124f-96f1-e91ce13f8711"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"45f00e30-1959-024a-8b91-a354970a96a7"],

Cell["HypergraphEmbedding[Hypergraph[{{1, 2}, {2, 3}}]]", "Input",ExpressionUUID->"fde539d3-04fe-bc4f-900a-32226ebb28ea"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0.`", ",", "3.6739403974420594`*^-16"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1.`", ",", "2.4492935982947064`*^-16"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2.`", ",", "0.`"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"9601f2f1-7f8c-5149-af28-dc8081fdc8df"],

Cell["One coordinate per vertex, in the order of the vertex list:", \
"ExampleText",ExpressionUUID->"fbbf361a-12a5-3c48-83c2-77d7a70b784c"],

Cell["\<\
h = Hypergraph[{Edge[{1, 2, 3}, \"Unordered\"], Edge[{3, 4}]}];
Thread[h[\"VertexIDs\"] -> HypergraphEmbedding[h]]\
\>", "Input",ExpressionUUID->"0df91c4d-0bbd-2247-805b-9ad7940ac1da"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"1", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1.9987657369935588`", ",", "1.061628456550387`"}], "}"}]}], ",", 
   RowBox[{"2", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1.9987444371974448`", ",", "0.`"}], "}"}]}], ",", 
   RowBox[{"3", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1.256851436554468`", ",", "0.5308254495580791`"}], "}"}]}], ",", 
   RowBox[{"4", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0.`", ",", "0.530777583334723`"}], "}"}]}]}], "}"}]], "Output",E\
xpressionUUID->"b43451e0-bf38-2944-98b6-94e56c0403ac"],

Cell["Source", "NotesSection",ExpressionUUID->"d6cb837c-4789-c644-8992-26f2fc05a272"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/HypergraphPlot.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
