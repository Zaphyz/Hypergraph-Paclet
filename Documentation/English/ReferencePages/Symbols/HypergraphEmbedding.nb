Notebook[{
Cell["HypergraphEmbedding", "ObjectName",ExpressionUUID->"e702a4b9-6348-9d48-a3f8-9149d1181b7f"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypergraphEmbedding", "[", "hg", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"da74827c-448c-9542-8c3f-05a619df843b"],
 " ",
 "gives the coordinates chosen for the vertices of hg, in the order of \
VertexList[hg]."
}], "Usage",ExpressionUUID->"18e45383-368c-6047-946f-90b3aeb9b37b"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"a2d2b09f-9e86-dc42-be46-c7a02f7717aa"],

Cell["\<\
The coordinates are those used by HypergraphPlot, and are obtained by laying \
out an auxiliary graph.\
\>", "Notes",ExpressionUUID->"011032bd-3465-8745-a7c6-d252d5dbbba7"],

Cell["\<\
Any option of HypergraphPlot may be given, and affects the embedding in the \
same way.\
\>", "Notes",ExpressionUUID->"c9036037-d1d3-1b4a-8e37-983e0cc26e1c"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"3ce6a5e7-bcd6-284e-a469-570824ce16ad"],

Cell["HypergraphEmbedding[Hypergraph[{{1, 2}, {2, 3}}]]", "Input",ExpressionUUID->"7d689970-7c39-b34c-be5e-2908baff001e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0.`", ",", "3.6739403974420594`*^-16"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1.`", ",", "2.4492935982947064`*^-16"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2.`", ",", "0.`"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"0793557e-3eb8-9241-8ab3-1f4a5583187d"],

Cell["One coordinate per vertex, in the order of the vertex list:", \
"ExampleText",ExpressionUUID->"a1c13202-046c-ab47-b447-4280b02b90f8"],

Cell["\<\
h = Hypergraph[{Edge[{1, 2, 3}, \"Unordered\"], Edge[{3, 4}]}];
Thread[h[\"VertexIDs\"] -> HypergraphEmbedding[h]]\
\>", "Input",ExpressionUUID->"e2111acb-a0d2-694f-a258-30a587e848d1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"1", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1.9987657369935588`", ",", "1.061628456550387`"}], "}"}]}], ",", 
   RowBox[{"2", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1.9987444371974448`", ",", "0.`"}], "}"}]}], ",", 
   RowBox[{"3", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1.256851436554468`", ",", "0.5308254495580791`"}], "}"}]}], ",", 
   RowBox[{"4", "\[Rule]", 
