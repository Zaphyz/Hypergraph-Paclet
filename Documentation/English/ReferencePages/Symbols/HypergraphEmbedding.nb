Notebook[{
Cell["HypergraphEmbedding", "ObjectName",ExpressionUUID->"93679a47-980c-4a40-9e57-f61c002eaaea"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypergraphEmbedding", "[", "hg", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"cc83435d-d36e-9a48-a253-c8d58402025b"],
 " ",
 "gives the coordinates chosen for the vertices of hg, in the order of \
VertexList[hg]."
}], "Usage",ExpressionUUID->"c4f2c4fc-6524-da4a-b152-c680a4a261a7"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"e6977d6d-5115-4243-91bf-a8d3a83864cc"],

Cell["\<\
The coordinates are those used by HypergraphPlot, and are obtained by laying \
out an auxiliary graph.\
\>", "Notes",ExpressionUUID->"7ed86e6e-fb78-1e4d-8281-4f0acf8663db"],

Cell["\<\
Any option of HypergraphPlot may be given, and affects the embedding in the \
same way.\
\>", "Notes",ExpressionUUID->"d276f081-580b-4a41-a8bd-070fdf89fa48"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"96b3357f-0119-e342-9a56-e5854ed9e59d"],

Cell["HypergraphEmbedding[Hypergraph[{{1, 2}, {2, 3}}]]", "Input",ExpressionUUID->"e2b2ebb3-b146-6542-96c6-b4fcdec6f70c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0.`", ",", "3.6739403974420594`*^-16"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1.`", ",", "2.4492935982947064`*^-16"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2.`", ",", "0.`"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"d4787742-3c6d-ce48-bfe0-c6be4765ded3"],

Cell["One coordinate per vertex, in the order of the vertex list:", \
"ExampleText",ExpressionUUID->"de2dce85-ecb6-9149-9740-7771a4773ef6"],

Cell["\<\
h = Hypergraph[{Edge[{1, 2, 3}, \"Unordered\"], Edge[{3, 4}]}];
Thread[h[\"VertexIDs\"] -> HypergraphEmbedding[h]]\
\>", "Input",ExpressionUUID->"5c28844c-6dd5-944d-8260-939d84d2bbf6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"1", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1.9987657369935588`", ",", "1.061628456550387`"}], "}"}]}], ",", 
   RowBox[{"2", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1.9987444371974448`", ",", "0.`"}], "}"}]}], ",", 
   RowBox[{"3", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1.256851436554468`", ",", "0.5308254495580791`"}], "}"}]}], ",", 
   RowBox[{"4", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0.`", ",", "0.530777583334723`"}], "}"}]}]}], "}"}]], "Output",E\
xpressionUUID->"ffb2a270-6dd7-4d4e-930a-a71e196ac73f"],

