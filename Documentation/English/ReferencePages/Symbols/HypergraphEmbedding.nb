Notebook[{
Cell["HypergraphEmbedding", "ObjectName",ExpressionUUID->"61526a61-47bb-6e44-9881-ff75937ab22e"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypergraphEmbedding", "[", "hg", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"8a81e1c4-d7b7-a84c-8621-e0e1113aa581"],
 " ",
 "gives the coordinates chosen for the vertices of hg, in the order of \
VertexList[hg]."
}], "Usage",ExpressionUUID->"ce58c892-56e3-b84b-baf6-fed234818444"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"bbf2b22c-03d8-6941-bde9-54e718668cd7"],

Cell["\<\
The coordinates are those used by HypergraphPlot, and are obtained by laying \
out an auxiliary graph.\
\>", "Notes",ExpressionUUID->"3b04e6cb-4a02-af44-8769-b065e0af5327"],

Cell["\<\
Any option of HypergraphPlot may be given, and affects the embedding in the \
same way.\
\>", "Notes",ExpressionUUID->"de0d7ebf-7aec-394e-9303-1dc1dd862d65"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"a2ffb5bf-2770-0a41-bf4e-0ad41bf62fff"],

Cell["HypergraphEmbedding[Hypergraph[{{1, 2}, {2, 3}}]]", "Input",ExpressionUUID->"1074e25a-4a3d-514f-a1e6-bf65e2e15fb6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0.`", ",", "3.6739403974420594`*^-16"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1.`", ",", "2.4492935982947064`*^-16"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2.`", ",", "0.`"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"a12afdd0-0025-d341-a4cb-6557f5fec5d4"],

Cell["One coordinate per vertex, in the order of the vertex list:", \
"ExampleText",ExpressionUUID->"06616609-70ff-b54c-b6ec-4f8104084b73"],

Cell["\<\
h = Hypergraph[{Edge[{1, 2, 3}, \"Unordered\"], Edge[{3, 4}]}];
Thread[h[\"VertexIDs\"] -> HypergraphEmbedding[h]]\
\>", "Input",ExpressionUUID->"c5e532d1-bbae-ef44-9008-94b07d040e1d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"1", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1.9987657369935588`", ",", "1.061628456550387`"}], "}"}]}], ",", 
   RowBox[{"2", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1.9987444371974448`", ",", "0.`"}], "}"}]}], ",", 
   RowBox[{"3", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1.256851436554468`", ",", "0.5308254495580791`"}], "}"}]}], ",", 
   RowBox[{"4", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0.`", ",", "0.530777583334723`"}], "}"}]}]}], "}"}]], "Output",E\
xpressionUUID->"022b53b8-f782-7549-9a09-2be419eef23b"],

