Notebook[{
Cell["HypergraphEmbedding", "ObjectName",ExpressionUUID->"b1a088ff-3faa-8944-aabb-f6dd9348480a"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypergraphEmbedding", "[", "hg", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"caea2eaa-7778-9e41-8f67-bf095d5d3319"],
 " ",
 "gives the coordinates chosen for the vertices of hg, in the order of \
VertexList[hg]."
}], "Usage",ExpressionUUID->"2382add5-2958-6940-aad0-659a15196fc7"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"091c7ca1-2e6d-3f4e-9c9f-4e5155fced6a"],

Cell["\<\
The coordinates are those used by HypergraphPlot, and are obtained by laying \
out an auxiliary graph.\
\>", "Notes",ExpressionUUID->"00cf000e-b06f-f844-8171-a01eb02d4aff"],

Cell["\<\
Any option of HypergraphPlot may be given, and affects the embedding in the \
same way.\
\>", "Notes",ExpressionUUID->"dc9bb314-e05f-7743-9f4b-876773f7c6bd"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"54d1c9b4-a823-ed46-a601-16808b4b27f4"],

Cell["HypergraphEmbedding[Hypergraph[{{1, 2}, {2, 3}}]]", "Input",ExpressionUUID->"b7a8b77e-1039-dd4c-b71a-baa5f2bce7ad"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0.`", ",", "3.6739403974420594`*^-16"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1.`", ",", "2.4492935982947064`*^-16"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2.`", ",", "0.`"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"28ed3545-16a9-4b41-a634-f40748160b8a"],

Cell["One coordinate per vertex, in the order of the vertex list:", \
"ExampleText",ExpressionUUID->"3dd8bacb-5bfc-aa45-98e1-f5e4f6ec5b94"],

Cell["\<\
h = Hypergraph[{Edge[{1, 2, 3}, \"Unordered\"], Edge[{3, 4}]}];
Thread[h[\"VertexIDs\"] -> HypergraphEmbedding[h]]\
\>", "Input",ExpressionUUID->"b64bae1c-f1cc-1346-b451-e985f904ae2b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"1", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1.9987657369935588`", ",", "1.061628456550387`"}], "}"}]}], ",", 
   RowBox[{"2", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1.9987444371974448`", ",", "0.`"}], "}"}]}], ",", 
   RowBox[{"3", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1.256851436554468`", ",", "0.5308254495580791`"}], "}"}]}], ",", 
   RowBox[{"4", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0.`", ",", "0.530777583334723`"}], "}"}]}]}], "}"}]], "Output",E\
xpressionUUID->"f77f6256-4309-bb47-95ce-47cdf09bee16"],

