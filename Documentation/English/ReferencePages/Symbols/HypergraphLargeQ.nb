Notebook[{
Cell["HypergraphLargeQ", "ObjectName",ExpressionUUID->"ab794bbf-0af5-3244-9f60-54317981f7b8"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypergraphLargeQ", "[", "hg", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"ce4d555f-4bad-0440-abf4-31649b5402e9"],
 " ",
 "gives True when hg is big enough that it displays as a summary box instead \
of a plot."
}], "Usage",ExpressionUUID->"2893bf17-253e-a94a-8d51-47751d6d1e59"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"0f591cea-6fbe-1a4f-88f0-069492ac8ea2"],

Cell["\<\
The thresholds are \"MaxVertices\" (32), \"MaxEdges\" (128) and \
\"MaxTotalElements\" (196), and are changed with SetHypergraphPlotThresholds.\
\
\>", "Notes",ExpressionUUID->"c3026240-2066-664e-a480-ae1e45994421"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"055398ed-d579-2e4b-a9f2-b5935021ba08"],

Cell["\<\
{HypergraphLargeQ[Hypergraph[{{1, 2}}]], \
HypergraphLargeQ[Hypergraph[Table[Edge[{i, i + 1}], {i, 40}]]]}\
\>", "Input",ExpressionUUID->"0883d432-fd74-b34a-be77-0dff01797eec"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "True"}], "}"}]], "Output",ExpressionUUID->"bebc4bce-\
c3a3-d542-8fe0-7284a7f407a2"],

