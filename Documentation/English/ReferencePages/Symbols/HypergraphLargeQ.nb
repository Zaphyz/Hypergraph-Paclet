Notebook[{
Cell["HypergraphLargeQ", "ObjectName",ExpressionUUID->"281c5bea-f746-7d4a-99d9-a433c4e93668"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypergraphLargeQ", "[", "hg", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"96fa556f-4d19-7d40-85d2-5ad48de496ff"],
 " ",
 "gives True when hg is big enough that it displays as a summary box instead \
of a plot."
}], "Usage",ExpressionUUID->"a43d006f-226b-7a45-81ea-06172961dda3"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"de6ffeb9-eaed-dd41-94ea-4342f1f31824"],

Cell["\<\
The thresholds are \"MaxVertices\" (32), \"MaxEdges\" (128) and \
\"MaxTotalElements\" (196), and are changed with SetHypergraphPlotThresholds.\
\
\>", "Notes",ExpressionUUID->"5fdbb75e-790e-1042-a9d5-7930f76d42c6"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"a0a6726e-6c14-1b42-9156-df0ff97af7b5"],

Cell["\<\
{HypergraphLargeQ[Hypergraph[{{1, 2}}]], \
HypergraphLargeQ[Hypergraph[Table[Edge[{i, i + 1}], {i, 40}]]]}\
\>", "Input",ExpressionUUID->"7b6eb7d7-e7d2-4c43-9aee-f04306242991"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "True"}], "}"}]], "Output",ExpressionUUID->"5b24d922-\
3a6c-c342-8394-f405bd8f9094"],

Cell["A large hypergraph displays as a summary box:", "ExampleText",ExpressionUUID->"6563e648-6b1c-2242-b503-cb935d130d0b"],

