Notebook[{
Cell["HypergraphLargeQ", "ObjectName",ExpressionUUID->"f206715e-ed56-6a42-8db4-3af138c3a3c0"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypergraphLargeQ", "[", "hg", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"f3dfbb48-b3c7-6f4f-be84-842c87659003"],
 " ",
 "gives True when hg is big enough that it displays as a summary box instead \
of a plot."
}], "Usage",ExpressionUUID->"a1c1d721-bc40-0249-8e53-e6ed7bdcbfd6"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"248d39fb-c08a-594e-bc87-86a7a5fab6cb"],

Cell["\<\
The thresholds are \"MaxVertices\" (32), \"MaxEdges\" (128) and \
\"MaxTotalElements\" (196), and are changed with SetHypergraphPlotThresholds.\
\
\>", "Notes",ExpressionUUID->"894ac5f6-c260-0946-968b-1f982a39b9c8"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"7db985a4-b2f9-da47-ac97-5eba86f1d58c"],

Cell["\<\
{HypergraphLargeQ[Hypergraph[{{1, 2}}]], \
HypergraphLargeQ[Hypergraph[Table[Edge[{i, i + 1}], {i, 40}]]]}\
\>", "Input",ExpressionUUID->"f0f76d45-9bd0-874b-a6d9-c01a01c0d15d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "True"}], "}"}]], "Output",ExpressionUUID->"e37d9673-\
b3b5-ce42-ad96-bf98f38a2920"],

