Notebook[{
Cell["HypergraphLargeQ", "ObjectName",ExpressionUUID->"c9c12ed5-090a-ac46-9c42-6ece9e3108c9"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypergraphLargeQ", "[", "hg", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"22739bbc-92b2-8f48-8cf6-16f1a91c6738"],
 " ",
 "gives True when hg is big enough that it displays as a summary box instead \
of a plot."
}], "Usage",ExpressionUUID->"c7817c44-e4fc-554b-9ead-ecb520b0df24"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"4ed3eec4-4ca5-0542-99f4-a2d6c69346ae"],

Cell["\<\
The thresholds are \"MaxVertices\" (32), \"MaxEdges\" (128) and \
\"MaxTotalElements\" (196), and are changed with SetHypergraphPlotThresholds.\
\
\>", "Notes",ExpressionUUID->"e7eac4b8-7358-7141-88a7-b581bbead3bd"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"7ba68b53-7329-c445-a688-112a795e53cc"],

Cell["\<\
{HypergraphLargeQ[Hypergraph[{{1, 2}}]], \
HypergraphLargeQ[Hypergraph[Table[Edge[{i, i + 1}], {i, 40}]]]}\
\>", "Input",ExpressionUUID->"8f910c7c-556f-ce4b-a0fa-f31dfa8f851b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "True"}], "}"}]], "Output",ExpressionUUID->"82f03d8e-\
7b54-834e-ad53-b566b323f56e"],

