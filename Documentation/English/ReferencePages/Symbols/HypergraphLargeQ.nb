Notebook[{
Cell["HypergraphLargeQ", "ObjectName",ExpressionUUID->"3fd43c4e-7a92-6943-9a8e-831cead2b1b5"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypergraphLargeQ", "[", "hg", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"cc033d76-c9c4-1f4a-b9dc-5b4958d5bdd3"],
 " ",
 "gives True when hg is big enough that it displays as a summary box instead \
of a plot."
}], "Usage",ExpressionUUID->"26ad5afa-4728-2148-8fa9-ac81666958e2"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"50fd0a0c-0ff1-2244-957f-34b1c01c091a"],

Cell["\<\
The thresholds are \"MaxVertices\" (32), \"MaxEdges\" (128) and \
\"MaxTotalElements\" (196), and are changed with SetHypergraphPlotThresholds.\
\
\>", "Notes",ExpressionUUID->"a5d4df14-f4a1-3d4d-8982-254e1e82e48f"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"2a98ff9a-7bc6-0b43-bef5-36ece65f7e51"],

Cell["\<\
{HypergraphLargeQ[Hypergraph[{{1, 2}}]], \
HypergraphLargeQ[Hypergraph[Table[Edge[{i, i + 1}], {i, 40}]]]}\
\>", "Input",ExpressionUUID->"92750516-a296-2e48-8a67-5711a69bb257"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "True"}], "}"}]], "Output",ExpressionUUID->"c16f9bd5-\
424f-0e46-9fe5-eedf3231707d"],

