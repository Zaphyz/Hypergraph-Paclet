Notebook[{
Cell["HypergraphLargeQ", "ObjectName",ExpressionUUID->"da489037-9692-8b4c-990c-292f9facaef0"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypergraphLargeQ", "[", "hg", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"b78f7919-8227-bd4a-8843-d449c2d90a70"],
 " ",
 "gives True when hg is big enough that it displays as a summary box instead \
of a plot."
}], "Usage",ExpressionUUID->"7d7b0f02-5b54-1846-b04e-1c9dd47e6ea5"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"c6a2bc6b-19c1-6043-ba13-432c9e18ce38"],

Cell["\<\
The thresholds are \"MaxVertices\" (32), \"MaxEdges\" (128) and \
\"MaxTotalElements\" (196), and are changed with SetHypergraphPlotThresholds.\
\
\>", "Notes",ExpressionUUID->"6bdabb68-60b0-4544-9e64-17eb8d7b2ce4"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"3d23d879-e2f1-0949-a27e-c4ac3d7fb050"],

Cell["\<\
{HypergraphLargeQ[Hypergraph[{{1, 2}}]], \
HypergraphLargeQ[Hypergraph[Table[Edge[{i, i + 1}], {i, 40}]]]}\
\>", "Input",ExpressionUUID->"da3c5db2-531e-b241-a2dc-ccef8353cf03"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "True"}], "}"}]], "Output",ExpressionUUID->"cf40d000-\
6871-2b42-996b-3bacf4f00a00"],

