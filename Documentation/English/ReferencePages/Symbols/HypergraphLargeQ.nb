Notebook[{
Cell["HypergraphLargeQ", "ObjectName",ExpressionUUID->"7716aead-2be9-0548-97f5-525d85d07ad3"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypergraphLargeQ", "[", "hg", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"02bdd551-8d8e-e34b-8832-3b2695039f1b"],
 " ",
 "gives True when hg is big enough that it displays as a summary box instead \
of a plot."
}], "Usage",ExpressionUUID->"5103274d-4cd2-0f42-ac81-74b1d25e6246"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"1b0b36d4-9fc5-e145-864f-1b81b3a1a160"],

Cell["\<\
The thresholds are \"MaxVertices\" (32), \"MaxEdges\" (128) and \
\"MaxTotalElements\" (196), and are changed with SetHypergraphPlotThresholds.\
\
\>", "Notes",ExpressionUUID->"59ef239d-a7df-9e42-bde7-9892d0c3eaa3"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"d970fd8e-925e-ef42-b24c-0320e52566ec"],

Cell["\<\
{HypergraphLargeQ[Hypergraph[{{1, 2}}]], \
HypergraphLargeQ[Hypergraph[Table[Edge[{i, i + 1}], {i, 40}]]]}\
\>", "Input",ExpressionUUID->"75fa28a5-296b-d645-b202-5c84d43c6e95"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "True"}], "}"}]], "Output",ExpressionUUID->"9d1b7929-\
8d33-154a-98b0-856432417a49"],

