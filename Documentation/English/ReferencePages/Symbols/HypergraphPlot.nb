Cell["The three symmetry types side by side:", "ExampleText",ExpressionUUID->"e78a6576-dc6c-104f-ba44-0f05813cbd8d"],

Cell["\<\
Grid[{{\"Directed\", \"Unordered\", \"Cyclic\"},
      HypergraphPlot[Hypergraph[{Edge[{1, 2, 3, 4}, #]}], ImageSize -> 150] & \
/@
        {\"Directed\", \"Unordered\", \"Cyclic\"}}, Frame -> All, Alignment \
-> Center]\
\>", "Input",ExpressionUUID->"f2afb428-4fea-4846-96b8-5154c8d9b634"],

