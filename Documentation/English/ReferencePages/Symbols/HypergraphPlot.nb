Cell["The three symmetry types side by side:", "ExampleText",ExpressionUUID->"e70bc38a-8874-984f-94fc-ce699d15c766"],

Cell["\<\
Grid[{{\"Directed\", \"Unordered\", \"Cyclic\"},
      HypergraphPlot[Hypergraph[{Edge[{1, 2, 3, 4}, #]}], ImageSize -> 150] & \
/@
        {\"Directed\", \"Unordered\", \"Cyclic\"}}, Frame -> All, Alignment \
-> Center]\
\>", "Input",ExpressionUUID->"b093f439-611c-4242-a5e3-a155aaa42586"],

