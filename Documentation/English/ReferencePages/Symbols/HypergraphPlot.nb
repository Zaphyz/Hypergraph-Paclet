Cell["The three symmetry types side by side:", "ExampleText",ExpressionUUID->"9d784e2c-7465-cf41-ade9-a43a61663bea"],

Cell["\<\
Grid[{{\"Directed\", \"Unordered\", \"Cyclic\"},
      HypergraphPlot[Hypergraph[{Edge[{1, 2, 3, 4}, #]}], ImageSize -> 150] & \
/@
        {\"Directed\", \"Unordered\", \"Cyclic\"}}, Frame -> All, Alignment \
-> Center]\
\>", "Input",ExpressionUUID->"384c6c66-d0fa-1c43-97ff-2ddccd367c6e"],

