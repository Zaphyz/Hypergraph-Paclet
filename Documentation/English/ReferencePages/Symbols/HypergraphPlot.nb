Notebook[{
Cell["HypergraphPlot", "ObjectName",ExpressionUUID->"44523cf2-ca99-c84c-b6b0-bb1a509694aa"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypergraphPlot", "[", "hg", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"9bdda668-3b58-ad45-af90-3ceba37c2da2"],
 " ",
 "draws the hypergraph hg."
}], "Usage",ExpressionUUID->"75d044d4-1c38-524a-b1cc-5cd841fa1c38"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"afbd7bb2-3728-c048-b624-4c0d5af02954"],

Cell["\<\
A Hypergraph displays as this plot by default, the way a Graph does, so \
HypergraphPlot is needed only to pass options.\
\>", "Notes",ExpressionUUID->"89890a9a-bf94-7e4a-92a3-a8ab43d280a2"],

Cell["\<\
Binary edges are drawn as arcs, and edges of arity three and above as filled \
concave polygons through their vertices. An edge of arity one is drawn as a \
disk and an edge of arity zero as a circle.\
\>", "Notes",ExpressionUUID->"52749c21-bebf-1842-b679-5d2ce2f89cca"],

Cell["\<\
The symmetry type of each edge is visible: a directed edge carries arrowheads \
running along it, an unordered edge carries none, and a cyclic edge is marked \
with a small circular arrow at its centre, drawn wider so as to encircle the \
edge's label when it has one.\
\>", "Notes",ExpressionUUID->"b8633853-c448-e84a-92f7-c3ab25473610"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"VertexLabels", " ", "->", " ", "Automatic"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"945a0595-ce0d-a045-bed9-b636b6456b3b"],
 " (the default) each vertex shows its label if it has one and its identifier \
otherwise. ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"VertexLabels", " ", "->", " ", "None"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"2283d868-23cb-3641-8a32-8d7c90d36b31"],
 " turns them off, ",
 Cell[BoxData[
  StyleBox["\"\<Name\>\"", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "10fc9dc6-e4e6-9a4f-b8a1-4899d74d1dc9"],
 " always shows the identifier and ",
 Cell[BoxData[
  StyleBox["\"\<Label\>\"", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "7025b3d2-a72b-0141-82b4-ba6634df2b39"],
 " always the label."
}], "Notes",ExpressionUUID->"f47a97e9-2e03-c348-ad0c-e9ec6ff59031"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"EdgeLabels", " ", "->", " ", "Automatic"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"6da13598-5c27-104e-b0ab-363b3a80711f"],
 " (the default) shows each edge's label where it has one; ",
 Cell[BoxData[
  StyleBox["\"\<Name\>\"", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "84ad8a55-5e26-1845-983a-9e1c24427c1a"],
 " shows the edge's vertex identifiers instead."
}], "Notes",ExpressionUUID->"81a6fdf8-69a5-1640-8357-0e0124a52b57"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"\"\<EdgeArrows\>\"", " ", "->", " ", "True"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"0c0670f9-fd45-cf4e-9ec8-15557e624e82"],
 " puts arrowheads on every edge whatever its symmetry type, and ",
 Cell[BoxData[
  StyleBox["False", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "8537fe75-3dec-4745-9d84-ec0bdd5047a5"],
 " on none. ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"\"\<CyclicBadges\>\"", " ", "->", " ", "False"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"824d7054-daec-eb46-a805-14eca323918f"],
 " suppresses the circular arrows."
}], "Notes",ExpressionUUID->"abb3ebcb-580a-0b45-ad3b-9a4e30cd16a6"],

Cell["\<\
The layout, colour palette and edge rendering follow the \
WolframInstitute/Hypergraph paclet.\
\>", "Notes",ExpressionUUID->"5a3a52a7-6b3e-7c4d-b737-59da478bab7b"],

Cell["All Graphics options are accepted.", "Notes",ExpressionUUID->"bc145803-dea7-1840-8bc6-d9f78551e532"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"45ddb0a2-e41b-8c46-b475-9b20b0ee3375"],

Cell["Edges of mixed arity and symmetry type:", "ExampleText",ExpressionUUID->"8e13728f-8de6-bc4a-a61e-22e19d708a35"],

Cell["\<\
HypergraphPlot[Hypergraph[{Edge[{1, 2, 3}, \"Unordered\"], Edge[{3, 4}],
                            Edge[{1, 4, 5}, \"Cyclic\"]}], ImageSize -> 300]\
\>", "Input",ExpressionUUID->"8c6bb11c-88f0-f24d-b7d5-d537809db99f"],

