Notebook[{
Cell["HypergraphPlot", "ObjectName",ExpressionUUID->"a29a3560-a242-f749-bd11-fab7cfe9d0ae"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypergraphPlot", "[", "hg", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"45472723-485b-0a4d-844f-c786ad174733"],
 " ",
 "draws the hypergraph hg."
}], "Usage",ExpressionUUID->"91641db0-5e89-734f-a574-b5b0693d5ffe"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"72f33331-d3b9-2747-9437-99ae28ff2c5c"],

Cell["\<\
A Hypergraph displays as this plot by default, the way a Graph does, so \
HypergraphPlot is needed only to pass options.\
\>", "Notes",ExpressionUUID->"2dd0613d-23e7-714f-87b9-3b92108c55f0"],

Cell["\<\
Binary edges are drawn as arcs, and edges of arity three and above as filled \
concave polygons through their vertices. An edge of arity one is drawn as a \
disk and an edge of arity zero as a circle.\
\>", "Notes",ExpressionUUID->"80a7419d-00ec-7449-ac9d-b2e14dc3da04"],

Cell["\<\
The symmetry type of each edge is visible: a directed edge carries arrowheads \
running along it, an unordered edge carries none, and a cyclic edge is marked \
with a small circular arrow at its centre, drawn wider so as to encircle the \
edge's label when it has one.\
\>", "Notes",ExpressionUUID->"41c3e1d0-ac88-164a-a1d1-8f6facabd7d0"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"VertexLabels", " ", "->", " ", "Automatic"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"d82d7519-2241-5c4d-93e8-e0007ef641ef"],
 " (the default) each vertex shows its label if it has one and its identifier \
otherwise. ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"VertexLabels", " ", "->", " ", "None"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"64f210f7-b31c-394e-9780-789d9dadd40e"],
 " turns them off, ",
 Cell[BoxData[
  StyleBox["\"\<Name\>\"", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "38d1c6bb-0b38-1e4f-9cb0-a5c78e06da76"],
 " always shows the identifier and ",
 Cell[BoxData[
  StyleBox["\"\<Label\>\"", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "a1babfd2-b4ad-3b40-a544-745f38da9755"],
 " always the label."
}], "Notes",ExpressionUUID->"1f82ca9c-aa90-e34b-9035-fcaa8568c12c"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"EdgeLabels", " ", "->", " ", "Automatic"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"2874e45d-9ca6-994c-bd20-731c752d6863"],
 " (the default) shows each edge's label where it has one; ",
 Cell[BoxData[
  StyleBox["\"\<Name\>\"", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "e439b0bd-b137-854a-92e7-d3e2ff560a7d"],
 " shows the edge's vertex identifiers instead."
}], "Notes",ExpressionUUID->"b667a49e-575e-954f-bc99-e3e3666bf706"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"\"\<EdgeArrows\>\"", " ", "->", " ", "True"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"97311ea9-36a8-3b4a-a4b7-69e2c943c7bd"],
 " puts arrowheads on every edge whatever its symmetry type, and ",
 Cell[BoxData[
  StyleBox["False", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "a8a8c723-4757-514f-b269-7815b0685200"],
 " on none. ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"\"\<CyclicBadges\>\"", " ", "->", " ", "False"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"5436b9b4-d048-f34f-ace4-e5317748391b"],
 " suppresses the circular arrows."
}], "Notes",ExpressionUUID->"5135e069-0e11-c84c-964e-6150b76d5b50"],

Cell["\<\
The layout, colour palette and edge rendering follow the \
WolframInstitute/Hypergraph paclet.\
\>", "Notes",ExpressionUUID->"88830355-7227-7b46-8b7d-af966aca101e"],

Cell["All Graphics options are accepted.", "Notes",ExpressionUUID->"a4564fdd-69de-2f41-8d27-5aec46f97816"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"c74d9554-05b7-8242-92b1-ed1ce6dfd03a"],

Cell["Edges of mixed arity and symmetry type:", "ExampleText",ExpressionUUID->"476b7cba-025d-d34f-9fe2-a13fb58766a3"],

Cell["\<\
HypergraphPlot[Hypergraph[{Edge[{1, 2, 3}, \"Unordered\"], Edge[{3, 4}],
                            Edge[{1, 4, 5}, \"Cyclic\"]}], ImageSize -> 300]\
\>", "Input",ExpressionUUID->"ce86e3a1-aa0f-e942-9415-77ac203a16d1"],

