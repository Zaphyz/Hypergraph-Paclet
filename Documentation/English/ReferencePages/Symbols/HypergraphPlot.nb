Notebook[{
Cell["HypergraphPlot", "ObjectName",ExpressionUUID->"20a2b334-88aa-8b49-a416-353f605e855f"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypergraphPlot", "[", "hg", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"ff396f27-4aa4-4846-ae44-914097d84369"],
 " ",
 "draws the hypergraph hg."
}], "Usage",ExpressionUUID->"fa18ea48-4f61-c94d-b75d-d229fb575fa2"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"b7fd4733-7ec9-ee40-ae2c-1c95df42292a"],

Cell["\<\
A Hypergraph displays as this plot by default, the way a Graph does, so \
HypergraphPlot is needed only to pass options.\
\>", "Notes",ExpressionUUID->"003119f0-962e-6643-b911-4c1d8a7f78c3"],

Cell["\<\
Binary edges are drawn as arcs, and edges of arity three and above as filled \
concave polygons through their vertices. An edge of arity one is drawn as a \
disk and an edge of arity zero as a circle.\
\>", "Notes",ExpressionUUID->"5748182d-c29f-5743-baad-9e08f057c1cc"],

Cell["\<\
The symmetry type of each edge is visible: a directed edge carries arrowheads \
running along it, an unordered edge carries none, and a cyclic edge is marked \
with a small circular arrow at its centre, drawn wider so as to encircle the \
edge's label when it has one.\
\>", "Notes",ExpressionUUID->"8a5830bb-a400-5c43-9c31-2125de29a6d2"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"VertexLabels", " ", "->", " ", "Automatic"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"3c170c67-a50c-f84a-a561-417dc605f092"],
 " (the default) each vertex shows its label if it has one and its identifier \
otherwise. ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"VertexLabels", " ", "->", " ", "None"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"67af4caa-dc15-684f-831e-b7e3fa844df4"],
 " turns them off, ",
 Cell[BoxData[
  StyleBox["\"\<Name\>\"", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "724ad1d4-6082-0c42-8073-1fea38892602"],
 " always shows the identifier and ",
 Cell[BoxData[
  StyleBox["\"\<Label\>\"", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "32b65b3f-693a-f041-9da2-9447dcb20a42"],
 " always the label."
}], "Notes",ExpressionUUID->"576b3221-b321-bf46-a3e6-e373deb7466b"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"EdgeLabels", " ", "->", " ", "Automatic"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"52ebeafc-b8da-dc4c-8878-6853cb3983b3"],
 " (the default) shows each edge's label where it has one; ",
 Cell[BoxData[
  StyleBox["\"\<Name\>\"", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "3364cf90-96a8-9d47-910f-b119a59f2601"],
 " shows the edge's vertex identifiers instead."
}], "Notes",ExpressionUUID->"62628bbd-f6ed-5849-9582-6e70398fdbb9"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"\"\<EdgeArrows\>\"", " ", "->", " ", "True"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"d9a497ad-0e49-fd4a-b1a6-e2c1192f9648"],
 " puts arrowheads on every edge whatever its symmetry type, and ",
 Cell[BoxData[
  StyleBox["False", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "0ab8db17-6a2f-2342-b0be-71c5382691ee"],
 " on none. ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"\"\<CyclicBadges\>\"", " ", "->", " ", "False"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"7d68b4be-1579-2c4a-8286-d1ac5fbaf7b4"],
 " suppresses the circular arrows."
}], "Notes",ExpressionUUID->"74f1a10c-d274-e748-a6ee-ff6d4d9435b1"],

Cell["\<\
The layout, colour palette and edge rendering follow the \
WolframInstitute/Hypergraph paclet.\
\>", "Notes",ExpressionUUID->"d5650eb9-abfc-3841-bcaa-3c5bd3f6adea"],

Cell["All Graphics options are accepted.", "Notes",ExpressionUUID->"05164527-165a-d247-b542-edb1985613e8"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"db7f9e7f-29ad-4541-91d7-23f41813afda"],

Cell["Edges of mixed arity and symmetry type:", "ExampleText",ExpressionUUID->"ec983299-cd78-ea4f-a361-5432d3370eec"],

Cell["\<\
HypergraphPlot[Hypergraph[{Edge[{1, 2, 3}, \"Unordered\"], Edge[{3, 4}],
                            Edge[{1, 4, 5}, \"Cyclic\"]}], ImageSize -> 300]\
\>", "Input",ExpressionUUID->"bcb0096f-8b00-7749-a448-2974101a3557"],

