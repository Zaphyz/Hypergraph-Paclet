Cell["The three symmetry types side by side:", "ExampleText",ExpressionUUID->"4da66a4b-17de-554e-834f-878ffc4042c9"],

Cell["\<\
Grid[{{\"Directed\", \"Unordered\", \"Cyclic\"},
      HypergraphPlot[Hypergraph[{Edge[{1, 2, 3, 4}, #]}], ImageSize -> 150] & \
/@
        {\"Directed\", \"Unordered\", \"Cyclic\"}}, Frame -> All, Alignment \
-> Center]\
\>", "Input",ExpressionUUID->"736dc15b-6518-8c45-a5fe-d41c2bf1c497"],

