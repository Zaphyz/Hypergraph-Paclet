Notebook[{
Cell["HypergraphPlot", "ObjectName",ExpressionUUID->"c8d1bd28-d424-934e-9b2a-03a333ed1db9"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypergraphPlot", "[", "hg", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"014f6ac3-36ed-8847-8ee3-868a8b5dcff5"],
 " ",
 "draws the hypergraph hg."
}], "Usage",ExpressionUUID->"86ace889-13ba-9d4d-88c8-2ae09d2b1327"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"16c50d80-7866-2f4e-8e47-5764817a76e5"],

Cell["\<\
A Hypergraph displays as this plot by default, the way a Graph does, so \
HypergraphPlot is needed only to pass options.\
\>", "Notes",ExpressionUUID->"81821ba4-c700-b44e-adae-e615414cee22"],

Cell["\<\
Binary edges are drawn as arcs, and edges of arity three and above as filled \
concave polygons through their vertices. An edge of arity one is drawn as a \
disk and an edge of arity zero as a circle.\
\>", "Notes",ExpressionUUID->"debc8bbf-6148-8d47-8769-0c30fbbe8b6b"],

Cell["\<\
The symmetry type of each edge is visible: a directed edge carries arrowheads \
running along it, an unordered edge carries none, and a cyclic edge is marked \
with a small circular arrow at its centre, drawn wider so as to encircle the \
edge's label when it has one.\
\>", "Notes",ExpressionUUID->"edc5542f-4b0d-3747-97c2-f877f3058104"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"VertexLabels", " ", "->", " ", "Automatic"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"be030e54-63d5-5e4c-8746-6943e656692c"],
 " (the default) each vertex shows its label if it has one and its identifier \
otherwise. ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"VertexLabels", " ", "->", " ", "None"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"37c02ace-c5b7-3047-8aef-425523d45aa4"],
 " turns them off, ",
 Cell[BoxData[
  StyleBox["\"\<Name\>\"", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "2e899c6d-9bc6-204e-88d7-bedae77c9d89"],
 " always shows the identifier and ",
 Cell[BoxData[
  StyleBox["\"\<Label\>\"", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "bc3ea076-0049-4843-b023-e89194f57ad0"],
 " always the label."
}], "Notes",ExpressionUUID->"fcff4f31-14d7-1943-8fda-3724a9df01c3"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"EdgeLabels", " ", "->", " ", "Automatic"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"10482fc0-0845-8446-af69-4d90a1f869f3"],
 " (the default) shows each edge's label where it has one; ",
 Cell[BoxData[
  StyleBox["\"\<Name\>\"", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "d506e2d9-9a92-304a-b456-e36d15bc220a"],
 " shows the edge's vertex identifiers instead."
}], "Notes",ExpressionUUID->"763d1cfc-8df0-a34e-aafd-f44ae9305fe2"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"\"\<EdgeArrows\>\"", " ", "->", " ", "True"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"3a2dbad4-9205-e744-8650-d76e391182bc"],
 " puts arrowheads on every edge whatever its symmetry type, and ",
 Cell[BoxData[
  StyleBox["False", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "38443cd8-0a27-9840-bfe9-1575fd3b0af2"],
 " on none. ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"\"\<CyclicBadges\>\"", " ", "->", " ", "False"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"397f8b6d-cce3-844b-814a-84090d921661"],
 " suppresses the circular arrows."
}], "Notes",ExpressionUUID->"21c7396c-65c0-9c4f-ae8a-ce8bb227c6af"],

Cell["\<\
The layout, colour palette and edge rendering follow the \
WolframInstitute/Hypergraph paclet.\
\>", "Notes",ExpressionUUID->"438e8f66-ca02-5947-87b0-d24e86fdfc66"],

Cell["All Graphics options are accepted.", "Notes",ExpressionUUID->"1f31287a-eb0b-5c4e-bb04-dae2f3a72a5a"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"9f68ea8e-1d3e-5c4e-935b-81027dd057be"],

Cell["Edges of mixed arity and symmetry type:", "ExampleText",ExpressionUUID->"a3b2b33d-aa65-0d45-b6e1-39a6a65af29b"],

Cell["\<\
HypergraphPlot[Hypergraph[{Edge[{1, 2, 3}, \"Unordered\"], Edge[{3, 4}],
                            Edge[{1, 4, 5}, \"Cyclic\"]}], ImageSize -> 300]\
\>", "Input",ExpressionUUID->"caba3e03-b101-a141-9cd6-37aea8d2c958"],

