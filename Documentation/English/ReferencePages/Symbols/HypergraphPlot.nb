Cell["The three symmetry types side by side:", "ExampleText",ExpressionUUID->"af99044b-3c91-1544-8d1f-baac6fbc731c"],

Cell["\<\
Grid[{{\"Directed\", \"Unordered\", \"Cyclic\"},
      HypergraphPlot[Hypergraph[{Edge[{1, 2, 3, 4}, #]}], ImageSize -> 150] & \
/@
        {\"Directed\", \"Unordered\", \"Cyclic\"}}, Frame -> All, Alignment \
-> Center]\
\>", "Input",ExpressionUUID->"0877942b-2684-d043-9825-408c4c953445"],

