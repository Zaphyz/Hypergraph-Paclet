Notebook[{
Cell["HypergraphPlot", "ObjectName",ExpressionUUID->"edcd9386-02a0-8240-9cd5-3d12df3cc60c"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypergraphPlot", "[", "hg", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"2182e978-3d45-1e41-ae63-5944f16cbff2"],
 " ",
 "draws the hypergraph hg."
}], "Usage",ExpressionUUID->"2687c627-49ed-714a-bf2d-0f1705a340f9"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"83e356de-2131-4b42-bbcb-4311b215a3c7"],

Cell["\<\
A Hypergraph displays as this plot by default, the way a Graph does, so \
HypergraphPlot is needed only to pass options.\
\>", "Notes",ExpressionUUID->"67f87660-d09f-0347-9b67-ff4413856cb1"],

Cell["\<\
Binary edges are drawn as arcs, and edges of arity three and above as filled \
concave polygons through their vertices. An edge of arity one is drawn as a \
disk and an edge of arity zero as a circle.\
\>", "Notes",ExpressionUUID->"1c1c0ae3-9a18-364d-a10e-ae49c8e5e4d3"],

Cell["\<\
The symmetry type of each edge is visible: a directed edge carries arrowheads \
running along it, an unordered edge carries none, and a cyclic edge is marked \
with a small circular arrow at its centre, drawn wider so as to encircle the \
edge's label when it has one.\
\>", "Notes",ExpressionUUID->"68e2bf51-8835-264a-abee-be5140ba4b25"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"VertexLabels", " ", "->", " ", "Automatic"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"1b6c3f0b-6d29-1946-91f3-11ca1127ed76"],
 " (the default) each vertex shows its label if it has one and its identifier \
otherwise. ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"VertexLabels", " ", "->", " ", "None"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"5a609157-adcc-9b42-8ff4-ca1b2623a98c"],
 " turns them off, ",
 Cell[BoxData[
  StyleBox["\"\<Name\>\"", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "18c5598d-dc46-5941-937f-78be972406a3"],
 " always shows the identifier and ",
 Cell[BoxData[
  StyleBox["\"\<Label\>\"", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "530f4618-e686-9e45-8394-944e840e91cb"],
 " always the label."
}], "Notes",ExpressionUUID->"98855128-2015-854f-bf97-608a2f533a14"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"EdgeLabels", " ", "->", " ", "Automatic"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"7a396893-531d-c44f-aab4-6cf937ab4ce6"],
 " (the default) shows each edge's label where it has one; ",
 Cell[BoxData[
  StyleBox["\"\<Name\>\"", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "a065685d-fbe3-ff4f-bb5f-55b1fb98f5b1"],
 " shows the edge's vertex identifiers instead."
}], "Notes",ExpressionUUID->"cee76ed9-526e-0c43-a204-1a3a1f62403e"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"\"\<EdgeArrows\>\"", " ", "->", " ", "True"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"e5dcd962-3da2-3947-8876-51bf150cced3"],
 " puts arrowheads on every edge whatever its symmetry type, and ",
 Cell[BoxData[
  StyleBox["False", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "68c7fed0-bfe4-ac4f-926b-723646ba83ca"],
 " on none. ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"\"\<CyclicBadges\>\"", " ", "->", " ", "False"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"66ea3247-a219-2943-bade-76ef2b48368b"],
 " suppresses the circular arrows."
}], "Notes",ExpressionUUID->"9e906888-207e-2348-bd89-e31f0d52386e"],

Cell["\<\
The layout, colour palette and edge rendering follow the \
WolframInstitute/Hypergraph paclet.\
\>", "Notes",ExpressionUUID->"fe7b4eba-7782-1640-8399-34ea827ac33e"],

Cell["All Graphics options are accepted.", "Notes",ExpressionUUID->"733a134f-902d-9c4e-ac9b-af4cac6403ac"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"c0ba0503-7a2b-0e48-ac28-b531aebeb57d"],

Cell["Edges of mixed arity and symmetry type:", "ExampleText",ExpressionUUID->"71bb6b53-5290-a649-89f5-c26910261f95"],

Cell["\<\
HypergraphPlot[Hypergraph[{Edge[{1, 2, 3}, \"Unordered\"], Edge[{3, 4}],
                            Edge[{1, 4, 5}, \"Cyclic\"]}], ImageSize -> 300]\
\>", "Input",ExpressionUUID->"65bf0250-2519-9044-b6fd-4a04b4b34d38"],

