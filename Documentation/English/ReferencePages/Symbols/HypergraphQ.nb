Notebook[{
Cell["HypergraphQ", "ObjectName",ExpressionUUID->"5fc8516a-72c4-0c41-a8c9-8fc640fb5a4a"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypergraphQ", "[", "expr", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"3378d18f-6b8f-f442-a31a-e3f9452324ad"],
 " ",
 "gives True if expr is a valid Hypergraph object, and False otherwise."
}], "Usage",ExpressionUUID->"dfde7b64-c829-2c49-a24f-824f8aedf08e"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"7dcc226b-a855-ba4f-8c5e-bf7127f97293"],

Cell["\<\
A Hypergraph expression that fails to be built evaluates to $Failed rather \
than remaining as a Hypergraph, so any surviving Hypergraph object is in \
canonical form.\
\>", "Notes",ExpressionUUID->"0e76180c-2860-3c4f-8408-97263a429837"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"81ee1005-3dd4-6545-a1a2-8998d3d40122"],

Cell["\<\
{HypergraphQ[Hypergraph[{Edge[{1, 2}]}]], HypergraphQ[17], \
HypergraphQ[Edge[{1, 2}]]}\
\>", "Input",ExpressionUUID->"6a77acbc-61f4-be4c-a1d8-35c1e896a372"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False", ",", "False"}], "}"}]], "Output",ExpressionUUI\
D->"2e1f0f03-2b39-6444-97eb-a9a119a373b8"],

