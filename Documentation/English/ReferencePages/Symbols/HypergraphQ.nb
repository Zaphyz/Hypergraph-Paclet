Notebook[{
Cell["HypergraphQ", "ObjectName",ExpressionUUID->"9d53b467-5496-df4f-b85a-c9f1e5a8d439"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypergraphQ", "[", "expr", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"459b0c79-78f7-8b49-8acb-9f6fb09d5c13"],
 " ",
 "gives True if expr is a valid Hypergraph object, and False otherwise."
}], "Usage",ExpressionUUID->"2af02c93-705d-0a44-99a9-67e39196c6ea"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"17ed0144-0c73-ab46-8ec9-c04485d7279d"],

Cell["\<\
A Hypergraph expression that fails to be built evaluates to $Failed rather \
than remaining as a Hypergraph, so any surviving Hypergraph object is in \
canonical form.\
\>", "Notes",ExpressionUUID->"8e75d726-775b-2042-9228-2ffac70117e0"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"7b6bfa31-eb47-9045-94fb-afaa1b10c15f"],

Cell["\<\
{HypergraphQ[Hypergraph[{Edge[{1, 2}]}]], HypergraphQ[17], \
HypergraphQ[Edge[{1, 2}]]}\
\>", "Input",ExpressionUUID->"a5046518-8cb6-8147-97b4-fd0d43d16c83"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False", ",", "False"}], "}"}]], "Output",ExpressionUUI\
D->"d569a718-b51f-254d-b419-97e9230e2d6b"],

Cell["Source", "NotesSection",ExpressionUUID->"99d3f943-092e-2a45-bf14-99f69be8d9e7"],

Cell[TextData[{
 "Defined in ",
