Notebook[{
Cell["HypergraphQ", "ObjectName",ExpressionUUID->"ee4054b9-2498-4a4a-87c9-d7e4d340a4bd"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypergraphQ", "[", "expr", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"cad4ebaa-108f-c24d-98ff-e6d099caf23e"],
 " ",
 "gives True if expr is a valid Hypergraph object, and False otherwise."
}], "Usage",ExpressionUUID->"2c9db085-c936-9f4d-82f5-c4fb2b799062"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"88da1316-dacb-5d46-ab2e-edb92577c1b8"],

Cell["\<\
A Hypergraph expression that fails to be built evaluates to $Failed rather \
than remaining as a Hypergraph, so any surviving Hypergraph object is in \
canonical form.\
\>", "Notes",ExpressionUUID->"ddb9c205-408c-384a-9c12-ec901a50b855"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"ead7b8cc-8bce-fe44-afd7-1f7b29d9afbe"],

Cell["\<\
{HypergraphQ[Hypergraph[{Edge[{1, 2}]}]], HypergraphQ[17], \
HypergraphQ[Edge[{1, 2}]]}\
\>", "Input",ExpressionUUID->"e8019411-4cd0-cf41-9069-59d61de73e47"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False", ",", "False"}], "}"}]], "Output",ExpressionUUI\
D->"92451ed1-7f98-bf46-968c-e910447d6a18"],

Cell["Source", "NotesSection",ExpressionUUID->"c80e36ad-f120-2d4e-9d18-a3c8b270a703"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Hypergraphs",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"23432090-e4dc-de4c-bf19-40304721083a"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"0dc39317-e32f-e74e-96b7-8309c1b15fb6"],

