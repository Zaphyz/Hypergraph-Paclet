Notebook[{
Cell["HypergraphQ", "ObjectName",ExpressionUUID->"2195cfa0-7d1e-fe4e-926b-6244af2b4d49"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypergraphQ", "[", "expr", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"e12bc155-484b-f745-97a6-4ab094f67df3"],
 " ",
 "gives True if expr is a valid Hypergraph object, and False otherwise."
}], "Usage",ExpressionUUID->"7518a4af-0c09-0147-ad25-f8faf6144191"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"36c94c04-da10-bd4c-aaf4-64400609d1fa"],

Cell["\<\
A Hypergraph expression that fails to be built evaluates to $Failed rather \
than remaining as a Hypergraph, so any surviving Hypergraph object is in \
canonical form.\
\>", "Notes",ExpressionUUID->"16a7195b-d4cb-f243-ad4f-f68ade22d4b6"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"5ab56508-fb51-0b46-83c8-829e5e8c9c2e"],

Cell["\<\
{HypergraphQ[Hypergraph[{Edge[{1, 2}]}]], HypergraphQ[17], \
HypergraphQ[Edge[{1, 2}]]}\
\>", "Input",ExpressionUUID->"12b9bc58-c527-d945-ba29-1d4af49f8a84"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False", ",", "False"}], "}"}]], "Output",ExpressionUUI\
D->"1b138693-2a18-7b43-87fc-39c5bfc9c241"],

Cell["Source", "NotesSection",ExpressionUUID->"6f545130-8c0e-874d-84ad-574ba3f7fd66"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Hypergraphs",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"1eb970d3-eecf-1c40-a7c5-eeb50f62cb4e"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"31533197-9e2f-914c-a91b-13b003c7a4f6"],

