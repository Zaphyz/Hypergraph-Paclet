Notebook[{
Cell["HypergraphQ", "ObjectName",ExpressionUUID->"86265a7a-c5c5-4e44-9216-43c17922c656"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypergraphQ", "[", "expr", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"e98a13d4-6296-4742-acf5-710ce1beb46e"],
 " ",
 "gives True if expr is a valid Hypergraph object, and False otherwise."
}], "Usage",ExpressionUUID->"a9557690-5a66-a348-b3d2-e26fd8124997"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"0b47bd9f-f839-a94c-8e26-c4e6a90452c4"],

Cell["\<\
A Hypergraph expression that fails to be built evaluates to $Failed rather \
than remaining as a Hypergraph, so any surviving Hypergraph object is in \
canonical form.\
\>", "Notes",ExpressionUUID->"e9ca0a3c-9b11-2b42-9462-64d6d029b521"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"c2427702-d331-0c4c-96bd-43228da34e67"],

Cell["\<\
{HypergraphQ[Hypergraph[{Edge[{1, 2}]}]], HypergraphQ[17], \
HypergraphQ[Edge[{1, 2}]]}\
\>", "Input",ExpressionUUID->"aca2de89-32d8-8e48-b171-f5a51397a19c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False", ",", "False"}], "}"}]], "Output",ExpressionUUI\
D->"1a8bf227-9ac2-ed4a-8610-ac44204206d9"],

Cell["Source", "NotesSection",ExpressionUUID->"08ffd054-bb7f-d143-ae10-40f4169f5eaa"],

