Notebook[{
Cell["HypergraphQ", "ObjectName",ExpressionUUID->"d9916ccc-6e18-7847-ba1b-6a84d06c760e"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypergraphQ", "[", "expr", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"2affb327-8471-4b47-95ae-6bdcd7b3f7c8"],
 " ",
 "gives True if expr is a valid Hypergraph object, and False otherwise."
}], "Usage",ExpressionUUID->"fda49f46-8c0e-774f-9293-0e483b19cee0"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"4117698e-7167-4945-a633-2fb54fd572ec"],

Cell["\<\
A Hypergraph expression that fails to be built evaluates to $Failed rather \
than remaining as a Hypergraph, so any surviving Hypergraph object is in \
canonical form.\
\>", "Notes",ExpressionUUID->"710856f4-9ac0-7445-b528-989a2c9eeba1"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"10729bdd-b8bf-6840-8998-dcb6e48767b7"],

Cell["\<\
{HypergraphQ[Hypergraph[{Edge[{1, 2}]}]], HypergraphQ[17], \
HypergraphQ[Edge[{1, 2}]]}\
\>", "Input",ExpressionUUID->"b8a49fbf-6082-de4c-beb3-c395115804dc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False", ",", "False"}], "}"}]], "Output",ExpressionUUI\
D->"8b435ebd-97f4-3d4c-9a52-0aa6889b67a4"],

Cell["Source", "NotesSection",ExpressionUUID->"e5255e79-042a-3d4a-aa65-044d9f261e3f"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
