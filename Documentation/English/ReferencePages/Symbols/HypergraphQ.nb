Notebook[{
Cell["HypergraphQ", "ObjectName",ExpressionUUID->"5ae3bfaa-1d5e-0941-aad6-88e928cffe90"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypergraphQ", "[", "expr", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"a7d7c1ff-af04-0743-bd8a-cf0efd8e5089"],
 " ",
 "gives True if expr is a valid Hypergraph object, and False otherwise."
}], "Usage",ExpressionUUID->"a22f4f2a-9f9d-9742-8eb7-f33d45ab46de"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"4f4ddab4-a491-f041-8bf9-44178a697e55"],

Cell["\<\
A Hypergraph expression that fails to be built evaluates to $Failed rather \
than remaining as a Hypergraph, so any surviving Hypergraph object is in \
canonical form.\
\>", "Notes",ExpressionUUID->"c177ee5b-8781-714a-8481-e619876fa08d"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"40427c22-cada-7b48-88d8-590ec78d8d8d"],

Cell["\<\
{HypergraphQ[Hypergraph[{Edge[{1, 2}]}]], HypergraphQ[17], \
HypergraphQ[Edge[{1, 2}]]}\
\>", "Input",ExpressionUUID->"5f6a2b19-a470-204b-96f3-da0ae7042d63"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False", ",", "False"}], "}"}]], "Output",ExpressionUUI\
D->"2e86e1ba-c8f5-6742-b18b-c943569f3e66"],

Cell["Source", "NotesSection",ExpressionUUID->"f9c1b696-79dc-be43-80bc-460dadab327d"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Hypergraphs",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"bdf657e8-f53e-b347-b0b3-988a5bd0bf9b"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"6c2a73c3-b1e7-1043-98cd-529644659d6b"],

