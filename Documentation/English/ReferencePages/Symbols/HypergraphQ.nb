Notebook[{
Cell["HypergraphQ", "ObjectName",ExpressionUUID->"50511766-b6b2-f144-97a4-84c16fc3113b"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypergraphQ", "[", "expr", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"42942730-17d2-7a4d-bfa9-3bdb50c5466a"],
 " ",
 "gives True if expr is a valid Hypergraph object, and False otherwise."
}], "Usage",ExpressionUUID->"6197f81e-c392-f945-9173-77a2f88853c0"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"7d7553ca-ef07-9b4b-b28c-30c75257b428"],

Cell["\<\
A Hypergraph expression that fails to be built evaluates to $Failed rather \
than remaining as a Hypergraph, so any surviving Hypergraph object is in \
canonical form.\
\>", "Notes",ExpressionUUID->"44b71321-dc9c-1e47-80bf-e4561c5c48ba"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"d3ff1c25-ebc0-3349-a33d-8afe30064492"],

Cell["\<\
{HypergraphQ[Hypergraph[{Edge[{1, 2}]}]], HypergraphQ[17], \
HypergraphQ[Edge[{1, 2}]]}\
\>", "Input",ExpressionUUID->"c940455d-5d08-4448-99e3-0419c4666684"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False", ",", "False"}], "}"}]], "Output",ExpressionUUI\
D->"dfc6c5ae-46ff-4f49-83bd-5130fd96f2e7"],

Cell["Source", "NotesSection",ExpressionUUID->"12bc76c2-4297-4e4f-ab56-c20331858a03"],

