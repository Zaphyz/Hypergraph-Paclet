Notebook[{
Cell["HypergraphQ", "ObjectName",ExpressionUUID->"a3a4262d-4e7f-ad40-b056-c08bf54a020a"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypergraphQ", "[", "expr", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"61910e25-87d2-754c-9921-34f3a5e6a84c"],
 " ",
 "gives True if expr is a valid Hypergraph object, and False otherwise."
}], "Usage",ExpressionUUID->"4fdfdee5-693a-6a43-b600-7b74ab321a16"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"6107cc13-e1b0-574a-a0d3-9b3204edd816"],

Cell["\<\
A Hypergraph expression that fails to be built evaluates to $Failed rather \
than remaining as a Hypergraph, so any surviving Hypergraph object is in \
canonical form.\
\>", "Notes",ExpressionUUID->"219f6503-d39b-904e-ad1f-875f130c7094"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"378b2702-38ad-a54a-a8c2-1bc567abb500"],

Cell["\<\
{HypergraphQ[Hypergraph[{Edge[{1, 2}]}]], HypergraphQ[17], \
HypergraphQ[Edge[{1, 2}]]}\
\>", "Input",ExpressionUUID->"b54688ee-7ea7-c14b-a32f-9068a7cd4b20"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False", ",", "False"}], "}"}]], "Output",ExpressionUUI\
D->"1541f140-43d7-e649-8150-effe03344f2c"],

Cell["Source", "NotesSection",ExpressionUUID->"32a0d509-c34e-cf4f-b673-9922c80064b6"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Hypergraphs",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"850451af-b0f9-614f-a753-18fb79904623"],

