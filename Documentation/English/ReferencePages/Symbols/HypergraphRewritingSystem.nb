Cell["\<\
Every edge of every state is a place the rule fits, so the states multiply:\
\>", "ExampleText",ExpressionUUID->"8dd9bdf3-933f-d044-8105-d3b154fde9a2"],

Cell["\<\
Table[{system[\"StateCount\", g], system[\"EventCount\", g]}, {g, 0, 3}]\
\>", "Input",ExpressionUUID->"11ba4b33-34d7-a94f-b36f-c1a25c4df9c4"],

