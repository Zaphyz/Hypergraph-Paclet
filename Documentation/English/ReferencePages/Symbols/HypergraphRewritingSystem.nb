Cell["\<\
Every edge of every state is a place the rule fits, so the states multiply:\
\>", "ExampleText",ExpressionUUID->"51391eaa-8096-0248-ac95-d59fed1c9130"],

Cell["\<\
Table[{system[\"StateCount\", g], system[\"EventCount\", g]}, {g, 0, 3}]\
\>", "Input",ExpressionUUID->"8a0e7ed0-52e5-2149-b1df-ec7f10364cb4"],

