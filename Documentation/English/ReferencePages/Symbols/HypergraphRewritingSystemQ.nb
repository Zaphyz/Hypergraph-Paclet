Notebook[{
Cell["HypergraphRewritingSystemQ", "ObjectName",ExpressionUUID->"b0589692-843a-6f4e-aba0-7014ad31531a"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypergraphRewritingSystemQ", "[", "expr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"153b3af3-cf66-064f-8a60-b0762f63e9f0"],
 " ",
 "gives True if expr is a valid HypergraphRewritingSystem, and False \
otherwise."
}], "Usage",ExpressionUUID->"c57adf62-a905-ab4b-aee8-a0a91e22e4ce"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"6527bfbd-3df1-9544-94f5-1e06d99f89e2"],

Cell["\<\
A valid system is a list of HypergraphRule objects together with a \
Hypergraph. Anything given in another form is converted when the system is \
built, so a system that exists at all is valid.\
\>", "Notes",ExpressionUUID->"bc640370-3509-f645-8577-e9db289f9b3b"],

Cell["\<\
It gives False rather than a message on anything else, including $Failed.\
\>", "Notes",ExpressionUUID->"1bf137d4-85a0-ba45-bfeb-b7e709e9b1e6"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"af3ddd55-eb71-124d-8966-68746fddcd02"],

Cell["\<\
HypergraphRewritingSystemQ @ HypergraphRewritingSystem[{{1, 2}} -> {{2, 1}}, \
Hypergraph[{{1, 2}}]]\
\>", "Input",ExpressionUUID->"a185008f-e5f7-1f43-ae56-ead054f29cf7"],

Cell[BoxData["True"], "Output",ExpressionUUID->"57adec41-1f48-5749-be22-7f2c995b2437"],

Cell["\<\
HypergraphRewritingSystemQ /@ {HypergraphRule[{{1, 2}}, {{2, 1}}], $Failed, 7}\
\>", "Input",ExpressionUUID->"d3f8deb4-f08e-f44b-a19d-c727b84a950d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "False", ",", "False"}], "}"}]], "Output",ExpressionUU\
ID->"9cc7cdb4-3daf-fc4b-af6e-38fe4fa9d473"],

Cell["Source", "NotesSection",ExpressionUUID->"e5858ceb-8e21-e441-b2fb-7609fd372c57"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Causality.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "The system object",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"65bce17f-6b3b-2d47-ac59-71d6f496fe41"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"b46f0df8-704c-7848-80fd-3e83287c7f52"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["HypergraphRewritingSystem", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"7d5f7587-9696-6a47-85b0-0642a47faad4"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphRuleQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "44318bc8-f54e-3043-8a57-e6dcde89c6e6"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "b17593ed-ef9c-4945-af53-837099a20fa9"]
}], "SeeAlso",ExpressionUUID->"1411c91c-6f37-3941-af61-5f5497cfc2c3"]
