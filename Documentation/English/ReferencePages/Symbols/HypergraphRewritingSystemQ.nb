Notebook[{
Cell["HypergraphRewritingSystemQ", "ObjectName",ExpressionUUID->"26fee5a1-7143-974b-9d37-517fe51e3fc6"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypergraphRewritingSystemQ", "[", "expr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"62af72dc-b7e1-474d-a82a-9a821811d9e6"],
 " ",
 "gives True if expr is a valid HypergraphRewritingSystem, and False \
otherwise."
}], "Usage",ExpressionUUID->"2d80c22c-cfa9-ed4e-b7ec-f98d79eaa554"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"89e6d59c-6192-2541-a4d7-beb658b530c5"],

Cell["\<\
A valid system is a list of HypergraphRule objects together with a \
Hypergraph. Anything given in another form is converted when the system is \
built, so a system that exists at all is valid.\
\>", "Notes",ExpressionUUID->"77eadb8d-56ed-164c-ac46-ff5831a5d6ea"],

Cell["\<\
It gives False rather than a message on anything else, including $Failed.\
\>", "Notes",ExpressionUUID->"cb2611a9-f7f9-d64c-8f3a-cd8203305962"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"129affea-2704-d74b-8e72-65a1f338adf7"],

Cell["\<\
HypergraphRewritingSystemQ @ HypergraphRewritingSystem[{{1, 2}} -> {{2, 1}}, \
Hypergraph[{{1, 2}}]]\
\>", "Input",ExpressionUUID->"aa4af592-4f0e-4040-b6e1-3c05ec5f79e6"],

Cell[BoxData["True"], "Output",ExpressionUUID->"4b4e092b-677f-4740-a176-44e5b5649161"],

Cell["\<\
HypergraphRewritingSystemQ /@ {HypergraphRule[{{1, 2}}, {{2, 1}}], $Failed, 7}\
\>", "Input",ExpressionUUID->"7653a11d-90dd-944f-9930-dd5cf76cacae"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "False", ",", "False"}], "}"}]], "Output",ExpressionUU\
ID->"60b4f8c9-ec4e-d945-8db7-94eb18b60d32"],

Cell["Source", "NotesSection",ExpressionUUID->"da3a4bef-a8ba-6741-96bf-53d223aeecd2"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Causality.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "The system object",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"6a9e7ff8-1006-9e43-9d64-5fe216bed793"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"6507e1d5-86d1-7d46-8b90-66a0d9f3356a"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["HypergraphRewritingSystem", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"0f5f8532-935f-ef43-9f8d-2c8d84c1b12b"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphRuleQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "aa18f459-6ca7-b743-8184-e0e0a2d2daf7"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "0b77ea32-2686-0441-bf72-9bb59a6a36e4"]
}], "SeeAlso",ExpressionUUID->"c9cd4d1b-5125-2243-9970-8ef447b9d1be"]
