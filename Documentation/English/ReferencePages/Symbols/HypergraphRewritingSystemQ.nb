Notebook[{
Cell["HypergraphRewritingSystemQ", "ObjectName",ExpressionUUID->"0f210e1d-d90a-9b4a-8995-f85cd6d280cb"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypergraphRewritingSystemQ", "[", "expr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"55593ca4-eee1-694d-93a8-3db4ec07f39b"],
 " ",
 "gives True if expr is a valid HypergraphRewritingSystem, and False \
otherwise."
}], "Usage",ExpressionUUID->"96fef3ab-c7cb-b747-a992-de6896e48e58"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"ab59d5a7-9d0a-9944-961e-819573b96323"],

Cell["\<\
A valid system is a list of HypergraphRule objects together with a \
Hypergraph. Anything given in another form is converted when the system is \
built, so a system that exists at all is valid.\
\>", "Notes",ExpressionUUID->"c32db5df-e84d-bc41-9832-08e78027ab1d"],

Cell["\<\
It gives False rather than a message on anything else, including $Failed.\
\>", "Notes",ExpressionUUID->"c4da017d-94bc-7141-b20e-f6934cd32eff"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"621313bd-aae2-aa4f-af93-81a62f9a6dea"],

Cell["\<\
HypergraphRewritingSystemQ @ HypergraphRewritingSystem[{{1, 2}} -> {{2, 1}}, \
Hypergraph[{{1, 2}}]]\
\>", "Input",ExpressionUUID->"85d73a7a-18a3-b74f-80d8-ac3553a93a29"],

Cell[BoxData["True"], "Output",ExpressionUUID->"a8a41d49-37be-bf42-b419-4a0d70e76b9e"],

Cell["\<\
HypergraphRewritingSystemQ /@ {HypergraphRule[{{1, 2}}, {{2, 1}}], $Failed, 7}\
\>", "Input",ExpressionUUID->"16723b25-ccf3-ca40-9ad7-9a8c2895bfb9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "False", ",", "False"}], "}"}]], "Output",ExpressionUU\
ID->"b3bbadb3-49e3-024d-a201-10ca176397f0"],

Cell["Source", "NotesSection",ExpressionUUID->"5b2ba293-91b4-8340-a537-080c06cf9e75"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Causality.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "The system object",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"489877f8-eab2-ac4a-9062-e0cc70a47f27"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"49a699ba-7e90-7a40-9f53-003ee9400531"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["HypergraphRewritingSystem", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"8b3eb51d-ac91-3741-98b3-c368a3651b08"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphRuleQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "7c5156f0-b23f-b641-b97c-d33a2018468e"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "433710a4-05ef-e348-b3b5-447b03d0e795"]
}], "SeeAlso",ExpressionUUID->"fa2b8e19-4c5a-6d40-8f7d-d770b5bfb99c"]
