(* Beginning of Notebook Content *)
Notebook[{
Cell["HypergraphRewritingSystemQ", "ObjectName",ExpressionUUID->"4d171042-b68c-054d-a433-9a73538ed6b8"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypergraphRewritingSystemQ", "[", "expr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"e04c6048-e29b-954f-a236-a2c4c65b8fda"],
 " ",
 "gives True if expr is a valid HypergraphRewritingSystem, and False \
otherwise."
}], "Usage",ExpressionUUID->"a9be493d-0ae1-c44f-9768-9a8653ee548b"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"c654180a-c613-0343-9964-fd727fad387e"],

Cell["\<\
A valid system is a list of HypergraphRule objects together with a \
Hypergraph. Anything given in another form is converted when the system is \
built, so a system that exists at all is valid.\
\>", "Notes",ExpressionUUID->"0a524e02-c212-0040-a596-7101a0c3b02a"],

Cell["\<\
It gives False rather than a message on anything else, including $Failed.\
\>", "Notes",ExpressionUUID->"accffb2b-3cef-ca4d-b789-576dfb7f85b9"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"2d267963-a8d7-6d41-918e-b4e5c5794d90"],

Cell["\<\
HypergraphRewritingSystemQ @ HypergraphRewritingSystem[{{1, 2}} -> {{2, 1}}, \
Hypergraph[{{1, 2}}]]\
\>", "Input",ExpressionUUID->"a5138b9f-d0d8-9348-a26c-b944cc94d268"],

Cell[BoxData["True"], "Output",ExpressionUUID->"3be6344d-5698-0947-b470-6d00bbbe5066"],

Cell["\<\
HypergraphRewritingSystemQ /@ {HypergraphRule[{{1, 2}}, {{2, 1}}], $Failed, 7}\
\>", "Input",ExpressionUUID->"194ad418-7692-f24a-abfa-8b71bb58c931"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "False", ",", "False"}], "}"}]], "Output",ExpressionUU\
ID->"df752e56-0ab4-444e-83f5-55b8bdf9842c"],

Cell["Source", "NotesSection",ExpressionUUID->"ffb9a410-26f7-c44b-a360-be03bf2bf634"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Causality.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "The system object",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"4a2de609-6b1e-f247-a95c-7c57ba61af0c"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"7437aebd-082a-7648-aa3b-1f47cf4ffce8"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["HypergraphRewritingSystem", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"1cdce804-9d0a-7a4c-a977-5bdab1fdcc95"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphRuleQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "232813c3-5a3c-da4b-9c8d-be03ac4b13d9"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "821be4b2-5c39-5a40-8c65-4098e70551c1"]
}], "SeeAlso",ExpressionUUID->"35622f4a-50b8-1149-8ec4-9f1c14c0e046"]
