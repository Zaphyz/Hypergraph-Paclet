Notebook[{
Cell["HypergraphRewritingSystemQ", "ObjectName",ExpressionUUID->"c5d39924-4ca5-6e41-a460-50629ddfd1fc"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypergraphRewritingSystemQ", "[", "expr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"057d3580-f7c5-9f4b-b57c-348e6f10b13c"],
 " ",
 "gives True if expr is a valid HypergraphRewritingSystem, and False \
otherwise."
}], "Usage",ExpressionUUID->"05a2ffeb-83ce-8546-9dab-b7ed7cc6bc16"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"33a911e1-dd36-4f40-bc50-d532925f3ff7"],

Cell["\<\
A valid system is a list of HypergraphRule objects together with a \
Hypergraph. Anything given in another form is converted when the system is \
built, so a system that exists at all is valid.\
\>", "Notes",ExpressionUUID->"3706a8f3-1682-f445-9e97-cae091ac49bd"],

Cell["\<\
It gives False rather than a message on anything else, including $Failed.\
\>", "Notes",ExpressionUUID->"3cb75177-5f00-3647-bef3-7aa087d43b28"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"582cbefb-94dd-2747-9258-9cfa78fbeecb"],

Cell["\<\
HypergraphRewritingSystemQ @ HypergraphRewritingSystem[{{1, 2}} -> {{2, 1}}, \
Hypergraph[{{1, 2}}]]\
\>", "Input",ExpressionUUID->"2661e42d-f0e2-7042-8218-18c0213baaf6"],

Cell[BoxData["True"], "Output",ExpressionUUID->"061d8b7f-ba58-384f-83f3-47abfea30474"],

Cell["\<\
HypergraphRewritingSystemQ /@ {HypergraphRule[{{1, 2}}, {{2, 1}}], $Failed, 7}\
\>", "Input",ExpressionUUID->"4a393773-0390-e14f-bda3-cd226ee63dfd"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "False", ",", "False"}], "}"}]], "Output",ExpressionUU\
ID->"7a6a3c4a-7db4-654f-99d0-f1964e84e19f"],

Cell["Source", "NotesSection",ExpressionUUID->"f7a3d46d-88a1-e549-9c9f-2e7602d88d7d"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Causality.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "The system object",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"37407704-43af-bf46-9eac-ea59069f890f"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"bc34a5d3-1675-6742-b0fe-71a24ec9a419"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["HypergraphRewritingSystem", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"aa0538f6-55d8-6c46-8753-db9aa6e6b0c4"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphRuleQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "73b82f73-b5e2-e048-a6f0-6cf2f7712758"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "bc901fe5-6dbc-7945-93af-d9118ff6d51b"]
}], "SeeAlso",ExpressionUUID->"4635b87f-067b-6842-b7f5-0df3101902d4"]
