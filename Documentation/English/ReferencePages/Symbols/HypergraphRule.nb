0252a41f8844"],

Cell["\<\
{sub[\"SharedVertices\"], sub[\"NewVertices\"], sub[\"DeletedVertices\"]}\
\>", "Input",ExpressionUUID->"a5435662-e386-9446-bda9-5e37130b0b9f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", "3", "}"}], ",", 
   RowBox[{"{", "}"}]}], "}"}]], "Output",ExpressionUUID->"6f77f6b0-4392-9343-\
b632-60bed45003a9"],

Cell["\<\
A rule that destroys a vertex, by mentioning it on the left only:\
\>", "ExampleText",ExpressionUUID->"65874de5-5769-3e4f-b47d-11fe46ebd5f1"],

Cell["HypergraphRule[{{1, 2}}, {{1}}][\"DeletedVertices\"]", "Input",ExpressionUUID->"c0c8cbdc-1d23-7744-b223-ba05e5848e83"],

Cell[BoxData[
 RowBox[{"{", "2", "}"}]], "Output",ExpressionUUID->"30919d11-efa8-f641-bf55-82e2e772aaaa"],

Cell["\<\
The sides may carry symmetry types and labels like any hypergraph:\
\>", "ExampleText",ExpressionUUID->"179c16b2-9a6a-1b49-9115-011b3a3ed333"],

Cell["\<\
HypergraphRule[{Edge[{1, 2, 3}, \"Unordered\", \"a\"]}, {Edge[{1, 2}, \
\"Directed\"]}][\"Input\"]\
\>", "Input",ExpressionUUID->"b26389e9-6d89-a949-8627-0614240d3980"],

