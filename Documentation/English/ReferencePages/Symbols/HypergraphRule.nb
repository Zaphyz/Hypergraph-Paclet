16016db96557"],

Cell["\<\
{sub[\"SharedVertices\"], sub[\"NewVertices\"], sub[\"DeletedVertices\"]}\
\>", "Input",ExpressionUUID->"2d0fd19f-4950-b746-8749-f10944e15c2c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", "3", "}"}], ",", 
   RowBox[{"{", "}"}]}], "}"}]], "Output",ExpressionUUID->"c24ac00f-6480-824b-\
b7d3-64843b7c222d"],

Cell["\<\
A rule that destroys a vertex, by mentioning it on the left only:\
\>", "ExampleText",ExpressionUUID->"746cab37-f96b-c549-ad02-c36bc906f0af"],

Cell["HypergraphRule[{{1, 2}}, {{1}}][\"DeletedVertices\"]", "Input",ExpressionUUID->"093c0476-7570-b045-aba1-447da1a794db"],

Cell[BoxData[
 RowBox[{"{", "2", "}"}]], "Output",ExpressionUUID->"acfa0a96-7c87-214c-9ed3-74d83d9e1567"],

Cell["\<\
The sides may carry symmetry types and labels like any hypergraph:\
\>", "ExampleText",ExpressionUUID->"32ea00fe-780e-e346-bd4f-23d1b71cd314"],

Cell["\<\
HypergraphRule[{Edge[{1, 2, 3}, \"Unordered\", \"a\"]}, {Edge[{1, 2}, \
\"Directed\"]}][\"Input\"]\
\>", "Input",ExpressionUUID->"d702a517-aa50-e74c-be6e-ed12b4385b88"],

