250c18e1fce5"],

Cell["\<\
{sub[\"SharedVertices\"], sub[\"NewVertices\"], sub[\"DeletedVertices\"]}\
\>", "Input",ExpressionUUID->"e7540fac-4d6e-7749-a2e3-b92ffeb9b0db"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", "3", "}"}], ",", 
   RowBox[{"{", "}"}]}], "}"}]], "Output",ExpressionUUID->"fc92ef41-fcf6-eb45-\
b070-1c78150ed617"],

Cell["\<\
A rule that destroys a vertex, by mentioning it on the left only:\
\>", "ExampleText",ExpressionUUID->"0efc5716-1782-e047-9030-2bd15156d042"],

Cell["HypergraphRule[{{1, 2}}, {{1}}][\"DeletedVertices\"]", "Input",ExpressionUUID->"dc7bdf37-e0e8-b84f-befe-fc4b280baf34"],

Cell[BoxData[
 RowBox[{"{", "2", "}"}]], "Output",ExpressionUUID->"55e0c939-54b7-974b-8e6b-708255701610"],

Cell["\<\
The sides may carry symmetry types and labels like any hypergraph:\
\>", "ExampleText",ExpressionUUID->"c753a43f-af3f-ca43-8094-7fb01c110b36"],

Cell["\<\
HypergraphRule[{Edge[{1, 2, 3}, \"Unordered\", \"a\"]}, {Edge[{1, 2}, \
\"Directed\"]}][\"Input\"]\
\>", "Input",ExpressionUUID->"ed8ec932-4dc3-6647-a246-75900d5433c7"],

