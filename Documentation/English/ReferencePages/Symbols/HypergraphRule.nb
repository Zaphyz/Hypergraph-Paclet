3c6321cfa829"],

Cell["\<\
{sub[\"SharedVertices\"], sub[\"NewVertices\"], sub[\"DeletedVertices\"]}\
\>", "Input",ExpressionUUID->"50b34386-bb54-4e4d-b9c7-399104b6db0b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", "3", "}"}], ",", 
   RowBox[{"{", "}"}]}], "}"}]], "Output",ExpressionUUID->"b1cf754f-0008-e542-\
b43d-f15c5b7743d5"],

Cell["\<\
A rule that destroys a vertex, by mentioning it on the left only:\
\>", "ExampleText",ExpressionUUID->"38623fcd-dc96-284c-b0cb-2e3898d12186"],

Cell["HypergraphRule[{{1, 2}}, {{1}}][\"DeletedVertices\"]", "Input",ExpressionUUID->"fd1c14c5-2262-ea46-a781-25b0a6293643"],

Cell[BoxData[
 RowBox[{"{", "2", "}"}]], "Output",ExpressionUUID->"4b108f87-e63a-1f4e-9041-08c4f7f61d5d"],

Cell["\<\
The sides may carry symmetry types and labels like any hypergraph:\
\>", "ExampleText",ExpressionUUID->"ad61c381-2405-7741-8c56-709d60bf5dcb"],

Cell["\<\
HypergraphRule[{Edge[{1, 2, 3}, \"Unordered\", \"a\"]}, {Edge[{1, 2}, \
\"Directed\"]}][\"Input\"]\
\>", "Input",ExpressionUUID->"a3609acb-fa9b-164c-beb5-72985231d2df"],

