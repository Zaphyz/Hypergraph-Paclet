e0809acab9fc"],

Cell["\<\
{sub[\"SharedVertices\"], sub[\"NewVertices\"], sub[\"DeletedVertices\"]}\
\>", "Input",ExpressionUUID->"d6548ee2-3134-084a-9a33-ea1768bc0a8a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", "3", "}"}], ",", 
   RowBox[{"{", "}"}]}], "}"}]], "Output",ExpressionUUID->"893cd375-d3e5-9a41-\
9f64-255db031fb17"],

Cell["\<\
A rule that destroys a vertex, by mentioning it on the left only:\
\>", "ExampleText",ExpressionUUID->"47fd7b9d-469f-0042-8b92-d1772c2bf478"],

Cell["HypergraphRule[{{1, 2}}, {{1}}][\"DeletedVertices\"]", "Input",ExpressionUUID->"dfa922a5-3650-d24f-a4d7-cef9f2e211be"],

Cell[BoxData[
 RowBox[{"{", "2", "}"}]], "Output",ExpressionUUID->"22d62928-3ed1-4546-b063-5edab0e46a38"],

Cell["\<\
The sides may carry symmetry types and labels like any hypergraph:\
\>", "ExampleText",ExpressionUUID->"35e298ed-8a91-0041-a60b-8679cb24f16e"],

Cell["\<\
HypergraphRule[{Edge[{1, 2, 3}, \"Unordered\", \"a\"]}, {Edge[{1, 2}, \
\"Directed\"]}][\"Input\"]\
\>", "Input",ExpressionUUID->"a6171dfa-18e7-2342-ba2a-eca9d203e979"],

