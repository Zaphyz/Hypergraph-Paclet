Cell["The results of both events, as edge lists:", "ExampleText",ExpressionUUID->"e64883e9-06ad-bf48-ae85-95c7be36c8aa"],

Cell["EdgeList[#[\"Hypergraph\"]] & /@ events", "Input",ExpressionUUID->"845a640c-3152-5b49-8981-edbbacfdf037"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Edge", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Vertex", "[", "1", "]"}], ",", 
         RowBox[{"Vertex", "[", 
          RowBox[{"\[FormalV]", "[", "1", "]"}], "]"}]}], "}"}], 
       ",", "\<\"Directed\"\>"}], "]"}], ",", 
     RowBox[{"Edge", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Vertex", "[", "2", "]"}], ",", 
         RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], 
       ",", "\<\"Directed\"\>"}], "]"}], ",", 
     RowBox[{"Edge", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Vertex", "[", 
          RowBox[{"\[FormalV]", "[", "1", "]"}], "]"}], ",", 
         RowBox[{"Vertex", "[", "2", "]"}]}], "}"}], 
       ",", "\<\"Directed\"\>"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Edge", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Vertex", "[", "1", "]"}], ",", 
         RowBox[{"Vertex", "[", "2", "]"}]}], "}"}], 
       ",", "\<\"Directed\"\>"}], "]"}], ",", 
     RowBox[{"Edge", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Vertex", "[", "2", "]"}], ",", 
         RowBox[{"Vertex", "[", 
          RowBox[{"\[FormalV]", "[", "1", "]"}], "]"}]}], "}"}], 
       ",", "\<\"Directed\"\>"}], "]"}], ",", 
     RowBox[{"Edge", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Vertex", "[", 
          RowBox[{"\[FormalV]", "[", "1", "]"}], "]"}], ",", 
         RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], 
       ",", "\<\"Directed\"\>"}], "]"}]}], "}"}]}], "}"}]], "Output",Expressio\
nUUID->"695a1c35-f10d-2142-a50f-78c87ecb7c6b"],

Cell["\<\
A rule that destroys a vertex does so only when nothing else holds it:\
\>", "ExampleText",ExpressionUUID->"47bf17a7-4278-5d43-9495-2aebd02e1780"],

Cell["\<\
del = HypergraphRule[{{1, 2}}, {{1}}];
{VertexList @ First[del[Hypergraph[{Edge[{1, 2}]}]]][\"Hypergraph\"],
 VertexList @ First[del[Hypergraph[{Edge[{1, 2}], Edge[{2, \
3}]}]]][\"Hypergraph\"]}\
\>", "Input",ExpressionUUID->"79d8333e-5974-af4d-ba2a-20255b867bb1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"Vertex", "[", "1", "]"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Vertex", "[", "1", "]"}], ",", 
     RowBox[{"Vertex", "[", "2", "]"}], ",", 
     RowBox[{"Vertex", "[", "3", "]"}]}], "}"}]}], "}"}]], "Output",Expression\
UUID->"4ab4052c-66f5-d94e-98f0-e6841bf7f7b3"],

Cell["\<\
A literal label on the pattern narrows what the rule applies to:\
\>", "ExampleText",ExpressionUUID->"e28951c4-d361-de40-b78d-8b13f4ee67fc"],

Cell["\<\
hl = Hypergraph[{Edge[{1, 2}, \"Directed\", \"a\"], Edge[{2, 3}, \
\"Directed\", \"b\"]}];
{Length @ HypergraphRuleMatches[HypergraphRule[{{1, 2}}, {}], hl],
 Length @ HypergraphRuleMatches[HypergraphRule[{Edge[{1, 2}, \"Directed\", \
\"a\"]}, {}], hl]}\
\>", "Input",ExpressionUUID->"24257405-7e35-6a45-a0ad-d9fd26635a79"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "1"}], "}"}]], "Output",ExpressionUUID->"136b9e03-5863-124a-8c70-18849128bd7a"],

Cell["\<\
A symbol, by contrast, matches any label and remembers what it found:\
\>", "ExampleText",ExpressionUUID->"f38fd8be-572e-cf40-a647-9f01ead01fb6"],

Cell["\<\
hsym = Hypergraph[{Edge[{1, 2}, \"Directed\", f], Edge[{2, 3}, \"Directed\", \
g]}];
#[\"LabelBindings\"] & /@ HypergraphRuleMatches[HypergraphRule[{Edge[{1, 2}, \
\"Directed\", x]}, {}], hsym]\
\>", "Input",ExpressionUUID->"58174097-7e70-ec45-8818-57a5b2a35684"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{"x", "\[Rule]", "f"}], "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{"x", "\[Rule]", "g"}], "\[RightAssociation]"}]}], "}"}]], "Output",\
ExpressionUUID->"f6211d6b-87b1-9b43-a4db-e0c07f04a2bc"],

Cell["\<\
\[Ellipsis] so the output can be named after it. Composing two labelled edges \
into one:\
\>", "ExampleText",ExpressionUUID->"bc5f7fbc-0c21-3242-851d-b155dd7af00e"],

Cell["\<\
comp = HypergraphRule[
   {Edge[{1, 2}, \"Directed\", x], Edge[{2, 3}, \"Directed\", y]},
   {Edge[{1, 3}, \"Directed\", Row[{\"{\", x, y, \"}\"}]]}];
EdgeLabel /@ EdgeList @ First[comp[hsym]][\"Hypergraph\"]\
\>", "Input",ExpressionUUID->"5b1ea66f-a980-744b-b4bc-1fb0e3275f21"],

Cell[BoxData[
 RowBox[{"{", 
  TemplateBox[{"\"{\"", "f", "g", "\"}\""},
   "RowDefault"], "}"}]], "Output",ExpressionUUID->"de004063-ed42-7f43-82d9-\
afed97f1572b"],

Cell["\<\
Vertex labels bind too, so a rule whose whole input is one labelled vertex \
can name what it creates after it:\
\>", "ExampleText",ExpressionUUID->"288f6992-fd1e-7a40-8b8d-8749713237dc"],

Cell["\<\
obj = Hypergraph[{Vertex[1, r], Vertex[2, s]}, {Edge[{1, 2}, \"Directed\", \
u]}];
unit = HypergraphRule[
   Hypergraph[{Vertex[1, p]}, {}],
   Hypergraph[{Vertex[1, p], Vertex[2, p]}, {Edge[{1, 2}, \"Directed\", \
Subscript[\"1\", p]]}]];
#[\"LabelBindings\"] & /@ unit[obj]\
\>", "Input",ExpressionUUID->"974b8260-c45e-954e-ab17-aea48db1aa1f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{"p", "\[Rule]", "r"}], "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{"p", "\[Rule]", "s"}], "\[RightAssociation]"}]}], "}"}]], "Output",\
ExpressionUUID->"f59e829f-9f45-1144-9e30-0eedc03508d2"],

Cell["EdgeLabel /@ EdgeList @ First[unit[obj]][\"Hypergraph\"]", "Input",ExpressionUUID->"67f6b36b-ea31-1c4e-b205-073fed270cb5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "4"}], "}"}]}], "}"}], ",", 
   SubscriptBox["\<\"1\"\>", "r"]}], "}"}]], "Output",ExpressionUUID->\
"9f70fb24-7181-5f4b-9150-86a06b7cdbf7"],

Cell["A rule that does not apply gives no events:", "ExampleText",ExpressionUUID->"03c120f1-2fb8-4848-a6d9-050b9d18057e"],

Cell["\<\
HypergraphRule[{{1, 2}, {2, 3}}, {}][Hypergraph[{Edge[{1, 2}]}]]\
\>", "Input",ExpressionUUID->"d9826a7d-92f9-3745-9d01-f6cb33961eed"],

Cell[BoxData[
 RowBox[{"{", "}"}]], "Output",ExpressionUUID->"55dca19b-80a3-3d46-bbff-a643baeecbb2"],

