          RowBox[{"\[FormalV]", "[", "1", "]"}], "]"}]}], "}"}], 
       ",", "\<\"Directed\"\>"}], "]"}], ",", 
     RowBox[{"Edge", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Vertex", "[", 
          RowBox[{"\[FormalV]", "[", "1", "]"}], "]"}], ",", 
         RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], 
       ",", "\<\"Directed\"\>"}], "]"}]}], "}"}]}], "}"}]], "Output",Expressio\
nUUID->"729cdfd3-3745-9a45-b30c-7bc311c6be4f"],

Cell["\<\
A rule that destroys a vertex does so only when nothing else holds it:\
\>", "ExampleText",ExpressionUUID->"fa2f2ddc-2ee7-bc41-8df0-9aadc1eb3f53"],

Cell["\<\
del = HypergraphRule[{{1, 2}}, {{1}}];
{VertexList @ First[del[Hypergraph[{Edge[{1, 2}]}]]][\"Hypergraph\"],
 VertexList @ First[del[Hypergraph[{Edge[{1, 2}], Edge[{2, \
3}]}]]][\"Hypergraph\"]}\
\>", "Input",ExpressionUUID->"0de20116-be04-1c4a-83ca-8a118dd37af8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"Vertex", "[", "1", "]"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Vertex", "[", "1", "]"}], ",", 
     RowBox[{"Vertex", "[", "2", "]"}], ",", 
     RowBox[{"Vertex", "[", "3", "]"}]}], "}"}]}], "}"}]], "Output",Expression\
UUID->"4b7e2bb8-ad0c-9943-acbb-d9dd9a0ad80a"],

Cell["\<\
A literal label on the pattern narrows what the rule applies to:\
\>", "ExampleText",ExpressionUUID->"b7c6f076-a7d6-de4b-9337-04a11170d90d"],

Cell["\<\
hl = Hypergraph[{Edge[{1, 2}, \"Directed\", \"a\"], Edge[{2, 3}, \
\"Directed\", \"b\"]}];
{Length @ HypergraphRuleMatches[HypergraphRule[{{1, 2}}, {}], hl],
 Length @ HypergraphRuleMatches[HypergraphRule[{Edge[{1, 2}, \"Directed\", \
\"a\"]}, {}], hl]}\
\>", "Input",ExpressionUUID->"e2695e82-f92b-d849-8970-d99f901e9451"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "1"}], "}"}]], "Output",ExpressionUUID->"337c5872-7725-0140-a49f-119c3ddb5cfc"],

Cell["\<\
A symbol, by contrast, matches any label and remembers what it found:\
\>", "ExampleText",ExpressionUUID->"d873c4b7-c30f-0e42-886f-6b351d796190"],

Cell["\<\
hsym = Hypergraph[{Edge[{1, 2}, \"Directed\", f], Edge[{2, 3}, \"Directed\", \
g]}];
#[\"LabelBindings\"] & /@ HypergraphRuleMatches[HypergraphRule[{Edge[{1, 2}, \
\"Directed\", x]}, {}], hsym]\
\>", "Input",ExpressionUUID->"789eeff2-e3ff-7a4b-a231-d719bb1667ab"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{"x", "\[Rule]", "f"}], "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{"x", "\[Rule]", "g"}], "\[RightAssociation]"}]}], "}"}]], "Output",\
ExpressionUUID->"584f7c93-bb7c-864d-a338-ea2a89f67901"],

Cell["\<\
\[Ellipsis] so the output can be named after it. Composing two labelled edges \
into one:\
\>", "ExampleText",ExpressionUUID->"703fb957-4ac2-4d40-9a2c-a22c1d57aa5f"],

Cell["\<\
comp = HypergraphRule[
   {Edge[{1, 2}, \"Directed\", x], Edge[{2, 3}, \"Directed\", y]},
   {Edge[{1, 3}, \"Directed\", Row[{\"{\", x, y, \"}\"}]]}];
EdgeLabel /@ EdgeList @ First[comp[hsym]][\"Hypergraph\"]\
\>", "Input",ExpressionUUID->"540edf9e-c78f-8343-ba2b-4418382c3978"],

Cell[BoxData[
 RowBox[{"{", 
  TemplateBox[{"\"{\"", "f", "g", "\"}\""},
   "RowDefault"], "}"}]], "Output",ExpressionUUID->"c8a25ed8-7d05-3944-b23b-\
9bc4f46ac685"],

Cell["\<\
Vertex labels bind too, so a rule whose whole input is one labelled vertex \
can name what it creates after it:\
\>", "ExampleText",ExpressionUUID->"d517c580-0976-5a45-be37-97f46f13e05a"],

Cell["\<\
obj = Hypergraph[{Vertex[1, r], Vertex[2, s]}, {Edge[{1, 2}, \"Directed\", \
u]}];
unit = HypergraphRule[
   Hypergraph[{Vertex[1, p]}, {}],
   Hypergraph[{Vertex[1, p], Vertex[2, p]}, {Edge[{1, 2}, \"Directed\", \
Subscript[\"1\", p]]}]];
#[\"LabelBindings\"] & /@ unit[obj]\
\>", "Input",ExpressionUUID->"9326389c-1d2e-0540-8c57-c8919117cf95"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{"p", "\[Rule]", "r"}], "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{"p", "\[Rule]", "s"}], "\[RightAssociation]"}]}], "}"}]], "Output",\
ExpressionUUID->"42dcfe46-109b-db48-950e-32b38b5b3987"],

Cell["EdgeLabel /@ EdgeList @ First[unit[obj]][\"Hypergraph\"]", "Input",ExpressionUUID->"8217ebcd-2001-6b42-b3f7-4441e32cc0cd"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "4"}], "}"}]}], "}"}], ",", 
   SubscriptBox["\<\"1\"\>", "r"]}], "}"}]], "Output",ExpressionUUID->\
"724bd597-8f01-ba41-93ce-dc1dcecf25fe"],

Cell["A rule that does not apply gives no events:", "ExampleText",ExpressionUUID->"45c8cc10-2cde-6443-a3ee-28aa9096432e"],

Cell["\<\
HypergraphRule[{{1, 2}, {2, 3}}, {}][Hypergraph[{Edge[{1, 2}]}]]\
\>", "Input",ExpressionUUID->"8bb9ff22-4a67-324d-9443-b1a09e37eb63"],

Cell[BoxData[
 RowBox[{"{", "}"}]], "Output",ExpressionUUID->"b105fe34-5f29-e845-8fb6-5debc7647ab4"],

