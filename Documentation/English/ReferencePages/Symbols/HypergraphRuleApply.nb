Cell["The results of both events, as edge lists:", "ExampleText",ExpressionUUID->"6c14113a-5f4c-c945-a3bd-9664e73ff82a"],

Cell["EdgeList[#[\"Hypergraph\"]] & /@ events", "Input",ExpressionUUID->"8848483d-7faf-0c40-adfd-60c4dbae06a5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Edge", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Vertex", "[", "1", "]"}], ",", 
         RowBox[{"Vertex", "[", 
          RowBox[{"\[FormalV]", "[", "1", "]"}], "]"}]}], "}"}], 
       ",", "\<\"Directed\"\>"}], "]"}], ",", 
     RowBox[{"Edge", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Vertex", "[", "2", "]"}], ",", 
         RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], 
       ",", "\<\"Directed\"\>"}], "]"}], ",", 
     RowBox[{"Edge", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Vertex", "[", 
          RowBox[{"\[FormalV]", "[", "1", "]"}], "]"}], ",", 
         RowBox[{"Vertex", "[", "2", "]"}]}], "}"}], 
       ",", "\<\"Directed\"\>"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Edge", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Vertex", "[", "1", "]"}], ",", 
         RowBox[{"Vertex", "[", "2", "]"}]}], "}"}], 
       ",", "\<\"Directed\"\>"}], "]"}], ",", 
     RowBox[{"Edge", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Vertex", "[", "2", "]"}], ",", 
         RowBox[{"Vertex", "[", 
          RowBox[{"\[FormalV]", "[", "1", "]"}], "]"}]}], "}"}], 
       ",", "\<\"Directed\"\>"}], "]"}], ",", 
     RowBox[{"Edge", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Vertex", "[", 
          RowBox[{"\[FormalV]", "[", "1", "]"}], "]"}], ",", 
         RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], 
       ",", "\<\"Directed\"\>"}], "]"}]}], "}"}]}], "}"}]], "Output",Expressio\
nUUID->"e1876fab-4f41-984b-bd02-43b27ff3593d"],

Cell["\<\
A rule that destroys a vertex does so only when nothing else holds it:\
\>", "ExampleText",ExpressionUUID->"de12fa1b-4021-2d4f-80ca-fa80e7731dba"],

Cell["\<\
del = HypergraphRule[{{1, 2}}, {{1}}];
{VertexList @ First[del[Hypergraph[{Edge[{1, 2}]}]]][\"Hypergraph\"],
 VertexList @ First[del[Hypergraph[{Edge[{1, 2}], Edge[{2, \
3}]}]]][\"Hypergraph\"]}\
\>", "Input",ExpressionUUID->"4c22dd4c-76b6-8244-961c-26df3f9cb242"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"Vertex", "[", "1", "]"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Vertex", "[", "1", "]"}], ",", 
     RowBox[{"Vertex", "[", "2", "]"}], ",", 
     RowBox[{"Vertex", "[", "3", "]"}]}], "}"}]}], "}"}]], "Output",Expression\
UUID->"6f9967a5-df02-e340-8e8a-1bfe468e4a71"],

Cell["\<\
A literal label on the pattern narrows what the rule applies to:\
\>", "ExampleText",ExpressionUUID->"762dc11b-89f2-9f47-8523-44c5bf86ca61"],

Cell["\<\
hl = Hypergraph[{Edge[{1, 2}, \"Directed\", \"a\"], Edge[{2, 3}, \
\"Directed\", \"b\"]}];
{Length @ HypergraphRuleMatches[HypergraphRule[{{1, 2}}, {}], hl],
 Length @ HypergraphRuleMatches[HypergraphRule[{Edge[{1, 2}, \"Directed\", \
\"a\"]}, {}], hl]}\
\>", "Input",ExpressionUUID->"54cdc6ed-fab3-1043-a421-7f7a290260bb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "1"}], "}"}]], "Output",ExpressionUUID->"219fba07-5b42-e04f-950a-52782c868817"],

Cell["\<\
A symbol, by contrast, matches any label and remembers what it found:\
\>", "ExampleText",ExpressionUUID->"3511d705-5c5d-9844-8639-40eaa17f6d7e"],

Cell["\<\
hsym = Hypergraph[{Edge[{1, 2}, \"Directed\", f], Edge[{2, 3}, \"Directed\", \
g]}];
#[\"LabelBindings\"] & /@ HypergraphRuleMatches[HypergraphRule[{Edge[{1, 2}, \
\"Directed\", x]}, {}], hsym]\
\>", "Input",ExpressionUUID->"99973554-b89d-844d-a4a8-e35c50cfd91c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{"x", "\[Rule]", "f"}], "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{"x", "\[Rule]", "g"}], "\[RightAssociation]"}]}], "}"}]], "Output",\
ExpressionUUID->"1f05c203-688e-bc44-a748-702a8ed403a9"],

Cell["\<\
\[Ellipsis] so the output can be named after it. Composing two labelled edges \
into one:\
\>", "ExampleText",ExpressionUUID->"e8be8bb1-9ee1-fd4a-9425-8809115431ff"],

Cell["\<\
comp = HypergraphRule[
   {Edge[{1, 2}, \"Directed\", x], Edge[{2, 3}, \"Directed\", y]},
   {Edge[{1, 3}, \"Directed\", Row[{\"{\", x, y, \"}\"}]]}];
EdgeLabel /@ EdgeList @ First[comp[hsym]][\"Hypergraph\"]\
\>", "Input",ExpressionUUID->"af5584b8-c7c5-324e-8f34-07f1717f8b1e"],

Cell[BoxData[
 RowBox[{"{", 
  TemplateBox[{"\"{\"", "f", "g", "\"}\""},
   "RowDefault"], "}"}]], "Output",ExpressionUUID->"fc06519d-de19-3a44-b0cd-\
b64031f45aa5"],

Cell["\<\
Vertex labels bind too, so a rule whose whole input is one labelled vertex \
can name what it creates after it:\
\>", "ExampleText",ExpressionUUID->"2dd9c271-42b0-8b43-83c1-1dad12d02dd5"],

Cell["\<\
obj = Hypergraph[{Vertex[1, r], Vertex[2, s]}, {Edge[{1, 2}, \"Directed\", \
u]}];
unit = HypergraphRule[
   Hypergraph[{Vertex[1, p]}, {}],
   Hypergraph[{Vertex[1, p], Vertex[2, p]}, {Edge[{1, 2}, \"Directed\", \
Subscript[\"1\", p]]}]];
#[\"LabelBindings\"] & /@ unit[obj]\
\>", "Input",ExpressionUUID->"4cf7c560-f8ff-fc47-8144-a922c0ed763d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{"p", "\[Rule]", "r"}], "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{"p", "\[Rule]", "s"}], "\[RightAssociation]"}]}], "}"}]], "Output",\
ExpressionUUID->"b494cfd3-ad95-d048-bc19-8e142519fd63"],

Cell["EdgeLabel /@ EdgeList @ First[unit[obj]][\"Hypergraph\"]", "Input",ExpressionUUID->"5bd15342-b428-8849-ad79-d78303761814"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "4"}], "}"}]}], "}"}], ",", 
   SubscriptBox["\<\"1\"\>", "r"]}], "}"}]], "Output",ExpressionUUID->\
"52101757-be11-e748-9b1e-4bc4fc5802e8"],

Cell["A rule that does not apply gives no events:", "ExampleText",ExpressionUUID->"5a7437d0-6534-8943-984c-113dbb74d120"],

Cell["\<\
HypergraphRule[{{1, 2}, {2, 3}}, {}][Hypergraph[{Edge[{1, 2}]}]]\
\>", "Input",ExpressionUUID->"a5a5c8c6-95fa-0f45-9857-baa040db6337"],

Cell[BoxData[
 RowBox[{"{", "}"}]], "Output",ExpressionUUID->"5bfba15c-6dfa-ec4c-9274-696bccae97c2"],

