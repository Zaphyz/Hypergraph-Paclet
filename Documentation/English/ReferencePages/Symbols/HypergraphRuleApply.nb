Cell["The results of both events, as edge lists:", "ExampleText",ExpressionUUID->"d8286590-2231-6544-931b-054daa267ce5"],

Cell["EdgeList[#[\"Hypergraph\"]] & /@ events", "Input",ExpressionUUID->"a6163a43-74da-5a4b-8848-1e382607ebd0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Edge", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Vertex", "[", "1", "]"}], ",", 
         RowBox[{"Vertex", "[", 
          RowBox[{"\[FormalV]", "[", "1", "]"}], "]"}]}], "}"}], 
       ",", "\<\"Directed\"\>"}], "]"}], ",", 
     RowBox[{"Edge", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Vertex", "[", "2", "]"}], ",", 
         RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], 
       ",", "\<\"Directed\"\>"}], "]"}], ",", 
     RowBox[{"Edge", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Vertex", "[", 
          RowBox[{"\[FormalV]", "[", "1", "]"}], "]"}], ",", 
         RowBox[{"Vertex", "[", "2", "]"}]}], "}"}], 
       ",", "\<\"Directed\"\>"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Edge", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Vertex", "[", "1", "]"}], ",", 
         RowBox[{"Vertex", "[", "2", "]"}]}], "}"}], 
       ",", "\<\"Directed\"\>"}], "]"}], ",", 
     RowBox[{"Edge", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Vertex", "[", "2", "]"}], ",", 
         RowBox[{"Vertex", "[", 
          RowBox[{"\[FormalV]", "[", "1", "]"}], "]"}]}], "}"}], 
       ",", "\<\"Directed\"\>"}], "]"}], ",", 
     RowBox[{"Edge", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Vertex", "[", 
          RowBox[{"\[FormalV]", "[", "1", "]"}], "]"}], ",", 
         RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], 
       ",", "\<\"Directed\"\>"}], "]"}]}], "}"}]}], "}"}]], "Output",Expressio\
nUUID->"6b4d59df-a976-964e-8274-877d4d2337ba"],

Cell["\<\
A rule that destroys a vertex does so only when nothing else holds it:\
\>", "ExampleText",ExpressionUUID->"980e24a6-f6d8-594e-a87f-4a9151c2fddf"],

Cell["\<\
del = HypergraphRule[{{1, 2}}, {{1}}];
{VertexList @ First[del[Hypergraph[{Edge[{1, 2}]}]]][\"Hypergraph\"],
 VertexList @ First[del[Hypergraph[{Edge[{1, 2}], Edge[{2, \
3}]}]]][\"Hypergraph\"]}\
\>", "Input",ExpressionUUID->"a90eb4b6-8df4-f94b-ba74-63ed43cdf70a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"Vertex", "[", "1", "]"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Vertex", "[", "1", "]"}], ",", 
     RowBox[{"Vertex", "[", "2", "]"}], ",", 
     RowBox[{"Vertex", "[", "3", "]"}]}], "}"}]}], "}"}]], "Output",Expression\
UUID->"fd860b33-00a9-e34e-a87c-14edda9362be"],

Cell["\<\
A literal label on the pattern narrows what the rule applies to:\
\>", "ExampleText",ExpressionUUID->"82308aa1-15c7-d645-8aff-55d54f6176d5"],

Cell["\<\
hl = Hypergraph[{Edge[{1, 2}, \"Directed\", \"a\"], Edge[{2, 3}, \
\"Directed\", \"b\"]}];
{Length @ HypergraphRuleMatches[HypergraphRule[{{1, 2}}, {}], hl],
 Length @ HypergraphRuleMatches[HypergraphRule[{Edge[{1, 2}, \"Directed\", \
\"a\"]}, {}], hl]}\
\>", "Input",ExpressionUUID->"5855f6e0-2a4a-324b-8445-76a2694b2226"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "1"}], "}"}]], "Output",ExpressionUUID->"f726dfde-68ce-4641-a385-3a9d60a59418"],

Cell["\<\
A symbol, by contrast, matches any label and remembers what it found:\
\>", "ExampleText",ExpressionUUID->"80240742-a362-f247-b76f-d814c279f8ed"],

Cell["\<\
hsym = Hypergraph[{Edge[{1, 2}, \"Directed\", f], Edge[{2, 3}, \"Directed\", \
g]}];
#[\"LabelBindings\"] & /@ HypergraphRuleMatches[HypergraphRule[{Edge[{1, 2}, \
\"Directed\", x]}, {}], hsym]\
\>", "Input",ExpressionUUID->"7c884be9-ae2b-3f42-897a-2059006693b9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{"x", "\[Rule]", "f"}], "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{"x", "\[Rule]", "g"}], "\[RightAssociation]"}]}], "}"}]], "Output",\
ExpressionUUID->"9cbb07ae-0228-224c-8f76-294fdb0bb79f"],

Cell["\<\
\[Ellipsis] so the output can be named after it. Composing two labelled edges \
into one:\
\>", "ExampleText",ExpressionUUID->"68520ee0-25a4-e94f-bfb0-482f88bba499"],

Cell["\<\
comp = HypergraphRule[
   {Edge[{1, 2}, \"Directed\", x], Edge[{2, 3}, \"Directed\", y]},
   {Edge[{1, 3}, \"Directed\", Row[{\"{\", x, y, \"}\"}]]}];
EdgeLabel /@ EdgeList @ First[comp[hsym]][\"Hypergraph\"]\
\>", "Input",ExpressionUUID->"43f879f0-3f95-0645-bc38-eca6491f93d9"],

Cell[BoxData[
 RowBox[{"{", 
  TemplateBox[{"\"{\"", "f", "g", "\"}\""},
   "RowDefault"], "}"}]], "Output",ExpressionUUID->"b29bb5d1-22e7-5e4a-9da4-\
da4b72dc7612"],

Cell["\<\
Vertex labels bind too, so a rule whose whole input is one labelled vertex \
can name what it creates after it:\
\>", "ExampleText",ExpressionUUID->"19bb2b7c-4330-f248-ac9a-1aa1c9e7f3a4"],

Cell["\<\
obj = Hypergraph[{Vertex[1, r], Vertex[2, s]}, {Edge[{1, 2}, \"Directed\", \
u]}];
unit = HypergraphRule[
   Hypergraph[{Vertex[1, p]}, {}],
   Hypergraph[{Vertex[1, p], Vertex[2, p]}, {Edge[{1, 2}, \"Directed\", \
Subscript[\"1\", p]]}]];
#[\"LabelBindings\"] & /@ unit[obj]\
\>", "Input",ExpressionUUID->"213b397e-7960-df4f-9358-a276f4dff342"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{"p", "\[Rule]", "r"}], "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{"p", "\[Rule]", "s"}], "\[RightAssociation]"}]}], "}"}]], "Output",\
ExpressionUUID->"a1cb7ead-a986-2e4f-8f93-b1e8a607fedf"],

Cell["EdgeLabel /@ EdgeList @ First[unit[obj]][\"Hypergraph\"]", "Input",ExpressionUUID->"4a0ea293-f30a-7d43-99e8-fad8e6005aeb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "4"}], "}"}]}], "}"}], ",", 
   SubscriptBox["\<\"1\"\>", "r"]}], "}"}]], "Output",ExpressionUUID->\
"b96b16c0-1b61-3242-846c-89104d0da4ac"],

Cell["A rule that does not apply gives no events:", "ExampleText",ExpressionUUID->"580e2059-4e47-6643-b570-5ecb9e254857"],

Cell["\<\
HypergraphRule[{{1, 2}, {2, 3}}, {}][Hypergraph[{Edge[{1, 2}]}]]\
\>", "Input",ExpressionUUID->"7c0b84c3-eefb-5049-8f79-5a828b996ff0"],

Cell[BoxData[
 RowBox[{"{", "}"}]], "Output",ExpressionUUID->"524175da-5e1a-3e47-87ef-5958da1845d4"],

