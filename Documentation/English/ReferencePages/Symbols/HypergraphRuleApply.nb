Cell["The results of both events, as edge lists:", "ExampleText",ExpressionUUID->"5eef50a2-e54f-e549-a861-ff7bf2b0b1e6"],

Cell["EdgeList[#[\"Hypergraph\"]] & /@ events", "Input",ExpressionUUID->"1c375833-771c-ce4f-b9ce-c06c0df4570b"],

