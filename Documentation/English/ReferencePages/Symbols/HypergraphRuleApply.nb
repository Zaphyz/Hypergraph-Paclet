Cell["\<\
A rule that destroys a vertex does so only when nothing else holds it:\
\>", "ExampleText",ExpressionUUID->"288dccb9-e37b-e94b-a88f-73013d4e6dbc"],

Cell["\<\
del = HypergraphRule[{{1, 2}}, {{1}}];
{VertexList @ First[del[Hypergraph[{Edge[{1, 2}]}]]][\"Hypergraph\"],
 VertexList @ First[del[Hypergraph[{Edge[{1, 2}], Edge[{2, \
3}]}]]][\"Hypergraph\"]}\
\>", "Input",ExpressionUUID->"e122fe3f-dfea-0848-8ae6-15edea77a31b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"Vertex", "[", "1", "]"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Vertex", "[", "1", "]"}], ",", 
     RowBox[{"Vertex", "[", "2", "]"}], ",", 
     RowBox[{"Vertex", "[", "3", "]"}]}], "}"}]}], "}"}]], "Output",Expression\
UUID->"99acc6a3-633f-b44f-8d0e-56cc8f333b2a"],

Cell["A label on the pattern narrows what the rule applies to:", "ExampleText",ExpressionUUID->"e6d39e5b-74b1-0942-a4b0-81dc46975602"],

Cell["\<\
hl = Hypergraph[{Edge[{1, 2}, \"Directed\", \"a\"], Edge[{2, 3}, \
\"Directed\", \"b\"]}];
{Length @ HypergraphRuleMatches[HypergraphRule[{{1, 2}}, {}], hl],
 Length @ HypergraphRuleMatches[HypergraphRule[{Edge[{1, 2}, \"Directed\", \
\"a\"]}, {}], hl]}\
\>", "Input",ExpressionUUID->"3a8b47d6-3256-f540-a276-b1244f5fe94a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "1"}], "}"}]], "Output",ExpressionUUID->"6cbc6343-955a-2f4f-9812-552360796044"],

Cell["A rule that does not apply gives no events:", "ExampleText",ExpressionUUID->"ec0ed9e2-6003-224c-9d72-41be9e936636"],

Cell["\<\
HypergraphRule[{{1, 2}, {2, 3}}, {}][Hypergraph[{Edge[{1, 2}]}]]\
\>", "Input",ExpressionUUID->"3429c738-6ae0-4b4e-b202-511fa87fe07d"],

Cell[BoxData[
 RowBox[{"{", "}"}]], "Output",ExpressionUUID->"c9df6101-5af8-444d-b3d8-a70059e0fcb8"],

