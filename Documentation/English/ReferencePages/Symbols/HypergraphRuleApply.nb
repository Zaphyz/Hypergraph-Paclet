Cell["The results of both events, as edge lists:", "ExampleText",ExpressionUUID->"fd18ff7a-329a-bb49-8a49-15a91d096f1e"],

Cell["EdgeList[#[\"Hypergraph\"]] & /@ events", "Input",ExpressionUUID->"24c5f47b-1859-124e-a010-289940baac60"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Edge", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Vertex", "[", "1", "]"}], ",", 
         RowBox[{"Vertex", "[", 
          RowBox[{"\[FormalV]", "[", "1", "]"}], "]"}]}], "}"}], 
       ",", "\<\"Directed\"\>"}], "]"}], ",", 
     RowBox[{"Edge", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Vertex", "[", "2", "]"}], ",", 
         RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], 
       ",", "\<\"Directed\"\>"}], "]"}], ",", 
     RowBox[{"Edge", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Vertex", "[", 
          RowBox[{"\[FormalV]", "[", "1", "]"}], "]"}], ",", 
         RowBox[{"Vertex", "[", "2", "]"}]}], "}"}], 
       ",", "\<\"Directed\"\>"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Edge", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Vertex", "[", "1", "]"}], ",", 
         RowBox[{"Vertex", "[", "2", "]"}]}], "}"}], 
       ",", "\<\"Directed\"\>"}], "]"}], ",", 
     RowBox[{"Edge", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Vertex", "[", "2", "]"}], ",", 
         RowBox[{"Vertex", "[", 
          RowBox[{"\[FormalV]", "[", "1", "]"}], "]"}]}], "}"}], 
       ",", "\<\"Directed\"\>"}], "]"}], ",", 
     RowBox[{"Edge", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Vertex", "[", 
          RowBox[{"\[FormalV]", "[", "1", "]"}], "]"}], ",", 
         RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], 
       ",", "\<\"Directed\"\>"}], "]"}]}], "}"}]}], "}"}]], "Output",Expressio\
nUUID->"121a5dce-abee-194f-9a6c-b232219ec7d9"],

Cell["\<\
A rule that destroys a vertex does so only when nothing else holds it:\
\>", "ExampleText",ExpressionUUID->"40083bb1-941e-6345-9520-e2a8211f1230"],

Cell["\<\
del = HypergraphRule[{{1, 2}}, {{1}}];
{VertexList @ First[del[Hypergraph[{Edge[{1, 2}]}]]][\"Hypergraph\"],
 VertexList @ First[del[Hypergraph[{Edge[{1, 2}], Edge[{2, \
3}]}]]][\"Hypergraph\"]}\
\>", "Input",ExpressionUUID->"49b7aa49-4f7a-d140-bc6a-38fd5a1a880a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"Vertex", "[", "1", "]"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Vertex", "[", "1", "]"}], ",", 
     RowBox[{"Vertex", "[", "2", "]"}], ",", 
     RowBox[{"Vertex", "[", "3", "]"}]}], "}"}]}], "}"}]], "Output",Expression\
UUID->"d33ecae4-ab39-5f45-8396-c5ede9e697e2"],

Cell["\<\
A literal label on the pattern narrows what the rule applies to:\
\>", "ExampleText",ExpressionUUID->"729dde8e-2d12-7f4b-9329-13837d7c6a1c"],

Cell["\<\
hl = Hypergraph[{Edge[{1, 2}, \"Directed\", \"a\"], Edge[{2, 3}, \
\"Directed\", \"b\"]}];
{Length @ HypergraphRuleMatches[HypergraphRule[{{1, 2}}, {}], hl],
 Length @ HypergraphRuleMatches[HypergraphRule[{Edge[{1, 2}, \"Directed\", \
\"a\"]}, {}], hl]}\
\>", "Input",ExpressionUUID->"f448c36b-36ed-f64b-8f4f-3c3bf5cb0dd1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "1"}], "}"}]], "Output",ExpressionUUID->"d3475844-e955-9341-9fb6-718c2000717b"],

Cell["\<\
A symbol, by contrast, matches any label and remembers what it found:\
\>", "ExampleText",ExpressionUUID->"d90c7c14-c9a4-e84b-bb77-88a5ff87f47d"],

Cell["\<\
hsym = Hypergraph[{Edge[{1, 2}, \"Directed\", f], Edge[{2, 3}, \"Directed\", \
g]}];
#[\"LabelBindings\"] & /@ HypergraphRuleMatches[HypergraphRule[{Edge[{1, 2}, \
\"Directed\", x]}, {}], hsym]\
\>", "Input",ExpressionUUID->"a913fb8c-4707-ad4f-9b4f-6b5b7a3e4755"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{"x", "\[Rule]", "f"}], "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{"x", "\[Rule]", "g"}], "\[RightAssociation]"}]}], "}"}]], "Output",\
ExpressionUUID->"864df0e9-2554-674c-8d33-9b67a91874fa"],

Cell["\<\
\[Ellipsis] so the output can be named after it. Composing two labelled edges \
into one:\
\>", "ExampleText",ExpressionUUID->"347d0870-1897-3e45-9b09-a16503e4e8bf"],

Cell["\<\
comp = HypergraphRule[
   {Edge[{1, 2}, \"Directed\", x], Edge[{2, 3}, \"Directed\", y]},
   {Edge[{1, 3}, \"Directed\", Row[{\"{\", x, y, \"}\"}]]}];
EdgeLabel /@ EdgeList @ First[comp[hsym]][\"Hypergraph\"]\
\>", "Input",ExpressionUUID->"f7d6325f-1865-364c-aaf1-00dc871fcac6"],

Cell[BoxData[
 RowBox[{"{", 
  TemplateBox[{"\"{\"", "f", "g", "\"}\""},
   "RowDefault"], "}"}]], "Output",ExpressionUUID->"ba26321b-a813-f340-8084-\
f2e7f4e5573a"],

Cell["\<\
Vertex labels bind too, so a rule whose whole input is one labelled vertex \
can name what it creates after it:\
\>", "ExampleText",ExpressionUUID->"b945a719-5059-d04e-a9a2-a01194087863"],

Cell["\<\
obj = Hypergraph[{Vertex[1, r], Vertex[2, s]}, {Edge[{1, 2}, \"Directed\", \
u]}];
unit = HypergraphRule[
   Hypergraph[{Vertex[1, p]}, {}],
   Hypergraph[{Vertex[1, p], Vertex[2, p]}, {Edge[{1, 2}, \"Directed\", \
Subscript[\"1\", p]]}]];
#[\"LabelBindings\"] & /@ unit[obj]\
\>", "Input",ExpressionUUID->"9bcf6966-bb69-cc43-9b68-ec41806917f6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{"p", "\[Rule]", "r"}], "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{"p", "\[Rule]", "s"}], "\[RightAssociation]"}]}], "}"}]], "Output",\
ExpressionUUID->"3f47e93b-13bd-7e40-8414-3059b404a47f"],

Cell["EdgeLabel /@ EdgeList @ First[unit[obj]][\"Hypergraph\"]", "Input",ExpressionUUID->"709fc35e-6e16-184d-bd98-851585025806"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "4"}], "}"}]}], "}"}], ",", 
   SubscriptBox["\<\"1\"\>", "r"]}], "}"}]], "Output",ExpressionUUID->\
"f20c83cd-7e28-e246-93d1-48cb9d4f7857"],

Cell["A rule that does not apply gives no events:", "ExampleText",ExpressionUUID->"0e863b05-5003-f141-ae94-1b63109ab39a"],

Cell["\<\
HypergraphRule[{{1, 2}, {2, 3}}, {}][Hypergraph[{Edge[{1, 2}]}]]\
\>", "Input",ExpressionUUID->"560a0705-80e0-9f40-85c5-6f7b2e1501ea"],

Cell[BoxData[
 RowBox[{"{", "}"}]], "Output",ExpressionUUID->"2f721b9d-2a5a-7942-84a1-95948958cd0f"],

