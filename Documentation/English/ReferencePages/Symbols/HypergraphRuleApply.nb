Cell["The results of both events, as edge lists:", "ExampleText",ExpressionUUID->"867d6170-be7d-4c4d-9e38-1ba440a3fcd1"],

Cell["EdgeList[#[\"Hypergraph\"]] & /@ events", "Input",ExpressionUUID->"ce53e9d4-3cae-5044-8292-c83a868d2054"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Edge", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Vertex", "[", "1", "]"}], ",", 
         RowBox[{"Vertex", "[", 
          RowBox[{"\[FormalV]", "[", "1", "]"}], "]"}]}], "}"}], 
       ",", "\<\"Directed\"\>"}], "]"}], ",", 
     RowBox[{"Edge", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Vertex", "[", "2", "]"}], ",", 
         RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], 
       ",", "\<\"Directed\"\>"}], "]"}], ",", 
     RowBox[{"Edge", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Vertex", "[", 
          RowBox[{"\[FormalV]", "[", "1", "]"}], "]"}], ",", 
         RowBox[{"Vertex", "[", "2", "]"}]}], "}"}], 
       ",", "\<\"Directed\"\>"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Edge", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Vertex", "[", "1", "]"}], ",", 
         RowBox[{"Vertex", "[", "2", "]"}]}], "}"}], 
       ",", "\<\"Directed\"\>"}], "]"}], ",", 
     RowBox[{"Edge", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Vertex", "[", "2", "]"}], ",", 
