Notebook[{
Cell["HypergraphRuleMatches", "ObjectName",ExpressionUUID->"44d251f6-59a1-df4b-b49e-af2ef6e9b29f"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypergraphRuleMatches", "[", 
    RowBox[{"rule", ",", " ", "hg"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"8d0d388b-3a54-1641-b70c-346500b1c214"],
 " ",
 "gives the ways the input of rule sits inside hg, without rewriting anything."
}], "Usage",ExpressionUUID->"03dc0409-0322-6942-9fc9-c3377194d93e"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"e91ceeb2-4605-5b4f-91f0-bebdef3df48c"],

Cell["\<\
Each match is an association with \"MatchEdgePositions\", the positions in \
EdgeList[hg] that the input's edges lie on, and \"RuleVertexMap\", the \
correspondence from the input's vertices to the hypergraph's.\
\>", "Notes",ExpressionUUID->"93746a97-969c-c843-96b5-02d71e6bc949"],

Cell["\<\
It takes the same options as HypergraphRuleApply, and is what that function \
matches with; asking for the matches alone is the way to see why a rule \
applies as often as it does.\
\>", "Notes",ExpressionUUID->"86081f4b-6e92-7b40-ba34-4813fc8aac63"],

Cell["\<\
An edge of the hypergraph is used by at most one edge of the input, so a rule \
whose input has two edges wants two of them.\
\>", "Notes",ExpressionUUID->"7fcfa9be-2d80-de4a-8ee6-471a7410a04e"],

Cell["\<\
A vertex of the input lying in no edge constrains nothing, and is matched to \
each vertex not already taken in turn.\
\>", "Notes",ExpressionUUID->"67b1baf0-0743-de42-899f-d224ad883be2"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"cc2aed3e-9ddd-8241-b173-91e014546fb9"],

Cell["\<\
HypergraphRuleMatches[HypergraphRule[{{1, 2}}, {}],
   Hypergraph[{Edge[{1, 2}], Edge[{2, 3}]}]]\
\>", "Input",ExpressionUUID->"74a4e761-86be-d44c-be96-5690c0f52c64"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"MatchEdgePositions\"\>", "\[Rule]", 
      RowBox[{"{", "1", "}"}]}], ",", 
     RowBox[{"\<\"RuleVertexMap\"\>", "\[Rule]", 
      RowBox[{"\[LeftAssociation]", 
       RowBox[{
        RowBox[{"1", "\[Rule]", "1"}], ",", 
        RowBox[{"2", "\[Rule]", "2"}]}], "\[RightAssociation]"}]}], ",", 
     RowBox[{"\<\"LabelBindings\"\>", "\[Rule]", 
      RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}]}], 
    "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"MatchEdgePositions\"\>", "\[Rule]", 
      RowBox[{"{", "2", "}"}]}], ",", 
     RowBox[{"\<\"RuleVertexMap\"\>", "\[Rule]", 
      RowBox[{"\[LeftAssociation]", 
       RowBox[{
        RowBox[{"1", "\[Rule]", "2"}], ",", 
        RowBox[{"2", "\[Rule]", "3"}]}], "\[RightAssociation]"}]}], ",", 
     RowBox[{"\<\"LabelBindings\"\>", "\[Rule]", 
      RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}]}], 
    "\[RightAssociation]"}]}], "}"}]], "Output",ExpressionUUID->"0bf9d9fa-\
f1c4-d948-bed6-f9536f7b46bc"],

Cell["\<\
An unordered edge matches in as many ways as its vertices can be ordered:\
\>", "ExampleText",ExpressionUUID->"caf7ee00-6f90-c548-9723-edff6ed094be"],

Cell["\<\
Length @ HypergraphRuleMatches[HypergraphRule[{Edge[{1, 2, 3}, \
\"Unordered\"]}, {}],
   Hypergraph[{Edge[{1, 2, 3}, \"Unordered\"]}]]\
\>", "Input",ExpressionUUID->"f106cc85-c939-2949-8799-f798d869d922"],

Cell[BoxData["6"], "Output",ExpressionUUID->"e822153a-7dfc-534c-9014-ad27d1e40ff2"],

Cell["\<\
\[Ellipsis] a cyclic one in as many ways as it can be rotated, and a directed \
one in one way:\
\>", "ExampleText",ExpressionUUID->"39bfb51a-a562-d642-8859-fee453c72f16"],

Cell["\<\
{Length @ HypergraphRuleMatches[HypergraphRule[{Edge[{1, 2, 3}, \"Cyclic\"]}, \
{}],
    Hypergraph[{Edge[{1, 2, 3}, \"Cyclic\"]}]],
 Length @ HypergraphRuleMatches[HypergraphRule[{Edge[{1, 2, 3}, \
\"Directed\"]}, {}],
    Hypergraph[{Edge[{1, 2, 3}, \"Directed\"]}]]}\
\>", "Input",ExpressionUUID->"4aafb880-a5dc-ce4d-aac4-ccbe396a68b1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"3", ",", "1"}], "}"}]], "Output",ExpressionUUID->"d9e71ce2-8b2b-0c42-b965-46a2a581f2bc"],

Cell["\<\
Two vertices of the input will not land on one, unless that is allowed:\
\>", "ExampleText",ExpressionUUID->"58e458c0-a41d-2244-8db8-c8c526b1b544"],

Cell["\<\
{HypergraphRuleMatches[HypergraphRule[{{1, 2}}, {}], Hypergraph[{Edge[{1, \
1}]}]],
 Length @ HypergraphRuleMatches[HypergraphRule[{{1, 2}}, {}], \
Hypergraph[{Edge[{1, 1}]}],
    \"DistinctVertices\" -> False]}\
\>", "Input",ExpressionUUID->"9bc0c0e3-e01e-4b4c-8d3e-baa46609ebb5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "}"}], ",", "1"}], "}"}]], "Output",ExpressionUUID->"e27692d5-\
f22f-7247-8ae9-f6b213c344cb"],

Cell["Source", "NotesSection",ExpressionUUID->"feeb5307-fadc-5a42-bedf-f9e59d7d96c4"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Rewriting.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Matching",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"1eb893f3-3f6b-1f47-801d-25fc731ff18b"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"646ec2ea-ffd7-9e40-b030-22a2cd143043"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["HypergraphRuleApply", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"357418bb-19e2-a145-b563-6961477fe9f4"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphRule", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "c1afca14-3bd9-494d-914b-5e0bdeb3f3dd"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeList", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "be690685-4b35-7347-962e-48988a7b58f2"]
}], "SeeAlso",ExpressionUUID->"779f2c38-b2c3-7d4f-929e-1ee61300566d"]
},
