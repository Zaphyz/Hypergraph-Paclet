Notebook[{
Cell["HypergraphRuleMatches", "ObjectName",ExpressionUUID->"4524c14e-d66b-6748-86a0-0a2df4b13e80"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypergraphRuleMatches", "[", 
    RowBox[{"rule", ",", " ", "hg"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"7e136c62-40e5-6f4e-a7fb-bba5a4dc88bf"],
 " ",
 "gives the ways the input of rule sits inside hg, without rewriting anything."
}], "Usage",ExpressionUUID->"963e891c-34a3-6a42-9dcc-7b3547f3c34b"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"f6f6cf1d-2976-044a-9eaa-cc04163576f2"],

Cell["\<\
Each match is an association with \"MatchEdgePositions\", the positions in \
EdgeList[hg] that the input's edges lie on, and \"RuleVertexMap\", the \
correspondence from the input's vertices to the hypergraph's.\
\>", "Notes",ExpressionUUID->"574ec1fe-6ffa-404a-a97a-e361a752f951"],

Cell["\<\
It takes the same options as HypergraphRuleApply, and is what that function \
matches with; asking for the matches alone is the way to see why a rule \
applies as often as it does.\
\>", "Notes",ExpressionUUID->"f99e1e9c-3d72-b945-a717-a61ec90d7c2e"],

Cell["\<\
An edge of the hypergraph is used by at most one edge of the input, so a rule \
whose input has two edges wants two of them.\
\>", "Notes",ExpressionUUID->"c9652581-b073-934d-9ee8-b365cb333361"],

Cell["\<\
A vertex of the input lying in no edge constrains nothing, and is matched to \
each vertex not already taken in turn.\
\>", "Notes",ExpressionUUID->"f830a275-7fb1-4346-822b-bc2b48601dc8"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"6b62b782-322a-6248-a556-588b9f786a41"],

Cell["\<\
HypergraphRuleMatches[HypergraphRule[{{1, 2}}, {}],
   Hypergraph[{Edge[{1, 2}], Edge[{2, 3}]}]]\
\>", "Input",ExpressionUUID->"50ccfad0-8ed5-724c-9664-a21d54854827"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"MatchEdgePositions\"\>", "\[Rule]", 
      RowBox[{"{", "1", "}"}]}], ",", 
     RowBox[{"\<\"RuleVertexMap\"\>", "\[Rule]", 
      RowBox[{"\[LeftAssociation]", 
       RowBox[{
        RowBox[{"1", "\[Rule]", "1"}], ",", 
        RowBox[{"2", "\[Rule]", "2"}]}], "\[RightAssociation]"}]}], ",", 
     RowBox[{"\<\"LabelBindings\"\>", "\[Rule]", 
      RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}]}], 
    "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"MatchEdgePositions\"\>", "\[Rule]", 
      RowBox[{"{", "2", "}"}]}], ",", 
     RowBox[{"\<\"RuleVertexMap\"\>", "\[Rule]", 
      RowBox[{"\[LeftAssociation]", 
       RowBox[{
        RowBox[{"1", "\[Rule]", "2"}], ",", 
        RowBox[{"2", "\[Rule]", "3"}]}], "\[RightAssociation]"}]}], ",", 
     RowBox[{"\<\"LabelBindings\"\>", "\[Rule]", 
      RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}]}], 
    "\[RightAssociation]"}]}], "}"}]], "Output",ExpressionUUID->"d3792460-\
eca4-7548-93c5-7fa2e05a8c60"],

Cell["\<\
An unordered edge matches in as many ways as its vertices can be ordered:\
\>", "ExampleText",ExpressionUUID->"6eb5fb0c-7398-7d40-ac41-2cce8cbf64b7"],

Cell["\<\
Length @ HypergraphRuleMatches[HypergraphRule[{Edge[{1, 2, 3}, \
\"Unordered\"]}, {}],
   Hypergraph[{Edge[{1, 2, 3}, \"Unordered\"]}]]\
\>", "Input",ExpressionUUID->"f3c3fdbd-5c7d-8149-ae6b-93326c6e230b"],

Cell[BoxData["6"], "Output",ExpressionUUID->"5056e3a3-e563-ba4d-a726-ec0f90d1bc7c"],

Cell["\<\
\[Ellipsis] a cyclic one in as many ways as it can be rotated, and a directed \
one in one way:\
\>", "ExampleText",ExpressionUUID->"64b49979-492c-6c43-85c1-59df278ec9f9"],

Cell["\<\
{Length @ HypergraphRuleMatches[HypergraphRule[{Edge[{1, 2, 3}, \"Cyclic\"]}, \
{}],
    Hypergraph[{Edge[{1, 2, 3}, \"Cyclic\"]}]],
 Length @ HypergraphRuleMatches[HypergraphRule[{Edge[{1, 2, 3}, \
\"Directed\"]}, {}],
    Hypergraph[{Edge[{1, 2, 3}, \"Directed\"]}]]}\
\>", "Input",ExpressionUUID->"f3462785-5c6c-1c4c-8b5a-dc95d87d3be0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"3", ",", "1"}], "}"}]], "Output",ExpressionUUID->"9b4c7be6-62ba-9e42-9e95-56e30c24d5cf"],

Cell["\<\
Two vertices of the input will not land on one, unless that is allowed:\
\>", "ExampleText",ExpressionUUID->"f46cd8c3-114a-2049-a891-952e65374798"],

Cell["\<\
{HypergraphRuleMatches[HypergraphRule[{{1, 2}}, {}], Hypergraph[{Edge[{1, \
1}]}]],
 Length @ HypergraphRuleMatches[HypergraphRule[{{1, 2}}, {}], \
Hypergraph[{Edge[{1, 1}]}],
    \"DistinctVertices\" -> False]}\
\>", "Input",ExpressionUUID->"3ec124b3-d4b7-e94a-82a9-51711c895f94"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "}"}], ",", "1"}], "}"}]], "Output",ExpressionUUID->"10c3a36f-\
69fa-534a-9e1c-4d4f470b747b"],

Cell["Source", "NotesSection",ExpressionUUID->"1516ba47-adf1-1d45-bc0e-9cb15298597a"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Rewriting.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Matching",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"ce594871-14d2-ec4d-9482-6ad1aa784f06"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"a7f2dd20-9991-c148-afb6-09dd18037e03"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["HypergraphRuleApply", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"a265425e-4bfc-5d49-9815-d68ee45cb480"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphRule", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "9ad68cc0-0dfe-d943-8832-084455e9db42"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeList", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "6bcb679f-2910-0246-beae-ee3e39862da9"]
}], "SeeAlso",ExpressionUUID->"7f9ba16f-e5c8-ea4f-9187-3b4693d42e2c"]
},
