(* Beginning of Notebook Content *)
Notebook[{
Cell["HypergraphRuleMatches", "ObjectName",ExpressionUUID->"d151402c-91b7-044e-808f-817f7cd10d15"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypergraphRuleMatches", "[", 
    RowBox[{"rule", ",", " ", "hg"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"d053dd11-cbc5-7546-985b-c939f6aab46c"],
 " ",
 "gives the ways the input of rule sits inside hg, without rewriting anything."
}], "Usage",ExpressionUUID->"b440f18f-7a64-644d-920e-9ceea6921699"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"df784441-0e68-8c42-b528-a8934265149d"],

Cell["\<\
Each match is an association with \"MatchEdgePositions\", the positions in \
EdgeList[hg] that the input's edges lie on, and \"RuleVertexMap\", the \
correspondence from the input's vertices to the hypergraph's.\
\>", "Notes",ExpressionUUID->"498236e9-4dec-d549-b583-48e5658d350f"],

Cell["\<\
It takes the same options as HypergraphRuleApply, and is what that function \
matches with; asking for the matches alone is the way to see why a rule \
applies as often as it does.\
\>", "Notes",ExpressionUUID->"855e49ef-c200-6542-a60e-0e62533f75ef"],

Cell["\<\
An edge of the hypergraph is used by at most one edge of the input, so a rule \
whose input has two edges wants two of them.\
\>", "Notes",ExpressionUUID->"1186d2f9-2c4c-8a4d-8579-201d986c0655"],

Cell["\<\
A vertex of the input lying in no edge constrains nothing, and is matched to \
each vertex not already taken in turn.\
\>", "Notes",ExpressionUUID->"cf7868c2-0ea2-6749-bdcc-9131e49de338"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"6f216918-661e-2e46-9e96-88e00d60510d"],

Cell["\<\
HypergraphRuleMatches[HypergraphRule[{{1, 2}}, {}],
   Hypergraph[{Edge[{1, 2}], Edge[{2, 3}]}]]\
\>", "Input",ExpressionUUID->"7c6a20d2-095d-5942-8ddc-c1333ebcb31c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"MatchEdgePositions\"\>", "\[Rule]", 
      RowBox[{"{", "1", "}"}]}], ",", 
     RowBox[{"\<\"RuleVertexMap\"\>", "\[Rule]", 
      RowBox[{"\[LeftAssociation]", 
       RowBox[{
        RowBox[{"1", "\[Rule]", "1"}], ",", 
        RowBox[{"2", "\[Rule]", "2"}]}], "\[RightAssociation]"}]}], ",", 
     RowBox[{"\<\"LabelBindings\"\>", "\[Rule]", 
      RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}]}], 
    "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"MatchEdgePositions\"\>", "\[Rule]", 
      RowBox[{"{", "2", "}"}]}], ",", 
     RowBox[{"\<\"RuleVertexMap\"\>", "\[Rule]", 
      RowBox[{"\[LeftAssociation]", 
       RowBox[{
        RowBox[{"1", "\[Rule]", "2"}], ",", 
        RowBox[{"2", "\[Rule]", "3"}]}], "\[RightAssociation]"}]}], ",", 
     RowBox[{"\<\"LabelBindings\"\>", "\[Rule]", 
      RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}]}], 
    "\[RightAssociation]"}]}], "}"}]], "Output",ExpressionUUID->"241e4016-\
a064-4244-acf9-de60b388fde2"],

Cell["\<\
An unordered edge matches in as many ways as its vertices can be ordered:\
\>", "ExampleText",ExpressionUUID->"5ba3ea44-0438-bb4f-9d6d-a7d042300988"],

Cell["\<\
Length @ HypergraphRuleMatches[HypergraphRule[{Edge[{1, 2, 3}, \
\"Unordered\"]}, {}],
   Hypergraph[{Edge[{1, 2, 3}, \"Unordered\"]}]]\
\>", "Input",ExpressionUUID->"c7afdd69-27a7-3646-8725-8e0088deb4b2"],

Cell[BoxData["6"], "Output",ExpressionUUID->"8a168132-58c1-9842-81b3-2da9552ecab6"],

Cell["\<\
\[Ellipsis] a cyclic one in as many ways as it can be rotated, and a directed \
one in one way:\
\>", "ExampleText",ExpressionUUID->"fd00d6db-49fe-0246-81e7-0d9840a1af44"],

Cell["\<\
{Length @ HypergraphRuleMatches[HypergraphRule[{Edge[{1, 2, 3}, \"Cyclic\"]}, \
{}],
    Hypergraph[{Edge[{1, 2, 3}, \"Cyclic\"]}]],
 Length @ HypergraphRuleMatches[HypergraphRule[{Edge[{1, 2, 3}, \
\"Directed\"]}, {}],
    Hypergraph[{Edge[{1, 2, 3}, \"Directed\"]}]]}\
\>", "Input",ExpressionUUID->"8cecae2d-0b1b-9d41-8364-f565d9d7cd31"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"3", ",", "1"}], "}"}]], "Output",ExpressionUUID->"1b31eef9-efe9-564a-8170-06281ae6a3cc"],

Cell["\<\
Two vertices of the input will not land on one, unless that is allowed:\
\>", "ExampleText",ExpressionUUID->"1c06b04c-6af2-b84b-8541-dda839c388aa"],

Cell["\<\
{HypergraphRuleMatches[HypergraphRule[{{1, 2}}, {}], Hypergraph[{Edge[{1, \
1}]}]],
 Length @ HypergraphRuleMatches[HypergraphRule[{{1, 2}}, {}], \
Hypergraph[{Edge[{1, 1}]}],
    \"DistinctVertices\" -> False]}\
\>", "Input",ExpressionUUID->"5f058c9e-f753-a849-9a3a-e1bf5fcbc5e8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "}"}], ",", "1"}], "}"}]], "Output",ExpressionUUID->"badf7e61-\
2bec-a943-9541-785b73b89eaf"],

Cell["Source", "NotesSection",ExpressionUUID->"76620c09-258c-4a4f-9a3e-4f4b3e6fc4b3"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Rewriting.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Matching",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"9a2353c9-8a97-414f-8df3-a74a933b546a"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"df7f0bbe-7764-6146-aa15-21dfca8cb03a"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["HypergraphRuleApply", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"e9d907a6-a36e-1649-94e2-20022d424b91"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphRule", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "d9986645-6748-3244-afc7-b001d35985c3"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeList", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "4e5943ce-7a6a-e644-ba4a-89a6e76486c7"]
}], "SeeAlso",ExpressionUUID->"dc7b68d7-aab1-bf47-9ea6-ac4f5683f395"]
},
