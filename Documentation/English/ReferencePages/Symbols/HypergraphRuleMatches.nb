Notebook[{
Cell["HypergraphRuleMatches", "ObjectName",ExpressionUUID->"531d9183-969f-f949-a9ed-0155e6752197"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypergraphRuleMatches", "[", 
    RowBox[{"rule", ",", " ", "hg"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"01f67c19-2e9e-cd46-95a4-6e341279ca3c"],
 " ",
 "gives the ways the input of rule sits inside hg, without rewriting anything."
}], "Usage",ExpressionUUID->"00d6fc44-87f2-4748-a660-80b296034f04"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"a01527d6-5f90-8b46-996c-a5460a9d1d5a"],

Cell["\<\
Each match is an association with \"MatchEdgePositions\", the positions in \
EdgeList[hg] that the input's edges lie on, and \"RuleVertexMap\", the \
correspondence from the input's vertices to the hypergraph's.\
\>", "Notes",ExpressionUUID->"d9748dd8-883e-7742-8c0e-beb7e551bc20"],

Cell["\<\
It takes the same options as HypergraphRuleApply, and is what that function \
matches with; asking for the matches alone is the way to see why a rule \
applies as often as it does.\
\>", "Notes",ExpressionUUID->"d947f6e1-3b4b-6e41-a7bf-77eec274df95"],

Cell["\<\
An edge of the hypergraph is used by at most one edge of the input, so a rule \
whose input has two edges wants two of them.\
\>", "Notes",ExpressionUUID->"d6b2be28-eabd-be43-917f-e2df8ffe568b"],

Cell["\<\
A vertex of the input lying in no edge constrains nothing, and is matched to \
each vertex not already taken in turn.\
\>", "Notes",ExpressionUUID->"c661302b-46a8-8949-bf6c-9967ff9647a0"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"19f2c819-0bf8-eb46-9d8e-f789016d4634"],

Cell["\<\
HypergraphRuleMatches[HypergraphRule[{{1, 2}}, {}],
   Hypergraph[{Edge[{1, 2}], Edge[{2, 3}]}]]\
\>", "Input",ExpressionUUID->"2abe4f37-d8cf-9f4e-bca6-2368cfe42618"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"MatchEdgePositions\"\>", "\[Rule]", 
      RowBox[{"{", "1", "}"}]}], ",", 
     RowBox[{"\<\"RuleVertexMap\"\>", "\[Rule]", 
      RowBox[{"\[LeftAssociation]", 
       RowBox[{
        RowBox[{"1", "\[Rule]", "1"}], ",", 
        RowBox[{"2", "\[Rule]", "2"}]}], "\[RightAssociation]"}]}], ",", 
     RowBox[{"\<\"LabelBindings\"\>", "\[Rule]", 
      RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}]}], 
    "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"MatchEdgePositions\"\>", "\[Rule]", 
      RowBox[{"{", "2", "}"}]}], ",", 
     RowBox[{"\<\"RuleVertexMap\"\>", "\[Rule]", 
      RowBox[{"\[LeftAssociation]", 
       RowBox[{
        RowBox[{"1", "\[Rule]", "2"}], ",", 
        RowBox[{"2", "\[Rule]", "3"}]}], "\[RightAssociation]"}]}], ",", 
     RowBox[{"\<\"LabelBindings\"\>", "\[Rule]", 
      RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}]}], 
    "\[RightAssociation]"}]}], "}"}]], "Output",ExpressionUUID->"4aa5802b-\
dc1e-2940-97f0-a07dee64d589"],

Cell["\<\
An unordered edge matches in as many ways as its vertices can be ordered:\
\>", "ExampleText",ExpressionUUID->"2cc9a158-fa5a-4340-990d-81725e30fc4f"],

Cell["\<\
Length @ HypergraphRuleMatches[HypergraphRule[{Edge[{1, 2, 3}, \
\"Unordered\"]}, {}],
   Hypergraph[{Edge[{1, 2, 3}, \"Unordered\"]}]]\
\>", "Input",ExpressionUUID->"9d614849-d429-8040-ae6b-0dc9e18555dc"],

Cell[BoxData["6"], "Output",ExpressionUUID->"85f69f06-df10-8e42-a281-88ca9dd30cf5"],

Cell["\<\
\[Ellipsis] a cyclic one in as many ways as it can be rotated, and a directed \
one in one way:\
\>", "ExampleText",ExpressionUUID->"012eadc6-62a9-c943-a1b5-faec9c68b308"],

Cell["\<\
{Length @ HypergraphRuleMatches[HypergraphRule[{Edge[{1, 2, 3}, \"Cyclic\"]}, \
{}],
    Hypergraph[{Edge[{1, 2, 3}, \"Cyclic\"]}]],
 Length @ HypergraphRuleMatches[HypergraphRule[{Edge[{1, 2, 3}, \
\"Directed\"]}, {}],
    Hypergraph[{Edge[{1, 2, 3}, \"Directed\"]}]]}\
\>", "Input",ExpressionUUID->"1c520775-0f9b-1f47-9abf-cd86d5039ef2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"3", ",", "1"}], "}"}]], "Output",ExpressionUUID->"d14f9733-7673-9b45-bd9f-cbc1eb62309d"],

Cell["\<\
Two vertices of the input will not land on one, unless that is allowed:\
\>", "ExampleText",ExpressionUUID->"ba1b9f62-57d7-0f40-abcf-32b71a892a10"],

Cell["\<\
{HypergraphRuleMatches[HypergraphRule[{{1, 2}}, {}], Hypergraph[{Edge[{1, \
1}]}]],
 Length @ HypergraphRuleMatches[HypergraphRule[{{1, 2}}, {}], \
Hypergraph[{Edge[{1, 1}]}],
    \"DistinctVertices\" -> False]}\
\>", "Input",ExpressionUUID->"0bbddf94-5b0c-0a44-8c87-86231e1ea0f9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "}"}], ",", "1"}], "}"}]], "Output",ExpressionUUID->"92bc4a45-\
affe-e24c-ab08-9c7d243f7ae7"],

Cell["Source", "NotesSection",ExpressionUUID->"2fa75996-0cf4-1e43-a1c0-c89255fc880d"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Rewriting.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Matching",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"74e85b27-21a3-1a40-8dcd-13b9a4c569d7"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"e61d28db-92cc-ec4f-8672-14ea53bb0a76"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["HypergraphRuleApply", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"363abdb3-e4d5-3043-8375-a41377d73d06"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphRule", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "9d07b15a-c65b-7541-a815-a84dcf3e71bc"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeList", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "46c45bae-638c-4b45-aaa7-25ac7c068e5c"]
}], "SeeAlso",ExpressionUUID->"15eee164-829e-0d44-9ffd-b9edbbd3c8e3"]
},
