Notebook[{
Cell["HypergraphRuleMatches", "ObjectName",ExpressionUUID->"c4e0aa7e-a782-5b4d-9c34-e84dcc4ff097"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypergraphRuleMatches", "[", 
    RowBox[{"rule", ",", " ", "hg"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"9a52d0cc-f23e-9e44-839c-eb45d674245c"],
 " ",
 "gives the ways the input of rule sits inside hg, without rewriting anything."
}], "Usage",ExpressionUUID->"2980f850-84b7-9a4d-81de-870ff0476fa9"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"5964ce74-0b13-954b-814b-deba858fc9e3"],

Cell["\<\
Each match is an association with \"MatchEdgePositions\", the positions in \
EdgeList[hg] that the input's edges lie on, and \"RuleVertexMap\", the \
correspondence from the input's vertices to the hypergraph's.\
\>", "Notes",ExpressionUUID->"723cfdee-15eb-b242-8b7e-e24c2b44fc08"],

Cell["\<\
It takes the same options as HypergraphRuleApply, and is what that function \
matches with; asking for the matches alone is the way to see why a rule \
applies as often as it does.\
\>", "Notes",ExpressionUUID->"417e61bf-d30e-874b-9194-e117bbe461aa"],

Cell["\<\
An edge of the hypergraph is used by at most one edge of the input, so a rule \
whose input has two edges wants two of them.\
\>", "Notes",ExpressionUUID->"8288dc88-e330-8445-9638-63475165b830"],

Cell["\<\
A vertex of the input lying in no edge constrains nothing, and is matched to \
each vertex not already taken in turn.\
\>", "Notes",ExpressionUUID->"2c653ebe-bdba-0f46-8649-b50cd04b2692"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"be2b4061-a76d-1948-8575-4a582b32b1fd"],

Cell["\<\
HypergraphRuleMatches[HypergraphRule[{{1, 2}}, {}],
   Hypergraph[{Edge[{1, 2}], Edge[{2, 3}]}]]\
\>", "Input",ExpressionUUID->"d914aa8e-a0a8-6642-9925-d33676bc1325"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"MatchEdgePositions\"\>", "\[Rule]", 
      RowBox[{"{", "1", "}"}]}], ",", 
     RowBox[{"\<\"RuleVertexMap\"\>", "\[Rule]", 
      RowBox[{"\[LeftAssociation]", 
       RowBox[{
        RowBox[{"1", "\[Rule]", "1"}], ",", 
        RowBox[{"2", "\[Rule]", "2"}]}], "\[RightAssociation]"}]}], ",", 
     RowBox[{"\<\"LabelBindings\"\>", "\[Rule]", 
      RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}]}], 
    "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"MatchEdgePositions\"\>", "\[Rule]", 
      RowBox[{"{", "2", "}"}]}], ",", 
     RowBox[{"\<\"RuleVertexMap\"\>", "\[Rule]", 
      RowBox[{"\[LeftAssociation]", 
       RowBox[{
        RowBox[{"1", "\[Rule]", "2"}], ",", 
        RowBox[{"2", "\[Rule]", "3"}]}], "\[RightAssociation]"}]}], ",", 
     RowBox[{"\<\"LabelBindings\"\>", "\[Rule]", 
      RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}]}], 
    "\[RightAssociation]"}]}], "}"}]], "Output",ExpressionUUID->"fe1320a3-\
6b8d-9a49-92aa-16814811a052"],

Cell["\<\
An unordered edge matches in as many ways as its vertices can be ordered:\
\>", "ExampleText",ExpressionUUID->"4df3f439-1353-9b40-a7d7-52dc3ac31c45"],

Cell["\<\
Length @ HypergraphRuleMatches[HypergraphRule[{Edge[{1, 2, 3}, \
\"Unordered\"]}, {}],
   Hypergraph[{Edge[{1, 2, 3}, \"Unordered\"]}]]\
\>", "Input",ExpressionUUID->"7ee39d82-79c7-ef41-bed2-f18035aa8405"],

Cell[BoxData["6"], "Output",ExpressionUUID->"d2d2ce78-5a1c-0d4d-a1c5-0e7180c39a1a"],

Cell["\<\
\[Ellipsis] a cyclic one in as many ways as it can be rotated, and a directed \
one in one way:\
\>", "ExampleText",ExpressionUUID->"90809ec3-d16e-544c-b39b-2a2cd988e5de"],

Cell["\<\
{Length @ HypergraphRuleMatches[HypergraphRule[{Edge[{1, 2, 3}, \"Cyclic\"]}, \
{}],
    Hypergraph[{Edge[{1, 2, 3}, \"Cyclic\"]}]],
 Length @ HypergraphRuleMatches[HypergraphRule[{Edge[{1, 2, 3}, \
\"Directed\"]}, {}],
    Hypergraph[{Edge[{1, 2, 3}, \"Directed\"]}]]}\
\>", "Input",ExpressionUUID->"19a12a90-bbee-3847-8ed4-3e70ad1ed904"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"3", ",", "1"}], "}"}]], "Output",ExpressionUUID->"2434a6a1-93c4-084d-84fc-a6bdcf261d9a"],

Cell["\<\
Two vertices of the input will not land on one, unless that is allowed:\
\>", "ExampleText",ExpressionUUID->"a07e8440-c84b-1f49-aab1-674552bf575e"],

Cell["\<\
{HypergraphRuleMatches[HypergraphRule[{{1, 2}}, {}], Hypergraph[{Edge[{1, \
1}]}]],
 Length @ HypergraphRuleMatches[HypergraphRule[{{1, 2}}, {}], \
Hypergraph[{Edge[{1, 1}]}],
    \"DistinctVertices\" -> False]}\
\>", "Input",ExpressionUUID->"4232a18c-f0e2-9f48-a3d7-08b986e20972"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "}"}], ",", "1"}], "}"}]], "Output",ExpressionUUID->"db04b321-\
be36-ab4d-b6e9-a44a0b2935f6"],

Cell["Source", "NotesSection",ExpressionUUID->"f3fe6273-c3f4-8e4c-98fb-6d84a66dd330"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Rewriting.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Matching",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"8b3c2d8e-41c7-6a4d-b829-c8b439dac1db"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"b16806fc-b165-b046-af45-4f97a2a7dd4b"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["HypergraphRuleApply", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"3ebb1b2d-f347-f544-9007-114bd8070624"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphRule", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "df1a4dfb-6f0a-b644-b111-ca8d28b94205"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeList", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "6679cc63-dba3-4742-a693-b2331b0c3de8"]
}], "SeeAlso",ExpressionUUID->"8a2c947b-273c-794e-8209-b37e00929d98"]
},
