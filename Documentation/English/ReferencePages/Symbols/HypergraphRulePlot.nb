(* Beginning of Notebook Content *)
Notebook[{
Cell["HypergraphRulePlot", "ObjectName",ExpressionUUID->"b562f9c9-c430-a540-986c-560f0c6344dc"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypergraphRulePlot", "[", "rule", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"290bfeec-4d57-d141-8d42-778aab3ec9a9"],
 " ",
 "draws the rewrite rule rule as its input beside its output."
}], "Usage",ExpressionUUID->"be8a2dfc-bebb-934d-8a26-2c5e426478fc"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"1a4dfd6c-0163-404d-a063-73fb2e31e590"],

Cell["\<\
Vertices the two sides share are drawn in the same places, so that what the \
rule does to them can be read off rather than searched for.\
\>", "Notes",ExpressionUUID->"a13240b9-a6e5-b94d-a74f-f27430d9cd75"],

Cell["\<\
The vertices a rule creates are highlighted on the right and the ones it \
destroys on the left; \"Highlight\" -> False leaves both plain.\
\>", "Notes",ExpressionUUID->"d4b59e8d-f6f9-0e45-9fc0-65b643325474"],

Cell[TextData[{
 "The highlight styles are \"HighlightLeftVertexStyle\", \
\"HighlightLeftEdgeStyle\", \"HighlightRightVertexStyle\" and \
\"HighlightRightEdgeStyle\", the same four names the reference paclet's ",
 Cell[BoxData[
  StyleBox["HighlightRule", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "6ddabbe8-1252-054b-872f-a1e3f2341c5d"],
 " takes."
}], "Notes",ExpressionUUID->"c9916ce7-3dac-9543-966f-52250b9db499"],

Cell["\<\
\"PanelSize\" sets how many pixels wide each of the two sides is drawn.\
\>", "Notes",ExpressionUUID->"d57e5fe3-3bae-0b4b-81af-877bb218fc68"],

Cell["\<\
\"SharedCoordinates\" -> False lays the two sides out independently.\
\>", "Notes",ExpressionUUID->"e67b63aa-c4cd-8c4f-b5ce-28fe9050cbb2"],

Cell[TextData[{
 "It takes the options of ",
 Cell[BoxData[
  StyleBox["HypergraphPlot", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "0913c474-fe83-9c42-ac6d-0247838c15cd"],
 " as well, which are passed to both sides."
}], "Notes",ExpressionUUID->"6faf7a43-e462-8e43-b0d7-49bf51b11fc8"],

Cell["\<\
Opening the summary box of a HypergraphRule shows the same picture.\
\>", "Notes",ExpressionUUID->"4c9840d5-c879-aa4f-ada3-6c91bbcd924d"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"fe81cf2f-05a1-ad4c-b06f-17a1010342dd"],

Cell["\<\
A rule that subdivides an edge. Vertices 2 and 3 stay where they are; the \
vertex the rule creates is highlighted:\
\>", "ExampleText",ExpressionUUID->"eb208203-80e4-074a-b486-7c9cdb8a928e"],

Cell["\<\
HypergraphRulePlot[HypergraphRule[{{2, 3}}, {{2, 5}, {5, 3}}], \"PanelSize\" \
-> 130]\
\>", "Input",ExpressionUUID->"bd083a0c-51cb-b849-98d9-e6c8df0e0636"],

