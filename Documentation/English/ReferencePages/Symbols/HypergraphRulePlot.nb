(* Beginning of Notebook Content *)
Notebook[{
Cell["HypergraphRulePlot", "ObjectName",ExpressionUUID->"a69dc695-7d0b-5644-882a-10cdd82fa8d0"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypergraphRulePlot", "[", "rule", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"77327027-2dcf-024e-a770-587529a144ff"],
 " ",
 "draws the rewrite rule rule as its input beside its output."
}], "Usage",ExpressionUUID->"f5130b9b-8520-7d46-b126-25e98bdbcfdb"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"f85fd7cd-5c5a-194e-9735-63f6e0c97b36"],

Cell["\<\
Vertices the two sides share are drawn in the same places, so that what the \
rule does to them can be read off rather than searched for.\
\>", "Notes",ExpressionUUID->"f6f98dbe-bbec-0245-85a3-bea9a5ebd6c5"],

Cell["\<\
The vertices a rule creates are highlighted on the right and the ones it \
destroys on the left; \"Highlight\" -> False leaves both plain.\
\>", "Notes",ExpressionUUID->"3a30090e-495e-5148-8ec3-2d266ef1974d"],

Cell[TextData[{
 "The highlight styles are \"HighlightLeftVertexStyle\", \
\"HighlightLeftEdgeStyle\", \"HighlightRightVertexStyle\" and \
\"HighlightRightEdgeStyle\", the same four names the reference paclet's ",
 Cell[BoxData[
  StyleBox["HighlightRule", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "4bf7e7f2-0de0-6948-a481-36bda8cdb48d"],
 " takes."
}], "Notes",ExpressionUUID->"5b0d4da0-6a86-584a-9057-a0dd8f48f7ab"],

Cell["\<\
\"PanelSize\" sets how many pixels wide each of the two sides is drawn.\
\>", "Notes",ExpressionUUID->"5e299717-86c8-d548-8090-fe487bc01232"],

Cell["\<\
\"SharedCoordinates\" -> False lays the two sides out independently.\
\>", "Notes",ExpressionUUID->"33ea2063-08f6-ac49-b5e8-7205f30d1aa9"],

Cell[TextData[{
 "It takes the options of ",
 Cell[BoxData[
  StyleBox["HypergraphPlot", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "b4b3dbb5-85c9-1642-a053-ca0b3c1aa8ab"],
 " as well, which are passed to both sides."
}], "Notes",ExpressionUUID->"30f0c9d5-1d27-894e-b4e5-b5dc9d34bee3"],

Cell["\<\
Opening the summary box of a HypergraphRule shows the same picture.\
\>", "Notes",ExpressionUUID->"88362762-466b-f345-a322-346f1b2291d2"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"c1fa1b54-7a6a-0844-ab25-50354486ecc1"],

Cell["\<\
A rule that subdivides an edge. Vertices 2 and 3 stay where they are; the \
vertex the rule creates is highlighted:\
\>", "ExampleText",ExpressionUUID->"a18e1233-4288-604b-bf09-5584f4276377"],

Cell["\<\
HypergraphRulePlot[HypergraphRule[{{2, 3}}, {{2, 5}, {5, 3}}], \"PanelSize\" \
-> 130]\
\>", "Input",ExpressionUUID->"779e38be-2910-2148-999f-ce599c5cb81f"],

