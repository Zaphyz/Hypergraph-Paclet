(* Beginning of Notebook Content *)
Notebook[{
Cell["HypergraphRulePlot", "ObjectName",ExpressionUUID->"ffb363ba-063b-4545-a96f-b2141caf38ea"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypergraphRulePlot", "[", "rule", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"d0999b83-73da-7442-93d1-cd90e6449e0f"],
 " ",
 "draws the rewrite rule rule as its input beside its output."
}], "Usage",ExpressionUUID->"a7f4d028-c01d-e548-89fe-6812937ce789"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"a007e09d-a0d5-234f-8e66-11ca568c2d82"],

Cell["\<\
Vertices the two sides share are drawn in the same places, so that what the \
rule does to them can be read off rather than searched for.\
\>", "Notes",ExpressionUUID->"652d89b3-5a62-2941-bc34-889230aa77b8"],

Cell["\<\
The vertices a rule creates are highlighted on the right and the ones it \
destroys on the left; \"Highlight\" -> False leaves both plain.\
\>", "Notes",ExpressionUUID->"8ac751da-099d-af40-98ed-c141289d368b"],

Cell[TextData[{
 "The highlight styles are \"HighlightLeftVertexStyle\", \
\"HighlightLeftEdgeStyle\", \"HighlightRightVertexStyle\" and \
\"HighlightRightEdgeStyle\", the same four names the reference paclet's ",
 Cell[BoxData[
  StyleBox["HighlightRule", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "762004d7-053a-5b4f-a3e4-29921c4b8350"],
 " takes."
}], "Notes",ExpressionUUID->"146dd56f-400e-e743-af92-ffcaf39da15e"],

Cell["\<\
\"PanelSize\" sets how many pixels wide each of the two sides is drawn.\
\>", "Notes",ExpressionUUID->"9aac1a04-53d3-ab4a-a399-a8892824297b"],

Cell["\<\
\"SharedCoordinates\" -> False lays the two sides out independently.\
\>", "Notes",ExpressionUUID->"2a53b52e-501c-6749-9b49-5bb13ccbc948"],

Cell[TextData[{
 "It takes the options of ",
 Cell[BoxData[
  StyleBox["HypergraphPlot", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "2f8c7503-e13e-5f49-9c03-138225d0fb13"],
 " as well, which are passed to both sides."
}], "Notes",ExpressionUUID->"d22eff85-8609-c745-bf93-31992321f6e0"],

Cell["\<\
Opening the summary box of a HypergraphRule shows the same picture.\
\>", "Notes",ExpressionUUID->"28d20bfc-3f9d-bb4f-abb2-716651902bd2"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"036be8e8-41e2-2d4b-8ae7-f8d90506c7f2"],

Cell["\<\
A rule that subdivides an edge. Vertices 2 and 3 stay where they are; the \
vertex the rule creates is highlighted:\
\>", "ExampleText",ExpressionUUID->"e7a40f3a-4e5d-6f44-96a7-e6c0a006035f"],

Cell["\<\
HypergraphRulePlot[HypergraphRule[{{2, 3}}, {{2, 5}, {5, 3}}], \"PanelSize\" \
-> 130]\
\>", "Input",ExpressionUUID->"ea9a16d8-f0d6-cd44-9475-81079ab30cbc"],

