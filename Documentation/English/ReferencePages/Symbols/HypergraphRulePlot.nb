(* Beginning of Notebook Content *)
Notebook[{
Cell["HypergraphRulePlot", "ObjectName",ExpressionUUID->"ca22db9a-fba8-6248-9f03-d56e0b6a3dc6"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypergraphRulePlot", "[", "rule", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"0ba2fac4-3b33-be48-87cc-4c1dee1a257b"],
 " ",
 "draws the rewrite rule rule as its input beside its output."
}], "Usage",ExpressionUUID->"8288a866-da08-4f49-8d21-04c33334019f"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"005c8ce0-2a53-c94f-9703-9c4c46207336"],

Cell["\<\
Vertices the two sides share are drawn in the same places, so that what the \
rule does to them can be read off rather than searched for.\
\>", "Notes",ExpressionUUID->"76c0b12d-f15f-d943-8b8c-5ac7dcdb816b"],

Cell["\<\
The vertices a rule creates are highlighted on the right and the ones it \
destroys on the left; \"Highlight\" -> False leaves both plain.\
\>", "Notes",ExpressionUUID->"f90ac14c-4a65-104f-ba6b-ac7188a448be"],

Cell[TextData[{
 "The highlight styles are \"HighlightLeftVertexStyle\", \
\"HighlightLeftEdgeStyle\", \"HighlightRightVertexStyle\" and \
\"HighlightRightEdgeStyle\", the same four names the reference paclet's ",
 Cell[BoxData[
  StyleBox["HighlightRule", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "49e31fb7-2466-7043-9976-9abbacca81af"],
 " takes."
}], "Notes",ExpressionUUID->"f0f6c651-ff8c-2e46-aa07-f19ddfd30101"],

Cell["\<\
\"PanelSize\" sets how many pixels wide each of the two sides is drawn.\
\>", "Notes",ExpressionUUID->"6f0a0f38-d3ec-e34c-a32f-3f802210c1ce"],

Cell["\<\
\"SharedCoordinates\" -> False lays the two sides out independently.\
\>", "Notes",ExpressionUUID->"e8a50efd-6644-9a44-9cbb-0f98f294b0e0"],

Cell[TextData[{
 "It takes the options of ",
 Cell[BoxData[
  StyleBox["HypergraphPlot", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "ab36ba11-8a8f-784d-a826-a72be471209f"],
 " as well, which are passed to both sides."
}], "Notes",ExpressionUUID->"6456bf1b-8861-bd44-a4a0-ff7c0e23b8d1"],

Cell["\<\
Opening the summary box of a HypergraphRule shows the same picture.\
\>", "Notes",ExpressionUUID->"c4e11dc0-e821-8d4e-bb90-cf0795fa7fef"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"682f21e3-8bd1-a743-ac74-50f823845734"],

Cell["\<\
A rule that subdivides an edge. Vertices 2 and 3 stay where they are; the \
vertex the rule creates is highlighted:\
\>", "ExampleText",ExpressionUUID->"3931223e-ae10-f742-9a1d-a5cdc032532c"],

Cell["\<\
HypergraphRulePlot[HypergraphRule[{{2, 3}}, {{2, 5}, {5, 3}}], \"PanelSize\" \
-> 130]\
\>", "Input",ExpressionUUID->"d67b35a3-e443-384e-a8b5-451a221c9a2c"],

