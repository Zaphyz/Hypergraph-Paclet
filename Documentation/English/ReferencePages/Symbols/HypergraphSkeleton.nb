          ImageScaled[{0.5, -0.5}]], InsetBox[
          StyleBox["3",
           StripOnInput->False,
           LineColor->GrayLevel[0],
           FrontFaceColor->GrayLevel[0],
           BackFaceColor->GrayLevel[0],
           GraphicsColor->GrayLevel[0],
           FontColor->GrayLevel[0]], {2., 0.}, 
          ImageScaled[{-0.5, 0.5000000000000002}]]}}}]],
    Background->GrayLevel[1],
    ImagePadding->20,
    PlotRange->{{0., 2.}, {-0.3333333333333333, 0.3333333333333337}},
    PlotRangePadding->Scaled[0.02]]}], "}"}]], "Output",ExpressionUUID->\
"cd988a70-9888-fc4f-aa16-983da58932dc"],

Cell["Every label is gone, while the symmetry types survive:", "ExampleText",ExpressionUUID->"54ff2c91-aaa0-c649-b4c9-c95892475a06"],

Cell["\<\
s = HypergraphSkeleton[Hypergraph[{Edge[{Vertex[1, \"A\"], 2}, \"Unordered\", \
\"f\"]}]];
{s[\"VertexLabels\"], s[\"EdgeLabels\"], s[\"EdgeSymmetries\"]}\
\>", "Input",ExpressionUUID->"1b6e3441-e818-5042-b0e5-12bed87e25e7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"None", ",", "None"}], "}"}], ",", 
   RowBox[{"{", "None", "}"}], ",", 
   RowBox[{"{", "\<\"Unordered\"\>", "}"}]}], "}"}]], "Output",ExpressionUUID->\
"eeb05e94-1961-2d4c-ba96-b1ad4a4e5318"],

Cell["The same thing as a property:", "ExampleText",ExpressionUUID->"698aab25-837d-5344-9d5a-83c7672b3c7a"],

Cell["l[\"Skeleton\"] === HypergraphSkeleton[l]", "Input",ExpressionUUID->"d57a17eb-cfe6-d940-8272-fae9e1261f3c"],

Cell[BoxData["True"], "Output",ExpressionUUID->"19568943-781b-7049-8cb1-bb943fb442f5"],

