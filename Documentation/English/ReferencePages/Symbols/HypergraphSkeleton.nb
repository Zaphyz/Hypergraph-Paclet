          StyleBox["2",
           StripOnInput->False,
           LineColor->GrayLevel[0],
           FrontFaceColor->GrayLevel[0],
           BackFaceColor->GrayLevel[0],
           GraphicsColor->GrayLevel[0],
           FontColor->GrayLevel[0]], {1., 2.4492935982947064*^-16}, 
          ImageScaled[{0.5, -0.5}]], InsetBox[
          StyleBox["3",
           StripOnInput->False,
           LineColor->GrayLevel[0],
           FrontFaceColor->GrayLevel[0],
           BackFaceColor->GrayLevel[0],
           GraphicsColor->GrayLevel[0],
           FontColor->GrayLevel[0]], {2., 0.}, 
          ImageScaled[{-0.5, 0.5000000000000002}]]}}}]],
    Background->GrayLevel[1],
    ImagePadding->20,
    PlotRange->{{0., 2.}, {-0.3333333333333333, 0.3333333333333337}},
    PlotRangePadding->Scaled[0.02]]}], "}"}]], "Output",ExpressionUUID->\
"3c0f2602-c8d1-3940-8380-8405d37c907f"],

Cell["Every label is gone, while the symmetry types survive:", "ExampleText",ExpressionUUID->"113d9502-0f0f-f043-83ff-845e4aecf833"],

Cell["\<\
s = HypergraphSkeleton[Hypergraph[{Edge[{Vertex[1, \"A\"], 2}, \"Unordered\", \
\"f\"]}]];
{s[\"VertexLabels\"], s[\"EdgeLabels\"], s[\"EdgeSymmetries\"]}\
\>", "Input",ExpressionUUID->"cd7f2f5d-9ce8-9b44-8b31-0ef8f12904de"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"None", ",", "None"}], "}"}], ",", 
   RowBox[{"{", "None", "}"}], ",", 
   RowBox[{"{", "\<\"Unordered\"\>", "}"}]}], "}"}]], "Output",ExpressionUUID->\
"83a99414-bc1e-864d-a858-ef16415410e0"],

Cell["The same thing as a property:", "ExampleText",ExpressionUUID->"36635741-fcbe-b443-854d-fd5fdeb45481"],

Cell["l[\"Skeleton\"] === HypergraphSkeleton[l]", "Input",ExpressionUUID->"917aec8f-354a-9747-bd15-15f101016f0a"],

Cell[BoxData["True"], "Output",ExpressionUUID->"6c9f4f49-6c86-2749-82ea-d14eeaa9ead2"],

