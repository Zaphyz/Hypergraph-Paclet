Notebook[{
Cell["HypergraphSkeleton", "ObjectName",ExpressionUUID->"6b63a45a-3eed-ec46-aace-fbe09682f60a"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypergraphSkeleton", "[", "hg", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"0a0e3a1f-8a4e-434d-b35e-077b928d8973"],
 " ",
 "gives the underlying unlabelled hypergraph of hg, dropping every vertex and \
edge label but keeping all edge symmetry types."
}], "Usage",ExpressionUUID->"a4dedf32-abb7-5248-b402-5a42d3455ba8"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"4133cfd7-d849-a84e-b2ce-4a328c1355fb"],

Cell["\<\
The same hypergraph is available as the property hg[\"Skeleton\"].\
\>", "Notes",ExpressionUUID->"49afec10-f63e-e846-b723-5edfdcfc70da"],

Cell["\<\
Comparing skeletons is what IsomorphicHypergraphQ[hg1, hg2, \"Labeled\" -> \
False] does; the two are equivalent for deciding isomorphism and for the \
canonical form, though the witness returned by FindHypergraphIsomorphism need \
not be the same one.\
\>", "Notes",ExpressionUUID->"50c5d31d-fb55-1e4a-a821-33d2ae90ab16"],

Cell["\<\
Labels are removed from the Vertex objects inside the edges as well as from \
the vertex list. Leaving them in the edges would put every label back, since \
the constructor treats a label on any occurrence of a vertex as authoritative.\
\>", "Notes",ExpressionUUID->"17f47c34-4cdb-2f44-bac9-b98a3b3c7585"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"75dbc484-9b86-c24d-acae-b0790ce036c1"],

Cell["A labelled hypergraph and its skeleton:", "ExampleText",ExpressionUUID->"3841dfbf-c203-b64e-b602-7cbd6ecb4d72"],

Cell["\<\
l = Hypergraph[{Vertex[1, \"A\"], Vertex[2, \"B\"], Vertex[3, \"C\"]}, {{1, \
2}, {2, 3}}];
{l, HypergraphSkeleton[l]}\
\>", "Input",ExpressionUUID->"a78bd862-7287-b448-9c5c-86c74857d4f0"],

