Notebook[{
Cell["HypergraphSkeleton", "ObjectName",ExpressionUUID->"1f3a6462-ce63-f146-8ea8-ab22d73e5aef"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypergraphSkeleton", "[", "hg", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"12355174-3152-4e4d-995b-5619ce13a107"],
 " ",
 "gives the underlying unlabelled hypergraph of hg, dropping every vertex and \
edge label but keeping all edge symmetry types."
}], "Usage",ExpressionUUID->"3c23da04-0377-a34c-af7f-e5dbed9f1d91"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"9ecc6a99-7e19-a148-b9b5-88861dcd5e67"],

Cell["\<\
The same hypergraph is available as the property hg[\"Skeleton\"].\
\>", "Notes",ExpressionUUID->"f428ec5d-592f-d542-9a75-12bf8e70f53f"],

Cell["\<\
Comparing skeletons is what IsomorphicHypergraphQ[hg1, hg2, \"Labeled\" -> \
False] does; the two are equivalent for deciding isomorphism and for the \
canonical form, though the witness returned by FindHypergraphIsomorphism need \
not be the same one.\
\>", "Notes",ExpressionUUID->"704dceb2-8359-0b46-81a3-75bda62ebc9d"],

Cell["\<\
Labels are removed from the Vertex objects inside the edges as well as from \
the vertex list. Leaving them in the edges would put every label back, since \
the constructor treats a label on any occurrence of a vertex as authoritative.\
\>", "Notes",ExpressionUUID->"bf50cb2a-6c09-9c45-9468-a8cd8f133698"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"afa07729-f013-6c4a-bcc6-6e97aa616434"],

Cell["A labelled hypergraph and its skeleton:", "ExampleText",ExpressionUUID->"62512d6b-7c89-0f4b-a831-bf2069905115"],

Cell["\<\
l = Hypergraph[{Vertex[1, \"A\"], Vertex[2, \"B\"], Vertex[3, \"C\"]}, {{1, \
2}, {2, 3}}];
{l, HypergraphSkeleton[l]}\
\>", "Input",ExpressionUUID->"87a383af-a6b3-694f-8e2b-5551b2e63229"],

