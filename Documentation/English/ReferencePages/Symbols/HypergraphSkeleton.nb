         WolframInstitute`Hypergraphs`Vertex[3]}, {
         WolframInstitute`Hypergraphs`Edge[{
           WolframInstitute`Hypergraphs`Vertex[1], 
           WolframInstitute`Hypergraphs`Vertex[2]}, "Directed"], 
         WolframInstitute`Hypergraphs`Edge[{
           WolframInstitute`Hypergraphs`Vertex[2], 
           WolframInstitute`Hypergraphs`Vertex[3]}, "Directed"]}]]}, 
      {AbsoluteThickness[Medium], Opacity[0.5], 
       Arrowheads[{{Medium, 0.5}}], {
        {Opacity[1], Arrowheads[{{Small, 0.5}}], 
         {Hue[0.63, 0.7, 0.5], Opacity[
