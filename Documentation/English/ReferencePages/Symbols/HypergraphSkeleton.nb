"c386779e-e889-3a4f-a976-c00c593f61b9"],

Cell["Every label is gone, while the symmetry types survive:", "ExampleText",ExpressionUUID->"fce95779-452c-9944-a084-f9948ee08a78"],

Cell["\<\
s = HypergraphSkeleton[Hypergraph[{Edge[{Vertex[1, \"A\"], 2}, \"Unordered\", \
\"f\"]}]];
{s[\"VertexLabels\"], s[\"EdgeLabels\"], s[\"EdgeSymmetries\"]}\
\>", "Input",ExpressionUUID->"4de5107f-9b3d-5742-9d43-d3d69b5698d2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
