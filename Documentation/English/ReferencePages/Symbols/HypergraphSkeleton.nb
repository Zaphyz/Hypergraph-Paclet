          ImageScaled[{0.5, -0.5}]], InsetBox[
          StyleBox["3",
           StripOnInput->False,
           LineColor->GrayLevel[0],
           FrontFaceColor->GrayLevel[0],
           BackFaceColor->GrayLevel[0],
           GraphicsColor->GrayLevel[0],
           FontColor->GrayLevel[0]], {2., 0.}, 
          ImageScaled[{-0.5, 0.5000000000000002}]]}}}]],
    Background->GrayLevel[1],
    ImagePadding->20,
    PlotRange->{{0., 2.}, {-0.3333333333333333, 0.3333333333333337}},
    PlotRangePadding->Scaled[0.02]]}], "}"}]], "Output",ExpressionUUID->\
"48551679-dd6a-5b40-87a5-194539bfa460"],

Cell["Every label is gone, while the symmetry types survive:", "ExampleText",ExpressionUUID->"d65085b4-4bd6-6f4c-a7ce-7a0d89fef141"],

Cell["\<\
s = HypergraphSkeleton[Hypergraph[{Edge[{Vertex[1, \"A\"], 2}, \"Unordered\", \
\"f\"]}]];
{s[\"VertexLabels\"], s[\"EdgeLabels\"], s[\"EdgeSymmetries\"]}\
\>", "Input",ExpressionUUID->"e235cca2-a4e3-0e40-9955-f977192ea85c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"None", ",", "None"}], "}"}], ",", 
   RowBox[{"{", "None", "}"}], ",", 
   RowBox[{"{", "\<\"Unordered\"\>", "}"}]}], "}"}]], "Output",ExpressionUUID->\
"c5bbd5c5-beec-bf41-8113-f09c194cca6a"],

Cell["The same thing as a property:", "ExampleText",ExpressionUUID->"15e117a3-64ed-4444-945f-1bbfd7ea86b8"],

Cell["l[\"Skeleton\"] === HypergraphSkeleton[l]", "Input",ExpressionUUID->"bf36eebd-3eae-7446-a58f-69b2be90df78"],

Cell[BoxData["True"], "Output",ExpressionUUID->"07efd74c-da2b-3e49-b10a-7516a416d578"],

