Notebook[{
Cell["HypergraphSkeleton", "ObjectName",ExpressionUUID->"15769c23-77c7-a540-8481-a65de38c707a"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypergraphSkeleton", "[", "hg", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"4347c135-4f0a-f34b-98fa-09cbc2b9f7ff"],
 " ",
 "gives the underlying unlabelled hypergraph of hg, dropping every vertex and \
edge label but keeping all edge symmetry types."
}], "Usage",ExpressionUUID->"51506618-903a-7740-ae6d-9aaff04eb4f8"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"3833e119-4248-6d41-83ef-eff62f24f848"],

Cell["\<\
The same hypergraph is available as the property hg[\"Skeleton\"].\
\>", "Notes",ExpressionUUID->"00fd488a-54e4-d949-bb58-fef50c8139de"],

Cell["\<\
Comparing skeletons is what IsomorphicHypergraphQ[hg1, hg2, \"Labeled\" -> \
False] does; the two are equivalent for deciding isomorphism and for the \
canonical form, though the witness returned by FindHypergraphIsomorphism need \
not be the same one.\
\>", "Notes",ExpressionUUID->"c2b76aad-0da0-f44a-835a-245bd525910a"],

Cell["\<\
Labels are removed from the Vertex objects inside the edges as well as from \
the vertex list. Leaving them in the edges would put every label back, since \
the constructor treats a label on any occurrence of a vertex as authoritative.\
\>", "Notes",ExpressionUUID->"82735cef-a6ba-cb4b-8958-e48d4517f9e9"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"14e320b0-9c3b-7546-8b9a-08db144b68d3"],

Cell["A labelled hypergraph and its skeleton:", "ExampleText",ExpressionUUID->"e190cc4a-0000-2149-9bfd-d5576944233c"],

Cell["\<\
l = Hypergraph[{Vertex[1, \"A\"], Vertex[2, \"B\"], Vertex[3, \"C\"]}, {{1, \
2}, {2, 3}}];
{l, HypergraphSkeleton[l]}\
\>", "Input",ExpressionUUID->"a67b0f6d-7967-8444-b411-14e90a4b5555"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
