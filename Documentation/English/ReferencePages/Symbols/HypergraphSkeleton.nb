(* Beginning of Notebook Content *)
Notebook[{
Cell["HypergraphSkeleton", "ObjectName",ExpressionUUID->"631a69a2-4822-a34d-bdf3-bb0694231033"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypergraphSkeleton", "[", "hg", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"4de700c2-991a-594a-b5aa-9cc73ae143d9"],
 " ",
 "gives the underlying unlabelled hypergraph of hg, dropping every vertex and \
edge label but keeping all edge symmetry types."
}], "Usage",ExpressionUUID->"df445833-510e-c349-8e60-c50c1b4541f4"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"fc308318-7fa0-b949-95c2-92e6aaa2ee01"],

Cell["\<\
The same hypergraph is available as the property hg[\"Skeleton\"].\
\>", "Notes",ExpressionUUID->"166a7e0f-3d8e-2a4f-81a3-fe050ef13c86"],

Cell["\<\
Comparing skeletons is what IsomorphicHypergraphQ[hg1, hg2, \"Labeled\" -> \
False] does; the two are equivalent for deciding isomorphism and for the \
canonical form, though the witness returned by FindHypergraphIsomorphism need \
not be the same one.\
\>", "Notes",ExpressionUUID->"ed6888d6-cce5-1c46-80da-b77b00afcab8"],

Cell["\<\
Labels are removed from the Vertex objects inside the edges as well as from \
the vertex list. Leaving them in the edges would put every label back, since \
the constructor treats a label on any occurrence of a vertex as authoritative.\
\>", "Notes",ExpressionUUID->"ef806666-3295-b141-87e9-91431b59bc65"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"b04c4525-9077-dc4c-a38f-30b7e00900c2"],

Cell["A labelled hypergraph and its skeleton:", "ExampleText",ExpressionUUID->"aa3679bb-0eee-a54a-b631-44ef81c93b52"],

Cell["\<\
l = Hypergraph[{Vertex[1, \"A\"], Vertex[2, \"B\"], Vertex[3, \"C\"]}, {{1, \
2}, {2, 3}}];
{l, HypergraphSkeleton[l]}\
\>", "Input",ExpressionUUID->"bdedba69-8d04-fd42-9b20-ae8d908b70e1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   GraphicsBox[
    NamespaceBox["Hypergraphs",
     DynamicModuleBox[{Typeset`hg = HoldComplete[
       WolframInstitute`Hypergraphs`Hypergraph[{
         WolframInstitute`Hypergraphs`Vertex[1, "A"], 
         WolframInstitute`Hypergraphs`Vertex[2, "B"], 
         WolframInstitute`Hypergraphs`Vertex[3, "C"]}, {
         WolframInstitute`Hypergraphs`Edge[{
           WolframInstitute`Hypergraphs`Vertex[1, "A"], 
           WolframInstitute`Hypergraphs`Vertex[2, "B"]}, "Directed"], 
         WolframInstitute`Hypergraphs`Edge[{
           WolframInstitute`Hypergraphs`Vertex[2, "B"], 
           WolframInstitute`Hypergraphs`Vertex[3, "C"]}, "Directed"]}]]}, 
      {AbsoluteThickness[Medium], Opacity[0.5], 
       Arrowheads[{{Medium, 0.5}}], {
        {Opacity[1], Arrowheads[{{Small, 0.5}}], 
         {Hue[0.63, 0.7, 0.5], Opacity[
          0.7], {ArrowBox[
            LineBox[{{0., 3.6739403974420594`*^-16}, {1., 
             2.4492935982947064`*^-16}}]], {}}, 
          {Opacity[1]}}}, 
        {Opacity[1], Arrowheads[{{Small, 0.5}}], 
         {Hue[0.63, 0.7, 0.5], Opacity[
          0.7], {ArrowBox[
            LineBox[{{1., 2.4492935982947064`*^-16}, {2., 0.}}]], {}}, 
          {Opacity[1]}}}}, 
       {Opacity[1], 
        {Hue[0.63, 0.26, 0.89], EdgeForm[{Hue[0.63, 0.7, 0.33], Opacity[
         0.95]}], 
         DiskBox[{0., 3.6739403974420594`*^-16}, Offset[{2., 2.}, {0., 0.}]], 
         DiskBox[{1., 2.4492935982947064`*^-16}, Offset[{2., 2.}, {0., 0.}]], 
         DiskBox[{2., 0.}, Offset[{2., 2.}, {0., 0.}]]}, {InsetBox[
          StyleBox["\<\"A\"\>",
           StripOnInput->False,
           LineColor->GrayLevel[0],
           FrontFaceColor->GrayLevel[0],
           BackFaceColor->GrayLevel[0],
           GraphicsColor->GrayLevel[0],
           FontColor->GrayLevel[0]], {0., 3.6739403974420594*^-16}, 
          ImageScaled[{1.5, 0.49999999999999983}]], InsetBox[
          StyleBox["\<\"B\"\>",
           StripOnInput->False,
           LineColor->GrayLevel[0],
           FrontFaceColor->GrayLevel[0],
           BackFaceColor->GrayLevel[0],
           GraphicsColor->GrayLevel[0],
           FontColor->GrayLevel[0]], {1., 2.4492935982947064*^-16}, 
          ImageScaled[{0.5, -0.5}]], InsetBox[
          StyleBox["\<\"C\"\>",
           StripOnInput->False,
           LineColor->GrayLevel[0],
           FrontFaceColor->GrayLevel[0],
           BackFaceColor->GrayLevel[0],
           GraphicsColor->GrayLevel[0],
           FontColor->GrayLevel[0]], {2., 0.}, 
          ImageScaled[{-0.5, 0.5000000000000002}]]}}}]],
    Background->GrayLevel[1],
    ImagePadding->20,
    PlotRange->{{0., 2.}, {-0.3333333333333333, 0.3333333333333337}},
    PlotRangePadding->Scaled[0.02]], ",", 
   GraphicsBox[
    NamespaceBox["Hypergraphs",
     DynamicModuleBox[{Typeset`hg = HoldComplete[
       WolframInstitute`Hypergraphs`Hypergraph[{
         WolframInstitute`Hypergraphs`Vertex[1], 
         WolframInstitute`Hypergraphs`Vertex[2], 
         WolframInstitute`Hypergraphs`Vertex[3]}, {
         WolframInstitute`Hypergraphs`Edge[{
           WolframInstitute`Hypergraphs`Vertex[1], 
           WolframInstitute`Hypergraphs`Vertex[2]}, "Directed"], 
         WolframInstitute`Hypergraphs`Edge[{
           WolframInstitute`Hypergraphs`Vertex[2], 
           WolframInstitute`Hypergraphs`Vertex[3]}, "Directed"]}]]}, 
      {AbsoluteThickness[Medium], Opacity[0.5], 
       Arrowheads[{{Medium, 0.5}}], {
        {Opacity[1], Arrowheads[{{Small, 0.5}}], 
         {Hue[0.63, 0.7, 0.5], Opacity[
          0.7], {ArrowBox[
            LineBox[{{0., 3.6739403974420594`*^-16}, {1., 
             2.4492935982947064`*^-16}}]], {}}, 
          {Opacity[1]}}}, 
        {Opacity[1], Arrowheads[{{Small, 0.5}}], 
         {Hue[0.63, 0.7, 0.5], Opacity[
          0.7], {ArrowBox[
            LineBox[{{1., 2.4492935982947064`*^-16}, {2., 0.}}]], {}}, 
          {Opacity[1]}}}}, 
       {Opacity[1], 
        {Hue[0.63, 0.26, 0.89], EdgeForm[{Hue[0.63, 0.7, 0.33], Opacity[
         0.95]}], 
         DiskBox[{0., 3.6739403974420594`*^-16}, Offset[{2., 2.}, {0., 0.}]], 
         DiskBox[{1., 2.4492935982947064`*^-16}, Offset[{2., 2.}, {0., 0.}]], 
         DiskBox[{2., 0.}, Offset[{2., 2.}, {0., 0.}]]}, {InsetBox[
          StyleBox["1",
           StripOnInput->False,
           LineColor->GrayLevel[0],
           FrontFaceColor->GrayLevel[0],
           BackFaceColor->GrayLevel[0],
           GraphicsColor->GrayLevel[0],
           FontColor->GrayLevel[0]], {0., 3.6739403974420594*^-16}, 
          ImageScaled[{1.5, 0.49999999999999983}]], InsetBox[
          StyleBox["2",
           StripOnInput->False,
           LineColor->GrayLevel[0],
           FrontFaceColor->GrayLevel[0],
           BackFaceColor->GrayLevel[0],
           GraphicsColor->GrayLevel[0],
           FontColor->GrayLevel[0]], {1., 2.4492935982947064*^-16}, 
          ImageScaled[{0.5, -0.5}]], InsetBox[
          StyleBox["3",
           StripOnInput->False,
           LineColor->GrayLevel[0],
           FrontFaceColor->GrayLevel[0],
           BackFaceColor->GrayLevel[0],
           GraphicsColor->GrayLevel[0],
           FontColor->GrayLevel[0]], {2., 0.}, 
          ImageScaled[{-0.5, 0.5000000000000002}]]}}}]],
    Background->GrayLevel[1],
    ImagePadding->20,
    PlotRange->{{0., 2.}, {-0.3333333333333333, 0.3333333333333337}},
    PlotRangePadding->Scaled[0.02]]}], "}"}]], "Output",ExpressionUUID->\
"71de764d-5d4c-2f4f-8c3f-6cfbfbc8b7c8"],

Cell["Every label is gone, while the symmetry types survive:", "ExampleText",ExpressionUUID->"792545af-f90b-3c47-84f6-6e648a2fe863"],

Cell["\<\
s = HypergraphSkeleton[Hypergraph[{Edge[{Vertex[1, \"A\"], 2}, \"Unordered\", \
\"f\"]}]];
{s[\"VertexLabels\"], s[\"EdgeLabels\"], s[\"EdgeSymmetries\"]}\
\>", "Input",ExpressionUUID->"c14c22f8-0f68-7c4c-b138-b6dffdc8b563"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"None", ",", "None"}], "}"}], ",", 
   RowBox[{"{", "None", "}"}], ",", 
   RowBox[{"{", "\<\"Unordered\"\>", "}"}]}], "}"}]], "Output",ExpressionUUID->\
"8269cb29-750f-7941-b8d8-2fb34707841a"],

Cell["The same thing as a property:", "ExampleText",ExpressionUUID->"02bee398-dabf-9642-b9fb-4bfeadb2e89f"],

Cell["l[\"Skeleton\"] === HypergraphSkeleton[l]", "Input",ExpressionUUID->"707b975a-b510-7c4f-8eea-9520663c8ec8"],

Cell[BoxData["True"], "Output",ExpressionUUID->"d5218205-b0a9-7442-bacd-e622df64f1b4"],

