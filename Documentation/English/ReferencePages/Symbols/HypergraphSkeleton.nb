    PlotRangePadding->Scaled[0.02]]}], "}"}]], "Output",ExpressionUUID->\
"f64949a0-5766-fa4f-bff5-d1c742da0a95"],

Cell["Every label is gone, while the symmetry types survive:", "ExampleText",ExpressionUUID->"5b7dfb08-ce28-2340-8c2f-697215e4a679"],

Cell["\<\
s = HypergraphSkeleton[Hypergraph[{Edge[{Vertex[1, \"A\"], 2}, \"Unordered\", \
\"f\"]}]];
{s[\"VertexLabels\"], s[\"EdgeLabels\"], s[\"EdgeSymmetries\"]}\
\>", "Input",ExpressionUUID->"bb139055-94ec-cd41-ac7f-d23eb8fed88b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"None", ",", "None"}], "}"}], ",", 
   RowBox[{"{", "None", "}"}], ",", 
   RowBox[{"{", "\<\"Unordered\"\>", "}"}]}], "}"}]], "Output",ExpressionUUID->\
"b6a13a0c-80b4-1240-9caa-931d4305ec5a"],

Cell["The same thing as a property:", "ExampleText",ExpressionUUID->"f902e10f-639e-764a-b3ce-aaa42da5aa26"],

Cell["l[\"Skeleton\"] === HypergraphSkeleton[l]", "Input",ExpressionUUID->"0c9e38c9-7d9e-a84f-aa4d-0f2a428244c3"],

Cell[BoxData["True"], "Output",ExpressionUUID->"5bb2f317-7428-a643-9750-ea2774fb61e6"],

