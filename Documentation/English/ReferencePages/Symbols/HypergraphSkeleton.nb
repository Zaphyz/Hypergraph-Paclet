"c7b84243-13ad-4b4f-bd8f-2b65972dd944"],

Cell["Every label is gone, while the symmetry types survive:", "ExampleText",ExpressionUUID->"be86b2cc-46fc-dc40-ad72-1ce1395e032d"],

Cell["\<\
s = HypergraphSkeleton[Hypergraph[{Edge[{Vertex[1, \"A\"], 2}, \"Unordered\", \
\"f\"]}]];
{s[\"VertexLabels\"], s[\"EdgeLabels\"], s[\"EdgeSymmetries\"]}\
\>", "Input",ExpressionUUID->"598de2ca-022e-024e-becb-a9145aeb7d03"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"None", ",", "None"}], "}"}], ",", 
   RowBox[{"{", "None", "}"}], ",", 
   RowBox[{"{", "\<\"Unordered\"\>", "}"}]}], "}"}]], "Output",ExpressionUUID->\
"85997c5f-7eb2-7f40-b3e2-3c2ac0821513"],

Cell["The same thing as a property:", "ExampleText",ExpressionUUID->"13f2a0da-77e3-6045-8b7e-6610a408094c"],

Cell["l[\"Skeleton\"] === HypergraphSkeleton[l]", "Input",ExpressionUUID->"52be2a6b-520b-8f45-bc5f-c8a8b941cbed"],

