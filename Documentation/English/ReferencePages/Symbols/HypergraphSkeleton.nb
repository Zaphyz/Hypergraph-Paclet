Notebook[{
Cell["HypergraphSkeleton", "ObjectName",ExpressionUUID->"f7965a2f-b53b-0145-a51d-9c5742844dec"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypergraphSkeleton", "[", "hg", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"9351508d-2c71-5140-97f2-411fca09f09b"],
 " ",
 "gives the underlying unlabelled hypergraph of hg, dropping every vertex and \
edge label but keeping all edge symmetry types."
}], "Usage",ExpressionUUID->"c5b8aa74-5b64-7540-b1f2-5a69bbd6457a"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"69b35d86-47a3-e047-b8d4-dff920c4a1ed"],

Cell["\<\
The same hypergraph is available as the property hg[\"Skeleton\"].\
\>", "Notes",ExpressionUUID->"46a97fad-1fb7-ee46-a650-469e529a407e"],

Cell["\<\
Comparing skeletons is what IsomorphicHypergraphQ[hg1, hg2, \"Labeled\" -> \
False] does; the two are equivalent for deciding isomorphism and for the \
canonical form, though the witness returned by FindHypergraphIsomorphism need \
not be the same one.\
\>", "Notes",ExpressionUUID->"b5dcb278-e2fc-ef47-831e-edc6948a4642"],

Cell["\<\
Labels are removed from the Vertex objects inside the edges as well as from \
the vertex list. Leaving them in the edges would put every label back, since \
the constructor treats a label on any occurrence of a vertex as authoritative.\
\>", "Notes",ExpressionUUID->"dbd536ba-1cc0-9342-94ab-7daff0b338c7"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"7f6ddc98-60fe-0948-99ec-0e66cf400b8e"],

Cell["A labelled hypergraph and its skeleton:", "ExampleText",ExpressionUUID->"a65a02ec-889b-0c46-af68-49fb1ebe3760"],

Cell["\<\
l = Hypergraph[{Vertex[1, \"A\"], Vertex[2, \"B\"], Vertex[3, \"C\"]}, {{1, \
2}, {2, 3}}];
{l, HypergraphSkeleton[l]}\
\>", "Input",ExpressionUUID->"ca3c286e-af70-f042-84f3-a4c9f0f4b253"],

