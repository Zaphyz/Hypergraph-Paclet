Notebook[{
Cell["HypergraphSkeleton", "ObjectName",ExpressionUUID->"6c9aa425-0370-5d4f-aae7-1b0d9d3353f4"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypergraphSkeleton", "[", "hg", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"7a66b333-4829-8644-974e-7320fba84f18"],
 " ",
 "gives the underlying unlabelled hypergraph of hg, dropping every vertex and \
edge label but keeping all edge symmetry types."
}], "Usage",ExpressionUUID->"c3031745-fdaa-5b4a-8037-7d395d13bef0"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"e617583c-7dee-7b4a-b540-7ad960891b50"],

Cell["\<\
The same hypergraph is available as the property hg[\"Skeleton\"].\
\>", "Notes",ExpressionUUID->"d58164c6-38a8-1341-87df-e013dd7f045c"],

Cell["\<\
Comparing skeletons is what IsomorphicHypergraphQ[hg1, hg2, \"Labeled\" -> \
False] does; the two are equivalent for deciding isomorphism and for the \
canonical form, though the witness returned by FindHypergraphIsomorphism need \
not be the same one.\
\>", "Notes",ExpressionUUID->"783b922a-a91a-6344-9024-bd0572631654"],

Cell["\<\
Labels are removed from the Vertex objects inside the edges as well as from \
the vertex list. Leaving them in the edges would put every label back, since \
the constructor treats a label on any occurrence of a vertex as authoritative.\
\>", "Notes",ExpressionUUID->"9e8a0ee1-9e34-cb4c-8b56-f1b77ee19979"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"24005d07-3925-5045-854d-f7c6685d48a8"],

Cell["A labelled hypergraph and its skeleton:", "ExampleText",ExpressionUUID->"cbbdc2e4-03d0-d241-b6b7-f2cb326fd6c9"],

Cell["\<\
l = Hypergraph[{Vertex[1, \"A\"], Vertex[2, \"B\"], Vertex[3, \"C\"]}, {{1, \
2}, {2, 3}}];
{l, HypergraphSkeleton[l]}\
\>", "Input",ExpressionUUID->"753c72ed-45bd-5946-a99c-e228514887e9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   GraphicsBox[
    NamespaceBox["Hypergraphs",
     DynamicModuleBox[{Typeset`hg = HoldComplete[
       WolframInstitute`Hypergraphs`Hypergraph[{
