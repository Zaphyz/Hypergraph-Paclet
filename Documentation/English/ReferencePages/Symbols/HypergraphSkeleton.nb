Notebook[{
Cell["HypergraphSkeleton", "ObjectName",ExpressionUUID->"73442683-544f-f945-bc9a-3283be78b25d"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypergraphSkeleton", "[", "hg", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"f21b18c3-d6a4-424f-911e-024696ab1b47"],
 " ",
 "gives the underlying unlabelled hypergraph of hg, dropping every vertex and \
edge label but keeping all edge symmetry types."
}], "Usage",ExpressionUUID->"25e842ad-d014-6a47-881e-421560f8b80b"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"179c3f8c-b673-c447-bbbe-b2d934767105"],

Cell["\<\
The same hypergraph is available as the property hg[\"Skeleton\"].\
\>", "Notes",ExpressionUUID->"d5c78d75-2fac-d042-9118-abed3e831441"],

Cell["\<\
Comparing skeletons is what IsomorphicHypergraphQ[hg1, hg2, \"Labeled\" -> \
False] does; the two are equivalent for deciding isomorphism and for the \
canonical form, though the witness returned by FindHypergraphIsomorphism need \
not be the same one.\
\>", "Notes",ExpressionUUID->"132f365c-74e9-5e4b-9523-6e6775ba89d6"],

Cell["\<\
Labels are removed from the Vertex objects inside the edges as well as from \
the vertex list. Leaving them in the edges would put every label back, since \
the constructor treats a label on any occurrence of a vertex as authoritative.\
\>", "Notes",ExpressionUUID->"dd002aab-1269-8c49-a1f5-f9bc26fc7a9e"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"2f25af5d-73f2-fc4c-9dd7-223d5c828db5"],

Cell["A labelled hypergraph and its skeleton:", "ExampleText",ExpressionUUID->"1891f3b4-fe3a-674c-a713-5fd567257b93"],

Cell["\<\
l = Hypergraph[{Vertex[1, \"A\"], Vertex[2, \"B\"], Vertex[3, \"C\"]}, {{1, \
2}, {2, 3}}];
{l, HypergraphSkeleton[l]}\
\>", "Input",ExpressionUUID->"e3aadb73-503f-c44e-a113-0f04f3076a67"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   GraphicsBox[
    NamespaceBox["Hypergraphs",
     DynamicModuleBox[{Typeset`hg = HoldComplete[
       WolframInstitute`Hypergraphs`Hypergraph[{
