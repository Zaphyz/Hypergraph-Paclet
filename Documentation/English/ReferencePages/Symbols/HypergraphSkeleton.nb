"ab5b7a23-a977-2544-9054-0fb90d801f25"],

Cell["Every label is gone, while the symmetry types survive:", "ExampleText",ExpressionUUID->"fe4b39cd-ad1b-e34d-9149-a0eb5dd57f82"],

Cell["\<\
s = HypergraphSkeleton[Hypergraph[{Edge[{Vertex[1, \"A\"], 2}, \"Unordered\", \
\"f\"]}]];
{s[\"VertexLabels\"], s[\"EdgeLabels\"], s[\"EdgeSymmetries\"]}\
\>", "Input",ExpressionUUID->"19a9902e-f272-e141-9918-20b0348a1f30"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"None", ",", "None"}], "}"}], ",", 
   RowBox[{"{", "None", "}"}], ",", 
   RowBox[{"{", "\<\"Unordered\"\>", "}"}]}], "}"}]], "Output",ExpressionUUID->\
"211285fa-377e-9347-afd7-16b543f93d80"],

Cell["The same thing as a property:", "ExampleText",ExpressionUUID->"24308f84-c486-db41-b493-e71c498ddefd"],

