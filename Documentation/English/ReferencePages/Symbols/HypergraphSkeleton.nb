   RowBox[{"{", "None", "}"}], ",", 
   RowBox[{"{", "\<\"Unordered\"\>", "}"}]}], "}"}]], "Output",ExpressionUUID->\
"435a4ea9-5478-bf48-a49d-1e782dc17f9f"],

Cell["The same thing as a property:", "ExampleText",ExpressionUUID->"3813e232-30d4-cf47-af5f-ba77954f5d26"],

