Notebook[{
Cell["HypergraphSkeleton", "ObjectName",ExpressionUUID->"1291b280-6503-2f42-8fc5-97ec04eaf374"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypergraphSkeleton", "[", "hg", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"bd2ff49a-c1c7-ba49-933b-3579acc111e5"],
 " ",
 "gives the underlying unlabelled hypergraph of hg, dropping every vertex and \
edge label but keeping all edge symmetry types."
}], "Usage",ExpressionUUID->"ffc41c8f-040b-2e4e-93c9-7863ad0abd31"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"87174866-e863-ea4b-b53e-922720d81393"],

Cell["\<\
The same hypergraph is available as the property hg[\"Skeleton\"].\
\>", "Notes",ExpressionUUID->"9663733a-3524-7f48-8f78-35ecd599c5f4"],

Cell["\<\
Comparing skeletons is what IsomorphicHypergraphQ[hg1, hg2, \"Labeled\" -> \
False] does; the two are equivalent for deciding isomorphism and for the \
canonical form, though the witness returned by FindHypergraphIsomorphism need \
not be the same one.\
\>", "Notes",ExpressionUUID->"2f57f625-4ac9-6944-931b-23723151b4a6"],

Cell["\<\
Labels are removed from the Vertex objects inside the edges as well as from \
the vertex list. Leaving them in the edges would put every label back, since \
the constructor treats a label on any occurrence of a vertex as authoritative.\
\>", "Notes",ExpressionUUID->"bce8a9c0-527c-c141-937f-891b1041876a"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"3e40e410-8a89-9348-9811-6beccafba561"],

Cell["A labelled hypergraph and its skeleton:", "ExampleText",ExpressionUUID->"29a9010a-78f9-9a4b-a931-abcfb544b126"],

Cell["\<\
l = Hypergraph[{Vertex[1, \"A\"], Vertex[2, \"B\"], Vertex[3, \"C\"]}, {{1, \
2}, {2, 3}}];
{l, HypergraphSkeleton[l]}\
\>", "Input",ExpressionUUID->"15c7b9ac-5ce4-f341-aaae-692b0e6b54ba"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   GraphicsBox[
    NamespaceBox["Hypergraphs",
     DynamicModuleBox[{Typeset`hg = HoldComplete[
       WolframInstitute`Hypergraphs`Hypergraph[{
