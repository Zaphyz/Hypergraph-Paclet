    "}"}]}], "}"}]], "Output",ExpressionUUID->"2e856d21-ab3f-b740-9402-\
daf52e2161cb"],

Cell["\<\
The result does not depend on the order the arrays were given in:\
\>", "ExampleText",ExpressionUUID->"b6c3720e-4dd7-1344-999b-bc716076ef4d"],

Cell["\<\
Hypermatrix[{ArrayObject[{1, 2}], ArrayObject[{{1, 2}, {3, 4}}]}] ===
 Hypermatrix[{ArrayObject[{{1, 2}, {3, 4}}], ArrayObject[{1, 2}]}]\
\>", "Input",ExpressionUUID->"6fec6a9d-c630-3e4a-912a-e70861af6118"],

Cell[BoxData["True"], "Output",ExpressionUUID->"a5bce200-8395-3748-af90-b078436e4374"],

Cell["\<\
Raw entries are promoted, and numerical and symbolic arrays may be mixed:\
\>", "ExampleText",ExpressionUUID->"383cff32-246c-ce43-82ed-1ace91b19d71"],

Cell["\<\
Hypermatrix[{{1, 2}, GenerateSymbolicArray[a, {2, 2}]}][\"Domains\"]\
\>", "Input",ExpressionUUID->"7aab3712-3383-9b46-8861-9c73537a4b07"],

