Cell["\<\
Lowest order first, then the shorter dimensions, then the symmetries:\
\>", "ExampleText",ExpressionUUID->"bf5f4faf-d0de-244b-88d4-98ccd598cd3c"],

Cell["{hm[\"Orders\"], hm[\"Dimensions\"], hm[\"Symmetries\"]}", "Input",ExpressionUUID->"8b0ec35f-0e8a-7a49-870b-87507f2dc9ea"],

