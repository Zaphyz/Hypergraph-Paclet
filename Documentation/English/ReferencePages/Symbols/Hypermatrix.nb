Cell["\<\
Lowest order first, then the shorter dimensions, then the symmetries:\
\>", "ExampleText",ExpressionUUID->"69b7c3b8-6a90-9b4f-ba3a-56c5bb08b656"],

Cell["{hm[\"Orders\"], hm[\"Dimensions\"], hm[\"Symmetries\"]}", "Input",ExpressionUUID->"63c7e0f1-3196-7441-b137-0d6927e5a5e9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
