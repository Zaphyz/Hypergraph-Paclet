    "}"}]}], "}"}]], "Output",ExpressionUUID->"d6c1447e-3f4b-7946-ab5f-\
27dbaa29dd8e"],

Cell["\<\
The result does not depend on the order the arrays were given in:\
\>", "ExampleText",ExpressionUUID->"ae6930d2-da0e-a941-b828-fcb298876986"],

Cell["\<\
Hypermatrix[{ArrayObject[{1, 2}], ArrayObject[{{1, 2}, {3, 4}}]}] ===
 Hypermatrix[{ArrayObject[{{1, 2}, {3, 4}}], ArrayObject[{1, 2}]}]\
\>", "Input",ExpressionUUID->"a4d53a91-c4a6-704f-9248-a83f1ffe3e1e"],

Cell[BoxData["True"], "Output",ExpressionUUID->"825d5108-292d-da44-8b82-78aaf60a5bce"],

Cell["\<\
Raw entries are promoted, and numerical and symbolic arrays may be mixed:\
\>", "ExampleText",ExpressionUUID->"0167438d-2090-1f41-9788-e50eed6b4ea2"],

Cell["\<\
Hypermatrix[{{1, 2}, GenerateSymbolicArray[a, {2, 2}]}][\"Domains\"]\
\>", "Input",ExpressionUUID->"7b89025a-15f6-4f4e-a77b-22acd636da7c"],

