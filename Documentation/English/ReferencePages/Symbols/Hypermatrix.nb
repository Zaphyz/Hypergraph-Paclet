    "}"}]}], "}"}]], "Output",ExpressionUUID->"9738890d-5fe9-594a-a828-\
f213d3f0aef6"],

Cell["\<\
The result does not depend on the order the arrays were given in:\
\>", "ExampleText",ExpressionUUID->"178020cd-0fd4-bf40-8967-84ffb503cfbc"],

Cell["\<\
Hypermatrix[{ArrayObject[{1, 2}], ArrayObject[{{1, 2}, {3, 4}}]}] ===
 Hypermatrix[{ArrayObject[{{1, 2}, {3, 4}}], ArrayObject[{1, 2}]}]\
\>", "Input",ExpressionUUID->"628757fd-a434-0f4e-bbf2-05b854d2d494"],

Cell[BoxData["True"], "Output",ExpressionUUID->"93337e3b-d4f6-ce49-9098-e8db437811b5"],

Cell["\<\
Raw entries are promoted, and numerical and symbolic arrays may be mixed:\
\>", "ExampleText",ExpressionUUID->"5c8d50bf-6be3-dc40-a680-fe98d748cf11"],

Cell["\<\
Hypermatrix[{{1, 2}, GenerateSymbolicArray[a, {2, 2}]}][\"Domains\"]\
\>", "Input",ExpressionUUID->"39047ecb-249d-f041-9280-36705e663be4"],

