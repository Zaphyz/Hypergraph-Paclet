    "}"}]}], "}"}]], "Output",ExpressionUUID->"90c670c4-6063-cd44-9616-\
7bc9906f1139"],

Cell["\<\
The result does not depend on the order the arrays were given in:\
\>", "ExampleText",ExpressionUUID->"b0f15044-664a-c743-a1f5-a1da0749c34b"],

Cell["\<\
Hypermatrix[{ArrayObject[{1, 2}], ArrayObject[{{1, 2}, {3, 4}}]}] ===
 Hypermatrix[{ArrayObject[{{1, 2}, {3, 4}}], ArrayObject[{1, 2}]}]\
\>", "Input",ExpressionUUID->"221ce1c4-4817-ea4a-9c9e-0f81a280021c"],

Cell[BoxData["True"], "Output",ExpressionUUID->"8d03c72d-d04e-ef43-adab-4417515dbfc6"],

Cell["\<\
Raw entries are promoted, and numerical and symbolic arrays may be mixed:\
\>", "ExampleText",ExpressionUUID->"7436222c-d662-de4a-bb8a-fbcd9b1ac4ed"],

Cell["\<\
Hypermatrix[{{1, 2}, GenerateSymbolicArray[a, {2, 2}]}][\"Domains\"]\
\>", "Input",ExpressionUUID->"e8fa0952-9623-404f-a75f-02289fa7f965"],

