    "}"}]}], "}"}]], "Output",ExpressionUUID->"c662527a-ccc2-344f-b4ac-\
b2257cac3f01"],

Cell["\<\
The result does not depend on the order the arrays were given in:\
\>", "ExampleText",ExpressionUUID->"ca70a4d7-5ae9-c645-8bbd-71519f906101"],

Cell["\<\
Hypermatrix[{ArrayObject[{1, 2}], ArrayObject[{{1, 2}, {3, 4}}]}] ===
 Hypermatrix[{ArrayObject[{{1, 2}, {3, 4}}], ArrayObject[{1, 2}]}]\
\>", "Input",ExpressionUUID->"3b7f6023-5c2c-5141-9442-637a6ce1883e"],

Cell[BoxData["True"], "Output",ExpressionUUID->"247a24c6-808d-3f44-9763-c2c1ad103047"],

Cell["\<\
Raw entries are promoted, and numerical and symbolic arrays may be mixed:\
\>", "ExampleText",ExpressionUUID->"9e680b12-b188-4948-8100-3c2d9797d1a3"],

Cell["\<\
Hypermatrix[{{1, 2}, GenerateSymbolicArray[a, {2, 2}]}][\"Domains\"]\
\>", "Input",ExpressionUUID->"965c3162-5d31-8844-baf4-a8c5e76b1d8b"],

