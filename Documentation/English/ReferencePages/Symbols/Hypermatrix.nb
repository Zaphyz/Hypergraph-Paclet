Cell["\<\
Lowest order first, then the shorter dimensions, then the symmetries:\
\>", "ExampleText",ExpressionUUID->"940d0b54-fca3-334f-b5ca-749954d1eeed"],

Cell["{hm[\"Orders\"], hm[\"Dimensions\"], hm[\"Symmetries\"]}", "Input",ExpressionUUID->"0baed506-946d-e54b-aabd-978a90036a7d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "2", ",", "2", ",", "2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", "2", "}"}], ",", 
