Cell["\<\
{Length[hm], Normal @ Hypermatrix[{ArrayObject[{{1, 2}, {3, 4}}], \
ArrayObject[{1, 2}]}]}\
\>", "Input",ExpressionUUID->"f974a45d-5ddc-b042-a57d-054180931a36"],

