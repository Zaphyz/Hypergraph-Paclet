Cell["\<\
The result does not depend on the order the arrays were given in:\
\>", "ExampleText",ExpressionUUID->"cae657e0-e59c-4d46-8947-db9dc1d5e215"],

Cell["\<\
Hypermatrix[{NumericalArray[{1, 2}], NumericalArray[{{1, 2}, {3, 4}}]}] ===
 Hypermatrix[{NumericalArray[{{1, 2}, {3, 4}}], NumericalArray[{1, 2}]}]\
\>", "Input",ExpressionUUID->"120672d4-1fbe-0449-9265-6d8882942282"],

Cell[BoxData["True"], "Output",ExpressionUUID->"fb9a427d-99f1-7c45-945b-bb2a6b1e81a8"],

Cell["\<\
Raw entries are promoted, and numerical and symbolic arrays may be mixed:\
\>", "ExampleText",ExpressionUUID->"3bf62c57-bb66-d743-bc45-d5447c0944b1"],

