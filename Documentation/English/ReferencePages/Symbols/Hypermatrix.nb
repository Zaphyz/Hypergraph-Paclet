    "}"}]}], "}"}]], "Output",ExpressionUUID->"f71d5536-8173-7b44-828c-\
cee3e29e033b"],

Cell["\<\
The result does not depend on the order the arrays were given in:\
\>", "ExampleText",ExpressionUUID->"3ec0b148-36ea-9841-b1ea-46ce17b89a95"],

Cell["\<\
Hypermatrix[{ArrayObject[{1, 2}], ArrayObject[{{1, 2}, {3, 4}}]}] ===
 Hypermatrix[{ArrayObject[{{1, 2}, {3, 4}}], ArrayObject[{1, 2}]}]\
\>", "Input",ExpressionUUID->"012caeb6-4798-7a45-a023-f2ea7beef12e"],

Cell[BoxData["True"], "Output",ExpressionUUID->"5af00c0b-6a57-cd40-afaa-a8b90044f0f4"],

Cell["\<\
Raw entries are promoted, and numerical and symbolic arrays may be mixed:\
\>", "ExampleText",ExpressionUUID->"c5a2bb1f-e439-2e4f-b059-668084f12fe5"],

Cell["\<\
Hypermatrix[{{1, 2}, GenerateSymbolicArray[a, {2, 2}]}][\"Domains\"]\
\>", "Input",ExpressionUUID->"923309d8-9be4-d14e-a25e-bfc89125a864"],

