Cell["\<\
Lowest order first, then the shorter dimensions, then the symmetries:\
\>", "ExampleText",ExpressionUUID->"045002b8-6de2-e448-a70c-93a33eb4e458"],

Cell["{hm[\"Orders\"], hm[\"Dimensions\"], hm[\"Symmetries\"]}", "Input",ExpressionUUID->"e59e4ec7-f095-584e-b24e-2e0a66a6bb84"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "2", ",", "2", ",", "2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", "2", "}"}], ",", 
