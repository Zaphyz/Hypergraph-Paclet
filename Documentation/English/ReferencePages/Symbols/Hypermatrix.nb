Cell["\<\
Lowest order first, then the shorter dimensions, then the symmetries:\
\>", "ExampleText",ExpressionUUID->"d1494f89-66b2-a643-9468-3f384e1b70fc"],

Cell["{hm[\"Orders\"], hm[\"Dimensions\"], hm[\"Symmetries\"]}", "Input",ExpressionUUID->"26986b3e-0280-494d-b127-8cbd4201fb6e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "2", ",", "2", ",", "2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", "2", "}"}], ",", 
