Cell["\<\
{Length[hm], Normal @ Hypermatrix[{ArrayObject[{{1, 2}, {3, 4}}], \
ArrayObject[{1, 2}]}]}\
\>", "Input",ExpressionUUID->"6f78ea31-13b3-2f49-bfcb-8188f5eb8167"],

