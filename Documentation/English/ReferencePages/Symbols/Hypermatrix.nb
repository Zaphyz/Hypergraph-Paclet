    "}"}]}], "}"}]], "Output",ExpressionUUID->"6dedb0f2-e198-3c48-bc09-\
71921d1c53a2"],

Cell["\<\
The result does not depend on the order the arrays were given in:\
\>", "ExampleText",ExpressionUUID->"df9f3944-6120-864c-b3d5-2ac3a1058d7b"],

Cell["\<\
Hypermatrix[{ArrayObject[{1, 2}], ArrayObject[{{1, 2}, {3, 4}}]}] ===
 Hypermatrix[{ArrayObject[{{1, 2}, {3, 4}}], ArrayObject[{1, 2}]}]\
\>", "Input",ExpressionUUID->"5025ec13-5556-a146-828c-c78dc9bcc2b2"],

Cell[BoxData["True"], "Output",ExpressionUUID->"1640ed47-fd92-f24e-998d-233705894cc2"],

Cell["\<\
Raw entries are promoted, and numerical and symbolic arrays may be mixed:\
\>", "ExampleText",ExpressionUUID->"766d30c0-113b-1d4e-8723-522ea6714dab"],

Cell["\<\
Hypermatrix[{{1, 2}, GenerateSymbolicArray[a, {2, 2}]}][\"Domains\"]\
\>", "Input",ExpressionUUID->"170d66f4-2d99-fa43-972d-06594ad85632"],

