 RowBox[{"{", 
  RowBox[{"\<\"Integer\"\>", ",", "\<\"Expression\"\>"}], "}"}]], "Output",Exp\
ressionUUID->"80bd174c-c932-9043-ac2e-445f40b37f22"],

Cell["The number of arrays, and their entries:", "ExampleText",ExpressionUUID->"c387fe3a-9fc2-8645-bedd-dced5ecc20e2"],

Cell["\<\
{Length[hm], Normal @ Hypermatrix[{ArrayObject[{{1, 2}, {3, 4}}], \
ArrayObject[{1, 2}]}]}\
\>", "Input",ExpressionUUID->"10698246-4877-ca48-9cb0-e4fe8d66e60c"],

