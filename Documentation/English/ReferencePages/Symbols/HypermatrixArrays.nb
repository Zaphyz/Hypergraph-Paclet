Cell["\<\
The properties of a hypermatrix read off its arrays in the same order:\
\>", "ExampleText",ExpressionUUID->"7ead7433-8984-0240-be1c-8526bfc2fdd9"],

Cell["\<\
hm2 = Hypermatrix[{{{1, 2}, {3, 4}}, {1, 2}, SymbolicArray[a, {2, 2}, \
\"Symmetric\"]}];
{hm2[\"Orders\"], hm2[\"Symmetries\"], hm2[\"Domains\"]}\
\>", "Input",ExpressionUUID->"a6ea9a93-eb0e-ba4b-91a8-101e2fee7e93"],

