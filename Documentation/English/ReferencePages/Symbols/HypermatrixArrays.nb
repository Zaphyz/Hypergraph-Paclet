Cell["\<\
The properties of a hypermatrix read off its arrays in the same order:\
\>", "ExampleText",ExpressionUUID->"0084cec1-70f6-4647-a44e-be48f25813e9"],

Cell["\<\
hm2 = Hypermatrix[{{{1, 2}, {3, 4}}, {1, 2}, GenerateSymbolicArray[a, {2, 2}, \
\"Symmetric\"]}];
{hm2[\"Orders\"], hm2[\"Symmetries\"], hm2[\"Domains\"]}\
\>", "Input",ExpressionUUID->"da06b136-ca23-e34c-b924-198a0d0b84cc"],

