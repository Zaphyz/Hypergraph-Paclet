Notebook[{
Cell["HypermatrixGraphics", "ObjectName",ExpressionUUID->"bd742b13-5547-7e48-b11c-7003e04897b5"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypermatrixGraphics", "[", "hm", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"8feda6ef-7795-7a46-9db2-8a1822332d36"],
 " ",
 "draws each array of the hypermatrix hm in the plane, in canonical order."
}], "Usage",ExpressionUUID->"80c3f763-2654-bf4c-944a-1666ad129664"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"76133042-055b-7148-aca9-b946f90c8fdf"],

Cell["\<\
Each array is drawn by ArrayGraphics, and the options are the same.\
\>", "Notes",ExpressionUUID->"e9bf8c34-453d-224b-af24-0540db2bb28e"],

Cell["\<\
The arrays appear in the hypermatrix's own order: lowest order first, then \
the shorter dimensions, then symmetry.\
\>", "Notes",ExpressionUUID->"a623404a-9d47-0940-96e7-968d88366887"],

Cell[TextData[{
 "For cubes arranged in space, see ",
 Cell[BoxData[
  StyleBox["HypermatrixGraphics3D", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"ad6b865f-0958-4641-a0f4-77c81610e762"],
 "."
}], "Notes",ExpressionUUID->"8504c895-58d9-5f41-82a2-611196305e46"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"0e76a3db-466a-644b-988f-d477c7badc6b"],

