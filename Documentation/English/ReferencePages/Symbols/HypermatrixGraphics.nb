Notebook[{
Cell["HypermatrixGraphics", "ObjectName",ExpressionUUID->"31c719a3-1cfa-ae41-b1f9-0785dbddef41"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypermatrixGraphics", "[", "hm", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"3caa78bb-833d-284e-8513-0fed8f8c54f0"],
 " ",
 "draws each array of the hypermatrix hm in the plane, in canonical order."
}], "Usage",ExpressionUUID->"0ff23322-925f-0e40-a9c2-d9529636d144"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"7185886d-8d8b-8e44-b420-288f74dffec7"],

Cell["\<\
Each array is drawn by ArrayGraphics, and the options are the same.\
\>", "Notes",ExpressionUUID->"b0035c00-5e0e-674e-a54f-f77a16be0673"],

Cell["\<\
The arrays appear in the hypermatrix's own order: lowest order first, then \
the shorter dimensions, then symmetry.\
\>", "Notes",ExpressionUUID->"1eb606ea-1eb8-774e-a28b-25814b565996"],

Cell[TextData[{
 "For cubes arranged in space, see ",
 Cell[BoxData[
  StyleBox["HypermatrixGraphics3D", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"5ebcdbdc-cfd3-1045-b57f-ae15ea52c8b0"],
 "."
}], "Notes",ExpressionUUID->"52beb88c-aa48-c644-a77e-557824dd9add"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"c2d6de8d-c48f-304d-b8d8-bf5970273eba"],

