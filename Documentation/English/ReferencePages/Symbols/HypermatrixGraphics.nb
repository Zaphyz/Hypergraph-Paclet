Notebook[{
Cell["HypermatrixGraphics", "ObjectName",ExpressionUUID->"ea0905f9-4ab3-514a-9851-833cd2cb454f"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypermatrixGraphics", "[", "hm", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"bfb8bd57-4b9f-0e4f-98f8-86eef9ff3f20"],
 " ",
 "draws each array of the hypermatrix hm in the plane, in canonical order."
}], "Usage",ExpressionUUID->"1b891580-a8a5-264d-a323-b3c1563011b5"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"05f15a79-3d95-1649-8667-08bc958772e6"],

Cell["\<\
Each array is drawn by ArrayGraphics, and the options are the same.\
\>", "Notes",ExpressionUUID->"bab3c4f2-8f72-ac49-9fd0-84dd454f254a"],

Cell["\<\
The arrays appear in the hypermatrix's own order: lowest order first, then \
the shorter dimensions, then symmetry.\
\>", "Notes",ExpressionUUID->"32ad99fa-dd69-8248-95aa-6ade967822c3"],

Cell[TextData[{
 "For cubes arranged in space, see ",
 Cell[BoxData[
  StyleBox["HypermatrixGraphics3D", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"2d0e0f6b-7e0d-9b4b-9fe4-424b04308511"],
 "."
}], "Notes",ExpressionUUID->"5812ddf2-a1e4-7944-a8a0-dd4196636562"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"931239a6-14b0-e04d-b2f0-85583cb79fcf"],

