Notebook[{
Cell["HypermatrixGraphics", "ObjectName",ExpressionUUID->"2b9a00f0-d21f-d741-9c6d-082aff295467"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypermatrixGraphics", "[", "hm", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"86ac9b52-ab33-194a-b379-e1bb1aa29972"],
 " ",
 "draws each array of the hypermatrix hm in the plane, in canonical order."
}], "Usage",ExpressionUUID->"9385d829-2303-3543-b30f-8c491a01edc3"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"48a972ae-563b-5a4c-a1d5-a92f55b255d7"],

Cell["\<\
Each array is drawn by ArrayGraphics, and the options are the same.\
\>", "Notes",ExpressionUUID->"34fec8e6-ed97-dc4f-9239-58b5ad734e90"],

Cell["\<\
The arrays appear in the hypermatrix's own order: lowest order first, then \
the shorter dimensions, then symmetry.\
\>", "Notes",ExpressionUUID->"fa22e04a-2f9a-c343-9c1e-bfd2b8bf8a03"],

Cell[TextData[{
 "For cubes arranged in space, see ",
 Cell[BoxData[
  StyleBox["HypermatrixGraphics3D", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"30b864d0-3419-e74e-b7bb-79b8a0a5f5bc"],
 "."
}], "Notes",ExpressionUUID->"d7c202de-7b74-964f-953c-35ba093121a5"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"5ee5ce6b-3fc4-4145-8fde-92c4bd14f46e"],

