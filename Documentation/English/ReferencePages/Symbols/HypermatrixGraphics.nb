Notebook[{
Cell["HypermatrixGraphics", "ObjectName",ExpressionUUID->"79833d4f-c842-a24a-8e0a-c6b32cd8a85f"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypermatrixGraphics", "[", "hm", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"d13122ba-7430-574f-9a1a-08ce4ea36e68"],
 " ",
 "draws each array of the hypermatrix hm in the plane, in canonical order."
}], "Usage",ExpressionUUID->"e79dc5f6-4802-5b48-b8eb-4d5ee7a3b986"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"12d658a2-dfef-7543-bc1b-578842eb3995"],

Cell["\<\
Each array is drawn by ArrayGraphics, and the options are the same.\
\>", "Notes",ExpressionUUID->"d1c8f153-d03c-d042-9b8e-a4acf6f924fa"],

Cell["\<\
The arrays appear in the hypermatrix's own order: lowest order first, then \
the shorter dimensions, then symmetry.\
\>", "Notes",ExpressionUUID->"82c3da7b-d2aa-1940-81f5-57f8e21455c9"],

Cell[TextData[{
 "For cubes arranged in space, see ",
 Cell[BoxData[
  StyleBox["HypermatrixGraphics3D", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"dcaf985f-0ddc-7a40-bb88-2a416e0e9bb4"],
 "."
}], "Notes",ExpressionUUID->"3ea0a80e-a800-424d-b050-bc3d1fa4b9fb"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"4a08dd3d-5d6e-c241-95a3-94186f226bc0"],

