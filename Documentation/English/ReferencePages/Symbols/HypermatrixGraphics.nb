Notebook[{
Cell["HypermatrixGraphics", "ObjectName",ExpressionUUID->"70a8f9ca-7c53-384a-afcf-727c85de30a9"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypermatrixGraphics", "[", "hm", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"e87cc977-7549-1446-bfdb-1ecb4e58a024"],
 " ",
 "draws each array of the hypermatrix hm in the plane, in canonical order."
}], "Usage",ExpressionUUID->"cb62765f-7ba2-ac4b-9563-8b452153ad95"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"f81e08ea-4377-5640-8572-5931fe85fa56"],

Cell["\<\
Each array is drawn by ArrayGraphics, and the options are the same.\
\>", "Notes",ExpressionUUID->"b4026244-aa14-3c45-b861-a571c42f628f"],

Cell["\<\
The arrays appear in the hypermatrix's own order: lowest order first, then \
the shorter dimensions, then symmetry.\
\>", "Notes",ExpressionUUID->"1b65ccec-4137-1449-8846-c485d14d1570"],

Cell[TextData[{
 "For cubes arranged in space, see ",
 Cell[BoxData[
  StyleBox["HypermatrixGraphics3D", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"7c47f903-cf56-ea45-b444-3062654b8360"],
 "."
}], "Notes",ExpressionUUID->"1858f8c5-9604-4544-944f-1f01011cf280"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"7c82d1d1-f9d6-c84f-90f8-22c9ca4aef38"],

