Notebook[{
Cell["HypermatrixGraphics", "ObjectName",ExpressionUUID->"cf6f8249-095f-e24f-9d1e-8c6a2db1ffb2"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypermatrixGraphics", "[", "hm", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"365bcfc6-d56d-3f45-b2cc-963b4165efaa"],
 " ",
 "draws each array of the hypermatrix hm in the plane, in canonical order."
}], "Usage",ExpressionUUID->"82a53860-666d-4442-a012-f99048595095"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"6fd20724-c937-2643-a83e-5f83583e71fb"],

Cell["\<\
Each array is drawn by ArrayGraphics, and the options are the same.\
\>", "Notes",ExpressionUUID->"93659710-8e0f-3f4b-9c97-878653d53620"],

Cell["\<\
The arrays appear in the hypermatrix's own order: lowest order first, then \
the shorter dimensions, then symmetry.\
\>", "Notes",ExpressionUUID->"c914cab0-5cd1-954a-9856-1ac9b29bf928"],

Cell[TextData[{
 "For cubes arranged in space, see ",
 Cell[BoxData[
  StyleBox["HypermatrixGraphics3D", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"afd5ae4d-6307-2b44-a475-fd756229f1e2"],
 "."
}], "Notes",ExpressionUUID->"07feca31-67eb-1349-92e4-1eef13357aa9"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"ff01c110-b572-2a40-acc6-c7ff4d47bb22"],

