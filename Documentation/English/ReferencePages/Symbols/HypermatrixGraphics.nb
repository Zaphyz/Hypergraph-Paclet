Notebook[{
Cell["HypermatrixGraphics", "ObjectName",ExpressionUUID->"8c88b0a9-400e-2e47-92ba-17fc22d26dad"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypermatrixGraphics", "[", "hm", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"b5d6290e-a508-e743-af85-82387099268f"],
 " ",
 "draws each array of the hypermatrix hm in the plane, in canonical order."
}], "Usage",ExpressionUUID->"e54d8d1a-8bbe-164f-bcd2-1ea800f51e6b"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"9cab5014-29db-4e49-b5f9-f5f5bd054f0a"],

Cell["\<\
Each array is drawn by ArrayGraphics, and the options are the same.\
\>", "Notes",ExpressionUUID->"97cdb16b-676f-a948-acb6-d47ac3ce42f8"],

Cell["\<\
The arrays appear in the hypermatrix's own order: lowest order first, then \
the shorter dimensions, then symmetry.\
\>", "Notes",ExpressionUUID->"37f118e7-47be-844f-ab2e-b37019531fd9"],

Cell[TextData[{
 "For cubes arranged in space, see ",
 Cell[BoxData[
  StyleBox["HypermatrixGraphics3D", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"352a3e95-2fad-7e42-99f6-edb15d5f8595"],
 "."
}], "Notes",ExpressionUUID->"1d734c00-3324-3148-9abe-e14f447edc25"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"7c09bd10-eb66-c044-bcd8-c63b77bd45d0"],

