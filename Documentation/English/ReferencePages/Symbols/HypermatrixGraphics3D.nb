Cell["HypermatrixGraphics3D", "ObjectName",ExpressionUUID->"95e4d4e1-cbf6-7e41-a20c-fab65ba1a8d4"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypermatrixGraphics3D", "[", "hm", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"46fc62cc-49ee-db40-98ad-bf8b29ef641d"],
 " ",
 "draws each array of the hypermatrix hm as cubes in space, in canonical \
order."
}], "Usage",ExpressionUUID->"fc6bffb3-f227-cc4e-8620-119f067d7c9b"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"9184b9ad-916e-6247-af36-41b746063f77"],

Cell["\<\
