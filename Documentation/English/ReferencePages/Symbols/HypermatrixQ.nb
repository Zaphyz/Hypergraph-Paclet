Notebook[{
Cell["HypermatrixQ", "ObjectName",ExpressionUUID->"3132b5f5-e0df-6747-a031-0a5d311bfe6a"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypermatrixQ", "[", "expr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"d5e2aa4c-633e-6d4f-a6cb-e671fb918ea1"],
 " ",
 "gives True if expr is a valid Hypermatrix object, and False otherwise."
}], "Usage",ExpressionUUID->"2e814828-c145-2e47-acf7-9dc577ebff78"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"184feee7-a5c8-7b43-9678-97375a003997"],

Cell["\<\
A Hypermatrix expression that fails to be built evaluates to $Failed, so any \
surviving Hypermatrix object holds valid arrays in canonical order.\
\>", "Notes",ExpressionUUID->"c82df410-5e82-9543-b006-7f6aa34d4900"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"ac0e8c89-0c0d-974e-9db2-d01ba4f4eaef"],

Cell["\<\
{HypermatrixQ @ Hypermatrix[{{1, 2}}], HypermatrixQ[{ArrayObject[{1, 2}]}], \
HypermatrixQ[17]}\
\>", "Input",ExpressionUUID->"201a1f35-86c3-d847-968a-8bc41c609437"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False", ",", "False"}], "}"}]], "Output",ExpressionUUI\
D->"bf77c6d7-40ea-1b41-be28-580accea131f"],

