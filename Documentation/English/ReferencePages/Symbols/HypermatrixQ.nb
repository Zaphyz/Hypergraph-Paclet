Notebook[{
Cell["HypermatrixQ", "ObjectName",ExpressionUUID->"baae1dc6-c54a-ad46-a187-60e9716d8056"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypermatrixQ", "[", "expr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"591e5f8b-39d1-3e4a-a94b-78595627fd98"],
 " ",
 "gives True if expr is a valid Hypermatrix object, and False otherwise."
}], "Usage",ExpressionUUID->"066a901a-2c21-b34d-a81f-639dfbe70f86"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"0d2e574d-18f2-6a48-acbd-a99e39c19f7f"],

Cell["\<\
A Hypermatrix expression that fails to be built evaluates to $Failed, so any \
surviving Hypermatrix object holds valid arrays in canonical order.\
\>", "Notes",ExpressionUUID->"81455238-f8cf-c743-96d4-6e4ce9959aef"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"2128617a-06fb-db4f-9d2f-7ee971e3662d"],

Cell["\<\
{HypermatrixQ @ Hypermatrix[{{1, 2}}], HypermatrixQ[{ArrayObject[{1, 2}]}], \
HypermatrixQ[17]}\
\>", "Input",ExpressionUUID->"7208e827-c0e2-574d-9d3f-bb682974de9a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False", ",", "False"}], "}"}]], "Output",ExpressionUUI\
D->"6bc3e722-cbb3-104c-91bb-11f5b7b61adb"],

