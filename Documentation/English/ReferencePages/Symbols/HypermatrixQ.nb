Notebook[{
Cell["HypermatrixQ", "ObjectName",ExpressionUUID->"d564b75a-3625-2b42-98aa-5e560af06ad7"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypermatrixQ", "[", "expr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"c00cfd15-1cf1-0b41-ac21-d31f804be340"],
 " ",
 "gives True if expr is a valid Hypermatrix object, and False otherwise."
}], "Usage",ExpressionUUID->"4f5b4ea9-6fd0-1446-a776-74f40212af7b"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"ccc1c264-98a8-0b45-82b6-d7a0439d7fbb"],

Cell["\<\
A Hypermatrix expression that fails to be built evaluates to $Failed, so any \
surviving Hypermatrix object holds valid arrays in canonical order.\
\>", "Notes",ExpressionUUID->"b3193128-89bc-df41-82a6-fcaffd9f8cf3"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"5068354c-b0d8-6649-bf26-50f13d12137f"],

Cell["\<\
{HypermatrixQ @ Hypermatrix[{{1, 2}}], HypermatrixQ[{ArrayObject[{1, 2}]}], \
HypermatrixQ[17]}\
\>", "Input",ExpressionUUID->"09fe4d7c-6acd-8d4f-b102-ef31fd4d22dc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False", ",", "False"}], "}"}]], "Output",ExpressionUUI\
D->"7bab4e05-067c-dd44-98b2-d16b85356c4c"],

