Notebook[{
Cell["HypermatrixQ", "ObjectName",ExpressionUUID->"0504a7cb-c30b-6a43-81b3-828cad8016e2"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypermatrixQ", "[", "expr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"9ad89406-eb33-ad4f-bcd8-dae0f8a1d5bf"],
 " ",
 "gives True if expr is a valid Hypermatrix object, and False otherwise."
}], "Usage",ExpressionUUID->"bdbac280-fd1e-1141-9c2d-e2280291f51b"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"c140d11f-93af-0c4f-9f3b-1811cf6164a4"],

Cell["\<\
A Hypermatrix expression that fails to be built evaluates to $Failed, so any \
surviving Hypermatrix object holds valid arrays in canonical order.\
\>", "Notes",ExpressionUUID->"ec846d21-3382-434c-92b0-96b9c814aadf"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"ab850d35-0782-d54a-8b46-e8e5f2320a49"],

Cell["\<\
{HypermatrixQ @ Hypermatrix[{{1, 2}}], HypermatrixQ[{ArrayObject[{1, 2}]}], \
HypermatrixQ[17]}\
\>", "Input",ExpressionUUID->"820607d5-5ce6-684e-8c32-ca33e6202d13"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False", ",", "False"}], "}"}]], "Output",ExpressionUUI\
D->"232ca19e-721f-174d-9472-112b3ab34fa7"],

