Notebook[{
Cell["HypermatrixQ", "ObjectName",ExpressionUUID->"f1391ff3-d58f-5246-bf15-aa33352b86fa"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypermatrixQ", "[", "expr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"d0f40130-b27a-4e4f-b3fc-67f857aa1e4d"],
 " ",
 "gives True if expr is a valid Hypermatrix object, and False otherwise."
}], "Usage",ExpressionUUID->"4d668d75-8d86-6644-9df1-d4991ac71413"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"51e8075e-a6d3-dc4a-9a03-8a76f9929fd7"],

Cell["\<\
A Hypermatrix expression that fails to be built evaluates to $Failed, so any \
surviving Hypermatrix object holds valid arrays in canonical order.\
\>", "Notes",ExpressionUUID->"66066419-0be8-c44a-8d87-61265ef4d5c4"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"2d344eaf-1da9-ae42-88fb-9279b277e257"],

Cell["\<\
{HypermatrixQ @ Hypermatrix[{{1, 2}}], HypermatrixQ[{NumericalArray[{1, \
2}]}], HypermatrixQ[17]}\
\>", "Input",ExpressionUUID->"73d1e0e8-0cbe-dd4d-a064-0eb33c228a60"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False", ",", "False"}], "}"}]], "Output",ExpressionUUI\
D->"19117bb0-878b-c340-b69b-2a59dea4ea99"],

