Notebook[{
Cell["HypermatrixQ", "ObjectName",ExpressionUUID->"4f700d49-cc59-4848-8e7a-ec836d30259a"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypermatrixQ", "[", "expr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"ae8faa9f-8a09-c34f-83a3-83004ccde758"],
 " ",
 "gives True if expr is a valid Hypermatrix object, and False otherwise."
}], "Usage",ExpressionUUID->"021edd8b-259b-f646-88f3-4124c95deccb"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"eacb801e-df38-9a47-84cd-16999ebae333"],

Cell["\<\
A Hypermatrix expression that fails to be built evaluates to $Failed, so any \
surviving Hypermatrix object holds valid arrays in canonical order.\
\>", "Notes",ExpressionUUID->"9e166a7c-e5b2-7244-89b3-54d6b0416c31"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"19eb00e7-fa6c-444b-b987-e0b54f16563b"],

Cell["\<\
{HypermatrixQ @ Hypermatrix[{{1, 2}}], HypermatrixQ[{ArrayObject[{1, 2}]}], \
HypermatrixQ[17]}\
\>", "Input",ExpressionUUID->"401383f6-3f7e-834c-bbb7-bb1af9320fe0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False", ",", "False"}], "}"}]], "Output",ExpressionUUI\
D->"54802366-adf7-6b4e-910b-609b48666a0f"],

