Notebook[{
Cell["HypermatrixQ", "ObjectName",ExpressionUUID->"5ae34a28-34f8-7b4b-8539-fc559d67f0e0"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypermatrixQ", "[", "expr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"49750cb3-f052-a043-8e56-90754cc97141"],
 " ",
 "gives True if expr is a valid Hypermatrix object, and False otherwise."
}], "Usage",ExpressionUUID->"6dd37474-5ea7-4343-a215-28dd3a74ec26"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"fb093275-8939-c944-b185-e4c82041602b"],

Cell["\<\
A Hypermatrix expression that fails to be built evaluates to $Failed, so any \
surviving Hypermatrix object holds valid arrays in canonical order.\
\>", "Notes",ExpressionUUID->"e4145ad3-08cd-0248-8ac8-19fdb6c25f17"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"d700df62-6db3-844c-b2f6-4ca566d6cc83"],

Cell["\<\
{HypermatrixQ @ Hypermatrix[{{1, 2}}], HypermatrixQ[{ArrayObject[{1, 2}]}], \
HypermatrixQ[17]}\
\>", "Input",ExpressionUUID->"582e9e81-db1f-fe40-a909-c3aa386c9106"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False", ",", "False"}], "}"}]], "Output",ExpressionUUI\
D->"a4418a30-73fd-4c49-81cf-0359c2965977"],

Cell["Source", "NotesSection",ExpressionUUID->"45d9f924-7efe-1846-b59a-049c0a93a145"],

