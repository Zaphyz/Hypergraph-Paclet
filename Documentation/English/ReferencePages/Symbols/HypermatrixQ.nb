Notebook[{
Cell["HypermatrixQ", "ObjectName",ExpressionUUID->"20badf68-b19e-6e46-9fa1-75475205f6cb"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypermatrixQ", "[", "expr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"8b856956-003f-d246-8c5f-586d4839ea02"],
 " ",
 "gives True if expr is a valid Hypermatrix object, and False otherwise."
}], "Usage",ExpressionUUID->"82143f22-f9bc-0e4c-b620-97ecc7fb47b2"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"681353ad-a4a2-964f-9048-5e553f3b2b86"],

Cell["\<\
A Hypermatrix expression that fails to be built evaluates to $Failed, so any \
surviving Hypermatrix object holds valid arrays in canonical order.\
\>", "Notes",ExpressionUUID->"cd331e19-6f69-0346-a343-2d5309d5a4f7"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"97eaa281-f5a6-1748-872a-1e3c936c02d9"],

Cell["\<\
{HypermatrixQ @ Hypermatrix[{{1, 2}}], HypermatrixQ[{ArrayObject[{1, 2}]}], \
HypermatrixQ[17]}\
\>", "Input",ExpressionUUID->"eaa88912-4a19-5848-acfe-a0e172a55930"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False", ",", "False"}], "}"}]], "Output",ExpressionUUI\
D->"3cf59ae6-4bdc-c047-a13e-b9728c16bb01"],

Cell["Source", "NotesSection",ExpressionUUID->"7caa0278-ce0e-924c-987c-55dc4e63df17"],

