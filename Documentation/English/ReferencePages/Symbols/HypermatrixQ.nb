Notebook[{
Cell["HypermatrixQ", "ObjectName",ExpressionUUID->"aa964d15-2d81-4b45-8ff6-2ebea61bc852"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"HypermatrixQ", "[", "expr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"96f2998f-4129-0c4f-af19-5433498b9bb2"],
 " ",
 "gives True if expr is a valid Hypermatrix object, and False otherwise."
}], "Usage",ExpressionUUID->"e8f0e49b-98f0-f045-8cbc-6ee2ce1bc150"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"a09c72b9-0172-cf4a-8f68-83f64cb0bff2"],

Cell["\<\
A Hypermatrix expression that fails to be built evaluates to $Failed, so any \
surviving Hypermatrix object holds valid arrays in canonical order.\
\>", "Notes",ExpressionUUID->"e386aa02-667a-1346-9ba2-80241c7346d8"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"ab8598b5-c6f5-8f46-b6b5-c80698869a9a"],

Cell["\<\
{HypermatrixQ @ Hypermatrix[{{1, 2}}], HypermatrixQ[{ArrayObject[{1, 2}]}], \
HypermatrixQ[17]}\
\>", "Input",ExpressionUUID->"8d3dd54f-9f0b-4543-a8df-0027945f9d28"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False", ",", "False"}], "}"}]], "Output",ExpressionUUI\
D->"d3f1c828-d520-f146-bfc9-042a3386410e"],

