Notebook[{
Cell["IdentityArray", "ObjectName",ExpressionUUID->"a3558a9e-049e-cd4d-960e-812f94322c8d"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"IdentityArray", "[", 
    RowBox[{"n", ",", " ", "d"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"56af9407-ac00-8542-82a8-f32e236c7edd"],
 " ",
 "gives the n-array with every index of length d whose entry is one where all \
n indices agree and zero elsewhere."
}], "Usage",ExpressionUUID->"34c07a85-16a7-514c-a31a-3952fa75ebb7"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"IdentityArray", "[", 
    RowBox[{"n", ",", " ", "d", ",", " ", "dom"}], "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"abd40b27-f5cf-ed46-94d8-9284cf0c38aa"],
 " ",
 "gives its entries in the value domain dom."
}], "Usage",ExpressionUUID->"f65c3213-75b7-a24d-acdd-5facb76f844e"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"5ceb53ab-623e-cc43-a184-25f909fdd70c"],

Cell["\<\
For n equal to 2 this is the ordinary identity matrix of size d.\
\>", "Notes",ExpressionUUID->"580fdae8-e466-3449-aba7-37724a5ea170"],

Cell["\<\
It is the generalized Kronecker delta on all n indices, and is invariant \
under every permutation of them, so it is declared \"Symmetric\".\
\>", "Notes",ExpressionUUID->"52c0ab77-cd6b-c545-9aab-bd7ad7487d9e"],

Cell["IdentityArray[n, d] is PartialIdentityArray[n, d, Range[n]].", "Notes",ExpressionUUID->"0974abcb-5310-1943-8ef9-5fb803927175"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"925d55dd-0a6e-b247-9e00-046dd0ae459d"],

Cell["At order two it is the identity matrix:", "ExampleText",ExpressionUUID->"1a281fa8-a8f5-434c-8f94-dd776e8c44b6"],

Cell["Normal @ IdentityArray[2, 3]", "Input",ExpressionUUID->"5c30ef74-ee20-d245-8b59-93ba3d25f7e3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}]], "Output",ExpressionUUI\
D->"7e9c424b-dca7-c545-abf1-3c7fde6bdef3"],

Cell["At order three it is one only on the main diagonal:", "ExampleText",ExpressionUUID->"20de4a17-c91f-774c-baa3-ca97ded5b010"],

Cell["Normal @ IdentityArray[3, 2]", "Input",ExpressionUUID->"0114b4c1-6d83-374c-a229-21a97715231b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"a75e9e6a-b7b3-c547-b437-519a9c598072"],

Cell["It acts as an identity for the matrix product:", "ExampleText",ExpressionUUID->"53755841-9092-e649-8fe1-81a508329acc"],

Cell["\<\
a = {{1, 2}, {3, 4}};
Normal @ ArrayMultiply[{Normal @ IdentityArray[2, 2], a}, \"ij,jk->ik\"]\
\>", "Input",ExpressionUUID->"483c9329-8a86-0649-a729-d83b2f40e341"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "4"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"c7662e82-47ce-9d41-8b81-c1ee92ec7688"],

Cell["Over a finite field:", "ExampleText",ExpressionUUID->"4821c51a-c100-6746-9785-f776168e2fb4"],

