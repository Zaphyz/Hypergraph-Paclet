Notebook[{
Cell["IdentityArray", "ObjectName",ExpressionUUID->"bcbb1bf0-6d79-7047-9037-610703eb3233"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"IdentityArray", "[", 
    RowBox[{"n", ",", " ", "d"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"96f2a5b5-3a91-3648-b0b0-5d7fc5dc0956"],
 " ",
 "gives the n-array with every index of length d whose entry is one where all \
n indices agree and zero elsewhere."
}], "Usage",ExpressionUUID->"f8fbb2af-eaa0-5241-addb-03939243a51f"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"IdentityArray", "[", 
    RowBox[{"n", ",", " ", "d", ",", " ", "dom"}], "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"381c7f37-f133-4645-8064-cdd786bc59e2"],
 " ",
 "gives its entries in the value domain dom."
}], "Usage",ExpressionUUID->"8bf141b4-8136-2344-b31b-e476e2208b15"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"5c3ce5ba-6ebc-2c40-9772-281005587bcd"],

Cell["\<\
For n equal to 2 this is the ordinary identity matrix of size d.\
\>", "Notes",ExpressionUUID->"52e8ad16-b16e-0341-b2ae-4f0bd39cd8f3"],

Cell["\<\
It is the generalized Kronecker delta on all n indices, and is invariant \
under every permutation of them, so it is declared \"Symmetric\".\
\>", "Notes",ExpressionUUID->"c633f9d6-85dc-2042-bc1d-4992e363d533"],

Cell["IdentityArray[n, d] is PartialIdentityArray[n, d, Range[n]].", "Notes",ExpressionUUID->"752936eb-1ec4-2a4c-9b1f-ef3ec3390e47"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"f7b72f0a-eec8-a84c-8b3c-23652d3ef230"],

Cell["At order two it is the identity matrix:", "ExampleText",ExpressionUUID->"710ff363-1153-0a4c-a89c-aa87e70ab267"],

Cell["Normal @ IdentityArray[2, 3]", "Input",ExpressionUUID->"81396bf6-81b2-9a49-98f3-ff63f1cba0bb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}]], "Output",ExpressionUUI\
D->"f096218f-c011-654a-8116-4b587e30a3f0"],

Cell["At order three it is one only on the main diagonal:", "ExampleText",ExpressionUUID->"eb696907-3890-a345-9931-6931e82cab06"],

Cell["Normal @ IdentityArray[3, 2]", "Input",ExpressionUUID->"b4eeb3ec-50b2-6d48-bd19-0967e1a692e8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"66b25876-bd6f-fb4f-b5b9-230befc88d19"],

Cell["It acts as an identity for the matrix product:", "ExampleText",ExpressionUUID->"39c22f2c-5a67-4147-9bc1-99030a19d8da"],

Cell["\<\
a = {{1, 2}, {3, 4}};
Normal @ ArrayMultiply[{Normal @ IdentityArray[2, 2], a}, \"ij,jk->ik\"]\
\>", "Input",ExpressionUUID->"5a010b58-af8f-cc46-b967-3960c8a83e81"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "4"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"5db06231-846a-4e4d-a067-eb7d45164431"],

Cell["Over a finite field:", "ExampleText",ExpressionUUID->"6dfe8f4d-2ab6-be4e-9c2a-d0e492dbe1bb"],

