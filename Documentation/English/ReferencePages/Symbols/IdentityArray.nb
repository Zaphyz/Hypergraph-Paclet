Notebook[{
Cell["IdentityArray", "ObjectName",ExpressionUUID->"ae11d757-5bb6-cd43-b8ac-8ce899655f02"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"IdentityArray", "[", 
    RowBox[{"n", ",", " ", "d"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"aee46407-daf4-834b-bf30-85d2db898718"],
 " ",
 "gives the n-array with every index of length d whose entry is one where all \
n indices agree and zero elsewhere."
}], "Usage",ExpressionUUID->"4f956d21-62ba-264d-988a-d66395c816d2"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"IdentityArray", "[", 
    RowBox[{"n", ",", " ", "d", ",", " ", "dom"}], "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"c116688c-8edc-4843-bd45-ca8bf347094b"],
 " ",
 "gives its entries in the value domain dom."
}], "Usage",ExpressionUUID->"d1e07391-f2bd-944e-aa2e-809956b71fb1"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"df8096df-620d-4649-90b4-a1175df52d54"],

Cell["\<\
For n equal to 2 this is the ordinary identity matrix of size d.\
\>", "Notes",ExpressionUUID->"b76a1707-c561-214e-ac30-2aae796b3877"],

Cell["\<\
It is the generalized Kronecker delta on all n indices, and is invariant \
under every permutation of them, so it is declared \"Symmetric\".\
\>", "Notes",ExpressionUUID->"e5972a0a-c790-7d4c-9b46-67d499d1d3fa"],

Cell["IdentityArray[n, d] is PartialIdentityArray[n, d, Range[n]].", "Notes",ExpressionUUID->"b54f272f-f141-5b44-a41f-165a616fe08d"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"06c8824d-27fe-5747-9513-abd1a2d95cab"],

Cell["At order two it is the identity matrix:", "ExampleText",ExpressionUUID->"a784e7a6-8e15-814a-bda3-c1645a93935a"],

Cell["Normal @ IdentityArray[2, 3]", "Input",ExpressionUUID->"8d4c4206-20f7-c846-9cbc-c169dc2fab07"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}]], "Output",ExpressionUUI\
D->"75b213c8-91e8-0a49-8771-c5483fb929f4"],

Cell["At order three it is one only on the main diagonal:", "ExampleText",ExpressionUUID->"65768663-22ae-1040-948e-613ad4f2b371"],

Cell["Normal @ IdentityArray[3, 2]", "Input",ExpressionUUID->"0dd4c254-d7ee-b440-bbf4-d38351f31dc3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"df4d9919-70fd-534a-bec3-f13246c95845"],

Cell["It acts as an identity for the matrix product:", "ExampleText",ExpressionUUID->"589e5e2b-2445-fa4d-a736-af6aa6703992"],

Cell["\<\
a = {{1, 2}, {3, 4}};
Normal @ ArrayMultiply[{Normal @ IdentityArray[2, 2], a}, \"ij,jk->ik\"]\
\>", "Input",ExpressionUUID->"b27d680c-ed47-0140-80c4-4851f709c228"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "4"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"e144bd84-29cc-7745-a4aa-0d17bd982e6c"],

