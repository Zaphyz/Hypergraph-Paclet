Notebook[{
Cell["IdentityArray", "ObjectName",ExpressionUUID->"2ab51f35-7bd3-164c-9972-f3f1f1b0c714"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"IdentityArray", "[", 
    RowBox[{"n", ",", " ", "d"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"5b7df439-1ef1-4941-9c24-c8563344e694"],
 " ",
 "gives the n-array with every index of length d whose entry is one where all \
n indices agree and zero elsewhere."
}], "Usage",ExpressionUUID->"c2e4e122-298f-1f43-b606-a1fe5d79cb2a"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"IdentityArray", "[", 
    RowBox[{"n", ",", " ", "d", ",", " ", "dom"}], "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"9cd464ec-e219-2348-9126-42c27ae4d01d"],
 " ",
 "gives its entries in the value domain dom."
}], "Usage",ExpressionUUID->"23ddb351-3fdc-134c-8175-99e5ddbd32cd"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"d762ed06-c228-6b4f-ac3e-e6883805cebb"],

Cell["\<\
For n equal to 2 this is the ordinary identity matrix of size d.\
\>", "Notes",ExpressionUUID->"6974f3d7-8025-6c47-8249-83d18d3972fb"],

Cell["\<\
It is the generalized Kronecker delta on all n indices, and is invariant \
under every permutation of them, so it is declared \"Symmetric\".\
\>", "Notes",ExpressionUUID->"7d337811-071d-4d40-a7f0-9a82765de431"],

Cell["IdentityArray[n, d] is PartialIdentityArray[n, d, Range[n]].", "Notes",ExpressionUUID->"c643659f-2f19-464a-b9e0-a6f1e76a349a"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"8b9a3994-fda8-b642-9f69-f410a7a76153"],

Cell["At order two it is the identity matrix:", "ExampleText",ExpressionUUID->"50ab1f46-766d-fb46-9be5-3e4478bfe0ad"],

Cell["Normal @ IdentityArray[2, 3]", "Input",ExpressionUUID->"dc6bba2e-b7a3-8240-a90a-b20ac8d5e6a2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}]], "Output",ExpressionUUI\
D->"2ff658bf-24de-dd47-92bd-06ea754da119"],

Cell["At order three it is one only on the main diagonal:", "ExampleText",ExpressionUUID->"66f496a5-f52f-0f45-8b63-fbb47c754e89"],

Cell["Normal @ IdentityArray[3, 2]", "Input",ExpressionUUID->"7cf49836-be1e-7c4a-8414-fec969bd9dd2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"a97c2554-afbf-474d-a7a0-644a52ce5248"],

Cell["It acts as an identity for the matrix product:", "ExampleText",ExpressionUUID->"ae8ae0b8-e35b-f549-800b-3a00b233969d"],

Cell["\<\
a = {{1, 2}, {3, 4}};
Normal @ ArrayMultiply[{Normal @ IdentityArray[2, 2], a}, \"ij,jk->ik\"]\
\>", "Input",ExpressionUUID->"719fadef-a227-fe43-93f1-a6b76d6d9b19"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "4"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"9de81510-eb55-a646-a88b-fc6382b5b79f"],

