Notebook[{
Cell["IdentityArray", "ObjectName",ExpressionUUID->"36c9b52f-6ad7-7543-bdd9-5d7f93439765"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"IdentityArray", "[", 
    RowBox[{"n", ",", " ", "d"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"1031a37c-4bb1-9840-932b-0d8a1e8a04d2"],
 " ",
 "gives the n-array with every index of length d whose entry is one where all \
n indices agree and zero elsewhere."
}], "Usage",ExpressionUUID->"eaf76b2f-c16d-424c-a9df-23ad533fbc0f"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"IdentityArray", "[", 
    RowBox[{"n", ",", " ", "d", ",", " ", "dom"}], "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"7e9ed761-b90e-174c-8467-362bef0e9730"],
 " ",
 "gives its entries in the value domain dom."
}], "Usage",ExpressionUUID->"1c45a7fb-c92b-a442-86dd-e40d9792f0f3"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"4c445384-4b63-2947-b5e6-540c064e30cb"],

Cell["\<\
For n equal to 2 this is the ordinary identity matrix of size d.\
\>", "Notes",ExpressionUUID->"656fa3fe-b042-d34e-9a30-75cf3d8ef497"],

Cell["\<\
It is the generalized Kronecker delta on all n indices, and is invariant \
under every permutation of them, so it is declared \"Symmetric\".\
\>", "Notes",ExpressionUUID->"2803930f-8dd0-d34e-8ecc-da67157dad56"],

Cell["IdentityArray[n, d] is PartialIdentityArray[n, d, Range[n]].", "Notes",ExpressionUUID->"824bb1a0-5f40-8c4c-a1e7-b1af4d92c329"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"3327167b-9951-e84b-b941-d881a7165f21"],

Cell["At order two it is the identity matrix:", "ExampleText",ExpressionUUID->"7b072a22-b3d9-ff47-92c8-30c5dc294c1e"],

Cell["Normal @ IdentityArray[2, 3]", "Input",ExpressionUUID->"7e7c1a4a-55bd-d349-841f-6d33a7f8db33"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}]], "Output",ExpressionUUI\
D->"37ec9434-c119-314e-96a5-4834086e9484"],

Cell["At order three it is one only on the main diagonal:", "ExampleText",ExpressionUUID->"3f1dbe47-a8b6-414e-9ca9-c7c57c254360"],

Cell["Normal @ IdentityArray[3, 2]", "Input",ExpressionUUID->"065857b7-cbc3-2946-9d5a-92b6d6f6405d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"7792295f-c0db-f54a-8589-604f59c3c22a"],

Cell["It acts as an identity for the matrix product:", "ExampleText",ExpressionUUID->"62866e88-d5da-0741-9204-533518bcbbe1"],

Cell["\<\
a = {{1, 2}, {3, 4}};
Normal @ ArrayMultiply[{Normal @ IdentityArray[2, 2], a}, \"ij,jk->ik\"]\
\>", "Input",ExpressionUUID->"0e522512-20a3-9648-a691-99fce4c0c69b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "4"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"223bae4a-52d4-3145-a0ff-ebd2d0e2ab83"],

