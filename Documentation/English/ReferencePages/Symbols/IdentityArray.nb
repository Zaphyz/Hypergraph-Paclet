Notebook[{
Cell["IdentityArray", "ObjectName",ExpressionUUID->"f5d31fca-b5c2-ee46-9a56-7b06191c443f"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"IdentityArray", "[", 
    RowBox[{"n", ",", " ", "d"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"80e0fdf9-7551-9046-bb11-5d56150b16bf"],
 " ",
 "gives the n-array with every index of length d whose entry is one where all \
n indices agree and zero elsewhere."
}], "Usage",ExpressionUUID->"f493288a-d80b-014a-bf98-dcafeb360091"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"IdentityArray", "[", 
    RowBox[{"n", ",", " ", "d", ",", " ", "dom"}], "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"609b64c7-3726-e545-b846-dfab41bfce00"],
 " ",
 "gives its entries in the value domain dom."
}], "Usage",ExpressionUUID->"410d2b05-89b8-e34f-8123-f18fda1a86fa"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"c19803c6-519f-df48-8c00-2afd9c463f08"],

Cell["\<\
For n equal to 2 this is the ordinary identity matrix of size d.\
\>", "Notes",ExpressionUUID->"c8da7f49-4803-4c4b-99c2-aedc9eed2b95"],

Cell["\<\
It is the generalized Kronecker delta on all n indices, and is invariant \
under every permutation of them, so it is declared \"Symmetric\".\
\>", "Notes",ExpressionUUID->"f4101b9e-9159-7d4c-aed0-2927d859705e"],

Cell["IdentityArray[n, d] is PartialIdentityArray[n, d, Range[n]].", "Notes",ExpressionUUID->"4192cd01-59a7-ad41-9d96-d3f64279c421"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"9dee6846-d2cc-b241-8437-8905032646eb"],

Cell["At order two it is the identity matrix:", "ExampleText",ExpressionUUID->"03c6553e-da18-ed4d-ac47-e47ea852e9c6"],

Cell["Normal @ IdentityArray[2, 3]", "Input",ExpressionUUID->"3d16ff14-a8f9-4b46-8fe5-8f619a8ebd72"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}]], "Output",ExpressionUUI\
D->"4512bbf8-b95e-bb45-a3af-e2a6c45e5191"],

Cell["At order three it is one only on the main diagonal:", "ExampleText",ExpressionUUID->"ffe096ba-0c9c-d24e-b8e3-250a5b167462"],

Cell["Normal @ IdentityArray[3, 2]", "Input",ExpressionUUID->"b0f877d6-563c-2344-aa42-3da9159a0940"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"9376bd97-57aa-5e4a-a35b-8179d2cbf5d7"],

Cell["It acts as an identity for the matrix product:", "ExampleText",ExpressionUUID->"814de779-4399-964c-89a5-f84a1ad1628b"],

Cell["\<\
a = {{1, 2}, {3, 4}};
Normal @ ArrayMultiply[{Normal @ IdentityArray[2, 2], a}, \"ij,jk->ik\"]\
\>", "Input",ExpressionUUID->"92d535ef-2dba-8948-ad4e-73db2c240410"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "4"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"5a063f86-d363-904d-bad9-448268ad980b"],

Cell["Over a finite field:", "ExampleText",ExpressionUUID->"b2dda287-3577-a34b-9cbd-5e2900a1a24f"],

Cell["Normal @ IdentityArray[2, 2, FiniteField[2, 1]]", "Input",ExpressionUUID->"f4147cb3-82ec-b440-a742-7f49a8abb095"],

