Notebook[{
Cell["IdentityArray", "ObjectName",ExpressionUUID->"be94e84a-a753-a54b-8c6c-4d53dfad74f6"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"IdentityArray", "[", 
    RowBox[{"n", ",", " ", "d"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"0a9f7d89-bbe0-c043-a339-bffb9b3c6cef"],
 " ",
 "gives the n-array with every index of length d whose entry is one where all \
n indices agree and zero elsewhere."
}], "Usage",ExpressionUUID->"e04350de-aadb-294f-a73b-111cb29c417c"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"IdentityArray", "[", 
    RowBox[{"n", ",", " ", "d", ",", " ", "dom"}], "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"bbca38d4-c990-9244-8b82-21cfbd207425"],
 " ",
 "gives its entries in the value domain dom."
}], "Usage",ExpressionUUID->"24418839-8bfc-b848-a93c-dfbf7b95f03f"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"fd21fb1b-b692-1945-a37e-12e1aef5edfb"],

Cell["\<\
For n equal to 2 this is the ordinary identity matrix of size d.\
\>", "Notes",ExpressionUUID->"b37c372d-fde7-2244-aef4-d9091d56cb92"],

Cell["\<\
It is the generalized Kronecker delta on all n indices, and is invariant \
under every permutation of them, so it is declared \"Symmetric\".\
\>", "Notes",ExpressionUUID->"939bad54-470a-0a44-ab31-84c919c4a04a"],

Cell["IdentityArray[n, d] is PartialIdentityArray[n, d, Range[n]].", "Notes",ExpressionUUID->"0f183c88-516e-4a4e-8883-676fbb40d625"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"9128df7d-1a28-7842-abbf-559f63b4f458"],

Cell["At order two it is the identity matrix:", "ExampleText",ExpressionUUID->"65f6a4c6-2e3f-0741-ae54-5a22fc54b492"],

Cell["Normal @ IdentityArray[2, 3]", "Input",ExpressionUUID->"e0efc7a2-8b1e-9045-bccd-9d59fb6fd3bf"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}]], "Output",ExpressionUUI\
D->"ef731d3b-c3e6-1040-88b0-3d7c184dffa9"],

Cell["At order three it is one only on the main diagonal:", "ExampleText",ExpressionUUID->"a63d88f0-e5e5-a34f-88fc-4720a543adb3"],

Cell["Normal @ IdentityArray[3, 2]", "Input",ExpressionUUID->"efc9770c-14e7-c94e-8f40-90da4fe97808"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"d47a9986-9485-e44f-ab0e-413b4b236711"],

Cell["It acts as an identity for the matrix product:", "ExampleText",ExpressionUUID->"5e9f6aa7-6deb-f740-b172-25c142612988"],

Cell["\<\
a = {{1, 2}, {3, 4}};
Normal @ ArrayMultiply[{Normal @ IdentityArray[2, 2], a}, \"ij,jk->ik\"]\
\>", "Input",ExpressionUUID->"9972630e-099b-6f4c-b38c-69cadb70676b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "4"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"0377f653-d2a9-6542-9853-a90e4627236f"],

Cell["Over a finite field:", "ExampleText",ExpressionUUID->"5cb5a973-a9a7-ca48-adcf-5f1d8b7fc1aa"],

Cell["Normal @ IdentityArray[2, 2, FiniteField[2, 1]]", "Input",ExpressionUUID->"0679df77-dadb-5a4a-902e-22178269e02f"],

