Notebook[{
Cell["IdentityArray", "ObjectName",ExpressionUUID->"a09bd366-8834-1140-913e-0da900fa0067"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"IdentityArray", "[", 
    RowBox[{"n", ",", " ", "d"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"8adf5cd8-1991-fc46-8783-ca717f3240fa"],
 " ",
 "gives the n-array with every index of length d whose entry is one where all \
n indices agree and zero elsewhere."
}], "Usage",ExpressionUUID->"c88cd6c9-d881-284a-adba-35ce7c456b2b"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"IdentityArray", "[", 
    RowBox[{"n", ",", " ", "d", ",", " ", "dom"}], "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"b4b16f9a-7e77-9541-85a5-daf9df7d5bc6"],
 " ",
 "gives its entries in the value domain dom."
}], "Usage",ExpressionUUID->"b3765bee-0032-014b-b842-231a99fd3ffb"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"e42ffff9-0ab6-4e4f-a79a-d3e4c86d7a2f"],

Cell["\<\
For n equal to 2 this is the ordinary identity matrix of size d.\
\>", "Notes",ExpressionUUID->"5709527f-00b9-5a40-91c9-ae7b85d5049e"],

Cell["\<\
It is the generalized Kronecker delta on all n indices, and is invariant \
under every permutation of them, so it is declared \"Symmetric\".\
\>", "Notes",ExpressionUUID->"7975e530-04ff-bf44-bc6e-a8673b12e028"],

Cell["IdentityArray[n, d] is PartialIdentityArray[n, d, Range[n]].", "Notes",ExpressionUUID->"d4a24a50-e353-9647-9302-2924309da260"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"e69c1464-d4bb-7a4c-a6ae-612be9774006"],

Cell["At order two it is the identity matrix:", "ExampleText",ExpressionUUID->"c9a958e6-b730-164a-920a-9a224a1cf52e"],

Cell["Normal @ IdentityArray[2, 3]", "Input",ExpressionUUID->"cb72ee29-602c-ac46-8a4c-57fed56fdd1d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}]], "Output",ExpressionUUI\
D->"5cf25322-c4c9-ac4b-9347-924c9aadccc9"],

Cell["At order three it is one only on the main diagonal:", "ExampleText",ExpressionUUID->"8420b5ad-0259-3e42-8a57-3c9bf0fc0fb2"],

Cell["Normal @ IdentityArray[3, 2]", "Input",ExpressionUUID->"7f2ded2f-c47c-cd42-8324-a3287de4a6e5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"8e9f4552-e298-5743-8f38-64f5eee71e3d"],

Cell["It acts as an identity for the matrix product:", "ExampleText",ExpressionUUID->"80df1efd-6b81-e442-9f37-18871502b494"],

Cell["\<\
a = {{1, 2}, {3, 4}};
Normal @ ArrayMultiply[{Normal @ IdentityArray[2, 2], a}, \"ij,jk->ik\"]\
\>", "Input",ExpressionUUID->"b5c7a2bb-2811-6942-9b1a-b0774897ebaa"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "4"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"1fec5ccb-6ae9-e048-8bd4-0cbbfc665f37"],

Cell["Over a finite field:", "ExampleText",ExpressionUUID->"b9db8519-03c6-5d4f-a682-5c8891d9fa5b"],

