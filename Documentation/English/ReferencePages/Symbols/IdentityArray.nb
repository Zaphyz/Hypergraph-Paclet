Notebook[{
Cell["IdentityArray", "ObjectName",ExpressionUUID->"7150c7f0-5ce4-ee4c-9d44-62c1aae0fef1"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"IdentityArray", "[", 
    RowBox[{"n", ",", " ", "d"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"742ac443-cbb7-1d46-ac99-1e0bf169e47b"],
 " ",
 "gives the n-array with every index of length d whose entry is one where all \
n indices agree and zero elsewhere."
}], "Usage",ExpressionUUID->"ef6178ad-74af-5840-9cbd-0f1ded1abaf7"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"IdentityArray", "[", 
    RowBox[{"n", ",", " ", "d", ",", " ", "dom"}], "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"b561f286-c3a6-fd43-ab40-7fad2ef21541"],
 " ",
 "gives its entries in the value domain dom."
}], "Usage",ExpressionUUID->"4505a218-5434-9446-9d96-43dad7c4bcc8"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"04eb2935-fcf1-364f-8573-5f09ff445e76"],

Cell["\<\
For n equal to 2 this is the ordinary identity matrix of size d.\
\>", "Notes",ExpressionUUID->"cc0f2650-41f9-7848-8973-2dddbc855b37"],

Cell["\<\
It is the generalized Kronecker delta on all n indices, and is invariant \
under every permutation of them, so it is declared \"Symmetric\".\
\>", "Notes",ExpressionUUID->"cd2e85df-fcfc-1d40-b3cd-5e0c2af7efa9"],

Cell["IdentityArray[n, d] is PartialIdentityArray[n, d, Range[n]].", "Notes",ExpressionUUID->"0603e945-f9dc-c34d-be81-db2fe7ef55dc"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"c758d21f-98bb-b04a-80dc-3ff04ed4592c"],

Cell["At order two it is the identity matrix:", "ExampleText",ExpressionUUID->"0ce69d20-4f65-6e41-b29e-2548d0a92651"],

Cell["Normal @ IdentityArray[2, 3]", "Input",ExpressionUUID->"c51f146a-b3a3-e540-85f6-a99ea6922743"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}]], "Output",ExpressionUUI\
D->"dd5c75a2-5d5f-2143-804f-99237056b543"],

Cell["At order three it is one only on the main diagonal:", "ExampleText",ExpressionUUID->"4e96d713-1e3b-2d4f-b882-37431232228b"],

Cell["Normal @ IdentityArray[3, 2]", "Input",ExpressionUUID->"3e124170-018c-e449-affa-151de9c3c50c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"e08d18f7-c278-474c-a515-0429c49fb8b5"],

Cell["It acts as an identity for the matrix product:", "ExampleText",ExpressionUUID->"5fd1175b-abdf-fb49-887b-1f57c6b5f708"],

Cell["\<\
a = {{1, 2}, {3, 4}};
Normal @ ArrayMultiply[{Normal @ IdentityArray[2, 2], a}, \"ij,jk->ik\"]\
\>", "Input",ExpressionUUID->"cb54a6a1-2f64-ff44-a945-b6b4bce9cc4e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "4"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"73b746e0-039a-394c-bc07-a6a4fc246b82"],

Cell["Over a finite field:", "ExampleText",ExpressionUUID->"abfbd077-e06f-e444-a79e-cc11d0777684"],

