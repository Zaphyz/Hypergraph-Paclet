(* Beginning of Notebook Content *)
Notebook[{
Cell["IsomorphicHypergraphQ", "ObjectName",ExpressionUUID->"201822a0-d004-f943-b553-570cd432291a"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"IsomorphicHypergraphQ", "[", 
    RowBox[{"hg1", ",", " ", "hg2"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"5e87628a-c073-0f46-ab33-73fe43fc40a2"],
 " ",
 "gives True if hg1 and hg2 are isomorphic as labelled hypergraphs."
}], "Usage",ExpressionUUID->"2028a4ee-179e-ef42-b663-7f27bab29008"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"6c024bb5-a15d-1c49-80d9-a188247fdb7c"],

Cell["\<\
Some renaming of vertex identifiers must carry hg1 onto hg2: the edge \
multisets must match exactly, each edge matching up to its own symmetry type, \
with edge multiplicities preserved.\
\>", "Notes",ExpressionUUID->"b5afad27-1ad0-e648-9a9d-31cdc6689b24"],

Cell["\<\
The renaming must also carry the labels of hg1 onto those of hg2 by a \
one-to-one correspondence. Labels are therefore significant only up to \
renaming: what must agree is which elements share a label, not what the \
labels are called.\
\>", "Notes",ExpressionUUID->"caff178c-4090-b646-8f72-34a94ae18367"],

Cell["\<\
Vertex labels and edge labels are put in correspondence independently of one \
another.\
\>", "Notes",ExpressionUUID->"03ec847e-0d65-6c4b-b605-15deebd28747"],

Cell["\<\
An element with no label can correspond only to an element with no label. \
Without this, every unlabelled hypergraph would be isomorphic to a labelled \
one whose labels were all alike.\
\>", "Notes",ExpressionUUID->"589b6b72-7735-bf46-bdcb-9c40ba122ab9"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"\"\<Labeled\>\"", " ", "->", " ", "False"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"cefebb99-b23e-b540-b52e-d5ad053630df"],
 " the skeletons are compared instead, ignoring labels altogether. Labelled \
isomorphism always implies isomorphism of skeletons."
}], "Notes",ExpressionUUID->"960ef5b4-8689-8445-a6a5-edee64472d59"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["Method", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "f8146362-4f11-f34d-98a5-dac463d675c8"],
 " option is as for CanonicalHypergraph. Both settings always agree here."
}], "Notes",ExpressionUUID->"9dad66ee-6ec0-0a49-8d57-e0f46b35d767"],

Cell["\<\
The search is exhaustive, and is comfortable up to roughly eight vertices.\
\>", "Notes",ExpressionUUID->"ae7c3bda-f1a6-cd4d-9dca-1fe2dc17b776"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"12d129a9-a997-094e-a4d5-0a4d00f68231"],

Cell["The same directed path on different identifiers:", "ExampleText",ExpressionUUID->"4169272a-c489-0343-88c6-91ab288c972a"],

Cell["\<\
{IsomorphicHypergraphQ[Hypergraph[{{1, 2}, {2, 3}}], Hypergraph[{{10, 20}, \
{20, 30}}]],
 IsomorphicHypergraphQ[Hypergraph[{{1, 2}, {2, 3}}], Hypergraph[{{1, 2}, {1, \
3}}]]}\
\>", "Input",ExpressionUUID->"136ec8d7-e145-a545-9ab4-2cdac3581e20"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",ExpressionUUID->"f631491d-\
3bb0-6249-80be-c09fc9272c85"],

Cell["\<\
Symmetry types are respected: a directed path is not an unordered one, but an \
unordered path on three vertices is an unordered star:\
\>", "ExampleText",ExpressionUUID->"090636cc-8975-0b43-ad69-50a6203b83ba"],

Cell["\<\
{IsomorphicHypergraphQ[Hypergraph[{{1, 2}, {2, 3}}],
                       Hypergraph[{Edge[{1, 2}, \"Unordered\"], Edge[{2, 3}, \
\"Unordered\"]}]],
 IsomorphicHypergraphQ[Hypergraph[{Edge[{1, 2}, \"Unordered\"], Edge[{2, 3}, \
\"Unordered\"]}],
                       Hypergraph[{Edge[{1, 2}, \"Unordered\"], Edge[{1, 3}, \
\"Unordered\"]}]]}\
\>", "Input",ExpressionUUID->"cd9ee6da-340c-db43-b9a8-ca96fe58b971"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "True"}], "}"}]], "Output",ExpressionUUID->"f64141c5-\
0814-1b48-b3e4-d56045ce522a"],

Cell["\<\
Labels count only up to a one-to-one renaming. Here a, b corresponds to x, y:\
\
\>", "ExampleText",ExpressionUUID->"2eb22ef1-6c08-a644-bec9-553f615e6e66"],

Cell["\<\
h1 = Hypergraph[{Edge[{1, 2}, \"Directed\", \"a\"], Edge[{2, 3}, \
\"Directed\", \"b\"]}];
h2 = Hypergraph[{Edge[{4, 5}, \"Directed\", \"x\"], Edge[{5, 6}, \
\"Directed\", \"y\"]}];
IsomorphicHypergraphQ[h1, h2]\
\>", "Input",ExpressionUUID->"303cfc41-f3fb-d949-a749-2ebc82fc4083"],

Cell[BoxData["True"], "Output",ExpressionUUID->"7c277b14-4d3c-a240-ab6b-d06e4780d4d1"],

Cell["\<\
But h3 repeats a single label where h1 has two distinct ones, and no \
correspondence can do that:\
\>", "ExampleText",ExpressionUUID->"21908918-9e78-124d-b627-b5ee7e9159e8"],

Cell["\<\
h3 = Hypergraph[{Edge[{4, 5}, \"Directed\", \"x\"], Edge[{5, 6}, \
\"Directed\", \"x\"]}];
{IsomorphicHypergraphQ[h1, h3], IsomorphicHypergraphQ[h1, h3, \"Labeled\" -> \
False]}\
\>", "Input",ExpressionUUID->"6c6c7904-693f-6640-a3ab-9ba476d69f8a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "True"}], "}"}]], "Output",ExpressionUUID->"7b6e8f35-\
58b1-ca41-9f86-a7930a4d10e5"],

Cell["\<\
The same principle governs vertex labels. A, A, B against A, B, B is not an \
isomorphism, because A would have to correspond to both A and B:\
\>", "ExampleText",ExpressionUUID->"0effc6fc-330d-3d4b-8513-608856833d3b"],

Cell["\<\
{IsomorphicHypergraphQ[
   Hypergraph[{Vertex[1, \"A\"], Vertex[2, \"A\"], Vertex[3, \"B\"]}, {{1, \
2}, {2, 3}}],
   Hypergraph[{Vertex[1, \"A\"], Vertex[2, \"B\"], Vertex[3, \"B\"]}, {{1, \
2}, {2, 3}}]],
 IsomorphicHypergraphQ[
   Hypergraph[{Vertex[1, \"A\"], Vertex[2, \"B\"], Vertex[3, \"C\"]}, {{1, \
2}, {2, 3}}],
   Hypergraph[{Vertex[1, \"C\"], Vertex[2, \"B\"], Vertex[3, \"A\"]}, {{1, \
2}, {2, 3}}]]}\
\>", "Input",ExpressionUUID->"55e1da0d-86f6-0f4c-bc3e-ae80a267943e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "True"}], "}"}]], "Output",ExpressionUUID->"cc75fd89-\
eccc-fc46-905e-c9b10e04890f"],

Cell["An unlabelled edge is not a labelled one:", "ExampleText",ExpressionUUID->"62191e57-26a5-664d-ba3e-677da522c17b"],

Cell["\<\
{IsomorphicHypergraphQ[Hypergraph[{Edge[{1, 2}, \"Directed\", \"f\"]}], \
Hypergraph[{Edge[{1, 2}]}]],
 IsomorphicHypergraphQ[Hypergraph[{Edge[{1, 2}, \"Directed\", \"f\"]}], \
Hypergraph[{Edge[{1, 2}]}],
                       \"Labeled\" -> False]}\
\>", "Input",ExpressionUUID->"f6fa9027-1697-3c43-8bc0-8bb05639d534"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "True"}], "}"}]], "Output",ExpressionUUID->"1af87ace-\
e3e9-984a-8680-6f4765c3cc29"],

Cell["Source", "NotesSection",ExpressionUUID->"1011d5f8-ebf6-894f-9385-d5f7d26668a4"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Canonical form and isomorphism",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"9efe740e-8714-cc44-b7fe-d9271f0279cc"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"02567a54-e36e-9342-9ab3-97924c045139"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["FindHypergraphIsomorphism", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"2bce052a-4ff2-7e4c-b92a-5ed4d3d55188"],
 ", ",
 Cell[BoxData[
  StyleBox["CanonicalHypergraph", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"1783c159-d050-ea4e-a28e-499c024c7734"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphSkeleton", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"6a14a231-8ec7-8b4d-a534-a5a07cb36515"],
 ", ",
 Cell[BoxData[
  StyleBox["Hypergraph", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "423d899f-d3b7-0c42-8033-c17b58f23493"]
}], "SeeAlso",ExpressionUUID->"9f7a54fd-0466-8f41-a5f6-eda4697373a2"]
},
WindowSize->{800, 750},
