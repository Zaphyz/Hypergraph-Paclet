Cell["A wider domain may be declared:", "ExampleText",ExpressionUUID->"13ed8244-3f53-c746-a374-895368c987f7"],

Cell["ArrayDomain @ NumericalArray[{1, 2}, \"Complex\"]", "Input",ExpressionUUID->"c05f2e03-324e-fc41-a18d-ef845e0d3b41"],

Cell[BoxData["\<\"Complex\"\>"], "Output",ExpressionUUID->"21180589-6b79-fb4f-9ea0-26244e1f9eb0"],

Cell["A domain that does not contain the entries is rejected:", "ExampleText",ExpressionUUID->"b327c1af-6305-284c-a1a8-e46c87de59d0"],

Cell["Quiet @ NumericalArray[{1.5}, \"Integer\"]", "Input",ExpressionUUID->"2a44c41a-fb4d-f749-96c5-7cb884fa6f26"],

Cell[BoxData["$Failed"], "Output",ExpressionUUID->"5194f709-f333-0143-973c-37f4abe38481"],

