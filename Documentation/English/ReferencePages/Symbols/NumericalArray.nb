Cell["\<\
A declared symmetry is verified. These entries are symmetric:\
\>", "ExampleText",ExpressionUUID->"c31a7744-1788-fa42-b1eb-81abe17434a8"],

Cell["\<\
ArraySymmetry @ NumericalArray[{{1, 2}, {2, 1}}, Automatic, \"Symmetric\"]\
\>", "Input",ExpressionUUID->"5783adc5-d03e-e949-8fbd-5b04558a48db"],

Cell[BoxData["\<\"Symmetric\"\>"], "Output",ExpressionUUID->"ede27758-8144-104e-a418-15ecbb810477"],

Cell["\[Ellipsis] and these are not, so the declaration is refused:", \
"ExampleText",ExpressionUUID->"c469210c-8069-cf45-8e6d-cc39a6467d3b"],

Cell["\<\
Quiet @ NumericalArray[{{1, 2}, {3, 4}}, Automatic, \"Symmetric\"]\
\>", "Input",ExpressionUUID->"740e008c-6bef-0b41-86ba-f47feb0891f2"],

Cell[BoxData["$Failed"], "Output",ExpressionUUID->"3cfdbe3a-0343-7f4b-b0b4-112093218f54"],

Cell["The same entries are perfectly good as a rigid array:", "ExampleText",ExpressionUUID->"6fe8dd42-3e0f-6446-b2e6-39bd445c8e77"],

Cell["ArraySymmetry @ NumericalArray[{{1, 2}, {3, 4}}]", "Input",ExpressionUUID->"5f0aeb34-b483-084b-a478-09e93fd7c923"],

Cell[BoxData["\<\"Rigid\"\>"], "Output",ExpressionUUID->"09a98a9d-5b40-6748-9425-463d06511c90"],

Cell["\<\
A scalar is the array of order zero, with no dimensions and one entry:\
\>", "ExampleText",ExpressionUUID->"a6a3dd6a-b876-bd4b-9ce5-f5d424ceebc7"],

