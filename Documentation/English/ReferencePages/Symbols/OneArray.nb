Cell["OneArray", "ObjectName",ExpressionUUID->"d1c0cdfa-daa5-5749-9bcd-484ad08cb6e9"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"OneArray", "[", 
    RowBox[{"n", ",", " ", "d"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"c5c82250-321d-a243-a5e7-e287a0e7fc04"],
 " ",
 "gives the n-array with every index of length d and every entry one."
}], "Usage",ExpressionUUID->"b439db11-c4e7-8645-ad4f-f1b38858dfab"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"OneArray", "[", "dims", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"b7dad9e2-4a2c-3445-9c60-846af9b5606f"],
 " ",
 "gives the array of the given dimensions."
}], "Usage",ExpressionUUID->"68d2f967-d2ba-1147-99c5-e58ad5a164f9"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"OneArray", "[", 
    RowBox[{"spec", ",", " ", "dom"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"d5a25988-8e12-bc42-b94e-4396552a1ac3"],
 " ",
 "gives its entries in the value domain dom."
}], "Usage",ExpressionUUID->"6746a301-6ab2-fb41-95b1-293f0e56dd00"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"daf35a53-c16f-894a-b3c7-f27e08fd266d"],

Cell["\<\
The domain defaults to \"Integer\". The one of \"Boolean\" is True, and the \
one of FiniteField[p, n] is that field's unit.\
\>", "Notes",ExpressionUUID->"fb653d9e-032d-6b4c-a47a-0e8ec2277a1e"],

Cell["\<\
Like any constant array, a regular one is declared \"Symmetric\".\
\>", "Notes",ExpressionUUID->"64d4e24d-bded-a34c-90bc-37759c02747d"],

Cell["\<\
This is the array of all ones, which is not the identity for any contraction; \
for that see IdentityArray.\
\>", "Notes",ExpressionUUID->"a8192c5e-5e26-5c4a-a236-f87d6b36ba08"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"cdfedbed-a2df-374c-9bdc-4f8a4d403bca"],

