Cell["OneArray", "ObjectName",ExpressionUUID->"5d40c65d-59ec-6043-9fe7-d06d3ed71af7"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"OneArray", "[", 
    RowBox[{"n", ",", " ", "d"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"b0bef470-28a2-0942-a166-3ddc83436dbe"],
 " ",
 "gives the n-array with every index of length d and every entry one."
}], "Usage",ExpressionUUID->"8e520158-7ce4-414c-b930-4634498cefe5"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"OneArray", "[", "dims", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"a10cfc9b-e9df-f54f-a792-340ccb9c16f2"],
 " ",
 "gives the array of the given dimensions."
}], "Usage",ExpressionUUID->"410bef18-8d75-7b44-96ef-3c05505df2ee"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"OneArray", "[", 
    RowBox[{"spec", ",", " ", "dom"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"49aeee2a-a2a4-ed42-b019-4aec2397ee65"],
 " ",
 "gives its entries in the value domain dom."
}], "Usage",ExpressionUUID->"5c5e2a2e-2d40-884d-a671-cebd45bf30c8"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"23bd3d48-65bf-4243-8a4b-0945c9d4efd6"],

Cell["\<\
The domain defaults to \"Integer\". The one of \"Boolean\" is True, and the \
one of FiniteField[p, n] is that field's unit.\
\>", "Notes",ExpressionUUID->"a21b699b-4f46-c94a-9d81-ede94027e168"],

Cell["\<\
Like any constant array, a regular one is declared \"Symmetric\".\
\>", "Notes",ExpressionUUID->"003f3dca-07cc-0f4a-92d6-00bf2bc88402"],

Cell["\<\
This is the array of all ones, which is not the identity for any contraction; \
for that see IdentityArray.\
\>", "Notes",ExpressionUUID->"d4a47937-74c1-8447-918a-15d53036a6f1"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"bfebe8b9-74b2-bd4f-9fda-7307d9a1abf6"],

