Cell["OneArray", "ObjectName",ExpressionUUID->"2e3958f3-c1bb-6948-8ae7-66413130ca2c"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"OneArray", "[", 
    RowBox[{"n", ",", " ", "d"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"04659af4-7629-b849-903d-5d69c824d5a4"],
 " ",
 "gives the n-array with every index of length d and every entry one."
}], "Usage",ExpressionUUID->"7d7e82b4-a2a0-d04a-9002-a301f650f5c1"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"OneArray", "[", "dims", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"9de65675-d124-e045-b131-5fd1f54e4908"],
 " ",
 "gives the array of the given dimensions."
}], "Usage",ExpressionUUID->"617b6a89-7e47-6d48-a4d5-75be74f76e84"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"OneArray", "[", 
    RowBox[{"spec", ",", " ", "dom"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"b205e912-6b19-6340-96bb-181de1e135ba"],
 " ",
 "gives its entries in the value domain dom."
}], "Usage",ExpressionUUID->"469979ec-ff50-4444-bc0e-c587a927780d"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"1e7b4122-f44e-0144-80e6-3afa4caa1b48"],

Cell["\<\
The domain defaults to \"Integer\". The one of \"Boolean\" is True, and the \
one of FiniteField[p, n] is that field's unit.\
\>", "Notes",ExpressionUUID->"c3198df0-76c0-a347-80cb-ddef990b8d33"],

Cell["\<\
Like any constant array, a regular one is declared \"Symmetric\".\
\>", "Notes",ExpressionUUID->"ed2f9af1-9afc-364c-8920-3c74348a916a"],

Cell["\<\
This is the array of all ones, which is not the identity for any contraction; \
for that see IdentityArray.\
\>", "Notes",ExpressionUUID->"e13a170b-ec76-684a-856d-d70bccbb33c5"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"eba8f454-ef42-1f4b-b071-2ce0f0d73d7d"],

