Cell["OneArray", "ObjectName",ExpressionUUID->"24cc6fb0-8c05-fb47-ab42-8f78b9e1c44f"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"OneArray", "[", 
    RowBox[{"n", ",", " ", "d"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"4d2cceac-6c51-604a-a3e9-19c87570d3f8"],
 " ",
 "gives the n-array with every index of length d and every entry one."
}], "Usage",ExpressionUUID->"268d3de1-67c0-7f4e-8b09-2c0ac7bbb711"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"OneArray", "[", "dims", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"7fc05781-de8f-a943-abed-0b68892172ce"],
 " ",
 "gives the array of the given dimensions."
}], "Usage",ExpressionUUID->"48cbd557-2c83-9b42-a181-5974fdec14ff"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"OneArray", "[", 
    RowBox[{"spec", ",", " ", "dom"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"e4703e97-e67b-1a4d-b3b6-1c97193eefa4"],
 " ",
 "gives its entries in the value domain dom."
}], "Usage",ExpressionUUID->"404b3555-32be-4448-a53f-419979725d39"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"598ad5ce-a7a0-d142-8485-c71a54bab869"],

Cell["\<\
The domain defaults to \"Integer\". The one of \"Boolean\" is True, and the \
one of FiniteField[p, n] is that field's unit.\
\>", "Notes",ExpressionUUID->"5ec816d6-16b1-834c-822d-7b3bedc4eaf8"],

Cell["\<\
Like any constant array, a regular one is declared \"Symmetric\".\
\>", "Notes",ExpressionUUID->"aaaae560-a56e-8c40-8ce0-f8cf23f7a27e"],

Cell["\<\
This is the array of all ones, which is not the identity for any contraction; \
for that see IdentityArray.\
\>", "Notes",ExpressionUUID->"0b8066aa-cea8-2441-a5bf-c2024d2ba3ab"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"c18ada66-795c-db41-a94c-df0c6113b803"],

