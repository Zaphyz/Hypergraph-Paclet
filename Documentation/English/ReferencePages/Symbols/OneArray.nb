Notebook[{
Cell["OneArray", "ObjectName",ExpressionUUID->"145e0a4e-3015-de4c-828f-f25d66147241"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"OneArray", "[", 
    RowBox[{"n", ",", " ", "d"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"31f24184-ca4e-1140-a582-3674c1f5eb16"],
 " ",
 "gives the n-array with every index of length d and every entry one."
}], "Usage",ExpressionUUID->"14fce4b0-0d71-9843-9227-8e55a72358db"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"OneArray", "[", "dims", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"128de60f-ad8b-4e4b-8774-c5867ec4c314"],
 " ",
 "gives the array of the given dimensions."
}], "Usage",ExpressionUUID->"b95e298d-0810-d446-bc9d-e496bc8433da"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"OneArray", "[", 
    RowBox[{"spec", ",", " ", "dom"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"5daeab69-8377-d848-a6cf-290de99f08e5"],
 " ",
 "gives its entries in the value domain dom."
}], "Usage",ExpressionUUID->"e094ba34-5eab-8040-a474-671e86e4e438"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"075b917a-91f9-0642-b1c1-ad4fb182320f"],

Cell["\<\
The domain defaults to \"Integer\". The one of \"Boolean\" is True, and the \
one of FiniteField[p, n] is that field's unit.\
\>", "Notes",ExpressionUUID->"19dc76bd-7114-9d4f-80ff-5413abaaf4c1"],

Cell["\<\
Like any constant array, a regular one is declared \"Symmetric\".\
\>", "Notes",ExpressionUUID->"100ec611-a0eb-ba4d-a447-6beac74c2f7f"],

Cell["\<\
This is the array of all ones, which is not the identity for any contraction; \
for that see IdentityArray.\
\>", "Notes",ExpressionUUID->"f0d19f29-800d-cb45-9c95-6dd6b5b0720e"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"3b2d1a90-bc1c-6f40-918d-13caf89ff6b4"],

