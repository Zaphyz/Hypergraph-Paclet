Notebook[{
Cell["OneArray", "ObjectName",ExpressionUUID->"dffaec18-791a-5d45-a20d-09efd02e83ad"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"OneArray", "[", 
    RowBox[{"n", ",", " ", "d"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"e3f36193-8f41-8648-b388-2905be45de51"],
 " ",
 "gives the n-array with every index of length d and every entry one."
}], "Usage",ExpressionUUID->"1b48cd8e-f136-1d4b-9426-a06f64065cc1"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"OneArray", "[", "dims", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"78847fa2-df8a-0f49-887d-3292427ed716"],
 " ",
 "gives the array of the given dimensions."
}], "Usage",ExpressionUUID->"dbbda60a-f850-374e-9bb7-76f18407cdce"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"OneArray", "[", 
    RowBox[{"spec", ",", " ", "dom"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"e42533cc-5720-6148-bb5e-2bc627afbec0"],
 " ",
 "gives its entries in the value domain dom."
}], "Usage",ExpressionUUID->"32d96d68-d935-c747-9464-2303f56a2e05"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"b32473da-b2aa-9344-a6d1-488337f3b168"],

Cell["\<\
The domain defaults to \"Integer\". The one of \"Boolean\" is True, and the \
one of FiniteField[p, n] is that field's unit.\
\>", "Notes",ExpressionUUID->"e793fc9e-533a-a14d-ba11-196a95237e71"],

Cell["\<\
Like any constant array, a regular one is declared \"Symmetric\".\
\>", "Notes",ExpressionUUID->"c1d8bcda-d7c8-4648-ac9a-808d655a6fa1"],

Cell["\<\
This is the array of all ones, which is not the identity for any contraction; \
for that see IdentityArray.\
\>", "Notes",ExpressionUUID->"195ae08f-bb9e-374a-8c63-990d0dd9e241"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"230ee5c4-d82f-164b-80f4-9482fdd35a09"],

