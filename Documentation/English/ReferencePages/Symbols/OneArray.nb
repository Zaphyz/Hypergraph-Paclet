Notebook[{
Cell["OneArray", "ObjectName",ExpressionUUID->"d0c10797-3160-9742-af54-7d6d24291fc9"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"OneArray", "[", 
    RowBox[{"n", ",", " ", "d"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"3455606f-11c2-ae41-a582-47475cdcfdba"],
 " ",
 "gives the n-array with every index of length d and every entry one."
}], "Usage",ExpressionUUID->"a7af8736-3a1e-da48-847b-f203b1904f5a"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"OneArray", "[", "dims", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"08ab2a7c-1cf0-a743-9068-1b843c4c2eb2"],
 " ",
 "gives the array of the given dimensions."
}], "Usage",ExpressionUUID->"c514da7a-a9b2-6a4b-b549-58b3b3b51a8a"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"OneArray", "[", 
    RowBox[{"spec", ",", " ", "dom"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"784136f3-ce52-9144-8c11-78dd265b6fe2"],
 " ",
 "gives its entries in the value domain dom."
}], "Usage",ExpressionUUID->"b5b36ffe-2400-1542-97f1-c584289b8327"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"1323a435-4333-af41-9738-9289b2010ce5"],

Cell["\<\
The domain defaults to \"Integer\". The one of \"Boolean\" is True, and the \
one of FiniteField[p, n] is that field's unit.\
\>", "Notes",ExpressionUUID->"22328bd8-32e5-ee42-9cdf-6c4422aaec71"],

Cell["\<\
Like any constant array, a regular one is declared \"Symmetric\".\
\>", "Notes",ExpressionUUID->"5433d3af-63e4-6c44-9a42-31e3ac4e7292"],

Cell["\<\
This is the array of all ones, which is not the identity for any contraction; \
for that see IdentityArray.\
\>", "Notes",ExpressionUUID->"120bc9ae-aa68-5543-acc5-b5fc58cf4c5f"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"b97ebfb3-875e-634e-b518-38ea4793bec8"],

Cell["Normal @ OneArray[2, 3]", "Input",ExpressionUUID->"6504e04d-4764-204b-8271-4f5368135535"],

