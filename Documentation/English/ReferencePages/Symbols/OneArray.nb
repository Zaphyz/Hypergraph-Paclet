Cell["OneArray", "ObjectName",ExpressionUUID->"b0ebf5ef-74eb-d04a-afbd-fe8118f3e5b8"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"OneArray", "[", 
    RowBox[{"n", ",", " ", "d"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"7159221a-cd05-9a4d-8e39-06ffa42924ab"],
 " ",
 "gives the n-array with every index of length d and every entry one."
}], "Usage",ExpressionUUID->"f2aafc7c-86c7-d648-a3a4-b2a7b8d13116"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"OneArray", "[", "dims", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"32560be4-55d9-3247-ba28-e09ed7a10cba"],
 " ",
 "gives the array of the given dimensions."
}], "Usage",ExpressionUUID->"c380a0f5-d56f-7d40-85b5-72b65af4f5a4"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"OneArray", "[", 
    RowBox[{"spec", ",", " ", "dom"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"6c4a0ec7-7f3b-0548-ba01-094ec6db8e7a"],
 " ",
 "gives its entries in the value domain dom."
}], "Usage",ExpressionUUID->"5daf81ff-f4d8-7f4a-9e43-65d8908fe345"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"8e0024b7-cb14-6d4e-874e-0fd808ccb041"],

Cell["\<\
The domain defaults to \"Integer\". The one of \"Boolean\" is True, and the \
one of FiniteField[p, n] is that field's unit.\
\>", "Notes",ExpressionUUID->"187abdb3-5a6d-8e4a-9572-0f731e9a85eb"],

Cell["\<\
Like any constant array, a regular one is declared \"Symmetric\".\
\>", "Notes",ExpressionUUID->"6e1aac47-9135-f047-a1a0-bae5186351ba"],

Cell["\<\
This is the array of all ones, which is not the identity for any contraction; \
for that see IdentityArray.\
\>", "Notes",ExpressionUUID->"492d87bc-1659-e949-a8bb-2b4cfb91d4bd"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"fb39f3d0-c7b2-244c-9b70-30f7cd7b3908"],

