Notebook[{
Cell["OneArray", "ObjectName",ExpressionUUID->"cddad07c-0245-3243-9240-33ef9db649d9"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"OneArray", "[", 
    RowBox[{"n", ",", " ", "d"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"c4f89909-79ab-744b-930e-20d1a598bea6"],
 " ",
 "gives the n-array with every index of length d and every entry one."
}], "Usage",ExpressionUUID->"fc55a8bf-1b27-be4c-afba-2423ee999910"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"OneArray", "[", "dims", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"bf5b392d-feaf-bd4a-bf6c-7ff7f37b52a3"],
 " ",
 "gives the array of the given dimensions."
}], "Usage",ExpressionUUID->"a5d083bd-8bde-e944-93fd-6a883c724aa7"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"OneArray", "[", 
    RowBox[{"spec", ",", " ", "dom"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"b5310f15-ffeb-7c4d-9331-35ee1a024366"],
 " ",
 "gives its entries in the value domain dom."
}], "Usage",ExpressionUUID->"1c377685-2438-5944-a177-3de2c50c6e42"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"137a6373-3e0f-3440-bcd8-29862b19695a"],

Cell["\<\
The domain defaults to \"Integer\". The one of \"Boolean\" is True, and the \
one of FiniteField[p, n] is that field's unit.\
\>", "Notes",ExpressionUUID->"3264a43c-dc99-aa42-910d-81a0634a1730"],

Cell["\<\
Like any constant array, a regular one is declared \"Symmetric\".\
\>", "Notes",ExpressionUUID->"a86ce70c-0b96-6d4d-a9c6-15cf4a8c36df"],

Cell["\<\
This is the array of all ones, which is not the identity for any contraction; \
for that see IdentityArray.\
\>", "Notes",ExpressionUUID->"65d36bf8-edbc-ea4b-982d-653160ffa6fd"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"df0ce2bd-e0fe-4046-b7d0-dd09ffa4c00f"],

Cell["Normal @ OneArray[2, 3]", "Input",ExpressionUUID->"b75da61e-096d-5248-ae5d-e82d06539d04"],

