Notebook[{
Cell["PartialIdentityArray", "ObjectName",ExpressionUUID->"32d3374e-5c00-3f4c-85a5-54f1ba9777e7"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"PartialIdentityArray", "[", 
    RowBox[{"n", ",", " ", "d", ",", " ", "positions"}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "ad417eb8-e29b-fd4c-8750-31bf99f9bca2"],
 " ",
 "gives the n-array with every index of length d whose entry is one where the \
indices at the given positions agree and zero elsewhere."
}], "Usage",ExpressionUUID->"59dd0b57-d2e8-ab4d-8e7a-0ee43d49ef82"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"PartialIdentityArray", "[", 
    RowBox[{"n", ",", " ", "d", ",", " ", "positions", ",", " ", "dom"}], 
    "]"}], "InlineCode"]], "InlineFormula",ExpressionUUID->
  "b005d99d-8827-0c41-b4c1-abef86566b42"],
 " ",
 "gives its entries in the value domain dom."
}], "Usage",ExpressionUUID->"ba1fe5e2-74cf-424a-ac49-9e4762fe0fe8"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"cf5ead8c-ecfd-8b46-bc2c-327a949e1b08"],

Cell["\<\
The positions are a list of distinct index positions between 1 and n.\
\>", "Notes",ExpressionUUID->"0d81bc66-4391-f947-841e-083873cb7dbf"],

Cell["\<\
With every position named this is IdentityArray[n, d], which is symmetric. \
With only some of them the array is generally not invariant under permuting \
all its indices, so it is declared \"Rigid\".\
\>", "Notes",ExpressionUUID->"60ba9f91-2d96-0344-b777-f29a6b0b9cad"],

Cell["\<\
These are the arrays that act as partial units for the ternary products: each \
names the pair of indices it identifies.\
\>", "Notes",ExpressionUUID->"11bd3254-9cc9-7e44-9ace-fbc7f739aa4d"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"3526cd13-41b8-9f45-b975-971de8954b2c"],

Cell["\<\
A 3-array that is one where the first two indices agree, whatever the third:\
\>", "ExampleText",ExpressionUUID->"8f910a8a-2770-1544-ab71-55cca010aacf"],

Cell["Normal @ PartialIdentityArray[3, 2, {1, 2}]", "Input",ExpressionUUID->"52336224-5224-db4e-b8a5-f0edc036ca22"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1"}], "}"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"4bf24c0f-0721-ac49-b75d-d92c1622e8b7"],

Cell["\<\
The three partial identities of a 3-array, one for each pair of indices:\
\>", "ExampleText",ExpressionUUID->"14e99823-e83a-8049-97c0-a04ccfe1c118"],

Cell["\<\
Normal @ PartialIdentityArray[3, 2, #] & /@ {{1, 2}, {2, 3}, {1, 3}}\
\>", "Input",ExpressionUUID->"757ecc24-1728-f643-b592-526f97e1510d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}]}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], "}"}]}], "}"}]], "Output",E\
xpressionUUID->"261c8c05-f368-1248-a8c6-b85e4ec5007e"],

Cell["Naming every position gives the full identity:", "ExampleText",ExpressionUUID->"1b5b3c8a-b308-8646-a816-90118a310606"],

Cell["\<\
PartialIdentityArray[3, 2, {1, 2, 3}] === IdentityArray[3, 2]\
\>", "Input",ExpressionUUID->"725ef588-6148-c546-872f-efc3eb1267fe"],

Cell[BoxData["True"], "Output",ExpressionUUID->"819fd4d8-4c72-a84f-8251-e61ec19f9885"],

Cell["Only a full identity is symmetric:", "ExampleText",ExpressionUUID->"e6bf8f91-46fc-3944-a3d8-b66f9ee20ad9"],

Cell["\<\
{ArraySymmetry @ PartialIdentityArray[3, 2, {1, 2}],
 ArraySymmetry @ PartialIdentityArray[3, 2, {1, 2, 3}]}\
\>", "Input",ExpressionUUID->"3bd0e338-ffff-5f4b-ad1b-364ba678d9c1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Rigid\"\>", ",", "\<\"Symmetric\"\>"}], "}"}]], "Output",Expres\
sionUUID->"63850a1f-4b1c-2940-8e9a-afd85827d758"],

Cell["Source", "NotesSection",ExpressionUUID->"0096fa37-cac7-ce44-81ba-caae6a0ecac4"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/ArrayAlgebra.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Special arrays",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"fb1b0376-d31e-ad4c-aba4-534c0a7ba5c1"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"ff8da8fa-c290-8241-9dfd-83ec96f3bd2d"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["IdentityArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "9eb42dc3-7488-9843-b621-a485d3cb7c98"],
 ", ",
 Cell[BoxData[
  StyleBox["ZeroArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "fff37dcb-3f82-d24d-b258-0086e4ad7704"],
 ", ",
 Cell[BoxData[
  StyleBox["OneArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "95d9ee42-acc9-f546-b048-9ab30818385a"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayMultiply", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "4f28fd42-1029-a943-8ea4-981527831946"],
 ", ",
 Cell[BoxData[
  StyleBox["ArraySymmetry", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "0238a6c8-9129-1647-bbc9-95a2575b6313"]
}], "SeeAlso",ExpressionUUID->"240a793d-2c46-984c-9d04-c8b001a10266"]
},
