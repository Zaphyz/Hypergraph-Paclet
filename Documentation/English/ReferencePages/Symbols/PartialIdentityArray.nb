Notebook[{
Cell["PartialIdentityArray", "ObjectName",ExpressionUUID->"14712d04-9abe-3c49-b5b7-e7e4b5472f0b"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"PartialIdentityArray", "[", 
    RowBox[{"n", ",", " ", "d", ",", " ", "positions"}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "0562a1f1-422d-cb40-b68d-dbf2d6b53ec4"],
 " ",
 "gives the n-array with every index of length d whose entry is one where the \
indices at the given positions agree and zero elsewhere."
}], "Usage",ExpressionUUID->"9cf860bb-f03b-d44c-8d97-7a1f917aff5d"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"PartialIdentityArray", "[", 
    RowBox[{"n", ",", " ", "d", ",", " ", "positions", ",", " ", "dom"}], 
    "]"}], "InlineCode"]], "InlineFormula",ExpressionUUID->
  "b404a99b-7dd7-5d4d-85cc-091bc47c4fb9"],
 " ",
 "gives its entries in the value domain dom."
}], "Usage",ExpressionUUID->"d2d4d6c9-2168-7d45-810c-7e20f242ee5b"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"a5abf78a-b801-9245-983f-efb0a5336b42"],

Cell["\<\
The positions are a list of distinct index positions between 1 and n.\
\>", "Notes",ExpressionUUID->"01635000-3f3e-b242-86a2-0f5b29596363"],

Cell["\<\
With every position named this is IdentityArray[n, d], which is symmetric. \
With only some of them the array is generally not invariant under permuting \
all its indices, so it is declared \"Rigid\".\
\>", "Notes",ExpressionUUID->"039bb30d-7625-654c-94f2-6e194082d861"],

Cell["\<\
These are the arrays that act as partial units for the ternary products: each \
names the pair of indices it identifies.\
\>", "Notes",ExpressionUUID->"b5088544-755a-e14d-abe0-94884210d52b"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"8af093d6-20e4-814a-9371-4842877112df"],

Cell["\<\
A 3-array that is one where the first two indices agree, whatever the third:\
\>", "ExampleText",ExpressionUUID->"e9c44c29-3b8f-fe45-a608-a7d3857fd160"],

Cell["Normal @ PartialIdentityArray[3, 2, {1, 2}]", "Input",ExpressionUUID->"b24cfd71-58e7-0a4f-8d2a-084d618ce411"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1"}], "}"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"833390e1-3e0c-ce44-82bf-1cc9b69dcadf"],

Cell["\<\
The three partial identities of a 3-array, one for each pair of indices:\
\>", "ExampleText",ExpressionUUID->"f4d083b8-4347-6042-91c8-b8c06f7e9e85"],

Cell["\<\
Normal @ PartialIdentityArray[3, 2, #] & /@ {{1, 2}, {2, 3}, {1, 3}}\
\>", "Input",ExpressionUUID->"3bea424d-f970-b642-a923-6f64934d8547"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}]}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], "}"}]}], "}"}]], "Output",E\
xpressionUUID->"e2e4071f-1127-d743-b470-8e51823b5043"],

Cell["Naming every position gives the full identity:", "ExampleText",ExpressionUUID->"8f4e5745-6e0f-e444-a3fa-d4ab4c5d9ac9"],

Cell["\<\
PartialIdentityArray[3, 2, {1, 2, 3}] === IdentityArray[3, 2]\
\>", "Input",ExpressionUUID->"cada37e6-f63f-3b46-aa92-ae71fda363ec"],

Cell[BoxData["True"], "Output",ExpressionUUID->"c670727b-15fa-934d-a8fb-56616d0e88e4"],

Cell["Only a full identity is symmetric:", "ExampleText",ExpressionUUID->"0e2a788b-f807-6449-8cdd-7ae53e7d7cdf"],

Cell["\<\
{ArraySymmetry @ PartialIdentityArray[3, 2, {1, 2}],
 ArraySymmetry @ PartialIdentityArray[3, 2, {1, 2, 3}]}\
\>", "Input",ExpressionUUID->"f9ffe914-77fd-3940-b5fd-99448d2596f1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Rigid\"\>", ",", "\<\"Symmetric\"\>"}], "}"}]], "Output",Expres\
sionUUID->"7cc5fc70-df16-a147-8610-54c45e10f05d"],

Cell["Source", "NotesSection",ExpressionUUID->"a0173cf4-f22f-4544-add1-b349eef4e0d4"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/ArrayAlgebra.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Special arrays",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"9390b8f4-e412-af40-9633-767ec394dc8d"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"bb4fb27b-a495-ad47-898b-6bd4f8856cbf"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["IdentityArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "1157efdb-0b36-e042-bab0-20917ac205d1"],
 ", ",
 Cell[BoxData[
  StyleBox["ZeroArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "1d9d86d8-659f-774c-a935-bcd7f9afa8fe"],
 ", ",
 Cell[BoxData[
  StyleBox["OneArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "839c7f21-7694-a24e-95b2-c54bc749db02"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayMultiply", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "223637e1-9263-a349-add5-82218ff98d6f"],
 ", ",
 Cell[BoxData[
  StyleBox["ArraySymmetry", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "251a09fc-f91a-9641-a54c-f0c90e553824"]
}], "SeeAlso",ExpressionUUID->"b145504d-3a1d-fc48-93a2-20ea8a0877a1"]
},
