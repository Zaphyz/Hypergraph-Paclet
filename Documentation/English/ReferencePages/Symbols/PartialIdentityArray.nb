Notebook[{
Cell["PartialIdentityArray", "ObjectName",ExpressionUUID->"ef49bcc5-c0fa-9344-bf91-db12bbdf1035"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"PartialIdentityArray", "[", 
    RowBox[{"n", ",", " ", "d", ",", " ", "positions"}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "23d62ac1-cf26-344e-80d6-7588c2097d46"],
 " ",
 "gives the n-array with every index of length d whose entry is one where the \
indices at the given positions agree and zero elsewhere."
}], "Usage",ExpressionUUID->"02282d71-2031-1043-9dec-2608cccf41be"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"PartialIdentityArray", "[", 
    RowBox[{"n", ",", " ", "d", ",", " ", "positions", ",", " ", "dom"}], 
    "]"}], "InlineCode"]], "InlineFormula",ExpressionUUID->
  "98e2bf9a-052e-d646-b548-25e4aaa2b7c4"],
 " ",
 "gives its entries in the value domain dom."
}], "Usage",ExpressionUUID->"ded98bb2-ff93-304a-8ae1-ccc9c140fc49"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"2613a440-9f77-b941-8eff-07a9b0a1416d"],

Cell["\<\
The positions are a list of distinct index positions between 1 and n.\
\>", "Notes",ExpressionUUID->"b404eb37-1d08-a347-94f7-7b24177510ce"],

Cell["\<\
With every position named this is IdentityArray[n, d], which is symmetric. \
With only some of them the array is generally not invariant under permuting \
all its indices, so it is declared \"Rigid\".\
\>", "Notes",ExpressionUUID->"7a95a372-232a-064c-9ad1-245b2b6452c1"],

Cell["\<\
These are the arrays that act as partial units for the ternary products: each \
names the pair of indices it identifies.\
\>", "Notes",ExpressionUUID->"311fed01-192e-0c47-b992-51d03d9d5f61"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"d911a1bf-65df-b742-acd9-785f846f9f20"],

Cell["\<\
A 3-array that is one where the first two indices agree, whatever the third:\
\>", "ExampleText",ExpressionUUID->"6582c3b6-431e-7c41-9f37-41b522df9e68"],

Cell["Normal @ PartialIdentityArray[3, 2, {1, 2}]", "Input",ExpressionUUID->"4e60bd04-727a-9a43-97d9-d31f9fac6237"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1"}], "}"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"ce15019a-2f12-3649-b3cf-73034f323e66"],

Cell["\<\
The three partial identities of a 3-array, one for each pair of indices:\
\>", "ExampleText",ExpressionUUID->"49123a2a-7598-4a43-b5e4-8aaa2731653c"],

Cell["\<\
Normal @ PartialIdentityArray[3, 2, #] & /@ {{1, 2}, {2, 3}, {1, 3}}\
\>", "Input",ExpressionUUID->"a1ad45ed-4dde-784b-a8df-be5bf60df44b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}]}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], "}"}]}], "}"}]], "Output",E\
xpressionUUID->"a05cde74-132a-a746-bd71-ccaafada80eb"],

Cell["Naming every position gives the full identity:", "ExampleText",ExpressionUUID->"4d421823-46a1-514b-9c8a-74ee877a1231"],

Cell["\<\
PartialIdentityArray[3, 2, {1, 2, 3}] === IdentityArray[3, 2]\
\>", "Input",ExpressionUUID->"dd0d5722-0168-b74b-a54b-7408c951babd"],

Cell[BoxData["True"], "Output",ExpressionUUID->"94a16f50-f3f8-fc46-b1f7-5b3122956378"],

Cell["Only a full identity is symmetric:", "ExampleText",ExpressionUUID->"1a932e77-c774-ce4c-9edf-944593ae0a2e"],

Cell["\<\
{ArraySymmetry @ PartialIdentityArray[3, 2, {1, 2}],
 ArraySymmetry @ PartialIdentityArray[3, 2, {1, 2, 3}]}\
\>", "Input",ExpressionUUID->"79a391a2-b88e-3745-8671-d9bf41229ce3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Rigid\"\>", ",", "\<\"Symmetric\"\>"}], "}"}]], "Output",Expres\
sionUUID->"89df10bd-cffd-6c41-a2c7-45866bda0719"],

Cell["Source", "NotesSection",ExpressionUUID->"487b15ab-88a7-3342-ac85-2910681418bf"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/ArrayAlgebra.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Special arrays",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"ae26cdcd-a2d2-5d44-9d01-819388e8b0ca"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"b981ccb3-c8b6-4e4b-9750-9ea81c0e6e4a"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["IdentityArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "fa4332a6-3b68-2841-8eca-905c4d01ad9d"],
 ", ",
 Cell[BoxData[
  StyleBox["ZeroArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "55353a3a-8a1a-d640-bbcd-72e8fced6e5c"],
 ", ",
 Cell[BoxData[
  StyleBox["OneArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "bc156ebf-0f7b-354e-87e9-87c461d90188"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayMultiply", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "cfb17b38-fd2a-8f4f-a731-9e63669569de"],
 ", ",
 Cell[BoxData[
  StyleBox["ArraySymmetry", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "1838bdb5-83b5-4142-b7b9-b65c1225a4ad"]
}], "SeeAlso",ExpressionUUID->"9012a750-5544-7543-85a8-22b3f35207a4"]
},
