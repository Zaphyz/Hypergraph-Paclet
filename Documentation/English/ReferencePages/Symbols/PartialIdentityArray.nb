Notebook[{
Cell["PartialIdentityArray", "ObjectName",ExpressionUUID->"e747ade3-384c-9644-9de0-9a6cacd27601"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"PartialIdentityArray", "[", 
    RowBox[{"n", ",", " ", "d", ",", " ", "positions"}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "81c9bfe5-eb1f-a746-bcc7-9409b2fc499c"],
 " ",
 "gives the n-array with every index of length d whose entry is one where the \
indices at the given positions agree and zero elsewhere."
}], "Usage",ExpressionUUID->"e7ef8ee4-3cf2-2b41-9ade-f9b363277de1"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"PartialIdentityArray", "[", 
    RowBox[{"n", ",", " ", "d", ",", " ", "positions", ",", " ", "dom"}], 
    "]"}], "InlineCode"]], "InlineFormula",ExpressionUUID->
  "a15e9f50-ec34-8d4a-8d0e-ca45e6ebddc7"],
 " ",
 "gives its entries in the value domain dom."
}], "Usage",ExpressionUUID->"7c3ea0d4-5c9b-4945-b3f0-c5f29664f2ef"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"63033774-6071-054b-8210-38dbffffe809"],

Cell["\<\
The positions are a list of distinct index positions between 1 and n.\
\>", "Notes",ExpressionUUID->"615767af-d77a-a84a-8972-fb824c851529"],

Cell["\<\
With every position named this is IdentityArray[n, d], which is symmetric. \
With only some of them the array is generally not invariant under permuting \
all its indices, so it is declared \"Rigid\".\
\>", "Notes",ExpressionUUID->"ae95d2ae-45a4-1d46-bf99-747ab3c52ad6"],

Cell["\<\
These are the arrays that act as partial units for the ternary products: each \
names the pair of indices it identifies.\
\>", "Notes",ExpressionUUID->"bdd8d3a8-e572-3a4f-9b4f-2db28dc6128c"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"5326bbd3-ace4-3245-9a59-0d6a7deda50c"],

Cell["\<\
A 3-array that is one where the first two indices agree, whatever the third:\
\>", "ExampleText",ExpressionUUID->"0f2fb0c6-4e87-3e4b-ac0f-482460c5fede"],

Cell["Normal @ PartialIdentityArray[3, 2, {1, 2}]", "Input",ExpressionUUID->"0020649b-7bee-b34b-bb3c-8c6993a2722e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1"}], "}"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"74b77228-21af-fb44-8d55-175615b8c9e7"],

Cell["\<\
The three partial identities of a 3-array, one for each pair of indices:\
\>", "ExampleText",ExpressionUUID->"4777928e-4f92-0b43-8a38-e3ec738503b4"],

Cell["\<\
Normal @ PartialIdentityArray[3, 2, #] & /@ {{1, 2}, {2, 3}, {1, 3}}\
\>", "Input",ExpressionUUID->"2d90493f-967a-3e4d-a09d-e76d7f5dd164"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}]}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], "}"}]}], "}"}]], "Output",E\
xpressionUUID->"dc74f4e5-7bf6-d44f-89cb-d2d5fc52080f"],

Cell["Naming every position gives the full identity:", "ExampleText",ExpressionUUID->"46c941c7-7c0a-c649-9a8e-17d1eae4381e"],

Cell["\<\
PartialIdentityArray[3, 2, {1, 2, 3}] === IdentityArray[3, 2]\
\>", "Input",ExpressionUUID->"f52b2953-f6b4-e042-8ad8-c1f955b09f07"],

Cell[BoxData["True"], "Output",ExpressionUUID->"9be018b0-f282-7448-b8f8-1e496c0cc402"],

Cell["Only a full identity is symmetric:", "ExampleText",ExpressionUUID->"a8abe657-c99b-414f-9767-eee28e7a8189"],

Cell["\<\
{ArraySymmetry @ PartialIdentityArray[3, 2, {1, 2}],
 ArraySymmetry @ PartialIdentityArray[3, 2, {1, 2, 3}]}\
\>", "Input",ExpressionUUID->"1ce3a0ca-08a8-a44d-ba95-3832cca16e14"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Rigid\"\>", ",", "\<\"Symmetric\"\>"}], "}"}]], "Output",Expres\
sionUUID->"6eb0c942-822f-2a47-b9bb-d6b9df84f3d6"],

Cell["Source", "NotesSection",ExpressionUUID->"3c40472e-616f-f443-bda3-dceca92847e6"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/ArrayAlgebra.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Special arrays",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"253542a4-9257-8247-ba48-dec2dddd7098"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"34e8d679-0d4e-2348-98f5-0c32c15ec56e"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["IdentityArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "33d0ca9c-890e-034e-990b-e7441a9cdec3"],
 ", ",
 Cell[BoxData[
  StyleBox["ZeroArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "c7322444-e59c-ea4c-9cbb-8e308c4e08b1"],
 ", ",
 Cell[BoxData[
  StyleBox["OneArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "0864f5bd-3728-df43-a88d-3a1387270dea"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayMultiply", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "35c62938-d5ab-624d-963d-dacc141e9f3c"],
 ", ",
 Cell[BoxData[
  StyleBox["ArraySymmetry", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "4fe22938-76f0-3a48-80d9-853dd2a372a7"]
}], "SeeAlso",ExpressionUUID->"695dcbd4-90d0-e04b-b157-329d985fefb2"]
