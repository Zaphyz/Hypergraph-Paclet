(* Beginning of Notebook Content *)
Notebook[{
Cell["PartialIdentityArray", "ObjectName",ExpressionUUID->"bd16ca3f-96d1-3542-b96f-f8f4d54b9aba"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"PartialIdentityArray", "[", 
    RowBox[{"n", ",", " ", "d", ",", " ", "positions"}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "05b93900-4e2b-7e4c-8379-f071906e1a0b"],
 " ",
 "gives the n-array with every index of length d whose entry is one where the \
indices at the given positions agree and zero elsewhere."
}], "Usage",ExpressionUUID->"7d2f1e3f-aa53-d641-b4b0-7f5f4521440c"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"PartialIdentityArray", "[", 
    RowBox[{"n", ",", " ", "d", ",", " ", "positions", ",", " ", "dom"}], 
    "]"}], "InlineCode"]], "InlineFormula",ExpressionUUID->
  "540ec4e4-c280-d14c-a574-0b5da591028b"],
 " ",
 "gives its entries in the value domain dom."
}], "Usage",ExpressionUUID->"3c4125f0-bf3e-d048-b296-6bb15a369398"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"fc0592a2-fbb4-074c-a651-77df1d7eb33f"],

Cell["\<\
The positions are a list of distinct index positions between 1 and n.\
\>", "Notes",ExpressionUUID->"36897ff8-f115-174b-9672-2d703c0dadc3"],

Cell["\<\
With every position named this is IdentityArray[n, d], which is symmetric. \
With only some of them the array is generally not invariant under permuting \
all its indices, so it is declared \"Rigid\".\
\>", "Notes",ExpressionUUID->"1816fb76-93c9-ae46-86ba-11659c208aa2"],

Cell["\<\
These are the arrays that act as partial units for the ternary products: each \
names the pair of indices it identifies.\
\>", "Notes",ExpressionUUID->"90a037db-d4db-664e-9291-195b326f9325"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"dd122f0d-e5ec-bd46-a2c8-effa6c16a797"],

Cell["\<\
A 3-array that is one where the first two indices agree, whatever the third:\
\>", "ExampleText",ExpressionUUID->"fd9cbad4-ef32-274e-ace0-e6c0fce7b6cb"],

Cell["Normal @ PartialIdentityArray[3, 2, {1, 2}]", "Input",ExpressionUUID->"47a73b30-2a9f-8e4a-bf57-82ca07f042e2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1"}], "}"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"00edfd94-e5a4-7a4f-ac51-8006dec7d0f3"],

Cell["\<\
The three partial identities of a 3-array, one for each pair of indices:\
\>", "ExampleText",ExpressionUUID->"a4373907-12a2-6a48-8c55-a8809ab3a1d7"],

Cell["\<\
Normal @ PartialIdentityArray[3, 2, #] & /@ {{1, 2}, {2, 3}, {1, 3}}\
\>", "Input",ExpressionUUID->"d6a96636-f5c4-4940-be82-89a17c2ce035"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}]}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], "}"}]}], "}"}]], "Output",E\
xpressionUUID->"ee739212-4412-1943-8a98-8ba33029617e"],

Cell["Naming every position gives the full identity:", "ExampleText",ExpressionUUID->"150271af-79d2-0b4f-8f98-a4b034b48e60"],

Cell["\<\
PartialIdentityArray[3, 2, {1, 2, 3}] === IdentityArray[3, 2]\
\>", "Input",ExpressionUUID->"0579c696-5e3f-3049-9326-b698b3c2e433"],

Cell[BoxData["True"], "Output",ExpressionUUID->"0a3a43a1-b28c-ff41-8156-1b0d7efddd43"],

Cell["Only a full identity is symmetric:", "ExampleText",ExpressionUUID->"e0969d19-593b-5640-ad09-039a9b389260"],

Cell["\<\
{ArraySymmetry @ PartialIdentityArray[3, 2, {1, 2}],
 ArraySymmetry @ PartialIdentityArray[3, 2, {1, 2, 3}]}\
\>", "Input",ExpressionUUID->"8e668737-77af-ed4b-9796-dd918046a131"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Rigid\"\>", ",", "\<\"Symmetric\"\>"}], "}"}]], "Output",Expres\
sionUUID->"d13e1cc5-e046-b54a-9daf-8f96ec03d425"],

Cell["Source", "NotesSection",ExpressionUUID->"c343e0f8-5655-b64d-92d5-19e39db5db14"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/ArrayAlgebra.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Special arrays",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"65f029c9-269b-bd46-bbb4-caed9b4d8d1c"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"26933f38-80ff-0b47-9da7-f5dd151556a2"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["IdentityArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "e37b1e7a-cdb8-f44a-989b-61bd59d2bb30"],
 ", ",
 Cell[BoxData[
  StyleBox["ZeroArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "cc81e889-3095-f14d-b305-787245fd843f"],
 ", ",
 Cell[BoxData[
  StyleBox["OneArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "79341b63-2c8e-af4e-bd26-c1e70404b3f4"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayMultiply", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "1b613f3c-f7ad-2045-93f8-08bb65a5ec9f"],
 ", ",
 Cell[BoxData[
  StyleBox["ArraySymmetry", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "ad1fd7f1-4c4b-974e-9d52-9e86970a581a"]
}], "SeeAlso",ExpressionUUID->"a6301f7f-1d1e-3540-a31d-92b2777de3ab"]
},
