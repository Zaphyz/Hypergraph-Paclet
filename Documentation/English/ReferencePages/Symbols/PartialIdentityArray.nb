Notebook[{
Cell["PartialIdentityArray", "ObjectName",ExpressionUUID->"9ec7c4f0-a919-164f-859d-2c6b0733da51"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"PartialIdentityArray", "[", 
    RowBox[{"n", ",", " ", "d", ",", " ", "positions"}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "bcb7b2f5-628e-6447-98f6-ac347d238477"],
 " ",
 "gives the n-array with every index of length d whose entry is one where the \
indices at the given positions agree and zero elsewhere."
}], "Usage",ExpressionUUID->"f40266e8-bdb2-0148-8ded-ae0140d103a2"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"PartialIdentityArray", "[", 
    RowBox[{"n", ",", " ", "d", ",", " ", "positions", ",", " ", "dom"}], 
    "]"}], "InlineCode"]], "InlineFormula",ExpressionUUID->
  "7c6a23f5-7f66-8548-b764-337b6d8e2291"],
 " ",
 "gives its entries in the value domain dom."
}], "Usage",ExpressionUUID->"c2c1ff63-ce5b-864e-8c22-ccb81ab0c1e3"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"4608ef9d-e235-e54a-a844-7c04f71bdaec"],

Cell["\<\
The positions are a list of distinct index positions between 1 and n.\
\>", "Notes",ExpressionUUID->"62e4489f-aa2e-fc4c-ac85-386e37f48820"],

Cell["\<\
With every position named this is IdentityArray[n, d], which is symmetric. \
With only some of them the array is generally not invariant under permuting \
all its indices, so it is declared \"Rigid\".\
\>", "Notes",ExpressionUUID->"6e537493-e8c6-8f4a-9ef6-4c86f6d1f1b4"],

Cell["\<\
These are the arrays that act as partial units for the ternary products: each \
names the pair of indices it identifies.\
\>", "Notes",ExpressionUUID->"03592e0f-872d-2f46-a971-dc85be61e884"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"17fd9ba3-a0db-cc4f-9099-e7f3ddca7d09"],

Cell["\<\
A 3-array that is one where the first two indices agree, whatever the third:\
\>", "ExampleText",ExpressionUUID->"c82d229b-463a-0c4b-b105-91ddb5c18392"],

Cell["Normal @ PartialIdentityArray[3, 2, {1, 2}]", "Input",ExpressionUUID->"40770563-4055-2241-95d3-4037541d6533"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1"}], "}"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"f396159f-9280-6547-8a2c-fe7860f61bc2"],

Cell["\<\
The three partial identities of a 3-array, one for each pair of indices:\
\>", "ExampleText",ExpressionUUID->"a0609782-746c-0743-86a8-e11e283812e7"],

Cell["\<\
Normal @ PartialIdentityArray[3, 2, #] & /@ {{1, 2}, {2, 3}, {1, 3}}\
\>", "Input",ExpressionUUID->"a07affb0-dbaa-984c-959b-916e12e5da84"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}]}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], "}"}]}], "}"}]], "Output",E\
xpressionUUID->"45d2054a-09d1-cb4e-85f2-0aca3ecc1644"],

Cell["Naming every position gives the full identity:", "ExampleText",ExpressionUUID->"1b11076b-fd68-5945-b52e-46e065f86e82"],

Cell["\<\
PartialIdentityArray[3, 2, {1, 2, 3}] === IdentityArray[3, 2]\
\>", "Input",ExpressionUUID->"7540cc5c-b7e5-624e-9982-0945832de8a5"],

Cell[BoxData["True"], "Output",ExpressionUUID->"c75fd629-4084-984e-b425-81c43924a3e7"],

Cell["Only a full identity is symmetric:", "ExampleText",ExpressionUUID->"26574426-df85-574a-801a-073abc1249d8"],

Cell["\<\
{ArraySymmetry @ PartialIdentityArray[3, 2, {1, 2}],
 ArraySymmetry @ PartialIdentityArray[3, 2, {1, 2, 3}]}\
\>", "Input",ExpressionUUID->"c76eddb5-bedd-0941-8ce5-700a331b1da4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Rigid\"\>", ",", "\<\"Symmetric\"\>"}], "}"}]], "Output",Expres\
sionUUID->"017a9915-3162-0448-a093-4efc738effab"],

Cell["Source", "NotesSection",ExpressionUUID->"566c39a4-ce6f-d24d-a3b8-67bcd5045df8"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/ArrayAlgebra.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Special arrays",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"e76beb48-d41f-e54d-a384-9a5e2d608cbd"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"27c22a6c-3127-274a-b5de-83e1c1d8ca65"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["IdentityArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "56bd1d5e-e68b-0141-ac2f-ea7493e6ce73"],
 ", ",
 Cell[BoxData[
  StyleBox["ZeroArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "4637213b-8e64-714b-a1e4-ca58e558340a"],
 ", ",
 Cell[BoxData[
  StyleBox["OneArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "2a14a848-a877-1340-b963-ea724a3eb844"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayMultiply", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "45fd259e-5795-e44d-9131-19df00b3528a"],
 ", ",
 Cell[BoxData[
  StyleBox["ArraySymmetry", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "f085cd85-f37d-2446-a564-4190972a48ac"]
}], "SeeAlso",ExpressionUUID->"ebc43864-18bd-9546-9e30-030bc396a543"]
