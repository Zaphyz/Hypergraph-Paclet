Notebook[{
Cell["PartialIdentityArray", "ObjectName",ExpressionUUID->"91123076-aa4a-c040-a5b5-81c4ed6d56a3"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"PartialIdentityArray", "[", 
    RowBox[{"n", ",", " ", "d", ",", " ", "positions"}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "c1f9a75f-7835-bc46-b792-6b383cb68885"],
 " ",
 "gives the n-array with every index of length d whose entry is one where the \
indices at the given positions agree and zero elsewhere."
}], "Usage",ExpressionUUID->"1959ccf2-69dc-8b40-a337-53728bdc3e54"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"PartialIdentityArray", "[", 
    RowBox[{"n", ",", " ", "d", ",", " ", "positions", ",", " ", "dom"}], 
    "]"}], "InlineCode"]], "InlineFormula",ExpressionUUID->
  "245f13bd-e130-0c46-90d7-c53f6e4cfe99"],
 " ",
 "gives its entries in the value domain dom."
}], "Usage",ExpressionUUID->"170569d1-06c7-b749-9759-2ae968ac64a0"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"80008ebc-c5be-fe4d-bbb0-579ef783bfe1"],

Cell["\<\
The positions are a list of distinct index positions between 1 and n.\
\>", "Notes",ExpressionUUID->"fb204ca8-19a7-7e4f-a255-fd13dba39411"],

Cell["\<\
With every position named this is IdentityArray[n, d], which is symmetric. \
With only some of them the array is generally not invariant under permuting \
all its indices, so it is declared \"Rigid\".\
\>", "Notes",ExpressionUUID->"1f5e07f9-33ea-8046-941d-77ac4c6dcb8b"],

Cell["\<\
These are the arrays that act as partial units for the ternary products: each \
names the pair of indices it identifies.\
\>", "Notes",ExpressionUUID->"5b34ec38-f5b5-d847-b34b-2a5850401c32"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"9f38bcf2-f6e0-c241-8def-d091ced749dc"],

Cell["\<\
A 3-array that is one where the first two indices agree, whatever the third:\
\>", "ExampleText",ExpressionUUID->"56586a17-b802-a348-942d-c1afde2b3181"],

Cell["Normal @ PartialIdentityArray[3, 2, {1, 2}]", "Input",ExpressionUUID->"1a2b6f50-93f5-1e45-82fd-5ee934e1d87c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1"}], "}"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"b9085a80-f8b6-b442-a1f7-510b1b6bb4ef"],

Cell["\<\
The three partial identities of a 3-array, one for each pair of indices:\
\>", "ExampleText",ExpressionUUID->"bcfd4f67-1ad5-4546-ae23-fa1042aba781"],

Cell["\<\
Normal @ PartialIdentityArray[3, 2, #] & /@ {{1, 2}, {2, 3}, {1, 3}}\
\>", "Input",ExpressionUUID->"7052a217-a529-5b49-91a6-57312058011a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}]}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], "}"}]}], "}"}]], "Output",E\
xpressionUUID->"cb74efd0-b008-c14f-a6eb-620ee55c01ca"],

Cell["Naming every position gives the full identity:", "ExampleText",ExpressionUUID->"94d46aac-919d-dd45-a06a-c57d84c27277"],

Cell["\<\
PartialIdentityArray[3, 2, {1, 2, 3}] === IdentityArray[3, 2]\
\>", "Input",ExpressionUUID->"1cb3fecc-c89b-a14f-9e0a-972449ee74f5"],

Cell[BoxData["True"], "Output",ExpressionUUID->"6722ba2a-aeba-1f4b-be02-33247dd606d9"],

Cell["Only a full identity is symmetric:", "ExampleText",ExpressionUUID->"d50666cf-2919-f44d-bc27-ff9b0947a746"],

Cell["\<\
{ArraySymmetry @ PartialIdentityArray[3, 2, {1, 2}],
 ArraySymmetry @ PartialIdentityArray[3, 2, {1, 2, 3}]}\
\>", "Input",ExpressionUUID->"72818761-8133-504e-9ac6-396ff46325dd"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Rigid\"\>", ",", "\<\"Symmetric\"\>"}], "}"}]], "Output",Expres\
sionUUID->"2b12fad7-a1f4-3e4e-bb47-276712d9bbff"],

Cell["Source", "NotesSection",ExpressionUUID->"d23b1226-8207-9e44-8b44-0432fc9fd674"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/ArrayAlgebra.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Special arrays",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"94d7a81e-1c05-c44e-a497-fa90d5d2a90b"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"7ef4a5b4-1871-0748-b88a-ae5a9cd0555e"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["IdentityArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "ab99808d-c764-2d4e-864d-fd065f6bab87"],
 ", ",
 Cell[BoxData[
  StyleBox["ZeroArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "5499f6ff-2328-584f-9731-2c4d9dff2f76"],
 ", ",
 Cell[BoxData[
  StyleBox["OneArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "662e4fdc-542d-334f-8b25-d9af371c70ee"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayMultiply", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "f6c2b707-1e34-4344-99bc-639ba047e486"],
 ", ",
 Cell[BoxData[
  StyleBox["ArraySymmetry", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "c9750f5f-d0f8-784c-87ea-d26b728c8e3c"]
}], "SeeAlso",ExpressionUUID->"001c57cc-cc66-214f-b0c0-b9939df35482"]
},
