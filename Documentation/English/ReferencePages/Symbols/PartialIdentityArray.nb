Notebook[{
Cell["PartialIdentityArray", "ObjectName",ExpressionUUID->"87b1512e-38a0-3c4b-83f2-4b14f076f91d"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"PartialIdentityArray", "[", 
    RowBox[{"n", ",", " ", "d", ",", " ", "positions"}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "1407bd95-4fdb-2c43-9009-0109a93ad2dd"],
 " ",
 "gives the n-array with every index of length d whose entry is one where the \
indices at the given positions agree and zero elsewhere."
}], "Usage",ExpressionUUID->"0087b796-021a-e145-97c2-76c0452bb961"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"PartialIdentityArray", "[", 
    RowBox[{"n", ",", " ", "d", ",", " ", "positions", ",", " ", "dom"}], 
    "]"}], "InlineCode"]], "InlineFormula",ExpressionUUID->
  "57f9adc5-613a-2343-9ffd-5f7ee110a287"],
 " ",
 "gives its entries in the value domain dom."
}], "Usage",ExpressionUUID->"d17f2235-a5bf-104f-a226-6b8a96ad1e9e"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"7bd19e38-dae5-c549-9e62-278f99806dc7"],

Cell["\<\
The positions are a list of distinct index positions between 1 and n.\
\>", "Notes",ExpressionUUID->"1a647d27-f43a-bf4e-813e-fa1781837e7d"],

Cell["\<\
With every position named this is IdentityArray[n, d], which is symmetric. \
With only some of them the array is generally not invariant under permuting \
all its indices, so it is declared \"Rigid\".\
\>", "Notes",ExpressionUUID->"9f7edbf4-8a26-0e41-8241-7b009122785e"],

Cell["\<\
These are the arrays that act as partial units for the ternary products: each \
names the pair of indices it identifies.\
\>", "Notes",ExpressionUUID->"9c21085f-a7ba-e94c-bbf4-89651b9a7ef1"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"5d7b2a78-afd2-364b-bbd3-0976efc1d69e"],

Cell["\<\
A 3-array that is one where the first two indices agree, whatever the third:\
\>", "ExampleText",ExpressionUUID->"e044029b-bcf9-ba47-a846-188157d275e0"],

Cell["Normal @ PartialIdentityArray[3, 2, {1, 2}]", "Input",ExpressionUUID->"6cd6df0e-244a-144c-9452-9d42e9336504"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1"}], "}"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"6a49972b-e035-7941-8dbf-2a43a14cde97"],

Cell["\<\
The three partial identities of a 3-array, one for each pair of indices:\
\>", "ExampleText",ExpressionUUID->"5fd76905-d9fa-a74f-a3c4-80261e7491f7"],

Cell["\<\
Normal @ PartialIdentityArray[3, 2, #] & /@ {{1, 2}, {2, 3}, {1, 3}}\
\>", "Input",ExpressionUUID->"b9e7aec5-f6be-bd40-87a8-125524c2b3a5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}]}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], "}"}]}], "}"}]], "Output",E\
xpressionUUID->"ef8e82f8-fbef-7042-a869-a25c3e27385e"],

Cell["Naming every position gives the full identity:", "ExampleText",ExpressionUUID->"de8f656b-ceed-f046-9687-65f7a39bddbb"],

Cell["\<\
PartialIdentityArray[3, 2, {1, 2, 3}] === IdentityArray[3, 2]\
\>", "Input",ExpressionUUID->"6f30daf3-4488-4043-9e85-98a7387ebe32"],

Cell[BoxData["True"], "Output",ExpressionUUID->"d07488f0-e0d8-a64b-81cc-4a40ae7ece65"],

Cell["Only a full identity is symmetric:", "ExampleText",ExpressionUUID->"47eb00a0-8427-b040-8bac-b64efbf8e1e8"],

Cell["\<\
{ArraySymmetry @ PartialIdentityArray[3, 2, {1, 2}],
 ArraySymmetry @ PartialIdentityArray[3, 2, {1, 2, 3}]}\
\>", "Input",ExpressionUUID->"6f199595-5c0b-ac49-ac52-07023823d808"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Rigid\"\>", ",", "\<\"Symmetric\"\>"}], "}"}]], "Output",Expres\
sionUUID->"493f910d-ce53-e443-82de-b296b13ed400"],

Cell["Source", "NotesSection",ExpressionUUID->"df1c3090-8fcb-0f4e-9b6d-8610cdabad71"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/ArrayAlgebra.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Special arrays",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"f07dbb97-07f3-4c41-9f58-ce23b225d943"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"bffb04c7-04e5-4a4b-8294-e60aaabf7248"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["IdentityArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "cabdf25e-c1b3-1745-a68f-41e0475e566d"],
 ", ",
 Cell[BoxData[
  StyleBox["ZeroArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "fe13b5b4-6e29-6740-bc8a-a09a7643c74b"],
 ", ",
 Cell[BoxData[
  StyleBox["OneArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "91dbc3ee-d649-5b4c-a3ed-91c6d0e7bc5e"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayMultiply", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "a4f6cf71-8b7d-4b4d-9dfe-655a8f7f2821"],
 ", ",
 Cell[BoxData[
  StyleBox["ArraySymmetry", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "ec35fd2a-aa66-5c48-bdff-0ba7f117dbc8"]
}], "SeeAlso",ExpressionUUID->"d12621f6-3389-6c45-870e-e0bf3d0fa9bf"]
