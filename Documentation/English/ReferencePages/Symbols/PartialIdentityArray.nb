Notebook[{
Cell["PartialIdentityArray", "ObjectName",ExpressionUUID->"38766656-aa07-c74f-bd5a-84fe58219b96"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"PartialIdentityArray", "[", 
    RowBox[{"n", ",", " ", "d", ",", " ", "positions"}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "ee1ead9d-bb60-1242-9512-87904b159885"],
 " ",
 "gives the n-array with every index of length d whose entry is one where the \
indices at the given positions agree and zero elsewhere."
}], "Usage",ExpressionUUID->"0f0e3dcb-ffb5-e848-89fa-494b87a0379e"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"PartialIdentityArray", "[", 
    RowBox[{"n", ",", " ", "d", ",", " ", "positions", ",", " ", "dom"}], 
    "]"}], "InlineCode"]], "InlineFormula",ExpressionUUID->
  "9f6d2ce8-f0db-9e46-8fe3-483525945969"],
 " ",
 "gives its entries in the value domain dom."
}], "Usage",ExpressionUUID->"21e90763-0d1d-6547-b9b5-2be3ede6d93c"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"c895a9ea-6797-b44e-a62f-a39089c443c6"],

Cell["\<\
The positions are a list of distinct index positions between 1 and n.\
\>", "Notes",ExpressionUUID->"cad99ea8-08d4-464d-bcff-13f05a7ef5ac"],

Cell["\<\
With every position named this is IdentityArray[n, d], which is symmetric. \
With only some of them the array is generally not invariant under permuting \
all its indices, so it is declared \"Rigid\".\
\>", "Notes",ExpressionUUID->"6d19eb23-bea1-e24a-bc08-8dbe09346ee8"],

Cell["\<\
These are the arrays that act as partial units for the ternary products: each \
names the pair of indices it identifies.\
\>", "Notes",ExpressionUUID->"8a1953db-59bb-d347-bea6-f392332b98b6"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"1ab053f5-b105-9043-b13d-a492c765e0b9"],

Cell["\<\
A 3-array that is one where the first two indices agree, whatever the third:\
\>", "ExampleText",ExpressionUUID->"91ac7eee-a04d-a24c-af2c-f199543e7455"],

Cell["Normal @ PartialIdentityArray[3, 2, {1, 2}]", "Input",ExpressionUUID->"b1bddc30-c877-3e46-a041-2ec0f4641247"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1"}], "}"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"72b435f5-add9-614b-83e5-47d98ab1db8b"],

Cell["\<\
The three partial identities of a 3-array, one for each pair of indices:\
\>", "ExampleText",ExpressionUUID->"d9f8b587-84e2-a64a-8582-a9d1a0e02a6b"],

Cell["\<\
Normal @ PartialIdentityArray[3, 2, #] & /@ {{1, 2}, {2, 3}, {1, 3}}\
\>", "Input",ExpressionUUID->"b0910d79-6039-8f4f-9fbd-f347a0687775"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}]}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], "}"}]}], "}"}]], "Output",E\
xpressionUUID->"cc08226b-ae74-8944-9169-dd81103b9fbd"],

Cell["Naming every position gives the full identity:", "ExampleText",ExpressionUUID->"82e34640-2f4f-3245-a406-742b109375cb"],

Cell["\<\
PartialIdentityArray[3, 2, {1, 2, 3}] === IdentityArray[3, 2]\
\>", "Input",ExpressionUUID->"2ee9fb4b-0179-c448-9935-45e1c647c091"],

Cell[BoxData["True"], "Output",ExpressionUUID->"32351822-394d-0d47-93ee-9b1ff554298f"],

Cell["Only a full identity is symmetric:", "ExampleText",ExpressionUUID->"4acec2fc-868e-bd41-b4b5-068513f52ce3"],

Cell["\<\
{ArraySymmetry @ PartialIdentityArray[3, 2, {1, 2}],
 ArraySymmetry @ PartialIdentityArray[3, 2, {1, 2, 3}]}\
\>", "Input",ExpressionUUID->"5d5f4344-28d6-cc40-b5ae-013560e3850c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Rigid\"\>", ",", "\<\"Symmetric\"\>"}], "}"}]], "Output",Expres\
sionUUID->"2b7b2944-e230-0048-8c0f-0df3bfcb1f89"],

Cell["Source", "NotesSection",ExpressionUUID->"25d37ec0-ed39-b848-bbbc-1ac95d24588b"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/ArrayAlgebra.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Special arrays",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"508c7cbe-342e-6149-838b-35a05099aaba"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"1f38a043-57cf-274c-856f-c82b5903aeb2"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["IdentityArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "c960f18f-9f6f-e14f-a927-99e8dc809a1d"],
 ", ",
 Cell[BoxData[
  StyleBox["ZeroArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "077d1d69-df01-4b4c-868b-889339cef284"],
 ", ",
 Cell[BoxData[
  StyleBox["OneArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "d7487cce-84df-1646-9ba5-acf9905e6a11"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayMultiply", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "4a365255-9611-c349-a324-f2f7814e8428"],
 ", ",
 Cell[BoxData[
  StyleBox["ArraySymmetry", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "ed058a05-acec-b34e-9a5a-e9aab83be35a"]
}], "SeeAlso",ExpressionUUID->"a848f8e4-570d-2d4b-b40f-36016d063ef3"]
},
