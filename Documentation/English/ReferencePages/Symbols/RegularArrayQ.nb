Notebook[{
Cell["RegularArrayQ", "ObjectName",ExpressionUUID->"66dcbd24-ffa8-4f46-ac63-91ddb6d6d007"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"RegularArrayQ", "[", "arr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"8637d413-ddb2-e64a-8d31-5e137093c946"],
 " ",
 "gives True if every index of arr ranges over the same length, and False \
otherwise."
}], "Usage",ExpressionUUID->"c4022f94-6457-574c-9d8c-d219a4fc1614"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"f80c334a-7630-644c-b23a-e66017c675db"],

Cell["\<\
An array whose indices range over different lengths is called irregular.\
\>", "Notes",ExpressionUUID->"f8422985-e25a-f44f-b82c-bf0536386c7a"],

Cell["\<\
Only a regular array can carry an index symmetry other than \"Rigid\", since \
permuting the indices of an irregular array would not give an array of the \
same shape.\
\>", "Notes",ExpressionUUID->"9643b509-33e9-0e48-b21b-bd2aafa0d9bf"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"c9c1412e-4176-4244-ad04-30195ffcffab"],

Cell["\<\
{RegularArrayQ @ ArrayObject[{{1, 2}, {3, 4}}],
 RegularArrayQ @ ArrayObject[{{1, 2, 3}, {4, 5, 6}}]}\
\>", "Input",ExpressionUUID->"4af49e40-3a83-1642-9cfb-b85597a5b275"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",ExpressionUUID->"7ebc31ba-\
0eda-3c40-88bc-8155eb9915c5"],

Cell["An irregular array cannot be declared symmetric:", "ExampleText",ExpressionUUID->"3e4af9f7-4522-f844-b697-f767eed9b233"],

Cell["Quiet @ ArrayObject[{{1, 2, 3}, {4, 5, 6}}, \"Symmetric\"]", "Input",ExpressionUUID->"37b96378-196e-4440-98b8-e385cf6e34a4"],

Cell[BoxData["$Failed"], "Output",ExpressionUUID->"2eecd638-f452-6542-bd5f-ecc3938cf4f0"],

Cell["Source", "NotesSection",ExpressionUUID->"e16cf1ec-8527-434c-a521-d214e486b75e"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Array accessors",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"c34a1553-2b59-cc46-804e-2b536a380c19"],

