Notebook[{
Cell["RegularArrayQ", "ObjectName",ExpressionUUID->"7d809ede-5ba1-c749-83b9-d80769383ca3"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"RegularArrayQ", "[", "arr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"dc501f24-8eab-9344-9ce8-3967b2e2b954"],
 " ",
 "gives True if every index of arr ranges over the same length, and False \
otherwise."
}], "Usage",ExpressionUUID->"b1f7423f-9278-034b-b466-39c8de5b65f7"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"aac1d179-d4bb-4d43-988a-35b6f0c82019"],

Cell["\<\
An array whose indices range over different lengths is called irregular.\
\>", "Notes",ExpressionUUID->"d82a6166-60fe-7442-bb4a-574b4084cf83"],

Cell["\<\
Only a regular array can carry an index symmetry other than \"Rigid\", since \
permuting the indices of an irregular array would not give an array of the \
same shape.\
\>", "Notes",ExpressionUUID->"257dbe50-a68e-2048-be10-ff7c0d6c02b5"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"f1d91ab5-f7af-5844-be0a-6b5a4cef6fa8"],

Cell["\<\
{RegularArrayQ @ NumericalArray[{{1, 2}, {3, 4}}],
 RegularArrayQ @ NumericalArray[{{1, 2, 3}, {4, 5, 6}}]}\
\>", "Input",ExpressionUUID->"dd87cb2a-3bf9-4845-9949-e9baa1c2f166"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",ExpressionUUID->"d73715c6-\
1c13-c540-8084-c3d7abfbb49b"],

Cell["An irregular array cannot be declared symmetric:", "ExampleText",ExpressionUUID->"2e3a743e-7435-d14b-9aea-802e0228631d"],

Cell["\<\
Quiet @ NumericalArray[{{1, 2, 3}, {4, 5, 6}}, Automatic, \"Symmetric\"]\
\>", "Input",ExpressionUUID->"fd0f7815-8d51-864f-87a6-78ce18f14eed"],

Cell[BoxData["$Failed"], "Output",ExpressionUUID->"448b4ba3-7274-424d-beac-8a7ebd3667d4"],

Cell["Source", "NotesSection",ExpressionUUID->"fa22fd92-2557-e148-80da-537d36c12c34"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Array accessors",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"6b0993fd-0519-2d47-a0bc-982882513d31"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"e2207051-3be5-cd43-93f9-4c1e37affe18"],

