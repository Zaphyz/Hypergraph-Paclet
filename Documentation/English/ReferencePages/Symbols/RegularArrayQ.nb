Notebook[{
Cell["RegularArrayQ", "ObjectName",ExpressionUUID->"d8f6bf74-9042-b74f-9b5c-cca35e10ced4"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"RegularArrayQ", "[", "arr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"9c48c8f2-47d6-cb4c-bb66-03fd80bf1729"],
 " ",
 "gives True if every index of arr ranges over the same length, and False \
otherwise."
}], "Usage",ExpressionUUID->"018e92fb-472d-c046-b05b-5855c08bb332"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"dd46b19c-951d-0842-a251-0774ddd3ad04"],

Cell["\<\
An array whose indices range over different lengths is called irregular.\
\>", "Notes",ExpressionUUID->"3d211fc6-b4d6-5c4b-8109-ab6f3d066ee4"],

Cell["\<\
Only a regular array can carry an index symmetry other than \"Rigid\", since \
permuting the indices of an irregular array would not give an array of the \
same shape.\
\>", "Notes",ExpressionUUID->"654ebece-7be5-434d-a845-f81cf81dc4a8"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"e2fa02eb-90d3-664d-8413-52aeee4e939e"],

Cell["\<\
{RegularArrayQ @ ArrayObject[{{1, 2}, {3, 4}}],
 RegularArrayQ @ ArrayObject[{{1, 2, 3}, {4, 5, 6}}]}\
\>", "Input",ExpressionUUID->"295daeef-faed-c543-b6e7-edb24d707d69"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",ExpressionUUID->"da2b5bce-\
79c3-a342-8d9a-37f11ff34302"],

Cell["An irregular array cannot be declared symmetric:", "ExampleText",ExpressionUUID->"60ea5359-4ad5-af43-a3ac-a1fc3b33a366"],

Cell["Quiet @ ArrayObject[{{1, 2, 3}, {4, 5, 6}}, \"Symmetric\"]", "Input",ExpressionUUID->"c121f2de-8f67-dd48-abe5-97625418bc01"],

Cell[BoxData["$Failed"], "Output",ExpressionUUID->"31b80d61-d8ce-d543-b6fe-381ba9562be8"],

Cell["Source", "NotesSection",ExpressionUUID->"ec69b454-91d7-744a-8fb1-c059448242dc"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Array accessors",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"774c35d3-bf34-5a4a-a8ee-35a27b5395ef"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"84623893-93b5-814c-a2f4-a8e986461919"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayDimensions", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "05656573-5f54-dd4a-91f6-6b62cf5d2620"],
 ", ",
