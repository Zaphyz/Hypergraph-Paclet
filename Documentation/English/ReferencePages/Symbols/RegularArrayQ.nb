Notebook[{
Cell["RegularArrayQ", "ObjectName",ExpressionUUID->"1269a452-a6f6-514a-9d5b-095f78fc5c62"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"RegularArrayQ", "[", "arr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"4d407fc0-4561-fe46-883e-a6e932e5f5c9"],
 " ",
 "gives True if every index of arr ranges over the same length, and False \
otherwise."
}], "Usage",ExpressionUUID->"3946ff1a-c8e7-f740-a185-96bd79465a3f"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"aa1b449c-b0ad-3846-928f-15cd96906084"],

Cell["\<\
An array whose indices range over different lengths is called irregular.\
\>", "Notes",ExpressionUUID->"fd24044a-e87c-a648-ad98-5dc70c8fbe10"],

Cell["\<\
Only a regular array can carry an index symmetry other than \"Rigid\", since \
permuting the indices of an irregular array would not give an array of the \
same shape.\
\>", "Notes",ExpressionUUID->"171d1e62-abed-d24a-a2bc-4ff3acb55f9f"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"07e92bc8-fdc8-6543-b0d8-fc11b991d678"],

Cell["\<\
{RegularArrayQ @ ArrayObject[{{1, 2}, {3, 4}}],
 RegularArrayQ @ ArrayObject[{{1, 2, 3}, {4, 5, 6}}]}\
\>", "Input",ExpressionUUID->"452b6d36-967e-604d-8759-aceb7672cd35"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",ExpressionUUID->"8967a781-\
ba79-2743-9d2e-871929f5bed9"],

Cell["An irregular array cannot be declared symmetric:", "ExampleText",ExpressionUUID->"5704fb0f-65e2-a147-b63a-c654e548a808"],

Cell["Quiet @ ArrayObject[{{1, 2, 3}, {4, 5, 6}}, \"Symmetric\"]", "Input",ExpressionUUID->"29087c68-1e77-7a44-aad9-335e6ce57686"],

Cell[BoxData["$Failed"], "Output",ExpressionUUID->"40bef2bd-2280-ec4d-86b5-356ba1ed508c"],

Cell["Source", "NotesSection",ExpressionUUID->"765954b6-209b-484f-b54e-718a6598f274"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Array accessors",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"e359286d-7c13-4741-8274-2a15e814627f"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"f97dc33b-f5ff-6847-8696-b6fcd7a80ca1"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayDimensions", "InlineCode"]], "InlineFormula",ExpressionUUID->
