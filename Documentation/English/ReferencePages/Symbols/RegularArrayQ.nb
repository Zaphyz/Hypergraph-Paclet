Notebook[{
Cell["RegularArrayQ", "ObjectName",ExpressionUUID->"66ec0815-73b8-c843-a49c-eff86f6c066e"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"RegularArrayQ", "[", "arr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"ef3fa980-ad7d-9a42-82c8-3decca95b2bc"],
 " ",
 "gives True if every index of arr ranges over the same length, and False \
otherwise."
}], "Usage",ExpressionUUID->"38aadd48-26b2-8642-b496-58a196bec6e3"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"1ec4544a-70db-3d44-b38d-da85f21ced2f"],

Cell["\<\
An array whose indices range over different lengths is called irregular.\
\>", "Notes",ExpressionUUID->"db694102-6b87-0446-b5e1-932ac21b330c"],

Cell["\<\
Only a regular array can carry an index symmetry other than \"Rigid\", since \
permuting the indices of an irregular array would not give an array of the \
same shape.\
\>", "Notes",ExpressionUUID->"e7bcacc0-6961-374b-bb14-182401b693a1"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"815c8cdc-d3bf-3245-93ed-290e87977c50"],

Cell["\<\
{RegularArrayQ @ ArrayObject[{{1, 2}, {3, 4}}],
 RegularArrayQ @ ArrayObject[{{1, 2, 3}, {4, 5, 6}}]}\
\>", "Input",ExpressionUUID->"e4939640-5370-f94e-8f68-ded135af2c20"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",ExpressionUUID->"0e85c0c9-\
0f60-8346-a024-5f1ec949ac46"],

Cell["An irregular array cannot be declared symmetric:", "ExampleText",ExpressionUUID->"2f87ef4e-bad7-cc42-ac01-ba8928cf0b5e"],

Cell["Quiet @ ArrayObject[{{1, 2, 3}, {4, 5, 6}}, \"Symmetric\"]", "Input",ExpressionUUID->"afd75184-f591-8249-9ae2-6e8b3ceb2f17"],

Cell[BoxData["$Failed"], "Output",ExpressionUUID->"f4c13564-da32-9544-a338-6b66ead13de2"],

Cell["Source", "NotesSection",ExpressionUUID->"4a19e0df-a49a-d141-94cf-46173d0206ef"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Array accessors",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"e740a1b8-6023-5744-bab7-133f3b577eec"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"d10a4c04-9740-504b-a1be-07a1d042f099"],

