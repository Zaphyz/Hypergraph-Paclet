Notebook[{
Cell["RegularArrayQ", "ObjectName",ExpressionUUID->"cd77ee4a-cb70-8b4b-a13e-1cb04ef9542b"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"RegularArrayQ", "[", "arr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"1f429b40-572c-4f4f-ad02-94f8fae042e7"],
 " ",
 "gives True if every index of arr ranges over the same length, and False \
otherwise."
}], "Usage",ExpressionUUID->"76b21874-b6d0-424a-9cc6-dcd9a9a8ade6"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"28bce2ae-4197-6747-a626-666237869423"],

Cell["\<\
An array whose indices range over different lengths is called irregular.\
\>", "Notes",ExpressionUUID->"2a7b0e12-74e6-544f-893d-c011d655a658"],

Cell["\<\
Only a regular array can carry an index symmetry other than \"Rigid\", since \
permuting the indices of an irregular array would not give an array of the \
same shape.\
\>", "Notes",ExpressionUUID->"0951b458-fa73-d04e-95df-55486bf73880"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"01e3057c-c9a8-5d46-b903-60f51a38dfeb"],

Cell["\<\
{RegularArrayQ @ ArrayObject[{{1, 2}, {3, 4}}],
 RegularArrayQ @ ArrayObject[{{1, 2, 3}, {4, 5, 6}}]}\
\>", "Input",ExpressionUUID->"7cf24dca-ac86-cd43-95ad-e16d7d672f8a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",ExpressionUUID->"014d5887-\
2d8a-b045-a534-98dc2efaf97e"],

Cell["An irregular array cannot be declared symmetric:", "ExampleText",ExpressionUUID->"361e558c-90ee-0a49-8197-f465591bb372"],

Cell["Quiet @ ArrayObject[{{1, 2, 3}, {4, 5, 6}}, \"Symmetric\"]", "Input",ExpressionUUID->"46839d1e-0f4c-494c-b2cb-dbb149754680"],

Cell[BoxData["$Failed"], "Output",ExpressionUUID->"efd888d3-a66b-a44b-849e-33c0806b7325"],

Cell["Source", "NotesSection",ExpressionUUID->"6839985e-7864-3a49-93f9-81176a6c5c7a"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Array accessors",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"add22c97-7d5b-644b-a013-320a1dda561e"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"63122373-2c19-7441-b071-59ee62dce7ff"],

