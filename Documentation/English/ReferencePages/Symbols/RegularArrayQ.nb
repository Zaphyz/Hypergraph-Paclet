Notebook[{
Cell["RegularArrayQ", "ObjectName",ExpressionUUID->"3ad61371-f2d8-9f48-a9eb-7d14794959f8"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"RegularArrayQ", "[", "arr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"8c99ecce-b20c-7444-8db2-bba0b08e6be0"],
 " ",
 "gives True if every index of arr ranges over the same length, and False \
otherwise."
}], "Usage",ExpressionUUID->"ef2487a5-497b-f543-a5cf-c0bb3a31178f"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"637b63cb-04b3-fb41-a065-4db449c9cbd8"],

Cell["\<\
An array whose indices range over different lengths is called irregular.\
\>", "Notes",ExpressionUUID->"c434740d-1b67-ba41-ae00-0241477d4b43"],

Cell["\<\
Only a regular array can carry an index symmetry other than \"Rigid\", since \
permuting the indices of an irregular array would not give an array of the \
same shape.\
\>", "Notes",ExpressionUUID->"3bce3713-5704-a746-979e-96548584feb0"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"05afb967-ad54-c842-bcdd-3c314c906230"],

Cell["\<\
{RegularArrayQ @ ArrayObject[{{1, 2}, {3, 4}}],
 RegularArrayQ @ ArrayObject[{{1, 2, 3}, {4, 5, 6}}]}\
\>", "Input",ExpressionUUID->"10f1a621-f432-3246-aaa2-f566d002c69f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",ExpressionUUID->"a23f0e6d-\
911f-5b4f-8cee-306fe17bb708"],

Cell["An irregular array cannot be declared symmetric:", "ExampleText",ExpressionUUID->"15bdfa78-14fb-a041-a158-bfcbe36d58c3"],

Cell["Quiet @ ArrayObject[{{1, 2, 3}, {4, 5, 6}}, \"Symmetric\"]", "Input",ExpressionUUID->"03bf6659-25b1-a84a-9c5d-3c5a3ecce5cf"],

Cell[BoxData["$Failed"], "Output",ExpressionUUID->"4985312a-729c-9747-8bc1-094a2bd07726"],

Cell["Source", "NotesSection",ExpressionUUID->"9cc9affb-951f-3043-8a6c-121741d1486a"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Array accessors",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"d15adc38-10e6-6d41-8950-84e65dc9a6d1"],

