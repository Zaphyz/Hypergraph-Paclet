Notebook[{
Cell["RegularArrayQ", "ObjectName",ExpressionUUID->"29d9900d-29fb-5e44-a83d-0af59472951a"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"RegularArrayQ", "[", "arr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"3b51c6c5-5cfc-0a44-9e47-6bcbb2f17070"],
 " ",
 "gives True if every index of arr ranges over the same length, and False \
otherwise."
}], "Usage",ExpressionUUID->"335ff500-6beb-fa48-8675-986b75ffbb00"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"87ea1c7a-6d11-d046-9997-710bbd3427f8"],

Cell["\<\
An array whose indices range over different lengths is called irregular.\
\>", "Notes",ExpressionUUID->"02f31dce-d4d2-2140-95a3-d7ee4d4920c2"],

Cell["\<\
Only a regular array can carry an index symmetry other than \"Rigid\", since \
permuting the indices of an irregular array would not give an array of the \
same shape.\
\>", "Notes",ExpressionUUID->"9f5df0a1-2b14-b046-b985-948b86be1be9"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"960164a1-7843-e842-816f-6ef1cf18719a"],

Cell["\<\
{RegularArrayQ @ ArrayObject[{{1, 2}, {3, 4}}],
 RegularArrayQ @ ArrayObject[{{1, 2, 3}, {4, 5, 6}}]}\
\>", "Input",ExpressionUUID->"43bd07d3-0f64-d840-bdc3-441d32a4d09c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",ExpressionUUID->"e2c4fae8-\
bcae-c64c-a1e8-bb6e4fb6a352"],

Cell["An irregular array cannot be declared symmetric:", "ExampleText",ExpressionUUID->"9397927d-3056-bc44-a86b-57d875376c31"],

Cell["Quiet @ ArrayObject[{{1, 2, 3}, {4, 5, 6}}, \"Symmetric\"]", "Input",ExpressionUUID->"3fca8f81-3552-6c43-ab9b-ff6baaa3e15d"],

Cell[BoxData["$Failed"], "Output",ExpressionUUID->"8434b784-42e4-694a-b7fb-fe0d13c62742"],

Cell["Source", "NotesSection",ExpressionUUID->"886e9a78-f8c6-494d-ba15-7afc477a8497"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Array accessors",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"5a6578d9-e078-3f4e-9c3e-766caf15f567"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"19cfb9bf-57f0-ba4f-a7d8-be9bca5b0d86"],

