Notebook[{
Cell["RegularArrayQ", "ObjectName",ExpressionUUID->"b976975c-bc3b-7647-ac97-dfe1c89567df"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"RegularArrayQ", "[", "arr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"ac556e98-d69d-0946-af99-4cd7d0037f15"],
 " ",
 "gives True if every index of arr ranges over the same length, and False \
otherwise."
}], "Usage",ExpressionUUID->"cb36aef1-66bf-3d4b-b0b8-8316d6862f9c"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"a5d82c0f-09a2-2a4c-bba7-c54fe752bd06"],

Cell["\<\
An array whose indices range over different lengths is called irregular.\
\>", "Notes",ExpressionUUID->"22089dde-7d58-d14d-a522-9cdbfe7f4295"],

Cell["\<\
Only a regular array can carry an index symmetry other than \"Rigid\", since \
permuting the indices of an irregular array would not give an array of the \
same shape.\
\>", "Notes",ExpressionUUID->"b4245210-a76d-e94f-8b06-03877c614981"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"c0ff3fbc-fbbf-264d-9157-c4b38e1c397d"],

Cell["\<\
{RegularArrayQ @ ArrayObject[{{1, 2}, {3, 4}}],
 RegularArrayQ @ ArrayObject[{{1, 2, 3}, {4, 5, 6}}]}\
\>", "Input",ExpressionUUID->"1fcf46f8-6af8-4f4f-b098-89c74989aac1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",ExpressionUUID->"bb8ad538-\
3cc8-e048-93c4-d4c236e5920e"],

Cell["An irregular array cannot be declared symmetric:", "ExampleText",ExpressionUUID->"957f0405-5576-9549-a79d-35aebe7f79f5"],

Cell["Quiet @ ArrayObject[{{1, 2, 3}, {4, 5, 6}}, \"Symmetric\"]", "Input",ExpressionUUID->"fbe3f424-34cb-9145-9851-126b647261e4"],

Cell[BoxData["$Failed"], "Output",ExpressionUUID->"1de1fcaf-3b4b-0d4b-b830-faba1173d889"],

Cell["Source", "NotesSection",ExpressionUUID->"e226471e-ce37-1d4e-9941-857bcab0da1f"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Array accessors",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"934d754d-4643-904e-84cb-1f7dfa57f373"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"995e8598-c4cf-ee49-b297-0f4589e6e1cb"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["ArrayDimensions", "InlineCode"]], "InlineFormula",ExpressionUUID->
