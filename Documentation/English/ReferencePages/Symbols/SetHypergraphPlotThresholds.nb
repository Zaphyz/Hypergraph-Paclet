(* Beginning of Notebook Content *)
Notebook[{
Cell["SetHypergraphPlotThresholds", "ObjectName",ExpressionUUID->"d140e861-5d66-d94d-81b0-48cb2c4bcbf5"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"SetHypergraphPlotThresholds", "[", 
    RowBox[{
     RowBox[{"\"\<MaxVertices\>\"", " ", "->", " ", "n"}], ",", " ", "..."}], 
    "]"}], "InlineCode"]], "InlineFormula",ExpressionUUID->
  "7330dc1b-8297-364d-86ed-dd9ed383c178"],
 " ",
 "sets the sizes beyond which a Hypergraph displays as a summary box rather \
than a plot."
}], "Usage",ExpressionUUID->"36a25811-301a-ac47-919e-a15a03f7e5b5"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"cf0bbb6a-9aa8-0a42-a193-3fc3668f4e16"],

Cell["\<\
The recognized keys are \"MaxVertices\", \"MaxEdges\" and \
\"MaxTotalElements\"; the defaults are 32, 128 and 196.\
\>", "Notes",ExpressionUUID->"ea0260c0-d005-c54b-9292-0bc158d8835b"],

Cell["\<\
Only the keys given are changed, and the new thresholds apply to every \
subsequent display.\
\>", "Notes",ExpressionUUID->"12bb9cf6-b2a0-ac40-bb0e-8628563f9374"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"05dca39d-504c-164c-a4ef-33f56eb96800"],

Cell["\<\
Making the threshold small enough that a small hypergraph is summarized:\
\>", "ExampleText",ExpressionUUID->"eee7b20c-4c0a-9043-aac4-1428fde1b811"],

Cell["\<\
SetHypergraphPlotThresholds[\"MaxVertices\" -> 2];
HypergraphLargeQ[Hypergraph[{{1, 2, 3}}]]\
\>", "Input",ExpressionUUID->"13a7d937-3d71-ab40-805f-d8d4469c2da4"],

Cell[BoxData["True"], "Output",ExpressionUUID->"76f37b29-c971-9d4e-a6bf-5035329b0da7"],

Cell["Putting it back:", "ExampleText",ExpressionUUID->"2060d4e2-20b1-5843-8452-d36441c91afa"],

Cell["\<\
SetHypergraphPlotThresholds[\"MaxVertices\" -> 32];
HypergraphLargeQ[Hypergraph[{{1, 2, 3}}]]\
\>", "Input",ExpressionUUID->"b5cac18f-8925-d14b-bbaa-4359d0f9b86d"],

Cell[BoxData["False"], "Output",ExpressionUUID->"34a5474d-a5e4-5e4a-b351-bd0a8f55893e"],

Cell["Source", "NotesSection",ExpressionUUID->"55316f5c-9561-d248-8fc4-87a883e873b1"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/HypergraphPlot.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Default formatting",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"13e131b5-de52-d94e-941d-7a933d9ade14"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"f2c0bef1-ff6d-fe46-8f91-96b81c37c115"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["HypergraphLargeQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "247c14e9-1f6f-c341-888c-440748597d4c"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphPlot", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "572e6034-d537-ed42-bce1-fb447b74ec82"],
 ", ",
 Cell[BoxData[
  StyleBox["Hypergraph", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "365efded-18e8-9b4d-a89c-795ea9c02ef5"]
}], "SeeAlso",ExpressionUUID->"fa1e65e5-9472-3e4b-90fe-3957c414283a"]
},
