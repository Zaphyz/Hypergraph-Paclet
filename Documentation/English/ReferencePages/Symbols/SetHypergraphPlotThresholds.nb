(* Beginning of Notebook Content *)
Notebook[{
Cell["SetHypergraphPlotThresholds", "ObjectName",ExpressionUUID->"2d0435ce-9841-e54c-b081-d3577d2faa01"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"SetHypergraphPlotThresholds", "[", 
    RowBox[{
     RowBox[{"\"\<MaxVertices\>\"", " ", "->", " ", "n"}], ",", " ", "..."}], 
    "]"}], "InlineCode"]], "InlineFormula",ExpressionUUID->
  "f636eef2-57e9-1a49-918a-31b8e7a98a68"],
 " ",
 "sets the sizes beyond which a Hypergraph displays as a summary box rather \
than a plot."
}], "Usage",ExpressionUUID->"78c4438b-5d0e-1441-a4ec-a95e409d4f57"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"971e2a5d-d132-b043-8c5d-f4a0e0a98296"],

Cell["\<\
The recognized keys are \"MaxVertices\", \"MaxEdges\" and \
\"MaxTotalElements\"; the defaults are 32, 128 and 196.\
\>", "Notes",ExpressionUUID->"4f1c518e-a5f0-c04f-b1c3-6528fe8a4b46"],

Cell["\<\
Only the keys given are changed, and the new thresholds apply to every \
subsequent display.\
\>", "Notes",ExpressionUUID->"3daa58e0-191c-314d-9c9d-0d1dc0aa0b5f"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"ad02be5a-e0c4-5743-8f5f-7a11b5373d0f"],

Cell["\<\
Making the threshold small enough that a small hypergraph is summarized:\
\>", "ExampleText",ExpressionUUID->"54b283b9-873a-954e-9cce-f4ad37fbe30e"],

Cell["\<\
SetHypergraphPlotThresholds[\"MaxVertices\" -> 2];
HypergraphLargeQ[Hypergraph[{{1, 2, 3}}]]\
\>", "Input",ExpressionUUID->"5c529776-5b74-434e-914f-d8399961800f"],

Cell[BoxData["True"], "Output",ExpressionUUID->"4780caa5-f343-1546-8f40-16eb5af2b7fd"],

Cell["Putting it back:", "ExampleText",ExpressionUUID->"017d3c3f-0e8e-4b4b-90ed-1bd3d10dc671"],

Cell["\<\
SetHypergraphPlotThresholds[\"MaxVertices\" -> 32];
HypergraphLargeQ[Hypergraph[{{1, 2, 3}}]]\
\>", "Input",ExpressionUUID->"78a7b10a-22af-594d-b5b6-b2b6c528be29"],

Cell[BoxData["False"], "Output",ExpressionUUID->"d7f296cc-37c7-3a43-8c07-569696eaac28"],

Cell["Source", "NotesSection",ExpressionUUID->"e9cabd65-792f-664c-a6d5-055b7eba614b"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/HypergraphPlot.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Default formatting",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"86e45415-0f59-b74e-a54c-2211dec12f17"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"c7d12cc5-f693-da4e-8c0a-24486c1a525f"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["HypergraphLargeQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "dd9d5955-fb74-044f-878c-7b831e60f988"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphPlot", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "10b0ae4c-4378-f84d-a1ed-3ec4d5a19797"],
 ", ",
 Cell[BoxData[
  StyleBox["Hypergraph", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "68422acf-d3ab-a241-a4c2-440b23f07cbc"]
}], "SeeAlso",ExpressionUUID->"4ec7edcf-26f7-a346-a38c-b54a2816c412"]
},
