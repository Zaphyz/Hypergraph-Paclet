(* Beginning of Notebook Content *)
Notebook[{
Cell["SetHypergraphPlotThresholds", "ObjectName",ExpressionUUID->"54756115-873b-b94b-8c16-b929705daff4"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"SetHypergraphPlotThresholds", "[", 
    RowBox[{
     RowBox[{"\"\<MaxVertices\>\"", " ", "->", " ", "n"}], ",", " ", "..."}], 
    "]"}], "InlineCode"]], "InlineFormula",ExpressionUUID->
  "1af60fd0-52c5-124b-a194-6bd1e89477fa"],
 " ",
 "sets the sizes beyond which a Hypergraph displays as a summary box rather \
than a plot."
}], "Usage",ExpressionUUID->"ab869f8d-8a16-824c-8ede-4b1e4bab08e5"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"775a4b1e-65a3-f84f-b108-237c6e95a010"],

Cell["\<\
The recognized keys are \"MaxVertices\", \"MaxEdges\" and \
\"MaxTotalElements\"; the defaults are 32, 128 and 196.\
\>", "Notes",ExpressionUUID->"ed485b20-9f73-924a-9a12-6b8de943a82b"],

Cell["\<\
Only the keys given are changed, and the new thresholds apply to every \
subsequent display.\
\>", "Notes",ExpressionUUID->"4564e033-9233-7040-a060-5a44366d5058"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"5c668e7b-f075-e24f-add8-aa75c202cbf2"],

Cell["\<\
Making the threshold small enough that a small hypergraph is summarized:\
\>", "ExampleText",ExpressionUUID->"abbe766e-3499-f040-9b50-02e6fc3d135f"],

Cell["\<\
SetHypergraphPlotThresholds[\"MaxVertices\" -> 2];
HypergraphLargeQ[Hypergraph[{{1, 2, 3}}]]\
\>", "Input",ExpressionUUID->"1f47d3f3-a2e3-ca4e-b4c3-f84052894e4f"],

Cell[BoxData["True"], "Output",ExpressionUUID->"5b75a1ba-54f7-fc41-9b1f-2b34d21b85f8"],

Cell["Putting it back:", "ExampleText",ExpressionUUID->"79ed8017-a0fb-4247-88e4-42b231b7f075"],

Cell["\<\
SetHypergraphPlotThresholds[\"MaxVertices\" -> 32];
HypergraphLargeQ[Hypergraph[{{1, 2, 3}}]]\
\>", "Input",ExpressionUUID->"4a4f56c0-f52d-104b-9a35-e531d186be7f"],

Cell[BoxData["False"], "Output",ExpressionUUID->"34df99b3-a183-0045-9a7a-b29f1bdf6384"],

Cell["Source", "NotesSection",ExpressionUUID->"cbcef7d4-fd0c-df44-8700-e81e7a6fb295"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/HypergraphPlot.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Default formatting",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"db4cbcf9-eb65-4141-9f21-d3944c7d8262"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"c17ad580-a495-8748-9156-fe2d3ab61749"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["HypergraphLargeQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "bee5dcb7-16f6-d549-a9ed-d046491fd966"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphPlot", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "8089057b-1935-2246-8ef1-954fc34f0262"],
 ", ",
 Cell[BoxData[
  StyleBox["Hypergraph", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "4237cc7f-b240-134c-a22d-f9512a1855d5"]
}], "SeeAlso",ExpressionUUID->"9d14c726-64a6-de4a-b8fa-310e8225f32f"]
},
WindowSize->{800, 750},
