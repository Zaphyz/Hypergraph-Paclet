(* Beginning of Notebook Content *)
Notebook[{
Cell["SetHypergraphPlotThresholds", "ObjectName",ExpressionUUID->"da3b9da9-dcc4-5c49-bdb4-aef20e65ae1c"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"SetHypergraphPlotThresholds", "[", 
    RowBox[{
     RowBox[{"\"\<MaxVertices\>\"", " ", "->", " ", "n"}], ",", " ", "..."}], 
    "]"}], "InlineCode"]], "InlineFormula",ExpressionUUID->
  "6f910f1f-23e4-394f-bf7e-75d6ec8cbc00"],
 " ",
 "sets the sizes beyond which a Hypergraph displays as a summary box rather \
than a plot."
}], "Usage",ExpressionUUID->"0af91226-bf70-4645-a0cf-d4ed9a1c333e"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"fea8a898-bb91-9c43-aebc-55abb698a047"],

Cell["\<\
The recognized keys are \"MaxVertices\", \"MaxEdges\" and \
\"MaxTotalElements\"; the defaults are 32, 128 and 196.\
\>", "Notes",ExpressionUUID->"84ce410d-fba8-b643-9439-fc489d091d83"],

Cell["\<\
Only the keys given are changed, and the new thresholds apply to every \
subsequent display.\
\>", "Notes",ExpressionUUID->"f46e1940-2fee-8d41-90f0-7a7a532d5983"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"4782f5f0-8691-8c45-a80b-c8a6fdcbd2d2"],

Cell["\<\
Making the threshold small enough that a small hypergraph is summarized:\
\>", "ExampleText",ExpressionUUID->"14e25c0d-ce86-464b-82ad-25550eb619f3"],

Cell["\<\
SetHypergraphPlotThresholds[\"MaxVertices\" -> 2];
HypergraphLargeQ[Hypergraph[{{1, 2, 3}}]]\
\>", "Input",ExpressionUUID->"b8054215-e556-054e-96b0-8b1018f2ad75"],

Cell[BoxData["True"], "Output",ExpressionUUID->"d6ce6070-31ad-dc49-838f-d2e27bd5c22c"],

Cell["Putting it back:", "ExampleText",ExpressionUUID->"4752e47c-741d-8443-afe3-a9a8c999cd38"],

Cell["\<\
SetHypergraphPlotThresholds[\"MaxVertices\" -> 32];
HypergraphLargeQ[Hypergraph[{{1, 2, 3}}]]\
\>", "Input",ExpressionUUID->"e79e4503-fcba-244a-962a-4215774ceb86"],

Cell[BoxData["False"], "Output",ExpressionUUID->"31b619a5-39b4-eb40-973f-5625bdb9f5ee"],

Cell["Source", "NotesSection",ExpressionUUID->"cef17d47-1e55-3b48-93fa-676cb8f12897"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/HypergraphPlot.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Default formatting",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"15d5dde0-d02b-d742-9c23-12ce9814d22a"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"f9d11fc3-8b9c-e940-b97e-d7d68f5d6c78"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["HypergraphLargeQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "69c18683-7a99-404e-8bc4-2512c2a66fcc"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphPlot", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "15d50e1e-1625-9640-92cc-2b92f685776b"],
 ", ",
 Cell[BoxData[
  StyleBox["Hypergraph", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "c525a27a-4c81-8b4f-9ddc-1d4ecc840023"]
}], "SeeAlso",ExpressionUUID->"62040249-85c6-6344-b03d-52f34dd6b3b1"]
},
