(* Beginning of Notebook Content *)
Notebook[{
Cell["SetHypergraphPlotThresholds", "ObjectName",ExpressionUUID->"5eecff99-bddb-0740-a6cc-e45a119621ca"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"SetHypergraphPlotThresholds", "[", 
    RowBox[{
     RowBox[{"\"\<MaxVertices\>\"", " ", "->", " ", "n"}], ",", " ", "..."}], 
    "]"}], "InlineCode"]], "InlineFormula",ExpressionUUID->
  "a2c1aeb7-d570-cd4b-8ab9-850fad683510"],
 " ",
 "sets the sizes beyond which a Hypergraph displays as a summary box rather \
than a plot."
}], "Usage",ExpressionUUID->"175dd892-30aa-194d-af2c-8b47a2dc22a3"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"b7f6d69f-125c-9c4b-b493-d6ac93b147d4"],

Cell["\<\
The recognized keys are \"MaxVertices\", \"MaxEdges\" and \
\"MaxTotalElements\"; the defaults are 32, 128 and 196.\
\>", "Notes",ExpressionUUID->"5f8380af-8075-8942-aca6-e1fc981fb9f3"],

Cell["\<\
Only the keys given are changed, and the new thresholds apply to every \
subsequent display.\
\>", "Notes",ExpressionUUID->"242a26f7-bc65-f042-a5ee-3bd021d9ff81"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"7fcd98c1-c0e4-7c40-8d51-f8c77d092b64"],

Cell["\<\
Making the threshold small enough that a small hypergraph is summarized:\
\>", "ExampleText",ExpressionUUID->"8d29c306-8326-454e-9370-78e5781e1538"],

Cell["\<\
SetHypergraphPlotThresholds[\"MaxVertices\" -> 2];
HypergraphLargeQ[Hypergraph[{{1, 2, 3}}]]\
\>", "Input",ExpressionUUID->"3fa4c5a2-1339-7c42-a540-8f695677c6c2"],

Cell[BoxData["True"], "Output",ExpressionUUID->"ffab2ac5-8588-b242-98c1-518cd1d3676f"],

Cell["Putting it back:", "ExampleText",ExpressionUUID->"c89223ac-0456-7744-ab5a-c256051328ec"],

Cell["\<\
SetHypergraphPlotThresholds[\"MaxVertices\" -> 32];
HypergraphLargeQ[Hypergraph[{{1, 2, 3}}]]\
\>", "Input",ExpressionUUID->"6d7ab28a-78c2-974c-972e-b3fbf823cedb"],

Cell[BoxData["False"], "Output",ExpressionUUID->"9a1854d9-51d5-1b49-a209-cf18c7bbe18f"],

Cell["Source", "NotesSection",ExpressionUUID->"b45e8a2f-de2b-5a42-9129-1592cb690617"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/HypergraphPlot.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Default formatting",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"90be1431-2b25-6745-96ed-77eeb1beda39"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"bd875baa-72b3-264a-bf44-3a62e4b7daa1"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["HypergraphLargeQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "a37b3c71-a339-4b46-adf9-0c42d3cbbf43"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphPlot", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "9f3bbf5f-2834-b946-bd9c-7548ddbfff28"],
 ", ",
 Cell[BoxData[
  StyleBox["Hypergraph", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "404a63dc-aa3a-7b42-80c3-b44e7dfcbfde"]
}], "SeeAlso",ExpressionUUID->"d131ea0e-c20c-4c46-a683-74d5a969c273"]
},
WindowSize->{800, 750},
