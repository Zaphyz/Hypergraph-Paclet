(* Beginning of Notebook Content *)
Notebook[{
Cell["SetHypergraphPlotThresholds", "ObjectName",ExpressionUUID->"d8703b5d-e50b-0145-8e2f-5e7519398b2f"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"SetHypergraphPlotThresholds", "[", 
    RowBox[{
     RowBox[{"\"\<MaxVertices\>\"", " ", "->", " ", "n"}], ",", " ", "..."}], 
    "]"}], "InlineCode"]], "InlineFormula",ExpressionUUID->
  "d535e989-b7d5-6a49-be79-babc018add43"],
 " ",
 "sets the sizes beyond which a Hypergraph displays as a summary box rather \
than a plot."
}], "Usage",ExpressionUUID->"f6212303-54e6-2549-a739-684cf7225673"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"05fa8fa8-905d-d547-9b09-48649eec66b9"],

Cell["\<\
The recognized keys are \"MaxVertices\", \"MaxEdges\" and \
\"MaxTotalElements\"; the defaults are 32, 128 and 196.\
\>", "Notes",ExpressionUUID->"a33f88cc-dc8d-4341-9474-a26cbc8bf6a9"],

Cell["\<\
Only the keys given are changed, and the new thresholds apply to every \
subsequent display.\
\>", "Notes",ExpressionUUID->"268b21f4-62c9-6840-abaf-1605537abd29"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"df13894f-fffb-434f-b600-562637123fa4"],

Cell["\<\
Making the threshold small enough that a small hypergraph is summarized:\
\>", "ExampleText",ExpressionUUID->"77353807-d680-8149-a35a-73d577507f48"],

Cell["\<\
SetHypergraphPlotThresholds[\"MaxVertices\" -> 2];
HypergraphLargeQ[Hypergraph[{{1, 2, 3}}]]\
\>", "Input",ExpressionUUID->"89bbb0c7-89c2-eb4f-8023-6f59f00c76da"],

Cell[BoxData["True"], "Output",ExpressionUUID->"d693b3d1-0b79-3c4c-9915-654317ba1e8c"],

Cell["Putting it back:", "ExampleText",ExpressionUUID->"d23e8eda-bd9b-7243-a083-250c15e5c8c7"],

Cell["\<\
SetHypergraphPlotThresholds[\"MaxVertices\" -> 32];
HypergraphLargeQ[Hypergraph[{{1, 2, 3}}]]\
\>", "Input",ExpressionUUID->"d1e8f06c-918d-5e47-a23a-9f9686d38a7f"],

Cell[BoxData["False"], "Output",ExpressionUUID->"a994b209-785b-7b48-8627-08c7616a034e"],

Cell["Source", "NotesSection",ExpressionUUID->"1a1f5c89-5c2e-d14c-861c-193f9fdf8fdf"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/HypergraphPlot.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Default formatting",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"dc0231aa-2442-0948-a660-acfade4dd84f"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"5559bce4-bbe8-a647-9c73-3b20fcbb8e21"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["HypergraphLargeQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "f5274298-5a61-9942-987c-16ac3f129aa0"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphPlot", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "1d161a40-d424-be46-ac9e-71a8f4acc860"],
 ", ",
 Cell[BoxData[
  StyleBox["Hypergraph", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "ac8690f7-449e-a543-9e14-38e91eb18fa9"]
}], "SeeAlso",ExpressionUUID->"267f3743-8694-104d-81d4-b37c9141b804"]
},
