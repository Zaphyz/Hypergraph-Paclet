(* Beginning of Notebook Content *)
Notebook[{
Cell["SetHypergraphPlotThresholds", "ObjectName",ExpressionUUID->"99146e0e-06c0-1b41-bb84-ade2def13c33"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"SetHypergraphPlotThresholds", "[", 
    RowBox[{
     RowBox[{"\"\<MaxVertices\>\"", " ", "->", " ", "n"}], ",", " ", "..."}], 
    "]"}], "InlineCode"]], "InlineFormula",ExpressionUUID->
  "2e99bfba-4231-9d4f-8040-8040fa51760d"],
 " ",
 "sets the sizes beyond which a Hypergraph displays as a summary box rather \
than a plot."
}], "Usage",ExpressionUUID->"32cd11a3-4343-834f-9cf8-acc2c5e8031c"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"db9d032d-b90f-d843-b8fe-ac574cb4e0a9"],

Cell["\<\
The recognized keys are \"MaxVertices\", \"MaxEdges\" and \
\"MaxTotalElements\"; the defaults are 32, 128 and 196.\
\>", "Notes",ExpressionUUID->"3c8b5ae8-51d1-1e41-85f2-9c557003c6ec"],

Cell["\<\
Only the keys given are changed, and the new thresholds apply to every \
subsequent display.\
\>", "Notes",ExpressionUUID->"4d909000-f914-9541-be5c-aec0b0bffd40"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"cb181691-85c8-a043-9825-ea91c7c5434e"],

Cell["\<\
Making the threshold small enough that a small hypergraph is summarized:\
\>", "ExampleText",ExpressionUUID->"25913507-9c4a-6741-a70a-1ef203a3909c"],

Cell["\<\
SetHypergraphPlotThresholds[\"MaxVertices\" -> 2];
HypergraphLargeQ[Hypergraph[{{1, 2, 3}}]]\
\>", "Input",ExpressionUUID->"cef9f239-59e0-dd41-8855-0d0b9f7dbe58"],

Cell[BoxData["True"], "Output",ExpressionUUID->"df132459-3dc2-144d-bace-ff9ea338ccca"],

Cell["Putting it back:", "ExampleText",ExpressionUUID->"94e73ce5-1b23-c84e-a05b-e063b141786f"],

Cell["\<\
SetHypergraphPlotThresholds[\"MaxVertices\" -> 32];
HypergraphLargeQ[Hypergraph[{{1, 2, 3}}]]\
\>", "Input",ExpressionUUID->"d6486d41-dce1-8345-925a-1a7cf17a5da5"],

Cell[BoxData["False"], "Output",ExpressionUUID->"9c1f3c26-d977-064f-b9c4-383bc70bf84f"],

Cell["Source", "NotesSection",ExpressionUUID->"5ba6ae26-40a9-ce46-883d-7c7d768b595a"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/HypergraphPlot.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Default formatting",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"a12dee6b-dd57-6345-9ccf-1b70453f5759"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"6447b323-9937-9648-9e2c-88183df19cca"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["HypergraphLargeQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "a86d36f1-aa45-414e-9902-393a972fc71d"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphPlot", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "cb229f38-81a6-bf4b-8d01-d874799c8853"],
 ", ",
 Cell[BoxData[
  StyleBox["Hypergraph", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "e2c1a056-08e5-c941-9c7a-e0a9ab6fa4c5"]
}], "SeeAlso",ExpressionUUID->"3e382c7a-a888-f946-9a86-2b3d685aca6d"]
},
