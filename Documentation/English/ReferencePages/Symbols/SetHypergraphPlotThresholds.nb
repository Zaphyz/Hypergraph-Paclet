(* Beginning of Notebook Content *)
Notebook[{
Cell["SetHypergraphPlotThresholds", "ObjectName",ExpressionUUID->"bcbdd83a-e638-bb42-aa0c-9c272477d696"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"SetHypergraphPlotThresholds", "[", 
    RowBox[{
     RowBox[{"\"\<MaxVertices\>\"", " ", "->", " ", "n"}], ",", " ", "..."}], 
    "]"}], "InlineCode"]], "InlineFormula",ExpressionUUID->
  "c8b38931-71c9-1044-bf2c-1f82fe6255f1"],
 " ",
 "sets the sizes beyond which a Hypergraph displays as a summary box rather \
than a plot."
}], "Usage",ExpressionUUID->"c052adf7-c288-c34b-a055-484b394f1d5f"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"6eae119c-f233-4b49-ac51-7a4edd5c5aaf"],

Cell["\<\
The recognized keys are \"MaxVertices\", \"MaxEdges\" and \
\"MaxTotalElements\"; the defaults are 32, 128 and 196.\
\>", "Notes",ExpressionUUID->"28d05eba-c1ac-6d42-94f0-a57be0328ad6"],

Cell["\<\
Only the keys given are changed, and the new thresholds apply to every \
subsequent display.\
\>", "Notes",ExpressionUUID->"ff4c8bfa-0db9-1441-b123-311ed228a438"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"811274e3-aefb-1644-8430-e00de21fa00e"],

Cell["\<\
Making the threshold small enough that a small hypergraph is summarized:\
\>", "ExampleText",ExpressionUUID->"b1960541-d81c-1b4a-bc89-bdc1d475d5c4"],

Cell["\<\
SetHypergraphPlotThresholds[\"MaxVertices\" -> 2];
HypergraphLargeQ[Hypergraph[{{1, 2, 3}}]]\
\>", "Input",ExpressionUUID->"a4220c3b-e872-af4b-af90-83d30d0370fb"],

Cell[BoxData["True"], "Output",ExpressionUUID->"8673bf57-3227-d34f-8c4a-4bb8ac1cc3b1"],

Cell["Putting it back:", "ExampleText",ExpressionUUID->"69b5e276-45d0-d543-a90d-17bf5e075da1"],

Cell["\<\
SetHypergraphPlotThresholds[\"MaxVertices\" -> 32];
HypergraphLargeQ[Hypergraph[{{1, 2, 3}}]]\
\>", "Input",ExpressionUUID->"456f8569-37f6-7e46-9fee-d53ff4f2209d"],

Cell[BoxData["False"], "Output",ExpressionUUID->"c97c6abf-5131-a848-b4f5-792634addfef"],

Cell["Source", "NotesSection",ExpressionUUID->"11b20aa7-cd40-2c47-b7bc-9e721f131977"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/HypergraphPlot.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Default formatting",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"c7988c77-a49e-cc4e-bbd4-5df263300f32"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"a96121d8-bad8-fe40-ae44-4d76c9720f63"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["HypergraphLargeQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "17312f25-aa38-ef43-bc45-ded7a9c59f9e"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphPlot", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "7997741f-4a9e-0247-9b1a-45eeba0be75d"],
 ", ",
 Cell[BoxData[
  StyleBox["Hypergraph", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "e5a99ec1-20c0-f848-974f-955a9081c63f"]
}], "SeeAlso",ExpressionUUID->"0c8269ed-7d97-dd46-b92c-59a67f831f43"]
},
