(* Beginning of Notebook Content *)
Notebook[{
Cell["SetHypergraphPlotThresholds", "ObjectName",ExpressionUUID->"a7661841-1c37-914f-a018-2cba1cdb6950"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"SetHypergraphPlotThresholds", "[", 
    RowBox[{
     RowBox[{"\"\<MaxVertices\>\"", " ", "->", " ", "n"}], ",", " ", "..."}], 
    "]"}], "InlineCode"]], "InlineFormula",ExpressionUUID->
  "788d9870-3ae9-eb4e-a44f-de67ada601da"],
 " ",
 "sets the sizes beyond which a Hypergraph displays as a summary box rather \
than a plot."
}], "Usage",ExpressionUUID->"8a89d792-8b0b-f74e-97c7-f294fb208b05"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"c67608a3-0584-a244-91b6-6f0050d2254b"],

Cell["\<\
The recognized keys are \"MaxVertices\", \"MaxEdges\" and \
\"MaxTotalElements\"; the defaults are 32, 128 and 196.\
\>", "Notes",ExpressionUUID->"e5b92042-a4c4-2e4f-a709-a8c3a6f145ed"],

Cell["\<\
Only the keys given are changed, and the new thresholds apply to every \
subsequent display.\
\>", "Notes",ExpressionUUID->"25762069-f4a3-8740-a659-0b4ce4b576e3"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"121adcf1-2da8-3641-a32c-d78719228b6b"],

Cell["\<\
Making the threshold small enough that a small hypergraph is summarized:\
\>", "ExampleText",ExpressionUUID->"8a47dbf6-ddad-3a4d-8b70-d7ffa098dd6d"],

Cell["\<\
SetHypergraphPlotThresholds[\"MaxVertices\" -> 2];
HypergraphLargeQ[Hypergraph[{{1, 2, 3}}]]\
\>", "Input",ExpressionUUID->"33bbbe4d-bffd-b049-8f7b-83f7fda3921a"],

Cell[BoxData["True"], "Output",ExpressionUUID->"46a5778d-4387-524a-bfba-d925adf2276f"],

Cell["Putting it back:", "ExampleText",ExpressionUUID->"bffa1fbf-4bfa-724d-83d5-9e65581df665"],

Cell["\<\
SetHypergraphPlotThresholds[\"MaxVertices\" -> 32];
HypergraphLargeQ[Hypergraph[{{1, 2, 3}}]]\
\>", "Input",ExpressionUUID->"a30eb0e6-c60c-3a46-8501-7724213e2942"],

Cell[BoxData["False"], "Output",ExpressionUUID->"90f11642-65e5-e045-b954-5f94e24b3ed2"],

Cell["Source", "NotesSection",ExpressionUUID->"6f5f97af-75dd-a948-9de5-ca8dbe6bce96"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/HypergraphPlot.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Default formatting",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"3538f1c1-9121-874d-9806-8998b5aa2d4e"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"2f46e7da-4c1b-7f4f-b843-53553dfd1680"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["HypergraphLargeQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "57f8f9cf-e2c1-924c-885e-d88e8f8d054e"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphPlot", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "48f4cebc-a85d-1d48-95cf-3714286f97ca"],
 ", ",
 Cell[BoxData[
  StyleBox["Hypergraph", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "be4272c4-c7d6-e14f-91b5-c79e46228bf8"]
}], "SeeAlso",ExpressionUUID->"7b6d5cd9-a48a-1746-a341-46271ba55980"]
},
