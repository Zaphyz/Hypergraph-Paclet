(* Beginning of Notebook Content *)
Notebook[{
Cell["SimpleHypergraphQ", "ObjectName",ExpressionUUID->"df9888f4-b704-474e-bd08-723fcf582568"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"SimpleHypergraphQ", "[", "hg", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"c8a07ac1-c3ca-654c-9233-a916090a708e"],
 " ",
 "gives True if no edge of hg is repeated, and False otherwise."
}], "Usage",ExpressionUUID->"1fd16350-b52d-a14c-b4e0-0e3ea67845b8"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"5bbc058a-cf1c-f74b-9392-5f348fb1309e"],

Cell["\<\
Labels are set aside for the test. Two edges differing only by a label are \
the same edge of the same skeleton, and so make the hypergraph not simple; \
the test is DuplicateFreeQ on the edges of HypergraphSkeleton[hg].\
\>", "Notes",ExpressionUUID->"a05b37a5-3005-9143-b951-6aaceda16233"],

Cell["\<\
A vertex repeated within a single edge is allowed. That is a property of one \
edge rather than a collision between two, and it obstructs nothing.\
\>", "Notes",ExpressionUUID->"46660360-16f6-8e4d-8ef6-c2cf50ee2625"],

Cell["\<\
Edges are stored with their vertices in the canonical order of their symmetry \
type, so two spellings of one unordered or cyclic edge are one edge, and a \
hypergraph holding both is not simple. Two directed edges that reverse each \
other are genuinely two edges, and it is.\
\>", "Notes",ExpressionUUID->"3feb1852-e41b-b943-b0a4-a9c85dd50a7d"],

Cell[TextData[{
 "Simplicity is what ",
 Cell[BoxData[
  StyleBox["AdjacencyHypermatrix", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"1a9d142b-86d1-0f45-a7f9-abbdf43c7e28"],
 " needs before it will put labels in the entries of a hypermatrix: one entry \
cannot hold two labels."
}], "Notes",ExpressionUUID->"315580e9-0bb7-f54e-81ec-42d275d09fb7"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"3a603f43-5876-4b4d-b595-7f3fe7727cc0"],

Cell["\<\
{SimpleHypergraphQ @ Hypergraph[{Edge[{1, 2}], Edge[{2, 3}]}],
 SimpleHypergraphQ @ Hypergraph[{Edge[{1, 2}], Edge[{1, 2}]}]}\
\>", "Input",ExpressionUUID->"952e52e9-3455-af4b-9e85-adb1acc547dc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",ExpressionUUID->"17f32955-\
17ef-2d4d-9095-6c362adf7856"],

Cell["Labels do not make two edges different:", "ExampleText",ExpressionUUID->"b1be646a-98dd-084f-b1c9-b9ee53e45d00"],

Cell["\<\
SimpleHypergraphQ @ Hypergraph[{Edge[{1, 2}, \"Directed\", \"a\"],
                                Edge[{1, 2}, \"Directed\", \"b\"]}]\
\>", "Input",ExpressionUUID->"f277330c-a6f0-e345-b491-3a3031e5e594"],

Cell[BoxData["False"], "Output",ExpressionUUID->"5f567a67-2c9d-f742-b3a7-fb35e8378a49"],

Cell["\<\
Two spellings of one unordered edge are one edge; two opposite directed edges \
are two:\
\>", "ExampleText",ExpressionUUID->"c27f4ae2-db44-d040-94a3-f4de0f548fa4"],

Cell["\<\
{SimpleHypergraphQ @ Hypergraph[{Edge[{1, 2}, \"Unordered\"], Edge[{2, 1}, \
\"Unordered\"]}],
 SimpleHypergraphQ @ Hypergraph[{Edge[{1, 2}, \"Directed\"], Edge[{2, 1}, \
\"Directed\"]}]}\
\>", "Input",ExpressionUUID->"3ae4edf1-6483-254b-a311-7347827f58f3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "True"}], "}"}]], "Output",ExpressionUUID->"780e3e53-\
0b10-0a42-aa26-b12f791d9c14"],

Cell["A vertex repeated inside an edge is no obstacle:", "ExampleText",ExpressionUUID->"9fa38135-b1b7-3241-bdfb-5e9c7f49d24b"],

Cell["\<\
SimpleHypergraphQ @ Hypergraph[{Edge[{1, 1, 2}, \"Unordered\"]}]\
\>", "Input",ExpressionUUID->"4353d9d0-5004-8747-8faa-18ebc7948f68"],

Cell[BoxData["True"], "Output",ExpressionUUID->"5363ec91-e7f0-3d4e-b40e-8a9cf293830e"],

Cell["Source", "NotesSection",ExpressionUUID->"fdffc7a8-9b14-ac43-b38d-020a617ccdb6"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Hypergraphs",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"029abc7d-05e5-d841-af6d-7c750d92e5b8"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"8254146c-bcfe-9144-8139-9a5f648176aa"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["HypergraphSkeleton", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"d656eda3-fd68-eb4f-9dc8-c69e5c3d24ec"],
 ", ",
 Cell[BoxData[
  StyleBox["AdjacencyHypermatrix", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"0b64bfb6-f669-f04b-81c2-70eb67111656"],
 ", ",
 Cell[BoxData[
  StyleBox["Hypergraph", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "8f52d6cf-2514-784e-a35f-9199c6d94172"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeList", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "aeabd302-25ea-5646-ad24-d646f084b43a"]
}], "SeeAlso",ExpressionUUID->"6204211f-927e-c741-9222-e6f164586117"]
},
WindowSize->{800, 750},
FrontEndVersion->"15.0 for Microsoft Windows (64-bit) (July 2, 2026)",
StyleDefinitions->"Reference.nb",
ExpressionUUID->"911e7e89-6ae1-cc45-bec1-b355f4c8024d"
]
