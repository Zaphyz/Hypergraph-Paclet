(* Beginning of Notebook Content *)
Notebook[{
Cell["SimpleHypergraphQ", "ObjectName",ExpressionUUID->"79850e30-b191-cd41-9dc0-e5537b547ff5"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"SimpleHypergraphQ", "[", "hg", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"356209a5-3304-f84a-ae9e-91f0eeb256e2"],
 " ",
 "gives True if no edge of hg is repeated, and False otherwise."
}], "Usage",ExpressionUUID->"a603a1e5-4dfa-db41-938d-cd307c24bb39"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"17005d69-3f81-cb4f-9328-45d61099b3d5"],

Cell["\<\
Labels are set aside for the test. Two edges differing only by a label are \
the same edge of the same skeleton, and so make the hypergraph not simple; \
the test is DuplicateFreeQ on the edges of HypergraphSkeleton[hg].\
\>", "Notes",ExpressionUUID->"74dd1611-5583-f649-b83a-2a3edd5e85d3"],

Cell["\<\
A vertex repeated within a single edge is allowed. That is a property of one \
edge rather than a collision between two, and it obstructs nothing.\
\>", "Notes",ExpressionUUID->"b8b377f5-0016-154c-a4d2-4f0a14d054fa"],

Cell["\<\
Edges are stored with their vertices in the canonical order of their symmetry \
type, so two spellings of one unordered or cyclic edge are one edge, and a \
hypergraph holding both is not simple. Two directed edges that reverse each \
other are genuinely two edges, and it is.\
\>", "Notes",ExpressionUUID->"1cc0e0c2-d169-2748-b432-a71cee8c02cc"],

Cell[TextData[{
 "Simplicity is what ",
 Cell[BoxData[
  StyleBox["AdjacencyHypermatrix", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"8af14ee4-5412-9542-af1f-98d9e54d1ee3"],
 " needs before it will put labels in the entries of a hypermatrix: one entry \
cannot hold two labels."
}], "Notes",ExpressionUUID->"0776d8a0-ed8d-924f-94cb-b47ce612c654"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"cc64c304-8520-d048-935d-b5cd2fb549bf"],

Cell["\<\
{SimpleHypergraphQ @ Hypergraph[{Edge[{1, 2}], Edge[{2, 3}]}],
 SimpleHypergraphQ @ Hypergraph[{Edge[{1, 2}], Edge[{1, 2}]}]}\
\>", "Input",ExpressionUUID->"eeb47c1a-08d7-1141-b75f-35a53e26c359"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",ExpressionUUID->"adff936a-\
e560-a949-9217-1b75c751b8fc"],

Cell["Labels do not make two edges different:", "ExampleText",ExpressionUUID->"9a133868-00a2-514c-aaa4-94563bbdd67c"],

Cell["\<\
SimpleHypergraphQ @ Hypergraph[{Edge[{1, 2}, \"Directed\", \"a\"],
                                Edge[{1, 2}, \"Directed\", \"b\"]}]\
\>", "Input",ExpressionUUID->"73bf4f21-e750-354c-ba05-2635c3812deb"],

Cell[BoxData["False"], "Output",ExpressionUUID->"9821d9f5-0d51-764f-9e0c-a568aa5cf2d4"],

Cell["\<\
Two spellings of one unordered edge are one edge; two opposite directed edges \
are two:\
\>", "ExampleText",ExpressionUUID->"94d14225-07b4-a34b-a050-6fe78708a9bf"],

Cell["\<\
{SimpleHypergraphQ @ Hypergraph[{Edge[{1, 2}, \"Unordered\"], Edge[{2, 1}, \
\"Unordered\"]}],
 SimpleHypergraphQ @ Hypergraph[{Edge[{1, 2}, \"Directed\"], Edge[{2, 1}, \
\"Directed\"]}]}\
\>", "Input",ExpressionUUID->"91e51db8-61de-9c41-b83c-a484a051c6eb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "True"}], "}"}]], "Output",ExpressionUUID->"139cba9a-\
368d-5b45-81ae-2dc8bae4928c"],

Cell["A vertex repeated inside an edge is no obstacle:", "ExampleText",ExpressionUUID->"62dfaa79-c542-8640-bfc0-b5bfacdd3b89"],

Cell["\<\
SimpleHypergraphQ @ Hypergraph[{Edge[{1, 1, 2}, \"Unordered\"]}]\
\>", "Input",ExpressionUUID->"52d9f419-9b5e-004b-8698-b15f437bdfba"],

Cell[BoxData["True"], "Output",ExpressionUUID->"6d7a4fcb-eb26-7441-9904-1fd0eba02718"],

Cell["Source", "NotesSection",ExpressionUUID->"58bef8d3-0d3f-1241-b98b-94b289f6064a"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Hypergraphs",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"0c992120-8e38-bc45-aa30-e2e42b0fe23b"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"52f7e20b-35c5-1d47-8294-7580926c6fb4"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["HypergraphSkeleton", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"b2a458d2-31ae-f642-9709-f65d61e1c67b"],
 ", ",
 Cell[BoxData[
  StyleBox["AdjacencyHypermatrix", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"f6bcd179-250e-294d-8df1-f6ce825bd54d"],
 ", ",
 Cell[BoxData[
  StyleBox["Hypergraph", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "46644d4f-a1eb-184f-834d-731d88ef5e8b"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeList", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "225a894b-57ec-194b-ba86-706eadff43c0"]
}], "SeeAlso",ExpressionUUID->"4bd28704-24f1-c540-bbd4-1e52f971d9a6"]
},
WindowSize->{800, 750},
FrontEndVersion->"15.0 for Microsoft Windows (64-bit) (July 2, 2026)",
