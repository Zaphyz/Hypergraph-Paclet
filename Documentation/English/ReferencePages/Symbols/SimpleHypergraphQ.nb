(* Beginning of Notebook Content *)
Notebook[{
Cell["SimpleHypergraphQ", "ObjectName",ExpressionUUID->"4bc762e2-6a28-264d-927b-dbbecb62fb96"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"SimpleHypergraphQ", "[", "hg", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"bddc921c-1478-8748-b020-e3b44ae2d9fe"],
 " ",
 "gives True if no edge of hg is repeated, and False otherwise."
}], "Usage",ExpressionUUID->"faf3630d-6a70-db47-8e73-305115c1d8ae"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"46e345e1-e269-d949-a053-c69beca9d46e"],

Cell["\<\
Labels are set aside for the test. Two edges differing only by a label are \
the same edge of the same skeleton, and so make the hypergraph not simple; \
the test is DuplicateFreeQ on the edges of HypergraphSkeleton[hg].\
\>", "Notes",ExpressionUUID->"23b9f84a-e59f-b544-bc9c-4344168ee6ff"],

Cell["\<\
A vertex repeated within a single edge is allowed. That is a property of one \
edge rather than a collision between two, and it obstructs nothing.\
\>", "Notes",ExpressionUUID->"5b825b3a-b43b-d146-ae30-c3d88e846735"],

Cell["\<\
Edges are stored with their vertices in the canonical order of their symmetry \
type, so two spellings of one unordered or cyclic edge are one edge, and a \
hypergraph holding both is not simple. Two directed edges that reverse each \
other are genuinely two edges, and it is.\
\>", "Notes",ExpressionUUID->"7d030a73-2ea8-c041-b498-2f89ed15a409"],

Cell[TextData[{
 "Simplicity is what ",
 Cell[BoxData[
  StyleBox["AdjacencyHypermatrix", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"b00056af-47be-7e4b-803b-59ca09c185cb"],
 " needs before it will put labels in the entries of a hypermatrix: one entry \
cannot hold two labels."
}], "Notes",ExpressionUUID->"3a311842-7238-784b-a67d-4e528fae593b"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"53e81b0c-352c-2049-8c9a-df5abebd4cc6"],

Cell["\<\
{SimpleHypergraphQ @ Hypergraph[{Edge[{1, 2}], Edge[{2, 3}]}],
 SimpleHypergraphQ @ Hypergraph[{Edge[{1, 2}], Edge[{1, 2}]}]}\
\>", "Input",ExpressionUUID->"05f3e1a0-3ace-2948-afe0-389255b906e8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",ExpressionUUID->"c1b6fce5-\
3ce6-f94c-a00d-205b4e2016bd"],

Cell["Labels do not make two edges different:", "ExampleText",ExpressionUUID->"77bf6728-c7c7-cc4f-8d9c-15a36fb5212d"],

Cell["\<\
SimpleHypergraphQ @ Hypergraph[{Edge[{1, 2}, \"Directed\", \"a\"],
                                Edge[{1, 2}, \"Directed\", \"b\"]}]\
\>", "Input",ExpressionUUID->"2fe85c6d-0054-0b42-b3f9-4f7636be94f6"],

Cell[BoxData["False"], "Output",ExpressionUUID->"5b5240ee-4087-8c45-9c46-dd23e212819b"],

Cell["\<\
Two spellings of one unordered edge are one edge; two opposite directed edges \
are two:\
\>", "ExampleText",ExpressionUUID->"c0dbff0f-0456-d94b-b1e2-eabff2aff1e3"],

Cell["\<\
{SimpleHypergraphQ @ Hypergraph[{Edge[{1, 2}, \"Unordered\"], Edge[{2, 1}, \
\"Unordered\"]}],
 SimpleHypergraphQ @ Hypergraph[{Edge[{1, 2}, \"Directed\"], Edge[{2, 1}, \
\"Directed\"]}]}\
\>", "Input",ExpressionUUID->"4a7fc475-722d-a34e-9d90-cc99cbc6a4be"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "True"}], "}"}]], "Output",ExpressionUUID->"82190d15-\
a471-0247-8f01-678338895b42"],

Cell["A vertex repeated inside an edge is no obstacle:", "ExampleText",ExpressionUUID->"f090dc55-568d-674d-9662-caa55be35b6a"],

Cell["\<\
SimpleHypergraphQ @ Hypergraph[{Edge[{1, 1, 2}, \"Unordered\"]}]\
\>", "Input",ExpressionUUID->"27d3575c-b75a-d345-bba8-6d3eb62aff46"],

Cell[BoxData["True"], "Output",ExpressionUUID->"ab5bea18-ca4c-6f43-9024-e339bcf1513c"],

Cell["Source", "NotesSection",ExpressionUUID->"4fa96e50-c6a5-e642-8cfc-7f0f0316a60f"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Hypergraphs",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"298c67f9-f88f-af4c-81d5-66c0d40ed213"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"a516ecbd-0b37-ad44-9df9-c6bc7142ace9"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["HypergraphSkeleton", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"fcce5cc0-7fa3-754c-b90a-be8ef67ca8bd"],
 ", ",
 Cell[BoxData[
  StyleBox["AdjacencyHypermatrix", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"154994c8-beaa-7944-8d2c-d7f7ab3c8d0b"],
 ", ",
 Cell[BoxData[
  StyleBox["Hypergraph", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "7afa46c4-c9d8-e74d-8435-cf263aecff1b"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeList", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "c1740386-eb46-c04c-91ed-295212a8fcc4"]
}], "SeeAlso",ExpressionUUID->"86e1b514-9094-8c4b-a3ef-6628ca3d9ae9"]
},
WindowSize->{800, 750},
FrontEndVersion->"15.0 for Microsoft Windows (64-bit) (July 2, 2026)",
