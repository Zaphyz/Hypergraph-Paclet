(* Beginning of Notebook Content *)
Notebook[{
Cell["SimpleHypergraphQ", "ObjectName",ExpressionUUID->"c2aea6ce-f83c-8c41-9c77-d41145461356"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"SimpleHypergraphQ", "[", "hg", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"dcdc0057-a6f8-5f45-b9af-a381714e777b"],
 " ",
 "gives True if no edge of hg is repeated, and False otherwise."
}], "Usage",ExpressionUUID->"95330182-71b0-ad44-8ec7-a513085ec5c1"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"b21bd960-d36c-4042-b0ae-b589422927b5"],

Cell["\<\
Labels are set aside for the test. Two edges differing only by a label are \
the same edge of the same skeleton, and so make the hypergraph not simple; \
the test is DuplicateFreeQ on the edges of HypergraphSkeleton[hg].\
\>", "Notes",ExpressionUUID->"b5322976-7cb6-9641-bb89-9a32bfa96038"],

Cell["\<\
A vertex repeated within a single edge is allowed. That is a property of one \
edge rather than a collision between two, and it obstructs nothing.\
\>", "Notes",ExpressionUUID->"f508a654-9668-814d-9a97-53e43b0f92c7"],

Cell["\<\
Edges are stored with their vertices in the canonical order of their symmetry \
type, so two spellings of one unordered or cyclic edge are one edge, and a \
hypergraph holding both is not simple. Two directed edges that reverse each \
other are genuinely two edges, and it is.\
\>", "Notes",ExpressionUUID->"4fa32d0c-b643-564c-baac-4dc2a64a102a"],

Cell[TextData[{
 "Simplicity is what ",
 Cell[BoxData[
  StyleBox["AdjacencyHypermatrix", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"1e946eae-fc14-1e47-b394-2fc22024dace"],
 " needs before it will put labels in the entries of a hypermatrix: one entry \
cannot hold two labels."
}], "Notes",ExpressionUUID->"956653da-7b76-2745-9979-21f5307fbe31"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"7161fa15-629b-604b-8e5c-d9598a3cb7ab"],

Cell["\<\
{SimpleHypergraphQ @ Hypergraph[{Edge[{1, 2}], Edge[{2, 3}]}],
 SimpleHypergraphQ @ Hypergraph[{Edge[{1, 2}], Edge[{1, 2}]}]}\
\>", "Input",ExpressionUUID->"4e66216a-3d67-ee4b-8dca-bae5eb484152"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",ExpressionUUID->"a833570f-\
055e-254b-b271-e00f70960733"],

Cell["Labels do not make two edges different:", "ExampleText",ExpressionUUID->"af961c80-421d-484b-88c2-76671ab86848"],

Cell["\<\
SimpleHypergraphQ @ Hypergraph[{Edge[{1, 2}, \"Directed\", \"a\"],
                                Edge[{1, 2}, \"Directed\", \"b\"]}]\
\>", "Input",ExpressionUUID->"b525dcf8-faaa-744b-8503-c95fc89e5eab"],

Cell[BoxData["False"], "Output",ExpressionUUID->"6d4768ab-f670-5947-9c88-43baaace5f76"],

Cell["\<\
Two spellings of one unordered edge are one edge; two opposite directed edges \
are two:\
\>", "ExampleText",ExpressionUUID->"c469f5f1-eb3f-fc4e-99b7-609c7afbce36"],

Cell["\<\
{SimpleHypergraphQ @ Hypergraph[{Edge[{1, 2}, \"Unordered\"], Edge[{2, 1}, \
\"Unordered\"]}],
 SimpleHypergraphQ @ Hypergraph[{Edge[{1, 2}, \"Directed\"], Edge[{2, 1}, \
\"Directed\"]}]}\
\>", "Input",ExpressionUUID->"4455fa09-7d6b-0448-b8c7-488d415429e0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "True"}], "}"}]], "Output",ExpressionUUID->"509fb21d-\
42cc-b844-9d33-fb41c194dcfe"],

Cell["A vertex repeated inside an edge is no obstacle:", "ExampleText",ExpressionUUID->"bdc88ed0-f697-bb49-ac37-08ef7db73f55"],

Cell["\<\
SimpleHypergraphQ @ Hypergraph[{Edge[{1, 1, 2}, \"Unordered\"]}]\
\>", "Input",ExpressionUUID->"eaa8adf7-1eb2-d34e-bd11-d2ff048f2d3a"],

Cell[BoxData["True"], "Output",ExpressionUUID->"95be276a-352e-414f-a30a-71b73a6e36de"],

Cell["Source", "NotesSection",ExpressionUUID->"0b73f0d3-cc87-054f-94af-7a2f301dbcf1"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Hypergraphs",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"4dcb13fb-2dea-6646-980c-6d5573b1404d"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"07e3c5ff-3c03-714c-9d26-a2ebcf1fa949"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["HypergraphSkeleton", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"b469b968-7807-0745-b6c0-c729d8645ec1"],
 ", ",
 Cell[BoxData[
  StyleBox["AdjacencyHypermatrix", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"7156e836-d705-704a-a832-553a85478663"],
 ", ",
 Cell[BoxData[
  StyleBox["Hypergraph", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "2dcc50eb-390a-6144-92fb-c8c78ba8a7e3"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeList", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "df30d0ce-8798-b942-9235-b4d1fcdf94f2"]
}], "SeeAlso",ExpressionUUID->"41853fb9-2185-8b43-bf73-5379edf5547f"]
},
WindowSize->{800, 750},
FrontEndVersion->"15.0 for Microsoft Windows (64-bit) (July 2, 2026)",
