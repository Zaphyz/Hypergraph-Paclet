(* Beginning of Notebook Content *)
Notebook[{
Cell["SimpleHypergraphQ", "ObjectName",ExpressionUUID->"b0fc1647-b1ed-cb46-aaf2-651331ec2a2c"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"SimpleHypergraphQ", "[", "hg", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"97ae540d-eadd-6b4f-86e9-8edffde026b1"],
 " ",
 "gives True if no edge of hg is repeated, and False otherwise."
}], "Usage",ExpressionUUID->"e8d30b32-c88c-f04d-88cc-953551bc8ac7"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"46302293-432f-6c4a-93dd-14dff096c5c9"],

Cell["\<\
Labels are set aside for the test. Two edges differing only by a label are \
the same edge of the same skeleton, and so make the hypergraph not simple; \
the test is DuplicateFreeQ on the edges of HypergraphSkeleton[hg].\
\>", "Notes",ExpressionUUID->"e259956d-7568-9d4a-a906-e5eba83a6d1b"],

Cell["\<\
A vertex repeated within a single edge is allowed. That is a property of one \
edge rather than a collision between two, and it obstructs nothing.\
\>", "Notes",ExpressionUUID->"2920e8e8-e32c-bf4d-8464-188c24194178"],

Cell["\<\
Edges are stored with their vertices in the canonical order of their symmetry \
type, so two spellings of one unordered or cyclic edge are one edge, and a \
hypergraph holding both is not simple. Two directed edges that reverse each \
other are genuinely two edges, and it is.\
\>", "Notes",ExpressionUUID->"3b4e335a-b598-4743-82ba-6b7b188b3f25"],

Cell[TextData[{
 "Simplicity is what ",
 Cell[BoxData[
  StyleBox["AdjacencyHypermatrix", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"80028d01-0f2e-ee48-b350-10c31f222727"],
 " needs before it will put labels in the entries of a hypermatrix: one entry \
cannot hold two labels."
}], "Notes",ExpressionUUID->"5328deda-d9cf-b240-bb7a-d2ef9399d501"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"7dcf5b4e-ae77-df4a-ba2b-596c0a62110d"],

Cell["\<\
{SimpleHypergraphQ @ Hypergraph[{Edge[{1, 2}], Edge[{2, 3}]}],
 SimpleHypergraphQ @ Hypergraph[{Edge[{1, 2}], Edge[{1, 2}]}]}\
\>", "Input",ExpressionUUID->"fe7dee28-e420-7a4c-97f7-ae992d7cf83d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",ExpressionUUID->"866a3313-\
10f9-684a-b4ca-5074eee5d397"],

Cell["Labels do not make two edges different:", "ExampleText",ExpressionUUID->"3a0ecba1-e4d2-3f4d-a0d6-7c4dad4f454f"],

Cell["\<\
SimpleHypergraphQ @ Hypergraph[{Edge[{1, 2}, \"Directed\", \"a\"],
                                Edge[{1, 2}, \"Directed\", \"b\"]}]\
\>", "Input",ExpressionUUID->"06bcb321-60de-4f47-94bf-e8f2b6be3fde"],

Cell[BoxData["False"], "Output",ExpressionUUID->"86fecd75-4e36-924b-87aa-a64f08db9eb5"],

Cell["\<\
Two spellings of one unordered edge are one edge; two opposite directed edges \
are two:\
\>", "ExampleText",ExpressionUUID->"e7311f93-216f-724f-b4fa-b1ee50d2092d"],

Cell["\<\
{SimpleHypergraphQ @ Hypergraph[{Edge[{1, 2}, \"Unordered\"], Edge[{2, 1}, \
\"Unordered\"]}],
 SimpleHypergraphQ @ Hypergraph[{Edge[{1, 2}, \"Directed\"], Edge[{2, 1}, \
\"Directed\"]}]}\
\>", "Input",ExpressionUUID->"9ea827c1-8d32-8e47-934e-1604dd0409d5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "True"}], "}"}]], "Output",ExpressionUUID->"08c41241-\
29f1-a941-a47d-4111c5eb3d74"],

Cell["A vertex repeated inside an edge is no obstacle:", "ExampleText",ExpressionUUID->"29896e8b-14b3-b742-84e8-d29d711a70b3"],

Cell["\<\
SimpleHypergraphQ @ Hypergraph[{Edge[{1, 1, 2}, \"Unordered\"]}]\
\>", "Input",ExpressionUUID->"9254ef48-0b8d-af49-ab85-20a3137a7646"],

Cell[BoxData["True"], "Output",ExpressionUUID->"9e55a3cd-cee7-414d-bc59-7847a59739bd"],

Cell["Source", "NotesSection",ExpressionUUID->"737d46ae-bc36-4e44-8491-5ad2aaa59e2e"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Hypergraphs",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"725cdc34-04b3-894b-bb54-c669beaa3543"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"65c467d1-0d99-9144-9c07-bb6cda5413fe"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["HypergraphSkeleton", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"b913c0d1-5b28-8148-a717-e5eac5d09866"],
 ", ",
 Cell[BoxData[
  StyleBox["AdjacencyHypermatrix", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"bcfb9f0a-7be8-da43-81df-1bc9258816ae"],
 ", ",
 Cell[BoxData[
  StyleBox["Hypergraph", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "8982e817-a8e9-b143-9993-078724fec872"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeList", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "fbad1824-d61f-a740-ac4e-90a6086ed27e"]
}], "SeeAlso",ExpressionUUID->"68d00d71-fd77-b844-ab3b-481dcfad92be"]
},
WindowSize->{800, 750},
