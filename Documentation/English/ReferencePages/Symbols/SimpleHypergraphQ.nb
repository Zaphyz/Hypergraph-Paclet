(* Beginning of Notebook Content *)
Notebook[{
Cell["SimpleHypergraphQ", "ObjectName",ExpressionUUID->"3649cf0a-4e04-9d4c-95e9-3d348d81ca65"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"SimpleHypergraphQ", "[", "hg", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"efa6b415-ea5e-1146-9e64-a4179f080506"],
 " ",
 "gives True if no edge of hg is repeated, and False otherwise."
}], "Usage",ExpressionUUID->"fdb7cb95-94c0-4a45-ac37-1c8192c4edf4"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"34ad1398-bb94-414e-95c8-253d0ef59555"],

Cell["\<\
Labels are set aside for the test. Two edges differing only by a label are \
the same edge of the same skeleton, and so make the hypergraph not simple; \
the test is DuplicateFreeQ on the edges of HypergraphSkeleton[hg].\
\>", "Notes",ExpressionUUID->"de5426db-4cf2-654d-9cf1-f84c62187c4f"],

Cell["\<\
A vertex repeated within a single edge is allowed. That is a property of one \
edge rather than a collision between two, and it obstructs nothing.\
\>", "Notes",ExpressionUUID->"94801b4c-e03a-7d4f-92d6-caad273d8cfe"],

Cell["\<\
Edges are stored with their vertices in the canonical order of their symmetry \
type, so two spellings of one unordered or cyclic edge are one edge, and a \
hypergraph holding both is not simple. Two directed edges that reverse each \
other are genuinely two edges, and it is.\
\>", "Notes",ExpressionUUID->"10a48bc8-17f5-b94f-9386-005bcd5b2126"],

Cell[TextData[{
 "Simplicity is what ",
 Cell[BoxData[
  StyleBox["AdjacencyHypermatrix", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"fdf4245c-98e1-a442-953b-ae7bc5ef3eca"],
 " needs before it will put labels in the entries of a hypermatrix: one entry \
cannot hold two labels."
}], "Notes",ExpressionUUID->"ea495fb1-e886-554b-84d0-6ec98566f97e"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"e438146a-5eec-d346-90aa-41ef6205eda9"],

Cell["\<\
{SimpleHypergraphQ @ Hypergraph[{Edge[{1, 2}], Edge[{2, 3}]}],
 SimpleHypergraphQ @ Hypergraph[{Edge[{1, 2}], Edge[{1, 2}]}]}\
\>", "Input",ExpressionUUID->"bf123f7e-d8a0-3840-b42b-0a14f5069e4d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",ExpressionUUID->"ad3d12e9-\
7594-4e46-b3f4-dc5fd1c87e6a"],

Cell["Labels do not make two edges different:", "ExampleText",ExpressionUUID->"abc0afed-94c0-7142-86af-8d7bbdfab63f"],

Cell["\<\
SimpleHypergraphQ @ Hypergraph[{Edge[{1, 2}, \"Directed\", \"a\"],
                                Edge[{1, 2}, \"Directed\", \"b\"]}]\
\>", "Input",ExpressionUUID->"41e218d3-c004-3f44-8cde-a3bfccda3ae3"],

Cell[BoxData["False"], "Output",ExpressionUUID->"8a99530c-a003-ef4c-9a01-1b08aa9c3336"],

Cell["\<\
Two spellings of one unordered edge are one edge; two opposite directed edges \
are two:\
\>", "ExampleText",ExpressionUUID->"be29bc26-8380-3a4c-a751-4c3f36ebda60"],

Cell["\<\
{SimpleHypergraphQ @ Hypergraph[{Edge[{1, 2}, \"Unordered\"], Edge[{2, 1}, \
\"Unordered\"]}],
 SimpleHypergraphQ @ Hypergraph[{Edge[{1, 2}, \"Directed\"], Edge[{2, 1}, \
\"Directed\"]}]}\
\>", "Input",ExpressionUUID->"0b26a78f-80c6-d84b-974b-6ebe7a95eb75"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "True"}], "}"}]], "Output",ExpressionUUID->"1439b9e4-\
8481-bf4a-9099-ab9404854897"],

Cell["A vertex repeated inside an edge is no obstacle:", "ExampleText",ExpressionUUID->"cbae3ab1-5633-e944-a354-35fbf89f7499"],

Cell["\<\
SimpleHypergraphQ @ Hypergraph[{Edge[{1, 1, 2}, \"Unordered\"]}]\
\>", "Input",ExpressionUUID->"4d7d9450-7005-ab40-b298-ca2e035bef9f"],

Cell[BoxData["True"], "Output",ExpressionUUID->"4eec82f6-6e2c-494c-96f1-d3fca4af8086"],

Cell["Source", "NotesSection",ExpressionUUID->"f5c37d5f-72b6-d44a-92b5-10f1539a89b3"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Hypergraphs",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"3dc494f6-0c03-e74c-85f6-ab9682e409d4"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"c523367e-1111-de48-811b-fe3a5f75ba3c"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["HypergraphSkeleton", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"d9d60193-cc2a-4a48-a9ef-02fe683c249f"],
 ", ",
 Cell[BoxData[
  StyleBox["AdjacencyHypermatrix", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"7bc1b160-23ff-7742-a997-d8e971dcea10"],
 ", ",
 Cell[BoxData[
  StyleBox["Hypergraph", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "da699670-9b9c-b647-97b5-72fce9722179"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeList", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "fdc2c08d-da2d-0841-8e98-98abeafe2848"]
}], "SeeAlso",ExpressionUUID->"8159180f-6117-7743-aac5-494041608386"]
},
WindowSize->{800, 750},
FrontEndVersion->"15.0 for Microsoft Windows (64-bit) (July 2, 2026)",
