(* Beginning of Notebook Content *)
Notebook[{
Cell["SimpleHypergraphQ", "ObjectName",ExpressionUUID->"724f32a7-3da9-4a4e-bc2d-4ad239d2b875"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"SimpleHypergraphQ", "[", "hg", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"35a99122-f72a-2c4d-9e3d-a4c5565cb54c"],
 " ",
 "gives True if no edge of hg is repeated, and False otherwise."
}], "Usage",ExpressionUUID->"03569230-61f0-d645-bcc4-65193394b759"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"e11e0a7d-6fb6-f643-9ea7-29c0891acfc7"],

Cell["\<\
Labels are set aside for the test. Two edges differing only by a label are \
the same edge of the same skeleton, and so make the hypergraph not simple; \
the test is DuplicateFreeQ on the edges of HypergraphSkeleton[hg].\
\>", "Notes",ExpressionUUID->"a4271dbe-dd21-6d4c-9db8-1495ffcf1310"],

Cell["\<\
A vertex repeated within a single edge is allowed. That is a property of one \
edge rather than a collision between two, and it obstructs nothing.\
\>", "Notes",ExpressionUUID->"364a0b18-6387-f24e-9276-5e12937eaa1a"],

Cell["\<\
Edges are stored with their vertices in the canonical order of their symmetry \
type, so two spellings of one unordered or cyclic edge are one edge, and a \
hypergraph holding both is not simple. Two directed edges that reverse each \
other are genuinely two edges, and it is.\
\>", "Notes",ExpressionUUID->"ebcd3880-c601-e44e-932b-0a97bedac46a"],

Cell[TextData[{
 "Simplicity is what ",
 Cell[BoxData[
  StyleBox["AdjacencyHypermatrix", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"45577837-4832-9442-8621-f27abe02b444"],
 " needs before it will put labels in the entries of a hypermatrix: one entry \
cannot hold two labels."
}], "Notes",ExpressionUUID->"8e543c08-e4e3-c648-bff8-faa94205cbca"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"8a3683df-3399-d64e-aeae-77ebb9eb2579"],

Cell["\<\
{SimpleHypergraphQ @ Hypergraph[{Edge[{1, 2}], Edge[{2, 3}]}],
 SimpleHypergraphQ @ Hypergraph[{Edge[{1, 2}], Edge[{1, 2}]}]}\
\>", "Input",ExpressionUUID->"29adf25f-edd5-6245-a913-1b8f0da251e2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",ExpressionUUID->"2b79819e-\
041d-a143-af7d-e5d1cdc5df2a"],

Cell["Labels do not make two edges different:", "ExampleText",ExpressionUUID->"f406f04e-7729-7441-8f03-798f0b5d5f63"],

Cell["\<\
SimpleHypergraphQ @ Hypergraph[{Edge[{1, 2}, \"Directed\", \"a\"],
                                Edge[{1, 2}, \"Directed\", \"b\"]}]\
\>", "Input",ExpressionUUID->"26ff9434-32c9-a143-a4b3-faf4270f65ce"],

Cell[BoxData["False"], "Output",ExpressionUUID->"605844ef-2eee-0b46-bbea-a9d2a8ea85cc"],

Cell["\<\
Two spellings of one unordered edge are one edge; two opposite directed edges \
are two:\
\>", "ExampleText",ExpressionUUID->"e8598c61-5771-9a41-96c7-3541b52235a4"],

Cell["\<\
{SimpleHypergraphQ @ Hypergraph[{Edge[{1, 2}, \"Unordered\"], Edge[{2, 1}, \
\"Unordered\"]}],
 SimpleHypergraphQ @ Hypergraph[{Edge[{1, 2}, \"Directed\"], Edge[{2, 1}, \
\"Directed\"]}]}\
\>", "Input",ExpressionUUID->"a882dbd9-3a75-8c45-a674-6de4e90b94aa"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "True"}], "}"}]], "Output",ExpressionUUID->"809188c6-\
3380-4240-bb8e-331033a70c73"],

Cell["A vertex repeated inside an edge is no obstacle:", "ExampleText",ExpressionUUID->"1fe663e8-f4f4-b444-a44d-0b059ed44cab"],

Cell["\<\
SimpleHypergraphQ @ Hypergraph[{Edge[{1, 1, 2}, \"Unordered\"]}]\
\>", "Input",ExpressionUUID->"cb6924b5-1e57-ce4b-b294-1e814aaaf723"],

Cell[BoxData["True"], "Output",ExpressionUUID->"e0cdc0cc-7067-df48-8eca-e8ec5e3b3abf"],

Cell["Source", "NotesSection",ExpressionUUID->"b894440d-4e92-574a-b4cf-02f81ff8772a"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Hypergraphs",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"7ccea8a5-d09c-d54a-a23f-0c53e4e51c68"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"f6060b3c-2d28-1342-a0ac-7219e27f81ce"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["HypergraphSkeleton", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"49295f4f-fa98-da4c-8eaf-38175d1aac94"],
 ", ",
 Cell[BoxData[
  StyleBox["AdjacencyHypermatrix", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"b083e968-d9ae-c549-a968-2c0c263bb6d6"],
 ", ",
 Cell[BoxData[
  StyleBox["Hypergraph", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "ff154efc-77e8-7c44-a8b6-c67710232b44"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeList", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "04bea385-db8e-074c-8d96-3f060ff5e8a3"]
}], "SeeAlso",ExpressionUUID->"07884479-e950-0649-8b69-ff3254caf837"]
},
WindowSize->{800, 750},
FrontEndVersion->"15.0 for Microsoft Windows (64-bit) (July 2, 2026)",
StyleDefinitions->"Reference.nb",
ExpressionUUID->"2ccf7efd-705b-6746-a88b-977919343839"
]
