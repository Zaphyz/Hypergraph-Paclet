Notebook[{
Cell["SymbolicArray", "ObjectName",ExpressionUUID->"bf3c8e3d-06a9-5640-84c8-9ea5b808da9d"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"SymbolicArray", "[", 
    RowBox[{"name", ",", " ", "dims"}], "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"ac8baa6e-615e-ef4c-9589-a9946c2722f0"],
 " ",
 "represents an array of the given dimensions whose entries are the \
expressions name[i1, i2, ...] formed from name and the indices."
}], "Usage",ExpressionUUID->"e36577af-1942-454f-b4b0-937f1e4e06fd"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"SymbolicArray", "[", 
    RowBox[{"name", ",", " ", "dims", ",", " ", "sym"}], "]"}], 
   "InlineCode"]], "InlineFormula",ExpressionUUID->
  "42006932-33e5-3c4b-a0af-5b4e7bbcc196"],
 " ",
 "additionally declares the index symmetry sym."
}], "Usage",ExpressionUUID->"3f06d040-3f2a-4c4a-bae6-46de909d3477"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"98c9cc99-b282-c14e-8f0c-be1d9e38c151"],

Cell["\<\
The entries are not stored. They are generated on demand by ArrayEntries or \
Normal, so a symbolic array of any size costs nothing to hold.\
\>", "Notes",ExpressionUUID->"29d0d958-c1e1-c446-ab0d-d1d446bcd982"],

Cell["\<\
The name must be a symbol or a string. The dimensions must be a list of \
positive integers. The empty list gives the array of order zero, whose single \
entry is the bare name.\
\>", "Notes",ExpressionUUID->"50f4d43a-3600-a346-afbd-64b6f702d170"],

Cell["\<\
The index symmetry sym is one of \"Rigid\" (the default), \"Cyclic\" or \
\"Symmetric\", and only a regular array can carry one other than \"Rigid\".\
\>", "Notes",ExpressionUUID->"a11777df-cb73-2447-a648-a73860120fae"],

Cell["\<\
Under a symmetry, index tuples that are equivalent name the same entry: the \
entry at a given tuple is the name applied to the least tuple in its orbit. A \
symmetric or cyclic symbolic array is therefore symmetric or cyclic by \
construction, with no checking needed.\
\>", "Notes",ExpressionUUID->"dba22d6e-1719-3e43-bbbf-667cdc0fbf01"],

Cell["\<\
A symbolic array is a different object from a numerical one, and its \
ArrayDomain is \"Symbolic\".\
\>", "Notes",ExpressionUUID->"7f2e6d54-bcb4-9f45-8110-8bf3e523b21b"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"59a94d12-a975-d748-9c5b-14d60d927997"],

Cell["The entries are the name applied to the indices:", "ExampleText",ExpressionUUID->"c3ae9aa7-e887-0945-84ed-a395ae04fb88"],

Cell["Normal @ SymbolicArray[a, {2, 3}]", "Input",ExpressionUUID->"94279765-be29-1c4c-95e6-8fdf6c94f0c1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "1"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "3"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "1"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "3"}], "]"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"3082fe35-c073-9f43-9c6b-009d722add30"],

Cell["Under a symmetry, equivalent index tuples name one entry:", \
"ExampleText",ExpressionUUID->"a919430b-cd8e-1749-93ed-7a78250e1299"],

Cell["Normal @ SymbolicArray[a, {3, 3}, \"Symmetric\"]", "Input",ExpressionUUID->"f5b9497e-2ecc-c644-a6e0-2607de11b90c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "1"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "3"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "3"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "3"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "3"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"3", ",", "3"}], "]"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"4842d00a-17be-854c-9453-f7450a5699d3"],

Cell["So the generated array really is symmetric:", "ExampleText",ExpressionUUID->"f9a6bd7a-39a0-754d-8db5-3b6913dc9c07"],

Cell["\<\
With[{e = Normal @ SymbolicArray[a, {3, 3}, \"Symmetric\"]}, e === \
Transpose[e]]\
\>", "Input",ExpressionUUID->"b24c7dfe-f330-0f48-98cd-c2ef0f73b39a"],

Cell[BoxData["True"], "Output",ExpressionUUID->"c331c024-da4e-af48-afab-3b7d30e3d42d"],

Cell["\<\
At order three the three symmetries give different numbers of distinct \
entries:\
\>", "ExampleText",ExpressionUUID->"ce0ca7b0-bf05-4746-b967-a942f31e3f3e"],

Cell["\<\
Length @ DeleteDuplicates @ Flatten @ Normal @ SymbolicArray[a, {3, 3, 3}, #] \
& /@
  {\"Rigid\", \"Cyclic\", \"Symmetric\"}\
\>", "Input",ExpressionUUID->"9ae2fcb6-de04-4641-8adb-1ef409cebb3d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"27", ",", "11", ",", "10"}], "}"}]], "Output",ExpressionUUID->\
"fa646727-a344-d143-8a8e-6a5e18c0ad6d"],

Cell["\<\
At order two the cyclic group is the symmetric group, so the two coincide:\
\>", "ExampleText",ExpressionUUID->"fce0bee4-f1f4-264b-ab17-cc2610372669"],

Cell["\<\
Normal[SymbolicArray[a, {3, 3}, \"Cyclic\"]] === Normal[SymbolicArray[a, {3, \
3}, \"Symmetric\"]]\
\>", "Input",ExpressionUUID->"6902ac7e-05a1-e943-b031-aabe12557c1d"],

Cell[BoxData["True"], "Output",ExpressionUUID->"f71299dd-77d4-1a44-aff9-f4ba35fc2eee"],

Cell["The name, and the domain of a symbolic array:", "ExampleText",ExpressionUUID->"dcf6bc28-48ba-1b45-a367-30f3d6853a6d"],

Cell["\<\
{ArrayName @ SymbolicArray[a, {2}], ArrayDomain @ SymbolicArray[a, {2}]}\
\>", "Input",ExpressionUUID->"25df648e-0512-e84e-91ce-489fdf7130aa"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"a", ",", "\<\"Symbolic\"\>"}], "}"}]], "Output",ExpressionUUID->\
"e68c1e38-e0a1-2c43-9fec-8eeecedba512"],

Cell["An irregular array cannot carry a symmetry:", "ExampleText",ExpressionUUID->"ae84e2cb-9927-3042-adce-c87911148d05"],

Cell["Quiet @ SymbolicArray[a, {2, 3}, \"Symmetric\"]", "Input",ExpressionUUID->"5f1db128-dbbc-5846-ba21-874f26939a8b"],

Cell[BoxData["$Failed"], "Output",ExpressionUUID->"37ed64a1-f8c9-be48-be40-f1018e399a72"],

Cell["With no indices the single entry is the name itself:", "ExampleText",ExpressionUUID->"8959269c-f5ae-ce41-b65c-0b8e4245a106"],

Cell["Normal @ SymbolicArray[a, {}]", "Input",ExpressionUUID->"d0c9fa2f-8854-a547-b757-c4e3f5dbc63d"],

Cell[BoxData["a"], "Output",ExpressionUUID->"b28c8949-f2a1-ed49-a502-e7975ae281b0"],

Cell["Source", "NotesSection",ExpressionUUID->"689c03bd-393a-944e-bc27-0439fb79c839"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypermatrix.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "SymbolicArray",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"61c13659-20fd-ff40-88f0-38a17033fcb5"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"5e7c581f-6c89-924a-9fcc-9907593f1b1d"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["NumericalArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "5b651f9f-af3a-4243-bef4-26a29af0946b"],
 ", ",
 Cell[BoxData[
  StyleBox["Hypermatrix", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "bc3e7212-bfa0-f24f-a705-4f22bd577a1c"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayName", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "05b3f62d-2276-f44f-a73f-9eabc87f685e"],
 ", ",
 Cell[BoxData[
  StyleBox["ArraySymmetry", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "4911dac3-6ec0-274f-b90a-550bfb5369ae"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayEntries", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "4e6d0074-19bc-e645-bd4a-55f05f17d179"],
 ", ",
 Cell[BoxData[
  StyleBox["RegularArrayQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "587206d9-dabe-7745-8e75-ace925fd8d6a"]
}], "SeeAlso",ExpressionUUID->"4cb0c576-e18b-1a4e-85de-2f730400e6c1"]
},
