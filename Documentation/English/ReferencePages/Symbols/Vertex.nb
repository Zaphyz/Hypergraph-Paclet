(* Beginning of Notebook Content *)
Notebook[{
Cell["Vertex", "ObjectName",ExpressionUUID->"9cb99424-d06c-4449-b58a-561d98f7d97d"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Vertex", "[", "id", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"30551f2e-7877-4b44-9438-56a724881a78"],
 " ",
 "represents an unlabelled vertex whose unique identifier is the expression \
id."
}], "Usage",ExpressionUUID->"e0a779a1-d860-b545-858c-b93b42548b49"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Vertex", "[", 
    RowBox[{"id", ",", " ", "lab"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"a5702fb0-fb52-1944-b953-562aaf0f9f30"],
 " ",
 "represents a vertex with identifier id carrying the label lab."
}], "Usage",ExpressionUUID->"d4c0292c-9e3c-d143-ac01-34c87ee8a210"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"d40e93c2-6839-cb4e-a887-316409bbb583"],

Cell["\<\
The identifier id may be any Wolfram Language expression, and is what makes \
the vertex unique within a hypergraph.\
\>", "Notes",ExpressionUUID->"5d164608-46c4-9744-9662-1e152f7ee9af"],

Cell["\<\
The label lab may be any expression. A label of None means no label, so \
Vertex[id, None] normalizes to the one-argument form Vertex[id].\
\>", "Notes",ExpressionUUID->"f6dd7932-4a83-f14f-88bd-abff9a8d3276"],

Cell["\<\
Because there is exactly one spelling per vertex, structural equality (===) \
on two Vertex objects already means that they are the same vertex.\
\>", "Notes",ExpressionUUID->"70c54cf3-33d8-8549-bae9-bbfc5d07a2db"],

Cell["\<\
Wherever a vertex is expected, a bare identifier may be given instead and is \
promoted to a Vertex automatically.\
\>", "Notes",ExpressionUUID->"34bc2e5b-d4a1-9149-b5cb-8f62efaaf5a9"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"3a61a5e7-fbfc-7e48-b045-bfef4fbfb357"],

Cell["An unlabelled vertex and a labelled one:", "ExampleText",ExpressionUUID->"574d272b-18e0-2e4d-9027-bfa0eca6077a"],

Cell["{Vertex[1], Vertex[1, \"a\"]}", "Input",ExpressionUUID->"0a7aac59-54ed-9245-95ab-4cc5c2b3f791"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Vertex", "[", "1", "]"}], ",", 
   RowBox[{"Vertex", "[", 
    RowBox[{"1", ",", "\<\"a\"\>"}], "]"}]}], "}"}]], "Output",ExpressionUUID->\
"29bb2236-303f-8145-9282-ef8ede9e8cb4"],

Cell["A label of None is dropped:", "ExampleText",ExpressionUUID->"7160cd67-cfd1-db43-bfe7-e44ba794c36a"],

Cell["Vertex[1, None]", "Input",ExpressionUUID->"12645650-5cd8-7242-a318-1f4733baa62a"],

Cell[BoxData[
 RowBox[{"Vertex", "[", "1", "]"}]], "Output",ExpressionUUID->"0d2f69f2-271a-5e47-b194-e3cfb2ff1e45"],

Cell["Identifiers are arbitrary expressions:", "ExampleText",ExpressionUUID->"f1d82601-491b-9a4b-abcd-e60f0d87a15a"],

Cell["\<\
{Vertex[1], Vertex[\"a\"], Vertex[{1, 2}], Vertex[u], Vertex[f[3]]}\
\>", "Input",ExpressionUUID->"45de9679-c41e-e146-9a2d-ca6dedc02f01"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Vertex", "[", "1", "]"}], ",", 
   RowBox[{"Vertex", "[", "\<\"a\"\>", "]"}], ",", 
   RowBox[{"Vertex", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}], "]"}], ",", 
   RowBox[{"Vertex", "[", "u", "]"}], ",", 
   RowBox[{"Vertex", "[", 
    RowBox[{"f", "[", "3", "]"}], "]"}]}], "}"}]], "Output",ExpressionUUID->\
"9f577747-1f03-7d4c-a513-6f66ff207263"],

Cell["\<\
Two vertices are identical exactly when they are the same vertex:\
\>", "ExampleText",ExpressionUUID->"cf9ddd71-64c8-eb4e-881e-4e7e5a25e3bf"],

Cell["{Vertex[1] === Vertex[1], Vertex[1] === Vertex[1, \"a\"]}", "Input",ExpressionUUID->"f0d682d2-c33a-344f-b068-a42f2491edf5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",ExpressionUUID->"66dfe760-\
9744-9c4b-987b-d6b9bd5805ff"],

Cell["Source", "NotesSection",ExpressionUUID->"d1999e3d-86c2-fa48-a947-a23f16f747e8"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Vertices",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"0d1c8e0f-81c5-bd4e-a793-2a827fca2b9d"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"d82bacdb-7610-9d4e-a720-c0cf77b783a0"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["VertexID", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "c8a77394-d347-324b-b453-fa088ad8ac3c"],
 ", ",
 Cell[BoxData[
  StyleBox["VertexLabel", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "e15dd645-3537-b846-820d-73bb97526ed8"],
 ", ",
 Cell[BoxData[
  StyleBox["VertexObjectQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "eeb85642-58da-c243-81e5-3d14472bd265"],
 ", ",
 Cell[BoxData[
  StyleBox["Edge", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "109ffb6f-2189-124d-ba20-3ab5cba1c95e"],
 ", ",
 Cell[BoxData[
  StyleBox["Hypergraph", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "f8785db6-1a2a-b64a-bd93-e7724e012a05"]
}], "SeeAlso",ExpressionUUID->"7d50519c-d37a-9343-9371-4a9927c28e82"]
},
