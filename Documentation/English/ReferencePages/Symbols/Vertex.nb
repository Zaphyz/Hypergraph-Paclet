(* Beginning of Notebook Content *)
Notebook[{
Cell["Vertex", "ObjectName",ExpressionUUID->"42cb7af1-6d47-094e-ba23-314f4fe4b2d9"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Vertex", "[", "id", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"a406d75a-142f-9246-8314-3dc7c2837613"],
 " ",
 "represents an unlabelled vertex whose unique identifier is the expression \
id."
}], "Usage",ExpressionUUID->"2d98d4d2-5815-bf4c-8777-d31672735e69"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Vertex", "[", 
    RowBox[{"id", ",", " ", "lab"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"4b0afb8b-27e1-064a-ae65-79201586f4f9"],
 " ",
 "represents a vertex with identifier id carrying the label lab."
}], "Usage",ExpressionUUID->"1913b2ca-f9c6-7648-b9b8-f1d74aa26266"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"a8014af9-4f4e-ed4d-ad50-4a7fe63dff9f"],

Cell["\<\
The identifier id may be any Wolfram Language expression, and is what makes \
the vertex unique within a hypergraph.\
\>", "Notes",ExpressionUUID->"61634a95-5d92-9b44-937c-a01708ead44e"],

Cell["\<\
The label lab may be any expression. A label of None means no label, so \
Vertex[id, None] normalizes to the one-argument form Vertex[id].\
\>", "Notes",ExpressionUUID->"104633f8-357c-e142-9566-59471f70b9fa"],

Cell["\<\
Because there is exactly one spelling per vertex, structural equality (===) \
on two Vertex objects already means that they are the same vertex.\
\>", "Notes",ExpressionUUID->"b4a230be-3f12-f747-9681-77691b945557"],

Cell["\<\
Wherever a vertex is expected, a bare identifier may be given instead and is \
promoted to a Vertex automatically.\
\>", "Notes",ExpressionUUID->"0894c749-f047-9144-8440-569b1e56cf62"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"c01449b7-af80-d049-b940-ae93e261f6e2"],

Cell["An unlabelled vertex and a labelled one:", "ExampleText",ExpressionUUID->"eef1cfc9-89bc-7d4d-a264-8efee40a1be9"],

Cell["{Vertex[1], Vertex[1, \"a\"]}", "Input",ExpressionUUID->"bb5fa7e1-9d01-424d-9093-019231506c49"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Vertex", "[", "1", "]"}], ",", 
   RowBox[{"Vertex", "[", 
    RowBox[{"1", ",", "\<\"a\"\>"}], "]"}]}], "}"}]], "Output",ExpressionUUID->\
"f83e6dec-a328-2a44-b3e0-f494639fd7b0"],

Cell["A label of None is dropped:", "ExampleText",ExpressionUUID->"aea817e9-0074-7149-8473-963197d4c4d4"],

Cell["Vertex[1, None]", "Input",ExpressionUUID->"06fee5c0-6052-2d48-89cd-98611893c042"],

Cell[BoxData[
 RowBox[{"Vertex", "[", "1", "]"}]], "Output",ExpressionUUID->"928d74e4-4329-3a43-ba9f-ca3202bf7019"],

Cell["Identifiers are arbitrary expressions:", "ExampleText",ExpressionUUID->"69a05e6a-1300-144b-8ef2-fb1e95e5e4ec"],

Cell["\<\
{Vertex[1], Vertex[\"a\"], Vertex[{1, 2}], Vertex[u], Vertex[f[3]]}\
\>", "Input",ExpressionUUID->"9bf1e2ec-092f-eb4e-8a86-db85be65212b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Vertex", "[", "1", "]"}], ",", 
   RowBox[{"Vertex", "[", "\<\"a\"\>", "]"}], ",", 
   RowBox[{"Vertex", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}], "]"}], ",", 
   RowBox[{"Vertex", "[", "u", "]"}], ",", 
   RowBox[{"Vertex", "[", 
    RowBox[{"f", "[", "3", "]"}], "]"}]}], "}"}]], "Output",ExpressionUUID->\
"e6a0504b-0139-8740-9325-6c0408813e99"],

Cell["\<\
Two vertices are identical exactly when they are the same vertex:\
\>", "ExampleText",ExpressionUUID->"6b875ad1-0ce8-7d43-9509-0d6fd52f5ae0"],

Cell["{Vertex[1] === Vertex[1], Vertex[1] === Vertex[1, \"a\"]}", "Input",ExpressionUUID->"1741c5b4-2113-6048-937a-3f7aa37954e4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",ExpressionUUID->"ed3c275e-\
8722-b44e-a0a4-89db902b884a"],

Cell["Source", "NotesSection",ExpressionUUID->"9ba1ee4d-549e-904e-8eea-43a6e3945f7c"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Vertices",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"a4dcb7ae-8d24-ec45-b05e-63b402a53612"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"4b5da545-85ff-c143-ade8-04e1defa37ce"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["VertexID", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "38414f7d-7a4c-2c46-8639-7051e95169ac"],
 ", ",
 Cell[BoxData[
  StyleBox["VertexLabel", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "b2e2cbc8-4ec7-5945-9e3e-ef3343215873"],
 ", ",
 Cell[BoxData[
  StyleBox["VertexObjectQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "c1ca42c6-0417-864b-aac7-cb1590b2b60b"],
 ", ",
 Cell[BoxData[
  StyleBox["Edge", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "2fdd6cc4-4233-5641-8022-07b81318a95a"],
 ", ",
 Cell[BoxData[
  StyleBox["Hypergraph", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "f0376a74-2740-dd41-8b23-2a8c6604bd8f"]
}], "SeeAlso",ExpressionUUID->"081bb33a-6414-d74a-93ee-74eb9a65e60d"]
},
