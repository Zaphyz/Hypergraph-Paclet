(* Beginning of Notebook Content *)
Notebook[{
Cell["Vertex", "ObjectName",ExpressionUUID->"57452438-2ffc-7148-96e0-37e808b27fb9"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Vertex", "[", "id", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"ec237364-7859-aa4f-8894-482cbd18258b"],
 " ",
 "represents an unlabelled vertex whose unique identifier is the expression \
id."
}], "Usage",ExpressionUUID->"104af979-4820-2a4f-8e98-7a4a6ee04ae7"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Vertex", "[", 
    RowBox[{"id", ",", " ", "lab"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"34c5f1e7-91b9-0b40-8f49-71eb702d5121"],
 " ",
 "represents a vertex with identifier id carrying the label lab."
}], "Usage",ExpressionUUID->"e69afe0a-8406-a34d-9f07-eba3f5c7580b"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"4054cad0-3a53-6449-b298-e6952fd50c24"],

Cell["\<\
The identifier id may be any Wolfram Language expression, and is what makes \
the vertex unique within a hypergraph.\
\>", "Notes",ExpressionUUID->"7b36b88d-f3a5-2a46-881f-adf4b87218d9"],

Cell["\<\
The label lab may be any expression. A label of None means no label, so \
Vertex[id, None] normalizes to the one-argument form Vertex[id].\
\>", "Notes",ExpressionUUID->"f47ede25-91a6-be41-a9c9-64857b123997"],

Cell["\<\
Because there is exactly one spelling per vertex, structural equality (===) \
on two Vertex objects already means that they are the same vertex.\
\>", "Notes",ExpressionUUID->"9a03eff6-0c8c-8c42-b7cf-65845edfcb55"],

Cell["\<\
Wherever a vertex is expected, a bare identifier may be given instead and is \
promoted to a Vertex automatically.\
\>", "Notes",ExpressionUUID->"b070ef00-e9d3-f44d-936d-c32b8bcbeebd"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"e80a8fb7-ba40-f841-a950-1ed19d19e889"],

Cell["An unlabelled vertex and a labelled one:", "ExampleText",ExpressionUUID->"c9f4ea31-5bfb-2f44-b4ef-4eb18c3af14c"],

Cell["{Vertex[1], Vertex[1, \"a\"]}", "Input",ExpressionUUID->"421fe07f-2d5c-4f46-9ed4-fca0d8cab80d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Vertex", "[", "1", "]"}], ",", 
   RowBox[{"Vertex", "[", 
    RowBox[{"1", ",", "\<\"a\"\>"}], "]"}]}], "}"}]], "Output",ExpressionUUID->\
"c359d53e-1492-6345-b127-261fd5e65e7a"],

Cell["A label of None is dropped:", "ExampleText",ExpressionUUID->"41bbf18a-6cec-624d-b6ae-adadeb6a7ee0"],

Cell["Vertex[1, None]", "Input",ExpressionUUID->"eaa11d77-305e-bd42-8dc5-fa44042feb2f"],

Cell[BoxData[
 RowBox[{"Vertex", "[", "1", "]"}]], "Output",ExpressionUUID->"7e108987-88b2-ab4e-97a6-4c9f741cdbd2"],

Cell["Identifiers are arbitrary expressions:", "ExampleText",ExpressionUUID->"9e5b2644-e910-d748-8a4a-750a20cff15b"],

Cell["\<\
{Vertex[1], Vertex[\"a\"], Vertex[{1, 2}], Vertex[u], Vertex[f[3]]}\
\>", "Input",ExpressionUUID->"de7a1bc6-934d-4e48-b9d9-7e5705c91d4c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Vertex", "[", "1", "]"}], ",", 
   RowBox[{"Vertex", "[", "\<\"a\"\>", "]"}], ",", 
   RowBox[{"Vertex", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}], "]"}], ",", 
   RowBox[{"Vertex", "[", "u", "]"}], ",", 
   RowBox[{"Vertex", "[", 
    RowBox[{"f", "[", "3", "]"}], "]"}]}], "}"}]], "Output",ExpressionUUID->\
"3665b431-e7b3-9f4c-8a88-01b781649996"],

Cell["\<\
Two vertices are identical exactly when they are the same vertex:\
\>", "ExampleText",ExpressionUUID->"836cbdf5-f939-574e-8e64-966fae8fb918"],

Cell["{Vertex[1] === Vertex[1], Vertex[1] === Vertex[1, \"a\"]}", "Input",ExpressionUUID->"bad278ee-e20e-fd47-9261-f5e59c847f1e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",ExpressionUUID->"d14e7cf6-\
3590-624c-a2cf-557d687c33bb"],

Cell["Source", "NotesSection",ExpressionUUID->"d97a6311-39d8-494e-b276-ec2690c0f2d2"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Vertices",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"c22d900b-0fb6-7b4d-8ea9-a8c9233f8e52"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"81a4c642-cf1a-294f-9b2a-0571465b9d28"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["VertexID", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "a76179e8-e520-fd4c-b34f-d905eee67f7d"],
 ", ",
 Cell[BoxData[
  StyleBox["VertexLabel", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "c5acc861-6151-2340-ba6f-b4c3189da70b"],
 ", ",
 Cell[BoxData[
  StyleBox["VertexObjectQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "8b6a0a87-37ef-624f-b140-de9f2810429c"],
 ", ",
 Cell[BoxData[
  StyleBox["Edge", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "558a4278-04d2-4c46-9aa9-407a8c813ef7"],
 ", ",
 Cell[BoxData[
  StyleBox["Hypergraph", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "ef6b7716-e133-ee4e-a871-e816625180a6"]
}], "SeeAlso",ExpressionUUID->"0cc6b983-f8ee-6346-8605-da19b388de2c"]
},
