(* Beginning of Notebook Content *)
Notebook[{
Cell["Vertex", "ObjectName",ExpressionUUID->"d22422e8-bda9-f84f-a5be-c44bac44ba46"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Vertex", "[", "id", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"e52b7888-42f3-9b48-bdc6-05f12de00a2c"],
 " ",
 "represents an unlabelled vertex whose unique identifier is the expression \
id."
}], "Usage",ExpressionUUID->"69a9d130-2c73-554a-b7b0-fecc416868b7"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Vertex", "[", 
    RowBox[{"id", ",", " ", "lab"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"a8d2f995-0dfe-0643-a066-55beaf9bd889"],
 " ",
 "represents a vertex with identifier id carrying the label lab."
}], "Usage",ExpressionUUID->"2155a368-ec86-eb4f-9039-9cae72259a58"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"90f41c9c-35ec-8a47-bd4c-52a164bb8fdd"],

Cell["\<\
The identifier id may be any Wolfram Language expression, and is what makes \
the vertex unique within a hypergraph.\
\>", "Notes",ExpressionUUID->"79521214-f392-3e43-a78c-4b41ac340940"],

Cell["\<\
The label lab may be any expression. A label of None means no label, so \
Vertex[id, None] normalizes to the one-argument form Vertex[id].\
\>", "Notes",ExpressionUUID->"68020224-8a26-3747-809d-548a01773349"],

Cell["\<\
Because there is exactly one spelling per vertex, structural equality (===) \
on two Vertex objects already means that they are the same vertex.\
\>", "Notes",ExpressionUUID->"5784fc10-ec14-0940-8ae3-642fe3447d2d"],

Cell["\<\
Wherever a vertex is expected, a bare identifier may be given instead and is \
promoted to a Vertex automatically.\
\>", "Notes",ExpressionUUID->"68d55b1b-7687-6146-a2e4-a055b416b438"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"2d25b2bc-5853-c440-b440-13bc71bc769d"],

Cell["An unlabelled vertex and a labelled one:", "ExampleText",ExpressionUUID->"1b43be03-55d4-5444-9eee-f40c68aee77f"],

Cell["{Vertex[1], Vertex[1, \"a\"]}", "Input",ExpressionUUID->"28ebcc47-b051-7845-b2dc-a7105ee7b9c7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Vertex", "[", "1", "]"}], ",", 
   RowBox[{"Vertex", "[", 
    RowBox[{"1", ",", "\<\"a\"\>"}], "]"}]}], "}"}]], "Output",ExpressionUUID->\
"d2df09b3-e91f-c44e-9a59-4925de97e3e0"],

Cell["A label of None is dropped:", "ExampleText",ExpressionUUID->"f606bc19-357b-d543-b2a1-88533a5a6511"],

Cell["Vertex[1, None]", "Input",ExpressionUUID->"af4f106c-416e-c843-a948-2148b26fcf9d"],

Cell[BoxData[
 RowBox[{"Vertex", "[", "1", "]"}]], "Output",ExpressionUUID->"0997ecbe-88f8-8d4b-b58b-fba3413588e5"],

Cell["Identifiers are arbitrary expressions:", "ExampleText",ExpressionUUID->"9cece5ac-48f9-dd46-ac6a-37023abfaf4e"],

Cell["\<\
{Vertex[1], Vertex[\"a\"], Vertex[{1, 2}], Vertex[u], Vertex[f[3]]}\
\>", "Input",ExpressionUUID->"bb2e2e68-1999-5748-be8a-600473db63b9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Vertex", "[", "1", "]"}], ",", 
   RowBox[{"Vertex", "[", "\<\"a\"\>", "]"}], ",", 
   RowBox[{"Vertex", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}], "]"}], ",", 
   RowBox[{"Vertex", "[", "u", "]"}], ",", 
   RowBox[{"Vertex", "[", 
    RowBox[{"f", "[", "3", "]"}], "]"}]}], "}"}]], "Output",ExpressionUUID->\
"4db4ae99-2f16-e04a-8b70-dce178524618"],

Cell["\<\
Two vertices are identical exactly when they are the same vertex:\
\>", "ExampleText",ExpressionUUID->"2fabf291-ee23-234e-abc5-ed7583b8767b"],

Cell["{Vertex[1] === Vertex[1], Vertex[1] === Vertex[1, \"a\"]}", "Input",ExpressionUUID->"4332aba1-1e38-4546-9dff-5012b77877d8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",ExpressionUUID->"fd0c3339-\
a48c-9e47-8cfb-f7fe22468e9e"],

Cell["Source", "NotesSection",ExpressionUUID->"d5076a2f-49a1-1947-9e29-2819855e9606"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Vertices",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"38574b73-6c16-0c44-86f8-7dcff565a081"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"49458a35-b192-8548-8854-babf0d2e89e1"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["VertexID", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "b8925f80-60b6-8a4e-8098-97e23f966682"],
 ", ",
 Cell[BoxData[
  StyleBox["VertexLabel", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "6e9ed4f6-123f-c64d-8fd9-7a7ff954bc11"],
 ", ",
 Cell[BoxData[
  StyleBox["VertexObjectQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "92e32e1f-db7f-7345-80b0-6065b7c81a75"],
 ", ",
 Cell[BoxData[
  StyleBox["Edge", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "cdff8184-b261-804c-bf2a-e98ae4b1f496"],
 ", ",
 Cell[BoxData[
  StyleBox["Hypergraph", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "067815ed-08b8-c348-8a35-3f3b587ff6ef"]
}], "SeeAlso",ExpressionUUID->"14ceb1a8-4194-6a41-9e88-66e3687847b6"]
},
