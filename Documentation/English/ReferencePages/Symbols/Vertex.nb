(* Beginning of Notebook Content *)
Notebook[{
Cell["Vertex", "ObjectName",ExpressionUUID->"4c3ee672-5b6f-d947-b236-8672b532cb5d"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Vertex", "[", "id", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"3b7f0a57-c054-c84d-b9f0-741e590cf5b0"],
 " ",
 "represents an unlabelled vertex whose unique identifier is the expression \
id."
}], "Usage",ExpressionUUID->"673a93aa-4499-e444-b9a5-78290ad7a3bc"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Vertex", "[", 
    RowBox[{"id", ",", " ", "lab"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"5bd23c27-8a84-0c42-944c-998408f17def"],
 " ",
 "represents a vertex with identifier id carrying the label lab."
}], "Usage",ExpressionUUID->"d3eb78c5-adf6-3048-9eda-9e419ce28ef0"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"9b388882-803d-864c-8709-642b7a2d257c"],

Cell["\<\
The identifier id may be any Wolfram Language expression, and is what makes \
the vertex unique within a hypergraph.\
\>", "Notes",ExpressionUUID->"623df7ba-843d-d142-bfc6-d25ced808826"],

Cell["\<\
The label lab may be any expression. A label of None means no label, so \
Vertex[id, None] normalizes to the one-argument form Vertex[id].\
\>", "Notes",ExpressionUUID->"2dc97bd2-0465-034f-894f-e748e48ae501"],

Cell["\<\
Because there is exactly one spelling per vertex, structural equality (===) \
on two Vertex objects already means that they are the same vertex.\
\>", "Notes",ExpressionUUID->"3d7966ca-8b16-9145-8fa9-73f9fd53a2b7"],

Cell["\<\
Wherever a vertex is expected, a bare identifier may be given instead and is \
promoted to a Vertex automatically.\
\>", "Notes",ExpressionUUID->"cef5205a-8125-c642-bd20-f3500ec55745"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"b2415c09-59e5-5142-b4d3-df166c02ede5"],

Cell["An unlabelled vertex and a labelled one:", "ExampleText",ExpressionUUID->"a74bfe26-b7b3-3e49-bd32-e9a692632b62"],

Cell["{Vertex[1], Vertex[1, \"a\"]}", "Input",ExpressionUUID->"f40a852a-343e-2d4a-a4e2-0696eabf1b75"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Vertex", "[", "1", "]"}], ",", 
   RowBox[{"Vertex", "[", 
    RowBox[{"1", ",", "\<\"a\"\>"}], "]"}]}], "}"}]], "Output",ExpressionUUID->\
"e1296b62-8c91-3145-ab6a-4aa9e51a5de3"],

Cell["A label of None is dropped:", "ExampleText",ExpressionUUID->"41cb4ea2-12cd-ed4e-aa56-4c00c87c964e"],

Cell["Vertex[1, None]", "Input",ExpressionUUID->"d07bef92-0278-5644-b94b-c13ad48aa9f3"],

Cell[BoxData[
 RowBox[{"Vertex", "[", "1", "]"}]], "Output",ExpressionUUID->"56f67e58-989c-9647-b3de-90afae474111"],

Cell["Identifiers are arbitrary expressions:", "ExampleText",ExpressionUUID->"6066660f-a70f-7d47-a22f-d6da7cb0a0b0"],

Cell["\<\
{Vertex[1], Vertex[\"a\"], Vertex[{1, 2}], Vertex[u], Vertex[f[3]]}\
\>", "Input",ExpressionUUID->"2bf34c4c-8a4c-4246-8a18-2bf819d31fd3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Vertex", "[", "1", "]"}], ",", 
   RowBox[{"Vertex", "[", "\<\"a\"\>", "]"}], ",", 
   RowBox[{"Vertex", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}], "]"}], ",", 
   RowBox[{"Vertex", "[", "u", "]"}], ",", 
   RowBox[{"Vertex", "[", 
    RowBox[{"f", "[", "3", "]"}], "]"}]}], "}"}]], "Output",ExpressionUUID->\
"6e474b50-99d2-dc49-8bad-03f1f4aefa5f"],

Cell["\<\
Two vertices are identical exactly when they are the same vertex:\
\>", "ExampleText",ExpressionUUID->"7dad69e4-2356-2748-82b7-b8d0de6b7b40"],

Cell["{Vertex[1] === Vertex[1], Vertex[1] === Vertex[1, \"a\"]}", "Input",ExpressionUUID->"672e54c9-8eaf-0549-86a2-d3cac618d72b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",ExpressionUUID->"69a42b4d-\
9408-9d4d-8fc6-4484a7e2f97f"],

Cell["Source", "NotesSection",ExpressionUUID->"3358a6aa-7b41-4f44-8c59-c3d877dfc98c"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Vertices",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"f31a6a7c-9ce3-c344-9b2e-88b22e37893e"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"aada896e-1037-0a47-86aa-c668fc189651"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["VertexID", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "c96bc81e-4265-7e4a-9bc6-234e81485317"],
 ", ",
 Cell[BoxData[
  StyleBox["VertexLabel", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "1de64418-5c7f-8f49-bbbc-e3b6ba4b86dc"],
 ", ",
 Cell[BoxData[
  StyleBox["VertexObjectQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "2d613236-6f3d-e24e-80ea-398ac025fa15"],
 ", ",
 Cell[BoxData[
  StyleBox["Edge", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "c884385d-c462-c94d-afff-e92de70930ca"],
 ", ",
 Cell[BoxData[
  StyleBox["Hypergraph", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "81fbca42-638d-7542-9b3d-f6fe465c6e47"]
}], "SeeAlso",ExpressionUUID->"76cf8d6b-7316-664a-ba7f-ab086c8c0dc8"]
},
WindowSize->{800, 750},
