(* Beginning of Notebook Content *)
Notebook[{
Cell["Vertex", "ObjectName",ExpressionUUID->"9dc9a2ec-59fc-fa4b-b579-b7b47c6379ac"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Vertex", "[", "id", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"de53c622-3a60-7f48-be70-71f23336b5e6"],
 " ",
 "represents an unlabelled vertex whose unique identifier is the expression \
id."
}], "Usage",ExpressionUUID->"0f5eabf5-177b-5a40-ba71-875481d9c7c8"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Vertex", "[", 
    RowBox[{"id", ",", " ", "lab"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"75a209ee-1cea-0a4f-bcd3-bce54319e450"],
 " ",
 "represents a vertex with identifier id carrying the label lab."
}], "Usage",ExpressionUUID->"cbbc24bf-c683-0a4a-a643-a27e6a10fe9d"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"b99b3c24-3e67-5a43-950e-1b34c0ec8b9f"],

Cell["\<\
The identifier id may be any Wolfram Language expression, and is what makes \
the vertex unique within a hypergraph.\
\>", "Notes",ExpressionUUID->"07b0eb5c-1adc-464a-848f-ffce185c9f51"],

Cell["\<\
The label lab may be any expression. A label of None means no label, so \
Vertex[id, None] normalizes to the one-argument form Vertex[id].\
\>", "Notes",ExpressionUUID->"3525bbb9-5cd7-0a4e-99c3-e7d7924e3edd"],

Cell["\<\
Because there is exactly one spelling per vertex, structural equality (===) \
on two Vertex objects already means that they are the same vertex.\
\>", "Notes",ExpressionUUID->"3bbd43c6-c326-034c-96eb-d54036300365"],

Cell["\<\
Wherever a vertex is expected, a bare identifier may be given instead and is \
promoted to a Vertex automatically.\
\>", "Notes",ExpressionUUID->"98a099b9-437c-1d46-a2e7-38ec085c2823"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"b7ee7124-ba2d-524b-8b88-e5d3af917642"],

Cell["An unlabelled vertex and a labelled one:", "ExampleText",ExpressionUUID->"aaf54e61-c1fa-6c4c-af5e-f4488e879729"],

Cell["{Vertex[1], Vertex[1, \"a\"]}", "Input",ExpressionUUID->"13c01924-b18f-e14f-b1c0-6fec5a0febc4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Vertex", "[", "1", "]"}], ",", 
   RowBox[{"Vertex", "[", 
    RowBox[{"1", ",", "\<\"a\"\>"}], "]"}]}], "}"}]], "Output",ExpressionUUID->\
"fe3d272f-efba-a742-8265-c19744c870f0"],

Cell["A label of None is dropped:", "ExampleText",ExpressionUUID->"4c91c018-87e1-c741-9236-9c12d133436a"],

Cell["Vertex[1, None]", "Input",ExpressionUUID->"b645e522-9631-7e40-893a-969bac801b52"],

Cell[BoxData[
 RowBox[{"Vertex", "[", "1", "]"}]], "Output",ExpressionUUID->"641d2f5b-c271-3b44-8876-c60b33d9ff86"],

Cell["Identifiers are arbitrary expressions:", "ExampleText",ExpressionUUID->"2b75b61f-aecb-874c-bee5-b06fde8be99c"],

Cell["\<\
{Vertex[1], Vertex[\"a\"], Vertex[{1, 2}], Vertex[u], Vertex[f[3]]}\
\>", "Input",ExpressionUUID->"cf2306cc-db9f-bc4b-a4fc-c13ceab5379c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Vertex", "[", "1", "]"}], ",", 
   RowBox[{"Vertex", "[", "\<\"a\"\>", "]"}], ",", 
   RowBox[{"Vertex", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}], "]"}], ",", 
   RowBox[{"Vertex", "[", "u", "]"}], ",", 
   RowBox[{"Vertex", "[", 
    RowBox[{"f", "[", "3", "]"}], "]"}]}], "}"}]], "Output",ExpressionUUID->\
"8cc50915-aff9-4d4f-94e1-feae6aa13008"],

Cell["\<\
Two vertices are identical exactly when they are the same vertex:\
\>", "ExampleText",ExpressionUUID->"88995b7b-b769-364b-adf9-4550c133e621"],

Cell["{Vertex[1] === Vertex[1], Vertex[1] === Vertex[1, \"a\"]}", "Input",ExpressionUUID->"61a63934-d728-134e-b1be-c286b71ec9be"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",ExpressionUUID->"efdb2353-\
3cac-e54b-8514-ce9aa5b851b4"],

Cell["Source", "NotesSection",ExpressionUUID->"d0fc7b4a-a928-024f-bd92-6c20eb8dfc93"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Vertices",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"ed51c807-76a0-5541-9512-c51b13643fbc"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"f1df4e52-8e26-ab4f-a494-1a383033e87d"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["VertexID", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "ca5d01b0-3315-564d-ad00-95f5a3d25433"],
 ", ",
 Cell[BoxData[
  StyleBox["VertexLabel", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "d40081da-23d0-384d-9763-8c7760fc9736"],
 ", ",
 Cell[BoxData[
  StyleBox["VertexObjectQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "4e28bb4b-b14a-c545-a72b-79528670a9fd"],
 ", ",
 Cell[BoxData[
  StyleBox["Edge", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "42c94835-6fb5-114f-a539-d3ef918e396c"],
 ", ",
 Cell[BoxData[
  StyleBox["Hypergraph", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "4bcfe500-8ded-de4a-b693-fff70738aefc"]
}], "SeeAlso",ExpressionUUID->"af08e768-6ee2-184f-b9c0-1e7b7617458e"]
},
