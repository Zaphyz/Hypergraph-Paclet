(* Beginning of Notebook Content *)
Notebook[{
Cell["Vertex", "ObjectName",ExpressionUUID->"193acf11-f88b-6245-b637-df62b998632f"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Vertex", "[", "id", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"a1e74eb9-f6f1-4849-af8d-e282efb19c8f"],
 " ",
 "represents an unlabelled vertex whose unique identifier is the expression \
id."
}], "Usage",ExpressionUUID->"5a5e9a74-340a-f04c-b1a2-97cafc6b2bd3"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Vertex", "[", 
    RowBox[{"id", ",", " ", "lab"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"e6c8b526-63d1-db42-95e2-c77738a9c2cd"],
 " ",
 "represents a vertex with identifier id carrying the label lab."
}], "Usage",ExpressionUUID->"d466ef32-3314-7843-8ddf-32ed7a683acd"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"4ff9dedb-5c45-aa41-bd02-7e72df0e450b"],

Cell["\<\
The identifier id may be any Wolfram Language expression, and is what makes \
the vertex unique within a hypergraph.\
\>", "Notes",ExpressionUUID->"1eb78819-5479-294d-a564-c685d63edfb5"],

Cell["\<\
The label lab may be any expression. A label of None means no label, so \
Vertex[id, None] normalizes to the one-argument form Vertex[id].\
\>", "Notes",ExpressionUUID->"cca9a7b2-ced6-1745-8d0a-ca0f87c6b614"],

Cell["\<\
Because there is exactly one spelling per vertex, structural equality (===) \
on two Vertex objects already means that they are the same vertex.\
\>", "Notes",ExpressionUUID->"75d672ec-4e7d-1c4f-8f66-5cafe92c5358"],

Cell["\<\
Wherever a vertex is expected, a bare identifier may be given instead and is \
promoted to a Vertex automatically.\
\>", "Notes",ExpressionUUID->"f5ed720c-a5d9-be4a-a54d-36f73ba0f936"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"0172738b-3b44-024e-8862-813e7881af69"],

Cell["An unlabelled vertex and a labelled one:", "ExampleText",ExpressionUUID->"49f48cfc-5d50-9245-916f-301b21126489"],

Cell["{Vertex[1], Vertex[1, \"a\"]}", "Input",ExpressionUUID->"8c3ee6c7-6a94-b94c-8d99-3bc8b48b9d89"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Vertex", "[", "1", "]"}], ",", 
   RowBox[{"Vertex", "[", 
    RowBox[{"1", ",", "\<\"a\"\>"}], "]"}]}], "}"}]], "Output",ExpressionUUID->\
"1c1a623f-e057-8f42-b2d3-c1bc66c4d2d0"],

Cell["A label of None is dropped:", "ExampleText",ExpressionUUID->"c45219a2-333f-d847-bb01-061826065ec3"],

Cell["Vertex[1, None]", "Input",ExpressionUUID->"ba198f87-93ba-df40-862d-78dcdd2a83b1"],

Cell[BoxData[
 RowBox[{"Vertex", "[", "1", "]"}]], "Output",ExpressionUUID->"4efe17b6-62bc-3b43-b2e6-a53e827d2260"],

Cell["Identifiers are arbitrary expressions:", "ExampleText",ExpressionUUID->"e8989c3b-3c83-3a4a-8872-c354f3e13177"],

Cell["\<\
{Vertex[1], Vertex[\"a\"], Vertex[{1, 2}], Vertex[u], Vertex[f[3]]}\
\>", "Input",ExpressionUUID->"e5aba49f-86f5-1042-900d-86bda7535571"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Vertex", "[", "1", "]"}], ",", 
   RowBox[{"Vertex", "[", "\<\"a\"\>", "]"}], ",", 
   RowBox[{"Vertex", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}], "]"}], ",", 
   RowBox[{"Vertex", "[", "u", "]"}], ",", 
   RowBox[{"Vertex", "[", 
    RowBox[{"f", "[", "3", "]"}], "]"}]}], "}"}]], "Output",ExpressionUUID->\
"b69b4145-5c59-3e43-91bb-41eb02a52c34"],

Cell["\<\
Two vertices are identical exactly when they are the same vertex:\
\>", "ExampleText",ExpressionUUID->"c0afbbb8-5672-0942-b02e-24d325e76be6"],

Cell["{Vertex[1] === Vertex[1], Vertex[1] === Vertex[1, \"a\"]}", "Input",ExpressionUUID->"4a5a2e0f-7bae-3546-85b4-237189d7c462"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",ExpressionUUID->"595c16e1-\
561f-054c-9296-47e3b88694e9"],

Cell["Source", "NotesSection",ExpressionUUID->"deac7e95-0570-504d-8836-a724331a7cdf"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Vertices",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"361bc345-1e15-1845-8312-fca3d6358dba"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"3b4d0111-bfe4-9543-813b-41afefc29659"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["VertexID", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "04a12d5f-a7f7-ec4f-830b-e0a36c2261b0"],
 ", ",
 Cell[BoxData[
  StyleBox["VertexLabel", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "e3c257e2-7444-ed49-888a-1ac24ffca60f"],
 ", ",
 Cell[BoxData[
  StyleBox["VertexObjectQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "339a9dfc-fdac-744b-ad98-2ce7ca607989"],
 ", ",
 Cell[BoxData[
  StyleBox["Edge", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "e9d3f4a8-79c5-b449-b1e1-d59daa82b649"],
 ", ",
 Cell[BoxData[
  StyleBox["Hypergraph", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "58a77ad6-ca31-0649-ba81-00edaacd3a9b"]
}], "SeeAlso",ExpressionUUID->"c51ec8ba-c0ae-9a47-af77-a15050e34baf"]
},
