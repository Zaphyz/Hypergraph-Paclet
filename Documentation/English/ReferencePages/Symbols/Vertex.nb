(* Beginning of Notebook Content *)
Notebook[{
Cell["Vertex", "ObjectName",ExpressionUUID->"71b9d44a-7bfb-ef4f-93f8-164425256c58"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Vertex", "[", "id", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"9c0de7d8-e610-da47-b10a-1c9fcd465154"],
 " ",
 "represents an unlabelled vertex whose unique identifier is the expression \
id."
}], "Usage",ExpressionUUID->"1107889d-9ba8-0649-8b49-b2c2e45ad1bf"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"Vertex", "[", 
    RowBox[{"id", ",", " ", "lab"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"aafb0a55-c7ea-a14e-89a6-d1102983b981"],
 " ",
 "represents a vertex with identifier id carrying the label lab."
}], "Usage",ExpressionUUID->"a7e0d54e-a99e-ce47-9333-d0a3fb5e0ea2"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"a65c18cf-f012-7c45-b8a0-354cf05b91f9"],

Cell["\<\
The identifier id may be any Wolfram Language expression, and is what makes \
the vertex unique within a hypergraph.\
\>", "Notes",ExpressionUUID->"e868333f-28c3-2e45-9963-aeef8b306706"],

Cell["\<\
The label lab may be any expression. A label of None means no label, so \
Vertex[id, None] normalizes to the one-argument form Vertex[id].\
\>", "Notes",ExpressionUUID->"aea6bdf0-707a-6248-a34c-124dcc8c8209"],

Cell["\<\
Because there is exactly one spelling per vertex, structural equality (===) \
on two Vertex objects already means that they are the same vertex.\
\>", "Notes",ExpressionUUID->"18c6d5cb-bbc6-6e4d-8f16-f50195b187ad"],

Cell["\<\
Wherever a vertex is expected, a bare identifier may be given instead and is \
promoted to a Vertex automatically.\
\>", "Notes",ExpressionUUID->"224a3db4-8004-a54f-bc85-0fb7b74be5e8"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"f09b0fb6-d7b1-1449-a71e-866d0284063c"],

Cell["An unlabelled vertex and a labelled one:", "ExampleText",ExpressionUUID->"976c36be-b934-d642-88a3-2e473f72fe47"],

Cell["{Vertex[1], Vertex[1, \"a\"]}", "Input",ExpressionUUID->"2c248bb5-89ca-8443-b24a-9a3d358afac3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Vertex", "[", "1", "]"}], ",", 
   RowBox[{"Vertex", "[", 
    RowBox[{"1", ",", "\<\"a\"\>"}], "]"}]}], "}"}]], "Output",ExpressionUUID->\
"57e05001-757d-4548-bb21-2ee8dacb9a95"],

Cell["A label of None is dropped:", "ExampleText",ExpressionUUID->"5cb0756b-1851-7c46-a96d-7212309bf848"],

Cell["Vertex[1, None]", "Input",ExpressionUUID->"599f3035-fd0c-ad4f-8040-46200f0e6b5a"],

Cell[BoxData[
 RowBox[{"Vertex", "[", "1", "]"}]], "Output",ExpressionUUID->"c6df5b70-969f-9547-8144-53faacfb6ac8"],

Cell["Identifiers are arbitrary expressions:", "ExampleText",ExpressionUUID->"07b2e1d3-9d06-7b45-85dd-dd95dba97586"],

Cell["\<\
{Vertex[1], Vertex[\"a\"], Vertex[{1, 2}], Vertex[u], Vertex[f[3]]}\
\>", "Input",ExpressionUUID->"f6456d97-2285-b140-9ffb-005e728af0a8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Vertex", "[", "1", "]"}], ",", 
   RowBox[{"Vertex", "[", "\<\"a\"\>", "]"}], ",", 
   RowBox[{"Vertex", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}], "]"}], ",", 
   RowBox[{"Vertex", "[", "u", "]"}], ",", 
   RowBox[{"Vertex", "[", 
    RowBox[{"f", "[", "3", "]"}], "]"}]}], "}"}]], "Output",ExpressionUUID->\
"7b244587-6cd3-9348-9941-34a4e51b1872"],

Cell["\<\
Two vertices are identical exactly when they are the same vertex:\
\>", "ExampleText",ExpressionUUID->"18948e14-dc81-fa41-ad62-a2d07298ce19"],

Cell["{Vertex[1] === Vertex[1], Vertex[1] === Vertex[1, \"a\"]}", "Input",ExpressionUUID->"c32ae4c4-6584-3144-9385-a1545ebc0754"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",ExpressionUUID->"59b631f3-\
7c8a-b948-9f57-fb5216f2a990"],

Cell["Source", "NotesSection",ExpressionUUID->"ea7e393c-db7b-e647-bcd1-fb1218443c47"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Vertices",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"df4a245d-58fa-624d-bfa4-bbaa6c7831d5"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"1142b193-e58e-a046-bdd5-2a7984b12c1e"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["VertexID", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "56c2e35a-d891-a74f-a1b7-4dfd48da99c5"],
 ", ",
 Cell[BoxData[
  StyleBox["VertexLabel", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "4bb4f883-20c0-0f45-9535-bd2097a44385"],
 ", ",
 Cell[BoxData[
  StyleBox["VertexObjectQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "67e60ad9-910c-e744-94cc-a9c83f3d62dc"],
 ", ",
 Cell[BoxData[
  StyleBox["Edge", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "9d759354-521c-9c41-b175-e6f945e616f6"],
 ", ",
 Cell[BoxData[
  StyleBox["Hypergraph", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "24c73c24-74c6-2744-bf3a-b0a1499ca03b"]
}], "SeeAlso",ExpressionUUID->"96cf2645-ea28-9e45-85f1-d7f969f848f0"]
},
