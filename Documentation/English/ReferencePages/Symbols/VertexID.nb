Notebook[{
Cell["VertexID", "ObjectName",ExpressionUUID->"41f8af69-d2a2-5942-99d0-6b521db59a4f"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"VertexID", "[", "v", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"ed10f39f-a4b7-c345-8a91-c490d1b82f72"],
 " ",
 "gives the identifier of the vertex v."
}], "Usage",ExpressionUUID->"f26f8862-034d-174b-956c-5da42d8501a3"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"d8f80390-3913-ed48-b840-ec282f4b917e"],

Cell["\<\
The identifier is the first argument of the Vertex object, and is what \
distinguishes one vertex from another.\
\>", "Notes",ExpressionUUID->"39f42b10-a51d-0140-ae22-a33857215553"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"49e8ee74-11e5-1447-afed-96884f4a1c54"],

Cell["VertexID[Vertex[x, \"a\"]]", "Input",ExpressionUUID->"8b527c57-ff31-e14b-8b55-8cf5c32a0f9e"],

Cell[BoxData["x"], "Output",ExpressionUUID->"283fb18b-6368-5a4d-bf53-623e69e7a5b9"],

Cell["Reading the identifiers of a whole hypergraph:", "ExampleText",ExpressionUUID->"c32bb721-ec29-5147-9df7-7ec8b8e8742e"],

Cell["\<\
VertexID /@ VertexList[Hypergraph[{Edge[{1, 2}], Edge[{2, 3}]}]]\
\>", "Input",ExpressionUUID->"75845cc0-ea26-6449-8a66-cad6e4cd17af"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3"}], "}"}]], "Output",ExpressionUUID->\
"4b7d42d4-379c-2f45-bc72-a82c82a39e62"],

Cell["The same list is available as a hypergraph property:", "ExampleText",ExpressionUUID->"99f17b58-7e46-9347-bd0d-b61dbfed656c"],

Cell["Hypergraph[{Edge[{1, 2}], Edge[{2, 3}]}][\"VertexIDs\"]", "Input",ExpressionUUID->"fbffd2d1-6ed9-3048-bfea-4f7c2628abc2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3"}], "}"}]], "Output",ExpressionUUID->\
"317f45f0-2b56-6e4b-bbb0-d27269b5a68a"],

Cell["Source", "NotesSection",ExpressionUUID->"68b68b20-6750-b74d-be33-bde85d54b162"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Vertices",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"6af55eed-87b7-fe42-baa4-3571702bc852"],

