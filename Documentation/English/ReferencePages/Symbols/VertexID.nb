Notebook[{
Cell["VertexID", "ObjectName",ExpressionUUID->"331997ac-877b-d24b-8d1f-007a49eaa2e5"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"VertexID", "[", "v", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"0b12dae2-891d-0d44-86ab-38222442820b"],
 " ",
 "gives the identifier of the vertex v."
}], "Usage",ExpressionUUID->"baeda406-4f50-3c41-89a6-3267f2f06324"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"eaf00ba3-e216-4f4d-bd03-bbde98c69be6"],

Cell["\<\
The identifier is the first argument of the Vertex object, and is what \
distinguishes one vertex from another.\
\>", "Notes",ExpressionUUID->"f2be12ef-2872-c74c-8428-7b5ba3a25377"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"90b09913-7c43-044e-90c3-d0d3f9b01779"],

Cell["VertexID[Vertex[x, \"a\"]]", "Input",ExpressionUUID->"52b0c38c-99b0-284f-8a5c-2fd26056030a"],

Cell[BoxData["x"], "Output",ExpressionUUID->"b3b0e4d5-ce81-3e4b-a79d-6fd4b8b63fee"],

Cell["Reading the identifiers of a whole hypergraph:", "ExampleText",ExpressionUUID->"bc08e9d6-c3ee-d743-9de0-6f749f4f3996"],

Cell["\<\
VertexID /@ VertexList[Hypergraph[{Edge[{1, 2}], Edge[{2, 3}]}]]\
\>", "Input",ExpressionUUID->"46fb7ebb-4c9a-c046-a715-2f85065c5dd2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3"}], "}"}]], "Output",ExpressionUUID->\
"017b7bec-e176-bf46-9e3c-da9aa142c4ed"],

Cell["The same list is available as a hypergraph property:", "ExampleText",ExpressionUUID->"7cd321ff-1d43-9f4a-b405-4953f57962be"],

Cell["Hypergraph[{Edge[{1, 2}], Edge[{2, 3}]}][\"VertexIDs\"]", "Input",ExpressionUUID->"9ffbeadf-475d-8342-9eda-968e27e19ef3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3"}], "}"}]], "Output",ExpressionUUID->\
"96729b2b-bcf7-eb48-a332-c39c73a485eb"],

Cell["Source", "NotesSection",ExpressionUUID->"8a79ff71-aa1b-174d-9963-dc2292fd472c"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Vertices",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"29754005-ac75-a944-9c78-3da16f89c615"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"2dd40783-69d4-0844-b10c-8ae0481fa083"],

