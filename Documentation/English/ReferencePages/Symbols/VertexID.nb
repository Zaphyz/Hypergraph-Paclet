Notebook[{
Cell["VertexID", "ObjectName",ExpressionUUID->"680b15ec-dc9c-aa42-9356-9f2c829f3b80"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"VertexID", "[", "v", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"18c7ae28-427a-7b42-975d-5663998b06a3"],
 " ",
 "gives the identifier of the vertex v."
}], "Usage",ExpressionUUID->"a7a6f078-0fc2-1b4e-9054-073fb94e7fcb"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"7390139e-852d-f24b-a183-28395f7df6dc"],

Cell["\<\
The identifier is the first argument of the Vertex object, and is what \
distinguishes one vertex from another.\
\>", "Notes",ExpressionUUID->"2e79a8ea-dd8d-bd47-a8e7-d62031da0556"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"63c79e73-021d-284f-95e3-eb62e8bdd612"],

Cell["VertexID[Vertex[x, \"a\"]]", "Input",ExpressionUUID->"278ed096-23fe-ef45-a5b3-05a4c8a27b7d"],

Cell[BoxData["x"], "Output",ExpressionUUID->"63544cfb-ddd6-c044-8cc3-3a28d996365f"],

Cell["Reading the identifiers of a whole hypergraph:", "ExampleText",ExpressionUUID->"377b0a4c-8617-7e44-829c-05fa9f39e0f9"],

Cell["\<\
VertexID /@ VertexList[Hypergraph[{Edge[{1, 2}], Edge[{2, 3}]}]]\
\>", "Input",ExpressionUUID->"4e54b86b-9113-434e-b620-a36d3be055ec"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3"}], "}"}]], "Output",ExpressionUUID->\
"5f940519-dfc2-8646-a3c2-fa4617167dc2"],

Cell["The same list is available as a hypergraph property:", "ExampleText",ExpressionUUID->"fe80f9c2-6dbc-2c4b-b24e-1406deff55f5"],

Cell["Hypergraph[{Edge[{1, 2}], Edge[{2, 3}]}][\"VertexIDs\"]", "Input",ExpressionUUID->"9634b2eb-d150-db4a-a43e-23f2aeb1da6a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3"}], "}"}]], "Output",ExpressionUUID->\
"d94d4983-9432-454b-aff4-ed8b0a966a06"],

Cell["Source", "NotesSection",ExpressionUUID->"fb62a776-bf98-144b-a738-6ee10157c6ff"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Vertices",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"0e30e3ea-a727-5a40-96b9-9243b19e4573"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"60de4e15-8ae4-ff44-bb52-f1f9a1c0053a"],

