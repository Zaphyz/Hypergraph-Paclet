Notebook[{
Cell["VertexID", "ObjectName",ExpressionUUID->"60fb7825-c3c7-6045-96de-ac7ccb05fbf4"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"VertexID", "[", "v", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"8c5c4a6f-114b-8843-9782-7738a1018a2a"],
 " ",
 "gives the identifier of the vertex v."
}], "Usage",ExpressionUUID->"4101062c-bc57-4644-8d77-bf05d67a1a5c"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"b6c2ad62-1809-284b-95cf-568fceca2f11"],

Cell["\<\
The identifier is the first argument of the Vertex object, and is what \
distinguishes one vertex from another.\
\>", "Notes",ExpressionUUID->"453ffa62-3161-064b-a13d-ec895d633840"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"c0b1d5a3-3c65-8c40-bbbf-42fd140e4d50"],

Cell["VertexID[Vertex[x, \"a\"]]", "Input",ExpressionUUID->"58ba68bb-b20a-7345-ad0b-43b08d01ac2a"],

Cell[BoxData["x"], "Output",ExpressionUUID->"f1cc110f-76a0-3f49-b061-25e6f42adc9b"],

Cell["Reading the identifiers of a whole hypergraph:", "ExampleText",ExpressionUUID->"e388ea9f-e38f-6a40-b1ac-0a8d787b5d06"],

Cell["\<\
VertexID /@ VertexList[Hypergraph[{Edge[{1, 2}], Edge[{2, 3}]}]]\
\>", "Input",ExpressionUUID->"5e0c395e-59c4-2947-b5aa-185b4b41ba0b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3"}], "}"}]], "Output",ExpressionUUID->\
"9d49517f-8514-504c-abe3-33b1e25d8808"],

Cell["The same list is available as a hypergraph property:", "ExampleText",ExpressionUUID->"58f6f3fc-3558-0e4a-af51-386e9733920f"],

Cell["Hypergraph[{Edge[{1, 2}], Edge[{2, 3}]}][\"VertexIDs\"]", "Input",ExpressionUUID->"c0a94b39-a358-c64d-95f8-ab2a850a8143"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3"}], "}"}]], "Output",ExpressionUUID->\
"b3cb2a9f-18f5-0a4a-bf6a-d37cf991496c"],

