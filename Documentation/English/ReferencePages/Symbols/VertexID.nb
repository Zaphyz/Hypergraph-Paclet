Notebook[{
Cell["VertexID", "ObjectName",ExpressionUUID->"31568fd3-bd58-8640-b4b5-e541b542cf7f"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"VertexID", "[", "v", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"41a1ca7b-d27f-ac4e-b287-a973aca921f3"],
 " ",
 "gives the identifier of the vertex v."
}], "Usage",ExpressionUUID->"e4f54e55-2687-994f-9bbd-fd0d791afcf3"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"08d76940-f2cb-cd41-8a35-a8f47b7450da"],

Cell["\<\
The identifier is the first argument of the Vertex object, and is what \
distinguishes one vertex from another.\
\>", "Notes",ExpressionUUID->"92f9f6ca-5225-dd42-9adf-27f858b7fdc6"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"30e338e4-d1ac-0846-b987-966823bd4062"],

Cell["VertexID[Vertex[x, \"a\"]]", "Input",ExpressionUUID->"59de28e7-b144-c542-8229-86f688a32a62"],

Cell[BoxData["x"], "Output",ExpressionUUID->"f7b8bd0d-b8dd-ee4a-ab29-37adf9546a23"],

Cell["Reading the identifiers of a whole hypergraph:", "ExampleText",ExpressionUUID->"3539b87c-d555-4245-af8a-5fbd0dc86e01"],

Cell["\<\
VertexID /@ VertexList[Hypergraph[{Edge[{1, 2}], Edge[{2, 3}]}]]\
\>", "Input",ExpressionUUID->"cdc4d04b-8acc-2d4d-b730-0ee56ce3012e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3"}], "}"}]], "Output",ExpressionUUID->\
"a34653e3-e919-0a4d-8fd0-a0c3958af041"],

Cell["The same list is available as a hypergraph property:", "ExampleText",ExpressionUUID->"a15f033a-b5d9-b74a-aa78-ebd8b6aedad0"],

Cell["Hypergraph[{Edge[{1, 2}], Edge[{2, 3}]}][\"VertexIDs\"]", "Input",ExpressionUUID->"ec3712c4-4152-3648-9221-9aa2f21a3807"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3"}], "}"}]], "Output",ExpressionUUID->\
"c49e00d1-6418-fe41-b293-53421c1ec314"],

Cell["Source", "NotesSection",ExpressionUUID->"2e07f079-c801-0448-9867-e12b1533ea44"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Vertices",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"ae6f82d9-d99f-1d4a-a1fa-ed0ec225da17"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"55894dc6-fb95-e444-aa71-02e16ddcb61a"],

