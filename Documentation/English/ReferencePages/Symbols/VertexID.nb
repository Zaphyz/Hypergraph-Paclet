Notebook[{
Cell["VertexID", "ObjectName",ExpressionUUID->"d76b992b-4cd9-e04a-a478-8606d0766a74"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"VertexID", "[", "v", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"1679d327-b066-0343-9cea-e28d71ca9fc9"],
 " ",
 "gives the identifier of the vertex v."
}], "Usage",ExpressionUUID->"345f5f2e-b3a5-824d-aaa6-1c21182acde3"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"b65e5998-8a7f-4347-876c-4426414801b6"],

Cell["\<\
The identifier is the first argument of the Vertex object, and is what \
distinguishes one vertex from another.\
\>", "Notes",ExpressionUUID->"3879d7b7-cc76-794d-9001-ab3904ca39dc"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"1dce0acd-d0f4-7641-92dc-5b8ef5bcf466"],

Cell["VertexID[Vertex[x, \"a\"]]", "Input",ExpressionUUID->"5e3e2b3b-5bad-834a-b98b-f3844116a638"],

Cell[BoxData["x"], "Output",ExpressionUUID->"6e19bca5-79eb-4749-89f9-114267576b73"],

Cell["Reading the identifiers of a whole hypergraph:", "ExampleText",ExpressionUUID->"ae374df5-0d5f-534d-8ce1-ed2b224f85e7"],

Cell["\<\
VertexID /@ VertexList[Hypergraph[{Edge[{1, 2}], Edge[{2, 3}]}]]\
\>", "Input",ExpressionUUID->"dd8e0e92-6ccb-a04a-9e98-326997e91b42"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3"}], "}"}]], "Output",ExpressionUUID->\
"6b6214dd-d11c-5d42-9c2c-16508eb87e65"],

Cell["The same list is available as a hypergraph property:", "ExampleText",ExpressionUUID->"75fccd4b-4f98-934d-b0bf-985d6ece437f"],

Cell["Hypergraph[{Edge[{1, 2}], Edge[{2, 3}]}][\"VertexIDs\"]", "Input",ExpressionUUID->"434f224b-cab2-eb46-b40a-3e5907a6d491"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3"}], "}"}]], "Output",ExpressionUUID->\
"b3c33a7c-8d01-9a4b-b6d4-3ca989592ec1"],

Cell["Source", "NotesSection",ExpressionUUID->"a2bd3f73-dad5-8149-a6a8-025fbf9e9a33"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Vertices",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"9d271fc0-1267-b74f-bb35-bcb5743a9f06"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"278cc1c0-cf3b-384b-a390-e37e88f1e957"],

