 Cell[BoxData[
  StyleBox["Vertex", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "d1b8da34-64f4-5b4d-9dc1-055f37854cdf"],
 ", ",
 Cell[BoxData[
  StyleBox["VertexLabel", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "731134fe-c3e7-6b43-b565-c01f2f4f8935"],
 ", ",
 Cell[BoxData[
  StyleBox["VertexObjectQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "613c6670-2bde-6442-bc7a-2e667ec045ae"]
}], "SeeAlso",ExpressionUUID->"4f348293-81a1-2f46-8f79-a08b959bdc88"]
