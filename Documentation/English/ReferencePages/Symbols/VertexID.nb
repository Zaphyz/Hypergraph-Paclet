Notebook[{
Cell["VertexID", "ObjectName",ExpressionUUID->"d41c1e40-ae93-034f-852e-8065dae0dbf9"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"VertexID", "[", "v", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"ea8f4ae6-a451-474a-96c5-3e61777f28af"],
 " ",
 "gives the identifier of the vertex v."
}], "Usage",ExpressionUUID->"f02446a5-2f35-0240-a8f7-18b4c37ed3c6"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"913b6e2e-165d-dd40-9d09-b5d25f8b275b"],

Cell["\<\
The identifier is the first argument of the Vertex object, and is what \
distinguishes one vertex from another.\
\>", "Notes",ExpressionUUID->"141b3421-47b9-db49-b4e8-68effa1b63b1"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"4ce7c73a-9b7f-f543-afc9-de4f02908697"],

Cell["VertexID[Vertex[x, \"a\"]]", "Input",ExpressionUUID->"00dfacb5-4391-2c45-8e1a-9140e09c3c6d"],

Cell[BoxData["x"], "Output",ExpressionUUID->"3c245a1d-aa08-f840-96cd-2f490f987cc1"],

Cell["Reading the identifiers of a whole hypergraph:", "ExampleText",ExpressionUUID->"ae4efe42-2c11-5b4b-b7d0-b5d68815e585"],

Cell["\<\
VertexID /@ VertexList[Hypergraph[{Edge[{1, 2}], Edge[{2, 3}]}]]\
\>", "Input",ExpressionUUID->"eb089979-e4c1-7b4a-a797-2ce9cd84b89b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3"}], "}"}]], "Output",ExpressionUUID->\
"871e4231-0cfe-1c4f-ab63-dab72310fb1b"],

Cell["The same list is available as a hypergraph property:", "ExampleText",ExpressionUUID->"d9b60fc2-a827-f744-a931-815248b0eb09"],

Cell["Hypergraph[{Edge[{1, 2}], Edge[{2, 3}]}][\"VertexIDs\"]", "Input",ExpressionUUID->"4de19df2-0976-434b-a4c0-615aace8bbb2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3"}], "}"}]], "Output",ExpressionUUID->\
"ee1eb077-b6cc-934c-8f32-617989363b3a"],

Cell["Source", "NotesSection",ExpressionUUID->"936a7929-274c-d443-ab94-7b0694d27056"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Vertices",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"44ef641f-658a-3149-a320-2b354b29970a"],

