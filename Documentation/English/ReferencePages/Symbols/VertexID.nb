Notebook[{
Cell["VertexID", "ObjectName",ExpressionUUID->"00e5cf35-bde9-654c-8765-87c5d13da13d"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"VertexID", "[", "v", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"e893dbc7-ba40-5843-8d4b-a967a4c49b28"],
 " ",
 "gives the identifier of the vertex v."
}], "Usage",ExpressionUUID->"c1f96f82-fa4e-9249-b505-585d4b8244cd"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"df351726-7357-684b-8fa3-dff63c4de324"],

Cell["\<\
The identifier is the first argument of the Vertex object, and is what \
distinguishes one vertex from another.\
\>", "Notes",ExpressionUUID->"5b89c665-5dea-184f-b402-a01fab9b3c23"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"883e1ed5-2331-8f48-bcf2-602f56fdba90"],

Cell["VertexID[Vertex[x, \"a\"]]", "Input",ExpressionUUID->"3b13a6a5-cc88-5d45-b480-8786dca9d63c"],

Cell[BoxData["x"], "Output",ExpressionUUID->"fe16de0a-4bc7-6642-a79c-c33285437402"],

Cell["Reading the identifiers of a whole hypergraph:", "ExampleText",ExpressionUUID->"05bf4131-52d2-dd49-af29-747a247b02d4"],

Cell["\<\
VertexID /@ VertexList[Hypergraph[{Edge[{1, 2}], Edge[{2, 3}]}]]\
\>", "Input",ExpressionUUID->"fa272876-ee23-d448-abce-95a648863828"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3"}], "}"}]], "Output",ExpressionUUID->\
"4aab0443-f84e-fb42-b969-7c4ff45260bc"],

Cell["The same list is available as a hypergraph property:", "ExampleText",ExpressionUUID->"02aba73a-2d83-9e48-8c76-366ce40bcc46"],

Cell["Hypergraph[{Edge[{1, 2}], Edge[{2, 3}]}][\"VertexIDs\"]", "Input",ExpressionUUID->"f9d98e1d-a7a7-eb4b-b791-3aa31e547842"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3"}], "}"}]], "Output",ExpressionUUID->\
"43350086-9698-7140-9846-dc219fde7611"],

Cell["Source", "NotesSection",ExpressionUUID->"141a709a-ba4a-c34c-bc32-2c361f4c45c8"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Vertices",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"b4a03dd5-6308-f74e-955f-0c43d9107781"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"10365b7b-cd8d-8144-8069-31511ee2ba08"],

