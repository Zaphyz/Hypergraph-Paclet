Notebook[{
Cell["VertexID", "ObjectName",ExpressionUUID->"a0cbcfb5-457b-e34d-baae-d73a4d89cc45"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"VertexID", "[", "v", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"c0c95a55-e264-a745-91fc-8d7160016f3c"],
 " ",
 "gives the identifier of the vertex v."
}], "Usage",ExpressionUUID->"a5411769-266a-414a-abc4-02539940d1b8"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"4dbdecfa-cde9-3043-ab91-f9231750e682"],

Cell["\<\
The identifier is the first argument of the Vertex object, and is what \
distinguishes one vertex from another.\
\>", "Notes",ExpressionUUID->"be6ea1e1-bfb9-4a4b-8276-fa38eeca5e10"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"b9d626aa-d3ef-4640-83e7-cfd49702d04b"],

Cell["VertexID[Vertex[x, \"a\"]]", "Input",ExpressionUUID->"9a217798-a0e5-184f-9b14-741b8d9853a4"],

Cell[BoxData["x"], "Output",ExpressionUUID->"e4bb2089-c1d6-5e43-9e90-c870b6830bef"],

Cell["Reading the identifiers of a whole hypergraph:", "ExampleText",ExpressionUUID->"2ebdbd16-ad27-d64d-85b2-75d06cd3087c"],

Cell["\<\
VertexID /@ VertexList[Hypergraph[{Edge[{1, 2}], Edge[{2, 3}]}]]\
\>", "Input",ExpressionUUID->"90338834-e0ac-5844-8ed0-9198323049e5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3"}], "}"}]], "Output",ExpressionUUID->\
"ad87ebb1-7333-a141-a518-6979ede4cf7d"],

Cell["The same list is available as a hypergraph property:", "ExampleText",ExpressionUUID->"6decd79d-0715-7744-934a-64accdfa33e8"],

Cell["Hypergraph[{Edge[{1, 2}], Edge[{2, 3}]}][\"VertexIDs\"]", "Input",ExpressionUUID->"16182caf-4113-b344-843d-7617ca6789cc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3"}], "}"}]], "Output",ExpressionUUID->\
"066f1fc3-d1e0-7444-ad5f-f36d9c3814a7"],

Cell["Source", "NotesSection",ExpressionUUID->"2c250410-2638-a745-896a-ed06e77614de"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Vertices",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"2c2f1cdf-c1e0-644d-8083-b5e5351d96aa"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"77eb25f7-a213-b046-9d9d-260d284cbdce"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["Vertex", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "fc8c9282-e7ae-7b41-9c64-b16881007a85"],
 ", ",
 Cell[BoxData[
  StyleBox["VertexLabel", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "fc185d11-fea9-b84f-a8ef-61d309de8ca5"],
 ", ",
 Cell[BoxData[
  StyleBox["VertexObjectQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "2eb0bfd6-c180-b847-9bf6-22541b284a51"]
}], "SeeAlso",ExpressionUUID->"da873b7d-6c13-184b-910e-a95507167073"]
