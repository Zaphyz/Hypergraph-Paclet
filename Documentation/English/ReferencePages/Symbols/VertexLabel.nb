Notebook[{
Cell["VertexLabel", "ObjectName",ExpressionUUID->"389c5d24-a0e1-d841-886c-d10bbf82be36"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"VertexLabel", "[", "v", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"4c6b60e5-8327-414e-9447-5a2eef6ac342"],
 " ",
 "gives the label of the vertex v, or None if it is unlabelled."
}], "Usage",ExpressionUUID->"ed09ba86-1036-fd4e-8089-f8d8a8481e50"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"68519769-ee3d-e547-8dcd-9503acab7e47"],

Cell["\<\
A vertex identifier denotes one vertex, so it carries at most one label.\
\>", "Notes",ExpressionUUID->"2fde8c83-c4b4-d94b-bdb4-a9fd839f1122"],

Cell["\<\
Within a hypergraph, a label attached to any occurrence of a vertex \
propagates to every other occurrence of that identifier.\
\>", "Notes",ExpressionUUID->"391a4954-60d3-e141-ac26-949a8aab5fc3"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"aa1e9e10-6da8-1148-8e19-fd24c656fe04"],

Cell["{VertexLabel[Vertex[1, \"a\"]], VertexLabel[Vertex[1]]}", "Input",ExpressionUUID->"199a944b-de90-c04f-ba73-0a2699127664"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"a\"\>", ",", "None"}], "}"}]], "Output",ExpressionUUID->\
"7e2da958-3e04-fa4f-b6da-387caff61cd5"],

Cell["\<\
The labels of a whole hypergraph, in the order of its vertex list:\
\>", "ExampleText",ExpressionUUID->"ff170874-db5f-854e-b305-6324c3455c03"],

Cell["\<\
Hypergraph[{Vertex[1, \"a\"], Vertex[2, \"b\"], 3}, {{1, 2}, {2, \
3}}][\"VertexLabels\"]\
\>", "Input",ExpressionUUID->"7714e090-3d72-5c4d-91f2-f0ca277f386a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"None", ",", "\<\"a\"\>", ",", "\<\"b\"\>"}], "}"}]], "Output",Expre\
ssionUUID->"ef56ba83-2c40-1848-8e3c-5c8e8bc24778"],

Cell["Source", "NotesSection",ExpressionUUID->"76947954-dcbd-224c-bd01-30a5177876ef"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Vertices",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"1caafadd-3bcb-5f46-afc6-0b1452114b89"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"3a90c538-a44c-cc4f-b8c3-1f9b2a249c98"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["Vertex", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "26cfa82d-64f7-7243-884c-4e6ba98f889c"],
 ", ",
 Cell[BoxData[
  StyleBox["VertexID", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "d61f786d-1abd-874c-9819-ad3d75ec7974"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeLabel", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "5c1a0564-82da-b243-8a54-2e48a1290668"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphSkeleton", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"69dcf90b-60e8-4945-af12-1a5c827ec86e"]
}], "SeeAlso",ExpressionUUID->"bdb6992c-4b6f-9d4c-bae8-942e271908c9"]
},
