Notebook[{
Cell["VertexLabel", "ObjectName",ExpressionUUID->"f3daf23c-500e-dd4b-af6f-7202c3155a64"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"VertexLabel", "[", "v", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"250d56f5-e0d6-884e-85bd-b82b2a91fb7c"],
 " ",
 "gives the label of the vertex v, or None if it is unlabelled."
}], "Usage",ExpressionUUID->"4c34f739-9c5f-1846-9fd2-0446f1548e74"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"e69facbf-fc88-644f-9caf-8c0e8b2e7e49"],

Cell["\<\
A vertex identifier denotes one vertex, so it carries at most one label.\
\>", "Notes",ExpressionUUID->"ce3c9684-d8e5-ac45-a2f6-2dfd8244c281"],

Cell["\<\
Within a hypergraph, a label attached to any occurrence of a vertex \
propagates to every other occurrence of that identifier.\
\>", "Notes",ExpressionUUID->"2227a060-2fa6-0744-afec-82fb9e1076fd"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"c5086f75-f2d5-b74b-a5be-ed5499778dd1"],

Cell["{VertexLabel[Vertex[1, \"a\"]], VertexLabel[Vertex[1]]}", "Input",ExpressionUUID->"8d062fa2-0225-1043-910e-cb441f47199e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"a\"\>", ",", "None"}], "}"}]], "Output",ExpressionUUID->\
"ae7aba12-8d1c-5d4a-b584-09ac7ddcbaa1"],

Cell["\<\
The labels of a whole hypergraph, in the order of its vertex list:\
\>", "ExampleText",ExpressionUUID->"03cb9d2e-c1ba-794c-87a0-bdc74befb2eb"],

Cell["\<\
Hypergraph[{Vertex[1, \"a\"], Vertex[2, \"b\"], 3}, {{1, 2}, {2, \
3}}][\"VertexLabels\"]\
\>", "Input",ExpressionUUID->"14cc4d8a-5741-e04c-a016-470fdd7c230d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"None", ",", "\<\"a\"\>", ",", "\<\"b\"\>"}], "}"}]], "Output",Expre\
ssionUUID->"7001f37e-4882-6b41-b7d3-abb337d54e08"],

Cell["Source", "NotesSection",ExpressionUUID->"1413e72d-ef92-4e49-8198-afd2d595e6fb"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Vertices",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"83c29314-7608-ee47-906d-e89b5f75cab0"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"6e8af8ea-06e8-6b4a-9c17-ab43423c69d7"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["Vertex", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "16e182f5-921a-5943-b845-9928c894659b"],
 ", ",
 Cell[BoxData[
  StyleBox["VertexID", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "de037878-d411-0c46-920e-513a80073891"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeLabel", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "d2f1b566-8289-d047-bd0d-1c5b3bc58515"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphSkeleton", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"c0e73977-79e1-4242-9fe3-3c2e102af17d"]
}], "SeeAlso",ExpressionUUID->"58abecbf-1d4e-1140-abbb-dd9de875e8fa"]
