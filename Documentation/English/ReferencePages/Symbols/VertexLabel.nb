Notebook[{
Cell["VertexLabel", "ObjectName",ExpressionUUID->"ae657dc1-c31c-a846-91f8-a56856841f82"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"VertexLabel", "[", "v", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"4dee0cc9-c76e-e841-9999-7d4ad7fa21fd"],
 " ",
 "gives the label of the vertex v, or None if it is unlabelled."
}], "Usage",ExpressionUUID->"064261e0-df90-b54d-91c2-79203a0e6ece"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"d19a4ee9-b5c6-ab4f-a3de-e02a03a3f2ac"],

Cell["\<\
A vertex identifier denotes one vertex, so it carries at most one label.\
\>", "Notes",ExpressionUUID->"8b05fbd8-9bc3-d948-a459-b52969413840"],

Cell["\<\
Within a hypergraph, a label attached to any occurrence of a vertex \
propagates to every other occurrence of that identifier.\
\>", "Notes",ExpressionUUID->"45c79722-1555-eb4f-b5f3-2adfff15849a"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"9fc78ea6-8586-8c48-8023-0f510ca6078e"],

Cell["{VertexLabel[Vertex[1, \"a\"]], VertexLabel[Vertex[1]]}", "Input",ExpressionUUID->"c781b19b-e326-7247-89e2-7c98347bdb68"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"a\"\>", ",", "None"}], "}"}]], "Output",ExpressionUUID->\
"65ba7b6a-8f78-884b-9848-c571db8155ae"],

Cell["\<\
The labels of a whole hypergraph, in the order of its vertex list:\
\>", "ExampleText",ExpressionUUID->"c05b173e-82d0-6449-a673-961a17f137ea"],

Cell["\<\
Hypergraph[{Vertex[1, \"a\"], Vertex[2, \"b\"], 3}, {{1, 2}, {2, \
3}}][\"VertexLabels\"]\
\>", "Input",ExpressionUUID->"10bdeb81-5375-8847-8c4e-e1cba573df2e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"None", ",", "\<\"a\"\>", ",", "\<\"b\"\>"}], "}"}]], "Output",Expre\
ssionUUID->"d2ee5a4a-1d89-2747-b8c7-445a7a766330"],

Cell["Source", "NotesSection",ExpressionUUID->"1c923b8e-04e4-6849-abbb-2092c305a936"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Vertices",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"3f6edced-3aa4-1948-a1d7-23e56e4c0a9a"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"db76221b-53fd-ae4d-b113-4e44746d3cb2"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["Vertex", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "37adfc12-2568-2d4e-af5c-36c141d15ed9"],
 ", ",
 Cell[BoxData[
  StyleBox["VertexID", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "c9d9b495-fe69-e941-abe4-fef1e9670c49"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeLabel", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "67e15e74-37c9-ef48-b950-6d217ff5875c"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphSkeleton", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"cf00320a-b0f6-f440-83db-1aefb4b3798c"]
}], "SeeAlso",ExpressionUUID->"be12e884-a7b2-0042-bf47-ec5a82c8c0d8"]
},
