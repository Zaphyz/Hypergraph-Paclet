Notebook[{
Cell["VertexLabel", "ObjectName",ExpressionUUID->"02dfb46e-724d-9d4c-92e4-685b7f6434e0"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"VertexLabel", "[", "v", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"f57544d1-f772-9348-8c14-1dea509a4a7b"],
 " ",
 "gives the label of the vertex v, or None if it is unlabelled."
}], "Usage",ExpressionUUID->"09411cb9-1747-6749-b12c-0801d442b6b5"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"3489484c-b470-ed47-98ef-89d20c8ad788"],

Cell["\<\
A vertex identifier denotes one vertex, so it carries at most one label.\
\>", "Notes",ExpressionUUID->"a4c6d752-4c69-f245-af0c-d7a9e156b43d"],

Cell["\<\
Within a hypergraph, a label attached to any occurrence of a vertex \
propagates to every other occurrence of that identifier.\
\>", "Notes",ExpressionUUID->"568d3dd7-fce8-2848-8311-2aa086202402"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"abf0b350-6b69-3246-bf9d-39d57d493e39"],

Cell["{VertexLabel[Vertex[1, \"a\"]], VertexLabel[Vertex[1]]}", "Input",ExpressionUUID->"d5059d9a-289f-9a49-ba7b-4e01cc11c7b4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"a\"\>", ",", "None"}], "}"}]], "Output",ExpressionUUID->\
"cc0b8f69-cb46-274b-8733-13190375793e"],

Cell["\<\
The labels of a whole hypergraph, in the order of its vertex list:\
\>", "ExampleText",ExpressionUUID->"7635bba1-6520-eb48-bb34-812e7211df4d"],

Cell["\<\
Hypergraph[{Vertex[1, \"a\"], Vertex[2, \"b\"], 3}, {{1, 2}, {2, \
3}}][\"VertexLabels\"]\
\>", "Input",ExpressionUUID->"c3f31460-b16c-4543-8c24-6092cae06e18"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"None", ",", "\<\"a\"\>", ",", "\<\"b\"\>"}], "}"}]], "Output",Expre\
ssionUUID->"e0a0dad4-1f56-3145-a37f-61249d873d35"],

Cell["Source", "NotesSection",ExpressionUUID->"b63e43d4-6830-b049-9cf2-eea1dc1e4408"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Vertices",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"8fa0171d-9c54-3d42-b7f0-e62ef731acce"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"3044bb3f-c017-4d4e-a5cf-f2f1befe71b7"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["Vertex", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "9757477e-1deb-da4c-a634-862dad62f5f5"],
 ", ",
 Cell[BoxData[
  StyleBox["VertexID", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "87a78e80-c05d-734b-ab7a-4a690f7424f2"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeLabel", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "ec0a3fd2-704a-c54c-a918-b2d3ae77e68b"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphSkeleton", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"4afa2fbb-c2c1-de42-906a-a0034a991ab2"]
}], "SeeAlso",ExpressionUUID->"e19591bf-9234-e24e-a50d-4c10b260aaa0"]
