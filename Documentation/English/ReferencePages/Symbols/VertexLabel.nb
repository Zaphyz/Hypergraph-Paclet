Notebook[{
Cell["VertexLabel", "ObjectName",ExpressionUUID->"791c0af2-1a40-204f-b2eb-37619234b55c"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"VertexLabel", "[", "v", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"e9043732-4e31-b94d-aaca-10e7b32db12e"],
 " ",
 "gives the label of the vertex v, or None if it is unlabelled."
}], "Usage",ExpressionUUID->"8cd9e910-0763-254a-9418-1ccea845cf20"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"8b0d8a07-d9a3-d64c-8f3d-db730312b38f"],

Cell["\<\
A vertex identifier denotes one vertex, so it carries at most one label.\
\>", "Notes",ExpressionUUID->"bd4afb1c-7068-574a-a5c0-84f683404a42"],

Cell["\<\
Within a hypergraph, a label attached to any occurrence of a vertex \
propagates to every other occurrence of that identifier.\
\>", "Notes",ExpressionUUID->"f8a74db9-bc1d-0a40-8a38-6f53b47850ac"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"563365dd-8ffa-204d-be78-0a8c2fe67b05"],

Cell["{VertexLabel[Vertex[1, \"a\"]], VertexLabel[Vertex[1]]}", "Input",ExpressionUUID->"3c829522-58a9-3646-a536-2ced86bda8ed"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"a\"\>", ",", "None"}], "}"}]], "Output",ExpressionUUID->\
"1879d539-4252-f048-bd48-89d07381461c"],

Cell["\<\
The labels of a whole hypergraph, in the order of its vertex list:\
\>", "ExampleText",ExpressionUUID->"a3416114-f019-2343-ac43-1ec5c20f5dc7"],

Cell["\<\
Hypergraph[{Vertex[1, \"a\"], Vertex[2, \"b\"], 3}, {{1, 2}, {2, \
3}}][\"VertexLabels\"]\
\>", "Input",ExpressionUUID->"ee0d4938-f100-0b46-a439-1ad4847cfd45"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"None", ",", "\<\"a\"\>", ",", "\<\"b\"\>"}], "}"}]], "Output",Expre\
ssionUUID->"4bfbb887-6aec-cd4f-ab64-805113262b47"],

Cell["Source", "NotesSection",ExpressionUUID->"f15bebc4-5617-c34e-802a-8f4a93801fd2"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Vertices",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"7143a3d6-5e5a-9548-ae44-1c9ffa87c465"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"422e4f79-5b89-d548-9d63-1e71d65f7406"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["Vertex", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "4c016319-90c1-9740-8d60-45de7ce340ee"],
 ", ",
 Cell[BoxData[
  StyleBox["VertexID", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "4db5cfa4-590a-9249-8e3a-bb157d1473e5"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeLabel", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "36634f92-c372-ee4e-8a48-6902c77f3508"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphSkeleton", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"dfaed420-b25d-3040-95d1-6c0ab49ffba6"]
}], "SeeAlso",ExpressionUUID->"0e0b26fc-0c58-8a43-9faf-f0da3259aa45"]
