Notebook[{
Cell["VertexLabel", "ObjectName",ExpressionUUID->"c0ce653a-acbc-7e4e-a7dd-205b71071e4a"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"VertexLabel", "[", "v", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"fba55290-3529-9d4b-8540-66bf220108c9"],
 " ",
 "gives the label of the vertex v, or None if it is unlabelled."
}], "Usage",ExpressionUUID->"f935dda4-5abf-4946-919f-3285ab2be3ae"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"0f63666a-4b81-b146-beaf-385f04c82e33"],

Cell["\<\
A vertex identifier denotes one vertex, so it carries at most one label.\
\>", "Notes",ExpressionUUID->"82c5112e-e011-9c4b-992e-91247c982b94"],

Cell["\<\
Within a hypergraph, a label attached to any occurrence of a vertex \
propagates to every other occurrence of that identifier.\
\>", "Notes",ExpressionUUID->"c74b39ba-20f2-224e-af11-601cd984cc20"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"037a6518-9d93-5049-9bb8-810854544496"],

Cell["{VertexLabel[Vertex[1, \"a\"]], VertexLabel[Vertex[1]]}", "Input",ExpressionUUID->"19d8cdac-41bc-5241-ae48-73f1af2eed0d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"a\"\>", ",", "None"}], "}"}]], "Output",ExpressionUUID->\
"6b445f4f-fd9e-e745-8d05-c0d5b81e0275"],

Cell["\<\
The labels of a whole hypergraph, in the order of its vertex list:\
\>", "ExampleText",ExpressionUUID->"13dc6d17-6e1c-cc4b-85cc-3e5bc43acf26"],

Cell["\<\
Hypergraph[{Vertex[1, \"a\"], Vertex[2, \"b\"], 3}, {{1, 2}, {2, \
3}}][\"VertexLabels\"]\
\>", "Input",ExpressionUUID->"9b95c1cf-f78c-b548-8850-433eaa4ca1d0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"None", ",", "\<\"a\"\>", ",", "\<\"b\"\>"}], "}"}]], "Output",Expre\
ssionUUID->"64b8c994-23e4-cb4d-95d3-fb47c80b3261"],

Cell["Source", "NotesSection",ExpressionUUID->"314f38f7-02eb-f444-834a-37f862952233"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Vertices",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"734691e9-9bc6-b943-b6cf-4fa03712ce8e"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"3a969fd8-f92e-1a41-bddc-3a35106c9587"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["Vertex", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "ba5ab778-13f8-104f-a6b0-0c662926b268"],
 ", ",
 Cell[BoxData[
  StyleBox["VertexID", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "dc6e8fa9-1ea3-c24f-af96-55aa7fdac374"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeLabel", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "5821710e-eaa8-ae43-96bb-38a45a9916b7"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphSkeleton", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"bf3a63d5-4de8-cf42-bebe-9fa244dd9ac5"]
}], "SeeAlso",ExpressionUUID->"95f6bd14-0b61-7e40-adfa-d895529cdaf8"]
