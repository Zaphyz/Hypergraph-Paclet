Notebook[{
Cell["VertexLabel", "ObjectName",ExpressionUUID->"9090478e-0401-004d-981c-c326e6c835a7"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"VertexLabel", "[", "v", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"c22112ea-60ff-6c4d-a4ac-38ef17c72c2f"],
 " ",
 "gives the label of the vertex v, or None if it is unlabelled."
}], "Usage",ExpressionUUID->"954fdd0f-71f0-1446-ab19-76e16b7ed7be"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"c10ce5ef-695f-5948-8514-276d6e4ce2b1"],

Cell["\<\
A vertex identifier denotes one vertex, so it carries at most one label.\
\>", "Notes",ExpressionUUID->"0f89b523-4e75-2343-a471-bcfb6e1cedba"],

Cell["\<\
Within a hypergraph, a label attached to any occurrence of a vertex \
propagates to every other occurrence of that identifier.\
\>", "Notes",ExpressionUUID->"2a6df3b9-5970-fb48-a2fb-16aa4dd9030e"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"d5dd25d1-2248-5d42-b352-65d02249b9cc"],

Cell["{VertexLabel[Vertex[1, \"a\"]], VertexLabel[Vertex[1]]}", "Input",ExpressionUUID->"4e19d59b-4de6-6d4e-8e59-b2fc6a9eed76"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"a\"\>", ",", "None"}], "}"}]], "Output",ExpressionUUID->\
"836c4cf9-dc1b-2345-af42-094b743083e5"],

Cell["\<\
The labels of a whole hypergraph, in the order of its vertex list:\
\>", "ExampleText",ExpressionUUID->"ee1e4b71-f182-1445-aa57-d451f91fa3e2"],

Cell["\<\
Hypergraph[{Vertex[1, \"a\"], Vertex[2, \"b\"], 3}, {{1, 2}, {2, \
3}}][\"VertexLabels\"]\
\>", "Input",ExpressionUUID->"724b753d-7487-fb4c-9c2a-9bc16adaa6bd"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"None", ",", "\<\"a\"\>", ",", "\<\"b\"\>"}], "}"}]], "Output",Expre\
ssionUUID->"e06ed9fe-b971-b144-93be-1e6eb3dc3c7b"],

Cell["Source", "NotesSection",ExpressionUUID->"4f69ad2f-4644-d548-96f1-f8543a0a1e10"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Vertices",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"73e95886-b309-6643-9eaf-8fd4752aa8b8"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"df3714f6-07bb-514e-b68d-695f25ad580f"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["Vertex", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "2510e24e-edd5-5646-9115-19099fceb1af"],
 ", ",
 Cell[BoxData[
  StyleBox["VertexID", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "b8fbae63-4049-ef42-9d0f-89502b45d785"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeLabel", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "513a3325-f010-8340-818f-fa7d83b1256d"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphSkeleton", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"764210fb-0dee-014d-bc84-fa34162873f2"]
}], "SeeAlso",ExpressionUUID->"ebf4af26-5688-ab4c-88f1-328a25d0bf26"]
