Notebook[{
Cell["VertexLabel", "ObjectName",ExpressionUUID->"a0d980ca-2c9c-5a42-b4c3-cd1788ff7c11"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"VertexLabel", "[", "v", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"e761df3b-bfda-1247-ba31-e89742374dd8"],
 " ",
 "gives the label of the vertex v, or None if it is unlabelled."
}], "Usage",ExpressionUUID->"fb8f86e4-64d5-bd41-bcb3-0241af4bc5b8"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"e93d9290-87f7-9a4a-bdf2-d7cab84b3197"],

Cell["\<\
A vertex identifier denotes one vertex, so it carries at most one label.\
\>", "Notes",ExpressionUUID->"3e9dd2ff-8088-2146-a2b8-e56c6ba1eec1"],

Cell["\<\
Within a hypergraph, a label attached to any occurrence of a vertex \
propagates to every other occurrence of that identifier.\
\>", "Notes",ExpressionUUID->"6d7802cf-cc91-ce45-aa23-c0b0cc97d575"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"6bb605cb-6146-a443-997b-54da1598f2b9"],

Cell["{VertexLabel[Vertex[1, \"a\"]], VertexLabel[Vertex[1]]}", "Input",ExpressionUUID->"78052c8d-1367-b240-a186-75f5d4257415"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"a\"\>", ",", "None"}], "}"}]], "Output",ExpressionUUID->\
"f467c28f-3a5a-9c4f-bcc5-d460a8732073"],

Cell["\<\
The labels of a whole hypergraph, in the order of its vertex list:\
\>", "ExampleText",ExpressionUUID->"b4114d76-d2ce-3a45-afc8-4412e652b1fa"],

Cell["\<\
Hypergraph[{Vertex[1, \"a\"], Vertex[2, \"b\"], 3}, {{1, 2}, {2, \
3}}][\"VertexLabels\"]\
\>", "Input",ExpressionUUID->"f60d28a7-6759-ae46-a98f-46429948f501"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"None", ",", "\<\"a\"\>", ",", "\<\"b\"\>"}], "}"}]], "Output",Expre\
ssionUUID->"7246c902-67da-8048-8cc3-27f05c29da42"],

Cell["Source", "NotesSection",ExpressionUUID->"1e1a4a83-832e-0e46-bdc0-c8087fe8d33c"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Vertices",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"41316389-a3f4-4741-8cbd-e265ace9a447"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"c6c07c74-0ea8-5346-b100-65cc14e40fd3"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["Vertex", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "3eedab97-1309-594d-b940-e27cedfd0d0f"],
 ", ",
 Cell[BoxData[
  StyleBox["VertexID", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "2228c152-13ca-764d-8de1-30eac5c7be5b"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeLabel", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "f5fa2633-db40-0944-9082-8a50432f3087"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphSkeleton", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"96182070-58a6-9348-95a8-b82ed628b838"]
}], "SeeAlso",ExpressionUUID->"0e80ae6d-6ae1-8242-b9cc-bc0f00e51464"]
