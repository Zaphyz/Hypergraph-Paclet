Notebook[{
Cell["VertexLabel", "ObjectName",ExpressionUUID->"29d8137e-599c-7c4d-943b-4aae610bb662"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"VertexLabel", "[", "v", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"479c57db-5e6d-b242-b873-9cb98c56e2a7"],
 " ",
 "gives the label of the vertex v, or None if it is unlabelled."
}], "Usage",ExpressionUUID->"0ea557a2-192a-9c4f-a9f9-d336497781e7"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"4ec93e54-fddd-3c42-8a61-32438d155c77"],

Cell["\<\
A vertex identifier denotes one vertex, so it carries at most one label.\
\>", "Notes",ExpressionUUID->"5c03a58e-578d-bc4f-890b-fa7993cae180"],

Cell["\<\
Within a hypergraph, a label attached to any occurrence of a vertex \
propagates to every other occurrence of that identifier.\
\>", "Notes",ExpressionUUID->"37a89a82-816e-a045-a88e-20b66d5193f7"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"327d01cf-9a66-1d4c-a685-fb8b8d93efc2"],

Cell["{VertexLabel[Vertex[1, \"a\"]], VertexLabel[Vertex[1]]}", "Input",ExpressionUUID->"3fb0b828-3868-7443-bc62-9c607d3e3b7d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"a\"\>", ",", "None"}], "}"}]], "Output",ExpressionUUID->\
"9c52d6c3-46a7-a644-979f-da1d9a1030c1"],

Cell["\<\
The labels of a whole hypergraph, in the order of its vertex list:\
\>", "ExampleText",ExpressionUUID->"582a5648-3703-f34f-9788-98129ea2b67a"],

Cell["\<\
Hypergraph[{Vertex[1, \"a\"], Vertex[2, \"b\"], 3}, {{1, 2}, {2, \
3}}][\"VertexLabels\"]\
\>", "Input",ExpressionUUID->"8da4c4ce-065b-604f-b35d-dc365f9f5da4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"None", ",", "\<\"a\"\>", ",", "\<\"b\"\>"}], "}"}]], "Output",Expre\
ssionUUID->"afab72c2-d216-9043-9845-ca3ad98b82a2"],

Cell["Source", "NotesSection",ExpressionUUID->"d0512e02-056a-2744-a762-cc70a22aed74"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Vertices",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"e7a7712b-c90b-2d4a-9c88-434e703fbe44"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"36f60e10-0ec0-8e45-8d7d-49b3c202d68a"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["Vertex", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "3cea2dff-f4fb-8b4e-a136-9614286dd54d"],
 ", ",
 Cell[BoxData[
  StyleBox["VertexID", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "0128db97-8508-8a44-8c5e-ca6df35615e9"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeLabel", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "614006fe-3b14-8946-8605-4b65cba950b7"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphSkeleton", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"3a606bbb-9d77-9d4d-8b36-57bb8fc403ea"]
}], "SeeAlso",ExpressionUUID->"9a83ee87-647f-cd40-9c96-3f5a78a79992"]
