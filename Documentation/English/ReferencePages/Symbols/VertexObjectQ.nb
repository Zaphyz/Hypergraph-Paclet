Notebook[{
Cell["VertexObjectQ", "ObjectName",ExpressionUUID->"e0fc9bd7-1765-ee46-9783-ffc4fbb78f9e"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"VertexObjectQ", "[", "expr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"7c08cc1b-f233-b642-b4b3-64fef0a283fe"],
 " ",
 "gives True if expr is a valid Vertex object, and False otherwise."
}], "Usage",ExpressionUUID->"670b5edf-b5bd-c648-9ab5-121042562e5b"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"deb77b56-b673-9b43-a68b-21baebe14ded"],

Cell["\<\
The names VertexQ and EdgeQ are protected System` symbols \[LongDash] the \
graph membership tests VertexQ[g, v] and EdgeQ[g, e] \[LongDash] so the \
predicates of this package are named VertexObjectQ and EdgeObjectQ instead.\
\>", "Notes",ExpressionUUID->"e26b14d9-8832-b247-ab17-3fdfba08f74c"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"6e8b23ba-e4b4-e346-a95d-98555c94763f"],

Cell["\<\
{VertexObjectQ[Vertex[1]], VertexObjectQ[Vertex[1, \"a\"]], VertexObjectQ[1], \
VertexObjectQ[Edge[{1, 2}]]}\
\>", "Input",ExpressionUUID->"4d73de9d-08c0-fa4f-8e65-ef167bd1c822"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "False", ",", "False"}], "}"}]], "Output",\
ExpressionUUID->"29e2bb9a-7d6e-4d4a-9683-eb0e8a35635e"],

Cell["Source", "NotesSection",ExpressionUUID->"545feaa0-f1cd-5447-a359-b001cfb7e47b"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Vertices",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"bb3edac7-45f0-c644-bacf-cfcba68d3f46"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"e7f79627-c332-094c-90a1-1ff8668ae549"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["Vertex", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "e20179f8-48cc-4d4f-80f9-a72ce6e1ea88"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeObjectQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "6464b141-b17c-6d4c-8930-29429ec02c47"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "d05c5fe0-de93-814f-b432-cd78e3dd9d91"]
}], "SeeAlso",ExpressionUUID->"8441447d-6417-c347-b8af-ca12e1e3455f"]
