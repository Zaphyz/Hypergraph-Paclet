Notebook[{
Cell["VertexObjectQ", "ObjectName",ExpressionUUID->"6fdfb63b-e835-164c-8aa0-4d63cf2688b1"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"VertexObjectQ", "[", "expr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"bf9d4758-8c60-124b-994c-da21bd42e516"],
 " ",
 "gives True if expr is a valid Vertex object, and False otherwise."
}], "Usage",ExpressionUUID->"a384778a-8a53-534f-8fcf-7291aad0943f"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"4f3e4d81-da6e-384c-a8d3-801230816fd5"],

Cell["\<\
The names VertexQ and EdgeQ are protected System` symbols \[LongDash] the \
graph membership tests VertexQ[g, v] and EdgeQ[g, e] \[LongDash] so the \
predicates of this package are named VertexObjectQ and EdgeObjectQ instead.\
\>", "Notes",ExpressionUUID->"bc021e2d-170e-474a-8fd1-17b663ac8df1"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"21026e8f-fd43-c048-9cc9-2cd34c7cc86e"],

Cell["\<\
{VertexObjectQ[Vertex[1]], VertexObjectQ[Vertex[1, \"a\"]], VertexObjectQ[1], \
VertexObjectQ[Edge[{1, 2}]]}\
\>", "Input",ExpressionUUID->"796735a0-9dbe-bc4a-8322-c9545e456e53"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "False", ",", "False"}], "}"}]], "Output",\
ExpressionUUID->"419136d9-c1bb-134a-b6be-0e7cba960e13"],

Cell["Source", "NotesSection",ExpressionUUID->"805dffbd-2bff-6b41-9f9a-c40743ee0acb"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Vertices",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"0925fc16-9df6-f044-8126-686a2c4f4364"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"5c89ba54-8617-4946-b9d1-d67a3f9651a1"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["Vertex", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "a3f50969-2495-d544-8269-7b83d61a0c3a"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeObjectQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "2cedfce2-adbe-244f-802c-fd6350ec5fcd"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "28f0ac1e-3371-8d42-be9c-df5d11a60d37"]
}], "SeeAlso",ExpressionUUID->"960df301-668d-b849-89fb-5f59f1242b1b"]
