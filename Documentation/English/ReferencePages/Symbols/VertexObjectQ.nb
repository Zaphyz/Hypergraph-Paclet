Notebook[{
Cell["VertexObjectQ", "ObjectName",ExpressionUUID->"90977ee9-4f45-d24e-b18d-644a628b4759"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"VertexObjectQ", "[", "expr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"239e8b77-f8c0-3746-a0b2-afb6227cd8fe"],
 " ",
 "gives True if expr is a valid Vertex object, and False otherwise."
}], "Usage",ExpressionUUID->"d809f2da-08f9-6f4a-8da3-c72a15879f3c"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"287230a6-b954-5644-9c93-e8636bcace3b"],

Cell["\<\
The names VertexQ and EdgeQ are protected System` symbols \[LongDash] the \
graph membership tests VertexQ[g, v] and EdgeQ[g, e] \[LongDash] so the \
predicates of this package are named VertexObjectQ and EdgeObjectQ instead.\
\>", "Notes",ExpressionUUID->"d93fb6e5-ea12-e746-a777-e8f5cc6e567e"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"f54e436f-f686-0743-a823-93ca98f509fe"],

Cell["\<\
{VertexObjectQ[Vertex[1]], VertexObjectQ[Vertex[1, \"a\"]], VertexObjectQ[1], \
VertexObjectQ[Edge[{1, 2}]]}\
\>", "Input",ExpressionUUID->"d9c95900-27bb-914a-9125-55089a06caa5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "False", ",", "False"}], "}"}]], "Output",\
ExpressionUUID->"f9357a45-fe42-af4c-874c-108594c8ce31"],

Cell["Source", "NotesSection",ExpressionUUID->"3f530c7c-37fa-c642-8adf-245a01f2fcbb"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Vertices",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"c322fc6e-953c-2a4e-b74c-1c6124feea9f"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"4674b26e-c5b3-954b-b1af-9978a5bfd120"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["Vertex", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "65a883a1-77bb-5e43-b0a7-9eb1dfdbf0b4"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeObjectQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "24e5accf-a013-464e-9152-f5d04cdf1f55"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "f1b35566-17a8-964f-aff7-ba7e93cb981c"]
}], "SeeAlso",ExpressionUUID->"abaead9b-369d-d14b-9ac8-d3e22c9222d2"]
