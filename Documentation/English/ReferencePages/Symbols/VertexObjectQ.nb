Notebook[{
Cell["VertexObjectQ", "ObjectName",ExpressionUUID->"b1b027e7-25f3-7c4f-bffd-0734dae9eb76"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"VertexObjectQ", "[", "expr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"d14f622d-9bd5-2340-8eb2-79dcba8533c9"],
 " ",
 "gives True if expr is a valid Vertex object, and False otherwise."
}], "Usage",ExpressionUUID->"ac589516-3275-7d45-b0d5-0f24b74a1b80"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"43401067-854f-ed4d-944a-d2ca8d011da0"],

Cell["\<\
The names VertexQ and EdgeQ are protected System` symbols \[LongDash] the \
graph membership tests VertexQ[g, v] and EdgeQ[g, e] \[LongDash] so the \
predicates of this package are named VertexObjectQ and EdgeObjectQ instead.\
\>", "Notes",ExpressionUUID->"14f27cfe-6d3b-8c4d-b7ab-8d4d8b383fa8"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"947218a3-205b-ae4f-8a85-5180240f46fc"],

Cell["\<\
{VertexObjectQ[Vertex[1]], VertexObjectQ[Vertex[1, \"a\"]], VertexObjectQ[1], \
VertexObjectQ[Edge[{1, 2}]]}\
\>", "Input",ExpressionUUID->"60783653-8883-ef4e-864e-50e3d325aa56"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "False", ",", "False"}], "}"}]], "Output",\
ExpressionUUID->"950a470d-6fc1-7046-b53f-d48d47c9e6e5"],

Cell["Source", "NotesSection",ExpressionUUID->"54fa14be-c073-6543-8330-2fae3442eba1"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Vertices",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"6aeb7063-aa18-4d40-8902-f5e3b79d6bc9"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"8e5b9208-3fee-6746-ae79-8aa6748a04ac"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["Vertex", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "03dc0a64-6e73-b449-a77b-157bdd183fd9"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeObjectQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "e1ed3f10-f5e7-d043-a59a-93b84885c285"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "fc084709-cc02-7d4b-a85e-2001662c3ce8"]
}], "SeeAlso",ExpressionUUID->"acc5f99b-dc93-d848-a911-3c38376d5932"]
},
