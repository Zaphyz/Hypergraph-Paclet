Notebook[{
Cell["VertexObjectQ", "ObjectName",ExpressionUUID->"109afd63-edcd-9341-adda-6d7618023b86"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"VertexObjectQ", "[", "expr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"9045a4bb-47cc-e542-b398-f8809231ba62"],
 " ",
 "gives True if expr is a valid Vertex object, and False otherwise."
}], "Usage",ExpressionUUID->"54648296-6d6d-ee49-9557-980f4b08fb40"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"a55d8442-2b21-ca48-92c8-46387a685c54"],

Cell["\<\
The names VertexQ and EdgeQ are protected System` symbols \[LongDash] the \
graph membership tests VertexQ[g, v] and EdgeQ[g, e] \[LongDash] so the \
predicates of this package are named VertexObjectQ and EdgeObjectQ instead.\
\>", "Notes",ExpressionUUID->"28965104-0f4a-ba4c-a28d-bcf6650caa9d"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"9fc9f05c-246a-894d-aea4-c8b79a25528e"],

Cell["\<\
{VertexObjectQ[Vertex[1]], VertexObjectQ[Vertex[1, \"a\"]], VertexObjectQ[1], \
VertexObjectQ[Edge[{1, 2}]]}\
\>", "Input",ExpressionUUID->"6e0a59af-17c6-eb4c-8fb4-a71a48d0dab9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "False", ",", "False"}], "}"}]], "Output",\
ExpressionUUID->"4f525536-5e15-0d4b-a0a8-5c9426df8419"],

Cell["Source", "NotesSection",ExpressionUUID->"bfa935cf-1dd1-bf4c-8bcb-0d730a1545ab"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Vertices",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"88e505de-4f81-e34f-8111-1f96594dc378"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"ea0ef679-a86e-594b-a2e8-fbb778739dce"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["Vertex", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "d052db71-b826-c246-bbcb-0592febd6b56"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeObjectQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "e7d069f6-38ed-de4a-91db-54b5a95bb2b4"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "788f2341-5378-724e-9c8c-cd1ca82ccbb0"]
}], "SeeAlso",ExpressionUUID->"d5048e20-4178-694b-bad6-c09a5dcfa632"]
},
