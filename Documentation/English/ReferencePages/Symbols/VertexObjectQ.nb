Notebook[{
Cell["VertexObjectQ", "ObjectName",ExpressionUUID->"e1ec830f-0261-3341-bca6-b2193f091146"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"VertexObjectQ", "[", "expr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"38df4ea3-005f-ce4f-9d36-680c98c93170"],
 " ",
 "gives True if expr is a valid Vertex object, and False otherwise."
}], "Usage",ExpressionUUID->"06961ec3-7c6b-e947-b959-84833d7a45f6"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"803aba51-8b91-5442-96a6-bc13356fb71d"],

Cell["\<\
The names VertexQ and EdgeQ are protected System` symbols \[LongDash] the \
graph membership tests VertexQ[g, v] and EdgeQ[g, e] \[LongDash] so the \
predicates of this package are named VertexObjectQ and EdgeObjectQ instead.\
\>", "Notes",ExpressionUUID->"f471509f-b9a5-8943-97a0-f3f4a64feb3b"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"8e9a4272-94c4-694a-aeb0-e965445a7f39"],

Cell["\<\
{VertexObjectQ[Vertex[1]], VertexObjectQ[Vertex[1, \"a\"]], VertexObjectQ[1], \
VertexObjectQ[Edge[{1, 2}]]}\
\>", "Input",ExpressionUUID->"ed7acc49-b354-eb48-bee6-d6701080eea0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "False", ",", "False"}], "}"}]], "Output",\
ExpressionUUID->"f33137bd-52ed-5c45-b04d-ce912de07b31"],

Cell["Source", "NotesSection",ExpressionUUID->"4f1e46c6-abd0-384c-bca8-0fb9df6ffb7b"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Vertices",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"71b2c224-54f9-0e47-a3a0-f47bc44a83db"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"4e029d13-f5ef-e844-8d2b-7d23310aa91e"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["Vertex", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "7b1b3fad-cbc0-dd40-9e98-f7cf07748bdc"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeObjectQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "b9f6b28d-36b2-0547-b1ef-c5b199e1fb6b"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "688b96a7-76f5-3c4f-96a9-1d0f5582aab5"]
}], "SeeAlso",ExpressionUUID->"22ddbc90-ab30-5642-bdeb-7cd9433a18cb"]
