Notebook[{
Cell["VertexObjectQ", "ObjectName",ExpressionUUID->"d7159523-2cd8-3c47-b32a-d785794e4965"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"VertexObjectQ", "[", "expr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"53a115b9-8bc0-b340-b20b-3859b0549087"],
 " ",
 "gives True if expr is a valid Vertex object, and False otherwise."
}], "Usage",ExpressionUUID->"9f54c0ed-b74b-d44a-8646-e9bee66fc938"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"34cddc26-6fd1-a84a-885b-d4ca5e358256"],

Cell["\<\
The names VertexQ and EdgeQ are protected System` symbols \[LongDash] the \
graph membership tests VertexQ[g, v] and EdgeQ[g, e] \[LongDash] so the \
predicates of this package are named VertexObjectQ and EdgeObjectQ instead.\
\>", "Notes",ExpressionUUID->"cc63943b-574a-734b-b399-1842b88d7a65"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"e0612bd1-ab35-b14e-be28-2cc3a4b162c4"],

Cell["\<\
{VertexObjectQ[Vertex[1]], VertexObjectQ[Vertex[1, \"a\"]], VertexObjectQ[1], \
VertexObjectQ[Edge[{1, 2}]]}\
\>", "Input",ExpressionUUID->"a0428465-3e5f-f945-916f-45cc34a1e410"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "False", ",", "False"}], "}"}]], "Output",\
ExpressionUUID->"bc862924-8fd6-d54b-8980-cecb6a9e091f"],

Cell["Source", "NotesSection",ExpressionUUID->"6c4b5a2a-9e21-4740-ad2f-5d368f5842c5"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Vertices",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"48be876e-e0e9-9b40-aecd-0b22677f7b5b"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"5dedbc94-c41b-b444-9b22-cf2e98e9785b"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["Vertex", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "c0b687e1-d3c6-7d4a-8901-5f70e858599f"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeObjectQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "253e65a5-7f77-724a-b578-8094e7185c5c"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "d2f34e37-2445-2241-8a1a-8c6cc153780d"]
}], "SeeAlso",ExpressionUUID->"161ef9ab-5a75-8e46-8117-8e302e30c82b"]
