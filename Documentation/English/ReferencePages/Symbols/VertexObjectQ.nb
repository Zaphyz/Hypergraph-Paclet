Notebook[{
Cell["VertexObjectQ", "ObjectName",ExpressionUUID->"97f200c1-fc4b-5e48-894e-9a48981e3d97"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"VertexObjectQ", "[", "expr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"97dc020f-47c5-674e-869e-def068f46604"],
 " ",
 "gives True if expr is a valid Vertex object, and False otherwise."
}], "Usage",ExpressionUUID->"2dc97fcd-676b-4048-9c5d-f07a656b2a1d"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"e831ecb9-b1f1-a544-8be2-1bb0db555b6c"],

Cell["\<\
The names VertexQ and EdgeQ are protected System` symbols \[LongDash] the \
graph membership tests VertexQ[g, v] and EdgeQ[g, e] \[LongDash] so the \
predicates of this package are named VertexObjectQ and EdgeObjectQ instead.\
\>", "Notes",ExpressionUUID->"9f172ba7-9e21-0942-86e4-a60879e31e5e"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"8a515c4a-13c4-584d-b07e-35122dc374b4"],

Cell["\<\
{VertexObjectQ[Vertex[1]], VertexObjectQ[Vertex[1, \"a\"]], VertexObjectQ[1], \
VertexObjectQ[Edge[{1, 2}]]}\
\>", "Input",ExpressionUUID->"f6dd4cf9-5887-8d49-9393-ebf962811b38"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "False", ",", "False"}], "}"}]], "Output",\
ExpressionUUID->"a41c346a-ea87-804a-adc6-cabefd0b9c6b"],

Cell["Source", "NotesSection",ExpressionUUID->"6b4fda05-9ef2-c648-ac98-9c3f514223e7"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Vertices",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"3896a3d5-ebc7-2241-951b-18d75c1e5680"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"e3cc402f-4138-7047-b29f-16d923013e3d"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["Vertex", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "4f03d202-5f64-ac41-90f8-387468d2361e"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeObjectQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "f2180085-6b4e-e44d-a6fa-e1bb62a6804f"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "5560c88d-b9f8-534e-bee7-2f7fa8bc7ee5"]
}], "SeeAlso",ExpressionUUID->"84265ef9-110b-2542-a146-383e3ac8ec28"]
