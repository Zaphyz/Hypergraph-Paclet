Notebook[{
Cell["VertexObjectQ", "ObjectName",ExpressionUUID->"59813dd0-a506-4f4e-b691-17cdb2271b31"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"VertexObjectQ", "[", "expr", "]"}], "InlineCode"]], 
  "InlineFormula",ExpressionUUID->"684e40cb-b5de-7249-b582-9acf2441da8c"],
 " ",
 "gives True if expr is a valid Vertex object, and False otherwise."
}], "Usage",ExpressionUUID->"36608475-4bb8-b049-a466-6086af0ff723"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"4e496cc9-7541-b345-b57a-297c1c670e6f"],

Cell["\<\
The names VertexQ and EdgeQ are protected System` symbols \[LongDash] the \
graph membership tests VertexQ[g, v] and EdgeQ[g, e] \[LongDash] so the \
predicates of this package are named VertexObjectQ and EdgeObjectQ instead.\
\>", "Notes",ExpressionUUID->"c0336f28-195e-bf4e-ac9c-cddf8131d9e5"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"d415afbc-9f7d-0547-a510-b7e710f9bf1f"],

Cell["\<\
{VertexObjectQ[Vertex[1]], VertexObjectQ[Vertex[1, \"a\"]], VertexObjectQ[1], \
VertexObjectQ[Edge[{1, 2}]]}\
\>", "Input",ExpressionUUID->"2982dd1d-b688-fa4f-851c-405ccba95895"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "False", ",", "False"}], "}"}]], "Output",\
ExpressionUUID->"5a6423eb-bf28-8745-957f-e57d22e54b07"],

Cell["Source", "NotesSection",ExpressionUUID->"14b13f2b-11fa-0e41-b8aa-3fdd4a7b3e3e"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/Hypergraph.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Vertices",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"cf5ef2ac-045b-ce46-a147-d07d965be9d9"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"9f0fe87f-8142-a943-86e8-bdc012a408e4"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["Vertex", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "70c51ebc-beb9-654c-aea8-0af3eaff1b05"],
 ", ",
 Cell[BoxData[
  StyleBox["EdgeObjectQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "ba023f8d-e013-f24c-908f-677ae714ba4d"],
 ", ",
 Cell[BoxData[
  StyleBox["HypergraphQ", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "cb806809-5ea9-864f-8138-729ac4abcdb5"]
}], "SeeAlso",ExpressionUUID->"19ff6d83-ce66-544e-a107-d8d1e1a76a07"]
},
