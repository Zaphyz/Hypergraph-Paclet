Notebook[{
Cell["ZeroArray", "ObjectName",ExpressionUUID->"182a494a-307d-0b4c-a7b6-adc9f8494fe0"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ZeroArray", "[", 
    RowBox[{"n", ",", " ", "d"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"a97e7649-e500-4544-979e-6d4a8d9ac7d4"],
 " ",
 "gives the n-array with every index of length d and every entry zero."
}], "Usage",ExpressionUUID->"d4b2931c-cf4c-294f-a9de-b6ffab4c2b6f"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ZeroArray", "[", "dims", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"5b541659-0ac2-c94b-8229-46c698e99d97"],
 " ",
 "gives the array of the given dimensions."
}], "Usage",ExpressionUUID->"6ba8459f-e989-354b-8b62-349f9e43068e"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ZeroArray", "[", 
    RowBox[{"spec", ",", " ", "dom"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"d79b1caf-f842-5247-9e4b-03507d199aa7"],
 " ",
 "gives its entries in the value domain dom."
}], "Usage",ExpressionUUID->"87dac4c0-3967-8847-8307-4cc7b08d59d6"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"b812f356-8777-7f44-87ed-7741e21c31bb"],

Cell["\<\
The domain defaults to \"Integer\". The zero of \"Boolean\" is False, and the \
zero of FiniteField[p, n] is that field's zero element.\
\>", "Notes",ExpressionUUID->"5dd391e5-4875-854c-81ee-c9198a942640"],

Cell["\<\
A constant array is invariant under every permutation of its indices, so a \
regular one is declared \"Symmetric\". An array of unequal index lengths \
cannot carry a symmetry and is declared \"Rigid\".\
\>", "Notes",ExpressionUUID->"5a69e706-65cc-df46-97c7-703d5d6c8f1b"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"34ca4602-e93e-8445-b95b-cfec6de9f7a0"],

Cell["Normal @ ZeroArray[2, 3]", "Input",ExpressionUUID->"757f4b6e-ca53-9e45-904b-23e8b16adbc5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "}"}]], "Output",ExpressionUUI\
D->"1dba2491-a62b-5049-bf3b-7b8b52fefff6"],

Cell["Any shape, and any domain:", "ExampleText",ExpressionUUID->"94346a6f-c0bb-6e40-afc8-cb01682ee5bf"],

Cell["\<\
{ArrayDimensions @ ZeroArray[{2, 3, 4}], Normal @ ZeroArray[1, 3, \"Real\"]}\
\>", "Input",ExpressionUUID->"15fb4ad9-8a86-524b-babf-64bef15f95c4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "3", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0.`", ",", "0.`", ",", "0.`"}], "}"}]}], "}"}]], "Output",Express\
ionUUID->"f1a16b4d-cd95-1347-9b1f-c36578090051"],

Cell["A regular constant array is symmetric:", "ExampleText",ExpressionUUID->"969f0e71-692f-6f4d-98c5-21cdbf5a17b1"],

Cell["\<\
{ArraySymmetry @ ZeroArray[3, 2], ArraySymmetry @ ZeroArray[{2, 3}]}\
\>", "Input",ExpressionUUID->"042de281-68e3-9c44-b8e7-21e24fcc13fe"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Symmetric\"\>", ",", "\<\"Rigid\"\>"}], "}"}]], "Output",Expres\
sionUUID->"7ce43581-66fb-694e-97fe-f9e43e906cbe"],

Cell["Source", "NotesSection",ExpressionUUID->"273c6014-4b50-fc44-9982-4bb2ac1e1028"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/ArrayAlgebra.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Special arrays",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"5ab587e7-23c9-bf4c-af74-1c4f844fc37f"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"2a1a0a0f-0110-c847-b92e-3d60c53f600c"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["OneArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "0c1ad805-2a0e-0d42-ba00-09792f2f148d"],
 ", ",
 Cell[BoxData[
  StyleBox["IdentityArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "a60852ce-22ac-b54e-97ed-e00c54148f78"],
 ", ",
 Cell[BoxData[
  StyleBox["PartialIdentityArray", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"a5ed471b-ba5f-d74b-91e9-c9d8f6bc61d1"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayObject", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "5e7b537e-c946-104e-a407-4713aff339bf"]
}], "SeeAlso",ExpressionUUID->"c7952405-a20b-a740-9a48-1842e7114254"]
},
