Notebook[{
Cell["ZeroArray", "ObjectName",ExpressionUUID->"91829d0d-9c19-4a48-8c90-f7137094bece"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ZeroArray", "[", 
    RowBox[{"n", ",", " ", "d"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"81ab6dee-193a-6d46-8920-ae563cfebca0"],
 " ",
 "gives the n-array with every index of length d and every entry zero."
}], "Usage",ExpressionUUID->"80885756-14ee-3e48-a648-3f0e497dca89"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ZeroArray", "[", "dims", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"f15f0673-f026-aa40-9d6a-a5300892afe9"],
 " ",
 "gives the array of the given dimensions."
}], "Usage",ExpressionUUID->"a0d6ff9d-999b-5745-8ebc-45d7baa32ff4"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ZeroArray", "[", 
    RowBox[{"spec", ",", " ", "dom"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"5c0b6df0-116b-de4b-83cf-c2d45864857d"],
 " ",
 "gives its entries in the value domain dom."
}], "Usage",ExpressionUUID->"69129f9a-635f-8f4e-a14f-c19dabc8d4f6"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"a2936cf3-5c26-b145-9088-f26c0c091b15"],

Cell["\<\
The domain defaults to \"Integer\". The zero of \"Boolean\" is False, and the \
zero of FiniteField[p, n] is that field's zero element.\
\>", "Notes",ExpressionUUID->"3950474f-7f38-484a-9ea0-1218a4435342"],

Cell["\<\
A constant array is invariant under every permutation of its indices, so a \
regular one is declared \"Symmetric\". An array of unequal index lengths \
cannot carry a symmetry and is declared \"Rigid\".\
\>", "Notes",ExpressionUUID->"0298d2c5-86db-9249-aafb-199518f9cf93"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"683b1d82-7fdd-3941-8181-86f68b7b0fd1"],

Cell["Normal @ ZeroArray[2, 3]", "Input",ExpressionUUID->"c2b14c3c-5ab6-c240-b752-dfd262a4615a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "}"}]], "Output",ExpressionUUI\
D->"9292cdf0-1312-6d47-94dc-552ea50b1499"],

Cell["Any shape, and any domain:", "ExampleText",ExpressionUUID->"ca2dc161-4b9f-3041-ae44-4980923a2ba1"],

Cell["\<\
{ArrayDimensions @ ZeroArray[{2, 3, 4}], Normal @ ZeroArray[1, 3, \"Real\"]}\
\>", "Input",ExpressionUUID->"9310546e-91ae-2349-981d-127f47541750"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "3", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0.`", ",", "0.`", ",", "0.`"}], "}"}]}], "}"}]], "Output",Express\
ionUUID->"befbf41b-9c68-1941-ab89-e610c7c63c58"],

Cell["A regular constant array is symmetric:", "ExampleText",ExpressionUUID->"80dfc060-3c09-5d4c-9b15-911119001b4d"],

Cell["\<\
{ArraySymmetry @ ZeroArray[3, 2], ArraySymmetry @ ZeroArray[{2, 3}]}\
\>", "Input",ExpressionUUID->"cf89968a-af26-8442-8710-4d834ce0d3e3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Symmetric\"\>", ",", "\<\"Rigid\"\>"}], "}"}]], "Output",Expres\
sionUUID->"73be8885-fb43-f749-a6f9-6ff15e1accc6"],

Cell["Source", "NotesSection",ExpressionUUID->"2ec53d6d-0254-2a48-99aa-0ab3fa0f1c2c"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/ArrayAlgebra.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Special arrays",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"bb7a7fba-37ae-964d-b87f-1e9cef5eab87"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"5b2977d2-507a-ea42-8bcb-b1e33f25ed8e"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["OneArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "1fbf2798-cdf3-b849-978f-ffea99baf2e3"],
 ", ",
 Cell[BoxData[
  StyleBox["IdentityArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "881433b7-6688-994e-ae43-c5be6d295dd3"],
 ", ",
 Cell[BoxData[
  StyleBox["PartialIdentityArray", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"16a49b68-41b7-8b4a-b30a-88ecfc691cf4"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayObject", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "ff5e5203-d807-934b-9abd-6706473d957e"]
}], "SeeAlso",ExpressionUUID->"6049539b-e2de-1843-82c6-b9e0019df12e"]
},
