Notebook[{
Cell["ZeroArray", "ObjectName",ExpressionUUID->"8e6067d3-a054-1b44-b8c6-a64758209675"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ZeroArray", "[", 
    RowBox[{"n", ",", " ", "d"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"927179f1-e59a-5d4d-9d35-99b3f3a5399a"],
 " ",
 "gives the n-array with every index of length d and every entry zero."
}], "Usage",ExpressionUUID->"5ed48070-f45d-744b-ab35-9d6135af11c2"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ZeroArray", "[", "dims", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"166ac6c2-1a55-fa49-b538-1311baf87c50"],
 " ",
 "gives the array of the given dimensions."
}], "Usage",ExpressionUUID->"373a8507-8763-d048-9d4e-210f21dcfe8b"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ZeroArray", "[", 
    RowBox[{"spec", ",", " ", "dom"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"4ab3a19f-b29c-2045-b8e3-ea33a58dd04e"],
 " ",
 "gives its entries in the value domain dom."
}], "Usage",ExpressionUUID->"e033327a-40a6-b247-b610-6bbbc7f91198"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"f0ff5329-99c2-f547-8d92-547bf4aa9d77"],

Cell["\<\
The domain defaults to \"Integer\". The zero of \"Boolean\" is False, and the \
zero of FiniteField[p, n] is that field's zero element.\
\>", "Notes",ExpressionUUID->"d9eee2bc-cf2a-1d4d-b0de-c5d120593200"],

Cell["\<\
A constant array is invariant under every permutation of its indices, so a \
regular one is declared \"Symmetric\". An array of unequal index lengths \
cannot carry a symmetry and is declared \"Rigid\".\
\>", "Notes",ExpressionUUID->"9bdd0848-6728-454a-a5e7-33f5135513c2"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"f94dc8ae-0199-aa4c-a544-7500a23c1c82"],

Cell["Normal @ ZeroArray[2, 3]", "Input",ExpressionUUID->"0325448f-9218-334c-b131-7efda08846ec"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "}"}]], "Output",ExpressionUUI\
D->"ec7e271d-4bc8-d446-9f2b-8444b9754162"],

Cell["Any shape, and any domain:", "ExampleText",ExpressionUUID->"fbdf2b89-70e9-4d43-81f9-780794fe84ec"],

Cell["\<\
{ArrayDimensions @ ZeroArray[{2, 3, 4}], Normal @ ZeroArray[1, 3, \"Real\"]}\
\>", "Input",ExpressionUUID->"6d9993cd-3572-b14b-a282-11f60b376685"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "3", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0.`", ",", "0.`", ",", "0.`"}], "}"}]}], "}"}]], "Output",Express\
ionUUID->"3f134909-217e-dd41-b503-a8b5df68b04c"],

Cell["A regular constant array is symmetric:", "ExampleText",ExpressionUUID->"8169a85a-b45d-874c-b41d-cfca4ac18b62"],

Cell["\<\
{ArraySymmetry @ ZeroArray[3, 2], ArraySymmetry @ ZeroArray[{2, 3}]}\
\>", "Input",ExpressionUUID->"e96c7d8f-9803-3744-a22d-fd38df0ae519"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Symmetric\"\>", ",", "\<\"Rigid\"\>"}], "}"}]], "Output",Expres\
sionUUID->"5b0b6d64-6481-4e40-98cf-a2c08daf62b5"],

Cell["Source", "NotesSection",ExpressionUUID->"a747b2ac-3a0f-9042-8b21-aa03873c4ef3"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/ArrayAlgebra.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Special arrays",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"6b310978-108f-4446-89ce-0ba4158b9982"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"fa5bd7bc-d61b-324f-8825-b1188201802c"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["OneArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "b69d603e-0843-a64c-98d6-c631729c7e1f"],
 ", ",
 Cell[BoxData[
  StyleBox["IdentityArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "34f6e65c-634c-724d-82ad-733e6434ea3a"],
 ", ",
 Cell[BoxData[
  StyleBox["PartialIdentityArray", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"cd7c3eb1-0d62-d548-a4be-86d5da214987"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayObject", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "b3b7c0d6-a8a9-394e-bf00-c74faa8219f8"]
}], "SeeAlso",ExpressionUUID->"5b3d6fc1-7e93-1644-9b33-2ae18ce06089"]
},
