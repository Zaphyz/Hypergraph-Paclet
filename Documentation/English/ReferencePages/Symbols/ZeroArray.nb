Notebook[{
Cell["ZeroArray", "ObjectName",ExpressionUUID->"90dd237e-f209-4e4c-a9c9-4ad6cdcdbb06"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ZeroArray", "[", 
    RowBox[{"n", ",", " ", "d"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"c73bf29c-a8a3-1c46-aede-483641a71a08"],
 " ",
 "gives the n-array with every index of length d and every entry zero."
}], "Usage",ExpressionUUID->"a2abe1d7-9e83-d14c-896a-04f3e4577efa"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ZeroArray", "[", "dims", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"dde35619-4c52-864c-a950-75d0714efc2f"],
 " ",
 "gives the array of the given dimensions."
}], "Usage",ExpressionUUID->"36270db6-2e2e-744a-b3ca-d6001ce03925"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ZeroArray", "[", 
    RowBox[{"spec", ",", " ", "dom"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"5f65653d-68f0-5d49-a547-a126e9c9ccc2"],
 " ",
 "gives its entries in the value domain dom."
}], "Usage",ExpressionUUID->"e2686187-475c-ab40-a174-0631585c51ef"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"4431b313-531c-4040-8c3c-65e3efa7d934"],

Cell["\<\
The domain defaults to \"Integer\". The zero of \"Boolean\" is False, and the \
zero of FiniteField[p, n] is that field's zero element.\
\>", "Notes",ExpressionUUID->"d1f4e41b-d6db-234a-bbfa-2b49a474f291"],

Cell["\<\
A constant array is invariant under every permutation of its indices, so a \
regular one is declared \"Symmetric\". An array of unequal index lengths \
cannot carry a symmetry and is declared \"Rigid\".\
\>", "Notes",ExpressionUUID->"70212dda-bc99-e24b-8ef9-d03aa0b60c75"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"15d527bc-c141-6f4e-a0a6-864bdceb28a0"],

Cell["Normal @ ZeroArray[2, 3]", "Input",ExpressionUUID->"9ae9bb56-a065-244d-a8c4-a3de50a6567f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "}"}]], "Output",ExpressionUUI\
D->"6f566c1e-28d7-244f-afc8-e734c3602478"],

Cell["Any shape, and any domain:", "ExampleText",ExpressionUUID->"c6119e02-1f78-094c-a9f4-eced72dc6663"],

Cell["\<\
{ArrayDimensions @ ZeroArray[{2, 3, 4}], Normal @ ZeroArray[1, 3, \"Real\"]}\
\>", "Input",ExpressionUUID->"801d4a01-1d38-b046-aa4d-b650a3cfbba7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "3", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0.`", ",", "0.`", ",", "0.`"}], "}"}]}], "}"}]], "Output",Express\
ionUUID->"0b056b37-6506-d342-a5fe-afdf0cd4518b"],

Cell["A regular constant array is symmetric:", "ExampleText",ExpressionUUID->"74d42272-b9ac-444f-9ca3-b8cb3208aba6"],

Cell["\<\
{ArraySymmetry @ ZeroArray[3, 2], ArraySymmetry @ ZeroArray[{2, 3}]}\
\>", "Input",ExpressionUUID->"daa03837-6027-074e-b3e6-104d3317e6c1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Symmetric\"\>", ",", "\<\"Rigid\"\>"}], "}"}]], "Output",Expres\
sionUUID->"c9b602ad-5717-2d42-baf6-108e48d048b4"],

Cell["Source", "NotesSection",ExpressionUUID->"eebc3a4c-7e8b-2b43-b2fa-b9db22b7de42"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/ArrayAlgebra.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Special arrays",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"b128ba02-f024-5747-85d5-fbcc38fbc18c"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"53f8dc00-c0b0-4c44-a463-6072137b335a"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["OneArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "82ee19d5-f5ad-df4e-bf6a-ef44e1b52da7"],
 ", ",
 Cell[BoxData[
  StyleBox["IdentityArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "7f2cc5da-50db-e84d-ba38-034aa0120e25"],
 ", ",
 Cell[BoxData[
  StyleBox["PartialIdentityArray", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"0cf325c3-f69c-8942-bebf-83ee303ba4c4"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayObject", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "017d9a04-a255-c14a-ac6a-0266ffafa613"]
}], "SeeAlso",ExpressionUUID->"65c0e6bd-3cfc-3945-a6a0-80289a027430"]
},
