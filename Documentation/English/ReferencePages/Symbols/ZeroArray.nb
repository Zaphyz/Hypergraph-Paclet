Notebook[{
Cell["ZeroArray", "ObjectName",ExpressionUUID->"4d3b49e7-71c0-9e4b-98ce-c35ac4bffdf2"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ZeroArray", "[", 
    RowBox[{"n", ",", " ", "d"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"2eb41e73-6c5a-6e45-af47-d8e7c7d83011"],
 " ",
 "gives the n-array with every index of length d and every entry zero."
}], "Usage",ExpressionUUID->"dc342c71-2bc3-5a40-a6b1-d273ffed4b0c"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ZeroArray", "[", "dims", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"4ece5c29-5dfe-a94c-86ea-9d9f9cc3a5e8"],
 " ",
 "gives the array of the given dimensions."
}], "Usage",ExpressionUUID->"91db86e4-b545-9a4e-af9d-06053defe78c"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ZeroArray", "[", 
    RowBox[{"spec", ",", " ", "dom"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"0c297d15-6a53-8f49-acd7-735722e2aef1"],
 " ",
 "gives its entries in the value domain dom."
}], "Usage",ExpressionUUID->"8034ce0d-49a1-ed47-9aea-a72f3f3aa2b5"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"c748082a-a3ed-b543-82be-57e80ebdb7fc"],

Cell["\<\
The domain defaults to \"Integer\". The zero of \"Boolean\" is False, and the \
zero of FiniteField[p, n] is that field's zero element.\
\>", "Notes",ExpressionUUID->"a88096fd-8748-8b4b-b047-20ea36b2b4cb"],

Cell["\<\
A constant array is invariant under every permutation of its indices, so a \
regular one is declared \"Symmetric\". An array of unequal index lengths \
cannot carry a symmetry and is declared \"Rigid\".\
\>", "Notes",ExpressionUUID->"a2ba1e8c-3b1c-1c47-a260-4b688b81dc29"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"c00af478-1de7-c244-a5f8-a94382a87deb"],

Cell["Normal @ ZeroArray[2, 3]", "Input",ExpressionUUID->"03cfe142-229a-8949-9a2e-c072b116921f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "}"}]], "Output",ExpressionUUI\
D->"d082a86b-410f-db41-9293-3234e59fdfed"],

Cell["Any shape, and any domain:", "ExampleText",ExpressionUUID->"e69749aa-bf38-5744-8fdd-5047ebd39efa"],

Cell["\<\
{ArrayDimensions @ ZeroArray[{2, 3, 4}], Normal @ ZeroArray[1, 3, \"Real\"]}\
\>", "Input",ExpressionUUID->"ee85fbff-2e44-2c44-b584-6063f279064a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "3", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0.`", ",", "0.`", ",", "0.`"}], "}"}]}], "}"}]], "Output",Express\
ionUUID->"23a5e46b-46b6-724a-87cd-cdc048e40385"],

Cell["A regular constant array is symmetric:", "ExampleText",ExpressionUUID->"ab3174ac-16ad-dd4c-8a85-4e2910dcf7f9"],

Cell["\<\
{ArraySymmetry @ ZeroArray[3, 2], ArraySymmetry @ ZeroArray[{2, 3}]}\
\>", "Input",ExpressionUUID->"76619fdc-df50-184d-b90c-a33faba2f95b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Symmetric\"\>", ",", "\<\"Rigid\"\>"}], "}"}]], "Output",Expres\
sionUUID->"66f55c7b-bd2b-ab4a-a332-5143e7e940c4"],

Cell["Source", "NotesSection",ExpressionUUID->"fb414ba1-9d29-ce44-b26a-faadb40d0fe1"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/ArrayAlgebra.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Special arrays",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"9e017d80-5d6f-1243-a0bc-628e8502de43"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"3eb25e29-a5f7-e645-a249-8d1c1d6741e1"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["OneArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "a89345d5-7086-ec4d-9178-bc352c4704cf"],
 ", ",
 Cell[BoxData[
  StyleBox["IdentityArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "b0564be2-3fe7-5a4d-83ae-359e89b10f02"],
 ", ",
 Cell[BoxData[
  StyleBox["PartialIdentityArray", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"9ec39a40-398a-7240-9f5d-88058e0d18cf"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayObject", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "0154819a-d41d-af42-84f5-33a7335063dc"]
}], "SeeAlso",ExpressionUUID->"43fb4a4e-bdd6-7343-89f5-87f224eeaf4f"]
},
