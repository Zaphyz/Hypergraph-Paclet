Notebook[{
Cell["ZeroArray", "ObjectName",ExpressionUUID->"67b6f7e0-6182-1d46-a360-819bb575c27f"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ZeroArray", "[", 
    RowBox[{"n", ",", " ", "d"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"97960bf2-b97d-6248-8186-61590fb89584"],
 " ",
 "gives the n-array with every index of length d and every entry zero."
}], "Usage",ExpressionUUID->"619dd2f8-f297-8541-a609-d8784f2b370c"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ZeroArray", "[", "dims", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"dc3f1455-bd01-9b41-a8de-00e4855f49bc"],
 " ",
 "gives the array of the given dimensions."
}], "Usage",ExpressionUUID->"4e358fe4-9ca8-134a-ba8b-0899f1c830fa"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ZeroArray", "[", 
    RowBox[{"spec", ",", " ", "dom"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"4e714479-ae09-6f46-8707-8b657c5c0953"],
 " ",
 "gives its entries in the value domain dom."
}], "Usage",ExpressionUUID->"d37d5a47-7a1a-c54f-a2db-f4436e003ccd"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"74675418-e60c-b14f-8ca2-2b8166a14c80"],

Cell["\<\
The domain defaults to \"Integer\". The zero of \"Boolean\" is False, and the \
zero of FiniteField[p, n] is that field's zero element.\
\>", "Notes",ExpressionUUID->"91e1c806-d347-e642-a749-20f5d75ea59b"],

Cell["\<\
A constant array is invariant under every permutation of its indices, so a \
regular one is declared \"Symmetric\". An array of unequal index lengths \
cannot carry a symmetry and is declared \"Rigid\".\
\>", "Notes",ExpressionUUID->"65f42893-05eb-b445-abec-237e3cc1ba15"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"5e234426-5f34-0c4b-b22f-dc49c0c7e8d7"],

Cell["Normal @ ZeroArray[2, 3]", "Input",ExpressionUUID->"df023e02-0692-3047-a9f4-851b5d3bae29"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "}"}]], "Output",ExpressionUUI\
D->"11002c04-0ea9-9f41-b4e2-212b62f58b44"],

Cell["Any shape, and any domain:", "ExampleText",ExpressionUUID->"5d1ad789-4c40-5e46-bb0c-d568e05f5fa1"],

Cell["\<\
{ArrayDimensions @ ZeroArray[{2, 3, 4}], Normal @ ZeroArray[1, 3, \"Real\"]}\
\>", "Input",ExpressionUUID->"f96b5a7f-5a5b-ea45-a224-809b967a9a96"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "3", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0.`", ",", "0.`", ",", "0.`"}], "}"}]}], "}"}]], "Output",Express\
ionUUID->"95b7ce42-6023-f740-b766-1aeb0342a3ce"],

Cell["A regular constant array is symmetric:", "ExampleText",ExpressionUUID->"d6726b7b-9015-f743-8fe8-8114346bbf8a"],

Cell["\<\
{ArraySymmetry @ ZeroArray[3, 2], ArraySymmetry @ ZeroArray[{2, 3}]}\
\>", "Input",ExpressionUUID->"74f86af5-0394-964d-be3c-c7fe9dc7ec47"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Symmetric\"\>", ",", "\<\"Rigid\"\>"}], "}"}]], "Output",Expres\
sionUUID->"e1ac557a-58bf-db45-b74f-0afde14e51d8"],

Cell["Source", "NotesSection",ExpressionUUID->"5f6c23ac-6aa8-4e4c-9990-8103dc3614b1"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/ArrayAlgebra.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Special arrays",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"a3887fe3-7f4e-324d-b82b-a4298226ed4a"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"2ec70ecb-0521-bc4d-8811-82c39bd6d07e"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["OneArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "77aa0be9-09e5-2049-aaf0-34cbeb8cb109"],
 ", ",
 Cell[BoxData[
  StyleBox["IdentityArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "7c1ccbb6-1810-0a46-978c-18daab368882"],
 ", ",
 Cell[BoxData[
  StyleBox["PartialIdentityArray", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"6bda8c95-ef2c-0b41-8b2e-a731899dd995"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayObject", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "d9ddca05-ef94-1646-b06b-113fbba71775"]
}], "SeeAlso",ExpressionUUID->"6ecb87d8-c92a-434c-8bbf-edd2f717eb8d"]
