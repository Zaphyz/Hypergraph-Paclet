Notebook[{
Cell["ZeroArray", "ObjectName",ExpressionUUID->"15f97af7-ab01-bb4d-a967-956444fa93fe"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ZeroArray", "[", 
    RowBox[{"n", ",", " ", "d"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"241c00ea-5455-f440-88a4-6334cddf84d7"],
 " ",
 "gives the n-array with every index of length d and every entry zero."
}], "Usage",ExpressionUUID->"3c824a03-6822-cd45-91dc-d167f2f95df8"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ZeroArray", "[", "dims", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"8b099881-4fcf-7543-8351-19170aa2823e"],
 " ",
 "gives the array of the given dimensions."
}], "Usage",ExpressionUUID->"a614d94d-15bf-5645-8fd9-85b0db500995"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ZeroArray", "[", 
    RowBox[{"spec", ",", " ", "dom"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"51782746-ddbd-2740-9532-fab42b08fa90"],
 " ",
 "gives its entries in the value domain dom."
}], "Usage",ExpressionUUID->"6eef6b8e-cce1-db46-8a07-b1fe1242903c"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"278a071a-df91-ba41-b708-81c0853cb643"],

Cell["\<\
The domain defaults to \"Integer\". The zero of \"Boolean\" is False, and the \
zero of FiniteField[p, n] is that field's zero element.\
\>", "Notes",ExpressionUUID->"723ebb96-eadb-4644-92d4-8f15b6d628b3"],

Cell["\<\
A constant array is invariant under every permutation of its indices, so a \
regular one is declared \"Symmetric\". An array of unequal index lengths \
cannot carry a symmetry and is declared \"Rigid\".\
\>", "Notes",ExpressionUUID->"df15ce87-f4cc-2743-a5cb-a46003ad1f33"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"5652e29e-1a9c-ed4a-b1ed-105943075c96"],

Cell["Normal @ ZeroArray[2, 3]", "Input",ExpressionUUID->"b4b45237-4a24-2b44-8f91-4532b057f855"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "}"}]], "Output",ExpressionUUI\
D->"9fe2e837-863e-1c49-9a96-8896c5fa02b3"],

Cell["Any shape, and any domain:", "ExampleText",ExpressionUUID->"c8a2730b-2e0a-b744-b97d-1860dab6d84d"],

Cell["\<\
{ArrayDimensions @ ZeroArray[{2, 3, 4}], Normal @ ZeroArray[1, 3, \"Real\"]}\
\>", "Input",ExpressionUUID->"0b85aa71-d126-fb4f-a25d-e32b1f0e45b0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "3", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0.`", ",", "0.`", ",", "0.`"}], "}"}]}], "}"}]], "Output",Express\
ionUUID->"b7f35cd8-c7c3-9a40-9085-32fe9b39144a"],

Cell["A regular constant array is symmetric:", "ExampleText",ExpressionUUID->"3624badc-6e8a-c24e-aacf-dbb0ddd71a39"],

Cell["\<\
{ArraySymmetry @ ZeroArray[3, 2], ArraySymmetry @ ZeroArray[{2, 3}]}\
\>", "Input",ExpressionUUID->"5c30cfaf-f606-244e-ba82-3b8aecfe1691"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Symmetric\"\>", ",", "\<\"Rigid\"\>"}], "}"}]], "Output",Expres\
sionUUID->"b5aa5908-ce3b-484a-856e-e152987260f8"],

Cell["Source", "NotesSection",ExpressionUUID->"926a52d4-f03e-df45-9c95-b51f1a821594"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/ArrayAlgebra.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Special arrays",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"8fb2d38c-ba13-b24b-96bf-14a96afcee94"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"0d363cf8-4182-5949-a9b7-a3df8c92b265"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["OneArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "85b428d6-47ac-4f48-9b19-c3ac7c07c581"],
 ", ",
 Cell[BoxData[
  StyleBox["IdentityArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "dae0e3c0-0684-4a4c-ad25-c6d637858a26"],
 ", ",
 Cell[BoxData[
  StyleBox["PartialIdentityArray", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"401ac624-5f38-fb48-bdec-a12f704a7377"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayObject", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "c1c174bf-adc3-bc4a-bc9d-c4c1bf8507d1"]
}], "SeeAlso",ExpressionUUID->"75de53e4-ff75-2049-9e62-81452ecc23af"]
},
