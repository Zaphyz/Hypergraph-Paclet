Notebook[{
Cell["ZeroArray", "ObjectName",ExpressionUUID->"c268b784-ab33-2f44-8bb3-291c0f6a0992"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ZeroArray", "[", 
    RowBox[{"n", ",", " ", "d"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"eba09a53-af59-9843-9018-dc0a3df3d886"],
 " ",
 "gives the n-array with every index of length d and every entry zero."
}], "Usage",ExpressionUUID->"dfd0998e-bb8d-df46-b52e-54f3310f07e9"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ZeroArray", "[", "dims", "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"708e691a-8ca7-eb4b-a2ef-b1c45a385486"],
 " ",
 "gives the array of the given dimensions."
}], "Usage",ExpressionUUID->"ecc9f9f0-b304-b84b-a14f-051a123e3523"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ZeroArray", "[", 
    RowBox[{"spec", ",", " ", "dom"}], "]"}], "InlineCode"]], "InlineFormula",
  ExpressionUUID->"0f922679-72fd-4a4f-8a8d-d0bd8490cd3c"],
 " ",
 "gives its entries in the value domain dom."
}], "Usage",ExpressionUUID->"a74c014c-7ec2-a24d-b21a-5f9e3b7d1bbb"],

Cell["Details and Options", "NotesSection",ExpressionUUID->"fd4be6fb-0f93-3040-b42c-36c85d2f1859"],

Cell["\<\
The domain defaults to \"Integer\". The zero of \"Boolean\" is False, and the \
zero of FiniteField[p, n] is that field's zero element.\
\>", "Notes",ExpressionUUID->"075f9eb5-dc78-b840-a77a-46e8ee0c7718"],

Cell["\<\
A constant array is invariant under every permutation of its indices, so a \
regular one is declared \"Symmetric\". An array of unequal index lengths \
cannot carry a symmetry and is declared \"Rigid\".\
\>", "Notes",ExpressionUUID->"a7482a55-f5e8-9141-b76e-3fa8c3a1f26e"],

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"cec508c9-eabb-724a-9afc-f38ccc4766d6"],

Cell["Normal @ ZeroArray[2, 3]", "Input",ExpressionUUID->"a46d6eef-f190-b64f-a381-0d6be10acbea"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "}"}]], "Output",ExpressionUUI\
D->"1228de4f-4346-a845-b259-c058675cbaa6"],

Cell["Any shape, and any domain:", "ExampleText",ExpressionUUID->"a8694675-6980-e543-afc3-0965f7f9aaf4"],

Cell["\<\
{ArrayDimensions @ ZeroArray[{2, 3, 4}], Normal @ ZeroArray[1, 3, \"Real\"]}\
\>", "Input",ExpressionUUID->"7996af03-d577-2948-87ca-8d1045ae4da4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "3", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0.`", ",", "0.`", ",", "0.`"}], "}"}]}], "}"}]], "Output",Express\
ionUUID->"c7e0e87b-7804-bc4e-8177-4a3bdf9e19d6"],

Cell["A regular constant array is symmetric:", "ExampleText",ExpressionUUID->"1a10840f-1e51-e54f-b39f-e65a9c041294"],

Cell["\<\
{ArraySymmetry @ ZeroArray[3, 2], ArraySymmetry @ ZeroArray[{2, 3}]}\
\>", "Input",ExpressionUUID->"23edcbda-16ba-db43-8ea2-ee3546e1005c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Symmetric\"\>", ",", "\<\"Rigid\"\>"}], "}"}]], "Output",Expres\
sionUUID->"8ba66d05-ce55-bc4e-89f1-fde8bbb83afe"],

Cell["Source", "NotesSection",ExpressionUUID->"d3c77b9c-6352-c44e-8c04-a9e64562d9a5"],

Cell[TextData[{
 "Defined in ",
 StyleBox["src/ArrayAlgebra.wl",
  FontFamily->"Courier",
  FontWeight->"Plain"],
 ", section ",
 "\[OpenCurlyDoubleQuote]",
 "Special arrays",
 "\[CloseCurlyDoubleQuote]."
}], "Notes",ExpressionUUID->"1d46598d-dea3-1d44-b421-904e8eb4dab7"],

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"20468552-654a-3148-94d0-9fdf12003c39"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["OneArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "df830bf1-d024-d145-9384-96e45bd65871"],
 ", ",
 Cell[BoxData[
  StyleBox["IdentityArray", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "466fd3e7-849f-5649-a70d-fc7fabc68434"],
 ", ",
 Cell[BoxData[
  StyleBox["PartialIdentityArray", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"453a5765-257b-e546-aae9-1289139b74c5"],
 ", ",
 Cell[BoxData[
  StyleBox["ArrayObject", "InlineCode"]], "InlineFormula",ExpressionUUID->
  "4450e076-4677-244c-b450-fcc75a0ed698"]
}], "SeeAlso",ExpressionUUID->"8d4674bc-4401-2f4a-bfc2-07df21d9556c"]
},
