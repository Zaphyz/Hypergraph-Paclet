Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "A system is two things and nothing else, so it has two properties. There is \
no place to hang options on it: how far to evolve and how to draw belong to \
the asking, not to the system."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"434a026a-5c39-f64f-9bf0-b8bb18ded12b"],

