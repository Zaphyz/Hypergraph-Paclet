Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "There is no overlap test and no ancestry test here. An arrow of the causal \
graph is a token: an edge that one event created and another consumed. The \
relation is read off the tokens rather than computed from them, which is the \
whole reason this stack is organised the way it is."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"56b9e44c-d7b9-9240-94de-72548daeedfc"],

Cell["Token-event graph \[LongDash] the thing the others are made of", \
"Subsection",ExpressionUUID->"8ea8c3fd-6a83-b144-a25a-7307397e6c9e"],

Cell["\<\
The edges themselves as vertices, with the events between them. Each small \
panel is one hyperedge; each wide panel is one event, taking the edges above \
it and giving the ones below:\
\>", "Text",ExpressionUUID->"a981c34f-6ac2-ef47-a041-4ad17062b6dd"],

Cell["sys[1][\"TokenEventGraph\", ImageSize -> 620]", "Input",ExpressionUUID->"7a8d64f5-fc80-7c4a-979e-05e1ea0f983f"],

