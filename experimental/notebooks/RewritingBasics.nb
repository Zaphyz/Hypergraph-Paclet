Cell["\<\
\"MaxStates\" belongs to the evolving rather than the drawing, and stops a \
run that is growing faster than expected:\
\>", "Text",ExpressionUUID->"a3225800-4dad-5244-a2a7-f35bc789cd1d"],

Cell["Quiet @ sys[6, \"MaxStates\" -> 20][\"StateCount\"]", "Input",ExpressionUUID->"aa705cb9-75dd-8844-8002-ef607b0d40f5"],

Cell[BoxData["20"], "Output",ExpressionUUID->"3a3e9006-5c40-6b42-b9ff-b14b5902a39d"],

Cell["Any option of Graph goes through as well:", "Text",ExpressionUUID->"28c9dc35-19d0-b447-b3b5-9f4f300f9318"],

