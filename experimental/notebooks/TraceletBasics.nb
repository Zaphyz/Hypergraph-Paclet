Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Look at what each one starts from. The first begins with a single edge \
\[LongDash] not the two-edge path the system was run on. Nothing else was \
needed, so nothing else is there. That is the whole content of the word \
minimal, and of Behr's characterisation theorem: the trace that actually ran \
is this tracelet with a context glued on."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"307bbc62-ce6b-cd42-b154-6a0170eec8b2"],

