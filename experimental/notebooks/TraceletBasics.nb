Cell["\<\
Only the causally connected ones, which is the filter Behr's pathway analysis \
puts on:\
\>", "Text",ExpressionUUID->"09460f6b-8ccb-854b-a30a-652d8584d0f1"],

Cell["\<\
Length /@ {TraceletAnalysis[sys, 2], TraceletAnalysis[sys, 2, \"Causal\" -> \
True]}\
\>", "Input",ExpressionUUID->"2a4f38aa-0e79-5747-89ad-a51cf5a3eb38"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "1"}], "}"}]], "Output",ExpressionUUID->"51e6ea17-de84-ca42-821e-bbed35ab89ca"],

Cell["\<\
And with the context left in, which is the same trace read where it happened \
rather than on its own:\
\>", "Text",ExpressionUUID->"ab2e5ab5-7d90-914b-9163-df18410981c8"],

Cell["\<\
TraceletAnalysis[sys[2], {1, 3}, \"Minimal\" -> False][[1, \"Diagram\"]]\
\>", "Input",ExpressionUUID->"3de9dbd1-f482-f949-98b5-6a176d16dbf6"],

