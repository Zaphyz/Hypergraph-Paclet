Cell["\<\
Those two event numbers are joined in the causal graph above, and the \
tracelet is what that arrow means.\
\>", "Text",ExpressionUUID->"2ebde538-dc94-1c45-97dc-71311e64ceb7"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "A causal arrow in this stack is a token, and an overlap of a tracelet is a \
token, so the two notions are not merely compatible \[LongDash] they are the \
same list read twice. That is the reason the tracelet code is short: it \
computes nothing that the evolution did not already record."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"d8a6eba9-b5b6-6440-9ad0-aee550d6e168"],

Cell["5. Labels", "Section",ExpressionUUID->"367f0b6a-82a3-ab41-8823-ad1be91391eb"],

Cell["\<\
Composition of labelled arrows. Two steps, and the two bracketings:\
\>", "Text",ExpressionUUID->"b0f8523b-f2d2-034a-b33f-1a51a222eef7"],

Cell["\<\
comp = HypergraphRule[
  {Edge[{1, 2}, \"Directed\", x], Edge[{2, 3}, \"Directed\", y]},
  {Edge[{1, 3}, \"Directed\", Row[{\"(\", x, y, \")\"}]]}];
chain = Hypergraph[{Edge[{1, 2}, \"Directed\", a], Edge[{2, 3}, \"Directed\", \
b],
                    Edge[{3, 4}, \"Directed\", c]}];
lts = TraceletAnalysis[RewritingSystem[comp, chain], 2];
Length[lts]\
\>", "Input",ExpressionUUID->"1d2aa117-d756-d549-b8eb-2bb077395425"],

Cell[BoxData["2"], "Output",ExpressionUUID->"8949eb6e-38ac-b74c-ba28-7a610b529125"],

Cell["Column[#[\"Diagram\"] & /@ lts, Spacings -> 1.2]", "Input",ExpressionUUID->"d313afdc-8b5d-a440-b5ed-2c16ed3eaaa0"],

