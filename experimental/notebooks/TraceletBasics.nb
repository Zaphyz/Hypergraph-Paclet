Cell["3. Overlaps, which are the causality", "Section",ExpressionUUID->"0c7e270a-337e-1f47-98ce-1a9b69ec33ff"],

Cell["\<\
What glues one step to the next is a token: an edge the first made and the \
second used. That is the admissible match of the categorical account. The \
causal tracelet has one:\
\>", "Text",ExpressionUUID->"b53a68a9-add6-ee43-9775-7803c0460efa"],

Cell["t1[\"Overlaps\"]", "Input",ExpressionUUID->"407b1759-876f-f849-883f-a98d9ae95f3f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\[LeftAssociation]", 
   RowBox[{
    RowBox[{"\<\"From\"\>", "\[Rule]", "1"}], ",", 
    RowBox[{"\<\"To\"\>", "\[Rule]", "2"}], ",", 
    RowBox[{"\<\"Tokens\"\>", "\[Rule]", 
     RowBox[{"{", "3", "}"}]}], ",", 
    RowBox[{"\<\"Edges\"\>", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"Edge", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Vertex", "[", "1", "]"}], ",", 
          RowBox[{"Vertex", "[", 
           RowBox[{"\[FormalV]", "[", "1", "]"}], "]"}]}], "}"}], 
        ",", "\<\"Directed\"\>"}], "]"}], "}"}]}]}], "\[RightAssociation]"}], 
  "}"}]], "Output",ExpressionUUID->"e7d24875-cc9b-6c4e-91a8-b0a8d0d8ae11"],

