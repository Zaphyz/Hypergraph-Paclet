Cell["\<\
Two steps of it can happen in nine ways, but they are only two derivations. \
TraceletAnalysis says which:\
\>", "Text",ExpressionUUID->"88c60295-7762-e84c-a71b-43499697911d"],

Cell["\<\
ts = TraceletAnalysis[sys, 2];
Length[ts]\
\>", "Input",ExpressionUUID->"9842f091-15dd-1e4a-8796-1e49113aa9ba"],

Cell[BoxData["2"], "Output",ExpressionUUID->"a8805a49-487f-6b48-8236-f3591d3daabf"],

Cell["\<\
Dataset[KeyTake[#, {\"Rules\", \"Causal\", \"Multiplicity\", \"Linearisations\
\"}] & /@ ts]\
\>", "Input",ExpressionUUID->"3dcb67c2-6d90-a143-a0df-0d456aae6d36"],

