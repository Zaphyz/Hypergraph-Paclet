Cell["\<\
And here the option earns its keep. Composing the first pair and composing \
the last pair are two events that share no arrow:\
\>", "Text",ExpressionUUID->"7f9b128c-56d1-0e4a-8951-8ac79b79295b"],

Cell["\<\
Complement[
  pairsOf @ chainSys[\"CausalEdges\", 2],
  pairsOf @ chainSys[\"CausalEdges\", 2, \"CausalDependence\" -> \"Edges\"]]\
\>", "Input",ExpressionUUID->"05e1fc02-94a0-434e-8daf-4e90947404b0"],

