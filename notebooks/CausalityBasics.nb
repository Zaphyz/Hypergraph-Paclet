Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Which elements appear is the same \"CausalDependence\" option as everywhere \
else. Under \"Edges\" only edge tokens are drawn, so a dependence that ran \
only through a shared vertex has nothing to run along and the two events \
stand apart \[LongDash] the contrast of section 4, made visible."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"4463fcad-74bf-da4b-bd9c-f5ad6697c80a"],

Cell["When not to draw", "Subsection",ExpressionUUID->"817e2bdc-59a1-354a-b1c1-d05f74f66b17"],

Cell["\<\
Drawing a state means laying out a hypergraph, and drawing an event means \
laying out two. Past a couple of dozen that is a wait nobody asked for, so a \
graph falls back to plain vertices and says which option to raise:\
\>", "Text",ExpressionUUID->"80ef20dd-acb4-ed4c-9b43-f7ca89b8ed2e"],

Cell["\<\
Short[Quiet @ HypergraphRewritingSystem[subdivide, Hypergraph[{{1, \
2}}]][\"EvolutionGraph\", 4],
  3]\
\>", "Input",ExpressionUUID->"781af283-ef8b-c94d-be3c-e22754653d40"],

