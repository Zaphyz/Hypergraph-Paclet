Cell["Zig-zag composition", "Subsection",ExpressionUUID->"e0048ecc-26a2-f44d-82ee-298d5fe2c92b"],

Cell["\<\
zig = HypergraphRule[
  {Edge[{1, 2}, \"Directed\", x], Edge[{3, 2}, \"Directed\", y], Edge[{3, 4}, \
\"Directed\", z]},
  {Edge[{1, 4}, \"Directed\", Row[{\"(\", x, y, z, \")\"}]]}];
long = Hypergraph[{Edge[{1, 2}, \"Directed\", a], Edge[{3, 2}, \"Directed\", \
b],
                   Edge[{3, 4}, \"Directed\", c], Edge[{5, 4}, \"Directed\", \
d],
                   Edge[{5, 6}, \"Directed\", e]}];
zigSys = HypergraphRewritingSystem[zig, long];
{zigSys[\"EventCount\", 1], zigSys[\"EventCount\", 2]}\
\>", "Input",ExpressionUUID->"b7138912-8b77-e84f-b583-d9648dbd68e4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"3", ",", "6"}], "}"}]], "Output",ExpressionUUID->"cd0b4f14-c84a-3940-9060-250f8c599ffe"],

Cell["\<\
The three bracketings of heap associativity, reached in two steps:\
\>", "Text",ExpressionUUID->"1b93caf0-a039-4f48-8589-7ea353176ead"],

Cell["\<\
DeleteDuplicates @ Select[
  EdgeLabel /@ EdgeList[#[\"Data\", \"Hypergraph\"]] & /@ \
zigSys[\"EventList\", 2],
  Length[#] === 1 &]\
\>", "Input",ExpressionUUID->"015330fc-83e1-f84c-bec1-ab6015e2acdc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    TemplateBox[{"\"(\"", 
      TemplateBox[{"\"(\"", "a", "b", "c", "\")\""}, "RowDefault"], "d", "e", 
      "\")\""},
     "RowDefault"], "}"}], ",", 
   RowBox[{"{", 
    TemplateBox[{"\"(\"", "a", "b", 
      TemplateBox[{"\"(\"", "c", "d", "e", "\")\""}, "RowDefault"], "\")\""},
     "RowDefault"], "}"}], ",", 
   RowBox[{"{", 
    TemplateBox[{"\"(\"", "a", 
      TemplateBox[{"\"(\"", "d", "c", "b", "\")\""}, "RowDefault"], "e", 
      "\")\""},
     "RowDefault"], "}"}]}], "}"}]], "Output",ExpressionUUID->"5e413f39-f8b5-\
1c49-948a-d5b922378ad3"],

Cell["\<\
Here each second step consumes the arrow the first one made, so the two \
readings agree:\
\>", "Text",ExpressionUUID->"19018a25-239a-0f4e-b703-4a9bb751729f"],

Cell["\<\
pairsOf @ zigSys[\"CausalEdges\", 2] ===
  pairsOf @ zigSys[\"CausalEdges\", 2, \"CausalDependence\" -> \"Edges\"]\
\>", "Input",ExpressionUUID->"2f032cc1-50f4-f34e-888f-b1e3eac15e56"],

Cell[BoxData["True"], "Output",ExpressionUUID->"91848f93-b95c-5f4a-a5ba-ac471262eff4"],

Cell["zigSys[\"EvolutionCausalGraph\", 2]", "Input",ExpressionUUID->"97df046f-93b2-e940-9a2c-4d3b10b84bdd"],

