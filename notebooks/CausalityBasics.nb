 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}]], "Output",ExpressionUUID\
->"6fe528ef-392b-f741-b2ad-1a9c1154613e"],

Cell["\<\
Four occurrences, of what is really one state reversed and reversed again. \
StatesGraph is where they are merged:\
\>", "Text",ExpressionUUID->"6e391445-4aba-3f47-af4f-81c74288546d"],

Cell["{flip[\"EvolutionGraph\", 3], flip[\"StatesGraph\", 3]}", "Input",ExpressionUUID->"1bc20f99-8137-8d46-9930-32061c53805d"],

