Cell["\<\
What counts as equal is \"CanonicalizeStates\". By default it is up to \
canonical form, so two states differing only in what their vertices are \
called are one. Comparing them as written merges far less:\
\>", "Text",ExpressionUUID->"2de242f6-c0b7-aa48-a0f6-13473b4c95fb"],

Cell["\<\
{VertexCount @ twoEdges[\"StatesGraph\", 2, \"StateRendering\" -> False],
  VertexCount @ twoEdges[\"StatesGraph\", 2, \"CanonicalizeStates\" -> False,
     \"StateRendering\" -> False]}\
\>", "Input",ExpressionUUID->"57eba796-cec6-6b4f-a6e3-a68e4a0d3d06"],

Cell[BoxData[
 RowBox[{"{", 
