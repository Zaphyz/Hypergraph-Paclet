Cell["Zig-zag composition", "Subsection",ExpressionUUID->"f2a14231-160c-f74d-ae39-992788227514"],

Cell["\<\
zig = HypergraphRule[
  {Edge[{1, 2}, \"Directed\", x], Edge[{3, 2}, \"Directed\", y], Edge[{3, 4}, \
\"Directed\", z]},
  {Edge[{1, 4}, \"Directed\", Row[{\"(\", x, y, z, \")\"}]]}];
long = Hypergraph[{Edge[{1, 2}, \"Directed\", a], Edge[{3, 2}, \"Directed\", \
b],
                   Edge[{3, 4}, \"Directed\", c], Edge[{5, 4}, \"Directed\", \
d],
                   Edge[{5, 6}, \"Directed\", e]}];
zigSys = HypergraphRewritingSystem[zig, long];
{zigSys[\"EventCount\", 1], zigSys[\"EventCount\", 2]}\
\>", "Input",ExpressionUUID->"bbca6686-2341-4d45-9de6-e775678eedd6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"3", ",", "6"}], "}"}]], "Output",ExpressionUUID->"235acc17-6529-e141-8787-8fab5dc2b05b"],

Cell["\<\
The three bracketings of heap associativity, reached in two steps:\
\>", "Text",ExpressionUUID->"97ea495f-2931-7244-94d1-e169a7d76ff6"],

Cell["\<\
DeleteDuplicates @ Select[
  EdgeLabel /@ EdgeList[#[\"Data\", \"Hypergraph\"]] & /@ \
zigSys[\"EventList\", 2],
  Length[#] === 1 &]\
\>", "Input",ExpressionUUID->"ad4444c7-662e-dc46-9cda-e692e0c89f8d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    TemplateBox[{"\"(\"", 
      TemplateBox[{"\"(\"", "a", "b", "c", "\")\""}, "RowDefault"], "d", "e", 
      "\")\""},
     "RowDefault"], "}"}], ",", 
   RowBox[{"{", 
    TemplateBox[{"\"(\"", "a", "b", 
      TemplateBox[{"\"(\"", "c", "d", "e", "\")\""}, "RowDefault"], "\")\""},
     "RowDefault"], "}"}], ",", 
   RowBox[{"{", 
    TemplateBox[{"\"(\"", "a", 
      TemplateBox[{"\"(\"", "d", "c", "b", "\")\""}, "RowDefault"], "e", 
      "\")\""},
     "RowDefault"], "}"}]}], "}"}]], "Output",ExpressionUUID->"ab18b5f0-489d-\
7b4d-83a6-a0acdd0126f5"],

Cell["\<\
Here each second step consumes the arrow the first one made, so the two \
readings agree:\
\>", "Text",ExpressionUUID->"6e1d1428-622e-324f-a70e-81e63914a74c"],

Cell["\<\
pairsOf @ zigSys[\"CausalEdges\", 2] ===
  pairsOf @ zigSys[\"CausalEdges\", 2, \"CausalDependence\" -> \"Edges\"]\
\>", "Input",ExpressionUUID->"208b1a2f-7123-6242-b4e8-97ceea449c4f"],

Cell[BoxData["True"], "Output",ExpressionUUID->"aca650c7-4af6-674c-8c9a-15411649f050"],

Cell["zigSys[\"EvolutionCausalGraph\", 2]", "Input",ExpressionUUID->"fe23d1d1-ef15-244d-8997-78b7132f71f8"],

