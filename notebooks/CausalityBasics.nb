Cell["TokenEventGraph \[LongDash] the elements themselves", "Subsection",ExpressionUUID->"3327e796-5627-934d-88d7-8b10255060ab"],

Cell["\<\
An event takes the elements it consumed and gives the ones it created, so a \
causal dependence becomes a path through an element rather than something \
inferred:\
\>", "Text",ExpressionUUID->"bf6b0d04-fa46-754f-bd6c-92c29a389a1b"],

Cell["\<\
twoEdges[\"TokenEventGraph\", 1, ImageSize -> 520, \"PanelSize\" -> 55]\
\>", "Input",ExpressionUUID->"30d749a4-8b15-df42-868e-2970c4747472"],

