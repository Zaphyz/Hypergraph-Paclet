   RowBox[{"\<\"DestroyedVertices\"\>", "\[Rule]", 
    RowBox[{"{", "}"}]}], ",", 
   RowBox[{"\<\"OutputState\"\>", "\[Rule]", "2"}]}], 
  "\[RightAssociation]"}]], "Output",ExpressionUUID->"0bc697e9-3821-ad42-b13c-\
f5df1b14b902"],

Cell["The evolution is a tree, not a graph of states", "Subsection",ExpressionUUID->"7d60a4ab-5330-8c4d-acae-3af07c1f3da1"],

Cell["\<\
A state reached two ways appears twice. Reversing an edge, back and forth:\
\>", "Text",ExpressionUUID->"81a3eaae-0137-cc4c-89d9-83cf12354015"],

Cell["\<\
flip = HypergraphRewritingSystem[{{1, 2}} -> {{2, 1}}, Hypergraph[{{1, 2}}]];
Table[flip[\"StateCount\", g], {g, 0, 3}]\
\>", "Input",ExpressionUUID->"b301780b-d2ba-304d-af31-cfea2c0a44a1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}]], "Output",ExpressionUUID\
->"477bbb08-8514-b64b-83c4-bdfab209772e"],

Cell["\<\
Four occurrences, of what is really one state reversed and reversed again. \
StatesGraph is where they are merged:\
\>", "Text",ExpressionUUID->"104258ff-33a7-ef4d-a72c-d952c2c9b320"],

Cell["{flip[\"EvolutionGraph\", 3], flip[\"StatesGraph\", 3]}", "Input",ExpressionUUID->"678f48b8-ce85-ea46-8970-681991a81b98"],

