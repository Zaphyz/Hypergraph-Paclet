Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Dependence is only asked about between events on one path: the later one \
must act on the state the earlier produced, or on a descendant of it. Two \
events on different branches of a multiway evolution never meet, whatever \
elements they appear to have in common \[LongDash] they are two things that \
could have happened, not two things that did. At one generation from a \
branching state there are therefore no causal edges at all."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"c8d5233e-7892-454f-afc9-e54f617f85bb"],

Cell["pairsOf @ twoEdges[\"CausalEdges\", 1]", "Input",ExpressionUUID->"74000c1f-f7cb-c645-8cec-21bb131bf9a7"],

Cell[BoxData[
 RowBox[{"{", "}"}]], "Output",ExpressionUUID->"789892fb-1bf5-0e47-95ae-d059f158c7b9"],

Cell["5. The graphs", "Section",ExpressionUUID->"2599fb7c-70da-2845-8142-16d4f6374a10"],

Cell["\<\
States alone, as the tree and as the merged graph; the states one step could \
have reached; the events and their dependence; and both together:\
\>", "Text",ExpressionUUID->"a7346cd2-02ed-3d46-ad57-6b6bf6173267"],

Cell["twoEdges[\"EvolutionGraph\", 2]", "Input",ExpressionUUID->"d4e0d7f2-3922-024c-b444-091d39de1718"],

