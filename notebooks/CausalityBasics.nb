Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Dependence is only asked about between events on one path: the later one \
must act on the state the earlier produced, or on a descendant of it. Two \
events on different branches of a multiway evolution never meet, whatever \
elements they appear to have in common \[LongDash] they are two things that \
could have happened, not two things that did. At one generation from a \
branching state there are therefore no causal edges at all."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"4cfd2a3b-5be0-364e-ab03-1b45c602d351"],

