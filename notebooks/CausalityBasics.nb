Cell["Zig-zag composition", "Subsection",ExpressionUUID->"3411987a-0412-dd4b-a9ba-033272f46a2d"],

Cell["\<\
zig = HypergraphRule[
  {Edge[{1, 2}, \"Directed\", x], Edge[{3, 2}, \"Directed\", y], Edge[{3, 4}, \
\"Directed\", z]},
  {Edge[{1, 4}, \"Directed\", Row[{\"(\", x, y, z, \")\"}]]}];
long = Hypergraph[{Edge[{1, 2}, \"Directed\", a], Edge[{3, 2}, \"Directed\", \
b],
                   Edge[{3, 4}, \"Directed\", c], Edge[{5, 4}, \"Directed\", \
d],
                   Edge[{5, 6}, \"Directed\", e]}];
zigSys = HypergraphRewritingSystem[zig, long];
{zigSys[\"EventCount\", 1], zigSys[\"EventCount\", 2]}\
\>", "Input",ExpressionUUID->"345689bc-beb6-924c-87fb-b0f7dfa5cce3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"3", ",", "6"}], "}"}]], "Output",ExpressionUUID->"43ba492d-021a-6144-aa03-622ddea944a9"],

Cell["\<\
The three bracketings of heap associativity, reached in two steps:\
\>", "Text",ExpressionUUID->"10e6705a-fca5-a848-bc3e-8a10b177e4db"],

Cell["\<\
DeleteDuplicates @ Select[
  EdgeLabel /@ EdgeList[#[\"Data\", \"Hypergraph\"]] & /@ \
zigSys[\"EventList\", 2],
  Length[#] === 1 &]\
\>", "Input",ExpressionUUID->"bfedd0e6-3343-9348-a6ec-0b1bec35e343"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    TemplateBox[{"\"(\"", 
      TemplateBox[{"\"(\"", "a", "b", "c", "\")\""}, "RowDefault"], "d", "e", 
      "\")\""},
     "RowDefault"], "}"}], ",", 
   RowBox[{"{", 
    TemplateBox[{"\"(\"", "a", "b", 
      TemplateBox[{"\"(\"", "c", "d", "e", "\")\""}, "RowDefault"], "\")\""},
     "RowDefault"], "}"}], ",", 
   RowBox[{"{", 
    TemplateBox[{"\"(\"", "a", 
      TemplateBox[{"\"(\"", "d", "c", "b", "\")\""}, "RowDefault"], "e", 
      "\")\""},
     "RowDefault"], "}"}]}], "}"}]], "Output",ExpressionUUID->"6271ab44-74fb-\
4e41-a238-a95809b912c2"],

Cell["\<\
Here each second step consumes the arrow the first one made, so the two \
readings agree:\
\>", "Text",ExpressionUUID->"b1eddb2d-28db-b44e-8a13-5eff01b12653"],

Cell["\<\
pairsOf @ zigSys[\"CausalEdges\", 2] ===
  pairsOf @ zigSys[\"CausalEdges\", 2, \"CausalDependence\" -> \"Edges\"]\
\>", "Input",ExpressionUUID->"e09e458f-402c-bc46-9525-b20eaa1efb20"],

