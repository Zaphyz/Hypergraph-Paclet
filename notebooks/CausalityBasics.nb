Cell["2. Evolution", "Section",ExpressionUUID->"cf2513be-0053-8e41-9741-ac359ec76e35"],

Cell["\<\
Every edge of every state is a place the subdivision rule fits, so each \
generation has one more edge to work on than the last:\
\>", "Text",ExpressionUUID->"1a09a971-a767-dc4b-8a74-e138e88d1ecd"],

Cell["\<\
Table[{g, system[\"StateCount\", g], system[\"EventCount\", g]}, {g, 0, 4}]\
\>", "Input",ExpressionUUID->"ff6a68f3-4d0f-6b41-8da0-4d9f4dd2899a"],

