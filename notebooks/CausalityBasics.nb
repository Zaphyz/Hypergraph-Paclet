Cell["Carried to the end, the five ways of bracketing four arrows:", "Text",ExpressionUUID->"2e22aa6a-0949-054d-9279-dc21af255cc8"],

Cell["\<\
DeleteDuplicates @ Select[
  EdgeLabel /@ EdgeList[#[\"Data\", \"Hypergraph\"]] & /@ \
chainSys[\"EventList\", 3],
  Length[#] === 1 &]\
\>", "Input",ExpressionUUID->"eb800707-5028-034b-ac56-3e97f6cfb73d"],

