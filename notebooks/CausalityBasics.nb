Cell["2. Evolution", "Section",ExpressionUUID->"9f837bb0-cdad-dc48-95ef-5521300401ed"],

Cell["\<\
Every edge of every state is a place the subdivision rule fits, so each \
generation has one more edge to work on than the last:\
\>", "Text",ExpressionUUID->"ba4d675c-ab3d-fb47-b06a-185db8ca8bc6"],

Cell["\<\
Table[{g, system[\"StateCount\", g], system[\"EventCount\", g]}, {g, 0, 4}]\
\>", "Input",ExpressionUUID->"3071dc35-94b0-8646-9a4a-30b9efbc1445"],

