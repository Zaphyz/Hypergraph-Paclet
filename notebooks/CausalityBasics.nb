   RowBox[{"\<\"RuleIndex\"\>", "\[Rule]", "1"}], ",", 
   RowBox[{"\<\"Generation\"\>", "\[Rule]", "1"}], ",", 
   RowBox[{"\<\"InputState\"\>", "\[Rule]", "1"}], ",", 
   RowBox[{"\<\"ConsumedEdges\"\>", "\[Rule]", 
    RowBox[{"{", "1", "}"}]}], ",", 
   RowBox[{"\<\"CreatedEdges\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"2", ",", "3"}], "}"}]}], ",", 
   RowBox[{"\<\"MatchedVertices\"\>", "\[Rule]", 
