Cell["\<\
An event says which rule fired, which state it acted on, which it made, and \
what it touched. \"Data\" is the event HypergraphRuleApply gave, so \
everything from the rewriting layer is still there:\
\>", "Text",ExpressionUUID->"8920ae0c-2ab6-aa4c-9586-9e4bb6d95eec"],

Cell["KeyDrop[First @ system[\"EventList\", 1], {\"Rule\", \"Data\"}]", \
"Input",ExpressionUUID->"2feeb3d7-41fd-4745-8051-c76634f133b9"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"RuleIndex\"\>", "\[Rule]", "1"}], ",", 
   RowBox[{"\<\"Generation\"\>", "\[Rule]", "1"}], ",", 
   RowBox[{"\<\"InputState\"\>", "\[Rule]", "1"}], ",", 
   RowBox[{"\<\"ConsumedEdges\"\>", "\[Rule]", 
    RowBox[{"{", "1", "}"}]}], ",", 
   RowBox[{"\<\"CreatedEdges\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"2", ",", "3"}], "}"}]}], ",", 
   RowBox[{"\<\"MatchedVertices\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}]}], ",", 
   RowBox[{"\<\"CreatedVertices\"\>", "\[Rule]", 
    RowBox[{"{", "3", "}"}]}], ",", 
   RowBox[{"\<\"DestroyedVertices\"\>", "\[Rule]", 
    RowBox[{"{", "}"}]}], ",", 
   RowBox[{"\<\"OutputState\"\>", "\[Rule]", "2"}]}], 
  "\[RightAssociation]"}]], "Output",ExpressionUUID->"51722b1e-ae47-724f-93c4-\
9d8c2d354c5b"],

Cell["The evolution is a tree, not a graph of states", "Subsection",ExpressionUUID->"d7d4200d-e4ba-1348-8a63-0d361dfe3f49"],

Cell["\<\
A state reached two ways appears twice. Reversing an edge, back and forth:\
\>", "Text",ExpressionUUID->"35ddd539-5876-0946-93c1-dc51409f957e"],

Cell["\<\
flip = HypergraphRewritingSystem[{{1, 2}} -> {{2, 1}}, Hypergraph[{{1, 2}}]];
Table[flip[\"StateCount\", g], {g, 0, 3}]\
\>", "Input",ExpressionUUID->"478203ab-6027-144c-8af2-a3b763ffddad"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}]], "Output",ExpressionUUID\
->"9dfd03d2-9622-ee4b-9b71-169c3f1a8b8a"],

Cell["\<\
Four occurrences, of what is really one state reversed and reversed again. \
StatesGraph is where they are merged:\
\>", "Text",ExpressionUUID->"68d1c042-79e6-ac47-bcf4-12e94b68d4e9"],

Cell["{flip[\"EvolutionGraph\", 3], flip[\"StatesGraph\", 3]}", "Input",ExpressionUUID->"652df7a6-6156-0a46-9795-1242cc9b6ea1"],

