   RowBox[{"\<\"DestroyedVertices\"\>", "\[Rule]", 
    RowBox[{"{", "}"}]}], ",", 
   RowBox[{"\<\"OutputState\"\>", "\[Rule]", "2"}]}], 
  "\[RightAssociation]"}]], "Output",ExpressionUUID->"6ef53089-58d8-9c4d-ba85-\
b7b341277934"],

Cell["The evolution is a tree, not a graph of states", "Subsection",ExpressionUUID->"3c3d53d9-4ed7-5e42-83b7-d1e55a2d31b7"],

Cell["\<\
A state reached two ways appears twice. Reversing an edge, back and forth:\
\>", "Text",ExpressionUUID->"5f1a0d6c-3e33-8545-a856-69caad019bc1"],

Cell["\<\
flip = HypergraphRewritingSystem[{{1, 2}} -> {{2, 1}}, Hypergraph[{{1, 2}}]];
Table[flip[\"StateCount\", g], {g, 0, 3}]\
\>", "Input",ExpressionUUID->"def09ad2-5b01-e748-8b0e-71ae7cd73022"],

