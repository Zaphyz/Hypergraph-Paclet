Cell["\<\
\"StateRendering\" and \"EventRendering\" settle the question either way, and \
\"MaxDrawnVertices\" moves the line.\
\>", "Text",ExpressionUUID->"7a31543f-e19d-a646-80d2-f92ef3dee053"],

Cell["Keeping track of the options", "Subsection",ExpressionUUID->"25a055d0-1a27-354e-832b-4297a7510783"],

Cell["\<\
There are enough options now that they are kept in one registry, with their \
defaults. Each of them is shown at work at the end of this section:\
\>", "Text",ExpressionUUID->"ea754bb4-7081-6e4c-99ad-cf654926c513"],

Cell["$HypergraphRewritingOptions", "Input",ExpressionUUID->"e93923ee-a33e-9e42-86ce-c92dcdeef235"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"MaxStates\"\>", "\[Rule]", "2048"}], ",", 
   RowBox[{"\<\"Labeled\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"LabelPatterns\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"DistinctVertices\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"CausalDependence\"\>", "\[Rule]", "\<\"Elements\"\>"}], ",", 
   RowBox[{"\<\"TransitiveReduction\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"CanonicalizeStates\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"StateRendering\"\>", "\[Rule]", "Automatic"}], ",", 
   RowBox[{"\<\"EventRendering\"\>", "\[Rule]", "Automatic"}], ",", 
   RowBox[{"\<\"MaxDrawnVertices\"\>", "\[Rule]", "24"}], ",", 
   RowBox[{"\<\"PanelSize\"\>", "\[Rule]", "90"}], ",", 
   RowBox[{"\<\"HypergraphPlotOptions\"\>", "\[Rule]", 
    RowBox[{"{", "}"}]}]}], "}"}]], "Output",ExpressionUUID->"2053e6cb-43d9-\
b74d-a0c7-4e8c3a81c520"],

Cell["\<\
Every graph-valued property takes those together with the options of Graph, \
so ImageSize, VertexSize, GraphLayout and the rest all work. A system can \
also hold the options that describe it, rather than having them retyped on \
every call:\
\>", "Text",ExpressionUUID->"777c1972-13f4-2f44-b613-a3117dbfeda8"],

Cell["\<\
strict = HypergraphRewritingSystem[subdivide, Hypergraph[{{1, 2}, {2, 3}}],
  \"CausalDependence\" -> \"Edges\", \"PanelSize\" -> 70];
{Length @ strict[\"CausalEdges\", 2],
  Length @ strict[\"CausalEdges\", 2, \"CausalDependence\" -> \"Elements\"]}\
\>", "Input",ExpressionUUID->"8038256c-1845-f441-b11f-6537fc77fe08"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"4", ",", "6"}], "}"}]], "Output",ExpressionUUID->"4a299078-fc6a-e444-8416-3ca60b709a00"],

Cell["\<\
The held option is used without being repeated, and an option given to a \
property still wins over it. What is in force for a particular system:\
\>", "Text",ExpressionUUID->"0d9b6904-9ad9-a047-a1fd-8b995dfa543a"],

Cell["\<\
FilterRules[strict[\"Options\"], {\"CausalDependence\", \"PanelSize\", \
\"MaxDrawnVertices\"}]\
\>", "Input",ExpressionUUID->"b392e164-2f85-614e-80da-24ee7d03ebb5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"CausalDependence\"\>", "\[Rule]", "\<\"Edges\"\>"}], ",", 
   RowBox[{"\<\"MaxDrawnVertices\"\>", "\[Rule]", "24"}], ",", 
   RowBox[{"\<\"PanelSize\"\>", "\[Rule]", "70"}]}], "}"}]], "Output",Expressi\
onUUID->"c330d091-46e4-a84c-aa79-b76ea3f5b253"],

Cell["Every option, and what it changes", "Subsection",ExpressionUUID->"6e388475-7bf6-954e-9d84-fcdf7aaea615"],

Cell["\<\
The registry, in the three groups it falls into. Four options govern the \
evolution, three govern what is made of it, and five govern how it is drawn:\
\>", "Text",ExpressionUUID->"66312001-652a-c745-8abb-8953bd7577f9"],

Cell["\<\
Column[{
  Row[{\"evolution:  \", Keys @ Association @ \
Take[$HypergraphRewritingOptions, 4]}],
  Row[{\"causality:  \", Keys @ Association @ \
Take[$HypergraphRewritingOptions, {5, 7}]}],
  Row[{\"drawing:    \", Keys @ Association @ \
Take[$HypergraphRewritingOptions, -5]}]}]\
\>", "Input",ExpressionUUID->"df87ada0-dc2c-a147-a20c-0884d4183672"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{"\"evolution:  \"", 
       RowBox[{"{", 
         RowBox[{
          "\"MaxStates\"", ",", "\"Labeled\"", ",", "\"LabelPatterns\"", ",", 
           "\"DistinctVertices\""}], "}"}]},
      "RowDefault"]},
    {
     TemplateBox[{"\"causality:  \"", 
       RowBox[{"{", 
         RowBox[{
          "\"CausalDependence\"", ",", "\"TransitiveReduction\"", ",", 
           "\"CanonicalizeStates\""}], "}"}]},
      "RowDefault"]},
    {
     TemplateBox[{"\"drawing:    \"", 
       RowBox[{"{", 
         RowBox[{
          "\"StateRendering\"", ",", "\"EventRendering\"", ",", 
           "\"MaxDrawnVertices\"", ",", "\"PanelSize\"", ",", 
           "\"HypergraphPlotOptions\""}], "}"}]},
      "RowDefault"]}
   },
   DefaultBaseStyle->"Column",
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Column"]], "Output",ExpressionUUID->"c06ae5d3-f39e-4d4a-9298-fedbcd0c95bd"],

Cell["\<\
\"MaxStates\" stops an evolution that is growing faster than expected rather \
than running on, and gives HypergraphRewritingSystem::trunc saying which \
generation it stopped in. Six generations of this rule would be tens of \
thousands of states; the limit cuts it off at forty, against ten at three \
generations:\
\>", "Text",ExpressionUUID->"b6cbb250-831f-fb4b-8775-e9ee17a44ab2"],

Cell["\<\
{Quiet @ HypergraphRewritingSystem[subdivide, Hypergraph[{{1, 2}}]][
     \"StateCount\", 6, \"MaxStates\" -> 40],
  HypergraphRewritingSystem[subdivide, Hypergraph[{{1, 2}}]][\"StateCount\", \
3]}\
\>", "Input",ExpressionUUID->"10819369-570f-d941-aca3-2794ab6d6ce7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"40", ",", "10"}], "}"}]], "Output",ExpressionUUID->"b312b02e-6fc7-8b4a-a761-d104bf0f7389"],

Cell["\<\
\"Labeled\", \"LabelPatterns\" and \"DistinctVertices\" are the matching \
options of HypergraphRuleApply, passed through to every rule application the \
evolution makes:\
\>", "Text",ExpressionUUID->"ae5ca5a3-2561-5842-b6ec-6f92bdcf9954"],

Cell["\<\
labelledStart = Hypergraph[{Edge[{1, 2}, \"Directed\", \"a\"], Edge[{2, 3}, \
\"Directed\", \"b\"]}];
onlyA = HypergraphRewritingSystem[HypergraphRule[{Edge[{1, 2}, \"Directed\", \
\"a\"]}, {{2, 1}}],
                                  labelledStart];
{onlyA[\"EventCount\", 1], onlyA[\"EventCount\", 1, \"Labeled\" -> False]}\
\>", "Input",ExpressionUUID->"6a8cb16c-3c7b-4341-b771-6e64b44aedd8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2"}], "}"}]], "Output",ExpressionUUID->"cd862329-ac01-c848-bbbb-700b545a7ca5"],

Cell["\<\
\"PanelSize\" is how many pixels wide each picture is drawn, and \
\"HypergraphPlotOptions\" is passed to every hypergraph inside a vertex \
\[LongDash] which is how to get the vertex names back, or to restyle what is \
drawn:\
\>", "Text",ExpressionUUID->"ae068bc4-cda5-224f-802f-54b7943382b2"],

Cell["\<\
twoEdges[\"EvolutionGraph\", 1, ImageSize -> 380, \"PanelSize\" -> 130,
  \"HypergraphPlotOptions\" -> {VertexLabels -> \"Name\"}]\
\>", "Input",ExpressionUUID->"0a15d07b-bdaf-e342-9431-e237f4758114"],

