Cell["Three places to compose, then two from each, then one:", "Text",ExpressionUUID->"84007e64-681a-1540-a9ca-404dbf41d628"],

Cell["Table[chainSys[\"EventCount\", g], {g, 0, 3}]", "Input",ExpressionUUID->"3dc43c49-d2a6-2e46-9415-d4d1297093ab"],

