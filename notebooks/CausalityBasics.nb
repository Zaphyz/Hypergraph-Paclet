Cell["Zig-zag composition", "Subsection",ExpressionUUID->"a8c5617e-6100-8746-84ca-6dd2e5c5ba3a"],

Cell["\<\
zig = HypergraphRule[
  {Edge[{1, 2}, \"Directed\", x], Edge[{3, 2}, \"Directed\", y], Edge[{3, 4}, \
\"Directed\", z]},
  {Edge[{1, 4}, \"Directed\", Row[{\"(\", x, y, z, \")\"}]]}];
long = Hypergraph[{Edge[{1, 2}, \"Directed\", a], Edge[{3, 2}, \"Directed\", \
b],
                   Edge[{3, 4}, \"Directed\", c], Edge[{5, 4}, \"Directed\", \
d],
                   Edge[{5, 6}, \"Directed\", e]}];
zigSys = HypergraphRewritingSystem[zig, long];
{zigSys[\"EventCount\", 1], zigSys[\"EventCount\", 2]}\
\>", "Input",ExpressionUUID->"a14e0615-3a3b-5948-a365-58e3729d345b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"3", ",", "6"}], "}"}]], "Output",ExpressionUUID->"8ac2406f-7405-f946-a54d-d45cd3def324"],

Cell["\<\
The three bracketings of heap associativity, reached in two steps:\
\>", "Text",ExpressionUUID->"c124a692-3293-c54a-9383-8c8bb4f2b2ce"],

Cell["\<\
DeleteDuplicates @ Select[
  EdgeLabel /@ EdgeList[#[\"Data\", \"Hypergraph\"]] & /@ \
zigSys[\"EventList\", 2],
  Length[#] === 1 &]\
\>", "Input",ExpressionUUID->"719ad1b7-e5fe-a042-9e3d-4d31eafe7bcc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    TemplateBox[{"\"(\"", 
      TemplateBox[{"\"(\"", "a", "b", "c", "\")\""}, "RowDefault"], "d", "e", 
      "\")\""},
     "RowDefault"], "}"}], ",", 
   RowBox[{"{", 
    TemplateBox[{"\"(\"", "a", "b", 
      TemplateBox[{"\"(\"", "c", "d", "e", "\")\""}, "RowDefault"], "\")\""},
     "RowDefault"], "}"}], ",", 
   RowBox[{"{", 
    TemplateBox[{"\"(\"", "a", 
      TemplateBox[{"\"(\"", "d", "c", "b", "\")\""}, "RowDefault"], "e", 
      "\")\""},
     "RowDefault"], "}"}]}], "}"}]], "Output",ExpressionUUID->"ecf830c8-c48d-\
5241-99f5-88158b220f18"],

Cell["\<\
Here each second step consumes the arrow the first one made, so the two \
readings agree:\
\>", "Text",ExpressionUUID->"079cf665-96e4-4e4e-a5ef-8130b7c4cc33"],

Cell["\<\
pairsOf @ zigSys[\"CausalEdges\", 2] ===
  pairsOf @ zigSys[\"CausalEdges\", 2, \"CausalDependence\" -> \"Edges\"]\
\>", "Input",ExpressionUUID->"276510ca-f1af-794b-8171-ef29149acb40"],

Cell[BoxData["True"], "Output",ExpressionUUID->"70834276-92c7-094e-aa16-fa263c3f8621"],

Cell["zigSys[\"EvolutionCausalGraph\", 2]", "Input",ExpressionUUID->"c527a697-59b4-4949-b038-6ed5f65e6fe2"],

