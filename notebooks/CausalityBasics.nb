Cell["2. Evolution", "Section",ExpressionUUID->"9365db4e-791b-0642-b710-2ebf27626cc6"],

Cell["\<\
Every edge of every state is a place the subdivision rule fits, so each \
generation has one more edge to work on than the last:\
\>", "Text",ExpressionUUID->"1ca8f06a-2c7c-1d48-827b-c5655e88b738"],

Cell["\<\
Table[{g, system[\"StateCount\", g], system[\"EventCount\", g]}, {g, 0, 4}]\
\>", "Input",ExpressionUUID->"9be1ab41-bee2-214e-9187-da55d406a532"],

