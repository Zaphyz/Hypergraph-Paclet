 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "8"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"9cca2009-e691-f843-b1c5-4c51db812c89"],

Cell["\<\
Select[chainSys[\"CausalEdges\", 2], #[\"SharedEdges\"] === {} &]\
\>", "Input",ExpressionUUID->"4f318952-0c8a-8741-bd95-c0479ca35ecd"],

