   RowBox[{"2", ",", "9"}], "}"}], "}"}]], "Output",ExpressionUUID->"76898ddd-\
4388-3246-9f5a-d955df829dad"],

Cell["pairsOf @ catSys[\"CausalEdges\", 2]", "Input",ExpressionUUID->"22475b9a-ac78-ea47-9de4-6f4f9238e239"],

