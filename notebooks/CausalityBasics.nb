Cell["\<\
Every vertex carries the state or the event it stands for as a tooltip, so a \
graph can be read by pointing at it.\
\>", "Text",ExpressionUUID->"095ffae4-22fb-6245-a787-ab65006e463d"],

Cell["6. Systems from the reference notebooks", "Section",ExpressionUUID->"0f1386d6-0c58-f34e-ba59-b79be1f64e87"],

Cell["\<\
The rules of reference/Chemoids.wl, evolved. Section 5 of RewritingBasics.nb \
ran them a step at a time by hand; a rewriting system is what that was \
standing in for.\
\>", "Text",ExpressionUUID->"a954260f-72cb-bb44-887a-f913016da16a"],

Cell["Composition along a chain", "Subsection",ExpressionUUID->"bc4b409f-d27c-ce4a-b4a5-2b013e215257"],

Cell["\<\
comp = HypergraphRule[
  {Edge[{1, 2}, \"Directed\", x], Edge[{2, 3}, \"Directed\", y]},
  {Edge[{1, 3}, \"Directed\", Row[{\"(\", x, y, \")\"}]]}];
chain4 = Hypergraph[{Edge[{1, 2}, \"Directed\", a], Edge[{2, 3}, \
\"Directed\", b],
                     Edge[{3, 4}, \"Directed\", c], Edge[{4, 5}, \
\"Directed\", d]}];
chainSys = HypergraphRewritingSystem[comp, chain4]\
\>", "Input",ExpressionUUID->"7da94355-636b-2f4a-8644-9e6bf14f45e2"],

