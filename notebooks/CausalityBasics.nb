Cell["\<\
\"TransitiveReduction\" is on by default, leaving only the edges the order \
does not already imply. Two generations of this rule happen to have nothing \
implied; three have plenty:\
\>", "Text",ExpressionUUID->"39920a1a-6e5d-a343-ace6-041f5bd969b4"],

Cell["\<\
Table[{n,
    EdgeCount @ twoEdges[\"CausalGraph\", n, \"EventRendering\" -> False],
    EdgeCount @ twoEdges[\"CausalGraph\", n, \"TransitiveReduction\" -> \
False,
       \"EventRendering\" -> False]}, {n, 2, 3}]\
\>", "Input",ExpressionUUID->"8866f2b5-34ce-f246-8979-3d3541566780"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "6", ",", "6"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "30", ",", "48"}], "}"}]}], "}"}]], "Output",ExpressionU\
UID->"e5ab551e-4c12-724b-b569-a939c9a099fc"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Thirty edges against forty-eight at three generations. The eighteen the \
reduction removes are the ones saying that an event depends on something it \
already depends on through another event, which is true and adds nothing to \
the picture."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"8bd9a7e2-1461-6342-8fc2-f46a44bbe4cb"],

Cell["EvolutionCausalGraph \[LongDash] states and events together", \
"Subsection",ExpressionUUID->"00718c7f-e16c-c34d-8609-af25bd7a6ba3"],

Cell["\<\
State to event to state, with the causal edges laid over them in red. Events \
are the wide panels, states the square ones:\
\>", "Text",ExpressionUUID->"a5a8a7df-d129-3548-a618-990f75569c07"],

Cell["\<\
twoEdges[\"EvolutionCausalGraph\", 2, ImageSize -> 560, \"PanelSize\" -> 55]\
\>", "Input",ExpressionUUID->"446f4637-7674-b649-ad36-51c4cf42bbbf"],

