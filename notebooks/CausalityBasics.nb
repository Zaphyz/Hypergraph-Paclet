   RowBox[{"\<\"DestroyedVertices\"\>", "\[Rule]", 
    RowBox[{"{", "}"}]}], ",", 
   RowBox[{"\<\"OutputState\"\>", "\[Rule]", "2"}]}], 
  "\[RightAssociation]"}]], "Output",ExpressionUUID->"b1d61004-325f-ba46-98dd-\
5cce2ad3b4bf"],

Cell["The evolution is a tree, not a graph of states", "Subsection",ExpressionUUID->"555949ab-eb02-fa45-8d4f-bf67aa6664f2"],

Cell["\<\
A state reached two ways appears twice. Reversing an edge, back and forth:\
\>", "Text",ExpressionUUID->"3f038b6a-48ed-264a-875b-f59b969e168c"],

Cell["\<\
flip = HypergraphRewritingSystem[{{1, 2}} -> {{2, 1}}, Hypergraph[{{1, 2}}]];
Table[flip[\"StateCount\", g], {g, 0, 3}]\
\>", "Input",ExpressionUUID->"3ac61012-7700-f647-94e7-a00917f453a4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}]], "Output",ExpressionUUID\
->"da83822d-e33d-e84e-860f-6a52351d5ded"],

Cell["\<\
Four occurrences, of what is really one state reversed and reversed again. \
StatesGraph is where they are merged:\
\>", "Text",ExpressionUUID->"0bd1fbf0-12c5-c048-a6ce-1e9590dc487b"],

Cell["{flip[\"EvolutionGraph\", 3], flip[\"StatesGraph\", 3]}", "Input",ExpressionUUID->"039ac3bd-7111-234f-9af6-f7e8ba172bc1"],

