Cell["Zig-zag composition", "Subsection",ExpressionUUID->"c340466a-c672-f346-bceb-c341250d5808"],

Cell["\<\
zig = HypergraphRule[
  {Edge[{1, 2}, \"Directed\", x], Edge[{3, 2}, \"Directed\", y], Edge[{3, 4}, \
\"Directed\", z]},
  {Edge[{1, 4}, \"Directed\", Row[{\"(\", x, y, z, \")\"}]]}];
long = Hypergraph[{Edge[{1, 2}, \"Directed\", a], Edge[{3, 2}, \"Directed\", \
b],
                   Edge[{3, 4}, \"Directed\", c], Edge[{5, 4}, \"Directed\", \
d],
                   Edge[{5, 6}, \"Directed\", e]}];
zigSys = HypergraphRewritingSystem[zig, long];
{zigSys[\"EventCount\", 1], zigSys[\"EventCount\", 2]}\
\>", "Input",ExpressionUUID->"21ce90e8-984c-984a-b9d3-c48f2bb8180b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"3", ",", "6"}], "}"}]], "Output",ExpressionUUID->"a8a9df48-853a-584e-9372-92f7a6539cc0"],

Cell["\<\
The three bracketings of heap associativity, reached in two steps:\
\>", "Text",ExpressionUUID->"587e9802-f772-c74d-9126-a7054b0d260d"],

Cell["\<\
DeleteDuplicates @ Select[
  EdgeLabel /@ EdgeList[#[\"Data\", \"Hypergraph\"]] & /@ \
zigSys[\"EventList\", 2],
  Length[#] === 1 &]\
\>", "Input",ExpressionUUID->"a34e68d9-637c-8c40-93d5-9b2f160859d8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    TemplateBox[{"\"(\"", 
      TemplateBox[{"\"(\"", "a", "b", "c", "\")\""}, "RowDefault"], "d", "e", 
      "\")\""},
     "RowDefault"], "}"}], ",", 
   RowBox[{"{", 
    TemplateBox[{"\"(\"", "a", "b", 
      TemplateBox[{"\"(\"", "c", "d", "e", "\")\""}, "RowDefault"], "\")\""},
     "RowDefault"], "}"}], ",", 
   RowBox[{"{", 
    TemplateBox[{"\"(\"", "a", 
      TemplateBox[{"\"(\"", "d", "c", "b", "\")\""}, "RowDefault"], "e", 
      "\")\""},
     "RowDefault"], "}"}]}], "}"}]], "Output",ExpressionUUID->"43eac137-4cb2-\
6b4d-858d-3a2abb5b5859"],

Cell["\<\
Here each second step consumes the arrow the first one made, so the two \
readings agree:\
\>", "Text",ExpressionUUID->"7dffd290-83e1-dc48-8860-466f908101fb"],

Cell["\<\
pairsOf @ zigSys[\"CausalEdges\", 2] ===
  pairsOf @ zigSys[\"CausalEdges\", 2, \"CausalDependence\" -> \"Edges\"]\
\>", "Input",ExpressionUUID->"c607ce51-a1fb-8a44-aa96-b0fac1d8c9a0"],

Cell[BoxData["True"], "Output",ExpressionUUID->"35b89f58-eefe-4d4f-9714-84ddf4c91de3"],

Cell["zigSys[\"EvolutionCausalGraph\", 2]", "Input",ExpressionUUID->"65d67f42-f323-394a-b987-a66e389ccec4"],

