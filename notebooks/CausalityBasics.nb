Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Keeping the occurrences apart is what the causal reading needs: which \
elements a state is made of depends on how it was reached, and two events can \
only be causally related when one lies on a path through the other. Merging \
first would throw away exactly the information the causal graph is built \
from. StatesGraph merges for display, on top of the tree, and by default up \
to canonical form \[LongDash] a rewrite names the vertices it creates after \
what is already there, so two branches reaching the same shape rarely reach \
it under the same names. Setting \"CanonicalizeStates\" -> False asks for the \
states as written."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"f934bccf-e130-4a4b-9b45-67502cbcebf8"],

Cell["\<\
{VertexCount @ flip[\"StatesGraph\", 3],
  VertexCount @ flip[\"StatesGraph\", 3, \"CanonicalizeStates\" -> False]}\
\>", "Input",ExpressionUUID->"294beb9e-142f-4640-a475-9f44cf8e2344"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2"}], "}"}]], "Output",ExpressionUUID->"342364b3-7247-1541-9c16-fae8e60179dc"],

Cell["3. What an event touched", "Section",ExpressionUUID->"d2624334-ad2a-a347-b13e-a55caf590ccb"],

Cell["\<\
The causal question is about elements: which ones an event took, and which it \
left behind. An event reports both, as tokens:\
\>", "Text",ExpressionUUID->"abe3beea-4286-bc40-87f6-58acac08eca1"],

Cell["\<\
KeyTake[First @ system[\"EventList\", 1],
  {\"ConsumedEdges\", \"CreatedEdges\", \"MatchedVertices\", \
\"CreatedVertices\", \"DestroyedVertices\"}]\
\>", "Input",ExpressionUUID->"fa744830-159f-f241-aeaa-1d55df134987"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"ConsumedEdges\"\>", "\[Rule]", 
    RowBox[{"{", "1", "}"}]}], ",", 
   RowBox[{"\<\"CreatedEdges\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"2", ",", "3"}], "}"}]}], ",", 
   RowBox[{"\<\"MatchedVertices\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}]}], ",", 
   RowBox[{"\<\"CreatedVertices\"\>", "\[Rule]", 
    RowBox[{"{", "3", "}"}]}], ",", 
   RowBox[{"\<\"DestroyedVertices\"\>", "\[Rule]", 
    RowBox[{"{", "}"}]}]}], "\[RightAssociation]"}]], "Output",ExpressionUUID->\
"e35069c1-75af-9241-b1ed-d49519ab8745"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "A token is a counter, minted when an element is created and carried \
unchanged for as long as that element survives. Elements are not followed by \
value, because an edge is an element of a multiset: two edges that look the \
same are still two elements, and a vertex identifier freed by one event may \
be handed out again by a later one. Following values instead of tokens would \
make a hypergraph with a repeated edge report dependences that are not \
there."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"24428e78-e5a3-9247-96bb-a8a8ecd9ff33"],

Cell["\<\
Two identical edges give two events, and the two consume different elements \
even though nothing tells the edges apart:\
\>", "Text",ExpressionUUID->"a7bc4484-2219-b948-8f13-dfaa27e20cfc"],

Cell["\<\
HypergraphRewritingSystem[subdivide, Hypergraph[{{1, 2}, {1, \
2}}]][\"EventList\", 1] //
  Map[#[\"ConsumedEdges\"] &]\
\>", "Input",ExpressionUUID->"798a5c57-16f8-7648-ab3b-f678477afaff"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "1", "}"}], ",", 
   RowBox[{"{", "2", "}"}]}], "}"}]], "Output",ExpressionUUID->"19caa732-2cd6-\
7e44-9928-f9e92c632c23"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "What makes that work is \"EdgeOrigins\" on the underlying event, which says \
for each edge of the result which host edge it carries over from, or None \
where the rule made it. The Hypergraph constructor sorts the edges, so a \
position in the result says nothing on its own; without that record an edge \
could not be followed across a rewrite at all."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"08b200ae-0e35-1c42-b4d5-81d51dd8cfde"],

Cell["4. Causal dependence, and the option", "Section",ExpressionUUID->"9b811dda-b252-2145-99bb-0bc5f949f897"],

Cell["\<\
Two events are causally related when the elements they touch overlap. What \
counts as an element is the option \"CausalDependence\":\
\>", "Text",ExpressionUUID->"7ee2b2e7-ed7b-3e4d-ae17-0bae73162c60"],

Cell["$CausalDependenceTypes", "Input",ExpressionUUID->"8af7e621-32e6-274a-96f5-85a2d3fc1a2c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Elements\"\>", ",", "\<\"Edges\"\>", ",", "\<\"Vertices\"\>"}],
   "}"}]], "Output",ExpressionUUID->"0c7cb208-51c8-a442-a09f-044dfb5b892b"],

Cell["Take a path of two edges and subdivide, twice:", "Text",ExpressionUUID->"e6e38cea-04f3-1e4e-841e-375b435618b0"],

Cell["\<\
twoEdges = HypergraphRewritingSystem[subdivide, Hypergraph[{{1, 2}, {2, \
3}}]];
twoEdges[\"EventCount\", 2]\
\>", "Input",ExpressionUUID->"4c713202-7e64-e14d-b7c7-c97cd96c5b36"],

Cell[BoxData["8"], "Output",ExpressionUUID->"9e809bc9-1e59-8347-be3a-7c67cf129d3c"],

Cell["\<\
pairsOf[l_] := {#[\"From\"], #[\"To\"]} & /@ l;
byType[t_] := pairsOf @ twoEdges[\"CausalEdges\", 2, \"CausalDependence\" -> \
t];
AssociationMap[byType, $CausalDependenceTypes]\
\>", "Input",ExpressionUUID->"c53a8bab-5c4e-0c42-ba24-5bfb2d27587f"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Elements\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "3"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "4"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "5"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "6"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "7"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "8"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"\<\"Edges\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "3"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "5"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "7"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "8"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"\<\"Vertices\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "3"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "4"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "5"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "6"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "7"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "8"}], "}"}]}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",ExpressionUUID->"5b82a02f-62d0-a24a-bdfc-\
0c4a320ca400"],

Cell["\<\
Four pairs by edges, six by elements. The two that only elements sees:\
\>", "Text",ExpressionUUID->"f3f07aee-7731-eb47-bc4c-f127b6a9609b"],

Cell["Complement[byType[\"Elements\"], byType[\"Edges\"]]", "Input",ExpressionUUID->"81a66470-7fdd-5c46-87b6-4c9745f7ba39"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "6"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"75a6dd01-d4ff-f44f-bc6c-83ac488df1fb"],

Cell["\<\
Those are the ones whose matches share no edge at all \[LongDash] they meet \
at the vertex between the two halves of the path:\
\>", "Text",ExpressionUUID->"a35a34e5-42e4-164f-9e57-87969e951212"],

Cell["\<\
Select[twoEdges[\"CausalEdges\", 2], #[\"SharedEdges\"] === {} &]\
\>", "Input",ExpressionUUID->"b46a663c-8841-444a-8f8d-885c621d348b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"From\"\>", "\[Rule]", "1"}], ",", 
     RowBox[{"\<\"To\"\>", "\[Rule]", "4"}], ",", 
     RowBox[{"\<\"SharedEdges\"\>", "\[Rule]", 
      RowBox[{"{", "}"}]}], ",", 
     RowBox[{"\<\"SharedVertices\"\>", "\[Rule]", 
      RowBox[{"{", "2", "}"}]}]}], "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"From\"\>", "\[Rule]", "2"}], ",", 
     RowBox[{"\<\"To\"\>", "\[Rule]", "6"}], ",", 
     RowBox[{"\<\"SharedEdges\"\>", "\[Rule]", 
      RowBox[{"{", "}"}]}], ",", 
     RowBox[{"\<\"SharedVertices\"\>", "\[Rule]", 
      RowBox[{"{", "2", "}"}]}]}], "\[RightAssociation]"}]}], "}"}]], "Output",\
ExpressionUUID->"a81622bb-d88f-4840-a431-ff933c6ba08b"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "This is the design point. The default, \"Elements\", is the weakest \
reading: two rule applications are related as soon as their matched patterns \
are superposed anywhere, vertex or edge. It is what the reference paclets \
take. \"Edges\" is the strictest: two events are related only when one \
consumed a whole edge the other made. Neither is more correct than the other. \
Subdividing one edge of a path and then the other really does leave the \
second event free of anything the first produced, and really does have the \
two matches meeting at a vertex; whether that vertex is a channel along which \
one event can affect the other is a fact about what the hypergraph is \
standing for."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"686018a3-a506-3d43-bb69-daedb32513d1"],

Cell["\<\
The three readings stand in a fixed relation on every system, which is why \
there are three and not two:\
\>", "Text",ExpressionUUID->"b2b4acda-e9e5-704e-93d9-bf7d4f4f92d8"],

Cell["\<\
{SubsetQ[byType[\"Elements\"], byType[\"Edges\"]],
  SubsetQ[byType[\"Elements\"], byType[\"Vertices\"]],
  Sort @ byType[\"Elements\"] === Sort @ Union[byType[\"Edges\"], \
byType[\"Vertices\"]]}\
\>", "Input",ExpressionUUID->"f0b8642a-1113-f34a-ba23-abe0718c2aa2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",ExpressionUUID->\
"87283751-35fc-224b-b452-c4f6300ae06f"],

Cell["What a causal edge reports", "Subsection",ExpressionUUID->"d1017b9e-d2df-fd44-a406-1181f3449d49"],

Cell["\<\
Not just that two events are related, but which elements they had in common:\
\>", "Text",ExpressionUUID->"752dfd4f-3365-8d48-83a9-e13756503e49"],

Cell["First @ twoEdges[\"CausalEdges\", 2]", "Input",ExpressionUUID->"6eb65a8d-657e-394b-a2e3-70019a73c926"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"From\"\>", "\[Rule]", "1"}], ",", 
   RowBox[{"\<\"To\"\>", "\[Rule]", "3"}], ",", 
   RowBox[{"\<\"SharedEdges\"\>", "\[Rule]", 
    RowBox[{"{", "3", "}"}]}], ",", 
   RowBox[{"\<\"SharedVertices\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1", ",", "4"}], "}"}]}]}], "\[RightAssociation]"}]], "Output",Ex\
pressionUUID->"ee536c97-9160-1844-8e2f-7eedf8cd0b92"],

Cell["\<\
And the relation as a graph, one vertex per event, numbered as in \"EventList\
\":\
\>", "Text",ExpressionUUID->"f461063d-9a1f-4342-b25e-5b21b0819be2"],

Cell["\<\
{twoEdges[\"CausalGraph\", 2],
  twoEdges[\"CausalGraph\", 2, \"CausalDependence\" -> \"Edges\"]}\
\>", "Input",ExpressionUUID->"67fe9286-e092-8845-9f64-a98426e01cdc"],

