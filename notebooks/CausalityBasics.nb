Cell["Carried to the end, the five ways of bracketing four arrows:", "Text",ExpressionUUID->"cf051900-6959-be4a-bc1e-ae72d8574036"],

Cell["\<\
DeleteDuplicates @ Select[
  EdgeLabel /@ EdgeList[#[\"Data\", \"Hypergraph\"]] & /@ \
chainSys[\"EventList\", 3],
  Length[#] === 1 &]\
\>", "Input",ExpressionUUID->"00782025-45c5-4d48-ab4b-34431610775d"],

