Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Dependence is only asked about between events on one path: the later one \
must act on the state the earlier produced, or on a descendant of it. Two \
events on different branches of a multiway evolution never meet, whatever \
elements they appear to have in common \[LongDash] they are two things that \
could have happened, not two things that did. At one generation from a \
branching state there are therefore no causal edges at all."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"a7676c69-5f21-db42-b464-4a1432dc4542"],

Cell["pairsOf @ twoEdges[\"CausalEdges\", 1]", "Input",ExpressionUUID->"b2eefdda-52b7-1a47-be50-e24b9b1ce1f2"],

Cell[BoxData[
 RowBox[{"{", "}"}]], "Output",ExpressionUUID->"2674468b-bc3f-1e42-ab43-65bb6bb38a90"],

Cell["5. The graphs", "Section",ExpressionUUID->"6b88c75b-b967-b14b-acc9-89498d43e8b0"],

Cell["\<\
Six graphs come out of one evolution, each answering a different question. \
All of them draw their states and events as pictures, carry the object they \
stand for as a tooltip, and take the options of Graph on top of the options \
of the system.\
\>", "Text",ExpressionUUID->"27a3d347-0ed7-da4d-b541-a64405d36822"],

Cell["EvolutionGraph \[LongDash] the tree of what happened", "Subsection",ExpressionUUID->"0779a93c-9060-8f4e-aad7-bebb4d333623"],

Cell["\<\
One vertex per state occurrence, one edge per event. Nothing is merged, so a \
state reached two ways appears twice:\
\>", "Text",ExpressionUUID->"c1e8999c-a129-f64b-a91c-d3e90ba81d82"],

Cell["\<\
twoEdges[\"EvolutionGraph\", 2, ImageSize -> 460, \"PanelSize\" -> 80]\
\>", "Input",ExpressionUUID->"17ee2dd4-5d08-f54a-ad45-d09b78726df6"],

