Cell["\<\
\"TransitiveReduction\" is on by default, leaving only the edges the order \
does not already imply. Two generations of this rule happen to have nothing \
implied; three have plenty:\
\>", "Text",ExpressionUUID->"ae847abe-670d-a84b-9e23-e647c8652c39"],

Cell["\<\
Table[{n,
    EdgeCount @ twoEdges[\"CausalGraph\", n, \"EventRendering\" -> False],
    EdgeCount @ twoEdges[\"CausalGraph\", n, \"TransitiveReduction\" -> \
False,
       \"EventRendering\" -> False]}, {n, 2, 3}]\
\>", "Input",ExpressionUUID->"73b1de9e-1b49-b049-ada9-bd95517bfeac"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
