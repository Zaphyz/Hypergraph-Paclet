Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "The colours are those of the Wolfram Physics Project, which is what the \
reference paclets draw these graphs in: states in blue, events in amber, \
causal edges in red, branchial edges in magenta. The values are copied into \
the source rather than fetched from the style resource function the reference \
calls, because that is a network call on a machine that has not cached it, \
and a package that cannot be loaded offline is not worth the exactness."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"f66359a9-5627-ad4b-a8b3-95ab6b2f483f"],

Cell["Elements as vertices", "Subsection",ExpressionUUID->"b30d30d7-7471-e841-9d09-9ec3f6968f96"],

Cell["\<\
The token-event graph puts the elements themselves in the picture: an event \
takes the ones it consumed and gives the ones it created, and a causal \
dependence is then a path rather than something inferred.\
\>", "Text",ExpressionUUID->"280b1f90-b3c6-dd4d-a620-de0c1f7a757f"],

Cell["\<\
twoEdges[\"TokenEventGraph\", 1, ImageSize -> 520, \"PanelSize\" -> 60]\
\>", "Input",ExpressionUUID->"6d6aab21-1359-3b46-9c71-db9b05b08783"],

