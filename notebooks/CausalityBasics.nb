{chainSys[\"CausalGraph\", 2, ImageSize -> 340, \"PanelSize\" -> 45],
  chainSys[\"CausalGraph\", 2, \"CausalDependence\" -> \"Edges\",
    ImageSize -> 340, \"PanelSize\" -> 45]}\
\>", "Input",ExpressionUUID->"e9936877-0d76-174a-b901-3a14c6baa338"],

