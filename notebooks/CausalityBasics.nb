Cell["Three places to compose, then two from each, then one:", "Text",ExpressionUUID->"c23f5ff3-4324-af4a-9d4f-62ad155d6b20"],

Cell["Table[chainSys[\"EventCount\", g], {g, 0, 3}]", "Input",ExpressionUUID->"3a85d4ab-46d8-f04f-9c13-a4f149b59fd1"],

