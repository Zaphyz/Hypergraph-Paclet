{chainSys[\"CausalGraph\", 2],
  chainSys[\"CausalGraph\", 2, \"CausalDependence\" -> \"Edges\"]}\
\>", "Input",ExpressionUUID->"4013c903-9f2f-c74e-a9fc-1279f81f0c20"],

