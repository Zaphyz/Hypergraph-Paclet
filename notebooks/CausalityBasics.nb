Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "This is section 4's contrast made visible. Two events joined in the \
token-event graph under \"Elements\" but not under \"Edges\" are exactly the \
pairs whose matches meet at a vertex and nowhere else."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"24cb7562-9359-3642-a840-1e392244c783"],

Cell["6. Systems from the reference notebooks", "Section",ExpressionUUID->"cdabaed8-54d8-0f44-aa33-d33f27a7947a"],

Cell["\<\
The rules of reference/Chemoids.wl, evolved. Section 5 of RewritingBasics.nb \
ran them a step at a time by hand; a rewriting system is what that was \
standing in for.\
\>", "Text",ExpressionUUID->"b3fbc8dd-a98d-cb48-a44e-eb9cc4458b7a"],

Cell["Composition along a chain", "Subsection",ExpressionUUID->"9de5b716-f189-744b-bdf9-78d38eebc0c7"],

Cell["\<\
comp = HypergraphRule[
  {Edge[{1, 2}, \"Directed\", x], Edge[{2, 3}, \"Directed\", y]},
  {Edge[{1, 3}, \"Directed\", Row[{\"(\", x, y, \")\"}]]}];
chain4 = Hypergraph[{Edge[{1, 2}, \"Directed\", a], Edge[{2, 3}, \
\"Directed\", b],
                     Edge[{3, 4}, \"Directed\", c], Edge[{4, 5}, \
\"Directed\", d]}];
chainSys = HypergraphRewritingSystem[comp, chain4]\
\>", "Input",ExpressionUUID->"b2e79864-2188-094b-b070-d53876685a1f"],

