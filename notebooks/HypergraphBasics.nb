Cell["\<\
a and b are the same directed path on different identifiers, so they are \
isomorphic. c is an out-star, which as a directed hypergraph is a different \
object:\
\>", "Text",ExpressionUUID->"4bfb0c60-54f7-9d4e-8fce-7019154d9f2c"],

Cell[CellGroupData[{

Cell["{IsomorphicHypergraphQ[a, b], IsomorphicHypergraphQ[a, c]}", "Input",ExpressionUUID->"4a74b470-fcdb-d648-b29c-9faf62542327"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",ExpressionUUID->"e24449ea-\
3b27-1b42-8711-c13beb2505c5"]
}, Open  ]],

Cell["\<\
The witnessing renaming is available too, and is an empty association when \
there is none:\
\>", "Text",ExpressionUUID->"d05a4ae1-c02d-d346-bbdd-ab5cb6066733"],

Cell[CellGroupData[{

Cell["\<\
{FindHypergraphIsomorphism[a, b], FindHypergraphIsomorphism[a, c]}\
\>", "Input",ExpressionUUID->"72556908-c064-ad4d-a96d-0558a64e23b3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"1", "\[Rule]", "10"}], ",", 
     RowBox[{"2", "\[Rule]", "20"}], ",", 
     RowBox[{"3", "\[Rule]", "30"}]}], "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], "}"}]], "Output",E\
xpressionUUID->"77152920-9ca5-7645-9b0a-fb98d27d86b3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Symmetry types are respected", "Subsection",ExpressionUUID->"1a62368e-9289-9648-87d0-d16eb03346ce"],

Cell["\<\
The same two hypergraphs, with both edges made unordered, become isomorphic \
\[LongDash] an undirected path on three vertices is an undirected star:\
\>", "Text",ExpressionUUID->"21ad2085-7e9e-0242-b4eb-b9bf21d8f43c"],

Cell[CellGroupData[{

Cell["\<\
au = Hypergraph[{Edge[{1, 2}, \"Unordered\"], Edge[{2, 3}, \"Unordered\"]}];
cu = Hypergraph[{Edge[{1, 2}, \"Unordered\"], Edge[{1, 3}, \"Unordered\"]}];
{au, cu, IsomorphicHypergraphQ[au, cu]}\
\>", "Input",ExpressionUUID->"ed18f8b5-98c2-4143-90b6-a6816d0008e8"],

