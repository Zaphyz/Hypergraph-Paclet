Cell["\<\
Asking for the labels as well as the vertices returns both correspondences:\
\>", "Text",ExpressionUUID->"3fc0aa13-15bf-fb4a-a454-ccdc18be89ef"],

Cell["FindHypergraphIsomorphism[h1, h2, \"Labels\" -> True]", "Input",ExpressionUUID->"0c33fc15-2842-2b41-b52b-c797f0997ce2"],

Cell[BoxData[
