(* Beginning of Notebook Content *)
Notebook[{
Cell["Hypergraphs: Core Objects and Isomorphism", "Title",ExpressionUUID->"200d9636-15c2-554c-a826-8faa44f7ea31"],

Cell["WolframInstitute`Hypergraphs` \[LongDash] first milestone", "Subtitle",ExpressionUUID->"df9b0580-5a1e-a945-98c9-9d1f293387aa"],

Cell["\<\
This notebook shows the three core objects of the rewrite \[LongDash] Vertex, \
Edge and Hypergraph \[LongDash] their default graphical display, and the \
isomorphism test, together with the language design choices behind them. \
Everything below is live output from src/.\
\>", "Text",ExpressionUUID->"79be79ec-80e8-544d-b21d-9f511e76437f"],

Cell["\<\
A Hypergraph now draws itself, the way a Graph does. Where the exact stored \
expression is the point rather than the picture, the cell is repeated with \
InputForm.\
\>", "Text",ExpressionUUID->"b4e85d54-16e9-e14f-836d-edd9418f8817"],

Cell["\<\
Not implemented yet: rewriting rules, the hypermatrix layer, and the causal \
machinery. Those come next.\
\>", "Text",ExpressionUUID->"233c3911-cd11-c848-9085-519c5c20138e"],

Cell["Loading the package", "Section",ExpressionUUID->"af34044a-ec5e-fd40-9616-9f797f2c4132"],

Cell["\<\
The cell below is an initialization cell, which the front end evaluates when \
this notebook is opened, so that every symbol is ready by the time you read \
this.\
\>", "Text",ExpressionUUID->"2ca9d047-36a5-f74f-9f79-7f85db884e45"],

Cell["\<\
PacletDirectoryLoad[ParentDirectory[NotebookDirectory[]]];
Needs[\"WolframInstitute`Hypergraphs`\"]\
\>", "Input",
 InitializationCell->
  True,ExpressionUUID->"945c7e2f-c9a6-b542-89a6-a04a0a7e9fbc"],

Cell["\<\
The package lives in its own context, deliberately distinct from the \
installed upstream paclet WolframInstitute`Hypergraph` (singular) so that \
both can coexist while we develop. This is a one-line change if you would \
prefer a different name.\
\>", "Text",ExpressionUUID->"03fc906d-1223-2847-97d1-982607714f68"],

Cell["Names[\"WolframInstitute`Hypergraphs`*\"]", "Input",ExpressionUUID->"d302b1e0-3f2b-234e-80a2-82d89d222ff7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"AdjacencyHypermatrix\"\>", ",", "\<\"ArrayAdd\"\>", 
   ",", "\<\"ArrayDimensions\"\>", ",", "\<\"ArrayDomain\"\>", 
   ",", "\<\"ArrayEntries\"\>", ",", "\<\"ArrayGraphics\"\>", 
   ",", "\<\"ArrayGraphics3D\"\>", ",", "\<\"ArrayMultiply\"\>", 
   ",", "\<\"ArrayNesting\"\>", ",", "\<\"ArrayObject\"\>", 
   ",", "\<\"ArrayObjectQ\"\>", ",", "\<\"ArrayOrder\"\>", 
   ",", "\<\"ArraySymmetry\"\>", ",", "\<\"ArrayTimes\"\>", 
   ",", "\<\"CanonicalHypergraph\"\>", ",", "\<\"Edge\"\>", 
   ",", "\<\"EdgeLabel\"\>", ",", "\<\"EdgeObjectQ\"\>", 
   ",", "\<\"EdgeSymmetry\"\>", ",", "\<\"EdgeVertices\"\>", 
   ",", "\<\"FindArrayEquations\"\>", 
   ",", "\<\"FindHypergraphIsomorphism\"\>", 
   ",", "\<\"GenerateSymbolicArray\"\>", ",", "\<\"Hypergraph\"\>", 
   ",", "\<\"HypergraphCausalGraph\"\>", ",", "\<\"HypergraphEmbedding\"\>", 
   ",", "\<\"HypergraphEventPlot\"\>", ",", "\<\"HypergraphLargeQ\"\>", 
   ",", "\<\"HypergraphPlot\"\>", ",", "\<\"HypergraphQ\"\>", 
   ",", "\<\"HypergraphRewritingSystem\"\>", 
   ",", "\<\"HypergraphRewritingSystemQ\"\>", ",", "\<\"HypergraphRule\"\>", 
   ",", "\<\"HypergraphRuleApply\"\>", ",", "\<\"HypergraphRuleMatches\"\>", 
   ",", "\<\"HypergraphRulePlot\"\>", ",", "\<\"HypergraphRuleQ\"\>", 
   ",", "\<\"HypergraphSkeleton\"\>", ",", "\<\"Hypermatrix\"\>", 
   ",", "\<\"HypermatrixArrays\"\>", ",", "\<\"HypermatrixGraphics\"\>", 
   ",", "\<\"HypermatrixGraphics3D\"\>", ",", "\<\"HypermatrixQ\"\>", 
   ",", "\<\"IdentityArray\"\>", ",", "\<\"IsomorphicHypergraphQ\"\>", 
   ",", "\<\"OneArray\"\>", ",", "\<\"PartialIdentityArray\"\>", 
   ",", "\<\"RegularArrayQ\"\>", ",", "\<\"SetHypergraphPlotThresholds\"\>", 
   ",", "\<\"SimpleHypergraphQ\"\>", ",", "\<\"Vertex\"\>", 
   ",", "\<\"VertexID\"\>", ",", "\<\"VertexLabel\"\>", 
   ",", "\<\"VertexObjectQ\"\>", ",", "\<\"ZeroArray\"\>", 
   ",", "\<\"$CausalDependenceTypes\"\>", 
   ",", "\<\"$HypergraphRewritingOptions\"\>"}], "}"}]], "Output",ExpressionUU\
ID->"9185f231-41df-ad46-8c8c-77cb0ebb6b5f"],

Cell["1.  Vertices", "Section",ExpressionUUID->"5bed8dbf-518b-bd41-825b-20301c03f501"],

Cell["\<\
A vertex is Vertex[id] or Vertex[id, lab]. The identifier id is any Wolfram \
Language expression and is what makes the vertex unique; lab is any \
expression and may be omitted.\
\>", "Text",ExpressionUUID->"dba95200-5faa-0846-a9b8-993f92de9de2"],

Cell["Vertex[1]", "Input",ExpressionUUID->"c3c21911-69bd-e74b-8369-1d5b94d30361"],

Cell[BoxData[
 RowBox[{"Vertex", "[", "1", "]"}]], "Output",ExpressionUUID->"273cc0fa-21ea-6b4b-b998-f6e3b1d3e489"],

Cell["Vertex[1, \"a\"]", "Input",ExpressionUUID->"73170aa4-ab57-ca4a-afc1-2d91a9894c23"],

Cell[BoxData[
 RowBox[{"Vertex", "[", 
  RowBox[{"1", ",", "\<\"a\"\>"}], "]"}]], "Output",ExpressionUUID->"10ea5615-\
cf36-0848-99b0-7f986d48dbc1"],

Cell["Vertex[1, None]", "Input",ExpressionUUID->"ac8ab930-2eaa-0148-857c-46a9dc0d6db5"],

Cell[BoxData[
 RowBox[{"Vertex", "[", "1", "]"}]], "Output",ExpressionUUID->"d432e2ef-eadf-b542-b64b-05e606b70ede"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "A label of None means \[OpenCurlyDoubleQuote]no label\
\[CloseCurlyDoubleQuote], so Vertex[id, None] collapses to the one-argument \
form. Keeping a single spelling per vertex means that ordinary structural \
equality (===) on vertices already means \[OpenCurlyDoubleQuote]the same \
vertex\[CloseCurlyDoubleQuote], which the isomorphism code relies on \
throughout."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"8afee379-1fcf-7a47-b843-7bf4d605d8e5"],

Cell["The two parts are read back with VertexID and VertexLabel:", "Text",ExpressionUUID->"d9e04241-f3c4-3746-b282-7c5c0bb259f6"],

Cell["\<\
{VertexID[Vertex[x, \"a\"]], VertexLabel[Vertex[x, \"a\"]], \
VertexLabel[Vertex[1]]}\
\>", "Input",ExpressionUUID->"d05663cb-a5a4-4f41-89c4-8e57ebcce76c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"x", ",", "\<\"a\"\>", ",", "None"}], "}"}]], "Output",ExpressionUUI\
D->"0d381771-b55b-3845-944e-ee61765b9f18"],

Cell["\<\
Identifiers really are arbitrary expressions \[LongDash] integers, strings, \
symbols, lists, anything:\
\>", "Text",ExpressionUUID->"3480dc72-e603-574f-9d44-76ffad8e0f6c"],

Cell["\<\
{Vertex[1], Vertex[\"a\"], Vertex[{1, 2}], Vertex[u], Vertex[f[3]]}\
\>", "Input",ExpressionUUID->"e7c45124-4588-9f44-9dfc-ebfebb7c8a97"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Vertex", "[", "1", "]"}], ",", 
   RowBox[{"Vertex", "[", "\<\"a\"\>", "]"}], ",", 
   RowBox[{"Vertex", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}], "]"}], ",", 
   RowBox[{"Vertex", "[", "u", "]"}], ",", 
   RowBox[{"Vertex", "[", 
    RowBox[{"f", "[", "3", "]"}], "]"}]}], "}"}]], "Output",ExpressionUUID->\
"4b9781b9-f87c-cd47-a294-fba45d46a9eb"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Wherever a vertex is expected you may write the bare identifier instead, \
and it is promoted to a Vertex automatically. That is what keeps the second \
Hypergraph constructor, which takes plain lists of identifiers, as light as \
you specified it."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"c62190cb-2937-3545-958c-9ae8e0eb49f2"],

Cell["2.  Edges", "Section",ExpressionUUID->"e48652ec-2e34-434d-a971-898588412aba"],

Cell["\<\
A hyperedge is Edge[{v1, v2, \[Ellipsis]}, sym, lab]. The symmetry type sym \
is one of \"Directed\" (the default), \"Unordered\" or \"Cyclic\", and lab \
may be omitted.\
\>", "Text",ExpressionUUID->"cdd9db83-e210-0241-b37e-fb1b786e3e8a"],

Cell["Edge[{1, 2, 3}]", "Input",ExpressionUUID->"d13cfaf9-d157-3440-9c11-105eae2cf7be"],

Cell[BoxData[
 RowBox[{"Edge", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Vertex", "[", "1", "]"}], ",", 
     RowBox[{"Vertex", "[", "2", "]"}], ",", 
     RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", "\<\"Directed\"\>"}], 
  "]"}]], "Output",ExpressionUUID->"7c09961a-caee-6547-8383-ad6489cc519c"],

Cell["Edge[{1, 2, 3}, \"Unordered\"]", "Input",ExpressionUUID->"27c420f3-3e3c-ff48-bc8d-0ad95f11cd88"],

Cell[BoxData[
 RowBox[{"Edge", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Vertex", "[", "1", "]"}], ",", 
     RowBox[{"Vertex", "[", "2", "]"}], ",", 
     RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", "\<\"Unordered\"\>"}], 
  "]"}]], "Output",ExpressionUUID->"1cc24aa1-9778-944e-beb7-5c531179657d"],

Cell["Edge[{1, 2, 3}, \"Cyclic\", \"f\"]", "Input",ExpressionUUID->"6460a980-4d72-6d44-8688-ed1379d2bae9"],

Cell[BoxData[
 RowBox[{"Edge", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Vertex", "[", "1", "]"}], ",", 
     RowBox[{"Vertex", "[", "2", "]"}], ",", 
     RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", "\<\"Cyclic\"\>", 
   ",", "\<\"f\"\>"}], "]"}]], "Output",ExpressionUUID->"8f820a88-232e-3643-\
a27f-da729a1d04dd"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "The symmetry types are strings rather than symbols because Cyclic is \
already a protected System` symbol in the Wolfram Language. \"Ordered\" is \
accepted as a synonym for \"Directed\", and the spelling is case-insensitive \
on input, but the stored form is always one of the three canonical strings."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"9b34ecf1-aaea-8649-a61b-4797b70f791b"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "The stored form always shows the symmetry type explicitly, even when it is \
the default, because the symmetry changes the mathematics of the edge. The \
label is the opposite case \[LongDash] it is dropped when absent, so an \
unlabelled edge stays short to read."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"9cbaa456-c495-c541-a3d0-eee6577c252b"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Vertices and edges keep their literal form on output; only a whole \
Hypergraph turns into a picture. An edge on its own has no embedding, and its \
identity is exactly the expression you see, so printing it literally is the \
honest thing to do."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"05d37f4f-25eb-1749-aa7f-2a2a70a7d0e0"],

Cell["Canonical vertex order", "Subsection",ExpressionUUID->"3752d818-ca72-1a47-919a-4822918f44de"],

Cell["\<\
Each edge stores the least member of its symmetry orbit. An unordered edge is \
sorted, a cyclic edge is rotated to its smallest rotation, and a directed \
edge is left alone:\
\>", "Text",ExpressionUUID->"f9a5353f-fc9f-f840-8186-ecef640f3b83"],

Cell["\<\
{Edge[{3, 2, 1}, \"Unordered\"], Edge[{3, 1, 2}, \"Cyclic\"], Edge[{3, 2, 1}]}\
\>", "Input",ExpressionUUID->"29dd1660-0b37-644c-8903-365edd81a5a2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Edge", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Vertex", "[", "1", "]"}], ",", 
       RowBox[{"Vertex", "[", "2", "]"}], ",", 
       RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", "\<\"Unordered\"\>"}],
     "]"}], ",", 
   RowBox[{"Edge", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Vertex", "[", "1", "]"}], ",", 
       RowBox[{"Vertex", "[", "2", "]"}], ",", 
       RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", "\<\"Cyclic\"\>"}], 
    "]"}], ",", 
   RowBox[{"Edge", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Vertex", "[", "3", "]"}], ",", 
       RowBox[{"Vertex", "[", "2", "]"}], ",", 
       RowBox[{"Vertex", "[", "1", "]"}]}], "}"}], ",", "\<\"Directed\"\>"}], 
    "]"}]}], "}"}]], "Output",ExpressionUUID->"2c80fb36-4a28-e24a-8e3e-\
c58950107b59"],

Cell["\<\
The consequence is that two Edge objects are identical exactly when they are \
the same hyperedge. A rotation of a cyclic edge is the same edge:\
\>", "Text",ExpressionUUID->"85230b9e-f8cc-f24f-acb3-6a54b1bca626"],

Cell["Edge[{1, 2, 3}, \"Cyclic\"] === Edge[{3, 1, 2}, \"Cyclic\"]", "Input",ExpressionUUID->"0a5c3359-f24e-c545-9cda-d0d30e71570b"],

Cell[BoxData["True"], "Output",ExpressionUUID->"87e61433-acdc-694a-9873-6fe88dd3f363"],

Cell["\<\
\[Ellipsis] but a reflection of it is not, since the cyclic group contains \
rotations only:\
\>", "Text",ExpressionUUID->"49910398-1aef-254d-945f-248264ee5ea3"],

Cell["Edge[{1, 2, 3}, \"Cyclic\"] === Edge[{1, 3, 2}, \"Cyclic\"]", "Input",ExpressionUUID->"15c29ff4-7dab-8144-b35c-149253aec8cf"],

Cell[BoxData["False"], "Output",ExpressionUUID->"1889655b-0dde-0a47-99a3-5cc621e8dc21"],

Cell["\<\
The symmetry type and the label are both part of an edge's identity:\
\>", "Text",ExpressionUUID->"c2192f88-ee15-6b47-a055-3544072737d8"],

Cell["\<\
{Edge[{1, 2}] === Edge[{1, 2}, \"Unordered\"],
  Edge[{1, 2}, \"Directed\", \"f\"] === Edge[{1, 2}]}\
\>", "Input",ExpressionUUID->"831e2774-13ba-7d4c-9353-1f097b1f302d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "False"}], "}"}]], "Output",ExpressionUUID->"05ecb7bd-\
0ea1-d547-bb9b-ebfbade96ed5"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "This is the pivot of the whole design. Once === on edges means \
\[OpenCurlyDoubleQuote]is the same hyperedge\[CloseCurlyDoubleQuote], a \
hypergraph can be compared as a plain multiset of edges, and the symmetry \
types never have to be consulted again during an isomorphism search \
\[LongDash] they have already been absorbed into the representation."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"82ed3e8a-688e-984e-ae17-b9649278fb8f"],

Cell["\<\
An unrecognized symmetry type is rejected rather than silently accepted:\
\>", "Text",ExpressionUUID->"68527703-f7d2-574d-952f-36512fc4588e"],

Cell["Edge[{1, 2}, \"Sideways\"]", "Input",ExpressionUUID->"8bf69058-4fc1-7f40-8b86-5d0b56ed8200"],

Cell[BoxData["$evalFailed"], "Output",ExpressionUUID->"19fce1ca-f1e3-5d4c-9939-dec7d1777fdd"],

Cell["\<\
The outputs in this notebook were computed in a plain kernel, so the \
accompanying message appears on the console rather than as a cell. Evaluating \
the cell yourself shows it:

    Edge::sym: Sideways is not a valid edge symmetry type; expected \
\"Directed\", \"Unordered\" or \"Cyclic\".\
\>", "Text",ExpressionUUID->"6caf7312-ab41-5e4b-b22a-990cff8cafab"],

Cell["3.  Hypergraphs", "Section",ExpressionUUID->"cd9041da-544d-524a-950d-c044d997e899"],

Cell["\<\
A hypergraph can be given as a list of Edge objects, in which case the vertex \
set is the union of the vertices of those edges. It displays as a drawing of \
itself:\
\>", "Text",ExpressionUUID->"adaba72c-604f-b84a-a7e3-51a94af2e1a8"],

Cell["\<\
Hypergraph[{Edge[{1, 2}], Edge[{2, 3}], Edge[{1, 2, 3}, \"Unordered\"]}]\
\>", "Input",ExpressionUUID->"2243a11d-a2c1-8745-ac5a-cb269df1d60e"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["Hypergraphs",
   DynamicModuleBox[{Typeset`hg = HoldComplete[
     WolframInstitute`Hypergraphs`Hypergraph[{
       WolframInstitute`Hypergraphs`Vertex[1], 
       WolframInstitute`Hypergraphs`Vertex[2], 
       WolframInstitute`Hypergraphs`Vertex[3]}, {
       WolframInstitute`Hypergraphs`Edge[{
         WolframInstitute`Hypergraphs`Vertex[1], 
         WolframInstitute`Hypergraphs`Vertex[2]}, "Directed"], 
       WolframInstitute`Hypergraphs`Edge[{
         WolframInstitute`Hypergraphs`Vertex[2], 
         WolframInstitute`Hypergraphs`Vertex[3]}, "Directed"], 
       WolframInstitute`Hypergraphs`Edge[{
         WolframInstitute`Hypergraphs`Vertex[1], 
         WolframInstitute`Hypergraphs`Vertex[2], 
         WolframInstitute`Hypergraphs`Vertex[3]}, "Unordered"]}]]}, 
    {AbsoluteThickness[Medium], Opacity[0.5], Arrowheads[{{Medium, 0.5}}], {
      {Opacity[1], Arrowheads[{{Small, 0.5}}], 
       {Hue[0.63, 0.7, 0.5], Opacity[
        0.7], {ArrowBox[
          BSplineCurveBox[{{0.8768424375680299, 0.8659683851517446}, {
           0.8658339352737859, 0.}}]], {}}, 
        {Opacity[1]}}}, 
      {Opacity[1], Arrowheads[{{Small, 0.5}}], 
       {Hue[0.63, 0.7, 0.5], Opacity[
        0.7], {ArrowBox[
          BSplineCurveBox[{{0.8658339352737859, 0.}, {0.010498775754916756`, 
           0.8773698149728941}}]], {}}, 
        {Opacity[1]}}}, 
      {Hue[0.63, 0.66, 0.81], Opacity[0.1], 
       FilledCurveBox[{
        BSplineCurve[{{0.8658339352737859, 0.}, {0.7278649513099094, 
          0.507048462975376}, {0.8768424375680299, 0.8659683851517446}}], 
         BSplineCurve[{{0.8768424375680299, 0.8659683851517446}, {
          0.5140311614301921, 0.7263909167185995}, {0.010498775754916756`, 
          0.8773698149728941}}], 
         BSplineCurve[{{0.010498775754916756`, 0.8773698149728941}, {
