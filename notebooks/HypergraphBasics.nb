Cell["\<\
Every vertex label and every edge label is gone, while the symmetry types \
survive:\
\>", "Text",ExpressionUUID->"942fd678-9ca8-9748-a51e-65ce68f446e2"],

Cell["\<\
hs = HypergraphSkeleton[Hypergraph[{Edge[{Vertex[1, \"A\"], 2}, \
\"Unordered\", \"f\"]}]];
{hs[\"VertexLabels\"], hs[\"EdgeLabels\"], hs[\"EdgeSymmetries\"]}\
\>", "Input",ExpressionUUID->"7a037a30-3112-154a-bcca-eda2edaa5f14"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"None", ",", "None"}], "}"}], ",", 
   RowBox[{"{", "None", "}"}], ",", 
   RowBox[{"{", "\<\"Unordered\"\>", "}"}]}], "}"}]], "Output",ExpressionUUID->\
"98b683e0-7e8b-b649-8b17-7021c73a3133"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "The labels have to be removed from the Vertex objects sitting inside the \
edges, not just from the vertex list. Because the constructor treats a label \
on any occurrence of a vertex as authoritative and propagates it, leaving \
labelled vertices inside the edges would put every label straight back. This \
was in fact a bug in the first cut of the code, caught while building this \
notebook, and there are now four assertions guarding it."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"8283504c-7d41-5a4a-91ee-c844f5ad74b9"],

Cell["Identifiers of any kind", "Subsection",ExpressionUUID->"6c2740f5-8422-fc41-ae9f-7619af47dc0c"],

Cell["\<\
Since identifiers are arbitrary expressions, hypergraphs built on completely \
different kinds of identifier can be compared directly:\
\>", "Text",ExpressionUUID->"b5078ed8-07cd-8a43-944b-15211c4ee8ec"],

Cell["\<\
w1 = Hypergraph[{Edge[{\"a\", \"b\"}], Edge[{\"b\", {1, 2}}]}];
w2 = Hypergraph[{Edge[{x, y}], Edge[{y, z}]}];
{w1, w2}\
\>", "Input",ExpressionUUID->"ae17443c-fd9a-ad4b-a62a-da118bc75366"],

