   RowBox[{"\<\"VertexLabels\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"EdgeLabels\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"a\"\>", "\[Rule]", "\<\"x\"\>"}], ",", 
      RowBox[{"\<\"b\"\>", "\[Rule]", "\<\"y\"\>"}]}], 
     "\[RightAssociation]"}]}]}], "\[RightAssociation]"}]], "Output",Expressio\
nUUID->"bfeb8586-3f4d-2142-a19f-c4bdaa791e39"],

Cell["\<\
h3 below is the same path again, but carries the one label x on both of its \
edges. It is not isomorphic to h1, because a correspondence would have to \
send both a and b to x, and that is not one-to-one. What distinguishes the \
two is not the names of the labels but how many edges share each of them:\
\>", "Text",ExpressionUUID->"14d3197a-50a0-f748-805b-4567f478a647"],

Cell["\<\
h3 = Hypergraph[{Edge[{4, 5}, \"Directed\", \"x\"], Edge[{5, 6}, \
\"Directed\", \"x\"]}];
{h1, h3}\
\>", "Input",ExpressionUUID->"e1e52ff6-68df-d248-9a18-ec364eff2417"],

