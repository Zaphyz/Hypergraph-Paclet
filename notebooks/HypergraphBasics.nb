        DiskBox[{0.8768424375680299, 0.8659683851517446}, 
         Offset[{2., 2.}, {0., 0.}]]}, 
       {Hue[0.63, 0.26, 0.89], EdgeForm[{Hue[0.63, 0.7, 0.33], Opacity[
        0.95]}], 
        DiskBox[{0.8658339352737859, 0.}, Offset[{2., 2.}, {0., 0.}]]}, 
       {Hue[0.63, 0.26, 0.89], EdgeForm[{Hue[0.63, 0.7, 0.33], Opacity[
