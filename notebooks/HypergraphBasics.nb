Cell["Labelled and unlabelled", "Subsection",ExpressionUUID->"5e6e7936-52fd-d940-ae10-de0245b6a2ed"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "IsomorphicHypergraphQ respects labels by default. This is the conservative \
choice: it distinguishes more, and it collapses to plain isomorphism \
automatically when nothing is labelled, so the unlabelled case costs nothing. \
The option \"Labeled\" -> False compares the skeletons instead."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"930fb595-178f-9a48-a795-3baf45353d76"],

Cell["\<\
l1 = Hypergraph[{Vertex[1, \"A\"], Vertex[2, \"B\"], Vertex[3, \"C\"]}, {{1, \
2}, {2, 3}}];
l2 = Hypergraph[{Vertex[10, \"A\"], Vertex[20, \"B\"], Vertex[30, \"C\"]}, \
{{10, 20}, {20, 30}}];
l3 = Hypergraph[{Vertex[1, \"C\"], Vertex[2, \"B\"], Vertex[3, \"A\"]}, {{1, \
2}, {2, 3}}];
{l1, l2, l3}\
\>", "Input",ExpressionUUID->"9aca17a4-0600-aa45-be1d-0139dd4a3eae"],

