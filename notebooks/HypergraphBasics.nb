\>", "Input",ExpressionUUID->"58a0633c-0f3e-2e42-b749-7f47613716e6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"1", "\[Rule]", "7"}], ",", 
