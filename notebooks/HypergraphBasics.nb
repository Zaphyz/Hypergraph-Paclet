Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "An unlabelled element counts as carrying no label rather than as carrying \
some particular one, so it can only ever correspond to another unlabelled \
element. Without that, every unlabelled hypergraph would be isomorphic to a \
labelled one with the labels all alike."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"44aa0ab6-6aed-f441-be5e-3fb86b872913"],

Cell["\<\
Vertex labels and edge labels are corresponded independently of each other. \
Here both kinds are renamed at once, the vertices by A \[Rule] P, B \[Rule] Q \
and the edges by f \[Rule] g, g \[Rule] f:\
\>", "Text",ExpressionUUID->"579f7fbd-ae67-c74f-9c0f-d03e3fbac3e5"],

Cell[CellGroupData[{

Cell["\<\
i1 = Hypergraph[{Edge[{Vertex[1, \"A\"], Vertex[2, \"A\"]}, \"Directed\", \"f\
\"],
                 Edge[{Vertex[2, \"A\"], Vertex[3, \"B\"]}, \"Directed\", \"g\
\"]}];
i2 = Hypergraph[{Edge[{Vertex[1, \"P\"], Vertex[2, \"P\"]}, \"Directed\", \"g\
\"],
                 Edge[{Vertex[2, \"P\"], Vertex[3, \"Q\"]}, \"Directed\", \"f\
\"]}];
{i1, i2}\
\>", "Input",
 CellLabel->"In[5]:=",ExpressionUUID->"6c140620-5b32-cd49-a3d9-0ccfff1ef38d"],

