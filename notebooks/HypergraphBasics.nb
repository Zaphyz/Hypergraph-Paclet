Cell[CellGroupData[{

Cell["Identifiers of any kind", "Subsection",ExpressionUUID->"4add29eb-b197-704f-81cd-f9e3ee498034"],

Cell["\<\
Since identifiers are arbitrary expressions, hypergraphs built on completely \
different kinds of identifier can be compared directly:\
\>", "Text",ExpressionUUID->"c9bbd4c2-7b82-8841-bcb9-f927677f0664"],

Cell[CellGroupData[{

Cell["\<\
w1 = Hypergraph[{Edge[{\"a\", \"b\"}], Edge[{\"b\", {1, 2}}]}];
w2 = Hypergraph[{Edge[{x, y}], Edge[{y, z}]}];
{w1, w2}\
\>", "Input",ExpressionUUID->"3b191756-4633-454c-aa88-e6b4220d624e"],

