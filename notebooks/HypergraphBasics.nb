Notebook[{

Cell[CellGroupData[{
Cell["Hypergraphs: Core Objects and Isomorphism", "Title",ExpressionUUID->"90f8e665-d1b5-b443-8720-e6d97d4cf45b"],

Cell["WolframInstitute`Hypergraphs` \[LongDash] first milestone", "Subtitle",ExpressionUUID->"3385ef73-0940-0445-a7de-f5fe88cf78c8"],

Cell["\<\
This notebook shows the three core objects of the rewrite \[LongDash] Vertex, \
Edge and Hypergraph \[LongDash] their default graphical display, and the \
isomorphism test, together with the language design choices behind them. \
Everything below is live output from src/.\
\>", "Text",ExpressionUUID->"70caca51-7f4a-3e40-abaa-97c5dfdf4125"],

Cell["\<\
A Hypergraph now draws itself, the way a Graph does. Where the exact stored \
expression is the point rather than the picture, the cell is repeated with \
InputForm.\
\>", "Text",ExpressionUUID->"d5c08660-5efa-d94c-b839-67c57e0bc614"],

Cell["\<\
Not implemented yet: rewriting rules, the hypermatrix layer, and the causal \
machinery. Those come next.\
\>", "Text",ExpressionUUID->"f825be65-3db4-8a4e-8492-888efdbb60f2"],

Cell[CellGroupData[{

Cell["Loading the package", "Section",ExpressionUUID->"296e0505-f26d-114d-9f4a-b4439f05ff79"],

Cell["\<\
Get[FileNameJoin[{ParentDirectory[NotebookDirectory[]], \"src\", \
\"Hypergraph.wl\"}]]\
\>", "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"d7a27ab2-b61c-2e45-a7ff-bb3c2b12c547"],

Cell["\<\
The package lives in its own context, deliberately distinct from the \
installed upstream paclet WolframInstitute`Hypergraph` (singular) so that \
both can coexist while we develop. This is a one-line change if you would \
prefer a different name.\
\>", "Text",ExpressionUUID->"df9359d3-3c67-7b4d-8134-42b48d6d05ca"],

Cell[CellGroupData[{

Cell["Names[\"WolframInstitute`Hypergraphs`*\"]", "Input",
 CellLabel->"In[2]:=",ExpressionUUID->"41d4f36c-5e51-ae47-9f8d-9b19426588d7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"CanonicalHypergraph\"\>", ",", "\<\"Edge\"\>", 
   ",", "\<\"EdgeLabel\"\>", ",", "\<\"EdgeObjectQ\"\>", 
   ",", "\<\"EdgeSymmetry\"\>", ",", "\<\"EdgeVertices\"\>", 
   ",", "\<\"FindHypergraphIsomorphism\"\>", ",", "\<\"Hypergraph\"\>", 
   ",", "\<\"HypergraphEmbedding\"\>", ",", "\<\"HypergraphLargeQ\"\>", 
   ",", "\<\"HypergraphPlot\"\>", ",", "\<\"HypergraphQ\"\>", 
   ",", "\<\"HypergraphSkeleton\"\>", ",", "\<\"IsomorphicHypergraphQ\"\>", 
   ",", "\<\"SetHypergraphPlotThresholds\"\>", ",", "\<\"Vertex\"\>", 
   ",", "\<\"VertexID\"\>", ",", "\<\"VertexLabel\"\>", 
   ",", "\<\"VertexObjectQ\"\>"}], "}"}]], "Output",
 CellChangeTimes->{3.9986841393140736`*^9},
 CellLabel->"Out[2]=",ExpressionUUID->"87686f6f-6fe5-4b4d-9614-61f26a593a93"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["1.  Vertices", "Section",ExpressionUUID->"58442208-67cd-9f4e-b119-cd7de1628356"],

Cell["\<\
A vertex is Vertex[id] or Vertex[id, lab]. The identifier id is any Wolfram \
Language expression and is what makes the vertex unique; lab is any \
expression and may be omitted.\
\>", "Text",ExpressionUUID->"35652eaf-fd8e-ae46-8b82-e6b0dd12b9a1"],

Cell[CellGroupData[{

Cell["Vertex[1]", "Input",ExpressionUUID->"78f49445-7ec8-484c-8059-93b9fa6192f7"],

Cell[BoxData[
 RowBox[{"Vertex", "[", "1", "]"}]], "Output",ExpressionUUID->"32dfd18d-d983-6a47-8db6-2612367abd33"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Vertex[1, \"a\"]", "Input",ExpressionUUID->"58eba9d9-efca-654a-a5d5-aa08dcd9052e"],

Cell[BoxData[
 RowBox[{"Vertex", "[", 
  RowBox[{"1", ",", "\<\"a\"\>"}], "]"}]], "Output",ExpressionUUID->"f57830c4-\
f250-7641-8bdd-6c6fd70315a8"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Vertex[1, None]", "Input",ExpressionUUID->"2b5515e7-6453-7d4d-8ffd-b6c3c5504186"],

Cell[BoxData[
 RowBox[{"Vertex", "[", "1", "]"}]], "Output",ExpressionUUID->"c2793ccb-7acc-6042-be65-8af8408539c3"]
}, Open  ]],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "A label of None means \[OpenCurlyDoubleQuote]no label\
\[CloseCurlyDoubleQuote], so Vertex[id, None] collapses to the one-argument \
form. Keeping a single spelling per vertex means that ordinary structural \
equality (===) on vertices already means \[OpenCurlyDoubleQuote]the same \
vertex\[CloseCurlyDoubleQuote], which the isomorphism code relies on \
throughout."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"8a77959f-e144-ec4a-a057-8fdfc22797f1"],

Cell["The two parts are read back with VertexID and VertexLabel:", "Text",ExpressionUUID->"b6e60c92-b895-8649-9276-82ef53a456eb"],

Cell[CellGroupData[{

Cell["\<\
{VertexID[Vertex[x, \"a\"]], VertexLabel[Vertex[x, \"a\"]], \
VertexLabel[Vertex[1]]}\
\>", "Input",ExpressionUUID->"5f6e4993-d0a7-cb42-84af-2030eab05eec"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"x", ",", "\<\"a\"\>", ",", "None"}], "}"}]], "Output",ExpressionUUI\
D->"fc18feef-b720-fd4e-a7d6-a8b0b4472f78"]
}, Open  ]],

Cell["\<\
Identifiers really are arbitrary expressions \[LongDash] integers, strings, \
symbols, lists, anything:\
\>", "Text",ExpressionUUID->"da980b85-c2e0-6744-a0c2-1ca8a8902205"],

Cell[CellGroupData[{

Cell["\<\
{Vertex[1], Vertex[\"a\"], Vertex[{1, 2}], Vertex[u], Vertex[f[3]]}\
\>", "Input",ExpressionUUID->"80ba8f04-3d2b-cf4c-97e7-9802e1ce989f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Vertex", "[", "1", "]"}], ",", 
   RowBox[{"Vertex", "[", "\<\"a\"\>", "]"}], ",", 
   RowBox[{"Vertex", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}], "]"}], ",", 
   RowBox[{"Vertex", "[", "u", "]"}], ",", 
   RowBox[{"Vertex", "[", 
    RowBox[{"f", "[", "3", "]"}], "]"}]}], "}"}]], "Output",ExpressionUUID->\
"579e4570-6526-eb45-9eb7-2ddf767aa73e"]
}, Open  ]],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Wherever a vertex is expected you may write the bare identifier instead, \
and it is promoted to a Vertex automatically. That is what keeps the second \
Hypergraph constructor, which takes plain lists of identifiers, as light as \
you specified it."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"0e34cb34-4bbd-6b4b-9d58-188f91e73383"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2.  Edges", "Section",ExpressionUUID->"93f8f0e0-9a53-804a-a9aa-c8b35b3416d4"],

Cell["\<\
A hyperedge is Edge[{v1, v2, \[Ellipsis]}, sym, lab]. The symmetry type sym \
is one of \"Directed\" (the default), \"Unordered\" or \"Cyclic\", and lab \
may be omitted.\
\>", "Text",ExpressionUUID->"c73a6fcc-e368-6047-bb39-36292a762791"],

Cell[CellGroupData[{

Cell["Edge[{1, 2, 3}]", "Input",ExpressionUUID->"f9bb31b7-cdb0-174c-8047-cf835ff92183"],

Cell[BoxData[
 RowBox[{"Edge", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Vertex", "[", "1", "]"}], ",", 
     RowBox[{"Vertex", "[", "2", "]"}], ",", 
     RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", "\<\"Directed\"\>"}], 
  "]"}]], "Output",ExpressionUUID->"d09334b6-c362-d34f-9eaf-6d3ca4fb4f4a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Edge[{1, 2, 3}, \"Unordered\"]", "Input",ExpressionUUID->"451154c5-91d7-8747-89ec-bafaeabbc4d7"],

Cell[BoxData[
 RowBox[{"Edge", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Vertex", "[", "1", "]"}], ",", 
     RowBox[{"Vertex", "[", "2", "]"}], ",", 
     RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", "\<\"Unordered\"\>"}], 
  "]"}]], "Output",ExpressionUUID->"b09d586b-5e69-874d-8107-fba98ad365d0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Edge[{1, 2, 3}, \"Cyclic\", \"f\"]", "Input",ExpressionUUID->"0f19d684-0f6a-934b-bea8-e95714d66470"],

Cell[BoxData[
 RowBox[{"Edge", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Vertex", "[", "1", "]"}], ",", 
     RowBox[{"Vertex", "[", "2", "]"}], ",", 
     RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", "\<\"Cyclic\"\>", 
   ",", "\<\"f\"\>"}], "]"}]], "Output",ExpressionUUID->"cd0d0e7a-afaf-1045-\
bd15-a3a26e19ee09"]
}, Open  ]],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "The symmetry types are strings rather than symbols because Cyclic is \
already a protected System` symbol in the Wolfram Language. \"Ordered\" is \
accepted as a synonym for \"Directed\", and the spelling is case-insensitive \
on input, but the stored form is always one of the three canonical strings."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"5f91f82b-e3ae-424f-83d0-070f71dd49ae"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "The stored form always shows the symmetry type explicitly, even when it is \
the default, because the symmetry changes the mathematics of the edge. The \
label is the opposite case \[LongDash] it is dropped when absent, so an \
unlabelled edge stays short to read."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"6e04fc89-e69e-0846-b6cd-c9333db9e813"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Vertices and edges keep their literal form on output; only a whole \
Hypergraph turns into a picture. An edge on its own has no embedding, and its \
identity is exactly the expression you see, so printing it literally is the \
honest thing to do."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"da0a516d-9cb9-ad45-b1c8-72199bef703a"],

Cell[CellGroupData[{

Cell["Canonical vertex order", "Subsection",ExpressionUUID->"f7cf2caa-c0e1-c540-b502-466b9a37e675"],

Cell["\<\
Each edge stores the least member of its symmetry orbit. An unordered edge is \
sorted, a cyclic edge is rotated to its smallest rotation, and a directed \
edge is left alone:\
\>", "Text",ExpressionUUID->"bf4544d3-f8a5-5748-9fb2-bf5620dd2fbc"],

Cell[CellGroupData[{

Cell["\<\
{Edge[{3, 2, 1}, \"Unordered\"], Edge[{3, 1, 2}, \"Cyclic\"], Edge[{3, 2, 1}]}\
\>", "Input",ExpressionUUID->"8bf4a608-1e49-f545-b626-dbc9b34ac3d0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Edge", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Vertex", "[", "1", "]"}], ",", 
       RowBox[{"Vertex", "[", "2", "]"}], ",", 
       RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", "\<\"Unordered\"\>"}],
     "]"}], ",", 
   RowBox[{"Edge", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Vertex", "[", "1", "]"}], ",", 
       RowBox[{"Vertex", "[", "2", "]"}], ",", 
       RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", "\<\"Cyclic\"\>"}], 
    "]"}], ",", 
   RowBox[{"Edge", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Vertex", "[", "3", "]"}], ",", 
       RowBox[{"Vertex", "[", "2", "]"}], ",", 
       RowBox[{"Vertex", "[", "1", "]"}]}], "}"}], ",", "\<\"Directed\"\>"}], 
    "]"}]}], "}"}]], "Output",ExpressionUUID->"fbff4986-6c26-614d-b989-\
53af17caa708"]
}, Open  ]],

Cell["\<\
The consequence is that two Edge objects are identical exactly when they are \
the same hyperedge. A rotation of a cyclic edge is the same edge:\
\>", "Text",ExpressionUUID->"2bee8768-9e7b-4945-9235-8df2f7f50da4"],

Cell[CellGroupData[{

Cell["Edge[{1, 2, 3}, \"Cyclic\"] === Edge[{3, 1, 2}, \"Cyclic\"]", "Input",ExpressionUUID->"17d427e2-5154-1b4e-b600-b6ecfb799685"],

Cell[BoxData["True"], "Output",ExpressionUUID->"b1ea4248-efdb-3c4f-8bf8-de388260ec40"]
}, Open  ]],

Cell["\<\
\[Ellipsis] but a reflection of it is not, since the cyclic group contains \
rotations only:\
\>", "Text",ExpressionUUID->"f81051eb-2918-cd42-a3b6-05f48c05e12f"],

Cell[CellGroupData[{

Cell["Edge[{1, 2, 3}, \"Cyclic\"] === Edge[{1, 3, 2}, \"Cyclic\"]", "Input",ExpressionUUID->"f5166b62-b5ab-5e4e-8b89-2f1828273a2d"],

Cell[BoxData["False"], "Output",ExpressionUUID->"e51c3946-0b44-be41-bcf8-17bc882dff01"]
}, Open  ]],

Cell["\<\
The symmetry type and the label are both part of an edge's identity:\
\>", "Text",ExpressionUUID->"375a17d6-f71c-2944-8692-b2e9d891a5d1"],

Cell[CellGroupData[{

Cell["\<\
{Edge[{1, 2}] === Edge[{1, 2}, \"Unordered\"],
  Edge[{1, 2}, \"Directed\", \"f\"] === Edge[{1, 2}]}\
\>", "Input",ExpressionUUID->"3d568f94-0c43-364f-aab4-a30da18e8af8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "False"}], "}"}]], "Output",ExpressionUUID->"b81ea5a2-\
f3a0-094a-a3af-dd0277fc0795"]
}, Open  ]],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "This is the pivot of the whole design. Once === on edges means \
\[OpenCurlyDoubleQuote]is the same hyperedge\[CloseCurlyDoubleQuote], a \
hypergraph can be compared as a plain multiset of edges, and the symmetry \
types never have to be consulted again during an isomorphism search \
\[LongDash] they have already been absorbed into the representation."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"f6dc051b-201e-af4a-a381-fe050ac4108e"],

Cell["\<\
An unrecognized symmetry type is rejected rather than silently accepted:\
\>", "Text",ExpressionUUID->"f3834e52-2331-9c45-aeef-a73c8b0bbbe7"],

Cell[CellGroupData[{

Cell["Edge[{1, 2}, \"Sideways\"]", "Input",ExpressionUUID->"af806dd4-e2a9-a946-a195-fc29e098c66e"],

Cell[BoxData["$evalFailed"], "Output",ExpressionUUID->"b98902ec-a0f3-e44c-8455-adeed2ae3e6b"]
}, Open  ]],

Cell["\<\
The outputs in this notebook were computed in a plain kernel, so the \
accompanying message appears on the console rather than as a cell. Evaluating \
the cell yourself shows it:

    Edge::sym: Sideways is not a valid edge symmetry type; expected \
\"Directed\", \"Unordered\" or \"Cyclic\".\
\>", "Text",ExpressionUUID->"68bf1044-c766-b844-abc2-df59bd544804"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["3.  Hypergraphs", "Section",ExpressionUUID->"9f36632a-2363-e34a-9d85-049cdbb71951"],

Cell["\<\
A hypergraph can be given as a list of Edge objects, in which case the vertex \
set is the union of the vertices of those edges. It displays as a drawing of \
itself:\
\>", "Text",ExpressionUUID->"17ed7baf-a47c-4249-baa4-2ae0740260e4"],

Cell[CellGroupData[{

Cell["\<\
Hypergraph[{Edge[{1, 2}], Edge[{2, 3}], Edge[{1, 2, 3}, \"Unordered\"]}]\
\>", "Input",ExpressionUUID->"fe9942a2-499f-b248-abad-8e80e22a7713"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["Hypergraphs",
   DynamicModuleBox[{Typeset`hg = HoldComplete[
     WolframInstitute`Hypergraphs`Hypergraph[{
       WolframInstitute`Hypergraphs`Vertex[1], 
       WolframInstitute`Hypergraphs`Vertex[2], 
       WolframInstitute`Hypergraphs`Vertex[3]}, {
       WolframInstitute`Hypergraphs`Edge[{
         WolframInstitute`Hypergraphs`Vertex[1], 
         WolframInstitute`Hypergraphs`Vertex[2]}, "Directed"], 
       WolframInstitute`Hypergraphs`Edge[{
         WolframInstitute`Hypergraphs`Vertex[2], 
         WolframInstitute`Hypergraphs`Vertex[3]}, "Directed"], 
       WolframInstitute`Hypergraphs`Edge[{
         WolframInstitute`Hypergraphs`Vertex[1], 
         WolframInstitute`Hypergraphs`Vertex[2], 
         WolframInstitute`Hypergraphs`Vertex[3]}, "Unordered"]}]]}, 
