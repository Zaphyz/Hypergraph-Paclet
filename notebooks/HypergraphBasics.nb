(* Beginning of Notebook Content *)
Notebook[{
Cell["Hypergraphs: Core Objects and Isomorphism", "Title",ExpressionUUID->"44eb9c7d-f3b5-8348-a1d2-fb17e3172aed"],

Cell["WolframInstitute`Hypergraphs` \[LongDash] first milestone", "Subtitle",ExpressionUUID->"2d6fe3f1-4379-6249-8fca-4d94264643ac"],

Cell["\<\
This notebook shows the three core objects of the rewrite \[LongDash] Vertex, \
Edge and Hypergraph \[LongDash] their default graphical display, and the \
isomorphism test, together with the language design choices behind them. \
Everything below is live output from src/.\
\>", "Text",ExpressionUUID->"6ec79208-7d64-8941-91f4-1262f43cbf12"],

Cell["\<\
A Hypergraph now draws itself, the way a Graph does. Where the exact stored \
expression is the point rather than the picture, the cell is repeated with \
InputForm.\
\>", "Text",ExpressionUUID->"a60816e8-c380-dc48-8f4c-047208aa5e99"],

Cell["\<\
Not implemented yet: rewriting rules, the hypermatrix layer, and the causal \
machinery. Those come next.\
\>", "Text",ExpressionUUID->"f7c221e5-73cb-f84e-b159-e18f1b791762"],

Cell["Loading the package", "Section",ExpressionUUID->"037b02ce-aa75-1047-b032-d408cc442c71"],

Cell["\<\
The cell below is an initialization cell, which the front end evaluates when \
this notebook is opened, so that every symbol is ready by the time you read \
this.\
\>", "Text",ExpressionUUID->"7c4811cf-9f8a-604a-ab21-c80ae24bf73f"],

Cell["\<\
PacletDirectoryLoad[ParentDirectory[NotebookDirectory[]]];
Needs[\"WolframInstitute`Hypergraphs`\"]\
\>", "Input",
 InitializationCell->
  True,ExpressionUUID->"24141c8d-2548-e442-a218-1f07e3697eb1"],

Cell["\<\
The package lives in its own context, deliberately distinct from the \
installed upstream paclet WolframInstitute`Hypergraph` (singular) so that \
both can coexist while we develop. This is a one-line change if you would \
prefer a different name.\
\>", "Text",ExpressionUUID->"c61d0d20-dea8-2d41-afac-ca174f5cf97b"],

Cell["Names[\"WolframInstitute`Hypergraphs`*\"]", "Input",ExpressionUUID->"893047b2-0dfb-384a-bb5e-e797d31a35a8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"AdjacencyHypermatrix\"\>", ",", "\<\"ArrayAdd\"\>", 
   ",", "\<\"ArrayDimensions\"\>", ",", "\<\"ArrayDomain\"\>", 
   ",", "\<\"ArrayEntries\"\>", ",", "\<\"ArrayGraphics\"\>", 
   ",", "\<\"ArrayGraphics3D\"\>", ",", "\<\"ArrayMultiply\"\>", 
   ",", "\<\"ArrayNesting\"\>", ",", "\<\"ArrayObject\"\>", 
   ",", "\<\"ArrayObjectQ\"\>", ",", "\<\"ArrayOrder\"\>", 
   ",", "\<\"ArraySymmetry\"\>", ",", "\<\"ArrayTimes\"\>", 
   ",", "\<\"CanonicalHypergraph\"\>", ",", "\<\"Edge\"\>", 
   ",", "\<\"EdgeLabel\"\>", ",", "\<\"EdgeObjectQ\"\>", 
   ",", "\<\"EdgeSymmetry\"\>", ",", "\<\"EdgeVertices\"\>", 
   ",", "\<\"FindArrayEquations\"\>", 
   ",", "\<\"FindHypergraphIsomorphism\"\>", 
   ",", "\<\"GenerateSymbolicArray\"\>", ",", "\<\"Hypergraph\"\>", 
   ",", "\<\"HypergraphCausalGraph\"\>", ",", "\<\"HypergraphEmbedding\"\>", 
   ",", "\<\"HypergraphEventPlot\"\>", ",", "\<\"HypergraphLargeQ\"\>", 
   ",", "\<\"HypergraphPlot\"\>", ",", "\<\"HypergraphQ\"\>", 
   ",", "\<\"HypergraphRewritingSystem\"\>", 
   ",", "\<\"HypergraphRewritingSystemQ\"\>", ",", "\<\"HypergraphRule\"\>", 
   ",", "\<\"HypergraphRuleApply\"\>", ",", "\<\"HypergraphRuleMatches\"\>", 
   ",", "\<\"HypergraphRulePlot\"\>", ",", "\<\"HypergraphRuleQ\"\>", 
   ",", "\<\"HypergraphSkeleton\"\>", ",", "\<\"Hypermatrix\"\>", 
   ",", "\<\"HypermatrixArrays\"\>", ",", "\<\"HypermatrixGraphics\"\>", 
   ",", "\<\"HypermatrixGraphics3D\"\>", ",", "\<\"HypermatrixQ\"\>", 
   ",", "\<\"IdentityArray\"\>", ",", "\<\"IsomorphicHypergraphQ\"\>", 
   ",", "\<\"OneArray\"\>", ",", "\<\"PartialIdentityArray\"\>", 
   ",", "\<\"RegularArrayQ\"\>", ",", "\<\"SetHypergraphPlotThresholds\"\>", 
   ",", "\<\"SimpleHypergraphQ\"\>", ",", "\<\"Vertex\"\>", 
   ",", "\<\"VertexID\"\>", ",", "\<\"VertexLabel\"\>", 
   ",", "\<\"VertexObjectQ\"\>", ",", "\<\"ZeroArray\"\>", 
   ",", "\<\"$CausalDependenceTypes\"\>", 
   ",", "\<\"$HypergraphRewritingOptions\"\>"}], "}"}]], "Output",ExpressionUU\
ID->"fb4fd581-154d-1545-88e9-71ee7cc763dc"],

Cell["1.  Vertices", "Section",ExpressionUUID->"46d21f9f-01de-b149-aa69-71bda42f35f0"],

Cell["\<\
A vertex is Vertex[id] or Vertex[id, lab]. The identifier id is any Wolfram \
Language expression and is what makes the vertex unique; lab is any \
expression and may be omitted.\
\>", "Text",ExpressionUUID->"4ba4e73e-62f1-4a42-b90c-0ce079b4e79f"],

Cell["Vertex[1]", "Input",ExpressionUUID->"f81645d5-deef-cb4f-a86d-84ba4fc56a5a"],

Cell[BoxData[
 RowBox[{"Vertex", "[", "1", "]"}]], "Output",ExpressionUUID->"2502baeb-794a-f846-ac9c-9bf66c98c46a"],

Cell["Vertex[1, \"a\"]", "Input",ExpressionUUID->"9839550c-62f7-154a-8e65-79f84d760a72"],

Cell[BoxData[
 RowBox[{"Vertex", "[", 
  RowBox[{"1", ",", "\<\"a\"\>"}], "]"}]], "Output",ExpressionUUID->"e8de3339-\
2f58-aa49-9419-324a34c84d94"],

Cell["Vertex[1, None]", "Input",ExpressionUUID->"05f623fd-d7c9-8e43-8235-1c265df340cb"],

Cell[BoxData[
 RowBox[{"Vertex", "[", "1", "]"}]], "Output",ExpressionUUID->"dacbc994-842f-9343-bbcf-bb535fa188f0"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "A label of None means \[OpenCurlyDoubleQuote]no label\
\[CloseCurlyDoubleQuote], so Vertex[id, None] collapses to the one-argument \
form. Keeping a single spelling per vertex means that ordinary structural \
equality (===) on vertices already means \[OpenCurlyDoubleQuote]the same \
vertex\[CloseCurlyDoubleQuote], which the isomorphism code relies on \
throughout."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"bbbdd05b-5d89-be4e-bb54-65cbb2fe6aca"],

Cell["The two parts are read back with VertexID and VertexLabel:", "Text",ExpressionUUID->"7cf7e1ed-bbee-4142-ad02-92a71dc18832"],

Cell["\<\
{VertexID[Vertex[x, \"a\"]], VertexLabel[Vertex[x, \"a\"]], \
VertexLabel[Vertex[1]]}\
\>", "Input",ExpressionUUID->"f7442196-fe62-5a47-bfc5-deef16df972b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"x", ",", "\<\"a\"\>", ",", "None"}], "}"}]], "Output",ExpressionUUI\
D->"c0afd3ee-dd5a-fe44-8355-6081fdc94264"],

Cell["\<\
Identifiers really are arbitrary expressions \[LongDash] integers, strings, \
symbols, lists, anything:\
\>", "Text",ExpressionUUID->"7f0bc024-8298-1d4e-9cd0-42b10b3fd442"],

Cell["\<\
{Vertex[1], Vertex[\"a\"], Vertex[{1, 2}], Vertex[u], Vertex[f[3]]}\
\>", "Input",ExpressionUUID->"02cbe848-4905-9f44-8753-be41b4090cff"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Vertex", "[", "1", "]"}], ",", 
   RowBox[{"Vertex", "[", "\<\"a\"\>", "]"}], ",", 
   RowBox[{"Vertex", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}], "]"}], ",", 
   RowBox[{"Vertex", "[", "u", "]"}], ",", 
   RowBox[{"Vertex", "[", 
    RowBox[{"f", "[", "3", "]"}], "]"}]}], "}"}]], "Output",ExpressionUUID->\
"40985564-b759-3e43-a163-57541cd3abf0"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Wherever a vertex is expected you may write the bare identifier instead, \
and it is promoted to a Vertex automatically. That is what keeps the second \
Hypergraph constructor, which takes plain lists of identifiers, as light as \
you specified it."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"ca2b4826-23c7-1945-bcd6-0c23cd920bd2"],

Cell["2.  Edges", "Section",ExpressionUUID->"3f6ddd21-a4b1-fe49-93d4-461a1feb202f"],

Cell["\<\
A hyperedge is Edge[{v1, v2, \[Ellipsis]}, sym, lab]. The symmetry type sym \
is one of \"Directed\" (the default), \"Unordered\" or \"Cyclic\", and lab \
may be omitted.\
\>", "Text",ExpressionUUID->"ff6fb141-7753-4043-9a22-7a396d4ff9cb"],

Cell["Edge[{1, 2, 3}]", "Input",ExpressionUUID->"74dfa55d-a394-4d41-b94d-70fb81e0b896"],

Cell[BoxData[
 RowBox[{"Edge", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Vertex", "[", "1", "]"}], ",", 
     RowBox[{"Vertex", "[", "2", "]"}], ",", 
     RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", "\<\"Directed\"\>"}], 
  "]"}]], "Output",ExpressionUUID->"e45c2738-4982-9841-9c73-c9dc41ce1609"],

Cell["Edge[{1, 2, 3}, \"Unordered\"]", "Input",ExpressionUUID->"12a74f05-2a02-6c42-b124-7a757ffd2bd7"],

Cell[BoxData[
 RowBox[{"Edge", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Vertex", "[", "1", "]"}], ",", 
     RowBox[{"Vertex", "[", "2", "]"}], ",", 
     RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", "\<\"Unordered\"\>"}], 
  "]"}]], "Output",ExpressionUUID->"8341e07b-5639-7b41-b14c-5928b2e69267"],

Cell["Edge[{1, 2, 3}, \"Cyclic\", \"f\"]", "Input",ExpressionUUID->"28bf1b1d-5268-2e40-af7a-cc0c813be48a"],

Cell[BoxData[
 RowBox[{"Edge", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Vertex", "[", "1", "]"}], ",", 
     RowBox[{"Vertex", "[", "2", "]"}], ",", 
     RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", "\<\"Cyclic\"\>", 
   ",", "\<\"f\"\>"}], "]"}]], "Output",ExpressionUUID->"b0f43ee0-9147-514a-\
8f1a-a4507938e80a"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "The symmetry types are strings rather than symbols because Cyclic is \
already a protected System` symbol in the Wolfram Language. \"Ordered\" is \
accepted as a synonym for \"Directed\", and the spelling is case-insensitive \
on input, but the stored form is always one of the three canonical strings."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"7a77e019-a0d9-0946-a0d2-70d0bdd537b6"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "The stored form always shows the symmetry type explicitly, even when it is \
the default, because the symmetry changes the mathematics of the edge. The \
label is the opposite case \[LongDash] it is dropped when absent, so an \
unlabelled edge stays short to read."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"a32b6ec3-3cb4-e44e-85a7-98e20b0efb9a"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Vertices and edges keep their literal form on output; only a whole \
Hypergraph turns into a picture. An edge on its own has no embedding, and its \
identity is exactly the expression you see, so printing it literally is the \
honest thing to do."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"8be2f5cb-8554-b04f-8c64-c0ab0b6cfebf"],

Cell["Canonical vertex order", "Subsection",ExpressionUUID->"e432d76f-6cc2-1047-aaef-510004914b8f"],

Cell["\<\
Each edge stores the least member of its symmetry orbit. An unordered edge is \
sorted, a cyclic edge is rotated to its smallest rotation, and a directed \
edge is left alone:\
\>", "Text",ExpressionUUID->"4a0b1b87-a4fd-eb43-8a64-4a0559b9811e"],

Cell["\<\
{Edge[{3, 2, 1}, \"Unordered\"], Edge[{3, 1, 2}, \"Cyclic\"], Edge[{3, 2, 1}]}\
\>", "Input",ExpressionUUID->"b948c714-d767-d84a-b7e1-9a678f638495"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Edge", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Vertex", "[", "1", "]"}], ",", 
       RowBox[{"Vertex", "[", "2", "]"}], ",", 
       RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", "\<\"Unordered\"\>"}],
     "]"}], ",", 
   RowBox[{"Edge", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Vertex", "[", "1", "]"}], ",", 
       RowBox[{"Vertex", "[", "2", "]"}], ",", 
       RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", "\<\"Cyclic\"\>"}], 
    "]"}], ",", 
   RowBox[{"Edge", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Vertex", "[", "3", "]"}], ",", 
       RowBox[{"Vertex", "[", "2", "]"}], ",", 
       RowBox[{"Vertex", "[", "1", "]"}]}], "}"}], ",", "\<\"Directed\"\>"}], 
    "]"}]}], "}"}]], "Output",ExpressionUUID->"6849a2ed-5da3-a146-a32d-\
2555a9cb59e5"],

Cell["\<\
The consequence is that two Edge objects are identical exactly when they are \
the same hyperedge. A rotation of a cyclic edge is the same edge:\
\>", "Text",ExpressionUUID->"57a6dae7-4d2f-b549-b6cd-b0edb1bd373a"],

Cell["Edge[{1, 2, 3}, \"Cyclic\"] === Edge[{3, 1, 2}, \"Cyclic\"]", "Input",ExpressionUUID->"2e47185b-3ded-a04c-b5f0-6e9e3e4e927c"],

Cell[BoxData["True"], "Output",ExpressionUUID->"ae089f29-06c6-3b4e-af37-091db8d2eabd"],

Cell["\<\
\[Ellipsis] but a reflection of it is not, since the cyclic group contains \
rotations only:\
\>", "Text",ExpressionUUID->"df998fbd-015d-854e-87ab-f3240e64d323"],

Cell["Edge[{1, 2, 3}, \"Cyclic\"] === Edge[{1, 3, 2}, \"Cyclic\"]", "Input",ExpressionUUID->"0fcda028-d4d5-f54c-b716-d2b03261b5b9"],

Cell[BoxData["False"], "Output",ExpressionUUID->"8ac8d025-db78-a143-a0f3-7ab4735bf5eb"],

Cell["\<\
The symmetry type and the label are both part of an edge's identity:\
\>", "Text",ExpressionUUID->"532dc1fd-0495-ad49-805d-37e32ea8e06f"],

Cell["\<\
{Edge[{1, 2}] === Edge[{1, 2}, \"Unordered\"],
  Edge[{1, 2}, \"Directed\", \"f\"] === Edge[{1, 2}]}\
\>", "Input",ExpressionUUID->"11232548-a19e-0e41-984c-f15371beb8ef"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "False"}], "}"}]], "Output",ExpressionUUID->"9502011b-\
2b8d-c149-a953-6413829aedfa"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "This is the pivot of the whole design. Once === on edges means \
\[OpenCurlyDoubleQuote]is the same hyperedge\[CloseCurlyDoubleQuote], a \
hypergraph can be compared as a plain multiset of edges, and the symmetry \
types never have to be consulted again during an isomorphism search \
\[LongDash] they have already been absorbed into the representation."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"b690d4c4-2bb9-0842-9bd3-357fdb32700a"],

Cell["\<\
An unrecognized symmetry type is rejected rather than silently accepted:\
\>", "Text",ExpressionUUID->"454ec461-016f-984a-af7e-916c0fa014b6"],

Cell["Edge[{1, 2}, \"Sideways\"]", "Input",ExpressionUUID->"c5c7d3fd-ebb3-e74d-a565-ed7005e09963"],

Cell[BoxData["$evalFailed"], "Output",ExpressionUUID->"a8a83ce4-fa50-db44-8712-a957059b962a"],

Cell["\<\
The outputs in this notebook were computed in a plain kernel, so the \
accompanying message appears on the console rather than as a cell. Evaluating \
the cell yourself shows it:

    Edge::sym: Sideways is not a valid edge symmetry type; expected \
\"Directed\", \"Unordered\" or \"Cyclic\".\
\>", "Text",ExpressionUUID->"ae0c02a5-5840-5443-8cb8-13970d32497e"],

Cell["3.  Hypergraphs", "Section",ExpressionUUID->"a51a7eb2-eb70-834c-8b7f-c1252580cc3f"],

Cell["\<\
A hypergraph can be given as a list of Edge objects, in which case the vertex \
set is the union of the vertices of those edges. It displays as a drawing of \
itself:\
\>", "Text",ExpressionUUID->"a1b9460b-66aa-ff4a-859d-2d22d914b0e9"],

Cell["\<\
Hypergraph[{Edge[{1, 2}], Edge[{2, 3}], Edge[{1, 2, 3}, \"Unordered\"]}]\
\>", "Input",ExpressionUUID->"51697d23-6c98-df41-b552-30535aab77a8"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["Hypergraphs",
   DynamicModuleBox[{Typeset`hg = HoldComplete[
     WolframInstitute`Hypergraphs`Hypergraph[{
       WolframInstitute`Hypergraphs`Vertex[1], 
       WolframInstitute`Hypergraphs`Vertex[2], 
       WolframInstitute`Hypergraphs`Vertex[3]}, {
       WolframInstitute`Hypergraphs`Edge[{
         WolframInstitute`Hypergraphs`Vertex[1], 
         WolframInstitute`Hypergraphs`Vertex[2]}, "Directed"], 
       WolframInstitute`Hypergraphs`Edge[{
         WolframInstitute`Hypergraphs`Vertex[2], 
         WolframInstitute`Hypergraphs`Vertex[3]}, "Directed"], 
       WolframInstitute`Hypergraphs`Edge[{
         WolframInstitute`Hypergraphs`Vertex[1], 
         WolframInstitute`Hypergraphs`Vertex[2], 
         WolframInstitute`Hypergraphs`Vertex[3]}, "Unordered"]}]]}, 
    {AbsoluteThickness[Medium], Opacity[0.5], Arrowheads[{{Medium, 0.5}}], {
      {Opacity[1], Arrowheads[{{Small, 0.5}}], 
       {Hue[0.63, 0.7, 0.5], Opacity[
        0.7], {ArrowBox[
          BSplineCurveBox[{{0.8768424375680299, 0.8659683851517446}, {
           0.8658339352737859, 0.}}]], {}}, 
        {Opacity[1]}}}, 
      {Opacity[1], Arrowheads[{{Small, 0.5}}], 
       {Hue[0.63, 0.7, 0.5], Opacity[
        0.7], {ArrowBox[
          BSplineCurveBox[{{0.8658339352737859, 0.}, {0.010498775754916756`, 
           0.8773698149728941}}]], {}}, 
        {Opacity[1]}}}, 
      {Hue[0.63, 0.66, 0.81], Opacity[0.1], 
       FilledCurveBox[{
        BSplineCurve[{{0.8658339352737859, 0.}, {0.7278649513099094, 
          0.507048462975376}, {0.8768424375680299, 0.8659683851517446}}], 
         BSplineCurve[{{0.8768424375680299, 0.8659683851517446}, {
          0.5140311614301921, 0.7263909167185995}, {0.010498775754916756`, 
          0.8773698149728941}}], 
         BSplineCurve[{{0.010498775754916756`, 0.8773698149728941}, {
          0.511279035856631, 0.5098988204306634}, {0.8658339352737859, 
          0.}}]}], 
       {Opacity[1]}}}, 
     {Opacity[1], {
       {Hue[0.63, 0.26, 0.89], EdgeForm[{Hue[0.63, 0.7, 0.33], Opacity[
        0.95]}], 
        DiskBox[{0.8768424375680299, 0.8659683851517446}, 
         Offset[{2., 2.}, {0., 0.}]]}, 
       {Hue[0.63, 0.26, 0.89], EdgeForm[{Hue[0.63, 0.7, 0.33], Opacity[
        0.95]}], 
        DiskBox[{0.8658339352737859, 0.}, Offset[{2., 2.}, {0., 0.}]]}, 
       {Hue[0.63, 0.26, 0.89], EdgeForm[{Hue[0.63, 0.7, 0.33], Opacity[
        0.95]}], 
        DiskBox[{0.010498775754916756`, 0.8773698149728941}, 
         Offset[{2., 2.}, {0., 0.}]]}}, {InsetBox[
        StyleBox["1",
         StripOnInput->False,
         LineColor->GrayLevel[0],
         FrontFaceColor->GrayLevel[0],
         BackFaceColor->GrayLevel[0],
         GraphicsColor->GrayLevel[0],
         FontColor->GrayLevel[0]], {0.8768424375680299, 0.8659683851517446}, 
        ImageScaled[{0.4998626608174635, -0.4999999905689744}]], InsetBox[
        StyleBox["2",
         StripOnInput->False,
         LineColor->GrayLevel[0],
         FrontFaceColor->GrayLevel[0],
         BackFaceColor->GrayLevel[0],
         GraphicsColor->GrayLevel[0],
         FontColor->GrayLevel[0]], {0.8658339352737859, 0.}, 
        ImageScaled[{0.28495136527721365, 1.4766033405143901}]], InsetBox[
        StyleBox["3",
         StripOnInput->False,
         LineColor->GrayLevel[0],
         FrontFaceColor->GrayLevel[0],
         BackFaceColor->GrayLevel[0],
         GraphicsColor->GrayLevel[0],
         FontColor->GrayLevel[0]], {0.010498775754916756, 0.8773698149728941},
         ImageScaled[{1.1890534411663594, -0.2247105320173004}]]}}}]],
  Background->GrayLevel[1],
  ImagePadding->19,
