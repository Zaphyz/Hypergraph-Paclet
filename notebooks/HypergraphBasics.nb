Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Directed and unordered are drawn exactly as the reference draws ordered and \
unordered edges. Cyclic is the one departure. The reference puts arrowheads \
on a cyclic edge too, which leaves it differing from a directed edge only by \
whether the last side happens to close the loop \[LongDash] easy to miss on a \
small picture, and on an edge of arity two there is no closing side to look \
at at all. Dropping the arrowheads and marking a cyclic edge with the badge \
alone makes the three types tell themselves apart at a glance."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"f9c9b8e6-a505-2c4a-ad6b-7993b60ff6a7"],

Cell["\<\
On an edge of arity two the badge is the whole of the distinction, since \
there is nothing else to tell a cyclic edge from the other two:\
\>", "Text",ExpressionUUID->"ca4406aa-82b6-2b44-be21-8b131dce8ef6"],

Cell["\<\
Grid[{
   {\"Directed\", \"Unordered\", \"Cyclic\"},
   HypergraphPlot[Hypergraph[{Edge[{1, 2}, #]}], ImageSize -> 170] & /@
     {\"Directed\", \"Unordered\", \"Cyclic\"}
  }, Frame -> All, Alignment -> Center]\
\>", "Input",ExpressionUUID->"cdddd23b-5370-6042-8b20-9994e515e64a"],

