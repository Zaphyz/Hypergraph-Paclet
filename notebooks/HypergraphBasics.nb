Cell["\<\
a and b are the same directed path on different identifiers, so they are \
isomorphic. c is an out-star, which as a directed hypergraph is a different \
object:\
\>", "Text",ExpressionUUID->"b0932ef6-9cce-d940-8894-923207feee35"],

Cell["{IsomorphicHypergraphQ[a, b], IsomorphicHypergraphQ[a, c]}", "Input",ExpressionUUID->"13eee25b-31dc-624f-907c-c46826b108c5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",ExpressionUUID->"3ddba9c7-\
d3b3-614c-8281-215f45435f32"],

Cell["\<\
The witnessing renaming is available too, and is an empty association when \
there is none:\
\>", "Text",ExpressionUUID->"3d08ca95-a935-ac47-8b65-3c2fb875af1d"],

Cell["\<\
{FindHypergraphIsomorphism[a, b], FindHypergraphIsomorphism[a, c]}\
\>", "Input",ExpressionUUID->"d9bec269-7852-6c4a-bdd3-4c7f5f24c9ff"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"1", "\[Rule]", "10"}], ",", 
     RowBox[{"2", "\[Rule]", "20"}], ",", 
     RowBox[{"3", "\[Rule]", "30"}]}], "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], "}"}]], "Output",E\
xpressionUUID->"111a9287-c5fc-1b4f-b457-65db87893154"],

Cell["Symmetry types are respected", "Subsection",ExpressionUUID->"4d5883e8-5893-864d-bee7-91014931cfb8"],

Cell["\<\
The same two hypergraphs, with both edges made unordered, become isomorphic \
\[LongDash] an undirected path on three vertices is an undirected star:\
\>", "Text",ExpressionUUID->"1acddccd-7348-c841-940f-8ebb0828c5dc"],

Cell["\<\
au = Hypergraph[{Edge[{1, 2}, \"Unordered\"], Edge[{2, 3}, \"Unordered\"]}];
cu = Hypergraph[{Edge[{1, 2}, \"Unordered\"], Edge[{1, 3}, \"Unordered\"]}];
{au, cu, IsomorphicHypergraphQ[au, cu]}\
\>", "Input",ExpressionUUID->"ea59a3a8-5b24-e841-aea6-14e7d1346002"],

