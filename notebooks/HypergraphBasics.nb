Cell["5.  Accessors and properties", "Section",ExpressionUUID->"d6f0e9be-a0e6-1744-9269-8a201fa9c17f"],

Cell["\<\
h = Hypergraph[{Vertex[1, \"a\"], Vertex[2, \"b\"], 3}, {{1, 2}, {2, 3}}];\
\>", "Input",ExpressionUUID->"a3af2593-b032-2f46-97e5-db1a65ea80ce"],

Cell["{VertexList[h], EdgeList[h], VertexCount[h], EdgeCount[h]}", "Input",ExpressionUUID->"4a28bc48-3d07-9e46-aa29-e666489e77a5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Vertex", "[", "3", "]"}], ",", 
     RowBox[{"Vertex", "[", 
      RowBox[{"1", ",", "\<\"a\"\>"}], "]"}], ",", 
     RowBox[{"Vertex", "[", 
      RowBox[{"2", ",", "\<\"b\"\>"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Edge", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Vertex", "[", 
          RowBox[{"1", ",", "\<\"a\"\>"}], "]"}], ",", 
         RowBox[{"Vertex", "[", 
          RowBox[{"2", ",", "\<\"b\"\>"}], "]"}]}], "}"}], 
       ",", "\<\"Directed\"\>"}], "]"}], ",", 
     RowBox[{"Edge", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Vertex", "[", 
          RowBox[{"2", ",", "\<\"b\"\>"}], "]"}], ",", 
         RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], 
       ",", "\<\"Directed\"\>"}], "]"}]}], "}"}], ",", "3", ",", "2"}], 
  "}"}]], "Output",ExpressionUUID->"b0b3aaec-a963-2d45-a0d6-5ce2301351ad"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "VertexList, EdgeList, VertexCount and EdgeCount are protected System` \
symbols. They are extended with UpValues on Hypergraph rather than redefined, \
so the ordinary graph meanings are untouched and no shadowing warning is ever \
produced."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"cffe1faa-7baa-5944-be76-05c5b8134e8c"],

Cell["\<\
Everything else is reached through a string property, in the style of the \
upstream paclet:\
\>", "Text",ExpressionUUID->"9eeca9ef-cc1a-f04e-bb68-b94259abcd7c"],

Cell["h[\"Properties\"]", "Input",ExpressionUUID->"763622c8-fa31-bc4b-8aca-12efd1c03b12"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"VertexList\"\>", ",", "\<\"EdgeList\"\>", 
   ",", "\<\"VertexCount\"\>", ",", "\<\"EdgeCount\"\>", 
   ",", "\<\"VertexIDs\"\>", ",", "\<\"VertexLabels\"\>", 
   ",", "\<\"EdgeLabels\"\>", ",", "\<\"EdgeSymmetries\"\>", 
   ",", "\<\"Arity\"\>", ",", "\<\"Skeleton\"\>"}], "}"}]], "Output",Expressio\
nUUID->"79274065-1be6-0447-9e01-36a7f7882fad"],

Cell["\<\
{h[\"VertexIDs\"], h[\"VertexLabels\"], h[\"Arity\"], h[\"EdgeSymmetries\"]}\
\>", "Input",ExpressionUUID->"f752b05a-4507-ae4c-8ed8-df95c908e51d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"3", ",", "1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"None", ",", "\<\"a\"\>", ",", "\<\"b\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"Directed\"\>", ",", "\<\"Directed\"\>"}], "}"}]}], 
  "}"}]], "Output",ExpressionUUID->"b12d5ede-546f-254f-9e2f-7115be643179"],

Cell["There are predicates for each of the three object types:", "Text",ExpressionUUID->"05c490cf-0466-5745-b939-eb77bff10ba9"],

Cell["\<\
{VertexObjectQ[Vertex[1]], EdgeObjectQ[Edge[{1, 2}]], HypergraphQ[h], \
HypergraphQ[17]}\
\>", "Input",ExpressionUUID->"3c997071-f5df-6144-8c21-63126301a4a7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True", ",", "False"}], "}"}]], "Output",E\
xpressionUUID->"c2454b43-cfa6-5e4e-9c57-60100a686b0a"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "The natural names VertexQ and EdgeQ are protected System` symbols \
\[LongDash] they are the graph membership tests VertexQ[g, v] and EdgeQ[g, e] \
\[LongDash] so the predicates here are VertexObjectQ and EdgeObjectQ. Taking \
the System` names instead would have reproduced exactly the shadowing problem \
that SetReplace and the upstream Hypergraph paclet already suffer from, where \
four symbols collide and every load prints a warning."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"ae6b9882-5ba1-d54e-84c4-5b779b407f94"],

Cell["6.  Isomorphism", "Section",ExpressionUUID->"f82caa3c-07a7-1843-8939-02b69f4cc839"],

Cell["\<\
Two hypergraphs are isomorphic when some renaming of vertex identifiers \
carries one onto the other: the edge multisets must match exactly, each edge \
matching up to its own symmetry type, with edge multiplicities preserved.\
\>", "Text",ExpressionUUID->"d5e05293-600e-e04f-9284-727388005f80"],

Cell["\<\
For labelled isomorphism the renaming must also carry the labels of the first \
onto the labels of the second, by a one-to-one correspondence. Labels are \
therefore significant only up to renaming: what has to agree is which \
elements share a label, not what the labels are called. Vertex labels and \
edge labels are put in correspondence independently of one another, and an \
element with no label can only correspond to an element with no label.\
\>", "Text",ExpressionUUID->"226867e5-e17a-334b-aa94-b8c6a0ca9f92"],

Cell["\<\
a = Hypergraph[{{1, 2}, {2, 3}}];
b = Hypergraph[{{10, 20}, {20, 30}}];
c = Hypergraph[{{1, 2}, {1, 3}}];
{a, b, c}\
\>", "Input",ExpressionUUID->"f98dbc9a-9c7b-f24c-8bd6-c52aaff69cca"],

