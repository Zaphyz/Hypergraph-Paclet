Cell["\<\
The placeholders are what let h1 and h2 above, whose edge labels are named \
differently, reduce to the same canonical form:\
\>", "Text",ExpressionUUID->"9b00dfc5-27f2-d74e-9e82-6b4ea26d2a2d"],

Cell["\<\
{CanonicalHypergraph[h1], CanonicalHypergraph[h2],
  CanonicalHypergraph[h1] === CanonicalHypergraph[h2]}\
\>", "Input",ExpressionUUID->"49fa87e9-136d-844a-97de-b6392d983413"],

