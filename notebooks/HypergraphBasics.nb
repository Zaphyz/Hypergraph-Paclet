  PlotRangePadding->Scaled[0.02]]], "Output",ExpressionUUID->"1baa946c-bcbd-\
2949-a36b-19daf0a0c9de"],

Cell["\<\
The picture is the same object; InputForm shows what is actually stored:\
\>", "Text",ExpressionUUID->"d2ecf868-d8be-cc42-8b96-078926eb87dd"],

Cell["\<\
InputForm @ Hypergraph[{Edge[{1, 2}], Edge[{2, 3}], Edge[{1, 2, 3}, \
\"Unordered\"]}]\
\>", "Input",ExpressionUUID->"065c1c44-c545-b643-995d-08014fb93f9f"],

Cell[BoxData[
 InterpretationBox[
  StyleBox[
   RowBox[{"Hypergraph", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Vertex", "[", "1", "]"}], ",", " ", 
       RowBox[{"Vertex", "[", "2", "]"}], ",", " ", 
       RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Edge", "[", 
        RowBox[{
         RowBox[{"{", 
