Cell["\<\
a and b are the same directed path on different identifiers, so they are \
isomorphic. c is an out-star, which as a directed hypergraph is a different \
object:\
\>", "Text",ExpressionUUID->"47f8eab7-1ada-e34d-91e5-d52f273703cd"],

Cell["{IsomorphicHypergraphQ[a, b], IsomorphicHypergraphQ[a, c]}", "Input",ExpressionUUID->"7ae6d224-8338-a042-adad-e2fccac33ca0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",ExpressionUUID->"7d61a112-\
8238-014d-a2e9-afb212e41eaf"],

Cell["\<\
The witnessing renaming is available too, and is an empty association when \
there is none:\
\>", "Text",ExpressionUUID->"66c8d1a2-849d-db46-a715-ee19847f5b15"],

Cell["\<\
{FindHypergraphIsomorphism[a, b], FindHypergraphIsomorphism[a, c]}\
\>", "Input",ExpressionUUID->"d9dc75a9-0d3b-4448-9b5e-7e929e16ce46"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"1", "\[Rule]", "10"}], ",", 
     RowBox[{"2", "\[Rule]", "20"}], ",", 
     RowBox[{"3", "\[Rule]", "30"}]}], "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], "}"}]], "Output",E\
xpressionUUID->"d87ae230-0645-0645-9d66-86dc71bade88"],

Cell["Symmetry types are respected", "Subsection",ExpressionUUID->"527d7138-da2f-0244-96eb-f8cef929c912"],

Cell["\<\
The same two hypergraphs, with both edges made unordered, become isomorphic \
\[LongDash] an undirected path on three vertices is an undirected star:\
\>", "Text",ExpressionUUID->"7f764ab2-679e-884d-8d6b-3d990f4e5c1b"],

Cell["\<\
au = Hypergraph[{Edge[{1, 2}, \"Unordered\"], Edge[{2, 3}, \"Unordered\"]}];
cu = Hypergraph[{Edge[{1, 2}, \"Unordered\"], Edge[{1, 3}, \"Unordered\"]}];
{au, cu, IsomorphicHypergraphQ[au, cu]}\
\>", "Input",ExpressionUUID->"1b40f5cc-e54e-e24c-82b0-e4cbbe645c24"],

