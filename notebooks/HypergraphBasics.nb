Cell["\<\
Every vertex label and every edge label is gone, while the symmetry types \
survive:\
\>", "Text",ExpressionUUID->"b03b7621-e721-2a47-b380-2549b3237dd5"],

Cell["\<\
hs = HypergraphSkeleton[Hypergraph[{Edge[{Vertex[1, \"A\"], 2}, \
\"Unordered\", \"f\"]}]];
{hs[\"VertexLabels\"], hs[\"EdgeLabels\"], hs[\"EdgeSymmetries\"]}\
\>", "Input",ExpressionUUID->"e6a6ccbc-e43f-4747-954b-f22563f33da5"],

