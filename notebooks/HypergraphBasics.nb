Cell["\<\
When a cyclic edge is labelled, the circular arrow is drawn wider so that it \
encircles the label rather than colliding with it:\
\>", "Text",ExpressionUUID->"dd1464bf-0ffb-6a40-b9ae-5262325fd489"],

Cell["\<\
Hypergraph[{Edge[{1, 2}, \"Directed\", \"f\"], Edge[{2, 3}, \"Cyclic\", \"g\"],
             Edge[{1, 3, 4}, \"Unordered\", \"h\"]}]\
\>", "Input",ExpressionUUID->"3f6e3f40-941a-ca45-9f0a-728c66531cb6"],

