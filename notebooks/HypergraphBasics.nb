Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"1", "\[Rule]", "1"}], ",", 
     RowBox[{"2", "\[Rule]", "2"}], ",", 
     RowBox[{"3", "\[Rule]", "3"}]}], "\[RightAssociation]"}]}], 
  "}"}]], "Output",ExpressionUUID->"97e0b28b-0bf6-7740-a58a-b657050d71cd"],

Cell["\<\
An edge carrying a label is not the same as an edge carrying none, and the \
same label on edges of different symmetry type does not match either:\
\>", "Text",ExpressionUUID->"ad12990f-2c9e-284f-be9c-ee5071f479ec"],

Cell["\<\
{IsomorphicHypergraphQ[Hypergraph[{Edge[{1, 2}, \"Directed\", \"f\"]}],
                        Hypergraph[{Edge[{1, 2}]}]],
  IsomorphicHypergraphQ[Hypergraph[{Edge[{1, 2, 3}, \"Cyclic\", \"f\"]}],
                        Hypergraph[{Edge[{1, 2, 3}, \"Directed\", \"f\"]}]]}\
\>", "Input",ExpressionUUID->"e0c6411d-8a76-6e41-a234-998d702791da"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "False"}], "}"}]], "Output",ExpressionUUID->"69b7dcdd-\
b8b7-f54f-b027-f0ce243ff0b6"],

Cell["\<\
Since a hypergraph is a multiset, how many times each label occurs matters \
too. Two copies of f is not the same as one f and one g, though the skeletons \
cannot tell them apart:\
\>", "Text",ExpressionUUID->"65f52385-3c27-1142-82c4-3fad731884a7"],

Cell["\<\
n1 = Hypergraph[{Edge[{1, 2}, \"Directed\", \"f\"], Edge[{1, 2}, \
\"Directed\", \"f\"]}];
n2 = Hypergraph[{Edge[{1, 2}, \"Directed\", \"f\"], Edge[{1, 2}, \
\"Directed\", \"g\"]}];
{IsomorphicHypergraphQ[n1, n2], IsomorphicHypergraphQ[n1, n2, \"Labeled\" -> \
False]}\
\>", "Input",ExpressionUUID->"33d6b119-c1b2-6a49-b299-5f204f33e89e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "True"}], "}"}]], "Output",ExpressionUUID->"e715114d-\
1720-c848-93af-32ee2db16588"],

Cell["\<\
Vertex labels and edge labels are checked together, but corresponded \
separately. Below b1 and b2 agree on both. So does b3, which has b1's two \
edge labels exchanged \[LongDash] absorbed by the edge-label correspondence. \
b4 is the one that fails: it puts a single label on both edges where b1 has \
two distinct ones, and no one-to-one correspondence can do that:\
\>", "Text",ExpressionUUID->"791fe29f-cb8f-0d47-8d55-92ad11198753"],

Cell["\<\
b1 = Hypergraph[{Edge[{Vertex[1, \"A\"], Vertex[2, \"B\"]}, \"Directed\", \"f\
\"],
                 Edge[{Vertex[2, \"B\"], Vertex[3, \"C\"]}, \"Cyclic\", \
\"g\"]}];
b2 = Hypergraph[{Edge[{Vertex[5, \"A\"], Vertex[6, \"B\"]}, \"Directed\", \"f\
\"],
                 Edge[{Vertex[6, \"B\"], Vertex[7, \"C\"]}, \"Cyclic\", \
\"g\"]}];
b3 = Hypergraph[{Edge[{Vertex[5, \"A\"], Vertex[6, \"B\"]}, \"Directed\", \"g\
\"],
                 Edge[{Vertex[6, \"B\"], Vertex[7, \"C\"]}, \"Cyclic\", \
\"f\"]}];
b4 = Hypergraph[{Edge[{Vertex[5, \"A\"], Vertex[6, \"B\"]}, \"Directed\", \"f\
\"],
                 Edge[{Vertex[6, \"B\"], Vertex[7, \"C\"]}, \"Cyclic\", \
\"f\"]}];
{b1, b2, b3, b4}\
\>", "Input",ExpressionUUID->"ad965723-2dfe-8440-8268-0271182469b0"],

