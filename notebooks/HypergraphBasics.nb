           RowBox[{"2", ",", " ", "\"\<Q\>\""}], "]"}]}], "}"}], ",", 
        " ", "\"\<Directed\>\"", ",", " ", "\"\<f\>\""}], "]"}], ",", "\n", 
      "                 ", 
      RowBox[{"Edge", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Vertex", "[", 
           RowBox[{"2", ",", " ", "\"\<Q\>\""}], "]"}], ",", " ", 
          RowBox[{"Vertex", "[", 
           RowBox[{"3", ",", " ", "\"\<Q\>\""}], "]"}]}], "}"}], ",", 
        " ", "\"\<Directed\>\"", ",", " ", "\"\<g\>\""}], "]"}]}], "}"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{"i1", ",", "i3"}], "}"}]}], "Input",
