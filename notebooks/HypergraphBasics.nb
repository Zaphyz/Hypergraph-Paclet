Cell["\<\
A directed edge is never the same as an unordered one, so a and au are not \
isomorphic:\
\>", "Text",ExpressionUUID->"2bb71464-642d-8e4d-8149-b65c3b8f5cd0"],

Cell[CellGroupData[{

Cell["IsomorphicHypergraphQ[a, au]", "Input",ExpressionUUID->"790c0ba1-f3a9-7c4c-8645-6ec6ff59640e"],

Cell[BoxData["False"], "Output",ExpressionUUID->"0a23c5c5-756e-294b-b4f6-d110f82fdd5e"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Labels count only up to renaming", "Subsection",ExpressionUUID->"febc2d6a-fae6-6c42-8632-cd65ff999c7e"],

Cell["\<\
The two hypergraphs below are the same directed path, one carrying edge \
labels a and b, the other x and y. They are isomorphic: on top of the vertex \
renaming sits the label correspondence a \[Rule] x, b \[Rule] y.\
\>", "Text",ExpressionUUID->"ece2f8e9-c70b-ca4b-8070-cc92e7a09e14"],

Cell[CellGroupData[{

Cell["\<\
h1 = Hypergraph[{Edge[{1, 2}, \"Directed\", \"a\"], Edge[{2, 3}, \
\"Directed\", \"b\"]}];
h2 = Hypergraph[{Edge[{4, 5}, \"Directed\", \"x\"], Edge[{5, 6}, \
\"Directed\", \"y\"]}];
{h1, h2}\
\>", "Input",ExpressionUUID->"5c54efbd-deed-904b-97b8-a003370c8373"],

