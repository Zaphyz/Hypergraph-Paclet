     RowBox[{"{", 
      RowBox[{
       RowBox[{"Vertex", "[", "2", "]"}], ",", " ", 
       RowBox[{"Vertex", "[", "3", "]"}], ",", " ", 
       RowBox[{"Vertex", "[", 
        RowBox[{"1", ",", " ", "\"\<a\>\""}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Edge", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Vertex", "[", 
            RowBox[{"1", ",", " ", "\"\<a\>\""}], "]"}], ",", " ", 
           RowBox[{"Vertex", "[", "2", "]"}]}], "}"}], ",", 
         " ", "\"\<Directed\>\""}], "]"}], ",", " ", 
       RowBox[{"Edge", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Vertex", "[", 
            RowBox[{"1", ",", " ", "\"\<a\>\""}], "]"}], ",", " ", 
           RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", 
         " ", "\"\<Directed\>\""}], "]"}]}], "}"}]}], "]"}],
   ShowStringCharacters->True,
   NumberMarks->True],
  InputForm[
   WolframInstitute`Hypergraphs`Hypergraph[{
     WolframInstitute`Hypergraphs`Vertex[2], 
     WolframInstitute`Hypergraphs`Vertex[3], 
     WolframInstitute`Hypergraphs`Vertex[1, "a"]}, {
     WolframInstitute`Hypergraphs`Edge[{
       WolframInstitute`Hypergraphs`Vertex[1, "a"], 
       WolframInstitute`Hypergraphs`Vertex[2]}, "Directed"], 
     WolframInstitute`Hypergraphs`Edge[{
       WolframInstitute`Hypergraphs`Vertex[1, "a"], 
       WolframInstitute`Hypergraphs`Vertex[3]}, "Directed"]}]],
  AutoDelete->True,
  Editable->True]], "Output",ExpressionUUID->"1dbee622-a11a-8147-88c7-\
5cb65d6fdefc"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "A vertex identifier denotes one vertex, so it can carry only one label. The \
explicit vertex list wins if the two disagree, and the disagreement is \
reported rather than resolved silently. This keeps the invariant that the \
vertex set is the single source of truth about labels, which is what makes \
labelled isomorphism well defined."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"cdf914d0-fca8-9b42-968f-82853b0cc6bb"],

Cell["A hypergraph is a multiset of edges", "Subsection",ExpressionUUID->"0330afbf-0d25-2147-8e13-65bbee1016c1"],

Cell["\<\
Edge order carries no information, so the two spellings below are the same \
object:\
\>", "Text",ExpressionUUID->"fb65808b-7569-c940-941d-236fb79f4b12"],

Cell["\<\
Hypergraph[{Edge[{1, 2}], Edge[{2, 3}]}] === Hypergraph[{Edge[{2, 3}], \
Edge[{1, 2}]}]\
\>", "Input",ExpressionUUID->"14eee5b2-f707-f341-8755-d14f9a8f156f"],

Cell[BoxData["True"], "Output",ExpressionUUID->"2c29791c-3f93-3f45-a6a8-1b483260d759"],

Cell["\<\
Multiplicity, on the other hand, does carry information. A repeated edge is \
kept, is drawn as a second arc, and a hypergraph with a doubled edge is not \
the same as one without:\
\>", "Text",ExpressionUUID->"604b835b-5638-2c4b-8c8b-590da1b6b7bc"],

Cell["Hypergraph[{Edge[{1, 2}], Edge[{1, 2}], Edge[{2, 3}]}]", "Input",ExpressionUUID->"48213529-c341-7049-a340-d0d9376b3968"],

