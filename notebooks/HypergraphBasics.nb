Cell["\<\
Edge labels behave the same way. Below, p followed by q along a directed path \
is isomorphic to q followed by p, by the correspondence that exchanges p and \
q:\
\>", "Text",ExpressionUUID->"1dadf843-8dc5-0740-877b-921432f765aa"],

Cell["\<\
t1 = Hypergraph[{Edge[{1, 2}, \"Directed\", \"p\"], Edge[{2, 3}, \
\"Directed\", \"q\"]}];
t2 = Hypergraph[{Edge[{1, 2}, \"Directed\", \"q\"], Edge[{2, 3}, \
\"Directed\", \"p\"]}];
{t1, t2}\
\>", "Input",ExpressionUUID->"4d0307c7-6bac-9d4d-8192-dc4b8a65259e"],

