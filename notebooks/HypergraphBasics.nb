Cell["\<\
a and b are the same directed path on different identifiers, so they are \
isomorphic. c is an out-star, which as a directed hypergraph is a different \
object:\
\>", "Text",ExpressionUUID->"a530ac25-89df-7543-834e-2d01e826eca3"],

Cell["{IsomorphicHypergraphQ[a, b], IsomorphicHypergraphQ[a, c]}", "Input",ExpressionUUID->"ce4cfd42-d215-d149-a32c-05b65350f76c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",ExpressionUUID->"07b08d42-\
6e05-264a-89dc-dd0cfa35c722"],

Cell["\<\
The witnessing renaming is available too, and is an empty association when \
there is none:\
\>", "Text",ExpressionUUID->"3171d68a-8eab-6148-804e-28322ac721b6"],

Cell["\<\
{FindHypergraphIsomorphism[a, b], FindHypergraphIsomorphism[a, c]}\
\>", "Input",ExpressionUUID->"dc49c8cb-f9d9-6f4b-b35c-0023bb22b38c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"1", "\[Rule]", "10"}], ",", 
     RowBox[{"2", "\[Rule]", "20"}], ",", 
     RowBox[{"3", "\[Rule]", "30"}]}], "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], "}"}]], "Output",E\
xpressionUUID->"e27bcee9-2d63-4d4d-b04f-7e10af4c88d2"],

Cell["Symmetry types are respected", "Subsection",ExpressionUUID->"0c087e43-7704-a045-9ed9-6bd4baa850f3"],

Cell["\<\
The same two hypergraphs, with both edges made unordered, become isomorphic \
\[LongDash] an undirected path on three vertices is an undirected star:\
\>", "Text",ExpressionUUID->"fc40e7d2-6947-7b44-a575-55a46a18b12a"],

Cell["\<\
au = Hypergraph[{Edge[{1, 2}, \"Unordered\"], Edge[{2, 3}, \"Unordered\"]}];
cu = Hypergraph[{Edge[{1, 2}, \"Unordered\"], Edge[{1, 3}, \"Unordered\"]}];
{au, cu, IsomorphicHypergraphQ[au, cu]}\
\>", "Input",ExpressionUUID->"216fcf7e-8212-864c-a41b-f6b43f218660"],

