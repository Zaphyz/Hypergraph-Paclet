Cell["FindHypergraphIsomorphism[i1, i2, \"Labels\" -> True]", "Input",ExpressionUUID->"e8c34783-c98b-e049-8984-467048b93501"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Vertices\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"1", "\[Rule]", "1"}], ",", 
      RowBox[{"2", "\[Rule]", "2"}], ",", 
      RowBox[{"3", "\[Rule]", "3"}]}], "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"VertexLabels\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"A\"\>", "\[Rule]", "\<\"P\"\>"}], ",", 
      RowBox[{"\<\"B\"\>", "\[Rule]", "\<\"Q\"\>"}]}], 
     "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"EdgeLabels\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"f\"\>", "\[Rule]", "\<\"g\"\>"}], ",", 
      RowBox[{"\<\"g\"\>", "\[Rule]", "\<\"f\"\>"}]}], 
     "\[RightAssociation]"}]}]}], "\[RightAssociation]"}]], "Output",Expressio\
nUUID->"9d8fab74-3fec-974a-ab4b-ba0861542317"],

Cell["\<\
Being independent, the two can disagree. i3 has the same edge labels as i1 \
but shares its vertex labels out differently \[LongDash] P once and Q twice, \
against A twice and B once \[LongDash] so no correspondence exists:\
\>", "Text",ExpressionUUID->"b655be5a-6ab5-e342-91fb-1ef1b5f29f31"],

Cell["\<\
i3 = Hypergraph[{Edge[{Vertex[1, \"P\"], Vertex[2, \"Q\"]}, \"Directed\", \"f\
\"],
                 Edge[{Vertex[2, \"Q\"], Vertex[3, \"Q\"]}, \"Directed\", \"g\
\"]}];
{IsomorphicHypergraphQ[i1, i3], IsomorphicHypergraphQ[i1, i3, \"Labeled\" -> \
False]}\
\>", "Input",ExpressionUUID->"1c06c34a-c6c4-cc45-838a-5d000db6990a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "True"}], "}"}]], "Output",ExpressionUUID->"fa97f8bb-\
4e27-cb46-943b-e3df31593556"],

Cell["\<\
The labels can still force the vertices to move. In k1 the label f is on two \
edges and g on one; in k2 it is q that is on two and p on one. So f must \
correspond to q and g to p, which obliges vertex 4 to go to vertex 2:\
\>", "Text",ExpressionUUID->"f5f32c25-072a-ab4b-a736-138920d7ed05"],

Cell["\<\
k1 = Hypergraph[{Edge[{1, 2}, \"Directed\", \"f\"], Edge[{1, 3}, \
\"Directed\", \"f\"],
                 Edge[{1, 4}, \"Directed\", \"g\"]}];
k2 = Hypergraph[{Edge[{1, 2}, \"Directed\", \"p\"], Edge[{1, 3}, \
\"Directed\", \"q\"],
                 Edge[{1, 4}, \"Directed\", \"q\"]}];
{k1, k2}\
\>", "Input",ExpressionUUID->"48b71f77-23e4-274e-b7c1-d59c6a8e5a2c"],

