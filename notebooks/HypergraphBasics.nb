           0.8773698149728941}}]], {}}, 
        {Opacity[1]}}}, 
      {Hue[0.63, 0.66, 0.81], Opacity[0.1], 
       FilledCurveBox[{
        BSplineCurve[{{0.8658339352737859, 0.}, {0.7278649513099094, 
          0.507048462975376}, {0.8768424375680299, 0.8659683851517446}}], 
