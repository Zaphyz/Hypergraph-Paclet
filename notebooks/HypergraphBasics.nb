Cell["\<\
The picture is the same object; InputForm shows what is actually stored:\
\>", "Text",ExpressionUUID->"9739d5b8-76ae-8a46-a0f9-bc40ea91afec"],

Cell[CellGroupData[{

Cell["\<\
InputForm @ Hypergraph[{Edge[{1, 2}], Edge[{2, 3}], Edge[{1, 2, 3}, \
\"Unordered\"]}]\
\>", "Input",ExpressionUUID->"50ea6f94-5ba2-0644-857b-6c92d59f74d1"],

Cell[BoxData[
 InterpretationBox[
  StyleBox[
   RowBox[{"Hypergraph", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Vertex", "[", "1", "]"}], ",", " ", 
       RowBox[{"Vertex", "[", "2", "]"}], ",", " ", 
       RowBox[{"Vertex", "[", "3", "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Edge", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Vertex", "[", "1", "]"}], ",", " ", 
           RowBox[{"Vertex", "[", "2", "]"}]}], "}"}], ",", 
         " ", "\"\<Directed\>\""}], "]"}], ",", " ", 
       RowBox[{"Edge", "[", 
