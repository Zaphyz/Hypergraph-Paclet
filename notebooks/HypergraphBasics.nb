\"Directed\", \"g\"]}];
e2 = Hypergraph[{Edge[{7, 8}, \"Directed\", \"f\"], Edge[{8, 9}, \
\"Directed\", \"g\"]}];
{e1, e2}\
\>", "Input",ExpressionUUID->"425eae21-6162-4e4c-9d42-65b3c20d596d"],

