Cell[CellGroupData[{

Cell["Isomorphism with labelled edges", "Subsection",ExpressionUUID->"a277ccc3-f2e5-cf43-a247-eb6aeb562083"],

Cell["\<\
Edge labels are treated on exactly the same footing as vertex labels. Two \
hypergraphs carrying the same edge labels on different identifiers are \
isomorphic, and the renaming is reported as usual:\
\>", "Text",ExpressionUUID->"defca386-3a15-5344-b5a5-838f1e4e91fa"],

Cell[CellGroupData[{

Cell["\<\
e1 = Hypergraph[{Edge[{1, 2}, \"Directed\", \"f\"], Edge[{2, 3}, \
\"Directed\", \"g\"]}];
e2 = Hypergraph[{Edge[{7, 8}, \"Directed\", \"f\"], Edge[{8, 9}, \
\"Directed\", \"g\"]}];
{e1, e2}\
\>", "Input",ExpressionUUID->"552f4b38-29e7-3d44-b7b0-a339beb55653"],

