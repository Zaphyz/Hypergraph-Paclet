        RowBox[{"1", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "4"}], "}"}]}], "}"}]}], "}"}]}], "}"}]], "Output",E\
xpressionUUID->"b4d4e14e-a723-a843-b298-d7274b526fba"],

Cell["A sequence of arrays is accepted as well as a list:", "Text",ExpressionUUID->"3dbfe9ee-75d3-8b43-96e5-91102a8622fa"],

Cell["\<\
Hypermatrix[ArrayObject[{1, 2}], ArrayObject[{1, 2, 3}]] ===
 Hypermatrix[{ArrayObject[{1, 2}], ArrayObject[{1, 2, 3}]}]\
\>", "Input",ExpressionUUID->"a815e639-d253-d244-bb22-b7482aacb8b0"],

Cell[BoxData["True"], "Output",ExpressionUUID->"094a2a68-b0a1-c84d-940f-68bbb7578bf6"],

