       StripOnInput->False,
       LineColor->GrayLevel[0],
       FrontFaceColor->GrayLevel[0],
       BackFaceColor->GrayLevel[0],
       GraphicsColor->GrayLevel[0],
       FontSize->12,
       FontColor->GrayLevel[0]], {3, 1, 2}]}, {
     {EdgeForm[None], FaceForm[{Hue[0.63, 0.3, 0.86], Opacity[0.22]}], 
      CuboidBox[{2.64, 0.64, 2.64}, {3.36, 1.3599999999999999`, 3.36}]}, 
     Text3DBox[
      StyleBox["0",
       StripOnInput->False,
       LineColor->GrayLevel[0],
       FrontFaceColor->GrayLevel[0],
       BackFaceColor->GrayLevel[0],
       GraphicsColor->GrayLevel[0],
       FontSize->12,
       FontColor->GrayLevel[0]], {3, 1, 3}]}, {
     {EdgeForm[None], FaceForm[{Hue[0.63, 0.3, 0.86], Opacity[0.22]}], 
      CuboidBox[{2.64, 1.6400000000000001`, 0.64}, {3.36, 2.36, 
       1.3599999999999999`}]}, Text3DBox[
      StyleBox["1",
       StripOnInput->False,
       LineColor->GrayLevel[0],
       FrontFaceColor->GrayLevel[0],
       BackFaceColor->GrayLevel[0],
       GraphicsColor->GrayLevel[0],
       FontSize->12,
       FontColor->GrayLevel[0]], {3, 2, 1}]}, {
     {EdgeForm[None], FaceForm[{Hue[0.63, 0.3, 0.86], Opacity[0.22]}], 
      CuboidBox[{2.64, 1.6400000000000001`, 1.6400000000000001`}, {3.36, 2.36,
        2.36}]}, Text3DBox[
      StyleBox["0",
       StripOnInput->False,
       LineColor->GrayLevel[0],
       FrontFaceColor->GrayLevel[0],
       BackFaceColor->GrayLevel[0],
       GraphicsColor->GrayLevel[0],
       FontSize->12,
       FontColor->GrayLevel[0]], {3, 2, 2}]}, {
     {EdgeForm[None], FaceForm[{Hue[0.63, 0.3, 0.86], Opacity[0.22]}], 
      CuboidBox[{2.64, 1.6400000000000001`, 2.64}, {3.36, 2.36, 3.36}]}, 
     Text3DBox[
      StyleBox["0",
       StripOnInput->False,
       LineColor->GrayLevel[0],
       FrontFaceColor->GrayLevel[0],
       BackFaceColor->GrayLevel[0],
       GraphicsColor->GrayLevel[0],
       FontSize->12,
       FontColor->GrayLevel[0]], {3, 2, 3}]}, {
     {EdgeForm[None], FaceForm[{Hue[0.63, 0.3, 0.86], Opacity[0.22]}], 
      CuboidBox[{2.64, 2.64, 0.64}, {3.36, 3.36, 1.3599999999999999`}]}, 
     Text3DBox[
      StyleBox["0",
       StripOnInput->False,
       LineColor->GrayLevel[0],
       FrontFaceColor->GrayLevel[0],
       BackFaceColor->GrayLevel[0],
       GraphicsColor->GrayLevel[0],
       FontSize->12,
       FontColor->GrayLevel[0]], {3, 3, 1}]}, {
     {EdgeForm[None], FaceForm[{Hue[0.63, 0.3, 0.86], Opacity[0.22]}], 
      CuboidBox[{2.64, 2.64, 1.6400000000000001`}, {3.36, 3.36, 2.36}]}, 
     Text3DBox[
      StyleBox["0",
       StripOnInput->False,
       LineColor->GrayLevel[0],
       FrontFaceColor->GrayLevel[0],
       BackFaceColor->GrayLevel[0],
       GraphicsColor->GrayLevel[0],
       FontSize->12,
       FontColor->GrayLevel[0]], {3, 3, 2}]}, {
     {EdgeForm[None], FaceForm[{Hue[0.63, 0.3, 0.86], Opacity[0.22]}], 
      CuboidBox[{2.64, 2.64, 2.64}, {3.36, 3.36, 3.36}]}, Text3DBox[
      StyleBox["0",
       StripOnInput->False,
       LineColor->GrayLevel[0],
       FrontFaceColor->GrayLevel[0],
       BackFaceColor->GrayLevel[0],
       GraphicsColor->GrayLevel[0],
       FontSize->12,
       FontColor->GrayLevel[0]], {3, 3, 3}]}}, 
   {Thickness[0.006], 
    {Hue[0.63, 0.7, 0.5], 
     Arrow3DBox[TubeBox[{{0.06, 0.06, 0.06}, {0.6100000000000001, 0.06, 
      0.06}}, 0.02]], Text3DBox[
