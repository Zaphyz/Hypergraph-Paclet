Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "The cubes have translucent faces and no outline. An outline on every cube \
of a lattice reads as a mesh rather than as a set of cells, and the entries \
behind the nearer faces can be read through them as it is. The reference \
implementation this package grew out of drew only this one order, and called \
such a picture a cubix; the name has not been kept, but the look of it has."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"e3a8f30b-9fe6-754a-9ca9-e708c5e06b2b"],

Cell["\<\
Colouring the indices makes the correspondence explicit, each axis taking a \
colour of its own:\
\>", "Text",ExpressionUUID->"b6a196aa-3554-a941-b093-403f334705a2"],

Cell["\<\
ArrayGraphics3D[Array[#1 #2 #3 &, {2, 2, 2}], \"Indices\" -> \"Colored\"]\
\>", "Input",ExpressionUUID->"27a1ce35-83ff-394e-8612-e27d8239dd54"],

