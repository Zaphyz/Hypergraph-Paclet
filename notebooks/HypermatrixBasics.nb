Cell["Normal @ GenerateSymbolicArray[a, {2, 3}]", "Input",ExpressionUUID->"6257ccf1-228e-9a4c-9e28-38cc7ef63417"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "1"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "3"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "1"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "3"}], "]"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"41792edd-f733-c943-9170-210c3bd4eea5"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "It is a function, not a kind of object. In that it sits beside ZeroArray, \
OneArray and IdentityArray, which build their entries from a shape as this \
one builds them from a name; what comes back from any of them is an \
ArrayObject. Naming it Generate\[Hyphen]something says that plainly, at the \
cost of being the only one of the four that does."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"92f27a92-d344-304a-97b6-e18ee088f5fa"],

Cell["\<\
Having been generated leaves no trace on the array, and its domain is read \
off its entries like anyone else's:\
\>", "Text",ExpressionUUID->"726bcff5-af1c-524e-8a73-6d66169851ed"],

Cell["\<\
sa = GenerateSymbolicArray[a, {2, 3}];
{Head[sa], ArrayDomain[sa], ArrayDomain[m]}\
\>", "Input",ExpressionUUID->"6a7e7efd-a8ef-2b4b-bfc5-12a9d35066b3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"ArrayObject", ",", "\<\"Expression\"\>", ",", "\<\"Integer\"\>"}], 
  "}"}]], "Output",ExpressionUUID->"b8201fcc-7194-424e-8512-c8439bde6a84"],

Cell["3. Index symmetries", "Section",ExpressionUUID->"d8baa5a9-d907-fa46-81d3-f1d57f45b718"],

Cell["\<\
A regular array may declare an index symmetry: \"Rigid\" for no symmetry, \
which is the default, \"Cyclic\" for invariance under cyclic permutation of \
the indices, or \"Symmetric\" for invariance under all of them.\
\>", "Text",ExpressionUUID->"cfd945fb-06f8-284e-bfb3-75eb06e9c5c5"],

Cell["On a symbolic array the symmetry is honoured by construction", \
"Subsection",ExpressionUUID->"f9f21b64-1adb-e34b-9b23-5b5dcb412240"],

Cell["\<\
Index tuples that are equivalent under the symmetry name the same entry, so \
the generated array cannot fail to have the symmetry it claims:\
\>", "Text",ExpressionUUID->"be101f81-2c78-ed4c-a0e7-8d7f6c0b605f"],

Cell["Normal @ GenerateSymbolicArray[a, {3, 3}, \"Symmetric\"]", "Input",ExpressionUUID->"44155c18-9b96-1344-8c6f-3ee91653735d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "1"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "3"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "3"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "3"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "3"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"3", ",", "3"}], "]"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"9900971b-efa4-2a43-803c-60c94633c786"],

Cell["\<\
With[{e = Normal @ GenerateSymbolicArray[a, {3, 3}, \"Symmetric\"]}, e === \
Transpose[e]]\
\>", "Input",ExpressionUUID->"f652d39f-8b2b-184b-829f-2f75a4376eeb"],

Cell[BoxData["True"], "Output",ExpressionUUID->"adc2419d-cbb9-ad42-a0c7-baafbcb67a8f"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "This is the same device that puts the vertices of a hyperedge into the \
least order of their symmetry orbit. Here the entry at a tuple of indices is \
the name applied to the least tuple in its orbit, which is why a symmetric or \
cyclic symbolic array needs no checking."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"17c2c676-22ce-7d4f-a2b1-075324d30c77"],

Cell["\<\
The three symmetries really are three different things. Counting distinct \
entries of a 3\[Times]3\[Times]3 array shows it:\
\>", "Text",ExpressionUUID->"5a568df5-83c0-494e-a776-fa3c7cf50ac6"],

Cell["\<\
Length @ DeleteDuplicates @ Flatten @ Normal @ GenerateSymbolicArray[a, {3, \
3, 3}, #] & /@
  {\"Rigid\", \"Cyclic\", \"Symmetric\"}\
\>", "Input",ExpressionUUID->"6bad698f-59c9-124c-91e7-aeb28be5e554"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"27", ",", "11", ",", "10"}], "}"}]], "Output",ExpressionUUID->\
"f3d10b09-158f-c646-aa1f-ad9901aa874b"],

Cell["\<\
At order two, though, the cyclic group on the indices is the whole symmetric \
group, so there \"Cyclic\" and \"Symmetric\" coincide exactly:\
\>", "Text",ExpressionUUID->"256b0d58-b442-6149-8e6a-b62875cece6b"],

Cell["\<\
Normal[GenerateSymbolicArray[a, {3, 3}, \"Cyclic\"]] === \
Normal[GenerateSymbolicArray[a, {3, 3}, \"Symmetric\"]]\
\>", "Input",ExpressionUUID->"6fbe249f-e2a1-1e4c-bf08-d1f1891e6fc8"],

Cell[BoxData["True"], "Output",ExpressionUUID->"cfb34508-9495-1f4a-b9ce-a7bb151ca8ba"],

Cell["A declared symmetry is verified", "Subsection",ExpressionUUID->"c6c414f4-4727-5041-80c7-c6efa667050b"],

Cell["\<\
An array given its entries has them already, so a declared symmetry is a \
claim about them, and it is checked. These entries are symmetric:\
\>", "Text",ExpressionUUID->"a09ef710-902f-7149-bbfb-158d7621c6b9"],

Cell["ArraySymmetry @ ArrayObject[{{1, 2}, {2, 1}}, \"Symmetric\"]", "Input",ExpressionUUID->"96b4d293-6d3b-644e-89e3-c114f2d0f7ac"],

Cell[BoxData["\<\"Symmetric\"\>"], "Output",ExpressionUUID->"2070fdc7-d34e-154e-8fc0-8cdb15cefda5"],

Cell["\<\
\[Ellipsis] and these are not, so the declaration is refused rather than the \
entries being quietly symmetrized:\
\>", "Text",ExpressionUUID->"2f901586-7f88-0c41-b985-2f6f5d003520"],

Cell["Quiet @ ArrayObject[{{1, 2}, {3, 4}}, \"Symmetric\"]", "Input",ExpressionUUID->"1d5f3feb-edb5-df43-a51d-e307d662b95a"],

Cell[BoxData["$Failed"], "Output",ExpressionUUID->"259627f4-7dbd-e540-9291-9a1ad6c7812e"],

Cell["The same entries are perfectly good as a rigid array:", "Text",ExpressionUUID->"4f4d5c43-363b-6047-b4b8-e4c564169d95"],

Cell["ArraySymmetry @ ArrayObject[{{1, 2}, {3, 4}}]", "Input",ExpressionUUID->"0cb17b8a-b4ea-c645-a800-6c22129077ca"],

Cell[BoxData["\<\"Rigid\"\>"], "Output",ExpressionUUID->"dd1a2e7a-a259-3e40-a733-da384ad290cf"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Refusing is the honest answer: symmetrizing would silently return an array \
with different entries from the ones given. The symmetry is a declared \
property and ArraySymmetry reports what was declared, in the same way that an \
edge's symmetry type is declared rather than detected."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"4d635730-317a-7d47-b6a4-05679ce7c99a"],

Cell["\<\
Cyclic and symmetric are genuinely distinguished. The indicator of the cyclic \
orbit of (1, 2, 3) is invariant under rotating the indices but not under \
swapping two of them:\
\>", "Text",ExpressionUUID->"943687e7-7a43-ea4c-8102-45bd98f0caab"],

Cell["\<\
cyc = Array[If[MemberQ[{{1, 2, 3}, {2, 3, 1}, {3, 1, 2}}, {##}], 1, 0] &, {3, \
3, 3}];
{ArraySymmetry @ ArrayObject[cyc, \"Cyclic\"],
  Quiet @ ArrayObject[cyc, \"Symmetric\"]}\
\>", "Input",ExpressionUUID->"264a04be-22e6-d04e-a426-6204fd9a95ee"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Cyclic\"\>", ",", "$Failed"}], "}"}]], "Output",ExpressionUUID->\
"840dd7bf-0f50-4a47-b70a-dcf5e9905f89"],

Cell["\<\
A symmetry needs a regular array: permuting the indices of a 2\[Times]3 array \
would not give an array of the same shape, so the declaration is refused:\
\>", "Text",ExpressionUUID->"84ef0415-1abe-c74e-a3fd-8806e3f5e1ef"],

Cell["Quiet @ ArrayObject[{{1, 2, 3}, {4, 5, 6}}, \"Symmetric\"]", "Input",ExpressionUUID->"81d4804e-18dd-b14b-9fbf-552ef6d22ecf"],

Cell[BoxData["$Failed"], "Output",ExpressionUUID->"14c0e0d8-4e2c-7243-99e4-8f0a7db191c9"],

Cell["4. Hypermatrices", "Section",ExpressionUUID->"d96e9ae8-d6bb-2347-853e-78baf9020eea"],

Cell["\<\
A hypermatrix is a list of arrays, held in a canonical order: lowest order \
first, then the shorter dimensions, then symmetry taking symmetric before \
cyclic before rigid. Here are six arrays given in no particular order:\
\>", "Text",ExpressionUUID->"fb1ed61e-8503-8445-9b27-0cab24efdc89"],

Cell["\<\
hm = Hypermatrix[{
   ArrayObject[Array[1 &, {2, 2, 2}], \"Symmetric\"],
   ArrayObject[{{1, 2}, {3, 4}}],
   ArrayObject[{1, 2}],
   ArrayObject[{1, 2, 3}],
   ArrayObject[{{1, 2}, {2, 1}}, \"Symmetric\"],
   ArrayObject[{{1, 2}, {2, 1}}, \"Cyclic\"]}]\
\>", "Input",ExpressionUUID->"1accf65c-f323-4241-b38b-ffffb1c258c2"],

