Cell["It agrees with the built-in matrix product, as it should:", "Text",ExpressionUUID->"999adac1-f5f9-5241-a936-ddee2bd80fb5"],

Cell["ArrayMultiply[{sa, sb}, \"ij,jk->ik\"] === sa . sb", "Input",ExpressionUUID->"03b49d63-bbc0-df4d-ae7d-ecc31644beed"],

Cell[BoxData["False"], "Output",ExpressionUUID->"1222af7f-a8fc-944b-86a0-5edcff6e6169"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Arrays with numeric entries and arrays with generated ones may be \
contracted together. That was once refused, on the grounds that the result \
would be neither kind of object; with one array object the objection has \
nothing left to stand on, and the entries of the result are simply the \
expressions the contraction builds."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"1bbe3d5a-7553-0244-8a1e-8656d4e676db"],

Cell["Normal @ ArrayMultiply[{{{1, 2}, {3, 4}}, sb}, \"ij,jk->ik\"]", "Input",ExpressionUUID->"1ad9c6e7-2032-ce4b-9e14-1325e3b92457"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"q", "[", 
       RowBox[{"1", ",", "1"}], "]"}], "+", 
      RowBox[{"2", " ", 
       RowBox[{"q", "[", 
        RowBox[{"2", ",", "1"}], "]"}]}]}], ",", 
     RowBox[{
      RowBox[{"q", "[", 
       RowBox[{"1", ",", "2"}], "]"}], "+", 
      RowBox[{"2", " ", 
       RowBox[{"q", "[", 
        RowBox[{"2", ",", "2"}], "]"}]}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"3", " ", 
       RowBox[{"q", "[", 
        RowBox[{"1", ",", "1"}], "]"}]}], "+", 
      RowBox[{"4", " ", 
       RowBox[{"q", "[", 
        RowBox[{"2", ",", "1"}], "]"}]}]}], ",", 
     RowBox[{
      RowBox[{"3", " ", 
       RowBox[{"q", "[", 
        RowBox[{"1", ",", "2"}], "]"}]}], "+", 
      RowBox[{"4", " ", 
       RowBox[{"q", "[", 
        RowBox[{"2", ",", "2"}], "]"}]}]}]}], "}"}]}], "}"}]], "Output",Expres\
sionUUID->"43074444-b7bb-8a41-8995-30d9bd6c01a2"],

Cell["Contracting every index: the trace", "Subsection",ExpressionUUID->"eb2f5db6-6b08-5440-8f9d-81f410463ab3"],

Cell["\<\
An operation need not return an array. Contracting a single matrix onto no \
indices at all sums its diagonal, which is the trace, and works on numerical \
and symbolic entries alike:\
\>", "Text",ExpressionUUID->"2279c39e-8568-ef44-8eb5-d22ea694b906"],

Cell["\<\
trace[u_List] := Normal @ ArrayMultiply[{u}, \"pp->\"];
{trace[{{1, 2}, {3, 4}}], trace[sa]}\
\>", "Input",ExpressionUUID->"c672a48c-72a3-f94a-9141-d0ec74a81d80"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"5", ",", 
   RowBox[{
    RowBox[{"p", "[", 
     RowBox[{"1", ",", "1"}], "]"}], "+", 
    RowBox[{"p", "[", 
     RowBox[{"2", ",", "2"}], "]"}]}]}], "}"}]], "Output",ExpressionUUID->\
"6bb2b518-b687-1d47-9256-648eb775f5a2"],

Cell["\<\
{trace[{{1, 2}, {3, 4}}] === Tr[{{1, 2}, {3, 4}}], trace[sa] === Tr[sa]}\
\>", "Input",ExpressionUUID->"f8e159a0-5ab6-2346-a85f-d28e83170f3a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",ExpressionUUID->"ad51a244-365c-5b4d-8278-64638feb87b1"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "The Normal is doing something here. A contraction onto no indices gives \
back the 0-array rather than a bare number, and Normal takes its single \
entry. It does the same whatever the entries were, so the one definition \
covers every case."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"b9d943b9-0968-5044-8dab-5f74640dfeb2"],

Cell["8. Adding and multiplying entry by entry", "Section",ExpressionUUID->"c6c685dc-ad3f-3d47-8428-6dd207c84619"],

Cell["\<\
Contraction is one of the two things one does with arrays. The other is to \
combine them entry by entry, which is what makes arrays of a given shape a \
vector space rather than merely a collection of tables. ArrayAdd and \
ArrayTimes do that:\
\>", "Text",ExpressionUUID->"de682594-486a-9a4b-a7ff-c56e74f8d0d2"],

Cell["\<\
u = {{1, 2}, {3, 4}}; v = {{5, 6}, {7, 8}};
{Normal @ ArrayAdd[u, v], Normal @ ArrayTimes[u, v]}\
\>", "Input",ExpressionUUID->"8cd633d5-080b-1a48-9696-c8dc4563f632"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"6", ",", "8"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"10", ",", "12"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"5", ",", "12"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"21", ",", "32"}], "}"}]}], "}"}]}], "}"}]], "Output",Expression\
UUID->"84233013-6388-ad43-a2d7-a325434d0938"],

Cell["\<\
Plus and Times on array objects are those same operations, so arrays may be \
combined in ordinary arithmetic notation:\
\>", "Text",ExpressionUUID->"da1d8b17-2596-3249-bcdb-45af336afab1"],

Cell["\<\
{Normal[ArrayObject[u] + ArrayObject[v]],
  Normal[ArrayObject[u] - ArrayObject[v]],
  Normal[ArrayObject[u] ArrayObject[v]]}\
\>", "Input",ExpressionUUID->"d85f07ef-829c-7942-9fa8-d7a20b24bd5a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"6", ",", "8"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"10", ",", "12"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "4"}], ",", 
       RowBox[{"-", "4"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "4"}], ",", 
       RowBox[{"-", "4"}]}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"5", ",", "12"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"21", ",", "32"}], "}"}]}], "}"}]}], "}"}]], "Output",Expression\
UUID->"bb9427f8-c030-6a4f-b94c-097793f492b2"],

Cell["\<\
An array of order zero has no shape of its own, so it combines with an array \
of any dimensions, reaching every entry:\
\>", "Text",ExpressionUUID->"a7672a87-ab9f-6644-9804-27c6c05f99b4"],

Cell["{Normal @ ArrayTimes[2, u], Normal @ ArrayAdd[1, u]}", "Input",ExpressionUUID->"f6edcf18-93bd-b24f-adb9-ce68d17fa8cf"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"6", ",", "8"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"4", ",", "5"}], "}"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"c8251156-57ed-4c42-8059-741cbeee317e"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "This is why scalar multiplication needs no name of its own. A scalar is the \
0-array; multiplying an array by one is the same entry-by-entry \
multiplication as multiplying it by another array of its own shape, with the \
single entry spread over the whole shape rather than matched index for index. \
One operation, one rule, and 2 a is ArrayTimes[ArrayObject[2], a] written \
shorter."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"8e9ac8da-35cb-1542-9f85-11ac6c404f39"],

Cell["ArrayTimes[2, u] === ArrayTimes[ArrayObject[2], u]", "Input",ExpressionUUID->"d66cd88c-e56b-a949-91eb-275da6d278f7"],

Cell[BoxData["True"], "Output",ExpressionUUID->"555153d7-4a86-a043-85d0-40586e8261b4"],

Cell["\<\
Arrays of different dimensions cannot be combined this way, and are refused \
rather than padded or truncated:\
\>", "Text",ExpressionUUID->"a8474af8-3f48-ac4a-9119-5ecb6e2db063"],

Cell["Quiet @ ArrayAdd[{1, 2}, {1, 2, 3}]", "Input",ExpressionUUID->"e4245b36-ba13-854f-b5a2-453b09942dbd"],

Cell[BoxData["$Failed"], "Output",ExpressionUUID->"7b06dcfd-f55a-854f-b209-6d3eae603806"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Entries of any kind may be combined, a number meeting an expression having \
the obvious meaning, and the result is an array object like anything else \
here. ArrayMultiply once refused the same mixture and no longer does, for the \
same reason: with one array object there is nothing ambiguous about what \
comes back."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"c6817b4c-3b35-2a43-a507-16d4301d9194"],

Cell["\<\
{2 GenerateSymbolicArray[c, {2}], ArrayObject[{1, 2}] + \
GenerateSymbolicArray[c, {2}]}\
\>", "Input",ExpressionUUID->"ac029a0e-bd6d-c244-b6f0-23ef744ff22c"],

