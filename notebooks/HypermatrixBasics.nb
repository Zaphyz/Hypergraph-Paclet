Cell["\<\
It displays as a summary box rather than as its entries, which is what lets \
an array of any order and any size print in the same amount of space. Normal \
gives the entries back, and ArrayGraphics draws them:\
\>", "Text",ExpressionUUID->"de19f67c-dce1-0b45-8e98-add89044139e"],

Cell["Normal @ ArrayObject[{{1, 2, 3}, {4, 5, 6}}]", "Input",ExpressionUUID->"182f4a6e-d177-144f-87b7-7f15c548e83d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"4", ",", "5", ",", "6"}], "}"}]}], "}"}]], "Output",ExpressionUUI\
D->"4a5ea734-1cdc-4f4a-89c3-39c32f2e212e"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "There is one array object rather than one per kind of entry because nothing \
about the structure of an array depends on what sits in it. The order, the \
dimensions and the symmetry are the same questions whether the entries are \
integers, elements of a finite field, generated symbols or labels from a \
dictionary. An earlier design had a NumericalArray and a SymbolicArray as \
separate heads; the distinction turned out to buy nothing and cost a slot \
that was meaningless in each."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"539ac7e6-3be1-e64d-8a17-a11e0ee8bc3e"],

Cell["Order and dimensions", "Subsection",ExpressionUUID->"ca4daa13-6a5e-bd4a-88c5-efc9c571eb93"],

Cell["\<\
The dimensions of an array are the lengths of its indices, and its order is \
the number of indices. An array of order n is an n-array, so a component \
vector is a 1-array and a matrix is a 2-array:\
\>", "Text",ExpressionUUID->"896c72d8-e023-7a43-b13d-9869af39615a"],

Cell["\<\
arrays = ArrayObject /@ {{1, 2, 3}, {{1, 2}, {3, 4}}, Array[#1 + #2 + #3 &, \
{2, 2, 2}]};
{ArrayOrder /@ arrays, ArrayDimensions /@ arrays}\
\>", "Input",ExpressionUUID->"25a5dec0-8fb1-af40-a30b-aa52030ce9cf"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", "3", "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "2", ",", "2"}], "}"}]}], "}"}]}], "}"}]], "Output",Ex\
pressionUUID->"7d28c65c-4847-ca40-ad69-dd6eec61e1ce"],

Cell["\<\
Dimensions works directly on an array object, as do Normal and the string \
properties:\
\>", "Text",ExpressionUUID->"7e0b6425-1976-d14f-8f15-6886b9bf0fb2"],

Cell["\<\
m = ArrayObject[{{1, 2, 3}, {4, 5, 6}}];
{Dimensions[m], m[\"Order\"], m[\"Properties\"]}\
\>", "Input",ExpressionUUID->"ac0c3218-1dc3-d344-be8b-05f60f29d22a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "3"}], "}"}], ",", "2", ",", 
   RowBox[{"{", 
    RowBox[{"\<\"Order\"\>", ",", "\<\"Dimensions\"\>", 
     ",", "\<\"Symmetry\"\>", ",", "\<\"Domain\"\>", ",", "\<\"Entries\"\>", 
     ",", "\<\"RegularQ\"\>"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"57c36d76-b468-e245-b0e5-569bcb5635d8"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Dimensions and Normal are protected System` symbols, so they are extended \
with UpValues on the array head rather than redefined. That is the same \
treatment VertexList and EdgeList get on Hypergraph."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"692d9052-97eb-6b49-bb08-94fee018c355"],

Cell["Regular and irregular", "Subsection",ExpressionUUID->"94315af7-fdeb-d84e-b7dc-07344b510f99"],

Cell["\<\
An array is regular when all of its indices range over the same length, and \
irregular when they do not:\
\>", "Text",ExpressionUUID->"06c10342-54d6-f34c-bbb4-6c14f72624f0"],

Cell["\<\
{RegularArrayQ @ ArrayObject[{{1, 2}, {3, 4}}],
  RegularArrayQ @ ArrayObject[{{1, 2, 3}, {4, 5, 6}}]}\
\>", "Input",ExpressionUUID->"8ec98394-9352-1a4d-8f75-3eff2e113426"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",ExpressionUUID->"350d5514-\
3370-af43-ad3a-f9226466f575"],

Cell["Value domains", "Subsection",ExpressionUUID->"4e10aced-7509-3e4c-9e04-eb24a411d068"],

Cell["\<\
What an array is made of is not declared: it is asked. ArrayDomain reads the \
entries and gives the narrowest recognized domain containing every one of \
them:\
\>", "Text",ExpressionUUID->"7384f56d-0eb6-074f-a9b7-d186f2e57967"],

Cell["\<\
ArrayDomain @ ArrayObject[#] & /@ {{True, False}, {1, 2}, {1/2, 3}, {1.5, 2}, \
{1 + I, 2}}\
\>", "Input",ExpressionUUID->"f12b086c-6a05-ee40-b603-bb91ce179f41"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Boolean\"\>", ",", "\<\"Integer\"\>", ",", "\<\"Rational\"\>", 
   ",", "\<\"Real\"\>", ",", "\<\"Complex\"\>"}], "}"}]], "Output",ExpressionU\
UID->"db0589a3-73d1-004d-8495-91884a66546e"],

Cell["The elements of a finite field are recognized as that field:", "Text",ExpressionUUID->"4acab14c-8545-e942-af73-c8468b939d73"],

Cell["\<\
ArrayDomain @ ArrayObject[{FiniteField[2, 1][0], FiniteField[2, 1][1]}]\
\>", "Input",ExpressionUUID->"db0892d9-39e4-3d43-bbc8-61d06f962bd1"],

