Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "The picture is the argument for the name. Where the full identity picks out \
a line through the cube, a partial identity picks out a plane \[LongDash] and \
the three of them, one per pair of indices, are three planes meeting along \
that line. Naming every position leaves only the line, which is the full \
identity again."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"a148816c-3d8e-fa4a-a237-e7b5ab53984e"],

Cell["\<\
Dimension by dimension, the identity at order three grows as a diagonal \
should:\
\>", "Text",ExpressionUUID->"96ae802d-71e0-304a-a72b-3940376426a1"],

Cell["ArrayGraphics3D @ IdentityArray[3, #] & /@ {2, 3, 4}", "Input",ExpressionUUID->"6c55e23b-8a4e-da45-a593-9e432b755e96"],

