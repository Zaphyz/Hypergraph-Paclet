Cell["Normal @ GenerateSymbolicArray[a, {2, 3}]", "Input",ExpressionUUID->"178f5b68-7f05-af41-b241-b85cb35e6e15"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "1"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "3"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "1"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "3"}], "]"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"a38b3b58-7775-f44e-838d-e85976bbea1d"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "It is a function, not a kind of object. In that it sits beside ZeroArray, \
OneArray and IdentityArray, which build their entries from a shape as this \
one builds them from a name; what comes back from any of them is an \
ArrayObject. Naming it Generate\[Hyphen]something says that plainly, at the \
cost of being the only one of the four that does."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"d57e499a-30d5-784b-ab97-c0776e4f2f1a"],

Cell["\<\
Having been generated leaves no trace on the array, and its domain is read \
off its entries like anyone else's:\
\>", "Text",ExpressionUUID->"2dc4ff65-d163-9c4e-98a1-5c315a3b9b88"],

Cell["\<\
sa = GenerateSymbolicArray[a, {2, 3}];
{Head[sa], ArrayDomain[sa], ArrayDomain[m]}\
\>", "Input",ExpressionUUID->"7b76c8a0-6208-dd4b-b836-1d5158354095"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"ArrayObject", ",", "\<\"Expression\"\>", ",", "\<\"Integer\"\>"}], 
  "}"}]], "Output",ExpressionUUID->"20cdaf3b-3728-c640-9583-d4c13a23fe66"],

Cell["3. Index symmetries", "Section",ExpressionUUID->"76095db1-59aa-a743-b642-35585e62d8c9"],

Cell["\<\
A regular array may declare an index symmetry: \"Rigid\" for no symmetry, \
which is the default, \"Cyclic\" for invariance under cyclic permutation of \
the indices, or \"Symmetric\" for invariance under all of them.\
\>", "Text",ExpressionUUID->"736f6cfa-a501-f94c-a627-5e3920415763"],

Cell["On a symbolic array the symmetry is honoured by construction", \
"Subsection",ExpressionUUID->"96bf55bc-ff1a-af45-990b-dfe0040b43d9"],

Cell["\<\
Index tuples that are equivalent under the symmetry name the same entry, so \
the generated array cannot fail to have the symmetry it claims:\
\>", "Text",ExpressionUUID->"02a66397-20d3-084b-9073-f3f265cd3f5e"],

Cell["Normal @ GenerateSymbolicArray[a, {3, 3}, \"Symmetric\"]", "Input",ExpressionUUID->"409ffb0c-aa3c-e54a-8d2d-f8fdff5f2121"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "1"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "3"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "3"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "3"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "3"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"3", ",", "3"}], "]"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"0b9b32f0-5be7-b144-9230-0b03b4e1b513"],

Cell["\<\
With[{e = Normal @ GenerateSymbolicArray[a, {3, 3}, \"Symmetric\"]}, e === \
Transpose[e]]\
\>", "Input",ExpressionUUID->"92d36e17-514e-6649-9a1c-a06c81bec37d"],

Cell[BoxData["True"], "Output",ExpressionUUID->"8754b9a3-ec8f-db42-ab10-7b2cda2a5e66"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "This is the same device that puts the vertices of a hyperedge into the \
least order of their symmetry orbit. Here the entry at a tuple of indices is \
the name applied to the least tuple in its orbit, which is why a symmetric or \
cyclic symbolic array needs no checking."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"1e4333c2-e2bd-014f-b1ff-6104ddac4575"],

Cell["\<\
The three symmetries really are three different things. Counting distinct \
entries of a 3\[Times]3\[Times]3 array shows it:\
\>", "Text",ExpressionUUID->"5a56765a-82f0-114d-a3f7-edd4b9a5b89b"],

Cell["\<\
Length @ DeleteDuplicates @ Flatten @ Normal @ GenerateSymbolicArray[a, {3, \
3, 3}, #] & /@
  {\"Rigid\", \"Cyclic\", \"Symmetric\"}\
\>", "Input",ExpressionUUID->"042d96eb-fae7-cc4e-aa35-a58c22607fde"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"27", ",", "11", ",", "10"}], "}"}]], "Output",ExpressionUUID->\
"18d81aa5-5d07-b146-b9c9-0c9f0e19f2cb"],

Cell["\<\
At order two, though, the cyclic group on the indices is the whole symmetric \
group, so there \"Cyclic\" and \"Symmetric\" coincide exactly:\
\>", "Text",ExpressionUUID->"37c1a204-68cb-db47-8ea2-9d1ef5b469c7"],

Cell["\<\
Normal[GenerateSymbolicArray[a, {3, 3}, \"Cyclic\"]] === \
Normal[GenerateSymbolicArray[a, {3, 3}, \"Symmetric\"]]\
\>", "Input",ExpressionUUID->"01b7309b-65cf-ec45-84eb-1f6b9fd49be1"],

Cell[BoxData["True"], "Output",ExpressionUUID->"0bbd9336-b8ee-1e41-9a10-26a02c0224d6"],

Cell["A declared symmetry is verified", "Subsection",ExpressionUUID->"4ab3f14c-827b-3949-a5cb-2752c6101ddc"],

Cell["\<\
An array given its entries has them already, so a declared symmetry is a \
claim about them, and it is checked. These entries are symmetric:\
\>", "Text",ExpressionUUID->"da06fdc1-caca-b24f-9a83-cb98c1e051b7"],

Cell["ArraySymmetry @ ArrayObject[{{1, 2}, {2, 1}}, \"Symmetric\"]", "Input",ExpressionUUID->"45be3c77-aa39-3442-86a9-73f9843fea2b"],

Cell[BoxData["\<\"Symmetric\"\>"], "Output",ExpressionUUID->"57e46051-d46f-7c40-a85c-af4ae52feee3"],

Cell["\<\
\[Ellipsis] and these are not, so the declaration is refused rather than the \
entries being quietly symmetrized:\
\>", "Text",ExpressionUUID->"b5cb68b7-7665-ac4a-b66a-07411ba5f0b0"],

Cell["Quiet @ ArrayObject[{{1, 2}, {3, 4}}, \"Symmetric\"]", "Input",ExpressionUUID->"b63dff3f-ac29-814c-a513-82bafa6a6fde"],

Cell[BoxData["$Failed"], "Output",ExpressionUUID->"2385f2f4-a9a3-7e4c-8e54-e010e220efab"],

Cell["The same entries are perfectly good as a rigid array:", "Text",ExpressionUUID->"dab0a43d-3be9-ba4f-94aa-9ccccf722327"],

Cell["ArraySymmetry @ ArrayObject[{{1, 2}, {3, 4}}]", "Input",ExpressionUUID->"484e29ee-a794-0f48-80b9-34eba7f32b9b"],

Cell[BoxData["\<\"Rigid\"\>"], "Output",ExpressionUUID->"0e039697-03e6-804c-aecc-f990965870ff"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Refusing is the honest answer: symmetrizing would silently return an array \
with different entries from the ones given. The symmetry is a declared \
property and ArraySymmetry reports what was declared, in the same way that an \
edge's symmetry type is declared rather than detected."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"c7ee4624-f21d-6846-acf2-e49e75679e21"],

Cell["\<\
Cyclic and symmetric are genuinely distinguished. The indicator of the cyclic \
orbit of (1, 2, 3) is invariant under rotating the indices but not under \
swapping two of them:\
\>", "Text",ExpressionUUID->"031e0056-ef61-d547-a8c0-2693a8310abb"],

Cell["\<\
cyc = Array[If[MemberQ[{{1, 2, 3}, {2, 3, 1}, {3, 1, 2}}, {##}], 1, 0] &, {3, \
3, 3}];
{ArraySymmetry @ ArrayObject[cyc, \"Cyclic\"],
  Quiet @ ArrayObject[cyc, \"Symmetric\"]}\
\>", "Input",ExpressionUUID->"48e4388c-55ca-004b-adeb-c6dba3005acc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Cyclic\"\>", ",", "$Failed"}], "}"}]], "Output",ExpressionUUID->\
"4eaa5964-2fac-cb4f-8b37-c5ada38c4ec6"],

Cell["\<\
A symmetry needs a regular array: permuting the indices of a 2\[Times]3 array \
would not give an array of the same shape, so the declaration is refused:\
\>", "Text",ExpressionUUID->"373b0b32-fa80-464d-a617-6d2678e470ad"],

Cell["Quiet @ ArrayObject[{{1, 2, 3}, {4, 5, 6}}, \"Symmetric\"]", "Input",ExpressionUUID->"6b9713e1-8bd7-2b47-a7f7-649c454e26d4"],

Cell[BoxData["$Failed"], "Output",ExpressionUUID->"95a60c33-b3f8-c646-a6cd-416d2d27633f"],

Cell["4. Hypermatrices", "Section",ExpressionUUID->"03cad6f8-d2fe-b94d-8584-a012b49000ed"],

Cell["\<\
A hypermatrix is a list of arrays, held in a canonical order: lowest order \
first, then the shorter dimensions, then symmetry taking symmetric before \
cyclic before rigid. Here are six arrays given in no particular order:\
\>", "Text",ExpressionUUID->"c63601fd-6968-1e42-8ef5-8ce34cbb1e35"],

Cell["\<\
hm = Hypermatrix[{
   ArrayObject[Array[1 &, {2, 2, 2}], \"Symmetric\"],
   ArrayObject[{{1, 2}, {3, 4}}],
   ArrayObject[{1, 2}],
   ArrayObject[{1, 2, 3}],
   ArrayObject[{{1, 2}, {2, 1}}, \"Symmetric\"],
   ArrayObject[{{1, 2}, {2, 1}}, \"Cyclic\"]}]\
\>", "Input",ExpressionUUID->"dbf8745e-f072-b54c-af34-930b7972cb17"],

