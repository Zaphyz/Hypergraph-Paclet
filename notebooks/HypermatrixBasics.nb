Cell["6. Special arrays", "Section",ExpressionUUID->"1f80f4ca-553f-944d-a36c-4fe2b9bee77a"],

Cell["\<\
The constant arrays and the generalized Kronecker deltas are available in any \
order, dimension and value domain. Each declares the strongest symmetry that \
actually holds of it, which the ArrayObject constructor then verifies.\
\>", "Text",ExpressionUUID->"af1f894b-dcb9-a84e-86b2-f16f147bade5"],

Cell["{Normal @ ZeroArray[2, 3], Normal @ OneArray[2, 3]}", "Input",ExpressionUUID->"86f6673d-9934-6b40-8b97-09a59476cc5e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "1", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], "}"}]}], "}"}]], "Output",Ex\
pressionUUID->"06d59f34-65ac-6444-a28d-0eb4a8036833"],

Cell["\<\
The identity array is one where all of its indices agree. At order two it is \
the identity matrix; at order three it is one only on the main diagonal:\
\>", "Text",ExpressionUUID->"1c48bd29-2adb-4b44-80fb-dc0bb68f29db"],

Cell["{Normal @ IdentityArray[2, 3], Normal @ IdentityArray[3, 2]}", "Input",ExpressionUUID->"0f5a2bc5-1157-f445-99bb-e333ad173038"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], "}"}]}], "}"}]], "Output",E\
xpressionUUID->"7af6b5df-6f92-4143-8345-012366ee5c82"],

Cell["\<\
A partial identity is one where the indices at chosen positions agree, \
whatever the others do. These are the three partial identities of a 3-array, \
one per pair of indices:\
\>", "Text",ExpressionUUID->"e9fb3cfb-0706-004d-9e92-927c63d1276a"],

Cell["\<\
Normal @ PartialIdentityArray[3, 2, #] & /@ {{1, 2}, {2, 3}, {1, 3}}\
\>", "Input",ExpressionUUID->"fb25d33d-7a0f-684a-9698-b9909e5b4fa8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}]}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], "}"}]}], "}"}]], "Output",E\
xpressionUUID->"4434a009-909c-f647-843a-8f41481f0e62"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "A constant array and a full identity are invariant under every permutation \
of their indices, so they are declared symmetric. A partial identity on only \
some positions is not, so it is declared rigid. Naming every position gives \
back the full identity exactly."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"e26ac702-1353-ae43-b56b-c9031c28ea0d"],

Cell["\<\
{ArraySymmetry @ ZeroArray[3, 2], ArraySymmetry @ IdentityArray[3, 2],
  ArraySymmetry @ PartialIdentityArray[3, 2, {1, 2}],
  PartialIdentityArray[3, 2, {1, 2, 3}] === IdentityArray[3, 2]}\
\>", "Input",ExpressionUUID->"811b4031-dd6b-0b4d-b84f-64e4ec0bbd68"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Symmetric\"\>", ",", "\<\"Symmetric\"\>", ",", "\<\"Rigid\"\>",
    ",", "True"}], "}"}]], "Output",ExpressionUUID->"85389a77-3577-384c-9358-\
ce5b20aaa4ef"],

Cell["Seeing them", "Subsection",ExpressionUUID->"6af26ffe-f6ca-d74c-9c34-492b3b39bfe3"],

Cell["\<\
These arrays are the ones whose shape is worth looking at, since what makes \
each of them special is where its entries sit rather than what they are. Both \
families of pictures are useful here, and at different orders.\
\>", "Text",ExpressionUUID->"7c342b0a-5e5a-4b4c-9886-fc8bbc616db7"],

Cell["\<\
A constant array says the same thing at every position, whatever its \
dimensions. Order one, order two, and a rectangular one that is not regular \
at all:\
\>", "Text",ExpressionUUID->"5223733b-0579-9749-8cad-3a33693f23f4"],

Cell["\<\
{ArrayGraphics @ OneArray[{4}], ArrayGraphics @ ZeroArray[2, 3],
  ArrayGraphics @ OneArray[{2, 5}]}\
\>", "Input",ExpressionUUID->"1da1e7b9-3793-b54e-b9b6-1de7de046a0a"],

