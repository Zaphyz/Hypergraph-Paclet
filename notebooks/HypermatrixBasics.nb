Cell["Normal @ GenerateSymbolicArray[a, {2, 3}]", "Input",ExpressionUUID->"3a812a19-e40f-6f47-99c0-3b6e3d963b57"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "1"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "3"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "1"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "3"}], "]"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"36212a13-b2e7-6b49-9744-7ee6495a2710"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "It is a function, not a kind of object. In that it sits beside ZeroArray, \
OneArray and IdentityArray, which build their entries from a shape as this \
one builds them from a name; what comes back from any of them is an \
ArrayObject. Naming it Generate\[Hyphen]something says that plainly, at the \
cost of being the only one of the four that does."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"a8190211-e5ec-2440-a279-f3ad8548f594"],

Cell["\<\
Having been generated leaves no trace on the array, and its domain is read \
off its entries like anyone else's:\
\>", "Text",ExpressionUUID->"bb450a36-11ae-aa4e-b2b5-b6021b821ee2"],

Cell["\<\
sa = GenerateSymbolicArray[a, {2, 3}];
{Head[sa], ArrayDomain[sa], ArrayDomain[m]}\
\>", "Input",ExpressionUUID->"292890b7-ef44-dc49-8a0d-3271207890fb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"ArrayObject", ",", "\<\"Expression\"\>", ",", "\<\"Integer\"\>"}], 
  "}"}]], "Output",ExpressionUUID->"3c801139-5966-ca49-bd55-6744d72695ef"],

Cell["3. Index symmetries", "Section",ExpressionUUID->"749b4a8d-fb18-2b43-9353-4aa6c2842ec6"],

Cell["\<\
A regular array may declare an index symmetry: \"Rigid\" for no symmetry, \
which is the default, \"Cyclic\" for invariance under cyclic permutation of \
the indices, or \"Symmetric\" for invariance under all of them.\
\>", "Text",ExpressionUUID->"643d7013-92b3-5a49-b153-60500f34f461"],

Cell["On a symbolic array the symmetry is honoured by construction", \
"Subsection",ExpressionUUID->"23ee7d03-d787-0d42-9b68-720d53b7e31a"],

Cell["\<\
Index tuples that are equivalent under the symmetry name the same entry, so \
the generated array cannot fail to have the symmetry it claims:\
\>", "Text",ExpressionUUID->"2fb5a832-a607-1843-97fd-9879685568b3"],

Cell["Normal @ GenerateSymbolicArray[a, {3, 3}, \"Symmetric\"]", "Input",ExpressionUUID->"287e7d6d-a295-1d49-bfe5-9974d67f3c17"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "1"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "3"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "3"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "3"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "3"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"3", ",", "3"}], "]"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"2c6d4702-0a82-1949-98ad-7cb8dd080642"],

Cell["\<\
With[{e = Normal @ GenerateSymbolicArray[a, {3, 3}, \"Symmetric\"]}, e === \
Transpose[e]]\
\>", "Input",ExpressionUUID->"50934d96-3276-9546-a86d-0814d4dca538"],

Cell[BoxData["True"], "Output",ExpressionUUID->"6feb46d2-7846-7943-9419-b1022798dd84"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "This is the same device that puts the vertices of a hyperedge into the \
least order of their symmetry orbit. Here the entry at a tuple of indices is \
the name applied to the least tuple in its orbit, which is why a symmetric or \
cyclic symbolic array needs no checking."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"f76a852e-2b6e-064c-a0c0-3be826487023"],

Cell["\<\
The three symmetries really are three different things. Counting distinct \
entries of a 3\[Times]3\[Times]3 array shows it:\
\>", "Text",ExpressionUUID->"cedc2626-5599-7445-8357-bb583e8cab89"],

Cell["\<\
Length @ DeleteDuplicates @ Flatten @ Normal @ GenerateSymbolicArray[a, {3, \
3, 3}, #] & /@
  {\"Rigid\", \"Cyclic\", \"Symmetric\"}\
\>", "Input",ExpressionUUID->"e1b56b2c-1e81-734a-92e0-4671e07e335b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"27", ",", "11", ",", "10"}], "}"}]], "Output",ExpressionUUID->\
"5d862bc3-93a0-d241-979f-33e91e099e2f"],

Cell["\<\
At order two, though, the cyclic group on the indices is the whole symmetric \
group, so there \"Cyclic\" and \"Symmetric\" coincide exactly:\
\>", "Text",ExpressionUUID->"61a74ab0-f8b7-4b47-9a9b-b79cd9bc4bbb"],

Cell["\<\
Normal[GenerateSymbolicArray[a, {3, 3}, \"Cyclic\"]] === \
Normal[GenerateSymbolicArray[a, {3, 3}, \"Symmetric\"]]\
\>", "Input",ExpressionUUID->"b66615be-42f4-7b47-a1cd-907144e6929d"],

Cell[BoxData["True"], "Output",ExpressionUUID->"510c0fb7-bda0-cc4f-a409-619b3e1a9c56"],

Cell["A declared symmetry is verified", "Subsection",ExpressionUUID->"f8bc67e0-7247-7e42-a180-f603912faeb6"],

Cell["\<\
An array given its entries has them already, so a declared symmetry is a \
claim about them, and it is checked. These entries are symmetric:\
\>", "Text",ExpressionUUID->"6a319ed9-3297-fc4e-adfd-c53f3fc4b2b6"],

Cell["ArraySymmetry @ ArrayObject[{{1, 2}, {2, 1}}, \"Symmetric\"]", "Input",ExpressionUUID->"d2cc2116-a9ff-894e-bb65-100dd4636903"],

Cell[BoxData["\<\"Symmetric\"\>"], "Output",ExpressionUUID->"919164b1-734b-494d-9b7a-a6916411b41e"],

Cell["\<\
\[Ellipsis] and these are not, so the declaration is refused rather than the \
entries being quietly symmetrized:\
\>", "Text",ExpressionUUID->"a55e5d9a-fd71-6d46-af5c-f7833c00a472"],

Cell["Quiet @ ArrayObject[{{1, 2}, {3, 4}}, \"Symmetric\"]", "Input",ExpressionUUID->"7733a326-40ab-3e4b-a02a-3e6d4e610cfa"],

Cell[BoxData["$Failed"], "Output",ExpressionUUID->"56382f28-f0ec-a043-b892-5983ca4614f5"],

Cell["The same entries are perfectly good as a rigid array:", "Text",ExpressionUUID->"b79ac0c7-40be-fe4a-bc9e-b9b3b62bb3be"],

Cell["ArraySymmetry @ ArrayObject[{{1, 2}, {3, 4}}]", "Input",ExpressionUUID->"2dcbd343-e767-0c45-81df-ef3883002e0d"],

Cell[BoxData["\<\"Rigid\"\>"], "Output",ExpressionUUID->"42c428dc-90e6-ab4d-ac36-a2373095180a"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Refusing is the honest answer: symmetrizing would silently return an array \
with different entries from the ones given. The symmetry is a declared \
property and ArraySymmetry reports what was declared, in the same way that an \
edge's symmetry type is declared rather than detected."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"2a0f0613-73df-dd4e-86cf-789dbfff38a4"],

Cell["\<\
Cyclic and symmetric are genuinely distinguished. The indicator of the cyclic \
orbit of (1, 2, 3) is invariant under rotating the indices but not under \
swapping two of them:\
\>", "Text",ExpressionUUID->"2a4bd305-f74c-ca47-92fd-ef9d2707be3a"],

Cell["\<\
cyc = Array[If[MemberQ[{{1, 2, 3}, {2, 3, 1}, {3, 1, 2}}, {##}], 1, 0] &, {3, \
3, 3}];
{ArraySymmetry @ ArrayObject[cyc, \"Cyclic\"],
  Quiet @ ArrayObject[cyc, \"Symmetric\"]}\
\>", "Input",ExpressionUUID->"2ac75f9c-86d9-d548-9fda-cd0f71293b9e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Cyclic\"\>", ",", "$Failed"}], "}"}]], "Output",ExpressionUUID->\
"f044ab1a-94ce-d94f-9f8e-6e790ee0502e"],

Cell["\<\
A symmetry needs a regular array: permuting the indices of a 2\[Times]3 array \
would not give an array of the same shape, so the declaration is refused:\
\>", "Text",ExpressionUUID->"abd6da9a-a6e5-e34e-848d-999c1155d6ad"],

Cell["Quiet @ ArrayObject[{{1, 2, 3}, {4, 5, 6}}, \"Symmetric\"]", "Input",ExpressionUUID->"259bf57e-a85b-d44d-9f49-ea509b88b1a0"],

Cell[BoxData["$Failed"], "Output",ExpressionUUID->"fbc6415f-56fb-2143-aa5d-9fcc7fe01562"],

Cell["4. Hypermatrices", "Section",ExpressionUUID->"ba626a6c-30ec-284d-ade9-401887f07707"],

Cell["\<\
A hypermatrix is a list of arrays, held in a canonical order: lowest order \
first, then the shorter dimensions, then symmetry taking symmetric before \
cyclic before rigid. Here are six arrays given in no particular order:\
\>", "Text",ExpressionUUID->"72c27ece-095d-cc4d-8402-c1ef40dfad43"],

Cell["\<\
hm = Hypermatrix[{
   ArrayObject[Array[1 &, {2, 2, 2}], \"Symmetric\"],
   ArrayObject[{{1, 2}, {3, 4}}],
   ArrayObject[{1, 2}],
   ArrayObject[{1, 2, 3}],
   ArrayObject[{{1, 2}, {2, 1}}, \"Symmetric\"],
   ArrayObject[{{1, 2}, {2, 1}}, \"Cyclic\"]}]\
\>", "Input",ExpressionUUID->"7a430b02-5361-f044-8014-e3f82efa8b74"],

