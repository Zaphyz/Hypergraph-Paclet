       FontColor->Hue[0.63, 0.7, 0.5]], {0.8400000000000001, 0.06, 0.06}]}, 
    {Hue[0.63, 0.7, 0.5], 
     Arrow3DBox[TubeBox[{{0.06, 0.06, 0.06}, {0.06, 0.6100000000000001, 
      0.06}}, 0.02]], Text3DBox[
      StyleBox["\<\"j\"\>",
       StripOnInput->False,
       LineColor->Hue[0.63, 0.7, 0.5],
       FrontFaceColor->Hue[0.63, 0.7, 0.5],
       BackFaceColor->Hue[0.63, 0.7, 0.5],
       GraphicsColor->Hue[0.63, 0.7, 0.5],
       FontSize->11,
       FontSlant->Italic,
       FontColor->Hue[0.63, 0.7, 0.5]], {0.06, 0.8400000000000001, 0.06}]}, 
    {Hue[0.63, 0.7, 0.5], 
     Arrow3DBox[TubeBox[{{0.06, 0.06, 0.06}, {0.06, 0.06, 
      0.6100000000000001}}, 0.02]], Text3DBox[
      StyleBox["\<\"k\"\>",
       StripOnInput->False,
       LineColor->Hue[0.63, 0.7, 0.5],
       FrontFaceColor->Hue[0.63, 0.7, 0.5],
       BackFaceColor->Hue[0.63, 0.7, 0.5],
       GraphicsColor->Hue[0.63, 0.7, 0.5],
       FontSize->11,
       FontSlant->Italic,
       FontColor->Hue[0.63, 0.7, 0.5]], {0.06, 0.06, 0.8400000000000001}]}}},
  Background->GrayLevel[1],
  Boxed->False,
  FormatType->StandardForm,
  ImageSize->162,
  Lighting->"Neutral",
  PlotRange->{{0, 3.7}, {0, 3.7}, {0, 3.7}},
  PlotRangePadding->Scaled[0.02]]], "Output",ExpressionUUID->"393d2565-a4b5-\
c94f-ab04-83f55b4ce41c"],

Cell["Multiplicities", "Subsection",ExpressionUUID->"e9868527-199c-a34e-85b9-62211202bcfe"],

Cell["\<\
A hypergraph is a multiset of edges, and identical copies of an edge all want \
the same entry. They get it, and the entry counts them:\
\>", "Text",ExpressionUUID->"9fd5dedc-a757-2b45-8cb8-e0bf6e1d5629"],

Cell["\<\
Normal @ First @ HypermatrixArrays @ AdjacencyHypermatrix @
  Hypergraph[{Edge[{1, 2}], Edge[{1, 2}], Edge[{2, 1}]}]\
\>", "Input",ExpressionUUID->"8927e2e4-4577-8f44-9ad7-206fab649392"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "0"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"c980c951-2d3e-9246-afb4-4f977edc0a9f"],

Cell["\<\
That holds at every symmetry type, over the whole orbit each time. Three \
copies of an unordered edge put a 3 at each of its six permutations; two \
copies of a cyclic one put a 2 at each of its three rotations:\
\>", "Text",ExpressionUUID->"c3a3707c-6263-c14d-aa09-7396bc2be31d"],

Cell["\<\
{Union @ Cases[Normal @ First @ HypermatrixArrays @ AdjacencyHypermatrix @
      Hypergraph[Table[Edge[{1, 2, 3}, \"Unordered\"], 3]], _?Positive, \
Infinity],
  Union @ Cases[Normal @ First @ HypermatrixArrays @ AdjacencyHypermatrix @
      Hypergraph[Table[Edge[{1, 2, 3}, \"Cyclic\"], 2]], _?Positive, \
Infinity]}\
\>", "Input",ExpressionUUID->"dfd0e0e9-09c3-334e-baaf-bbfffb140ff6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "3", "}"}], ",", 
   RowBox[{"{", "2", "}"}]}], "}"}]], "Output",ExpressionUUID->"f754e395-a079-\
6f4e-9bda-04161e86528d"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Edges are stored with their vertices in the canonical order of their \
symmetry type, so two spellings of one unordered edge are one edge written \
twice, not two edges. The entry is 2, as it should be."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"d04c5d1f-d31d-704e-92ea-8fa809936495"],

Cell["\<\
Normal @ First @ HypermatrixArrays @ AdjacencyHypermatrix @
  Hypergraph[{Edge[{1, 2}, \"Unordered\"], Edge[{2, 1}, \"Unordered\"]}]\
\>", "Input",ExpressionUUID->"ec0f6866-781e-c14d-9847-716632af32aa"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "0"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"ee29a34a-1a8b-5741-ab76-7b6c2f80b009"],

Cell["Labels as entries", "Subsection",ExpressionUUID->"811187c0-e5c0-7846-b39d-3522314d43bc"],

Cell["\<\
If the edges carry labels, those labels can be the entries instead of the \
counts. With \"Labeled\" -> True the entry at a position is the label of the \
edge that sits there, and 0 where no edge does:\
\>", "Text",ExpressionUUID->"d0279b5e-b0ae-fa48-9c2a-fab55402661b"],

Cell["\<\
hLab = Hypergraph[{Edge[{1, 2}, \"Directed\", \"a\"], Edge[{2, 3}, \"Directed\
\", \"b\"],
                   Edge[{1, 2, 3}, \"Unordered\", \"c\"]}];
Normal @ First @ HypermatrixArrays @ AdjacencyHypermatrix[hLab, \"Labeled\" \
-> True]\
\>", "Input",ExpressionUUID->"8d04b309-de43-0c4a-8928-0efc2636daec"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "\<\"a\"\>", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "\<\"b\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "}"}]], "Output",ExpressionUUI\
D->"722a892d-38e0-d544-9ff7-ef4f9a4840aa"],

Cell["\<\
A label fills the whole orbit of its edge, exactly as a count does, so the \
arrays carry their symmetries just the same. The unordered edge labelled c \
appears at all six permutations of its vertices:\
\>", "Text",ExpressionUUID->"f0a062a5-0916-944c-ba04-5676b351dc2d"],

Cell["\<\
{Length @ Position[Normal @ Last @ HypermatrixArrays @
      AdjacencyHypermatrix[hLab, \"Labeled\" -> True], \"c\"],
  ArraySymmetry @ Last @ HypermatrixArrays @ AdjacencyHypermatrix[hLab, \
\"Labeled\" -> True]}\
\>", "Input",ExpressionUUID->"8ca2e5cc-5d96-414f-ad27-2602adb027ad"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"6", ",", "\<\"Symmetric\"\>"}], "}"}]], "Output",ExpressionUUID->\
"91115074-5c5f-344c-aa74-a3950263a452"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "The value domain of such an array is \"Label\". It is the one domain that \
is never inferred: its test admits anything at all, so were it in the list \
that inference walks, every array whose entries fitted nothing else would \
quietly become an array of labels. It has to be asked for, which is what \
\"Labeled\" -> True does."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"9c902ae0-8108-0b4f-a236-0eb4a345ffe1"],

Cell["\<\
{AdjacencyHypermatrix[hLab][\"Domains\"],
  AdjacencyHypermatrix[hLab, \"Labeled\" -> True][\"Domains\"]}\
\>", "Input",ExpressionUUID->"daaa08cd-7c4d-a349-a1f8-3cdc15986f45"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\<\"Integer\"\>", ",", "\<\"Integer\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"Expression\"\>", ",", "\<\"Expression\"\>"}], "}"}]}], 
  "}"}]], "Output",ExpressionUUID->"79460272-6585-1144-9b88-072d226fa235"],

Cell["\<\
Counting remains what happens by default, so nothing changes for a hypergraph \
whose labels are beside the point:\
\>", "Text",ExpressionUUID->"1d631a2c-0a0b-e740-ab8a-7d7bbcb7cd9e"],

Cell["\<\
AdjacencyHypermatrix[hLab] === AdjacencyHypermatrix[hLab, \"Labeled\" -> \
False]\
\>", "Input",ExpressionUUID->"a8d71204-e1f4-1846-884f-14e17e694d41"],

Cell[BoxData["True"], "Output",ExpressionUUID->"dad57714-1865-104e-9783-1c81a754673d"],

Cell["Why labels need a simple hypergraph", "Subsection",ExpressionUUID->"27c11c3c-24cd-0944-9a30-30bc787f4400"],

Cell["\<\
An entry can hold a count of any size, but it cannot hold two labels. So \
labels can only be the entries when no two edges want the same one \
\[LongDash] which is exactly what it means for the hypergraph to be simple. \
SimpleHypergraphQ tests for it:\
\>", "Text",ExpressionUUID->"8ebcb572-8fc0-a34f-a814-a86af184d6ec"],

Cell["\<\
{SimpleHypergraphQ[hLab],
  SimpleHypergraphQ @ Hypergraph[{Edge[{1, 2}, \"Directed\", \"a\"],
                                  Edge[{1, 2}, \"Directed\", \"b\"]}]}\
\>", "Input",ExpressionUUID->"dbc9996a-7675-a54e-8852-58429a21e64c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",ExpressionUUID->"f2794e07-\
21c6-b847-bd6f-0a0639e1acd8"],

Cell["\<\
The second is two edges in one place. Counting them is no trouble; labelling \
them is refused:\
\>", "Text",ExpressionUUID->"a8c13cb8-6d0b-bd49-8e91-6cca804d2da1"],

Cell["\<\
Quiet @ AdjacencyHypermatrix[
  Hypergraph[{Edge[{1, 2}, \"Directed\", \"a\"], Edge[{1, 2}, \"Directed\", \
\"b\"]}],
  \"Labeled\" -> True]\
\>", "Input",ExpressionUUID->"8ea2a4e5-5b0d-8247-ab9a-69e44a67f3ce"],

Cell[BoxData["$Failed"], "Output",ExpressionUUID->"2d687e46-c7a0-ba4c-b018-d71f415932f5"],

Cell["\<\
Normal @ First @ HypermatrixArrays @ AdjacencyHypermatrix @
  Hypergraph[{Edge[{1, 2}, \"Directed\", \"a\"], Edge[{1, 2}, \"Directed\", \
\"b\"]}]\
\>", "Input",ExpressionUUID->"3686232e-c207-784b-bec5-cbc4d78b02dd"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"ae67c735-38a6-e64b-9691-1ccfd9854c8a"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Simplicity is tested on the skeleton, which is the right place: two edges \
differing only by a label are the same edge of the same skeleton, and it is \
their sharing a position that matters, not their having different labels. A \
vertex repeated within one edge, by contrast, is allowed \[LongDash] that is \
a property of one edge rather than a collision between two, and it obstructs \
nothing."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"5af065c6-9feb-704c-a526-5351e9d1b1ac"],

Cell["\<\
{SimpleHypergraphQ @ Hypergraph[{Edge[{1, 1, 2}, \"Unordered\"]}],
  Union @ Flatten @ Normal @ First @ HypermatrixArrays @ \
AdjacencyHypermatrix[
     Hypergraph[{Edge[{1, 1, 2}, \"Unordered\", \"r\"]}], \"Labeled\" -> \
True]}\
\>", "Input",ExpressionUUID->"42dae91c-778f-ca46-9f50-442ce6495186"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "\<\"r\"\>"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"c043dc5b-0731-c841-aa0d-429357fb54b8"],

Cell["\<\
Edges of one arity but different symmetry types go to different arrays, so \
they never collide and a hypergraph holding both is simple:\
\>", "Text",ExpressionUUID->"4cd2c11e-205f-114f-9918-0af69b63e9ea"],

Cell["\<\
AdjacencyHypermatrix[
  Hypergraph[{Edge[{1, 2}, \"Directed\", \"d\"], Edge[{1, 2}, \"Unordered\", \
\"u\"]}],
  \"Labeled\" -> True][\"Symmetries\"]\
\>", "Input",ExpressionUUID->"dd0899e6-b624-6141-a8c9-0d751140e598"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Symmetric\"\>", ",", "\<\"Rigid\"\>"}], "}"}]], "Output",Expres\
sionUUID->"51691845-aca8-4842-88a2-be9060558978"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Vertex labels have no slot here. An entry of an adjacency array answers to \
an edge, so edge labels are what can go in it; the vertices are the indices \
rather than the entries, and their labels stay in VertexList. An edge \
carrying no label of its own gives None, which is not the same as the 0 that \
means no edge at all."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"8fff46f6-021d-d441-9526-73e71c9d1af4"],

Cell["\<\
Normal @ First @ HypermatrixArrays @ AdjacencyHypermatrix[
  Hypergraph[{Edge[{1, 2}, \"Directed\", \"a\"], Edge[{2, 1}, \
\"Directed\"]}], \"Labeled\" -> True]\
\>", "Input",ExpressionUUID->"31a5afd8-d521-9044-83c9-38855be90a49"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "\<\"a\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"None", ",", "0"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"a5106000-2f58-e34a-981d-d810e903b718"],

Cell["Which order do the indices run in?", "Subsection",ExpressionUUID->"720a9cc1-cbe0-4241-bab8-2c9e02dee84b"],

Cell["\<\
The vertices of a hypergraph are a set. They have no order of their own, and \
yet the indices of an array are numbered one to n. Something must be \
choosing, and it is worth being clear about what.\
\>", "Text",ExpressionUUID->"640ad7e0-78b6-8b47-b53e-d97a7c92e544"],

Cell["\<\
The choice is made by the Hypergraph constructor, not by \
AdjacencyHypermatrix. A hypergraph is stored with its vertices sorted, so the \
order is a property of the object rather than of how it was typed. Giving the \
same edges in a different order changes nothing:\
\>", "Text",ExpressionUUID->"701752aa-5a45-a747-afb5-0447ed4c8350"],

Cell["\<\
hOrdA = Hypergraph[{Edge[{3, 1}], Edge[{2, 3}]}];
hOrdB = Hypergraph[{Edge[{2, 3}], Edge[{3, 1}]}];
{VertexID /@ VertexList[hOrdA], hOrdA === hOrdB,
  AdjacencyHypermatrix[hOrdA] === AdjacencyHypermatrix[hOrdB]}\
\>", "Input",ExpressionUUID->"93ef671b-9392-3449-8e9b-804b4bbfe087"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",", "True", ",", "True"}], 
  "}"}]], "Output",ExpressionUUID->"0d430738-420b-5946-814e-44d44d521256"],

Cell["\<\
So far so good. But the sort is on the vertex identifiers, and identifiers \
are whatever the user chose them to be. Here are two isomorphic hypergraphs \
\[LongDash] the same path on three vertices \[LongDash] whose vertices are \
named differently:\
\>", "Text",ExpressionUUID->"8238b08f-8325-dd4d-9d60-8098a29690b8"],

Cell["\<\
hNum = Hypergraph[{Edge[{1, 2}], Edge[{2, 3}]}];
hStr = Hypergraph[{Edge[{\"z\", \"a\"}], Edge[{\"a\", \"m\"}]}];
{IsomorphicHypergraphQ[hNum, hStr],
  VertexID /@ VertexList[hNum], VertexID /@ VertexList[hStr]}\
\>", "Input",ExpressionUUID->"807819df-3829-b24c-a50a-d2094e8c1eed"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"a\"\>", ",", "\<\"m\"\>", ",", "\<\"z\"\>"}], "}"}]}], 
  "}"}]], "Output",ExpressionUUID->"7d558b67-9c29-0744-a23d-8eb044a4df04"],

Cell["\<\
Sorting puts a before m before z, so the vertex called z \[LongDash] the \
start of the path \[LongDash] ends up third. The two adjacency matrices are \
not equal:\
\>", "Text",ExpressionUUID->"ecb3061e-b3a1-9443-95bf-e0526e7f17fa"],

Cell["\<\
mNum = Normal @ First @ HypermatrixArrays @ AdjacencyHypermatrix[hNum];
mStr = Normal @ First @ HypermatrixArrays @ AdjacencyHypermatrix[hStr];
{MatrixForm[mNum], MatrixForm[mStr], mNum === mStr}\
\>", "Input",ExpressionUUID->"ea17019f-b555-7348-9dac-4f3186bf2f09"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   TagBox[
    RowBox[{"(", "\[NoBreak]", GridBox[{
       {"0", "1", "0"},
       {"0", "0", "1"},
       {"0", "0", "0"}
      },
      GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
      GridBoxSpacings->{"Columns" -> {
          Offset[0.27999999999999997`], {
           Offset[0.7]}, 
          Offset[0.27999999999999997`]}, "Rows" -> {
          Offset[0.2], {
           Offset[0.4]}, 
          Offset[0.2]}}], "\[NoBreak]", ")"}],
    Function[BoxForm`e$, 
     MatrixForm[BoxForm`e$]]], ",", 
   TagBox[
    RowBox[{"(", "\[NoBreak]", GridBox[{
       {"0", "1", "0"},
       {"0", "0", "0"},
       {"1", "0", "0"}
      },
      GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
      GridBoxSpacings->{"Columns" -> {
          Offset[0.27999999999999997`], {
           Offset[0.7]}, 
          Offset[0.27999999999999997`]}, "Rows" -> {
          Offset[0.2], {
           Offset[0.4]}, 
          Offset[0.2]}}], "\[NoBreak]", ")"}],
    Function[BoxForm`e$, 
     MatrixForm[BoxForm`e$]]], ",", "False"}], "}"}]], "Output",ExpressionUUID\
->"c00fe1ec-df5d-1843-aa4a-e648cb9d3d0c"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "This is the honest answer to the question: there is a choice, and renaming \
the vertices can change the hypermatrix. What the sort buys is not that the \
choice goes away but that it is made the same way every time. \
AdjacencyHypermatrix is a function of the hypergraph it is given, with \
nothing arbitrary left in it; what it is not is a function of the isomorphism \
class."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"2163bc9d-4c6c-db42-8579-9815def0c160"],

Cell["\<\
The two matrices are of course related, by the permutation the renaming \
induces on the indices. Old vertex 1 is called z, which sorts third; 2 is \
called a, which sorts first; 3 is called m, which sorts second:\
\>", "Text",ExpressionUUID->"c75a4c0d-e472-524c-8abe-5e5fa03047e4"],

Cell["\<\
perm = {3, 1, 2};
mNum[[InversePermutation[perm], InversePermutation[perm]]] === mStr\
\>", "Input",ExpressionUUID->"1c9f28d2-c031-dd42-8c86-7e70575b0655"],

Cell[BoxData["True"], "Output",ExpressionUUID->"fc5712d8-a4e6-4f43-a5e9-9f0e7986ba64"],

Cell["\<\
The same permutation, applied in every index slot at once, relates the \
higher-order arrays too. Simultaneous, because one vertex set is being \
renumbered, not three:\
\>", "Text",ExpressionUUID->"3fcdab51-7370-174b-b66b-e3a1d567771c"],

Cell["\<\
gNum = Hypergraph[{Edge[{1, 2, 3}, \"Unordered\"], Edge[{1, 1, 2}, \
\"Unordered\"]}];
gStr = Hypergraph[{Edge[{\"z\", \"a\", \"m\"}, \"Unordered\"], Edge[{\"z\", \
\"z\", \"a\"}, \"Unordered\"]}];
aNum = Normal @ First @ HypermatrixArrays @ AdjacencyHypermatrix[gNum];
aStr = Normal @ First @ HypermatrixArrays @ AdjacencyHypermatrix[gStr];
{aNum === aStr,
 With[{q = InversePermutation[perm]}, aNum[[q, q, q]] === aStr]}\
\>", "Input",ExpressionUUID->"ceb5a67f-a436-6945-bea6-bde52ae6e7ee"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "True"}], "}"}]], "Output",ExpressionUUID->"e3c92135-\
61b6-0c4d-8867-c7e68ccb4d25"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Mathematically this is the usual state of affairs: an adjacency array is \
attached to a hypergraph together with a numbering of its vertices, and as an \
invariant of the isomorphism class it is defined only up to simultaneous \
permutation of its indices. Nothing here is a defect of the implementation \
\[LongDash] it is what the object is."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"3773941d-abb6-d347-a9ce-112703449425"],

Cell["\<\
If what is wanted is an invariant, the package already has the missing half. \
CanonicalHypergraph picks a representative of the isomorphism class, \
relabelling the vertices one to n; composing the two gives a hypermatrix that \
depends on the isomorphism class alone:\
\>", "Text",ExpressionUUID->"96b1512c-a5db-384a-acdb-b6c4b7b422c1"],

Cell["\<\
{VertexID /@ VertexList @ CanonicalHypergraph[hNum],
  VertexID /@ VertexList @ CanonicalHypergraph[hStr],
  CanonicalHypergraph[hNum] === CanonicalHypergraph[hStr]}\
\>", "Input",ExpressionUUID->"33a85716-86df-6d4c-8a93-75df8d19faca"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",", "True"}], "}"}]], "Output",\
ExpressionUUID->"207e0b26-d54e-ef4f-823a-eea635043994"],

Cell["\<\
AdjacencyHypermatrix[CanonicalHypergraph[hNum]] ===
  AdjacencyHypermatrix[CanonicalHypergraph[hStr]]\
\>", "Input",ExpressionUUID->"80623ba0-199d-2b47-942f-60268c27d735"],

Cell[BoxData["True"], "Output",ExpressionUUID->"129bf629-0c27-cf42-b4eb-5f2e22071051"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "So there are two functions here, and it is worth knowing which one is \
wanted. AdjacencyHypermatrix[hg] is the adjacency of the hypergraph as it \
stands, with its own vertex names, and is the one to use when those names \
mean something. AdjacencyHypermatrix[ CanonicalHypergraph[hg]] is the \
adjacency of its isomorphism class, and is the one to use when they do not. \
The second is not offered as a separate function because it is already a \
composition of two, and naming it would only hide which of the two was \
meant."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"f2519683-7f2f-4a4c-a683-3c4d7219436d"],

Cell["11. Scope and limits", "Section",ExpressionUUID->"776c1a38-ebbe-6540-86d0-b14c05295bc1"],

Cell["\<\
A scalar is the array of order zero: no indices, no dimensions, one entry. \
That is what a full contraction leaves behind and what multiplies an array \
entry by entry, so the alternative \[LongDash] treating a plain value as \
something other than an array \[LongDash] would have needed a separate rule \
at each of those places.\
\>", "Text",ExpressionUUID->"f7a56022-42f8-1d46-984c-f7e8e14a7dbf"],

Cell["\<\
Only the three symmetries named in the plan are recognized: rigid, cyclic and \
symmetric. Arbitrary index symmetry groups, and antisymmetry with its sign, \
are not implemented.\
\>", "Text",ExpressionUUID->"dd72c19c-93d6-aa46-ad24-04bbc0f01703"],

Cell["\<\
A declared symmetry is checked by testing invariance under a generating set \
of the group, one transposition and one rotation, rather than under every \
permutation. That is enough, and it keeps the check cheap for arrays of high \
order.\
\>", "Text",ExpressionUUID->"004c2fd7-025d-1a43-a840-e7c934167749"],

Cell["\<\
The file tests/HypermatrixExamples.wls runs the examples in this notebook as \
assertions, plus 1300 randomized checks: that order, dimensions and \
regularity always agree with the entries; that a symmetrized array is always \
accepted as symmetric and a cyclically symmetrized one as cyclic; that the \
canonical order of a hypermatrix never depends on the order its arrays were \
given in; and that the result really is sorted by the three stated criteria.\
\>", "Text",ExpressionUUID->"484630bd-3839-e949-95f2-bfc1d36b360d"],

Cell["\<\
The file tests/ArrayAlgebraExamples.wls does the same for the special arrays, \
ArrayMultiply, the entry-by-entry operations and FindArrayEquations, checking \
the contraction against Dot, Tr, Diagonal, Transpose and Outer, and \
confirming that every equation reported really holds on arrays the search \
never saw.\
\>", "Text",ExpressionUUID->"bb5a5c1c-8a93-ae44-b6cb-80e8908d67a8"],

Cell["Next: the graphical rendering of 1-, 2- and 3-arrays.", "Text",ExpressionUUID->"95bc57da-7990-fc45-ab91-0aff1fa7bc8a"]
},
