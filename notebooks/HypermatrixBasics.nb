Cell["\<\
At order three, the full lattice. The entry at (i, j, k) sits at the point \
{i, j, k}, and a gnomon in the near corner says which way the three indices \
run:\
\>", "Text",ExpressionUUID->"8f8788a6-36e4-3f42-ab18-799e74548405"],

Cell["ArrayGraphics3D[Array[#1 + #2 + #3 &, {3, 3, 3}]]", "Input",ExpressionUUID->"dceaa510-24d1-ed48-8f0c-d181ea1549ef"],

