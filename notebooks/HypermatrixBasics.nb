Cell["\<\
At order three, the full lattice. The entry at (i, j, k) sits at the point \
{i, j, k}, and a gnomon in the near corner says which way the three indices \
run:\
\>", "Text",ExpressionUUID->"b07d2528-62f4-b742-93d7-0747664e77ce"],

Cell["ArrayGraphics3D[Array[#1 + #2 + #3 &, {3, 3, 3}]]", "Input",ExpressionUUID->"9c08897c-49e9-9543-95b6-9426b486c8dd"],

