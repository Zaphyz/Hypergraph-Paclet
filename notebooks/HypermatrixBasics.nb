Cell["\<\
The specification may equally be given as a rule between lists of index \
labels:\
\>", "Text",ExpressionUUID->"7f55ac64-a7c1-fb4e-a89a-78a260304e04"],

Cell["\<\
{Normal @ ArrayMultiply[{a, b}, \"ij,jk->ik\"],
  Normal @ ArrayMultiply[{a, b}, {{1, 2}, {2, 3}} -> {1, 3}]}\
\>", "Input",ExpressionUUID->"f374dbb2-64cf-8544-a89a-9a02e28a98ee"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"4", ",", "3"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"4", ",", "3"}], "}"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"5df6b241-c5ea-e24e-9b65-ddf017375be3"],

Cell["\<\
Repeating an index within one array takes a diagonal, and leaving it out of \
the output sums it, so a trace and a transpose are contractions too:\
\>", "Text",ExpressionUUID->"211f697c-9f44-0943-bc75-bd74af390b57"],

Cell["\<\
{Normal @ ArrayMultiply[{a}, \"ii->i\"], Normal @ ArrayMultiply[{a}, \"ii->\"],
  Normal @ ArrayMultiply[{a}, \"ij->ji\"]}\
\>", "Input",ExpressionUUID->"7856dc3e-aa5e-4842-b97b-c47f95f478ec"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "4"}], "}"}], ",", "5", ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "4"}], "}"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"3b9f00d1-a5a8-ce4b-ac30-5fc40e0ea0fc"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "An index may occur in any number of the arrays at once, and may occur in \
the output as well as in the inputs. That is what lets a single specification \
express the three-way contractions of the ternary products, which no sequence \
of pairwise contractions would give."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"cdd390c2-27e3-3149-9836-9eb9f1190b94"],

Cell["\<\
The Bhattacharya-Mesner product of three 3-arrays joins all three on one \
index:\
\>", "Text",ExpressionUUID->"5e374215-6285-6e45-8cc0-ada12f41172a"],

Cell["\<\
x = Array[#1 + #2 + #3 &, {2, 2, 2}];
Normal @ ArrayMultiply[{x, x, x}, \"ijp,ipk,pjk->ijk\"]\
\>", "Input",ExpressionUUID->"4b77cfc3-27ef-2445-93ef-8ae0c142ec86"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"91", ",", "148"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"148", ",", "230"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"148", ",", "230"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"230", ",", "341"}], "}"}]}], "}"}]}], "}"}]], "Output",Expressi\
onUUID->"536432bc-09a7-fd47-b8da-20414b0f7dcb"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "The result comes back as an array object, whatever the entries turned out \
to be. Contracting every index away leaves a single entry, which is the array \
of order zero, and Normal of that gives the scalar itself. There is nothing \
here to decide: an array of arbitrary expressions is an array like any other, \
which is the whole point of there being one array object."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"ddde23c6-6864-024f-974d-d1acf6a3e158"],

Cell["\<\
The other side of the same coin: an array of order zero is named in a \
specification by an empty group of index labels, which is how a scalar enters \
a contraction.\
\>", "Text",ExpressionUUID->"f11e321c-b7bb-c44b-8485-3f06333d2f61"],

Cell["Normal @ ArrayMultiply[{3, a}, \",ij->ij\"]", "Input",ExpressionUUID->"9c67bc07-06e4-b540-b23a-af1c05df1e1f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"3", ",", "6"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"9", ",", "12"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"767bb737-24ef-fb4c-99dc-dd921f118cf8"],

Cell["Numerical and symbolic arrays", "Subsection",ExpressionUUID->"9844b186-475e-794e-bd02-8c50ccea58da"],

Cell["\<\
A symbolic array is a list of lists of terms with explicit indices, and a \
contraction of symbolic arrays simply builds the corresponding expressions in \
a list of lists. The symbols behave as Wolfram Language symbols always do, \
which is to say as complex variables:\
\>", "Text",ExpressionUUID->"d58edb10-dea1-ff4a-b92e-12e1f082da2c"],

Cell["\<\
sa = Normal @ GenerateSymbolicArray[p, {2, 2}];
sb = Normal @ GenerateSymbolicArray[q, {2, 2}];
{sa, sb}\
\>", "Input",ExpressionUUID->"25ed7c6d-90f0-bf45-b03d-5b03820b6eb7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"p", "[", 
        RowBox[{"1", ",", "1"}], "]"}], ",", 
       RowBox[{"p", "[", 
        RowBox[{"1", ",", "2"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"p", "[", 
        RowBox[{"2", ",", "1"}], "]"}], ",", 
       RowBox[{"p", "[", 
        RowBox[{"2", ",", "2"}], "]"}]}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"q", "[", 
        RowBox[{"1", ",", "1"}], "]"}], ",", 
       RowBox[{"q", "[", 
        RowBox[{"1", ",", "2"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"q", "[", 
        RowBox[{"2", ",", "1"}], "]"}], ",", 
       RowBox[{"q", "[", 
        RowBox[{"2", ",", "2"}], "]"}]}], "}"}]}], "}"}]}], "}"}]], "Output",E\
xpressionUUID->"b088c10b-cae3-b54d-aec2-dbcd9af88374"],

Cell["ArrayMultiply[{sa, sb}, \"ij,jk->ik\"]", "Input",ExpressionUUID->"27f26882-3c50-eb4a-94b1-8bef6204893b"],

