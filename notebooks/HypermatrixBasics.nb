Cell["\<\
The specification may equally be given as a rule between lists of index \
labels:\
\>", "Text",ExpressionUUID->"0c5222c5-05b5-0a49-82e9-36b924cb29c0"],

Cell["\<\
{Normal @ ArrayMultiply[{a, b}, \"ij,jk->ik\"],
  Normal @ ArrayMultiply[{a, b}, {{1, 2}, {2, 3}} -> {1, 3}]}\
\>", "Input",ExpressionUUID->"f5c54159-343d-2a47-9269-7f9a57f7e571"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"4", ",", "3"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"4", ",", "3"}], "}"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"3fed315f-9f6e-c948-af41-b26470876b2a"],

Cell["\<\
Repeating an index within one array takes a diagonal, and leaving it out of \
the output sums it, so a trace and a transpose are contractions too:\
\>", "Text",ExpressionUUID->"b2368dee-d663-834c-a7b3-7cb5c4da6dd5"],

Cell["\<\
{Normal @ ArrayMultiply[{a}, \"ii->i\"], Normal @ ArrayMultiply[{a}, \"ii->\"],
  Normal @ ArrayMultiply[{a}, \"ij->ji\"]}\
\>", "Input",ExpressionUUID->"af21bf40-1356-fd40-bc2d-bcd07f6c1019"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "4"}], "}"}], ",", "5", ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "4"}], "}"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"893cd81a-3760-0b47-ad15-5ae926160683"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "An index may occur in any number of the arrays at once, and may occur in \
the output as well as in the inputs. That is what lets a single specification \
express the three-way contractions of the ternary products, which no sequence \
of pairwise contractions would give."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"4bfe495a-337d-5345-80b8-1a3388f7348c"],

Cell["\<\
The Bhattacharya-Mesner product of three 3-arrays joins all three on one \
index:\
\>", "Text",ExpressionUUID->"44daaae4-5d78-5547-bdab-da5f6558bc4a"],

Cell["\<\
x = Array[#1 + #2 + #3 &, {2, 2, 2}];
Normal @ ArrayMultiply[{x, x, x}, \"ijp,ipk,pjk->ijk\"]\
\>", "Input",ExpressionUUID->"f9e407c8-e202-9344-8322-ca73ff097a13"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"91", ",", "148"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"148", ",", "230"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"148", ",", "230"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"230", ",", "341"}], "}"}]}], "}"}]}], "}"}]], "Output",Expressi\
onUUID->"ecefb186-a60f-6243-9c36-e915e89c8377"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "The result comes back as an array object, whatever the entries turned out \
to be. Contracting every index away leaves a single entry, which is the array \
of order zero, and Normal of that gives the scalar itself. There is nothing \
here to decide: an array of arbitrary expressions is an array like any other, \
which is the whole point of there being one array object."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"2e4e2cf6-974b-8943-b639-c78b371507b8"],

Cell["\<\
The other side of the same coin: an array of order zero is named in a \
specification by an empty group of index labels, which is how a scalar enters \
a contraction.\
\>", "Text",ExpressionUUID->"ad919abb-7e41-d942-b87f-2b56c5d05a8e"],

Cell["Normal @ ArrayMultiply[{3, a}, \",ij->ij\"]", "Input",ExpressionUUID->"797eb9c2-cc06-084e-9e00-01080042a3ce"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"3", ",", "6"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"9", ",", "12"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"699d39e2-1981-e54c-b40c-e6417e2668c9"],

Cell["Numerical and symbolic arrays", "Subsection",ExpressionUUID->"4251af80-038d-7f4f-bad0-360b7cfb50ae"],

Cell["\<\
A symbolic array is a list of lists of terms with explicit indices, and a \
contraction of symbolic arrays simply builds the corresponding expressions in \
a list of lists. The symbols behave as Wolfram Language symbols always do, \
which is to say as complex variables:\
\>", "Text",ExpressionUUID->"a8a89293-1f5f-0b4f-b8a7-b5b1014424f3"],

Cell["\<\
sa = Normal @ GenerateSymbolicArray[p, {2, 2}];
sb = Normal @ GenerateSymbolicArray[q, {2, 2}];
{sa, sb}\
\>", "Input",ExpressionUUID->"02d16233-3f56-414f-95ba-26644bdcabf8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"p", "[", 
        RowBox[{"1", ",", "1"}], "]"}], ",", 
       RowBox[{"p", "[", 
        RowBox[{"1", ",", "2"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"p", "[", 
        RowBox[{"2", ",", "1"}], "]"}], ",", 
       RowBox[{"p", "[", 
        RowBox[{"2", ",", "2"}], "]"}]}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"q", "[", 
        RowBox[{"1", ",", "1"}], "]"}], ",", 
       RowBox[{"q", "[", 
        RowBox[{"1", ",", "2"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"q", "[", 
        RowBox[{"2", ",", "1"}], "]"}], ",", 
       RowBox[{"q", "[", 
        RowBox[{"2", ",", "2"}], "]"}]}], "}"}]}], "}"}]}], "}"}]], "Output",E\
xpressionUUID->"2bc70275-f09a-1a44-bda4-6c7592e151b4"],

Cell["ArrayMultiply[{sa, sb}, \"ij,jk->ik\"]", "Input",ExpressionUUID->"1242c3ff-4525-e549-8c0c-f7c3ccc7a633"],

