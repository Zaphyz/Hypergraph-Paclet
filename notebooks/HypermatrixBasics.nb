Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Everything ends up in one picture, which is the point: a tiled lattice can \
be turned and looked at as a single object, where a grid of separate 3D panes \
could not be. The spatial default takes blocks of three with any remainder \
off the front \[LongDash] ArrayNesting[n, 3] \[LongDash] and a block of four \
is refused, space holding only three indices at a time."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"99d7abe6-dc51-5f48-9ae2-e47547a9ae02"],

Cell["Table[ArrayNesting[n, 3], {n, 0, 8}]", "Input",ExpressionUUID->"0d0bac89-a4fc-cc42-9486-9806809abb22"],

