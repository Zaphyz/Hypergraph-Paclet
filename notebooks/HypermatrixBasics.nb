}, Open  ]],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "\"Boolean\" means the entries are True and False. Entries 0 and 1 are \
integers, and the two element field is FiniteField[2, 1] \[LongDash] three \
different things that all get called boolean in casual use, kept apart here. \
The set of domains is a single table in the source, so adding one is a line."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"1ef1fd10-ea89-f542-beed-5222e9564e0f"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. Symbolic arrays", "Section",ExpressionUUID->"ec38d494-5851-eb4e-b4df-ef8c9181e72d"],

Cell["\<\
A symbolic array is a different object. It carries no entries at all, only a \
name and the dimensions; the entries are generated from the name and the \
indices when they are asked for:\
\>", "Text",ExpressionUUID->"fd78d348-dcda-9d46-905e-159d6a753b15"],

Cell[CellGroupData[{

Cell["SymbolicArray[a, {2, 3}]", "Input",ExpressionUUID->"17dc6b3c-9f7e-3241-99d8-420de000113e"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   TagBox["SymbolicArray",
    "SummaryHead"], "[", 
   DynamicModuleBox[{Typeset`open$$ = False, Typeset`embedState$$ = "Ready"}, 
    TemplateBox[{
      PaneSelectorBox[{False -> GridBox[{{
            PaneBox[
             ButtonBox[
              DynamicBox[
               FEPrivate`FrontEndResource["FEBitmaps", "SummaryBoxOpener"]], 
              ButtonFunction :> (Typeset`open$$ = True), Appearance -> None, 
              BaseStyle -> {}, Evaluator -> Automatic, Method -> 
              "Preemptive"], Alignment -> {Center, Center}, ImageSize -> 
             Dynamic[{
               Automatic, 
                3.5 (CurrentValue["FontCapHeight"]/AbsoluteCurrentValue[
                 Magnification])}]], 
            GraphicsBox[{
              FaceForm[
               Hue[0.63, 0.26, 0.89]], 
              EdgeForm[
               Hue[0.63, 0.7, 0.33]], {{
                RectangleBox[{0, 0}, {0.82, 0.82}], 
                RectangleBox[{0, -1}, {0.82, -0.18000000000000005`}], 
