Cell["7. Contraction", "Section",ExpressionUUID->"3096db90-c223-624f-85a8-94d478f7bee9"],

Cell["\<\
ArrayMultiply contracts a list of arrays according to an index specification, \
in the manner of Einstein summation. Indices named in the output survive; the \
rest are summed over.\
\>", "Text",ExpressionUUID->"1fc66e12-9fda-6d42-a092-dcf8dd293ecd"],

Cell["\<\
a = {{1, 2}, {3, 4}}; b = {{0, 1}, {1, 0}};
ArrayMultiply[{a, b}, \"ij,jk->ik\"]\
\>", "Input",ExpressionUUID->"266f8082-448f-0942-b49e-f6ece833d11c"],

