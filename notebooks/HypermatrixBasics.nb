Cell["\<\
It displays as a summary box rather than as its entries, which is what lets \
an array of any order and any size print in the same amount of space. Normal \
gives the entries back:\
\>", "Text",ExpressionUUID->"dccc0c57-479b-fa4b-aa53-62fb9e350ef4"],

Cell[CellGroupData[{

Cell["Normal @ NumericalArray[{{1, 2, 3}, {4, 5, 6}}]", "Input",ExpressionUUID->"1d033d9d-8143-ca4f-bd0c-6c4beb96ef35"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"4", ",", "5", ",", "6"}], "}"}]}], "}"}]], "Output",ExpressionUUI\
D->"acfcb3a7-27a2-f242-98d5-fadc7b90b97c"]
}, Open  ]],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "A summary box is the placeholder, not the destination. Rendering 1-, 2- and \
3-arrays graphically is the next item of the plan, and will replace this \
display for the small cases where a picture is better than a table of numbers."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"bef7763d-173f-3d47-92d3-3cb20d2c5698"],

Cell[CellGroupData[{

Cell["Order and dimensions", "Subsection",ExpressionUUID->"8cf003cc-1bb8-6947-80c6-c93d3ad72564"],

Cell["\<\
The dimensions of an array are the lengths of its indices, and its order is \
the number of indices. An array of order n is an n-array, so a component \
vector is a 1-array and a matrix is a 2-array:\
\>", "Text",ExpressionUUID->"abaa17d6-8d74-b640-9afe-7542bc4f9376"],

Cell[CellGroupData[{

Cell["\<\
arrays = NumericalArray /@ {{1, 2, 3}, {{1, 2}, {3, 4}}, Array[#1 + #2 + #3 \
&, {2, 2, 2}]};
{ArrayOrder /@ arrays, ArrayDimensions /@ arrays}\
\>", "Input",ExpressionUUID->"fd6b144e-3d73-ed4e-8c9f-abede2f28812"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", "3", "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "2", ",", "2"}], "}"}]}], "}"}]}], "}"}]], "Output",Ex\
pressionUUID->"739d272b-6663-fc4c-b3a5-4b3d058189ed"]
}, Open  ]],

Cell["\<\
Dimensions works directly on an array object, as do Normal and the string \
properties:\
\>", "Text",ExpressionUUID->"cce73862-db59-ec41-ae00-bb77b4126297"],

Cell[CellGroupData[{

Cell["\<\
m = NumericalArray[{{1, 2, 3}, {4, 5, 6}}];
{Dimensions[m], m[\"Order\"], m[\"Properties\"]}\
\>", "Input",ExpressionUUID->"6f4c3903-8d69-c346-9d45-6a30c308cff9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "3"}], "}"}], ",", "2", ",", 
   RowBox[{"{", 
    RowBox[{"\<\"Order\"\>", ",", "\<\"Dimensions\"\>", 
     ",", "\<\"Symmetry\"\>", ",", "\<\"Domain\"\>", ",", "\<\"Name\"\>", 
     ",", "\<\"Entries\"\>", ",", "\<\"RegularQ\"\>"}], "}"}]}], 
  "}"}]], "Output",ExpressionUUID->"91219a3f-e388-fa46-b98e-70bc392b385c"]
}, Open  ]],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Dimensions and Normal are protected System` symbols, so they are extended \
with UpValues on the array heads rather than redefined. That is the same \
treatment VertexList and EdgeList get on Hypergraph."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"a3e35f98-4ca3-6941-85ce-d2b8a458dda4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Regular and irregular", "Subsection",ExpressionUUID->"cf1c4f5b-4104-d349-8193-8cf9d6768a22"],

Cell["\<\
An array is regular when all of its indices range over the same length, and \
irregular when they do not:\
\>", "Text",ExpressionUUID->"a5d349e8-2180-6343-b789-883d59f5b8ee"],

Cell[CellGroupData[{

Cell["\<\
{RegularArrayQ @ NumericalArray[{{1, 2}, {3, 4}}],
  RegularArrayQ @ NumericalArray[{{1, 2, 3}, {4, 5, 6}}]}\
\>", "Input",ExpressionUUID->"477b706d-f33c-384b-834d-f63c7d25cb1a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",ExpressionUUID->"02c49d8a-\
6343-2048-acb5-0556b0974007"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Value domains", "Subsection",ExpressionUUID->"0e2121e6-871a-e942-b44e-a60628c192b9"],

Cell["\<\
The domain is inferred as the narrowest recognized one containing every entry:\
\>", "Text",ExpressionUUID->"63df5d29-e36e-e64d-9b75-17d4af893ff5"],

Cell[CellGroupData[{

Cell["\<\
ArrayDomain @ NumericalArray[#] & /@ {{True, False}, {1, 2}, {1/2, 3}, {1.5, \
2}, {1 + I, 2}}\
\>", "Input",ExpressionUUID->"7e0d59c4-3f07-c14c-bcfb-b5f0aa50155a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Boolean\"\>", ",", "\<\"Integer\"\>", ",", "\<\"Rational\"\>", 
   ",", "\<\"Real\"\>", ",", "\<\"Complex\"\>"}], "}"}]], "Output",ExpressionU\
UID->"7f29f337-087d-d445-8775-956a547e2607"]
}, Open  ]],

