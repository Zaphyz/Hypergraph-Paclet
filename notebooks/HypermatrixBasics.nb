Cell["\<\
The specification may equally be given as a rule between lists of index \
labels:\
\>", "Text",ExpressionUUID->"3517ab3f-fa4b-1c4f-ba5a-f5cc01114aad"],

Cell["\<\
{Normal @ ArrayMultiply[{a, b}, \"ij,jk->ik\"],
  Normal @ ArrayMultiply[{a, b}, {{1, 2}, {2, 3}} -> {1, 3}]}\
\>", "Input",ExpressionUUID->"a89b0fb8-f124-5246-8edb-6b2e1f9fca96"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"4", ",", "3"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"4", ",", "3"}], "}"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"b1644306-2331-764c-8c28-ac724f1ae8c9"],

Cell["\<\
Repeating an index within one array takes a diagonal, and leaving it out of \
the output sums it, so a trace and a transpose are contractions too:\
\>", "Text",ExpressionUUID->"d31ff0c3-2ffb-e64d-b521-d00a7d0f190c"],

Cell["\<\
{Normal @ ArrayMultiply[{a}, \"ii->i\"], Normal @ ArrayMultiply[{a}, \"ii->\"],
  Normal @ ArrayMultiply[{a}, \"ij->ji\"]}\
\>", "Input",ExpressionUUID->"c18e8545-97fc-e54f-8afa-cb7f4c1788f2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "4"}], "}"}], ",", "5", ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "4"}], "}"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"a559c11f-4651-a644-a85b-bceaadd10716"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "An index may occur in any number of the arrays at once, and may occur in \
the output as well as in the inputs. That is what lets a single specification \
express the three-way contractions of the ternary products, which no sequence \
of pairwise contractions would give."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"4cb79b63-877e-d246-b4d3-354ebea751d6"],

Cell["\<\
The Bhattacharya-Mesner product of three 3-arrays joins all three on one \
index:\
\>", "Text",ExpressionUUID->"673df8b8-c978-0d4b-9396-e26f110f9827"],

Cell["\<\
x = Array[#1 + #2 + #3 &, {2, 2, 2}];
Normal @ ArrayMultiply[{x, x, x}, \"ijp,ipk,pjk->ijk\"]\
\>", "Input",ExpressionUUID->"445894e6-c0d4-b640-85a4-e2c36d913213"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"91", ",", "148"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"148", ",", "230"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"148", ",", "230"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"230", ",", "341"}], "}"}]}], "}"}]}], "}"}]], "Output",Expressi\
onUUID->"9cee3f69-9c47-134f-93c7-950403f191f3"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "The result comes back as an array object, whatever the entries turned out \
to be. Contracting every index away leaves a single entry, which is the array \
of order zero, and Normal of that gives the scalar itself. There is nothing \
here to decide: an array of arbitrary expressions is an array like any other, \
which is the whole point of there being one array object."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"31730b99-1995-7646-afb0-0e5b96ce178f"],

Cell["\<\
The other side of the same coin: an array of order zero is named in a \
specification by an empty group of index labels, which is how a scalar enters \
a contraction.\
\>", "Text",ExpressionUUID->"37a11d18-fe81-bb4b-acb3-99c6bd974ea6"],

Cell["Normal @ ArrayMultiply[{3, a}, \",ij->ij\"]", "Input",ExpressionUUID->"4cd6ccf2-60ba-8049-8372-51c372f86b7d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"3", ",", "6"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"9", ",", "12"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"2935fbdc-ae7d-d044-91d0-f9cbe56d388d"],

Cell["Numerical and symbolic arrays", "Subsection",ExpressionUUID->"3be1554d-6703-164f-9e5d-b123657184c6"],

Cell["\<\
A symbolic array is a list of lists of terms with explicit indices, and a \
contraction of symbolic arrays simply builds the corresponding expressions in \
a list of lists. The symbols behave as Wolfram Language symbols always do, \
which is to say as complex variables:\
\>", "Text",ExpressionUUID->"ada72a54-3412-eb4e-a271-a5547f222e29"],

Cell["\<\
sa = Normal @ GenerateSymbolicArray[p, {2, 2}];
sb = Normal @ GenerateSymbolicArray[q, {2, 2}];
{sa, sb}\
\>", "Input",ExpressionUUID->"fb8ed4de-8f19-9d46-8fad-2cc1e68e4bf7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"p", "[", 
        RowBox[{"1", ",", "1"}], "]"}], ",", 
       RowBox[{"p", "[", 
        RowBox[{"1", ",", "2"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"p", "[", 
        RowBox[{"2", ",", "1"}], "]"}], ",", 
       RowBox[{"p", "[", 
        RowBox[{"2", ",", "2"}], "]"}]}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"q", "[", 
        RowBox[{"1", ",", "1"}], "]"}], ",", 
       RowBox[{"q", "[", 
        RowBox[{"1", ",", "2"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"q", "[", 
        RowBox[{"2", ",", "1"}], "]"}], ",", 
       RowBox[{"q", "[", 
        RowBox[{"2", ",", "2"}], "]"}]}], "}"}]}], "}"}]}], "}"}]], "Output",E\
xpressionUUID->"6eb75145-1d86-ca41-9835-32ac1d38808e"],

Cell["ArrayMultiply[{sa, sb}, \"ij,jk->ik\"]", "Input",ExpressionUUID->"fce9a64d-37ab-ef4c-bac9-92cf2dc759e0"],

