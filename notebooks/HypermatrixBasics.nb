   RowBox[{"{", "3", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "3", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3", ",", "3"}], "}"}]}], "}"}]], "Output",ExpressionUUI\
D->"46917797-0ed2-1f44-ad6d-162ac868bd1b"],

Cell["\<\
The splitting may be given here too. The same 4-array with the single index \
innermost instead, so that each cube of a lattice becomes a short line of \
cubes:\
\>", "Text",ExpressionUUID->"17a7dc76-fad9-704a-8c8a-381a946afde3"],

