D->"0ed1d54a-fc5d-5a4f-affb-8b3c95c8ebdc"],

Cell["\<\
The two 1-arrays come first, shorter dimensions before longer. The three \
2-arrays follow, all of dimensions 2\[Times]2, separated by symmetry. The \
3-array comes last.\
\>", "Text",ExpressionUUID->"aa46cd5a-dff7-9d4b-8201-bed391040d48"],

Cell["\<\
Because the order is canonical, the same arrays given differently produce the \
identical expression:\
\>", "Text",ExpressionUUID->"c28d53a8-b05a-5042-88e3-f33f6d874892"],

Cell["\<\
Hypermatrix[{ArrayObject[{1, 2}], ArrayObject[{{1, 2}, {3, 4}}]}] ===
 Hypermatrix[{ArrayObject[{{1, 2}, {3, 4}}], ArrayObject[{1, 2}]}]\
\>", "Input",ExpressionUUID->"ef925845-9c4d-e04b-8e85-936801faaa46"],

Cell[BoxData["True"], "Output",ExpressionUUID->"6c5ca545-632c-4844-836a-9f014c59bf9d"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Two arrays alike in order, dimensions and symmetry are put in the Wolfram \
Language's own canonical order, so that a hypermatrix is a function of the \
set of arrays it was given and of nothing else. Without that last tiebreak \
the three 2\[Times]2 arrays above could come out in either of two orders \
depending on how they were typed."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"e03bc97c-e49f-ac46-893b-21be26526836"],

Cell["What goes in", "Subsection",ExpressionUUID->"891c8d3c-fa66-4c47-8292-2f7f0916f622"],

Cell["\<\
Raw entries are promoted to array objects, and arrays of any kind of entry \
sit together:\
\>", "Text",ExpressionUUID->"db0c22c3-f485-9f4b-8077-c778d57e888c"],

Cell["\<\
Hypermatrix[{{1, 2}, {1.5, 2.5}, GenerateSymbolicArray[a, {2, 2}]}][\"Domains\
\"]\
\>", "Input",ExpressionUUID->"151b63fe-0391-6f45-952b-a5336767517f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Integer\"\>", ",", "\<\"Real\"\>", ",", "\<\"Expression\"\>"}],
   "}"}]], "Output",ExpressionUUID->"23e85961-ea2b-c646-a222-8d43f45d2ab7"],

Cell["\<\
Length gives the number of arrays, HypermatrixArrays gives them, and Normal \
gives their entries in the same order:\
\>", "Text",ExpressionUUID->"3a9fdce8-0977-494c-ac0f-7cf03d5338e6"],

Cell["\<\
hm2 = Hypermatrix[{{{1, 2}, {3, 4}}, {1, 2}}];
{Length[hm2], Normal[hm2]}\
\>", "Input",ExpressionUUID->"fe9e041b-757f-0342-b973-4bb6ffda2491"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "4"}], "}"}]}], "}"}]}], "}"}]}], "}"}]], "Output",E\
xpressionUUID->"f66b5d42-e291-1647-9575-cfebcbf09fc9"],

Cell["A sequence of arrays is accepted as well as a list:", "Text",ExpressionUUID->"dc0c36d0-37de-6c40-841c-34452708422f"],

Cell["\<\
Hypermatrix[ArrayObject[{1, 2}], ArrayObject[{1, 2, 3}]] ===
 Hypermatrix[{ArrayObject[{1, 2}], ArrayObject[{1, 2, 3}]}]\
\>", "Input",ExpressionUUID->"9c53dd74-3cd4-8f44-bc5b-9ff7634e2fff"],

Cell[BoxData["True"], "Output",ExpressionUUID->"2215eaad-ea0c-b742-8ec0-6a44407c87db"],

Cell["Anything that is not an array is refused:", "Text",ExpressionUUID->"4b7e5556-339d-054b-a1cf-ebeb6bb8c94f"],

Cell["Quiet @ Hypermatrix[{\"nope\"}]", "Input",ExpressionUUID->"17323dd6-9fe1-9b4b-a759-8e3a374acb39"],

