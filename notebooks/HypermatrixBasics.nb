       RowBox[{"{", 
        RowBox[{"3", ",", "4"}], "}"}]}], "}"}]}], "}"}]}], "}"}]], "Output",E\
xpressionUUID->"ab74c338-f85e-3e4d-9b87-21f32ef70d29"],

Cell["A sequence of arrays is accepted as well as a list:", "Text",ExpressionUUID->"e3c26c4c-930d-8d46-8967-4516e8983c85"],

Cell["\<\
Hypermatrix[ArrayObject[{1, 2}], ArrayObject[{1, 2, 3}]] ===
 Hypermatrix[{ArrayObject[{1, 2}], ArrayObject[{1, 2, 3}]}]\
\>", "Input",ExpressionUUID->"c713f6f6-7653-fe46-b800-1e0577c32138"],

