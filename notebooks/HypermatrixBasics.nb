     {Opacity[1], 
      {Hue[0.63, 0.26, 0.89], EdgeForm[{Hue[0.63, 0.7, 0.33], Opacity[0.95]}],
        DiskBox[{1.9987657369935588`, 1.061628456550387}, 
        Offset[{2., 2.}, {0., 0.}]], 
       DiskBox[{1.9987444371974448`, 0.}, Offset[{2., 2.}, {0., 0.}]], 
       DiskBox[{1.256851436554468, 0.5308254495580791}, 
        Offset[{2., 2.}, {0., 0.}]], 
