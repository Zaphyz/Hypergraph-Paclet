  WolframInstitute`Hypergraphs`Hypermatrix[{
    WolframInstitute`Hypergraphs`NumericalArray[{1, 2}, "Integer", "Rigid"], 
    WolframInstitute`Hypergraphs`NumericalArray[{1, 2, 3}, "Integer", 
