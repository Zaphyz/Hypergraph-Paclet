   RowBox[{"{", "2", "}"}], ",", 
   RowBox[{"{", "3", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "3", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3", ",", "3"}], "}"}]}], "}"}]], "Output",ExpressionUUI\
D->"d1b5660b-770d-8c47-9392-6e95dbd7e53c"],

Cell["\<\
The splitting may be given here too. The same 4-array with the single index \
innermost instead, so that each cube of a lattice becomes a short line of \
cubes:\
\>", "Text",ExpressionUUID->"5dfadbbd-d6bc-cd45-9f69-4bc9e53d3c0e"],

Cell["\<\
ArrayGraphics3D[Array[#1 + #2 + #3 + #4 &, {2, 2, 2, 2}], \"Nesting\" -> {3, \
1}]\
\>", "Input",ExpressionUUID->"8c66a043-d129-dc45-a10f-e42a8a454573"],

