Cell["It agrees with the built-in matrix product, as it should:", "Text",ExpressionUUID->"821832ef-e4f6-9f47-bd21-bd61aab8b440"],

Cell["ArrayMultiply[{sa, sb}, \"ij,jk->ik\"] === sa . sb", "Input",ExpressionUUID->"5c06d88f-a94e-5243-aaa0-fd1b3c05d1b5"],

Cell[BoxData["False"], "Output",ExpressionUUID->"bfa527a8-dc3a-104b-b7d2-61a1e30aacc6"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Arrays with numeric entries and arrays with generated ones may be \
contracted together. That was once refused, on the grounds that the result \
would be neither kind of object; with one array object the objection has \
nothing left to stand on, and the entries of the result are simply the \
expressions the contraction builds."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"cdf0fae5-d79a-c044-8c9d-0e7b8a8284a4"],

Cell["Normal @ ArrayMultiply[{{{1, 2}, {3, 4}}, sb}, \"ij,jk->ik\"]", "Input",ExpressionUUID->"af34c85f-e89e-2847-8ab7-ebf3f63d8215"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"q", "[", 
       RowBox[{"1", ",", "1"}], "]"}], "+", 
      RowBox[{"2", " ", 
       RowBox[{"q", "[", 
        RowBox[{"2", ",", "1"}], "]"}]}]}], ",", 
     RowBox[{
      RowBox[{"q", "[", 
       RowBox[{"1", ",", "2"}], "]"}], "+", 
      RowBox[{"2", " ", 
       RowBox[{"q", "[", 
        RowBox[{"2", ",", "2"}], "]"}]}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"3", " ", 
       RowBox[{"q", "[", 
        RowBox[{"1", ",", "1"}], "]"}]}], "+", 
      RowBox[{"4", " ", 
       RowBox[{"q", "[", 
        RowBox[{"2", ",", "1"}], "]"}]}]}], ",", 
     RowBox[{
      RowBox[{"3", " ", 
       RowBox[{"q", "[", 
        RowBox[{"1", ",", "2"}], "]"}]}], "+", 
      RowBox[{"4", " ", 
       RowBox[{"q", "[", 
        RowBox[{"2", ",", "2"}], "]"}]}]}]}], "}"}]}], "}"}]], "Output",Expres\
sionUUID->"b3d7f90c-466b-3240-8971-a4911bb8bcaf"],

Cell["Contracting every index: the trace", "Subsection",ExpressionUUID->"d69b88d7-7867-654a-8d6a-2c98248e3a0f"],

Cell["\<\
An operation need not return an array. Contracting a single matrix onto no \
indices at all sums its diagonal, which is the trace, and works on numerical \
and symbolic entries alike:\
\>", "Text",ExpressionUUID->"a9ceadaa-0b83-c849-a7f7-535753d47c51"],

Cell["\<\
trace[u_List] := Normal @ ArrayMultiply[{u}, \"pp->\"];
{trace[{{1, 2}, {3, 4}}], trace[sa]}\
\>", "Input",ExpressionUUID->"b17d5564-2c4a-dd40-bf65-0712d37135c8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"5", ",", 
   RowBox[{
    RowBox[{"p", "[", 
     RowBox[{"1", ",", "1"}], "]"}], "+", 
    RowBox[{"p", "[", 
     RowBox[{"2", ",", "2"}], "]"}]}]}], "}"}]], "Output",ExpressionUUID->\
"674aaf7d-b98d-814c-8ec0-1a4bb751e487"],

Cell["\<\
{trace[{{1, 2}, {3, 4}}] === Tr[{{1, 2}, {3, 4}}], trace[sa] === Tr[sa]}\
\>", "Input",ExpressionUUID->"5d787a7e-ec25-434f-bf64-a91a8053ec8b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",ExpressionUUID->"2c7de537-5c15-f042-b17d-2e2234369787"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "The Normal is doing something here. A contraction onto no indices gives \
back the 0-array rather than a bare number, and Normal takes its single \
entry. It does the same whatever the entries were, so the one definition \
covers every case."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"6c1f2208-86fb-f04e-9737-791bda9b61ab"],

Cell["8. Adding and multiplying entry by entry", "Section",ExpressionUUID->"fbf4e995-e5d1-1849-9516-545619f38542"],

Cell["\<\
Contraction is one of the two things one does with arrays. The other is to \
combine them entry by entry, which is what makes arrays of a given shape a \
vector space rather than merely a collection of tables. ArrayAdd and \
ArrayTimes do that:\
\>", "Text",ExpressionUUID->"7b4961bb-ef56-ab48-a6c9-5cdc921c2038"],

Cell["\<\
u = {{1, 2}, {3, 4}}; v = {{5, 6}, {7, 8}};
{Normal @ ArrayAdd[u, v], Normal @ ArrayTimes[u, v]}\
\>", "Input",ExpressionUUID->"de3aec54-5797-174e-bd27-0b084f2475ac"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"6", ",", "8"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"10", ",", "12"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"5", ",", "12"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"21", ",", "32"}], "}"}]}], "}"}]}], "}"}]], "Output",Expression\
UUID->"5e24c3ac-fb55-004e-9acc-51dfa443980d"],

Cell["\<\
Plus and Times on array objects are those same operations, so arrays may be \
combined in ordinary arithmetic notation:\
\>", "Text",ExpressionUUID->"2a61364b-f493-f140-92e9-c434840ef813"],

Cell["\<\
{Normal[ArrayObject[u] + ArrayObject[v]],
  Normal[ArrayObject[u] - ArrayObject[v]],
  Normal[ArrayObject[u] ArrayObject[v]]}\
\>", "Input",ExpressionUUID->"620e9ba3-fd55-c14c-ac91-cba19e30bb84"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"6", ",", "8"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"10", ",", "12"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "4"}], ",", 
       RowBox[{"-", "4"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "4"}], ",", 
       RowBox[{"-", "4"}]}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"5", ",", "12"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"21", ",", "32"}], "}"}]}], "}"}]}], "}"}]], "Output",Expression\
UUID->"c34b4c92-472d-5e46-b161-2d4cd0973a5d"],

Cell["\<\
An array of order zero has no shape of its own, so it combines with an array \
of any dimensions, reaching every entry:\
\>", "Text",ExpressionUUID->"02901ea9-7373-2d4f-b030-f450c6cde2d4"],

Cell["{Normal @ ArrayTimes[2, u], Normal @ ArrayAdd[1, u]}", "Input",ExpressionUUID->"9794753a-3075-2b4f-974e-ed2b1333a91b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"6", ",", "8"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"4", ",", "5"}], "}"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"f7bfc85f-d10e-7249-abdb-f6c661c458b0"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "This is why scalar multiplication needs no name of its own. A scalar is the \
0-array; multiplying an array by one is the same entry-by-entry \
multiplication as multiplying it by another array of its own shape, with the \
single entry spread over the whole shape rather than matched index for index. \
One operation, one rule, and 2 a is ArrayTimes[ArrayObject[2], a] written \
shorter."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"ca882cc6-13fd-e148-bdd9-1d386f8526eb"],

Cell["ArrayTimes[2, u] === ArrayTimes[ArrayObject[2], u]", "Input",ExpressionUUID->"3f6b136a-14e9-064a-9d27-c48c5baf5a35"],

Cell[BoxData["True"], "Output",ExpressionUUID->"b05d891c-f5d8-a148-bfa4-c72331eb5b71"],

Cell["\<\
Arrays of different dimensions cannot be combined this way, and are refused \
rather than padded or truncated:\
\>", "Text",ExpressionUUID->"9e05e00a-e4ae-e146-9652-e767e492efc9"],

Cell["Quiet @ ArrayAdd[{1, 2}, {1, 2, 3}]", "Input",ExpressionUUID->"26922962-04de-ba4f-aa58-056abd8e5797"],

Cell[BoxData["$Failed"], "Output",ExpressionUUID->"aeec4363-4ed0-9c4e-807c-f0b37beee174"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Entries of any kind may be combined, a number meeting an expression having \
the obvious meaning, and the result is an array object like anything else \
here. ArrayMultiply once refused the same mixture and no longer does, for the \
same reason: with one array object there is nothing ambiguous about what \
comes back."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"5123abd9-14a7-bd45-b092-87ca6c1160ed"],

Cell["\<\
{2 GenerateSymbolicArray[c, {2}], ArrayObject[{1, 2}] + \
GenerateSymbolicArray[c, {2}]}\
\>", "Input",ExpressionUUID->"547c1b94-2240-e94d-8676-877bc00059d3"],

