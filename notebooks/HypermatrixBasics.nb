   RowBox[{"{", "2", "}"}], ",", 
   RowBox[{"{", "3", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "3", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3", ",", "3"}], "}"}]}], "}"}]], "Output",ExpressionUUI\
D->"0df50e25-9760-f84e-a4d5-b3bd69c14bb7"],

Cell["\<\
The splitting may be given here too. The same 4-array with the single index \
innermost instead, so that each cube of a lattice becomes a short line of \
cubes:\
\>", "Text",ExpressionUUID->"301231c7-6937-3c41-851d-dbc1a2a91d7f"],

