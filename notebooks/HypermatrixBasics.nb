Cell["It agrees with the built-in matrix product, as it should:", "Text",ExpressionUUID->"28253f83-6a68-bb43-8bd6-f8005b2dad41"],

Cell["ArrayMultiply[{sa, sb}, \"ij,jk->ik\"] === sa . sb", "Input",ExpressionUUID->"a6805c29-383d-6b4f-82e6-066b1d1832c0"],

Cell[BoxData["False"], "Output",ExpressionUUID->"aad46763-f395-f043-9e5e-760afb52b840"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Arrays with numeric entries and arrays with generated ones may be \
contracted together. That was once refused, on the grounds that the result \
would be neither kind of object; with one array object the objection has \
nothing left to stand on, and the entries of the result are simply the \
expressions the contraction builds."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"88c0d116-b3c6-0242-8541-777d9d8aee41"],

Cell["Normal @ ArrayMultiply[{{{1, 2}, {3, 4}}, sb}, \"ij,jk->ik\"]", "Input",ExpressionUUID->"247fac4c-a334-c848-80f9-0ab84452b925"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"q", "[", 
       RowBox[{"1", ",", "1"}], "]"}], "+", 
      RowBox[{"2", " ", 
       RowBox[{"q", "[", 
        RowBox[{"2", ",", "1"}], "]"}]}]}], ",", 
     RowBox[{
      RowBox[{"q", "[", 
       RowBox[{"1", ",", "2"}], "]"}], "+", 
      RowBox[{"2", " ", 
       RowBox[{"q", "[", 
        RowBox[{"2", ",", "2"}], "]"}]}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"3", " ", 
       RowBox[{"q", "[", 
        RowBox[{"1", ",", "1"}], "]"}]}], "+", 
      RowBox[{"4", " ", 
       RowBox[{"q", "[", 
        RowBox[{"2", ",", "1"}], "]"}]}]}], ",", 
     RowBox[{
      RowBox[{"3", " ", 
       RowBox[{"q", "[", 
        RowBox[{"1", ",", "2"}], "]"}]}], "+", 
      RowBox[{"4", " ", 
       RowBox[{"q", "[", 
        RowBox[{"2", ",", "2"}], "]"}]}]}]}], "}"}]}], "}"}]], "Output",Expres\
sionUUID->"809cc848-7276-294f-8be9-ed8fe06a03d1"],

Cell["Contracting every index: the trace", "Subsection",ExpressionUUID->"3abe4978-d7e9-a54a-945a-d78d14c8ec7f"],

Cell["\<\
An operation need not return an array. Contracting a single matrix onto no \
indices at all sums its diagonal, which is the trace, and works on numerical \
and symbolic entries alike:\
\>", "Text",ExpressionUUID->"8b1b01a4-75eb-8243-be0c-c037b05e0d8f"],

Cell["\<\
trace[u_List] := Normal @ ArrayMultiply[{u}, \"pp->\"];
{trace[{{1, 2}, {3, 4}}], trace[sa]}\
\>", "Input",ExpressionUUID->"77738873-9d6d-9b47-915e-416cfc2f4996"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"5", ",", 
   RowBox[{
    RowBox[{"p", "[", 
     RowBox[{"1", ",", "1"}], "]"}], "+", 
    RowBox[{"p", "[", 
     RowBox[{"2", ",", "2"}], "]"}]}]}], "}"}]], "Output",ExpressionUUID->\
"cdea2f4e-0dd8-5845-8bd9-b7adf7ddecd0"],

Cell["\<\
{trace[{{1, 2}, {3, 4}}] === Tr[{{1, 2}, {3, 4}}], trace[sa] === Tr[sa]}\
\>", "Input",ExpressionUUID->"1dba793c-efc7-ee42-978e-d98c7235a127"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",ExpressionUUID->"62e58e43-db95-774f-8c71-ea98a854dc3b"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "The Normal is doing something here. A contraction onto no indices gives \
back the 0-array rather than a bare number, and Normal takes its single \
entry. It does the same whatever the entries were, so the one definition \
covers every case."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"feef4822-83ca-5f42-8242-3170944238e5"],

Cell["8. Adding and multiplying entry by entry", "Section",ExpressionUUID->"fc617e21-51be-d841-8f6d-02fe217aa742"],

Cell["\<\
Contraction is one of the two things one does with arrays. The other is to \
combine them entry by entry, which is what makes arrays of a given shape a \
vector space rather than merely a collection of tables. ArrayAdd and \
ArrayTimes do that:\
\>", "Text",ExpressionUUID->"3b80297d-f251-4f43-b5a5-8a7599a46304"],

Cell["\<\
u = {{1, 2}, {3, 4}}; v = {{5, 6}, {7, 8}};
{Normal @ ArrayAdd[u, v], Normal @ ArrayTimes[u, v]}\
\>", "Input",ExpressionUUID->"bcad648b-a814-9e42-bed6-34d9ef3c5e37"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"6", ",", "8"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"10", ",", "12"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"5", ",", "12"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"21", ",", "32"}], "}"}]}], "}"}]}], "}"}]], "Output",Expression\
UUID->"f0692f01-6131-9445-9002-4ba30b178b07"],

Cell["\<\
Plus and Times on array objects are those same operations, so arrays may be \
combined in ordinary arithmetic notation:\
\>", "Text",ExpressionUUID->"fd55f723-11f8-7242-b453-97011d260017"],

Cell["\<\
{Normal[ArrayObject[u] + ArrayObject[v]],
  Normal[ArrayObject[u] - ArrayObject[v]],
  Normal[ArrayObject[u] ArrayObject[v]]}\
\>", "Input",ExpressionUUID->"a4832c89-aa21-f247-a703-658766002e21"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"6", ",", "8"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"10", ",", "12"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "4"}], ",", 
       RowBox[{"-", "4"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "4"}], ",", 
       RowBox[{"-", "4"}]}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"5", ",", "12"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"21", ",", "32"}], "}"}]}], "}"}]}], "}"}]], "Output",Expression\
UUID->"27b4f6d4-373b-ea47-9859-8c60d227489a"],

Cell["\<\
An array of order zero has no shape of its own, so it combines with an array \
of any dimensions, reaching every entry:\
\>", "Text",ExpressionUUID->"bbecb71a-dbd3-2348-877b-a3439e7cf82a"],

Cell["{Normal @ ArrayTimes[2, u], Normal @ ArrayAdd[1, u]}", "Input",ExpressionUUID->"eb387935-ffa4-e24e-bf02-695063e622c1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"6", ",", "8"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"4", ",", "5"}], "}"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"d7e7f370-e203-364b-910a-467eb98397e4"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "This is why scalar multiplication needs no name of its own. A scalar is the \
0-array; multiplying an array by one is the same entry-by-entry \
multiplication as multiplying it by another array of its own shape, with the \
single entry spread over the whole shape rather than matched index for index. \
One operation, one rule, and 2 a is ArrayTimes[ArrayObject[2], a] written \
shorter."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"4a225ff8-0adc-a147-b97c-f2ab4eb18c0d"],

Cell["ArrayTimes[2, u] === ArrayTimes[ArrayObject[2], u]", "Input",ExpressionUUID->"f91bfa82-f705-b84b-84ba-a6a071c3f774"],

Cell[BoxData["True"], "Output",ExpressionUUID->"cb1d0864-16b2-704d-9c2f-c89651a9c440"],

Cell["\<\
Arrays of different dimensions cannot be combined this way, and are refused \
rather than padded or truncated:\
\>", "Text",ExpressionUUID->"47e8d4d4-e2ea-244c-ac08-5158df917916"],

Cell["Quiet @ ArrayAdd[{1, 2}, {1, 2, 3}]", "Input",ExpressionUUID->"480af880-e61c-984b-8c36-ce6d49b6eb23"],

Cell[BoxData["$Failed"], "Output",ExpressionUUID->"bd6e224a-706c-f245-8dd3-90584fb9227a"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Entries of any kind may be combined, a number meeting an expression having \
the obvious meaning, and the result is an array object like anything else \
here. ArrayMultiply once refused the same mixture and no longer does, for the \
same reason: with one array object there is nothing ambiguous about what \
comes back."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"60a54506-0c2a-fa4d-b468-7b9a2b30e498"],

Cell["\<\
{2 GenerateSymbolicArray[c, {2}], ArrayObject[{1, 2}] + \
GenerateSymbolicArray[c, {2}]}\
\>", "Input",ExpressionUUID->"9622b2b6-7d7b-4441-a132-49a2fe7696e0"],

