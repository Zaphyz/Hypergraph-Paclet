Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "An array of more than a few hundred entries is refused rather than drawn, \
with ArrayGraphics::big. A picture of a thousand cells is not a picture of \
anything; \"MaxEntries\" raises the limit for anyone who disagrees."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"ba59fc08-e9fe-b94e-a59f-b6878b3658c6"],

