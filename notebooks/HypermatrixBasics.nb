Cell["6. Special arrays", "Section",ExpressionUUID->"dce2f865-e700-4745-a1be-b43073ceea11"],

Cell["\<\
The constant arrays and the generalized Kronecker deltas are available in any \
order, dimension and value domain. Each declares the strongest symmetry that \
actually holds of it, which the ArrayObject constructor then verifies.\
\>", "Text",ExpressionUUID->"ace7e79f-21f5-f442-9aae-9637b36cb804"],

Cell["{Normal @ ZeroArray[2, 3], Normal @ OneArray[2, 3]}", "Input",ExpressionUUID->"fa2b74d9-ffb6-6f41-8c7b-e5690f1ddafe"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "1", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], "}"}]}], "}"}]], "Output",Ex\
pressionUUID->"2c39be85-971a-204f-b6d4-895a3e151c43"],

Cell["\<\
The identity array is one where all of its indices agree. At order two it is \
the identity matrix; at order three it is one only on the main diagonal:\
\>", "Text",ExpressionUUID->"93804849-7114-8f4a-8605-f059117e88de"],

Cell["{Normal @ IdentityArray[2, 3], Normal @ IdentityArray[3, 2]}", "Input",ExpressionUUID->"1d32823a-99b7-064b-923b-f60933e036af"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], "}"}]}], "}"}]], "Output",E\
xpressionUUID->"cd9354b4-e42e-4549-b168-f629483770b1"],

Cell["\<\
A partial identity is one where the indices at chosen positions agree, \
whatever the others do. These are the three partial identities of a 3-array, \
one per pair of indices:\
\>", "Text",ExpressionUUID->"4c87f3eb-85a3-5745-901f-5c149e6eeed5"],

Cell["\<\
Normal @ PartialIdentityArray[3, 2, #] & /@ {{1, 2}, {2, 3}, {1, 3}}\
\>", "Input",ExpressionUUID->"eb426499-abb9-704a-b026-e001a3606a13"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}]}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], "}"}]}], "}"}]], "Output",E\
xpressionUUID->"468b6c1c-d623-7047-8fee-0c775ac4e8aa"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "A constant array and a full identity are invariant under every permutation \
of their indices, so they are declared symmetric. A partial identity on only \
some positions is not, so it is declared rigid. Naming every position gives \
back the full identity exactly."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"b8c166ce-a736-2948-b67b-46e3dfddbcdd"],

Cell["\<\
{ArraySymmetry @ ZeroArray[3, 2], ArraySymmetry @ IdentityArray[3, 2],
  ArraySymmetry @ PartialIdentityArray[3, 2, {1, 2}],
  PartialIdentityArray[3, 2, {1, 2, 3}] === IdentityArray[3, 2]}\
\>", "Input",ExpressionUUID->"d50f42d7-b9bc-d043-a108-b065568ff7c1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Symmetric\"\>", ",", "\<\"Symmetric\"\>", ",", "\<\"Rigid\"\>",
    ",", "True"}], "}"}]], "Output",ExpressionUUID->"00b42210-b0ce-9841-ad52-\
57b1c2ededc8"],

Cell["Seeing them", "Subsection",ExpressionUUID->"336393ea-0ba9-914d-8660-9f040d302c5c"],

Cell["\<\
These arrays are the ones whose shape is worth looking at, since what makes \
each of them special is where its entries sit rather than what they are. Both \
families of pictures are useful here, and at different orders.\
\>", "Text",ExpressionUUID->"5a5d59de-78cf-2745-9f86-358ae9f4ef03"],

Cell["\<\
A constant array says the same thing at every position, whatever its \
dimensions. Order one, order two, and a rectangular one that is not regular \
at all:\
\>", "Text",ExpressionUUID->"c4012d27-9f98-5746-8644-06cb078cf85c"],

Cell["\<\
{ArrayGraphics @ OneArray[{4}], ArrayGraphics @ ZeroArray[2, 3],
  ArrayGraphics @ OneArray[{2, 5}]}\
\>", "Input",ExpressionUUID->"95d55dae-4769-0e42-b626-e3e420bcf5f6"],

