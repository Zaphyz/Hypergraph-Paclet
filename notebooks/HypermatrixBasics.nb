Cell[BoxData["\<\"Complex\"\>"], "Output",ExpressionUUID->"8cb944ae-5144-8d40-97e0-49d559a4c9f3"]
}, Open  ]],

Cell["\[Ellipsis] but one that does not contain them is refused:", "Text",ExpressionUUID->"64b67008-7074-f045-907e-2e08b59a5ab2"],

Cell[CellGroupData[{

Cell["Quiet @ NumericalArray[{1.5}, \"Integer\"]", "Input",ExpressionUUID->"7d239fc4-3365-ae41-85a9-3fbfc4dbd5dc"],

