Cell[CellGroupData[{

Cell["Normal @ SymbolicArray[a, {2, 3}]", "Input",ExpressionUUID->"c167416b-a8cf-3c42-aa5b-21ac5380759c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "1"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "3"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "1"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "3"}], "]"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"ba510a8a-5e6c-9542-b6be-bb2a427e50e9"]
}, Open  ]],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Numerical and symbolic arrays are separate heads rather than one head with \
a flag, because almost nothing they do is shared: one stores its entries and \
has a value domain, the other generates its entries and has a name. Keeping \
them apart means neither has to carry a slot that is meaningless for it."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"b057cbba-fa92-2749-8bee-23937ecb1029"],

Cell["\<\
A symbolic array has a name where a numerical one has a domain, and the two \
accessors work on both kinds:\
\>", "Text",ExpressionUUID->"5d8db73c-a65a-a04c-86e3-d50f216ccc13"],

Cell[CellGroupData[{

Cell["\<\
sa = SymbolicArray[a, {2, 3}];
{{ArrayName[sa], ArrayDomain[sa]}, {ArrayName[m], ArrayDomain[m]}}\
\>", "Input",ExpressionUUID->"ec20f290-1641-c34b-9604-a2358717c7e8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"a", ",", "\<\"Symbolic\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"None", ",", "\<\"Integer\"\>"}], "}"}]}], "}"}]], "Output",Expres\
sionUUID->"74894dd9-2bcb-aa4f-aff8-bc339dc32a63"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Index symmetries", "Section",ExpressionUUID->"38408b00-b37e-9d41-8010-480d38c853c4"],

Cell["\<\
A regular array may declare an index symmetry: \"Rigid\" for no symmetry, \
which is the default, \"Cyclic\" for invariance under cyclic permutation of \
the indices, or \"Symmetric\" for invariance under all of them.\
\>", "Text",ExpressionUUID->"5a5b9655-b16f-2b45-8473-7cd486bcc8d6"],

Cell[CellGroupData[{

Cell["On a symbolic array the symmetry is honoured by construction", \
"Subsection",ExpressionUUID->"e9012128-f6f8-ac49-ae68-e466057d7775"],

Cell["\<\
Index tuples that are equivalent under the symmetry name the same entry, so \
the generated array cannot fail to have the symmetry it claims:\
\>", "Text",ExpressionUUID->"9e3409b2-ae74-fa49-b46f-84ddeb117920"],

Cell[CellGroupData[{

Cell["Normal @ SymbolicArray[a, {3, 3}, \"Symmetric\"]", "Input",ExpressionUUID->"674e42a1-58dd-7d42-8873-c374a60e27cd"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "1"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "3"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "2"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "3"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"1", ",", "3"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"2", ",", "3"}], "]"}], ",", 
     RowBox[{"a", "[", 
      RowBox[{"3", ",", "3"}], "]"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"0c47204d-22fa-9447-aa07-b1c102b020c2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
With[{e = Normal @ SymbolicArray[a, {3, 3}, \"Symmetric\"]}, e === \
Transpose[e]]\
\>", "Input",ExpressionUUID->"1c24a422-5d09-434f-bcf4-6531657ccd45"],

Cell[BoxData["True"], "Output",ExpressionUUID->"96bfd1ef-f686-0544-af48-56c1bc915529"]
}, Open  ]],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "This is the same device that puts the vertices of a hyperedge into the \
least order of their symmetry orbit. Here the entry at a tuple of indices is \
the name applied to the least tuple in its orbit, which is why a symmetric or \
cyclic symbolic array needs no checking."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"0d75973d-0482-ed45-b91a-9b220262fd03"],

Cell["\<\
The three symmetries really are three different things. Counting distinct \
entries of a 3\[Times]3\[Times]3 array shows it:\
\>", "Text",ExpressionUUID->"fd018938-b601-2d4d-977f-408e66ee623f"],

Cell[CellGroupData[{

Cell["\<\
Length @ DeleteDuplicates @ Flatten @ Normal @ SymbolicArray[a, {3, 3, 3}, #] \
& /@
  {\"Rigid\", \"Cyclic\", \"Symmetric\"}\
\>", "Input",ExpressionUUID->"ae4903ab-c025-cf4e-87ed-ac361553041d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"27", ",", "11", ",", "10"}], "}"}]], "Output",ExpressionUUID->\
"8ed122de-42ac-294d-a463-8b7b3b8a0fb6"]
}, Open  ]],

Cell["\<\
At order two, though, the cyclic group on the indices is the whole symmetric \
group, so there \"Cyclic\" and \"Symmetric\" coincide exactly:\
\>", "Text",ExpressionUUID->"d2b22ef2-7c20-5c40-a900-076eb69623be"],

Cell[CellGroupData[{

Cell["\<\
Normal[SymbolicArray[a, {3, 3}, \"Cyclic\"]] === Normal[SymbolicArray[a, {3, \
3}, \"Symmetric\"]]\
\>", "Input",ExpressionUUID->"671a6f86-d452-c24b-8d8d-f966273e3825"],

Cell[BoxData["True"], "Output",ExpressionUUID->"0513a078-0ccd-3c43-bd3c-512927f913b2"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["On a numerical array the symmetry is verified", "Subsection",ExpressionUUID->"0b2866ec-1521-604f-a942-bf94627b6829"],

Cell["\<\
A numerical array has entries already, so a declared symmetry is a claim \
about them, and it is checked. These entries are symmetric:\
\>", "Text",ExpressionUUID->"a23bae16-bb8b-8f47-b6b0-7997fbfcd9e8"],

Cell[CellGroupData[{

Cell["\<\
ArraySymmetry @ NumericalArray[{{1, 2}, {2, 1}}, Automatic, \"Symmetric\"]\
\>", "Input",ExpressionUUID->"786df9a8-58d4-6a43-a35c-a4b37f7861b4"],

Cell[BoxData["\<\"Symmetric\"\>"], "Output",ExpressionUUID->"814147f8-a7b3-7944-8324-bb82728ec27e"]
}, Open  ]],

Cell["\<\
\[Ellipsis] and these are not, so the declaration is refused rather than the \
entries being quietly symmetrized:\
\>", "Text",ExpressionUUID->"9c36a79f-56ef-2949-a4b6-044247efe4cb"],

Cell[CellGroupData[{

Cell["\<\
Quiet @ NumericalArray[{{1, 2}, {3, 4}}, Automatic, \"Symmetric\"]\
\>", "Input",ExpressionUUID->"b7102e13-500b-e54d-9918-d82aba03d3e1"],

Cell[BoxData["$Failed"], "Output",ExpressionUUID->"0576cb5a-ff6d-c948-874c-a7132a845c9d"]
}, Open  ]],

Cell["The same entries are perfectly good as a rigid array:", "Text",ExpressionUUID->"a2bc34d2-1672-0c47-9646-d24d82064735"],

Cell[CellGroupData[{

Cell["ArraySymmetry @ NumericalArray[{{1, 2}, {3, 4}}]", "Input",ExpressionUUID->"18cdc01f-e822-5047-b174-1f3fc17a45ea"],

Cell[BoxData["\<\"Rigid\"\>"], "Output",ExpressionUUID->"b3d78766-b8fd-8e4d-9a8b-246aecd0bfce"]
}, Open  ]],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Refusing is the honest answer: symmetrizing would silently return an array \
with different entries from the ones given. The symmetry is a declared \
property and ArraySymmetry reports what was declared, in the same way that an \
edge's symmetry type is declared rather than detected."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"996390d1-80d6-7040-b1f5-f55d3ec50636"],

Cell["\<\
Cyclic and symmetric are genuinely distinguished. The indicator of the cyclic \
orbit of (1, 2, 3) is invariant under rotating the indices but not under \
swapping two of them:\
\>", "Text",ExpressionUUID->"c553789b-6c02-aa4e-8082-6fe85d691db4"],

Cell[CellGroupData[{

Cell["\<\
cyc = Array[If[MemberQ[{{1, 2, 3}, {2, 3, 1}, {3, 1, 2}}, {##}], 1, 0] &, {3, \
3, 3}];
{ArraySymmetry @ NumericalArray[cyc, Automatic, \"Cyclic\"],
  Quiet @ NumericalArray[cyc, Automatic, \"Symmetric\"]}\
\>", "Input",ExpressionUUID->"f681897f-6d96-b64a-abde-75d66c01ad13"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Cyclic\"\>", ",", "$Failed"}], "}"}]], "Output",ExpressionUUID->\
"efe77d0b-dc52-eb4f-bdee-856e428a35a9"]
}, Open  ]],

Cell["\<\
A symmetry needs a regular array: permuting the indices of a 2\[Times]3 array \
would not give an array of the same shape, so the declaration is refused:\
\>", "Text",ExpressionUUID->"e88f43dc-a61d-3e42-b3da-888fbdd1f0e6"],

Cell[CellGroupData[{

Cell["\<\
Quiet @ NumericalArray[{{1, 2, 3}, {4, 5, 6}}, Automatic, \"Symmetric\"]\
\>", "Input",ExpressionUUID->"312260c1-fac0-eb4c-af7b-ef469143d24a"],

Cell[BoxData["$Failed"], "Output",ExpressionUUID->"547173f0-dd64-1645-9fb8-fe7c76a349bb"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. Hypermatrices", "Section",ExpressionUUID->"3c01b5ee-c08a-3e43-9895-12feba5f052c"],

Cell["\<\
A hypermatrix is a list of arrays, held in a canonical order: lowest order \
first, then the shorter dimensions, then symmetry taking symmetric before \
cyclic before rigid. Here are six arrays given in no particular order:\
\>", "Text",ExpressionUUID->"1cc2cb43-7425-d044-bfe0-c84a98f0a0d4"],

Cell[CellGroupData[{

Cell["\<\
hm = Hypermatrix[{
   NumericalArray[Array[1 &, {2, 2, 2}], Automatic, \"Symmetric\"],
   NumericalArray[{{1, 2}, {3, 4}}],
   NumericalArray[{1, 2}],
   NumericalArray[{1, 2, 3}],
   NumericalArray[{{1, 2}, {2, 1}}, Automatic, \"Symmetric\"],
   NumericalArray[{{1, 2}, {2, 1}}, Automatic, \"Cyclic\"]}]\
\>", "Input",ExpressionUUID->"fb5a50c8-7bf6-354c-b116-b592476c6a85"],

