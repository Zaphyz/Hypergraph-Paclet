          Offset[0.27999999999999997`]}, "Rows" -> {
          Offset[0.2], {
           Offset[0.1]}, 
          Offset[0.2]}}], "\<\"Rigid\"\>"},
    {"3", "2", GridBox[{
       {"2"},
       {"2"}
      },
