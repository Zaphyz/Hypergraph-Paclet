Cell["\<\
Three ways to fit into that state, each consuming a different window of three \
edges:\
\>", "Text",ExpressionUUID->"15f1fe4c-ee7a-3641-a61e-f32dbaf2e595"],

Cell["EdgeLabel /@ EdgeList[#[\"Hypergraph\"]] & /@ zigzag[long]", "Input",ExpressionUUID->"d5af9f78-5425-ad43-9c7b-b004b35eab45"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     TemplateBox[{"\"(\"", "a", "b", "c", "\")\""},
      "RowDefault"], ",", "d", ",", "e"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"a", ",", "b", ",", 
     TemplateBox[{"\"(\"", "c", "d", "e", "\")\""},
      "RowDefault"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"a", ",", 
     TemplateBox[{"\"(\"", "d", "c", "b", "\")\""},
      "RowDefault"], ",", "e"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"3f4b6eec-63c1-2f47-83bc-b3acc1a88c29"],

Cell["\<\
Each of the three has one further match, and the three second steps are the \
three bracketings of the whole:\
\>", "Text",ExpressionUUID->"cd5713a6-dfdc-ee48-88bc-ec0fba6bb823"],

Cell["\<\
EdgeLabel /@ EdgeList[#[\"Hypergraph\"]] & /@
  Catenate[zigzag /@ (#[\"Hypergraph\"] & /@ zigzag[long])]\
\>", "Input",ExpressionUUID->"a518b502-f83c-6741-81a7-6505714573c9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    TemplateBox[{"\"(\"", 
      TemplateBox[{"\"(\"", "a", "b", "c", "\")\""}, "RowDefault"], "d", "e", 
      "\")\""},
     "RowDefault"], "}"}], ",", 
   RowBox[{"{", 
    TemplateBox[{"\"(\"", "a", "b", 
      TemplateBox[{"\"(\"", "c", "d", "e", "\")\""}, "RowDefault"], "\")\""},
     "RowDefault"], "}"}], ",", 
   RowBox[{"{", 
    TemplateBox[{"\"(\"", "a", 
      TemplateBox[{"\"(\"", "d", "c", "b", "\")\""}, "RowDefault"], "e", 
      "\")\""},
     "RowDefault"], "}"}]}], "}"}]], "Output",ExpressionUUID->"025ad540-ff79-\
444f-9de2-3b51120cde7c"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "((a b c) d e), (a b (c d e)) and (a (d c b) e): the reference calls the \
equality of these three heap associativity, and the middle one having its \
letters reversed is the point of it. Three distinct terms out of one state in \
two steps, from a rule carrying no labels of its own \[LongDash] every label \
in the result was carried out of the match by a variable. Which of the three \
a system reaches, and whether two of the steps could have been taken in \
either order, is what the causal machinery is for; section 6 of \
CausalityBasics.nb runs this same rule as a system."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"c450dd74-826f-464e-b266-71994674e61c"],

Cell["6. Pictures", "Section",ExpressionUUID->"b4cbe9c9-98e0-314c-982b-7eefc19b1ba9"],

Cell["\<\
A rule is a pair of hypergraphs, and a hypergraph is a thing to look at. \
Everything in this section is what the causal machinery uses to draw an event \
as a vertex of a graph, available on its own.\
\>", "Text",ExpressionUUID->"96dd50dd-34ca-6942-871f-31ac85c03ebc"],

Cell["A rule", "Subsection",ExpressionUUID->"69d3df98-bb8e-bf48-afd1-990bf0995b23"],

Cell["\<\
HypergraphRulePlot draws a rule as its input beside its output. The vertices \
the two sides share are drawn in the same places, so what the rule does to \
them can be read off rather than worked out:\
\>", "Text",ExpressionUUID->"decd74f7-9596-204f-afd6-a225b1a936f2"],

