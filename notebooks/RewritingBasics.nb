labelled],
  Length @ HypergraphRuleMatches[HypergraphRule[{Edge[{1, 2}, \"Directed\", \
\"a\"]}, {{2, 1}}], labelled]}\
\>", "Input",ExpressionUUID->"6c348a3f-ba3f-a040-8b6f-f665c5c9990d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "1"}], "}"}]], "Output",ExpressionUUID->"27c55a4a-b7bd-f14e-b994-2c4dc406860e"],

Cell["\<\
The labelled pattern finds the edge carrying that label, and only it:\
\>", "Text",ExpressionUUID->"4d61a120-dbd9-494e-8683-806340dddc71"],

Cell["\<\
First @ HypergraphRuleMatches[
  HypergraphRule[{Edge[{1, 2}, \"Directed\", \"a\"]}, {{2, 1}}], labelled]\
\>", "Input",ExpressionUUID->"5d281604-e6e6-7f4b-8652-4f28287321e0"],

