#[\"LabelBindings\"] & /@ HypergraphRuleMatches[
  HypergraphRule[{Edge[{1, 2}, \"Directed\", x]}, {}], composable]\
\>", "Input",ExpressionUUID->"4f1e9974-dd58-e84b-b506-9305a8cefaf5"],

