Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Choosing the first event each time is a choice made by hand, and it is \
exactly the choice a multiway system refuses to make: it keeps all of them, \
and the branching that results is what its evolution graph draws. Doing it by \
hand here shows what there is to keep."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"f916ea53-93ed-2642-862f-653bab9838c9"],

Cell["A rule with no match", "Subsection",ExpressionUUID->"05d92a52-ff9d-324c-b4d6-ce1ad203f988"],

Cell["\<\
A rule that does not apply gives no events, which is not a failure but an \
answer:\
\>", "Text",ExpressionUUID->"652484a2-b167-fb41-80ce-88aa07285f69"],

Cell["contract[Hypergraph[{Edge[{1, 2}]}]]", "Input",ExpressionUUID->"57e4913d-ccfb-224e-8ff8-5921077181b6"],

Cell[BoxData[
 RowBox[{"{", "}"}]], "Output",ExpressionUUID->"e39ebeb5-3413-084a-8236-bc3e6a6c3772"],

Cell["Every state one step away", "Subsection",ExpressionUUID->"1f0782c8-501a-0140-a93b-581479a42bd7"],

Cell["\<\
All the events at once, from a slightly larger hypergraph, as the states they \
lead to:\
\>", "Text",ExpressionUUID->"4e1916ee-777d-994a-a15a-8eec9d3dbc9f"],

Cell["\<\
star = Hypergraph[{Edge[{1, 2}], Edge[{1, 3}], Edge[{1, 4}]}]\
\>", "Input",ExpressionUUID->"a868d8fc-b18a-604a-b30f-574717edb00b"],

