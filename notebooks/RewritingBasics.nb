        ImageScaled[{-0.5, 0.5000000000000002}]], InsetBox[
        StyleBox[
         RowBox[{"\[FormalV]", "(", "1", ")"}],
         StripOnInput->False,
         LineColor->GrayLevel[0],
         FrontFaceColor->GrayLevel[0],
