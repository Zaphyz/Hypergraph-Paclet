Cell["A rule on a labelled chain", "Subsection",ExpressionUUID->"a5c584ab-1e95-8d49-8fa8-70842c908f1f"],

Cell["\<\
Rules and labels together: rewriting only the edges that carry a given label \
leaves the rest of the hypergraph alone.\
\>", "Text",ExpressionUUID->"b1c42d17-c9e0-794e-a4c4-026d65174bf3"],

Cell["\<\
mixed = Hypergraph[{Edge[{1, 2}, \"Directed\", \"x\"], Edge[{2, 3}, \
\"Directed\", \"y\"],
                    Edge[{3, 4}, \"Directed\", \"x\"]}]\
\>", "Input",ExpressionUUID->"f9b3a18a-42ec-174b-b037-c1b2c32aeb13"],

