         FrontFaceColor->GrayLevel[0],
         BackFaceColor->GrayLevel[0],
         GraphicsColor->GrayLevel[0],
         FontColor->GrayLevel[0]], {0., 1.2246467991473532*^-16}, 
        ImageScaled[{1.5, 0.4999999999999999}]]}}}]],
  Background->GrayLevel[1],
  ImagePadding->20,
  PlotRange->{{0., 1.}, {-0.16666666666666666`, 0.16666666666666677`}},
  PlotRangePadding->Scaled[0.02]]], "Output",ExpressionUUID->"aa0d99fd-90f2-\
a149-9f81-7f55f0f591e5"],

Cell["\<\
Applying it twice returns the edge to where it began, with the label \
recording that it was daggered twice rather than reduced:\
\>", "Text",ExpressionUUID->"d609fbe4-c00c-d640-a56e-952b9ab5049a"],

Cell["\<\
EdgeLabel /@ EdgeList @ \
First[dagger[First[dagger[objects]][\"Hypergraph\"]]][\"Hypergraph\"]\
\>", "Input",ExpressionUUID->"f11bf35a-450b-8a4f-a0ab-4f63988c1752"],

Cell[BoxData[
 RowBox[{"{", 
  TemplateBox[{"\"(\"", 
    SuperscriptBox[
     TemplateBox[{"\"(\"", 
       SuperscriptBox["u", "\[Dagger]"], "\")\""}, "RowDefault"], 
     "\[Dagger]"], "\")\""},
   "RowDefault"], "}"}]], "Output",ExpressionUUID->"900b1845-14ec-cc45-94ff-\
999ab378419c"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "That the label is not simplified is the right behaviour here: rewriting \
builds the expression, and whether the two daggers cancel is a fact about the \
algebra being modelled rather than about the rewriting. A rule asserting the \
involution would be a second rule, and the two together are what the \
reference notebooks use to check it."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"529f9414-aaf6-6448-a442-13815b8d48ad"],

Cell["\<\
A rule may also relabel. Where the output gives a vertex a label, that label \
is what the result carries; where it leaves one unlabelled, the hypergraph's \
own label stays:\
\>", "Text",ExpressionUUID->"2628c4b0-a125-014f-9e99-5f8d34d35930"],

Cell["\<\
swap = HypergraphRule[
  Hypergraph[{Vertex[1, p], Vertex[2, q]}, {Edge[{1, 2}, \"Directed\", x]}],
  Hypergraph[{Vertex[1, q], Vertex[2, p]}, {Edge[{1, 2}, \"Directed\", x]}]];
VertexLabel /@ VertexList @ First[swap[objects]][\"Hypergraph\"]\
\>", "Input",ExpressionUUID->"67460a3d-04c9-a545-9d78-c7b9c09d1687"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"s", ",", "r"}], "}"}]], "Output",ExpressionUUID->"4210b123-d1b6-594d-87e1-640badb29949"],

Cell["5. Worked examples", "Section",ExpressionUUID->"f4504e7a-9f4f-d34b-9e6b-556126b493a3"],

Cell["Growing a path", "Subsection",ExpressionUUID->"960d0017-5489-124b-a90d-f25982179c7a"],

Cell["\<\
Subdividing repeatedly. Taking the first event each time, an edge becomes a \
path:\
\>", "Text",ExpressionUUID->"8f9b98ae-810a-b742-8a46-9c22ab59e020"],

Cell["\<\
NestList[First[sub[#]][\"Hypergraph\"] &, Hypergraph[{Edge[{1, 2}]}], 3]\
\>", "Input",ExpressionUUID->"2bd41e24-613a-c245-9c5f-4b7813883995"],

