Cell["\<\
Three ways to fit into that state, each consuming a different window of three \
edges:\
\>", "Text",ExpressionUUID->"83096c64-85ec-b047-a549-d8adb2b74694"],

Cell["EdgeLabel /@ EdgeList[#[\"Hypergraph\"]] & /@ zigzag[long]", "Input",ExpressionUUID->"b86a45af-bced-d94c-9a15-f1df4b0c75fd"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     TemplateBox[{"\"(\"", "a", "b", "c", "\")\""},
      "RowDefault"], ",", "d", ",", "e"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"a", ",", "b", ",", 
     TemplateBox[{"\"(\"", "c", "d", "e", "\")\""},
      "RowDefault"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"a", ",", 
     TemplateBox[{"\"(\"", "d", "c", "b", "\")\""},
      "RowDefault"], ",", "e"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"425d7bb0-fb47-5c43-b61e-88301c485c63"],

Cell["\<\
Each of the three has one further match, and the three second steps are the \
three bracketings of the whole:\
\>", "Text",ExpressionUUID->"0c2a1f7e-497a-da4a-b2a9-e8df0fedb741"],

Cell["\<\
EdgeLabel /@ EdgeList[#[\"Hypergraph\"]] & /@
  Catenate[zigzag /@ (#[\"Hypergraph\"] & /@ zigzag[long])]\
\>", "Input",ExpressionUUID->"a6424e49-3eac-c146-a160-c908e4c730eb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    TemplateBox[{"\"(\"", 
      TemplateBox[{"\"(\"", "a", "b", "c", "\")\""}, "RowDefault"], "d", "e", 
      "\")\""},
     "RowDefault"], "}"}], ",", 
   RowBox[{"{", 
    TemplateBox[{"\"(\"", "a", "b", 
      TemplateBox[{"\"(\"", "c", "d", "e", "\")\""}, "RowDefault"], "\")\""},
     "RowDefault"], "}"}], ",", 
   RowBox[{"{", 
    TemplateBox[{"\"(\"", "a", 
      TemplateBox[{"\"(\"", "d", "c", "b", "\")\""}, "RowDefault"], "e", 
      "\")\""},
     "RowDefault"], "}"}]}], "}"}]], "Output",ExpressionUUID->"2004b70d-66fa-\
2f4d-b3f0-1386be4e8a14"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "((a b c) d e), (a b (c d e)) and (a (d c b) e): the reference calls the \
equality of these three heap associativity, and the middle one having its \
letters reversed is the point of it. Three distinct terms out of one state in \
two steps, from a rule carrying no labels of its own \[LongDash] every label \
in the result was carried out of the match by a variable. Which of the three \
a system reaches, and whether two of the steps could have been taken in \
either order, is what the causal machinery is for."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"5ed33492-3123-7b4b-a313-2c0cc33ed962"],

Cell["6. Worked examples", "Section",ExpressionUUID->"11133f2f-5878-ba45-8cd0-4faf418fb848"],

Cell["Growing a path", "Subsection",ExpressionUUID->"3d00591d-bfd6-b945-a501-c885b595c436"],

Cell["\<\
Subdividing repeatedly. Taking the first event each time, an edge becomes a \
path:\
\>", "Text",ExpressionUUID->"94f55641-217b-ac42-ba48-a69bf7486b1f"],

Cell["\<\
NestList[First[sub[#]][\"Hypergraph\"] &, Hypergraph[{Edge[{1, 2}]}], 3]\
\>", "Input",ExpressionUUID->"752b9a41-4875-4a4c-9d99-37d8bdbb635b"],

