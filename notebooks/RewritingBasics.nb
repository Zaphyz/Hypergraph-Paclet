Cell["A rule on a labelled chain", "Subsection",ExpressionUUID->"7498d10e-3ad2-484b-902f-e04151c04a8b"],

Cell["\<\
Rules and labels together: rewriting only the edges that carry a given label \
leaves the rest of the hypergraph alone.\
\>", "Text",ExpressionUUID->"727e077d-a87b-e44b-810b-d4a083a1a064"],

Cell["\<\
mixed = Hypergraph[{Edge[{1, 2}, \"Directed\", \"x\"], Edge[{2, 3}, \
\"Directed\", \"y\"],
                    Edge[{3, 4}, \"Directed\", \"x\"]}]\
\>", "Input",ExpressionUUID->"34301068-efe3-374e-bb22-5377bd1bb21a"],

