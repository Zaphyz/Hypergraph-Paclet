Cell["Creating and destroying", "Subsection",ExpressionUUID->"389c9bde-f5f1-0f4e-8794-9c620dbe61f5"],

Cell["\<\
An output that mentions fewer vertices than the input destroys the difference:\
\>", "Text",ExpressionUUID->"5d1fddff-0203-7c49-9179-ae485d73f9bb"],

