Cell["An event", "Subsection",ExpressionUUID->"6d51e283-1424-a54d-b828-69f61fbeed52"],

Cell["\<\
HypergraphEventPlot is the same idea applied to a particular match: what the \
event acted on with the match highlighted, an arrow, and what it made with \
the creations highlighted.\
\>", "Text",ExpressionUUID->"61cca087-f768-f34c-8a4d-1cabaa9e3052"],

Cell["\<\
shown = Hypergraph[{Edge[{1, 2}], Edge[{2, 3}], Edge[{3, 4}]}];

HypergraphEventPlot[First @ sub[shown], \"PanelSize\" -> 140]\
\>", "Input",ExpressionUUID->"6b2fd13a-5a05-b54f-9e83-a3c777ae5a23"],

