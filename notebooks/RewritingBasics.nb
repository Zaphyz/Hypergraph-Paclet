Cell["A rule on a labelled chain", "Subsection",ExpressionUUID->"3933a399-64f1-6740-94b3-48c9fef64167"],

Cell["\<\
Rules and labels together: rewriting only the edges that carry a given label \
leaves the rest of the hypergraph alone.\
\>", "Text",ExpressionUUID->"b0228d8d-258f-8b4b-bfd3-ebcc6ee0fda0"],

Cell["\<\
mixed = Hypergraph[{Edge[{1, 2}, \"Directed\", \"x\"], Edge[{2, 3}, \
\"Directed\", \"y\"],
                    Edge[{3, 4}, \"Directed\", \"x\"]}]\
\>", "Input",ExpressionUUID->"906dd909-088a-1b43-bded-d90322eea399"],

