Cell["\<\
This is the rule that subdivides an edge: where there was one edge from 1 to \
2, there will be two, through a vertex in the middle. The two sides are \
hypergraphs like any other, and draw themselves:\
\>", "Text",ExpressionUUID->"32aeb17a-8eff-4e40-bd6c-fc6412d8ede7"],

Cell["{sub[\"Input\"], sub[\"Output\"]}", "Input",ExpressionUUID->"c8926b5c-d9b4-f74c-8b42-54966cbcf3d3"],

