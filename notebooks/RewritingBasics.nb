labelled],
  Length @ HypergraphRuleMatches[HypergraphRule[{Edge[{1, 2}, \"Directed\", \
\"a\"]}, {{2, 1}}], labelled]}\
\>", "Input",ExpressionUUID->"3ad4741a-543e-bf46-8dde-bbc8971b179d"],

