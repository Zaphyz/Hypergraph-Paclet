    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"1", "\[Rule]", "1"}], ",", 
      RowBox[{"2", "\[Rule]", "2"}], ",", 
      RowBox[{"3", "\[Rule]", 
       RowBox[{"\[FormalV]", "[", "1", "]"}]}]}], "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"LabelBindings\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"Rule\"\>", "\[Rule]", 
