  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{"x", "\[Rule]", "f"}], "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{"x", "\[Rule]", "g"}], "\[RightAssociation]"}]}], "}"}]], "Output",\
ExpressionUUID->"c0fa424d-3bc7-1e4f-9413-d95a23f575db"],

Cell["\<\
One match per edge, and in each the variable x has been bound to the label it \
found. The output is an expression in those variables. This rule composes two \
edges and names the result after the two it consumed:\
\>", "Text",ExpressionUUID->"ea56d58b-3fe4-004d-af9f-be0a6023e31c"],

Cell["\<\
compose = HypergraphRule[
  {Edge[{1, 2}, \"Directed\", x], Edge[{2, 3}, \"Directed\", y]},
  {Edge[{1, 3}, \"Directed\", Row[{\"{\", x, y, \"}\"}]]}]\
\>", "Input",ExpressionUUID->"5f279299-5d97-9e40-b26a-0de249082668"],

