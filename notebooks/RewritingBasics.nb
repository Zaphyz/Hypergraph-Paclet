Cell["\<\
Vertices correspond between the two sides by name. So the rule can be read \
off: 1 and 2 appear on both sides and are kept, 3 appears only on the right \
and is therefore created.\
\>", "Text",ExpressionUUID->"2140c807-76a7-7942-a729-54eb7ee023c6"],

Cell["\<\
{sub[\"SharedVertices\"], sub[\"NewVertices\"], sub[\"DeletedVertices\"]}\
\>", "Input",ExpressionUUID->"759b0248-dd43-6244-b98e-74e6c17659f2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", "3", "}"}], ",", 
   RowBox[{"{", "}"}]}], "}"}]], "Output",ExpressionUUID->"22a522ea-c6ae-8f4a-\
bfd8-c636e2773056"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "A name on both sides means the same vertex, and nothing else in the rule \
says so. That is what makes a rule readable as a local surgery: the shared \
vertices are the seam along which the output is sewn in where the input was \
cut out."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"75d4f18e-2a39-6b4c-8e29-719b9baa9101"],

Cell["A vertex mentioned only on the left is destroyed:", "Text",ExpressionUUID->"4546f198-2bf4-e64d-b40b-b45230ee01c7"],

Cell["HypergraphRule[{{1, 2}}, {{1}}][\"DeletedVertices\"]", "Input",ExpressionUUID->"02ce4099-c33a-9d44-90c3-03619b8fcd89"],

Cell[BoxData[
 RowBox[{"{", "2", "}"}]], "Output",ExpressionUUID->"8765fd09-1fd3-f344-ac5e-f6124a149ae1"],

Cell["\<\
Rules are hypergraphs all the way down, so a side may carry symmetry types \
and labels:\
\>", "Text",ExpressionUUID->"6da4b329-c176-2544-86c8-9d5afb8c7592"],

Cell["\<\
HypergraphRule[{Edge[{1, 2, 3}, \"Unordered\", \"triple\"]}, {Edge[{1, 2}, \
\"Directed\"]}][\"Input\"]\
\>", "Input",ExpressionUUID->"affec347-73cc-624f-b6b4-673c65417c8b"],

