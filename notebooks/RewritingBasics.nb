labelled],
  Length @ HypergraphRuleMatches[HypergraphRule[{Edge[{1, 2}, \"Directed\", \
\"a\"]}, {{2, 1}}], labelled]}\
\>", "Input",ExpressionUUID->"33f2c059-d14f-7845-932e-30691bd9643b"],

