Cell["\<\
New vertices are named so as to miss everything already there:\
\>", "Text",ExpressionUUID->"620a6fb3-d259-0c4b-a2cc-b2f130bc2efb"],

Cell["\<\
{#[\"NewVertices\"], VertexList[#[\"Hypergraph\"]]} & @ First[sub[chain]]\
\>", "Input",ExpressionUUID->"55ce25b7-394d-e14b-95d1-9c31fedea3d4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[FormalV]", "[", "1", "]"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Vertex", "[", "1", "]"}], ",", 
     RowBox[{"Vertex", "[", "2", "]"}], ",", 
     RowBox[{"Vertex", "[", "3", "]"}], ",", 
     RowBox[{"Vertex", "[", 
      RowBox[{"\[FormalV]", "[", "1", "]"}], "]"}]}], "}"}]}], 
  "}"}]], "Output",ExpressionUUID->"14b33ab0-01a8-fa45-84a4-2b0980506306"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Fresh symbols would do here, and are what the reference uses, but names \
chosen to avoid what is present make a rewrite reproducible from one session \
to the next. That matters as soon as states are compared, which is the whole \
of what a multiway system does."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"805edf1d-ec8c-904d-9e78-4400dd6ced7e"],

Cell["4. Labels", "Section",ExpressionUUID->"10483e48-2a3f-ba41-8d91-d0d56c164582"],

Cell["\<\
Labels on a rule constrain what it applies to. A pattern carrying no label \
matches whatever it lies on, and one carrying a label matches only the same \
label, so labels only ever narrow a rule.\
\>", "Text",ExpressionUUID->"5250a589-6ef6-214f-8ac7-72b1da2d5655"],

Cell["\<\
labelled = Hypergraph[{Edge[{1, 2}, \"Directed\", \"a\"], Edge[{2, 3}, \
\"Directed\", \"b\"]}]\
\>", "Input",ExpressionUUID->"b7b99264-c4d3-1449-946f-f579594b9be4"],

