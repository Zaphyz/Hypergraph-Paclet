Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "A graph given coordinates for some of its vertices and not others lays out \
none of them, which is why this is not simply handed to the layout. The given \
positions are written over the automatic layout and the rest moved repeatedly \
to the middle of their neighbours until they settle. The helper vertex that \
stands for a large edge is moved the same way, to the centre of the vertices \
it serves \[LongDash] left where the automatic layout put it, it would drag \
the edge's boundary away from them."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"bf8a6da5-cdbf-7c42-b188-5983fe9a9f97"],

Cell["7. Worked examples", "Section",ExpressionUUID->"fab035da-cd70-ce4d-955a-4eb3272b044d"],

Cell["Growing a path", "Subsection",ExpressionUUID->"8ba36f16-eb44-2844-b470-97f86d462d39"],

Cell["\<\
Subdividing repeatedly. Taking the first event each time, an edge becomes a \
path:\
\>", "Text",ExpressionUUID->"be53ce41-11ab-7d44-991c-cc0bbf9382d5"],

Cell["\<\
NestList[First[sub[#]][\"Hypergraph\"] &, Hypergraph[{Edge[{1, 2}]}], 3]\
\>", "Input",ExpressionUUID->"43ee9b06-2956-b94d-8103-069e35c31297"],

