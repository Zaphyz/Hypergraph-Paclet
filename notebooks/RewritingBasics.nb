Cell["\<\
Three ways to fit into that state, each consuming a different window of three \
edges:\
\>", "Text",ExpressionUUID->"587571f8-6c60-0b41-abb2-c4f5e963c4ce"],

Cell["EdgeLabel /@ EdgeList[#[\"Hypergraph\"]] & /@ zigzag[long]", "Input",ExpressionUUID->"1ab032ec-0ece-0f49-b5a4-b09a54f30117"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     TemplateBox[{"\"(\"", "a", "b", "c", "\")\""},
      "RowDefault"], ",", "d", ",", "e"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"a", ",", "b", ",", 
     TemplateBox[{"\"(\"", "c", "d", "e", "\")\""},
      "RowDefault"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"a", ",", 
     TemplateBox[{"\"(\"", "d", "c", "b", "\")\""},
      "RowDefault"], ",", "e"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"85d9d9df-9d0f-024d-9c3d-a0e1ef6b2c3a"],

Cell["\<\
Each of the three has one further match, and the three second steps are the \
three bracketings of the whole:\
\>", "Text",ExpressionUUID->"92b26c56-2d04-fd4d-86aa-7a3d62e4cb12"],

Cell["\<\
EdgeLabel /@ EdgeList[#[\"Hypergraph\"]] & /@
  Catenate[zigzag /@ (#[\"Hypergraph\"] & /@ zigzag[long])]\
\>", "Input",ExpressionUUID->"cffcee21-431e-7b4a-be9f-61e16119578a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
