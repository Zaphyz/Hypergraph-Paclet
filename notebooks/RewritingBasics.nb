Cell["\<\
Acting twice moves the point along the chain, one arrow at a time:\
\>", "Text",ExpressionUUID->"06168f58-93d6-e244-bc82-05a7befcfb10"],

Cell["\<\
EdgeLabel /@ EdgeList[#[\"Hypergraph\"]] & /@
  Catenate[action /@ (#[\"Hypergraph\"] & /@ action[pointed])]\
\>", "Input",ExpressionUUID->"1c1c659d-f9be-1c48-a36f-2ca6263c7b49"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   TemplateBox[{"g", "\"[\"", 
     TemplateBox[{"f", "\"[\"", "u", "\"]\""}, "RowDefault"], "\"]\""},
    "RowDefault"], "}"}], "}"}]], "Output",ExpressionUUID->"aed93e6f-00df-\
e943-bf4a-dd254d6c3c83"],

Cell["\<\
Composing the two arrows first and acting once gives the other side of the \
associativity law:\
\>", "Text",ExpressionUUID->"e9e72649-c1b8-d540-bab0-cbf9bc9a0464"],

Cell["\<\
EdgeLabel /@ EdgeList[#[\"Hypergraph\"]] & /@
  Catenate[action /@ (#[\"Hypergraph\"] & /@ arrowComp[pointed])]\
\>", "Input",ExpressionUUID->"1a3a17fe-d833-0d46-bc5f-d76d188d22f6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   TemplateBox[{
     TemplateBox[{"\"(\"", "f", "g", "\")\""}, "RowDefault"], "\"[\"", "u", 
     "\"]\""},
    "RowDefault"], "}"}], "}"}]], "Output",ExpressionUUID->"c6e6c914-f929-\
d742-92e1-9ae52d213c49"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "The two results are g[f[u]] and (f g)[u]. Which of f and g ends up \
outermost is fixed by the composition convention, not by the rewriting: \
arrowComp writes the composite in diagram order, first arrow first, so acting \
through the composite applies f before g and the nested form has g outside. \
Writing the composite the other way round would swap them. Both rules match \
on the same structure either way."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"822fd900-5292-7745-b1f0-352e0af03e37"],

Cell["Zig-zag composition", "Subsection",ExpressionUUID->"a8a7bee3-617f-2c42-9a4b-d4460ef24997"],

Cell["\<\
The input of a rule need not be a directed path. This one matches three edges \
meeting at two shared vertices with the middle one reversed, and replaces \
them by a single edge across:\
\>", "Text",ExpressionUUID->"cefeb833-fa58-de42-bcae-78a94809cb12"],

Cell["\<\
zigzag = HypergraphRule[
  {Edge[{1, 2}, \"Directed\", x], Edge[{3, 2}, \"Directed\", y], Edge[{3, 4}, \
\"Directed\", z]},
  {Edge[{1, 4}, \"Directed\", Row[{\"(\", x, y, z, \")\"}]]}];
long = Hypergraph[{Edge[{1, 2}, \"Directed\", a], Edge[{3, 2}, \"Directed\", \
b],
                   Edge[{3, 4}, \"Directed\", c], Edge[{5, 4}, \"Directed\", \
d],
                   Edge[{5, 6}, \"Directed\", e]}]\
\>", "Input",ExpressionUUID->"c001a37e-d15a-954e-87a0-b7ae1960512c"],

