Cell["A rule on a labelled chain", "Subsection",ExpressionUUID->"a29d3561-8ba8-0346-9393-94e64dc90ab1"],

Cell["\<\
Rules and labels together: rewriting only the edges that carry a given label \
leaves the rest of the hypergraph alone.\
\>", "Text",ExpressionUUID->"52215661-137b-f54d-96e1-4103c8421549"],

Cell["\<\
mixed = Hypergraph[{Edge[{1, 2}, \"Directed\", \"x\"], Edge[{2, 3}, \
\"Directed\", \"y\"],
                    Edge[{3, 4}, \"Directed\", \"x\"]}]\
\>", "Input",ExpressionUUID->"de5d5863-d841-e44d-8695-ee972d32e05c"],

