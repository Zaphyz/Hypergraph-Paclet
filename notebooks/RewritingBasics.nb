nUUID->"088789cd-37d7-ef4a-8873-02d4457c0e42"],

Cell["Labels as variables", "Subsection",ExpressionUUID->"37fb11cc-09cd-0040-a9a7-b86058f3487e"],

Cell["\<\
So far the labels on a rule have been literals, narrowing what it applies to. \
They can do much more than that. A label on the input written as a bare \
symbol is a variable: it matches whatever label it is laid against and \
remembers it, and the output can then be named in terms of what was found.\
\>", "Text",ExpressionUUID->"e2c52ab4-9a7b-2d47-9051-7ceab06ae99a"],

Cell["\<\
composable = Hypergraph[{Edge[{1, 2}, \"Directed\", f], Edge[{2, 3}, \
\"Directed\", g]}]\
\>", "Input",ExpressionUUID->"701f87d3-864f-8244-93af-15164be3a2b5"],

