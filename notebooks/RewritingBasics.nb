Cell["A rule on a labelled chain", "Subsection",ExpressionUUID->"4786adc7-c683-9b4f-ba69-5c2e8f5e6107"],

Cell["\<\
Rules and labels together: rewriting only the edges that carry a given label \
leaves the rest of the hypergraph alone.\
\>", "Text",ExpressionUUID->"7e2b2cc3-2888-0b41-9752-720764802383"],

Cell["\<\
mixed = Hypergraph[{Edge[{1, 2}, \"Directed\", \"x\"], Edge[{2, 3}, \
\"Directed\", \"y\"],
                    Edge[{3, 4}, \"Directed\", \"x\"]}]\
\>", "Input",ExpressionUUID->"c85c3898-63d0-154c-802c-2d66faeb5393"],

