Cell["The four highlight styles", "Subsection",ExpressionUUID->"8e6f0b70-7c7f-3543-b43f-890f6256875f"],

Cell["\<\
The styles are four options, named as the reference paclet names them: left \
for what was matched, right for what was made, and a vertex and an edge style \
on each side.\
\>", "Text",ExpressionUUID->"ada7c2c4-4adf-504e-847f-b9a82cd02615"],

Cell["\<\
HypergraphEventPlot[First @ sub[shown], \"PanelSize\" -> 140,
  \"HighlightLeftEdgeStyle\" -> Directive[Thick, Blue, \
EdgeForm[Directive[Blue, Thick]]],
  \"HighlightLeftVertexStyle\" -> Directive[PointSize[0.03], Blue],
  \"HighlightRightEdgeStyle\" -> Directive[Thick, Darker[Green], \
EdgeForm[Directive[Darker[Green], Thick]]],
  \"HighlightRightVertexStyle\" -> Directive[PointSize[0.03], Darker[Green]]]\
\
\>", "Input",ExpressionUUID->"d8edd5ae-e959-0044-b278-b7c1f64e1543"],

