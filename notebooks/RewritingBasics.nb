        ImageScaled[{1.5, 0.49999999999999983}]], InsetBox[
        StyleBox["2",
         StripOnInput->False,
         LineColor->GrayLevel[0],
         FrontFaceColor->GrayLevel[0],
         BackFaceColor->GrayLevel[0],
         GraphicsColor->GrayLevel[0],
         FontColor->GrayLevel[0]], {1., 2.4492935982947064*^-16}, 
        ImageScaled[{0.5, -0.5}]], InsetBox[
        StyleBox["3",
         StripOnInput->False,
         LineColor->GrayLevel[0],
         FrontFaceColor->GrayLevel[0],
         BackFaceColor->GrayLevel[0],
         GraphicsColor->GrayLevel[0],
         FontColor->GrayLevel[0]], {2., 0.}, 
        ImageScaled[{-0.5, 0.5000000000000002}]]}}}]],
  Background->GrayLevel[1],
  ImagePadding->20,
  PlotRange->{{0., 2.}, {-0.3333333333333333, 0.3333333333333337}},
  PlotRangePadding->Scaled[0.02]]], "Output",ExpressionUUID->"7bfca9a2-9483-\
2240-ba18-a78a1f933503"],

Cell["HypergraphRuleMatches[sub, chain]", "Input",ExpressionUUID->"73636797-3cb6-f940-82dc-4352d2b2d183"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"MatchEdgePositions\"\>", "\[Rule]", 
      RowBox[{"{", "1", "}"}]}], ",", 
     RowBox[{"\<\"RuleVertexMap\"\>", "\[Rule]", 
      RowBox[{"\[LeftAssociation]", 
       RowBox[{
        RowBox[{"1", "\[Rule]", "1"}], ",", 
        RowBox[{"2", "\[Rule]", "2"}]}], "\[RightAssociation]"}]}], ",", 
     RowBox[{"\<\"LabelBindings\"\>", "\[Rule]", 
      RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}]}], 
    "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"MatchEdgePositions\"\>", "\[Rule]", 
      RowBox[{"{", "2", "}"}]}], ",", 
     RowBox[{"\<\"RuleVertexMap\"\>", "\[Rule]", 
      RowBox[{"\[LeftAssociation]", 
       RowBox[{
        RowBox[{"1", "\[Rule]", "2"}], ",", 
        RowBox[{"2", "\[Rule]", "3"}]}], "\[RightAssociation]"}]}], ",", 
     RowBox[{"\<\"LabelBindings\"\>", "\[Rule]", 
      RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}]}], 
    "\[RightAssociation]"}]}], "}"}]], "Output",ExpressionUUID->"658a3547-\
5419-5144-b8a7-69d46d223dd2"],

Cell["\<\
Two matches, because the single edge of the input can lie on either edge of \
the chain. Each match says which positions of EdgeList it used and how the \
input's vertices correspond to the hypergraph's.\
\>", "Text",ExpressionUUID->"44bf87d4-53f3-294b-bfe8-560ab322d26d"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Asking for the matches without rewriting is the way to see why a rule \
applies as often as it does. When a rule produces more events than expected, \
it is almost always the matching that is surprising rather than the rewriting."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"bdb201cb-b603-fc43-b91f-e4f1d46a53e6"],

Cell["What a rule knows about itself", "Subsection",ExpressionUUID->"661b53b0-e156-e04c-8cfe-9691b957c368"],

Cell["\<\
A rule answers for its two sides and for what it does to vertices, read off \
by identifier:\
\>", "Text",ExpressionUUID->"7b024fb3-6f33-2649-adc5-ef014d1322c3"],

Cell["sub[\"Properties\"]", "Input",ExpressionUUID->"137fed9b-8255-3949-beda-f793688c59ae"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Input\"\>", ",", "\<\"Output\"\>", 
   ",", "\<\"SharedVertices\"\>", ",", "\<\"NewVertices\"\>", 
   ",", "\<\"DeletedVertices\"\>", ",", "\<\"Signature\"\>"}], 
  "}"}]], "Output",ExpressionUUID->"e053aff8-446c-c54b-a5f0-5198bdc741a0"],

Cell["\<\
AssociationMap[sub, {\"SharedVertices\", \"NewVertices\", \
\"DeletedVertices\", \"Signature\"}]\
\>", "Input",ExpressionUUID->"69821faa-6be7-af46-8757-5a4e83aa6522"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"SharedVertices\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}]}], ",", 
   RowBox[{"\<\"NewVertices\"\>", "\[Rule]", 
    RowBox[{"{", "3", "}"}]}], ",", 
   RowBox[{"\<\"DeletedVertices\"\>", "\[Rule]", 
    RowBox[{"{", "}"}]}], ",", 
   RowBox[{"\<\"Signature\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "3"}], "}"}]}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",ExpressionUUID->"8f08001d-f604-0646-ba2d-\
20a691b3a924"],

Cell["\<\
\"Signature\" is the shape of the rule: how many edges and vertices on each \
side. A rule that contracts rather than grows has it the other way round:\
\>", "Text",ExpressionUUID->"ecfc8f10-760b-3840-9e20-4e6702cf8b54"],

Cell["\<\
contract = HypergraphRule[{{1, 2}, {2, 3}}, {{1, 3}}];
AssociationMap[contract, {\"SharedVertices\", \"NewVertices\", \
\"DeletedVertices\", \"Signature\"}]\
\>", "Input",ExpressionUUID->"41046e1c-9fae-004d-9723-cd5f3e6e672d"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"SharedVertices\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1", ",", "3"}], "}"}]}], ",", 
   RowBox[{"\<\"NewVertices\"\>", "\[Rule]", 
    RowBox[{"{", "}"}]}], ",", 
   RowBox[{"\<\"DeletedVertices\"\>", "\[Rule]", 
    RowBox[{"{", "2", "}"}]}], ",", 
   RowBox[{"\<\"Signature\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"2", ",", "3"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}]}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",ExpressionUUID->"9a1c19a9-aee0-0c49-9fc4-\
39ba223803bf"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Vertices correspond between the two sides by identifier, so a name on both \
sides is the same vertex and a name on the output alone is a new one. That is \
the whole of the convention, and these three lists are it applied."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"f5d7d651-05df-bc46-b6af-3363bbcb44fe"],

Cell["The matching options", "Subsection",ExpressionUUID->"c84a2adf-ebeb-ad44-b0f9-de37eb914898"],

Cell["\<\
Three options govern what counts as a match. \"Labeled\" -> False puts labels \
aside altogether, so a rule written for skeletons applies to a labelled \
hypergraph:\
\>", "Text",ExpressionUUID->"a180793e-6e24-4d49-90b5-bb405cd109bc"],

Cell["\<\
labelledPair = Hypergraph[{Edge[{1, 2}, \"Directed\", \"a\"], Edge[{2, 3}, \
\"Directed\", \"b\"]}];
{Length @ HypergraphRuleMatches[HypergraphRule[{Edge[{1, 2}, \"Directed\", \
\"c\"]}, {}], labelledPair],
  Length @ HypergraphRuleMatches[HypergraphRule[{Edge[{1, 2}, \"Directed\", \
\"c\"]}, {}], labelledPair,
     \"Labeled\" -> False]}\
\>", "Input",ExpressionUUID->"45d193ca-2562-0444-8b5a-47227d054bc3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "2"}], "}"}]], "Output",ExpressionUUID->"bf2edda3-36be-8042-a163-ecc30edb5f5d"],

Cell["\<\
\"LabelPatterns\" -> False reads every label literally, so a bare symbol \
stops being a variable. Section 4 is about what that option turns on:\
\>", "Text",ExpressionUUID->"9707e153-f38f-3a4e-94c0-887fb3153fc8"],

Cell["\<\
{Length @ HypergraphRuleMatches[HypergraphRule[{Edge[{1, 2}, \"Directed\", \
w]}, {}], labelledPair],
  Length @ HypergraphRuleMatches[HypergraphRule[{Edge[{1, 2}, \"Directed\", \
w]}, {}], labelledPair,
     \"LabelPatterns\" -> False]}\
\>", "Input",ExpressionUUID->"7ea41537-b77f-7441-9778-a821d5ee35c9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "0"}], "}"}]], "Output",ExpressionUUID->"91799208-9c35-104e-8a23-26c241c37039"],

Cell["\<\
\"DistinctVertices\" -> False lets two vertices of the input fall on one \
vertex of the hypergraph, which is what the next subsection is about:\
\>", "Text",ExpressionUUID->"6caddc1b-e2be-df4d-a196-71879f38e6ea"],

Cell["\<\
{Length @ HypergraphRuleMatches[HypergraphRule[{{1, 2}, {2, 3}}, {}], \
Hypergraph[{{1, 2}}]],
  Length @ HypergraphRuleMatches[HypergraphRule[{{1, 2}, {2, 3}}, {}], \
Hypergraph[{{1, 2}}],
     \"DistinctVertices\" -> False]}\
\>", "Input",ExpressionUUID->"506802e1-13e4-5f4b-b91e-df70caa56691"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "0"}], "}"}]], "Output",ExpressionUUID->"1ea79ecf-dcd7-334c-9f77-66877b98e668"],

Cell["\<\
A match on its own says only where it sits: which positions of EdgeList it \
used, how the input's vertices correspond, and what its label variables were \
bound to.\
\>", "Text",ExpressionUUID->"edd0f59c-23a8-2e4c-8717-11c6e6d2be05"],

Cell["Keys @ First @ HypergraphRuleMatches[sub, chain]", "Input",ExpressionUUID->"04eedcff-6ac4-9543-95dd-d9863cd7d257"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"MatchEdgePositions\"\>", ",", "\<\"RuleVertexMap\"\>", 
   ",", "\<\"LabelBindings\"\>"}], "}"}]], "Output",ExpressionUUID->"75c1036d-\
390a-1c48-a5b8-aad3c4ae3507"],

Cell["Symmetry decides how many ways a pattern fits", "Subsection",ExpressionUUID->"c5972ff7-3585-a848-b38a-b8f58a19145a"],

Cell["\<\
A pattern edge and the edge it lies on must have the same symmetry type, and \
the pattern is matched over the orderings that type allows. A directed edge \
of arity three fits one way, a cyclic one three ways, an unordered one all \
six:\
\>", "Text",ExpressionUUID->"a297cf07-9e89-5e4e-96f6-7de2d513ce72"],

Cell["\<\
Table[
  Length @ HypergraphRuleMatches[
    HypergraphRule[{Edge[{1, 2, 3}, s]}, {}], Hypergraph[{Edge[{1, 2, 3}, \
s]}]],
  {s, {\"Directed\", \"Cyclic\", \"Unordered\"}}]\
\>", "Input",ExpressionUUID->"3513aee1-332a-ad4d-9d07-2222850f73a4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "3", ",", "6"}], "}"}]], "Output",ExpressionUUID->\
"4d607db4-82bc-d749-91c8-cd5f70532e7e"],

Cell["\<\
And the types have to agree, so a directed pattern finds nothing in an \
unordered edge:\
\>", "Text",ExpressionUUID->"0164b838-f316-b646-bfd0-e7fb9178c8da"],

Cell["\<\
HypergraphRuleMatches[HypergraphRule[{Edge[{1, 2}, \"Directed\"]}, {}],
  Hypergraph[{Edge[{1, 2}, \"Unordered\"]}]]\
\>", "Input",ExpressionUUID->"11cddfc8-6937-a349-85f0-320c8beb47f3"],

Cell[BoxData[
 RowBox[{"{", "}"}]], "Output",ExpressionUUID->"3e8cc28f-4cea-e541-a86e-12862a96c037"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Those six matches of an unordered triple are genuinely six, not one \
reported six times: they differ in which vertex of the hypergraph each vertex \
of the rule corresponds to, and an output that treats its vertices \
differently will produce six different results. When the output is symmetric \
too, the six results coincide, and the multiplicity is then something to \
divide out rather than something wrong."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"143a14f8-27c6-c648-b535-bc5010460157"],

Cell["Two vertices of a rule do not fold onto one", "Subsection",ExpressionUUID->"0e5eb921-42ae-b446-b32e-6a84b0110a6c"],

Cell["\<\
By default distinct vertices of the input match distinct vertices of the \
hypergraph, so a two-vertex pattern does not fit a self-loop:\
\>", "Text",ExpressionUUID->"a6eb73e0-8876-c948-8029-f3ff5b0d4e98"],

Cell["\<\
{HypergraphRuleMatches[HypergraphRule[{{1, 2}}, {}], Hypergraph[{Edge[{1, \
1}]}]],
  Length @ HypergraphRuleMatches[HypergraphRule[{{1, 2}}, {}], \
Hypergraph[{Edge[{1, 1}]}],
     \"DistinctVertices\" -> False]}\
\>", "Input",ExpressionUUID->"8f31d812-b794-cc4c-89a8-73254e5c8924"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "}"}], ",", "1"}], "}"}]], "Output",ExpressionUUID->"744cf069-\
b67b-524d-9878-d05a3ed1bc89"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "This follows the reference paclet, which imposes the same by default. It is \
worth knowing that it is a choice: in the Wolfram model a rule's vertices \
need not be distinct, and \"DistinctVertices\" -> False is that convention."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"24eff1a4-0cc5-f342-abc4-4a020cc1e96b"],

Cell["An edge is used once", "Subsection",ExpressionUUID->"3b8896c6-4d5a-b149-9652-5c7230306940"],

Cell["\<\
Each edge of the hypergraph is used by at most one edge of the input, so a \
rule wanting two edges wants two of them:\
\>", "Text",ExpressionUUID->"1f3f1f1e-03f6-b448-8b07-416ba59b5b0f"],

Cell["\<\
{HypergraphRuleMatches[HypergraphRule[{{1, 2}, {1, 2}}, {}], \
Hypergraph[{Edge[{1, 2}]}]],
  Length @ HypergraphRuleMatches[HypergraphRule[{{1, 2}, {1, 2}}, {}],
     Hypergraph[{Edge[{1, 2}], Edge[{1, 2}]}]]}\
\>", "Input",ExpressionUUID->"8609cd3b-ec85-674d-9445-cfe13c2b868f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "}"}], ",", "2"}], "}"}]], "Output",ExpressionUUID->"821bf3d8-\
e5e6-a64c-a57b-9d856976e395"],

Cell["3. Applying a rule: events", "Section",ExpressionUUID->"6e0b6b13-1091-204b-ac1d-7c06e9ce2be5"],

Cell["\<\
Applying a rule gives one event for every match. An event is an association: \
it says what the hypergraph became, and also what was matched, what was \
created and what was destroyed.\
\>", "Text",ExpressionUUID->"fa25859e-0f60-0d47-a001-1a22a97d3bd7"],

Cell["\<\
events = sub[chain];
Length[events]\
\>", "Input",ExpressionUUID->"f6fa7826-bb3f-644e-9e48-72269587ef14"],

Cell[BoxData["2"], "Output",ExpressionUUID->"a5cd1e97-d440-fd40-9995-f53887355caf"],

Cell["Keys @ First[events]", "Input",ExpressionUUID->"25cae99e-e2b8-b949-bbe4-86283113347e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Hypergraph\"\>", ",", "\<\"Input\"\>", 
   ",", "\<\"EdgeOrigins\"\>", ",", "\<\"MatchVertices\"\>", 
   ",", "\<\"MatchEdges\"\>", ",", "\<\"MatchEdgePositions\"\>", 
   ",", "\<\"NewVertices\"\>", ",", "\<\"NewEdges\"\>", 
   ",", "\<\"DeletedVertices\"\>", ",", "\<\"RuleVertexMap\"\>", 
   ",", "\<\"LabelBindings\"\>", ",", "\<\"Rule\"\>"}], "}"}]], "Output",Expre\
ssionUUID->"39c785f6-58c7-fb49-ad81-cac5fb42b459"],

Cell["\<\
The two results, drawn. Each has subdivided one of the two edges:\
\>", "Text",ExpressionUUID->"441ae79e-d2f4-5e4a-98a3-f9de2b5b58bf"],

Cell["#[\"Hypergraph\"] & /@ events", "Input",ExpressionUUID->"3a24dcd9-575f-0f48-8564-63528ab6181c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   GraphicsBox[
    NamespaceBox["Hypergraphs",
     DynamicModuleBox[{Typeset`hg = HoldComplete[
       WolframInstitute`Hypergraphs`Hypergraph[{
