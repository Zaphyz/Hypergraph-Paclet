Cell["A rule that consumes two edges", "Subsection",ExpressionUUID->"3d9ae9d7-4eca-3944-952c-2469355b20c3"],

Cell["\<\
The input may have several edges. This one contracts a path of two edges into \
one:\
\>", "Text",ExpressionUUID->"840b1337-cd22-b042-94a1-37bcaab87652"],

