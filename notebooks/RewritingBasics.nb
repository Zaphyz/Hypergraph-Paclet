Cell["Styling a hypergraph, one element at a time", "Subsection",ExpressionUUID->"3a34a12f-de3f-0e48-9bdd-32a35e5da498"],

Cell["\<\
All of the above rests on HypergraphPlot taking a style per element. A single \
directive styles everything:\
\>", "Text",ExpressionUUID->"81285905-748e-c142-ae56-fa6ed71c585c"],

Cell["\<\
styled = Hypergraph[{Edge[{1, 2}], Edge[{2, 3}], Edge[{1, 2}], Edge[{1, 2, \
3}]}];
HypergraphPlot[styled, EdgeStyle -> Directive[Thick, Purple], VertexStyle -> \
Orange,
  ImageSize -> 220]\
\>", "Input",ExpressionUUID->"559b4b40-1782-844c-ab95-8364a11d6a5e"],

