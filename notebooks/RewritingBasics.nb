Cell["\<\
Vertices correspond between the two sides by name. So the rule can be read \
off: 1 and 2 appear on both sides and are kept, 3 appears only on the right \
and is therefore created.\
\>", "Text",ExpressionUUID->"f574ac69-a31f-4947-aae8-67aa6a089d1a"],

Cell["\<\
{sub[\"SharedVertices\"], sub[\"NewVertices\"], sub[\"DeletedVertices\"]}\
\>", "Input",ExpressionUUID->"bb8466dd-bd73-8347-82a2-01b36cd4c87e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", "3", "}"}], ",", 
   RowBox[{"{", "}"}]}], "}"}]], "Output",ExpressionUUID->"805ccee0-ed54-7948-\
b9fc-166440d8bfc7"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "A name on both sides means the same vertex, and nothing else in the rule \
says so. That is what makes a rule readable as a local surgery: the shared \
vertices are the seam along which the output is sewn in where the input was \
cut out."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"c1cff2be-a533-5448-ac44-7c5b21231226"],

Cell["A vertex mentioned only on the left is destroyed:", "Text",ExpressionUUID->"58e0cbcf-988c-ac47-ac6d-c6b3ef5f536e"],

Cell["HypergraphRule[{{1, 2}}, {{1}}][\"DeletedVertices\"]", "Input",ExpressionUUID->"0d556465-baab-b348-bf7c-6d9f54ca4238"],

Cell[BoxData[
 RowBox[{"{", "2", "}"}]], "Output",ExpressionUUID->"9695e6f2-16eb-1645-81df-b25ede344afd"],

Cell["\<\
Rules are hypergraphs all the way down, so a side may carry symmetry types \
and labels:\
\>", "Text",ExpressionUUID->"605cd4b3-e237-f745-a25d-a3fa3136a27f"],

Cell["\<\
HypergraphRule[{Edge[{1, 2, 3}, \"Unordered\", \"triple\"]}, {Edge[{1, 2}, \
\"Directed\"]}][\"Input\"]\
\>", "Input",ExpressionUUID->"fc22f56e-61e7-c745-a308-15d0bd173d1b"],

