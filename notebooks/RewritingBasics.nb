Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "An event is reported rather than just a result because a result on its own \
forgets how it came about. Which edges were consumed and which were produced \
is exactly what decides whether two events could have happened in either \
order, so the causal machinery to come needs all of it. Returning it now \
costs nothing and means that machinery will not have to match the rule a \
second time."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"f71b2b7e-2dcc-454b-ac1a-9d1b229834ef"],

Cell["\<\
rule[hg] and HypergraphRuleApply are the same thing, the first being the \
reference paclet's way of writing it:\
\>", "Text",ExpressionUUID->"86ce18c3-6449-054d-975e-d3bf863c97be"],

Cell["sub[chain] === HypergraphRuleApply[sub, chain]", "Input",ExpressionUUID->"31d29a76-5125-cb48-b7de-fe22377ebc95"],

Cell[BoxData["True"], "Output",ExpressionUUID->"b4d95015-9be3-444c-afa3-58d0127bff72"],

Cell["A rule that consumes two edges", "Subsection",ExpressionUUID->"5da2880b-38ab-8149-8eed-ecafa9471f47"],

Cell["\<\
The input may have several edges. This one contracts a path of two edges into \
one:\
\>", "Text",ExpressionUUID->"71ff6051-b0b8-5147-9672-32c39c38b996"],

