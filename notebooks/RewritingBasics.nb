      TemplateBox[{"\"(\"", "a", "b", "c", "\")\""}, "RowDefault"], "d", "e", 
      "\")\""},
     "RowDefault"], "}"}], ",", 
   RowBox[{"{", 
    TemplateBox[{"\"(\"", "a", "b", 
      TemplateBox[{"\"(\"", "c", "d", "e", "\")\""}, "RowDefault"], "\")\""},
     "RowDefault"], "}"}], ",", 
   RowBox[{"{", 
    TemplateBox[{"\"(\"", "a", 
      TemplateBox[{"\"(\"", "d", "c", "b", "\")\""}, "RowDefault"], "e", 
      "\")\""},
     "RowDefault"], "}"}]}], "}"}]], "Output",ExpressionUUID->"844a6b3a-eba6-\
2c49-a8a4-2beebbdacdc2"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "((a b c) d e), (a b (c d e)) and (a (d c b) e): the reference calls the \
equality of these three heap associativity, and the middle one having its \
letters reversed is the point of it. Three distinct terms out of one state in \
two steps, from a rule carrying no labels of its own \[LongDash] every label \
in the result was carried out of the match by a variable. Which of the three \
a system reaches, and whether two of the steps could have been taken in \
either order, is what the causal machinery is for; section 6 of \
CausalityBasics.nb runs this same rule as a system."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"112925ae-b363-b74a-add2-3d27cc27bb5c"],

Cell["6. Pictures", "Section",ExpressionUUID->"efc01ffc-09c0-9a45-b7f4-10a7454bffb1"],

Cell["\<\
A rule is a pair of hypergraphs, and a hypergraph is a thing to look at. \
Everything in this section is what the causal machinery uses to draw an event \
as a vertex of a graph, available on its own.\
\>", "Text",ExpressionUUID->"7d20c2ab-122f-a349-8d16-76afcb28af7a"],

Cell["A rule", "Subsection",ExpressionUUID->"9bd0c34c-1119-4e4c-83b7-067745151f16"],

Cell["\<\
HypergraphRulePlot draws a rule as its input beside its output. The vertices \
the two sides share are drawn in the same places, so what the rule does to \
them can be read off rather than worked out:\
\>", "Text",ExpressionUUID->"792d73bd-f22d-0141-8d1a-a8700b5b8862"],

