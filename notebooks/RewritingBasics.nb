Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "The reference paclet's events carry \"Hypergraph\", \"MatchVertices\", \
\"MatchEdges\", \"MatchEdgePositions\", \"NewVertices\", \"NewEdges\", \
\"DeletedVertices\" and \"RuleVertexMap\", and a rule written for it reads \
the same here. The three extra keys are \"Input\", without which an event \
cannot be drawn; \"LabelBindings\", which is the label machinery of section \
4; and \"EdgeOrigins\", which is what lets an element be followed across a \
rewrite."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"fd44d478-e641-c040-8328-19a632289e24"],

