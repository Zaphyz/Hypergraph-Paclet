Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Choosing the first event each time is a choice made by hand, and it is \
exactly the choice a multiway system refuses to make: it keeps all of them, \
and the branching that results is what its evolution graph draws. Doing it by \
hand here shows what there is to keep."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"b11a9ed3-ae4b-c547-a676-89f13252d701"],

Cell["A rule with no match", "Subsection",ExpressionUUID->"81cfd222-1367-ce4b-bd71-d4695b56b051"],

Cell["\<\
A rule that does not apply gives no events, which is not a failure but an \
answer:\
\>", "Text",ExpressionUUID->"72d308cc-fe45-aa4f-b539-089181a8b3a8"],

Cell["contract[Hypergraph[{Edge[{1, 2}]}]]", "Input",ExpressionUUID->"d07c5b4f-77cb-c041-80b2-7e85890338a6"],

Cell[BoxData[
 RowBox[{"{", "}"}]], "Output",ExpressionUUID->"0bc5e812-12c2-044e-aee7-fe3f6801c4fc"],

Cell["Every state one step away", "Subsection",ExpressionUUID->"80c3d5d5-4910-8540-ba86-c4407b6bbb17"],

Cell["\<\
All the events at once, from a slightly larger hypergraph, as the states they \
lead to:\
\>", "Text",ExpressionUUID->"8051b671-1e0d-9c42-aeee-0a2d89d2491e"],

Cell["\<\
star = Hypergraph[{Edge[{1, 2}], Edge[{1, 3}], Edge[{1, 4}]}]\
