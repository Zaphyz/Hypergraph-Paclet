Cell["\<\
Vertices correspond between the two sides by name. So the rule can be read \
off: 1 and 2 appear on both sides and are kept, 3 appears only on the right \
and is therefore created.\
\>", "Text",ExpressionUUID->"22cc01e1-47d4-1c42-a1e3-e24113a61c9a"],

Cell["\<\
{sub[\"SharedVertices\"], sub[\"NewVertices\"], sub[\"DeletedVertices\"]}\
\>", "Input",ExpressionUUID->"4d81209f-9077-2444-85ca-c50ac47cda2e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", "3", "}"}], ",", 
   RowBox[{"{", "}"}]}], "}"}]], "Output",ExpressionUUID->"6259dff8-a51d-3842-\
8d36-eda80ef5295e"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "A name on both sides means the same vertex, and nothing else in the rule \
says so. That is what makes a rule readable as a local surgery: the shared \
vertices are the seam along which the output is sewn in where the input was \
cut out."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"00ff3509-a68a-014e-ba2c-c419293bb77d"],

Cell["A vertex mentioned only on the left is destroyed:", "Text",ExpressionUUID->"eee23302-6d98-404e-ad2a-621efb5ff43f"],

Cell["HypergraphRule[{{1, 2}}, {{1}}][\"DeletedVertices\"]", "Input",ExpressionUUID->"479ab8ca-1beb-9048-a773-75b280c9e679"],

Cell[BoxData[
 RowBox[{"{", "2", "}"}]], "Output",ExpressionUUID->"df971706-aa81-794d-8f13-5e77a587d2c2"],

Cell["\<\
Rules are hypergraphs all the way down, so a side may carry symmetry types \
and labels:\
\>", "Text",ExpressionUUID->"07060e2f-8835-9044-91a8-bea4a4c8e6f3"],

Cell["\<\
HypergraphRule[{Edge[{1, 2, 3}, \"Unordered\", \"triple\"]}, {Edge[{1, 2}, \
\"Directed\"]}][\"Input\"]\
\>", "Input",ExpressionUUID->"827400f2-4cb7-7e4e-b178-ddf2d072e721"],

