         FrontFaceColor->GrayLevel[0],
         BackFaceColor->GrayLevel[0],
         GraphicsColor->GrayLevel[0],
         FontColor->GrayLevel[0]], {0., 3.6739403974420594*^-16}, 
        ImageScaled[{1.5, 0.49999999999999983}]], InsetBox[
        StyleBox["2",
         StripOnInput->False,
         LineColor->GrayLevel[0],
         FrontFaceColor->GrayLevel[0],
         BackFaceColor->GrayLevel[0],
         GraphicsColor->GrayLevel[0],
         FontColor->GrayLevel[0]], {1., 2.4492935982947064*^-16}, NCache[
        ImageScaled[{Rational[1, 2], Rational[-1, 2]}], 
         ImageScaled[{0.5, -0.5}]]], InsetBox[
        StyleBox["3",
         StripOnInput->False,
         LineColor->GrayLevel[0],
         FrontFaceColor->GrayLevel[0],
         BackFaceColor->GrayLevel[0],
         GraphicsColor->GrayLevel[0],
         FontColor->GrayLevel[0]], {2., 0.}, 
        ImageScaled[{-0.5, 0.5000000000000002}]]}}}]],
  Background->GrayLevel[1],
  ImagePadding->19,
  PlotRange->{{0., 2.}, {-0.3333333333333333, 0.3333333333333337}},
  PlotRangePadding->Scaled[0.02]]], "Output",ExpressionUUID->"eebaecb8-85a5-\
4742-a377-4f66d815ba7b"],

Cell["HypergraphRuleMatches[sub, chain]", "Input",ExpressionUUID->"7625fbe0-8637-224e-a39e-8c9f30239f9d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"MatchEdgePositions\"\>", "\[Rule]", 
      RowBox[{"{", "1", "}"}]}], ",", 
     RowBox[{"\<\"RuleVertexMap\"\>", "\[Rule]", 
      RowBox[{"\[LeftAssociation]", 
       RowBox[{
        RowBox[{"1", "\[Rule]", "1"}], ",", 
        RowBox[{"2", "\[Rule]", "2"}]}], "\[RightAssociation]"}]}], ",", 
     RowBox[{"\<\"LabelBindings\"\>", "\[Rule]", 
      RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}]}], 
    "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"MatchEdgePositions\"\>", "\[Rule]", 
      RowBox[{"{", "2", "}"}]}], ",", 
     RowBox[{"\<\"RuleVertexMap\"\>", "\[Rule]", 
      RowBox[{"\[LeftAssociation]", 
       RowBox[{
        RowBox[{"1", "\[Rule]", "2"}], ",", 
        RowBox[{"2", "\[Rule]", "3"}]}], "\[RightAssociation]"}]}], ",", 
     RowBox[{"\<\"LabelBindings\"\>", "\[Rule]", 
      RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}]}], 
    "\[RightAssociation]"}]}], "}"}]], "Output",ExpressionUUID->"01ffce3d-\
584f-8141-b112-4b548db3914c"],

Cell["\<\
Two matches, because the single edge of the input can lie on either edge of \
the chain. Each match says which positions of EdgeList it used and how the \
input's vertices correspond to the hypergraph's.\
\>", "Text",ExpressionUUID->"48f23dd7-b757-ff45-895a-94e398d9f83e"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Asking for the matches without rewriting is the way to see why a rule \
applies as often as it does. When a rule produces more events than expected, \
it is almost always the matching that is surprising rather than the rewriting."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"dff2a440-f937-a94c-a8cb-abb4ecbca5e6"],

Cell["What a rule knows about itself", "Subsection",ExpressionUUID->"5a52bf9e-e056-c94d-bcb4-c0907fa19179"],

Cell["\<\
A rule answers for its two sides and for what it does to vertices, read off \
by identifier:\
\>", "Text",ExpressionUUID->"8d474a56-3d3f-ba4a-bbbb-bceeec70de4f"],

Cell["sub[\"Properties\"]", "Input",ExpressionUUID->"545a1c83-32d0-9f48-a896-c65f8a17232f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Input\"\>", ",", "\<\"Output\"\>", 
   ",", "\<\"SharedVertices\"\>", ",", "\<\"NewVertices\"\>", 
   ",", "\<\"DeletedVertices\"\>", ",", "\<\"Signature\"\>"}], 
  "}"}]], "Output",ExpressionUUID->"fe0336bb-ada6-ba4e-bda4-f9dfac564253"],

Cell["\<\
AssociationMap[sub, {\"SharedVertices\", \"NewVertices\", \
\"DeletedVertices\", \"Signature\"}]\
\>", "Input",ExpressionUUID->"63b7b0a2-7bb5-2c4e-9fc0-29159e3172ee"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"SharedVertices\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}]}], ",", 
   RowBox[{"\<\"NewVertices\"\>", "\[Rule]", 
    RowBox[{"{", "3", "}"}]}], ",", 
   RowBox[{"\<\"DeletedVertices\"\>", "\[Rule]", 
    RowBox[{"{", "}"}]}], ",", 
   RowBox[{"\<\"Signature\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "3"}], "}"}]}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",ExpressionUUID->"820068fa-56a8-8347-9068-\
090c76ce15be"],

Cell["\<\
\"Signature\" is the shape of the rule: how many edges and vertices on each \
side. A rule that contracts rather than grows has it the other way round:\
\>", "Text",ExpressionUUID->"f33446cb-79ef-c646-8358-90d3b3fc1529"],

Cell["\<\
contract = HypergraphRule[{{1, 2}, {2, 3}}, {{1, 3}}];
AssociationMap[contract, {\"SharedVertices\", \"NewVertices\", \
\"DeletedVertices\", \"Signature\"}]\
\>", "Input",ExpressionUUID->"6313a292-bcc0-8a4a-b88d-7f3304d31d35"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"SharedVertices\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1", ",", "3"}], "}"}]}], ",", 
   RowBox[{"\<\"NewVertices\"\>", "\[Rule]", 
    RowBox[{"{", "}"}]}], ",", 
   RowBox[{"\<\"DeletedVertices\"\>", "\[Rule]", 
    RowBox[{"{", "2", "}"}]}], ",", 
   RowBox[{"\<\"Signature\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"2", ",", "3"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}]}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",ExpressionUUID->"f184ca55-5d68-ca42-9bfd-\
c3b7b7cb2608"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Vertices correspond between the two sides by identifier, so a name on both \
sides is the same vertex and a name on the output alone is a new one. That is \
the whole of the convention, and these three lists are it applied."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"d646ebd7-35d2-d24e-82c0-7383a5b8dd2c"],

Cell["The matching options", "Subsection",ExpressionUUID->"bbdce545-f96d-6344-8aff-be5e9a2ea3f3"],

Cell["\<\
Three options govern what counts as a match. \"Labeled\" -> False puts labels \
aside altogether, so a rule written for skeletons applies to a labelled \
hypergraph:\
\>", "Text",ExpressionUUID->"3733576d-c7e1-f245-9a6f-f04f317bb23f"],

Cell["\<\
labelledPair = Hypergraph[{Edge[{1, 2}, \"Directed\", \"a\"], Edge[{2, 3}, \
\"Directed\", \"b\"]}];
{Length @ HypergraphRuleMatches[HypergraphRule[{Edge[{1, 2}, \"Directed\", \
\"c\"]}, {}], labelledPair],
  Length @ HypergraphRuleMatches[HypergraphRule[{Edge[{1, 2}, \"Directed\", \
\"c\"]}, {}], labelledPair,
     \"Labeled\" -> False]}\
\>", "Input",ExpressionUUID->"77ff1d9f-50ba-ba44-886b-d79372b3b322"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "2"}], "}"}]], "Output",ExpressionUUID->"af9b370a-310a-7f4d-b227-0f86eb494508"],

Cell["\<\
\"LabelPatterns\" -> False reads every label literally, so a bare symbol \
stops being a variable. Section 4 is about what that option turns on:\
\>", "Text",ExpressionUUID->"7a9b093e-5e0a-1542-9a98-672701cea6b2"],

Cell["\<\
{Length @ HypergraphRuleMatches[HypergraphRule[{Edge[{1, 2}, \"Directed\", \
w]}, {}], labelledPair],
  Length @ HypergraphRuleMatches[HypergraphRule[{Edge[{1, 2}, \"Directed\", \
w]}, {}], labelledPair,
     \"LabelPatterns\" -> False]}\
\>", "Input",ExpressionUUID->"9566fc35-8f7f-4946-8477-a5661a4f5b12"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "0"}], "}"}]], "Output",ExpressionUUID->"234a894a-159f-b842-b435-e8e0abb6127c"],

Cell["\<\
\"DistinctVertices\" -> False lets two vertices of the input fall on one \
vertex of the hypergraph, which is what the next subsection is about:\
\>", "Text",ExpressionUUID->"0b80144e-3ee4-0043-af4b-6c3fefac6584"],

Cell["\<\
{Length @ HypergraphRuleMatches[HypergraphRule[{{1, 2}, {2, 3}}, {}], \
Hypergraph[{{1, 2}}]],
  Length @ HypergraphRuleMatches[HypergraphRule[{{1, 2}, {2, 3}}, {}], \
Hypergraph[{{1, 2}}],
     \"DistinctVertices\" -> False]}\
\>", "Input",ExpressionUUID->"38bce05c-323d-0943-a686-dd1c50eb5a44"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "0"}], "}"}]], "Output",ExpressionUUID->"b4088353-b87a-d24c-9e6f-a942ce77f7f5"],

Cell["\<\
A match on its own says only where it sits: which positions of EdgeList it \
used, how the input's vertices correspond, and what its label variables were \
bound to.\
\>", "Text",ExpressionUUID->"d5b1351e-32e8-104e-9ed1-548a33f4be77"],

Cell["Keys @ First @ HypergraphRuleMatches[sub, chain]", "Input",ExpressionUUID->"5c27dbe1-9f82-404a-98b7-f4f7512df901"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"MatchEdgePositions\"\>", ",", "\<\"RuleVertexMap\"\>", 
   ",", "\<\"LabelBindings\"\>"}], "}"}]], "Output",ExpressionUUID->"4a82ad11-\
fb96-8042-8a5c-5346b84f15a6"],

Cell["Symmetry decides how many ways a pattern fits", "Subsection",ExpressionUUID->"6be5d411-a18d-404c-ad3f-1ea537fc3774"],

Cell["\<\
A pattern edge and the edge it lies on must have the same symmetry type, and \
the pattern is matched over the orderings that type allows. A directed edge \
of arity three fits one way, a cyclic one three ways, an unordered one all \
six:\
\>", "Text",ExpressionUUID->"6e759985-39c5-f842-bcfc-730cfcac19b5"],

Cell["\<\
Table[
  Length @ HypergraphRuleMatches[
    HypergraphRule[{Edge[{1, 2, 3}, s]}, {}], Hypergraph[{Edge[{1, 2, 3}, \
s]}]],
  {s, {\"Directed\", \"Cyclic\", \"Unordered\"}}]\
\>", "Input",ExpressionUUID->"1e0587f1-c422-9b4e-9b41-5636f77f8205"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "3", ",", "6"}], "}"}]], "Output",ExpressionUUID->\
"e6934b84-6f77-8d49-a285-75e15faf14f4"],

Cell["\<\
And the types have to agree, so a directed pattern finds nothing in an \
unordered edge:\
\>", "Text",ExpressionUUID->"02c0c878-072b-484d-8d11-6446a09ebcfa"],

Cell["\<\
HypergraphRuleMatches[HypergraphRule[{Edge[{1, 2}, \"Directed\"]}, {}],
  Hypergraph[{Edge[{1, 2}, \"Unordered\"]}]]\
\>", "Input",ExpressionUUID->"91755e88-6448-8c47-9c4f-85391f21e465"],

Cell[BoxData[
 RowBox[{"{", "}"}]], "Output",ExpressionUUID->"3618244e-06c2-6a42-a00d-ca68e131d607"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Those six matches of an unordered triple are genuinely six, not one \
reported six times: they differ in which vertex of the hypergraph each vertex \
of the rule corresponds to, and an output that treats its vertices \
differently will produce six different results. When the output is symmetric \
too, the six results coincide, and the multiplicity is then something to \
divide out rather than something wrong."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"83440ee4-9603-7744-804a-ef0d8f60d8b1"],

Cell["Two vertices of a rule do not fold onto one", "Subsection",ExpressionUUID->"47ac8353-e74a-614e-8047-c95b7d2f17b1"],

Cell["\<\
By default distinct vertices of the input match distinct vertices of the \
hypergraph, so a two-vertex pattern does not fit a self-loop:\
\>", "Text",ExpressionUUID->"0a14cbc5-8e39-134c-a29e-594f9d42a90e"],

Cell["\<\
{HypergraphRuleMatches[HypergraphRule[{{1, 2}}, {}], Hypergraph[{Edge[{1, \
1}]}]],
  Length @ HypergraphRuleMatches[HypergraphRule[{{1, 2}}, {}], \
Hypergraph[{Edge[{1, 1}]}],
     \"DistinctVertices\" -> False]}\
\>", "Input",ExpressionUUID->"72dc12bb-fdf2-ed45-890c-c66eadb87a72"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "}"}], ",", "1"}], "}"}]], "Output",ExpressionUUID->"0007dec0-\
d57f-cd48-af83-b2204443eb59"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "This follows the reference paclet, which imposes the same by default. It is \
worth knowing that it is a choice: in the Wolfram model a rule's vertices \
need not be distinct, and \"DistinctVertices\" -> False is that convention."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"ff6927c7-d063-5049-9120-d302267c5490"],

Cell["An edge is used once", "Subsection",ExpressionUUID->"b87ce37f-995c-de4c-85bb-59bd01dffbf6"],

Cell["\<\
Each edge of the hypergraph is used by at most one edge of the input, so a \
rule wanting two edges wants two of them:\
\>", "Text",ExpressionUUID->"d29e6cbe-ea49-ef4d-a44d-d7613209d150"],

Cell["\<\
{HypergraphRuleMatches[HypergraphRule[{{1, 2}, {1, 2}}, {}], \
Hypergraph[{Edge[{1, 2}]}]],
  Length @ HypergraphRuleMatches[HypergraphRule[{{1, 2}, {1, 2}}, {}],
     Hypergraph[{Edge[{1, 2}], Edge[{1, 2}]}]]}\
\>", "Input",ExpressionUUID->"6718117c-5b53-b349-8ecf-cbde870700f3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "}"}], ",", "2"}], "}"}]], "Output",ExpressionUUID->"7dd79ceb-\
77c0-cf49-95df-e4042932d868"],

Cell["3. Applying a rule: events", "Section",ExpressionUUID->"1557c80d-9abd-7141-9e9c-b9bc82ab1fd5"],

Cell["\<\
Applying a rule gives one event for every match. An event is an association: \
it says what the hypergraph became, and also what was matched, what was \
created and what was destroyed.\
\>", "Text",ExpressionUUID->"3e23f131-fd3c-814e-b0a2-9b6d8ba9cfb0"],

Cell["\<\
events = sub[chain];
Length[events]\
\>", "Input",ExpressionUUID->"d2e8bd69-736b-8644-8324-6b3659783281"],

Cell[BoxData["2"], "Output",ExpressionUUID->"6fcbafcc-5ff8-c343-bc8f-21d663eaf904"],

Cell["Keys @ First[events]", "Input",ExpressionUUID->"7bd50431-ae6d-4a42-8ed6-eeb1331d7fd6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Hypergraph\"\>", ",", "\<\"Input\"\>", 
   ",", "\<\"EdgeOrigins\"\>", ",", "\<\"MatchVertices\"\>", 
   ",", "\<\"MatchEdges\"\>", ",", "\<\"MatchEdgePositions\"\>", 
   ",", "\<\"NewVertices\"\>", ",", "\<\"NewEdges\"\>", 
   ",", "\<\"DeletedVertices\"\>", ",", "\<\"RuleVertexMap\"\>", 
   ",", "\<\"LabelBindings\"\>", ",", "\<\"Rule\"\>"}], "}"}]], "Output",Expre\
ssionUUID->"1cbeeb95-3863-0b48-86a2-0358288cf411"],

Cell["\<\
The two results, drawn. Each has subdivided one of the two edges:\
\>", "Text",ExpressionUUID->"a8fde130-f594-9446-9b67-41de46d4d0cd"],

Cell["#[\"Hypergraph\"] & /@ events", "Input",ExpressionUUID->"3f9143f6-5576-2b4f-ad68-c087ecf76a17"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   GraphicsBox[
    NamespaceBox["Hypergraphs",
     DynamicModuleBox[{Typeset`hg = HoldComplete[
       WolframInstitute`Hypergraphs`Hypergraph[{
