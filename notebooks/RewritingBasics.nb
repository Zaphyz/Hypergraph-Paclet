          0.7], {ArrowBox[
            LineBox[{{0., 6.123233995736766*^-16}, {1., 
             4.898587196589413*^-16}}]], {}}, 
          {Opacity[1]}}}, 
        {Opacity[1], Arrowheads[{{Small, 0.5}}], 
         {Hue[0.63, 0.7, 0.5], Opacity[
          0.7], {ArrowBox[
            LineBox[{{1., 4.898587196589413*^-16}, {2., 
             2.4492935982947064`*^-16}}]], {}}, 
          {Opacity[1]}}}, 
        {Opacity[1], Arrowheads[{{Small, 0.5}}], 
         {Hue[0.63, 0.7, 0.5], Opacity[
          0.7], {ArrowBox[
            LineBox[{{2., 2.4492935982947064`*^-16}, {3., 0.}}]], {}}, 
