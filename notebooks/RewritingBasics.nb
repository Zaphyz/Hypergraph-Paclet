Cell[BoxData[
 RowBox[{"{", 
  TemplateBox[{"\"{\"", "f", "g", "\"}\""},
   "RowDefault"], "}"}]], "Output",ExpressionUUID->"2b811740-0f1d-f94e-8557-\
532d1d178f83"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "This is the rule the reference notebooks write for composition, and it is \
the reason labels are worth the trouble. Without variables a rule can only \
say what it applies to; with them it can carry information out of the match \
and into what it builds, and a rewriting system becomes a calculus on the \
labels rather than only on the shape."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"718c336d-dd0b-b34b-a5b1-400fb5528011"],

Cell["\<\
A variable used twice must find the same label both times, which is how a \
rule asks for two edges that agree:\
\>", "Text",ExpressionUUID->"b100b48b-d856-0f4b-8a69-0c12c9a3ff97"],

Cell["\<\
twice = HypergraphRule[{Edge[{1, 2}, \"Directed\", x], Edge[{2, 3}, \
\"Directed\", x]}, {}];
{HypergraphRuleMatches[twice, composable],
  Length @ HypergraphRuleMatches[twice,
     Hypergraph[{Edge[{1, 2}, \"Directed\", f], Edge[{2, 3}, \"Directed\", \
f]}]]}\
\>", "Input",ExpressionUUID->"f1b148a4-79e9-eb48-9403-88c10302f07b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "}"}], ",", "1"}], "}"}]], "Output",ExpressionUUID->"15c056e0-\
06c5-774c-9248-de7ac08e5b8b"],

Cell["What counts as a variable", "Subsection",ExpressionUUID->"d10058e1-103f-464b-9bbd-228a7ed01725"],

Cell["\<\
A bare symbol is a variable. A string, a number, or any composite expression \
is a literal and matches only itself, which is why every labelled rule \
earlier in this notebook went on behaving as it did:\
\>", "Text",ExpressionUUID->"f6f14faa-527a-214b-a2eb-c921e53b51db"],

Cell["\<\
{Length @ HypergraphRuleMatches[HypergraphRule[{Edge[{1, 2}, \"Directed\", \
x]}, {}], composable],
  Length @ HypergraphRuleMatches[HypergraphRule[{Edge[{1, 2}, \"Directed\", \
\"f\"]}, {}], composable]}\
\>", "Input",ExpressionUUID->"a8837d61-14ff-be43-aff8-5890f2ede490"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "0"}], "}"}]], "Output",ExpressionUUID->"a6707e62-758d-b345-85fc-e1898781c151"],

Cell["\<\
Verbatim asks for a symbol to be read literally, for a rule that wants to \
match the label f rather than bind to it; and \"LabelPatterns\" -> False \
reads every label literally:\
\>", "Text",ExpressionUUID->"931149ff-88ff-be40-9db2-9c7d44c40e84"],

Cell["\<\
{Length @ HypergraphRuleMatches[HypergraphRule[{Edge[{1, 2}, \"Directed\", \
Verbatim[f]]}, {}], composable],
  Length @ HypergraphRuleMatches[HypergraphRule[{Edge[{1, 2}, \"Directed\", \
x]}, {}], composable,
     \"LabelPatterns\" -> False]}\
\>", "Input",ExpressionUUID->"7206e2e9-64e2-034b-abe1-459d5da61b7e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "0"}], "}"}]], "Output",ExpressionUUID->"0e8c5519-8435-5e40-b5f7-374b25960d2b"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Deciding that a bare symbol is a variable and everything else is a literal \
is a convention, not a necessity, and it was chosen by reading the reference \
notebooks: every label they write in a rule is a bare symbol meant as a \
variable, and every label they write in a state is one too. Requiring \
something like x_ would have been more explicit and would have made those \
notebooks unwriteable in this package without editing every rule."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"af967039-d560-ec4d-8590-1cdd20afd0ae"],

Cell["Vertex labels bind as well", "Subsection",ExpressionUUID->"77471c11-3d8f-764a-96c9-b78d811b14a1"],

Cell["\<\
Nothing about this is particular to edges. A rule whose whole input is a \
single labelled vertex binds that label, and creates something named after it:\
\>", "Text",ExpressionUUID->"784ae9a9-43d2-9849-9a55-2b95dcd69275"],

Cell["\<\
objects = Hypergraph[{Vertex[1, r], Vertex[2, s]}, {Edge[{1, 2}, \
\"Directed\", u]}]\
\>", "Input",ExpressionUUID->"5827667f-05cd-3441-8ffe-d6a8ff307aaf"],

