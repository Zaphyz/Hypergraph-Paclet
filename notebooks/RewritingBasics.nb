       Dynamic[Typeset`open$$], ImageSize -> Automatic]},
     "SummaryPanel"],
    DynamicModuleValues:>{}], "]"}],
  WolframInstitute`Hypergraphs`HypergraphRule[
   WolframInstitute`Hypergraphs`Hypergraph[{
     WolframInstitute`Hypergraphs`Vertex[1, $CellContext`p]}, {}], 
   WolframInstitute`Hypergraphs`Hypergraph[{
     WolframInstitute`Hypergraphs`Vertex[1, $CellContext`p], 
     WolframInstitute`Hypergraphs`Vertex[2, $CellContext`p]}, {
     WolframInstitute`Hypergraphs`Edge[{
       WolframInstitute`Hypergraphs`Vertex[1, $CellContext`p], 
       WolframInstitute`Hypergraphs`Vertex[2, $CellContext`p]}, "Directed", 
      Subscript["1", $CellContext`p]]}]],
  Editable->False,
  SelectWithContents->True,
  Selectable->False]], "Output",ExpressionUUID->"12807ce6-7369-8a49-92b2-\
277f0d0e3b0f"],

Cell["#[\"LabelBindings\"] & /@ unit[objects]", "Input",ExpressionUUID->"7af6b1e1-714c-2f49-8959-8b626f2b0873"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{"p", "\[Rule]", "r"}], "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{"p", "\[Rule]", "s"}], "\[RightAssociation]"}]}], "}"}]], "Output",\
ExpressionUUID->"789dfce3-657a-314b-a4d5-f6cb6151780b"],

Cell["EdgeLabel /@ EdgeList @ First[unit[objects]][\"Hypergraph\"]", "Input",ExpressionUUID->"bffa649b-13f3-2749-9ebe-49af7d9f7344"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"u", ",", 
   SubscriptBox["\<\"1\"\>", "r"]}], "}"}]], "Output",ExpressionUUID->\
"3ad55221-1f85-d646-9075-2dd4a8dcb8b5"],

Cell["\<\
Two events, one for each vertex of the state, and each builds an edge named \
for the vertex it was found at. The vertex the rule created carries that \
label too:\
\>", "Text",ExpressionUUID->"0ee267c6-226d-9f40-9207-c95a8b6e684e"],

Cell["\<\
VertexLabel /@ VertexList @ First[unit[objects]][\"Hypergraph\"]\
\>", "Input",ExpressionUUID->"14fd0479-1ad7-ff49-89c2-258ad03a3705"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"r", ",", "s", ",", "r"}], "}"}]], "Output",ExpressionUUID->\
"7c8fb679-565a-a14e-bf5b-d2c836e7f0bf"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "The input of this rule has no edges at all, only a labelled vertex. A \
vertex of the input lying in no edge is matched to each vertex not already \
taken in turn, and its label binds like any other \[LongDash] which is what \
makes a rule of this shape mean anything."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"8008c40b-2695-7c44-9a8b-5147d842da96"],

Cell["An involution", "Subsection",ExpressionUUID->"e68fbb51-08af-b847-b842-4d4adc7d5d9a"],

Cell["\<\
A rule may take an edge apart and put it back the other way round, naming the \
result after what it undid. Reversing an edge and daggering its label:\
\>", "Text",ExpressionUUID->"a22fd176-10b3-5048-a30e-edf31fbb1b3f"],

Cell["\<\
dagger = HypergraphRule[
  Hypergraph[{Vertex[1, p], Vertex[2, q]}, {Edge[{1, 2}, \"Directed\", x]}],
  Hypergraph[{Vertex[1, p], Vertex[2, q]},
             {Edge[{2, 1}, \"Directed\", Row[{\"(\", SuperDagger[x], \
\")\"}]]}]];
First[dagger[objects]][\"Hypergraph\"]\
\>", "Input",ExpressionUUID->"17d3e59d-9804-c44e-a02d-6fc7dc2aa29e"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["Hypergraphs",
   DynamicModuleBox[{Typeset`hg = HoldComplete[
     WolframInstitute`Hypergraphs`Hypergraph[{
       WolframInstitute`Hypergraphs`Vertex[1, $CellContext`r], 
       WolframInstitute`Hypergraphs`Vertex[2, $CellContext`s]}, {
       WolframInstitute`Hypergraphs`Edge[{
         WolframInstitute`Hypergraphs`Vertex[2, $CellContext`s], 
         WolframInstitute`Hypergraphs`Vertex[1, $CellContext`r]}, "Directed", 
        
        Row[{"(", 
          SuperDagger[$CellContext`u], ")"}]]}]]}, 
    {AbsoluteThickness[Medium], Opacity[0.5], Arrowheads[{{Medium, 0.5}}], 
     {Opacity[1], Arrowheads[{{Small, 0.5}}], 
      {Hue[0.63, 0.7, 0.5], Opacity[
       0.7], {ArrowBox[
         LineBox[{{0., 1.2246467991473532`*^-16}, {1., 0.}}]], {}}, 
       {Opacity[1], InsetBox[
         StyleBox[
          TemplateBox[{"\"(\"", 
            SuperscriptBox["u", "\[Dagger]"], "\")\""},
           "RowDefault"],
          StripOnInput->False,
          LineColor->Hue[0.63, 0.7, 0.5],
          FrontFaceColor->Hue[0.63, 0.7, 0.5],
          BackFaceColor->Hue[0.63, 0.7, 0.5],
          GraphicsColor->Hue[0.63, 0.7, 0.5],
          FontColor->Hue[0.63, 0.7, 0.5]], {0.5, 0.010000000000000063}]}}}, 
     {Opacity[1], 
      {Hue[0.63, 0.26, 0.89], EdgeForm[{Hue[0.63, 0.7, 0.33], Opacity[0.95]}],
        DiskBox[{1., 0.}, Offset[{2., 2.}, {0., 0.}]], 
       DiskBox[{0., 1.2246467991473532`*^-16}, Offset[{2., 2.}, {0., 0.}]]}, {
       InsetBox[
        StyleBox["r",
         StripOnInput->False,
         LineColor->GrayLevel[0],
         FrontFaceColor->GrayLevel[0],
         BackFaceColor->GrayLevel[0],
         GraphicsColor->GrayLevel[0],
         FontColor->GrayLevel[0]], {1., 0.}, 
        ImageScaled[{-0.5, 0.5000000000000001}]], InsetBox[
        StyleBox["s",
         StripOnInput->False,
         LineColor->GrayLevel[0],
         FrontFaceColor->GrayLevel[0],
         BackFaceColor->GrayLevel[0],
         GraphicsColor->GrayLevel[0],
         FontColor->GrayLevel[0]], {0., 1.2246467991473532*^-16}, 
        ImageScaled[{1.5, 0.4999999999999999}]]}}}]],
  Background->GrayLevel[1],
  ImagePadding->20,
  PlotRange->{{0., 1.}, {-0.16666666666666666`, 0.16666666666666677`}},
  PlotRangePadding->Scaled[0.02]]], "Output",ExpressionUUID->"77e579f2-e213-\
6042-81f2-0d4fde9cbfa1"],

Cell["\<\
Applying it twice returns the edge to where it began, with the label \
recording that it was daggered twice rather than reduced:\
\>", "Text",ExpressionUUID->"70a1c254-350c-a04f-99f7-c7f0dcd3520b"],

Cell["\<\
EdgeLabel /@ EdgeList @ \
First[dagger[First[dagger[objects]][\"Hypergraph\"]]][\"Hypergraph\"]\
\>", "Input",ExpressionUUID->"c230b4cb-b57a-f147-9801-4b9d967df378"],

Cell[BoxData[
 RowBox[{"{", 
  TemplateBox[{"\"(\"", 
    SuperscriptBox[
     TemplateBox[{"\"(\"", 
       SuperscriptBox["u", "\[Dagger]"], "\")\""}, "RowDefault"], 
     "\[Dagger]"], "\")\""},
   "RowDefault"], "}"}]], "Output",ExpressionUUID->"458e2031-4563-0f4a-a739-\
d51603965867"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "That the label is not simplified is the right behaviour here: rewriting \
builds the expression, and whether the two daggers cancel is a fact about the \
algebra being modelled rather than about the rewriting. A rule asserting the \
involution would be a second rule, and the two together are what the \
reference notebooks use to check it."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"31da5253-ea54-5944-9d68-6eaf9122dcc7"],

Cell["\<\
A rule may also relabel. Where the output gives a vertex a label, that label \
is what the result carries; where it leaves one unlabelled, the hypergraph's \
own label stays:\
\>", "Text",ExpressionUUID->"38ae1fc5-7da8-8748-b92a-b524005dbcc0"],

Cell["\<\
swap = HypergraphRule[
  Hypergraph[{Vertex[1, p], Vertex[2, q]}, {Edge[{1, 2}, \"Directed\", x]}],
  Hypergraph[{Vertex[1, q], Vertex[2, p]}, {Edge[{1, 2}, \"Directed\", x]}]];
VertexLabel /@ VertexList @ First[swap[objects]][\"Hypergraph\"]\
\>", "Input",ExpressionUUID->"f6f32d60-02cc-e143-83fa-77a8e15689ab"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"s", ",", "r"}], "}"}]], "Output",ExpressionUUID->"c3edb896-8225-744f-afee-a074778c8462"],

Cell["5. Rules from the reference notebooks", "Section",ExpressionUUID->"eafa40c9-fd14-7140-a98e-e8ab60fb2869"],

Cell["\<\
reference/Chemoids.wl builds small algebraic structures out of labelled \
rules: a composition, a unit, a dagger, an action, a zig-zag. Section 4 \
showed the mechanism those rules need; this section runs them and looks at \
the laws they were written to express. There is no multiway system here yet, \
so where the reference draws two steps of an evolution graph, this takes the \
second step by hand \[LongDash] applying the rule again to each state the \
first step produced.\
\>", "Text",ExpressionUUID->"381d4445-5b86-b94b-aa53-0894335bbd68"],

Cell["Composition and the unit", "Subsection",ExpressionUUID->"4f6f0f7a-af7e-9d40-9d61-a193c03b3c44"],

Cell["\<\
Composition joins two edges meeting head to tail and names the result after \
them. The unit takes a single labelled vertex and grows an identity edge at \
it. Both are written the way the reference writes them:\
\>", "Text",ExpressionUUID->"923413bc-957c-e34f-940e-c5c18b8eef63"],

Cell["\<\
arrowComp = HypergraphRule[
  {Edge[{1, 2}, \"Directed\", x], Edge[{2, 3}, \"Directed\", y]},
  {Edge[{1, 3}, \"Directed\", Row[{\"(\", x, y, \")\"}]]}];
arrowUnit = HypergraphRule[
  Hypergraph[{Vertex[1, p]}, {}],
  Hypergraph[{Vertex[1, p], Vertex[2, p]},
             {Edge[{1, 2}, \"Directed\", Subscript[\"1\", p]]}]];
arrow = Hypergraph[{Vertex[1, r], Vertex[2, s]}, {Edge[{1, 2}, \"Directed\", \
f]}]\
\>", "Input",ExpressionUUID->"872e67fc-a980-cc4a-842d-3950cd76e45d"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["Hypergraphs",
   DynamicModuleBox[{Typeset`hg = HoldComplete[
     WolframInstitute`Hypergraphs`Hypergraph[{
       WolframInstitute`Hypergraphs`Vertex[1, $CellContext`r], 
       WolframInstitute`Hypergraphs`Vertex[2, $CellContext`s]}, {
       WolframInstitute`Hypergraphs`Edge[{
         WolframInstitute`Hypergraphs`Vertex[1, $CellContext`r], 
         WolframInstitute`Hypergraphs`Vertex[2, $CellContext`s]}, 
        "Directed", $CellContext`f]}]]}, 
    {AbsoluteThickness[Medium], Opacity[0.5], Arrowheads[{{Medium, 0.5}}], 
     {Opacity[1], Arrowheads[{{Small, 0.5}}], 
      {Hue[0.63, 0.7, 0.5], Opacity[
       0.7], {ArrowBox[
         LineBox[{{1., 0.}, {0., 1.2246467991473532`*^-16}}]], {}}, 
       {Opacity[1], InsetBox[
         StyleBox["f",
          StripOnInput->False,
          LineColor->Hue[0.63, 0.7, 0.5],
          FrontFaceColor->Hue[0.63, 0.7, 0.5],
          BackFaceColor->Hue[0.63, 0.7, 0.5],
          GraphicsColor->Hue[0.63, 0.7, 0.5],
          FontColor->Hue[0.63, 0.7, 0.5]], {0.5, 0.010000000000000063}]}}}, 
     {Opacity[1], 
      {Hue[0.63, 0.26, 0.89], EdgeForm[{Hue[0.63, 0.7, 0.33], Opacity[0.95]}],
        DiskBox[{1., 0.}, Offset[{2., 2.}, {0., 0.}]], 
       DiskBox[{0., 1.2246467991473532`*^-16}, Offset[{2., 2.}, {0., 0.}]]}, {
       InsetBox[
        StyleBox["r",
         StripOnInput->False,
         LineColor->GrayLevel[0],
         FrontFaceColor->GrayLevel[0],
         BackFaceColor->GrayLevel[0],
         GraphicsColor->GrayLevel[0],
         FontColor->GrayLevel[0]], {1., 0.}, 
        ImageScaled[{-0.5, 0.5000000000000001}]], InsetBox[
        StyleBox["s",
         StripOnInput->False,
         LineColor->GrayLevel[0],
         FrontFaceColor->GrayLevel[0],
         BackFaceColor->GrayLevel[0],
         GraphicsColor->GrayLevel[0],
         FontColor->GrayLevel[0]], {0., 1.2246467991473532*^-16}, 
        ImageScaled[{1.5, 0.4999999999999999}]]}}}]],
  Background->GrayLevel[1],
  ImagePadding->20,
  PlotRange->{{0., 1.}, {-0.16666666666666666`, 0.16666666666666677`}},
  PlotRangePadding->Scaled[0.02]]], "Output",ExpressionUUID->"bffc279d-3a87-\
634a-95d2-f3028e4b1474"],

Cell["\<\
Both rules against that one state. Composition finds nothing \[LongDash] a \
single edge has nothing to compose with \[LongDash] and the unit fires once \
at each end:\
\>", "Text",ExpressionUUID->"b7f69eb1-736b-014e-961a-3babda48009b"],

Cell["\<\
EdgeLabel /@ EdgeList[#[\"Hypergraph\"]] & /@ Catenate[Through[{arrowUnit, \
arrowComp}[arrow]]]\
\>", "Input",ExpressionUUID->"5d5eadb5-a735-784b-815d-79b060989c61"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"f", ",", 
     SubscriptBox["\<\"1\"\>", "r"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"f", ",", 
     SubscriptBox["\<\"1\"\>", "s"]}], "}"}]}], "}"}]], "Output",ExpressionUUI\
D->"0494870b-2aab-3147-abc1-61ff99977f25"],

Cell["\<\
Composing afterwards is the unit law. Of the two states the unit produced, \
only one goes further:\
\>", "Text",ExpressionUUID->"093d766b-6649-1745-9bb0-64f0854cc42e"],

Cell["\<\
EdgeLabel /@ EdgeList[#[\"Hypergraph\"]] & /@
  Catenate[arrowComp /@ (#[\"Hypergraph\"] & /@ arrowUnit[arrow])]\
\>", "Input",ExpressionUUID->"f16ba58e-1196-1c46-8734-1ca82c7b9dda"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   TemplateBox[{"\"(\"", "f", 
     SubscriptBox["\"1\"", "s"], "\")\""},
    "RowDefault"], "}"}], "}"}]], "Output",ExpressionUUID->"0773c6b6-6804-\
394c-8a90-5e5cc9eb3712"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "The unit built at the target of f leaves s, so it follows f head to tail \
and the pair composes; the one built at the source leaves r, which f also \
leaves, so the two share a source rather than meeting, and nothing composes. \
The orientation is doing the work. What comes out is the term (f Subscript[1, \
s]) \[LongDash] the left side of the unit law, not the law itself. Rewriting \
builds terms; asserting that this one equals f is a further rule, or the \
identification of states that a multiway system makes."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"ebe977c7-b271-f445-ac72-a75cdb109090"],

Cell["The dagger is an antihomomorphism", "Subsection",ExpressionUUID->"4ff22c30-1da3-f44b-9758-59e2bedd367b"],

Cell["\<\
The dagger rule reverses an edge and daggers its label. Composing first and \
then daggering gives the dagger of the composite:\
\>", "Text",ExpressionUUID->"02bdaa48-4c6d-3e4b-96aa-dc405eaec4cd"],

Cell["\<\
chain2 = Hypergraph[{Edge[{1, 2}, \"Directed\", f], Edge[{2, 3}, \
\"Directed\", g]}];
dag = HypergraphRule[
  Hypergraph[{Vertex[1, p], Vertex[2, q]}, {Edge[{1, 2}, \"Directed\", x]}],
  Hypergraph[{Vertex[1, p], Vertex[2, q]}, {Edge[{2, 1}, \"Directed\", \
SuperDagger[x]]}]];
EdgeLabel /@ EdgeList[#[\"Hypergraph\"]] & /@
  Catenate[dag /@ (#[\"Hypergraph\"] & /@ arrowComp[chain2])]\
\>", "Input",ExpressionUUID->"cdcf3401-1ffe-714d-ad7a-08a52bd2ba4a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   SuperscriptBox[
    TemplateBox[{"\"(\"", "f", "g", "\")\""},
     "RowDefault"], "\[Dagger]"], "}"}], "}"}]], "Output",ExpressionUUID->\
"82137a09-b29d-b14b-ad5b-1635653ce030"],

Cell["\<\
Daggering both edges first and then composing gives the composite of the \
daggers, in the other order:\
\>", "Text",ExpressionUUID->"0087166a-c062-684f-a2d1-6246d8b3ed2d"],

Cell["\<\
bothDaggered = Select[
  #[\"Hypergraph\"] & /@ Catenate[dag /@ (#[\"Hypergraph\"] & /@ dag[chain2])],
  FreeQ[EdgeLabel /@ EdgeList[#], SuperDagger[SuperDagger[_]]] &];
DeleteDuplicates[EdgeLabel /@ EdgeList[#[\"Hypergraph\"]] & /@ \
Catenate[arrowComp /@ bothDaggered]]\
\>", "Input",ExpressionUUID->"07ce3a8d-bdfb-7944-8130-0e86ab53bf22"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   TemplateBox[{"\"(\"", 
     SuperscriptBox["g", "\[Dagger]"], 
     SuperscriptBox["f", "\[Dagger]"], "\")\""},
    "RowDefault"], "}"}], "}"}]], "Output",ExpressionUUID->"81976aad-dbc6-\
264c-9ca3-3ee7f397346b"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Two routes out of the same state reach two terms, and the antihomomorphism \
law is the claim that those terms are equal. Nothing here checks that claim; \
what the rewriting does is produce both sides of it from one state, which is \
what makes such a law something a causal or multiway analysis can be asked \
about rather than something asserted by hand. The Select drops the states \
where the same edge was daggered twice \[LongDash] those are the involution, \
not the antihomomorphism."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"ffdb53ce-db49-3b49-a2ef-c26ac7b4a0bc"],

Cell["An action", "Subsection",ExpressionUUID->"8feb7ad1-2d95-d641-9ff7-5db1343da62b"],

Cell["\<\
Not every edge in a rule has to be binary. The action rule consumes a unary \
edge \[LongDash] a point carrying an element \[LongDash] together with an \
arrow leaving that vertex, and leaves a point at the far end carrying the \
element acted on:\
\>", "Text",ExpressionUUID->"18c0889f-2953-1f4b-97a1-04034354f4da"],

Cell["\<\
action = HypergraphRule[
  {Edge[{1}, \"Directed\", a], Edge[{1, 2}, \"Directed\", x]},
  {Edge[{2}, \"Directed\", Row[{x, \"[\", a, \"]\"}]]}];
pointed = Hypergraph[{Edge[{1}, \"Directed\", u], Edge[{1, 2}, \"Directed\", \
f],
                      Edge[{2, 3}, \"Directed\", g]}]\
\>", "Input",ExpressionUUID->"9ae1a1a6-8717-6c4d-8bd4-b54ead2acbc0"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["Hypergraphs",
   DynamicModuleBox[{Typeset`hg = HoldComplete[
     WolframInstitute`Hypergraphs`Hypergraph[{
