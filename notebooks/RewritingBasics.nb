Cell["\<\
Three ways to fit into that state, each consuming a different window of three \
edges:\
\>", "Text",ExpressionUUID->"a85d4395-bc6a-c948-86d4-a04ba5c6c2e1"],

Cell["EdgeLabel /@ EdgeList[#[\"Hypergraph\"]] & /@ zigzag[long]", "Input",ExpressionUUID->"ae73b2c4-4e56-4f4b-870a-db699a072059"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     TemplateBox[{"\"(\"", "a", "b", "c", "\")\""},
      "RowDefault"], ",", "d", ",", "e"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"a", ",", "b", ",", 
     TemplateBox[{"\"(\"", "c", "d", "e", "\")\""},
      "RowDefault"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"a", ",", 
     TemplateBox[{"\"(\"", "d", "c", "b", "\")\""},
      "RowDefault"], ",", "e"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"ef6fe1b1-afe6-b44f-b2d0-6dca084f3182"],

Cell["\<\
Each of the three has one further match, and the three second steps are the \
three bracketings of the whole:\
\>", "Text",ExpressionUUID->"481cb386-68d3-cd46-92cd-83ffca248f50"],

Cell["\<\
EdgeLabel /@ EdgeList[#[\"Hypergraph\"]] & /@
  Catenate[zigzag /@ (#[\"Hypergraph\"] & /@ zigzag[long])]\
\>", "Input",ExpressionUUID->"00fe0167-0881-cc49-87f9-db9ecdbaff19"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    TemplateBox[{"\"(\"", 
      TemplateBox[{"\"(\"", "a", "b", "c", "\")\""}, "RowDefault"], "d", "e", 
      "\")\""},
     "RowDefault"], "}"}], ",", 
   RowBox[{"{", 
    TemplateBox[{"\"(\"", "a", "b", 
      TemplateBox[{"\"(\"", "c", "d", "e", "\")\""}, "RowDefault"], "\")\""},
     "RowDefault"], "}"}], ",", 
   RowBox[{"{", 
    TemplateBox[{"\"(\"", "a", 
      TemplateBox[{"\"(\"", "d", "c", "b", "\")\""}, "RowDefault"], "e", 
      "\")\""},
     "RowDefault"], "}"}]}], "}"}]], "Output",ExpressionUUID->"16ef2728-ea6d-\
4c4c-bc8c-111bb300641e"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "((a b c) d e), (a b (c d e)) and (a (d c b) e): the reference calls the \
equality of these three heap associativity, and the middle one having its \
letters reversed is the point of it. Three distinct terms out of one state in \
two steps, from a rule carrying no labels of its own \[LongDash] every label \
in the result was carried out of the match by a variable. Which of the three \
a system reaches, and whether two of the steps could have been taken in \
either order, is what the causal machinery is for; section 6 of \
CausalityBasics.nb runs this same rule as a system."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"29cd1afc-e3b3-0140-b1e8-b3f9348be430"],

Cell["6. Worked examples", "Section",ExpressionUUID->"f8b82466-d2cf-c743-9416-88252ccfa561"],

Cell["Growing a path", "Subsection",ExpressionUUID->"e5e7aa5f-789c-9246-9053-69069d24fda8"],

Cell["\<\
Subdividing repeatedly. Taking the first event each time, an edge becomes a \
path:\
\>", "Text",ExpressionUUID->"1e9b03c9-8f97-964b-ab4e-6536ab28d91f"],

Cell["\<\
NestList[First[sub[#]][\"Hypergraph\"] &, Hypergraph[{Edge[{1, 2}]}], 3]\
\>", "Input",ExpressionUUID->"f7b6aca0-118d-6f4c-9812-da99a787f3c6"],

