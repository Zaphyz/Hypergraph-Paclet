Cell["Styling a hypergraph, one element at a time", "Subsection",ExpressionUUID->"751dc585-326d-c641-8f91-632321bc35b5"],

Cell["\<\
All of the above rests on HypergraphPlot taking a style per element. A single \
directive styles everything:\
\>", "Text",ExpressionUUID->"3af9f114-b4d4-974f-a6f1-153c58281093"],

Cell["\<\
styled = Hypergraph[{Edge[{1, 2}], Edge[{2, 3}], Edge[{1, 2}], Edge[{1, 2, \
3}]}];
HypergraphPlot[styled, EdgeStyle -> Directive[Thick, Purple], VertexStyle -> \
Orange,
  ImageSize -> 220]\
\>", "Input",ExpressionUUID->"afebe5d7-d2a8-0945-969f-bfdea41e603d"],

