         BackFaceColor->GrayLevel[0],
         GraphicsColor->GrayLevel[0],
         FontColor->GrayLevel[0]], {0., 3.6739403974420594*^-16}, 
        ImageScaled[{1.5, 0.49999999999999983}]], InsetBox[
        StyleBox["2",
         StripOnInput->False,
         LineColor->GrayLevel[0],
         FrontFaceColor->GrayLevel[0],
         BackFaceColor->GrayLevel[0],
         GraphicsColor->GrayLevel[0],
         FontColor->GrayLevel[0]], {1., 2.4492935982947064*^-16}, NCache[
        ImageScaled[{Rational[1, 2], Rational[-1, 2]}], 
         ImageScaled[{0.5, -0.5}]]], InsetBox[
        StyleBox["3",
         StripOnInput->False,
         LineColor->GrayLevel[0],
         FrontFaceColor->GrayLevel[0],
         BackFaceColor->GrayLevel[0],
         GraphicsColor->GrayLevel[0],
         FontColor->GrayLevel[0]], {2., 0.}, 
        ImageScaled[{-0.5, 0.5000000000000002}]]}}}]],
  Background->GrayLevel[1],
  ImagePadding->19,
  PlotRange->{{0., 2.}, {-0.3333333333333333, 0.3333333333333337}},
  PlotRangePadding->Scaled[0.02]]], "Output",ExpressionUUID->"fd1e8bda-6880-\
a54e-86b8-7df40603f40f"],

Cell["HypergraphRuleMatches[sub, chain]", "Input",ExpressionUUID->"392b2cf9-2821-724d-9721-d518102cab9e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"MatchEdgePositions\"\>", "\[Rule]", 
      RowBox[{"{", "1", "}"}]}], ",", 
     RowBox[{"\<\"RuleVertexMap\"\>", "\[Rule]", 
      RowBox[{"\[LeftAssociation]", 
       RowBox[{
        RowBox[{"1", "\[Rule]", "1"}], ",", 
        RowBox[{"2", "\[Rule]", "2"}]}], "\[RightAssociation]"}]}], ",", 
     RowBox[{"\<\"LabelBindings\"\>", "\[Rule]", 
      RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}]}], 
    "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"MatchEdgePositions\"\>", "\[Rule]", 
      RowBox[{"{", "2", "}"}]}], ",", 
     RowBox[{"\<\"RuleVertexMap\"\>", "\[Rule]", 
      RowBox[{"\[LeftAssociation]", 
       RowBox[{
        RowBox[{"1", "\[Rule]", "2"}], ",", 
        RowBox[{"2", "\[Rule]", "3"}]}], "\[RightAssociation]"}]}], ",", 
     RowBox[{"\<\"LabelBindings\"\>", "\[Rule]", 
      RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}]}], 
    "\[RightAssociation]"}]}], "}"}]], "Output",ExpressionUUID->"133dd1ca-\
8cc4-c24c-aa98-77ffad0d837b"],

Cell["\<\
Two matches, because the single edge of the input can lie on either edge of \
the chain. Each match says which positions of EdgeList it used and how the \
input's vertices correspond to the hypergraph's.\
\>", "Text",ExpressionUUID->"17f3e20c-3430-ca43-b749-6a998fea5272"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Asking for the matches without rewriting is the way to see why a rule \
applies as often as it does. When a rule produces more events than expected, \
it is almost always the matching that is surprising rather than the rewriting."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"09796699-8fc9-174e-9be7-503cab229b38"],

Cell["What a rule knows about itself", "Subsection",ExpressionUUID->"e8528c7e-e49a-ab47-9c85-eaa22ad68f60"],

Cell["\<\
A rule answers for its two sides and for what it does to vertices, read off \
by identifier:\
\>", "Text",ExpressionUUID->"48141261-a6d9-6c41-a02e-09dbc02c5e89"],

Cell["sub[\"Properties\"]", "Input",ExpressionUUID->"940909ea-5bca-6345-bb45-70d439ffdc3f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Input\"\>", ",", "\<\"Output\"\>", 
   ",", "\<\"SharedVertices\"\>", ",", "\<\"NewVertices\"\>", 
   ",", "\<\"DeletedVertices\"\>", ",", "\<\"Signature\"\>"}], 
  "}"}]], "Output",ExpressionUUID->"94d5d29e-aaf8-1146-9d49-467650a93299"],

Cell["\<\
AssociationMap[sub, {\"SharedVertices\", \"NewVertices\", \
\"DeletedVertices\", \"Signature\"}]\
\>", "Input",ExpressionUUID->"6b17aa79-5173-524a-9e33-9b1e4a43b848"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"SharedVertices\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}]}], ",", 
   RowBox[{"\<\"NewVertices\"\>", "\[Rule]", 
    RowBox[{"{", "3", "}"}]}], ",", 
   RowBox[{"\<\"DeletedVertices\"\>", "\[Rule]", 
    RowBox[{"{", "}"}]}], ",", 
   RowBox[{"\<\"Signature\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "3"}], "}"}]}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",ExpressionUUID->"369f1b71-2f41-ae40-97a6-\
ff654029145c"],

Cell["\<\
\"Signature\" is the shape of the rule: how many edges and vertices on each \
side. A rule that contracts rather than grows has it the other way round:\
\>", "Text",ExpressionUUID->"5f9d972c-1b83-6440-9066-d34db975a39c"],

Cell["\<\
contract = HypergraphRule[{{1, 2}, {2, 3}}, {{1, 3}}];
AssociationMap[contract, {\"SharedVertices\", \"NewVertices\", \
\"DeletedVertices\", \"Signature\"}]\
\>", "Input",ExpressionUUID->"47116113-fc8b-354b-bb33-f3872376d367"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"SharedVertices\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1", ",", "3"}], "}"}]}], ",", 
   RowBox[{"\<\"NewVertices\"\>", "\[Rule]", 
    RowBox[{"{", "}"}]}], ",", 
   RowBox[{"\<\"DeletedVertices\"\>", "\[Rule]", 
    RowBox[{"{", "2", "}"}]}], ",", 
   RowBox[{"\<\"Signature\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"2", ",", "3"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}]}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",ExpressionUUID->"08a5254f-63d6-f249-870e-\
b735fab586e9"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Vertices correspond between the two sides by identifier, so a name on both \
sides is the same vertex and a name on the output alone is a new one. That is \
the whole of the convention, and these three lists are it applied."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"db4a8a4c-347b-9246-9cbb-0f651e784d3f"],

Cell["The matching options", "Subsection",ExpressionUUID->"6fb786fe-0bb3-004c-b1b9-c46731be1187"],

Cell["\<\
Three options govern what counts as a match. \"Labeled\" -> False puts labels \
aside altogether, so a rule written for skeletons applies to a labelled \
hypergraph:\
\>", "Text",ExpressionUUID->"5ba4a062-7029-5b43-8598-5dba37025f38"],

Cell["\<\
labelledPair = Hypergraph[{Edge[{1, 2}, \"Directed\", \"a\"], Edge[{2, 3}, \
\"Directed\", \"b\"]}];
{Length @ HypergraphRuleMatches[HypergraphRule[{Edge[{1, 2}, \"Directed\", \
\"c\"]}, {}], labelledPair],
  Length @ HypergraphRuleMatches[HypergraphRule[{Edge[{1, 2}, \"Directed\", \
\"c\"]}, {}], labelledPair,
     \"Labeled\" -> False]}\
\>", "Input",ExpressionUUID->"542ba474-f497-9a43-b795-9a31be322bf9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "2"}], "}"}]], "Output",ExpressionUUID->"9fcae328-e35d-f644-8225-ff931a129b6f"],

Cell["\<\
\"LabelPatterns\" -> False reads every label literally, so a bare symbol \
stops being a variable. Section 4 is about what that option turns on:\
\>", "Text",ExpressionUUID->"c2a0a7fe-0bdd-4440-810c-ee4a94aaed71"],

Cell["\<\
{Length @ HypergraphRuleMatches[HypergraphRule[{Edge[{1, 2}, \"Directed\", \
w]}, {}], labelledPair],
  Length @ HypergraphRuleMatches[HypergraphRule[{Edge[{1, 2}, \"Directed\", \
w]}, {}], labelledPair,
     \"LabelPatterns\" -> False]}\
\>", "Input",ExpressionUUID->"576537ad-2553-6a48-9e18-926ff2df55c8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "0"}], "}"}]], "Output",ExpressionUUID->"9517dde2-2d43-d14c-9fab-c5423e828f19"],

Cell["\<\
\"DistinctVertices\" -> False lets two vertices of the input fall on one \
vertex of the hypergraph, which is what the next subsection is about:\
\>", "Text",ExpressionUUID->"16908d09-3b87-f546-b2f6-12461ae37f4e"],

Cell["\<\
{Length @ HypergraphRuleMatches[HypergraphRule[{{1, 2}, {2, 3}}, {}], \
Hypergraph[{{1, 2}}]],
  Length @ HypergraphRuleMatches[HypergraphRule[{{1, 2}, {2, 3}}, {}], \
Hypergraph[{{1, 2}}],
     \"DistinctVertices\" -> False]}\
\>", "Input",ExpressionUUID->"52db9984-fa61-f340-9177-f901b9a06911"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "0"}], "}"}]], "Output",ExpressionUUID->"ddd94fe0-8161-464f-be33-b5702c3693e6"],

Cell["\<\
A match on its own says only where it sits: which positions of EdgeList it \
used, how the input's vertices correspond, and what its label variables were \
bound to.\
\>", "Text",ExpressionUUID->"788205e3-ffed-d549-a61b-188173347531"],

Cell["Keys @ First @ HypergraphRuleMatches[sub, chain]", "Input",ExpressionUUID->"35caccb6-5581-3b4b-bbb5-dfab15c1ebf1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"MatchEdgePositions\"\>", ",", "\<\"RuleVertexMap\"\>", 
   ",", "\<\"LabelBindings\"\>"}], "}"}]], "Output",ExpressionUUID->"a5e6ce48-\
941c-2846-b2d9-45445d3c9882"],

Cell["Symmetry decides how many ways a pattern fits", "Subsection",ExpressionUUID->"f1c8b0e7-3a5e-674d-a19c-7f0ffc483fe5"],

Cell["\<\
A pattern edge and the edge it lies on must have the same symmetry type, and \
the pattern is matched over the orderings that type allows. A directed edge \
of arity three fits one way, a cyclic one three ways, an unordered one all \
six:\
\>", "Text",ExpressionUUID->"cf2636cd-e8d2-9943-b97b-38c197f378bf"],

Cell["\<\
Table[
  Length @ HypergraphRuleMatches[
    HypergraphRule[{Edge[{1, 2, 3}, s]}, {}], Hypergraph[{Edge[{1, 2, 3}, \
s]}]],
  {s, {\"Directed\", \"Cyclic\", \"Unordered\"}}]\
\>", "Input",ExpressionUUID->"413f69d1-38b9-894b-a5f0-9cab52cef907"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "3", ",", "6"}], "}"}]], "Output",ExpressionUUID->\
"929706af-e91e-8d45-8954-2ea18410f270"],

Cell["\<\
And the types have to agree, so a directed pattern finds nothing in an \
unordered edge:\
\>", "Text",ExpressionUUID->"0a2260ea-2b37-2448-937c-bcbf93702373"],

Cell["\<\
HypergraphRuleMatches[HypergraphRule[{Edge[{1, 2}, \"Directed\"]}, {}],
  Hypergraph[{Edge[{1, 2}, \"Unordered\"]}]]\
\>", "Input",ExpressionUUID->"e97ae81f-18e0-1749-8048-acbf9b945c1e"],

Cell[BoxData[
 RowBox[{"{", "}"}]], "Output",ExpressionUUID->"9ccc91fc-1482-244b-bc8a-de1d320ff667"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Those six matches of an unordered triple are genuinely six, not one \
reported six times: they differ in which vertex of the hypergraph each vertex \
of the rule corresponds to, and an output that treats its vertices \
differently will produce six different results. When the output is symmetric \
too, the six results coincide, and the multiplicity is then something to \
divide out rather than something wrong."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"48acfdba-178d-0b48-bbad-def5a60943fd"],

Cell["Two vertices of a rule do not fold onto one", "Subsection",ExpressionUUID->"eb982310-b6df-d347-911e-88a0e891181e"],

Cell["\<\
By default distinct vertices of the input match distinct vertices of the \
hypergraph, so a two-vertex pattern does not fit a self-loop:\
\>", "Text",ExpressionUUID->"bb5ed0d2-cf57-cb45-9b7f-ce2d97a9cee6"],

Cell["\<\
{HypergraphRuleMatches[HypergraphRule[{{1, 2}}, {}], Hypergraph[{Edge[{1, \
1}]}]],
  Length @ HypergraphRuleMatches[HypergraphRule[{{1, 2}}, {}], \
Hypergraph[{Edge[{1, 1}]}],
     \"DistinctVertices\" -> False]}\
\>", "Input",ExpressionUUID->"bf0f0f01-7891-cb4c-a9e5-5b313d7f6ea4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "}"}], ",", "1"}], "}"}]], "Output",ExpressionUUID->"6740922b-\
f493-2741-a4c1-d814266bf7ec"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "This follows the reference paclet, which imposes the same by default. It is \
worth knowing that it is a choice: in the Wolfram model a rule's vertices \
need not be distinct, and \"DistinctVertices\" -> False is that convention."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"0acee81f-8c0d-5845-a2cb-b2f1195ad5ae"],

Cell["An edge is used once", "Subsection",ExpressionUUID->"e7bda049-bb74-be49-b64b-1c2b045887ce"],

Cell["\<\
Each edge of the hypergraph is used by at most one edge of the input, so a \
rule wanting two edges wants two of them:\
\>", "Text",ExpressionUUID->"ff958ea3-1591-9641-b63e-999cb0e0b90e"],

Cell["\<\
{HypergraphRuleMatches[HypergraphRule[{{1, 2}, {1, 2}}, {}], \
Hypergraph[{Edge[{1, 2}]}]],
  Length @ HypergraphRuleMatches[HypergraphRule[{{1, 2}, {1, 2}}, {}],
     Hypergraph[{Edge[{1, 2}], Edge[{1, 2}]}]]}\
\>", "Input",ExpressionUUID->"1b363994-b296-c44e-98c3-a7aedd1aae8c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "}"}], ",", "2"}], "}"}]], "Output",ExpressionUUID->"563575c9-\
61f0-a640-9f6f-b56df975dfc2"],

Cell["3. Applying a rule: events", "Section",ExpressionUUID->"e59f213e-c44c-e249-bd4f-324ffe6a8b7b"],

Cell["\<\
Applying a rule gives one event for every match. An event is an association: \
it says what the hypergraph became, and also what was matched, what was \
created and what was destroyed.\
\>", "Text",ExpressionUUID->"4b4076d3-5df7-4549-8665-d4f44145bcda"],

Cell["\<\
events = sub[chain];
Length[events]\
\>", "Input",ExpressionUUID->"46a1ab9c-b3f2-6246-8807-461805149e27"],

Cell[BoxData["2"], "Output",ExpressionUUID->"22bd02ca-2d38-8d42-a17b-c45eea51738b"],

Cell["Keys @ First[events]", "Input",ExpressionUUID->"a1259b79-4480-c940-87db-e510398a3e27"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Hypergraph\"\>", ",", "\<\"Input\"\>", 
   ",", "\<\"EdgeOrigins\"\>", ",", "\<\"MatchVertices\"\>", 
   ",", "\<\"MatchEdges\"\>", ",", "\<\"MatchEdgePositions\"\>", 
   ",", "\<\"NewVertices\"\>", ",", "\<\"NewEdges\"\>", 
   ",", "\<\"DeletedVertices\"\>", ",", "\<\"RuleVertexMap\"\>", 
   ",", "\<\"LabelBindings\"\>", ",", "\<\"Rule\"\>"}], "}"}]], "Output",Expre\
ssionUUID->"a4256a60-ae95-6d4a-a39e-b4c756372f05"],

Cell["\<\
The two results, drawn. Each has subdivided one of the two edges:\
\>", "Text",ExpressionUUID->"8cc52322-a558-b842-a44a-f3e3dcce43d8"],

Cell["#[\"Hypergraph\"] & /@ events", "Input",ExpressionUUID->"7499a480-8045-cd4c-841a-dfcfd4925ca9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   GraphicsBox[
    NamespaceBox["Hypergraphs",
     DynamicModuleBox[{Typeset`hg = HoldComplete[
       WolframInstitute`Hypergraphs`Hypergraph[{
         WolframInstitute`Hypergraphs`Vertex[1], 
