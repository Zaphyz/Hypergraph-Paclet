Cell["\<\
An event carries the hypergraph it acted on under \"Input\", which is what \
makes the left half drawable at all \[LongDash] an event that knew only its \
result could not be drawn:\
\>", "Text",ExpressionUUID->"439692f5-6745-b14e-9cf2-9bb706607672"],

Cell["First[sub[shown]][\"Input\"] === path3", "Input",ExpressionUUID->"074e664b-de4f-254f-b531-0f2dd6ddc671"],

Cell[BoxData["True"], "Output",ExpressionUUID->"94189522-a0ca-354e-aeda-a8a662d4ea6e"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Which edges of the result to highlight is read off \"EdgeOrigins\", the \
record of where each edge of the result came from, rather than by looking for \
edges equal to \"NewEdges\". In a multiset two edges of equal value are still \
two edges, so a rule that creates an edge the hypergraph already had would \
otherwise highlight whichever one happened to sort first."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"d694ab7e-7e00-1449-a7ab-462572eafa94"],

Cell["\<\
doubled = Hypergraph[{Edge[{1, 2}], Edge[{1, 2}]}];
{#[\"EdgeOrigins\"], Flatten @ Position[#[\"EdgeOrigins\"], None]} & @ \
First[sub[doubled]]\
\>", "Input",ExpressionUUID->"e80604b9-f86d-574c-a97e-c4f9b37c4ebb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "None", ",", "None"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"0b2c6b85-0038-3640-accb-cc0a6fe29308"],

Cell["\<\
HypergraphEventPlot[First @ sub[doubled], \"PanelSize\" -> 140]\
\>", "Input",ExpressionUUID->"939802ca-c8b5-9e44-a190-52d128216f2e"],

