Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Choosing the first event each time is a choice made by hand, and it is \
exactly the choice a multiway system refuses to make: it keeps all of them, \
and the branching that results is what its evolution graph draws. Doing it by \
hand here shows what there is to keep."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"cc46e19d-3708-5c49-b498-bf6324366a97"],

Cell["A rule with no match", "Subsection",ExpressionUUID->"9b207a7e-ae4c-db44-a903-3b39af7d25a0"],

Cell["\<\
A rule that does not apply gives no events, which is not a failure but an \
answer:\
\>", "Text",ExpressionUUID->"48c1a66e-aa02-6941-83c2-793348f99f0d"],

Cell["contract[Hypergraph[{Edge[{1, 2}]}]]", "Input",ExpressionUUID->"2aa78c1f-3437-9948-aa05-6c0d7ebc4514"],

Cell[BoxData[
 RowBox[{"{", "}"}]], "Output",ExpressionUUID->"b644b401-ef36-7d43-a61b-e054d22c4c5c"],

Cell["Every state one step away", "Subsection",ExpressionUUID->"4b4f9bf1-efbe-7f45-b231-99641e5be4f0"],

Cell["\<\
All the events at once, from a slightly larger hypergraph, as the states they \
lead to:\
\>", "Text",ExpressionUUID->"7510b386-4907-394d-8c28-6a1cd4771b25"],

Cell["\<\
star = Hypergraph[{Edge[{1, 2}], Edge[{1, 3}], Edge[{1, 4}]}]\
