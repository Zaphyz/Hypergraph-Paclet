Cell["\<\
{Length @ HypergraphRuleMatches[HypergraphRule[{{1, 2}}, {{2, 1}}], \
labelled],
  Length @ HypergraphRuleMatches[HypergraphRule[{Edge[{1, 2}, \"Directed\", \
\"a\"]}, {{2, 1}}], labelled]}\
\>", "Input",ExpressionUUID->"4487ba84-c488-8944-9148-4ebb18db08ff"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "1"}], "}"}]], "Output",ExpressionUUID->"b28987ac-2049-1a48-a599-588cd3311489"],

Cell["\<\
The labelled pattern finds the edge carrying that label, and only it:\
\>", "Text",ExpressionUUID->"97839af4-1127-654f-b654-3658f8457ec3"],

Cell["\<\
First @ HypergraphRuleMatches[
  HypergraphRule[{Edge[{1, 2}, \"Directed\", \"a\"]}, {{2, 1}}], labelled]\
\>", "Input",ExpressionUUID->"7b5a023c-3696-8646-8a78-2c2221e139e8"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"MatchEdgePositions\"\>", "\[Rule]", 
    RowBox[{"{", "1", "}"}]}], ",", 
   RowBox[{"\<\"RuleVertexMap\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"1", "\[Rule]", "1"}], ",", 
      RowBox[{"2", "\[Rule]", "2"}]}], "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"LabelBindings\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}]}], 
  "\[RightAssociation]"}]], "Output",ExpressionUUID->"109070e0-c028-0b43-9b0e-\
a58076bf6c88"],

Cell["\<\
A label nothing carries matches nothing, and \"Labeled\" -> False puts labels \
aside altogether:\
\>", "Text",ExpressionUUID->"49bdc9c2-74fe-1242-80b9-9936d8b35b7b"],

Cell["\<\
{HypergraphRuleMatches[HypergraphRule[{Edge[{1, 2}, \"Directed\", \"c\"]}, \
{}], labelled],
  Length @ HypergraphRuleMatches[HypergraphRule[{Edge[{1, 2}, \"Directed\", \
\"c\"]}, {}], labelled,
     \"Labeled\" -> False]}\
\>", "Input",ExpressionUUID->"e7d4a8f9-dca8-a640-b698-87abdee0f57d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "}"}], ",", "2"}], "}"}]], "Output",ExpressionUUID->"37f09c19-\
b307-a54d-b469-fcd60e45b8b5"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "An unlabelled pattern being a wildcard is what makes a rule written for \
skeletons work unchanged on a labelled hypergraph. The alternative \
\[LongDash] requiring a pattern to be unlabelled in order to match an \
unlabelled edge \[LongDash] would mean writing two versions of every rule."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"47379198-3059-4c41-a2ca-0c04f64eefed"],

Cell["\<\
The output's labels are carried onto the edges it makes, so a rule can label \
what it builds:\
\>", "Text",ExpressionUUID->"86cd279b-d42e-174c-97d1-b751844f54af"],

Cell["\<\
tag = HypergraphRule[{{1, 2}}, {Edge[{1, 3}, \"Directed\", \"first\"],
                           Edge[{3, 2}, \"Directed\", \"second\"]}];
First[tag[Hypergraph[{Edge[{1, 2}]}]]][\"Hypergraph\"]\
\>", "Input",ExpressionUUID->"9062f995-63bb-ed4d-a826-a7d9a76716b2"],

