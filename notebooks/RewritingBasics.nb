Cell["\<\
Vertices correspond between the two sides by name. So the rule can be read \
off: 1 and 2 appear on both sides and are kept, 3 appears only on the right \
and is therefore created.\
\>", "Text",ExpressionUUID->"fb9ea4dd-162e-bd41-9749-feda6d60a97a"],

Cell["\<\
{sub[\"SharedVertices\"], sub[\"NewVertices\"], sub[\"DeletedVertices\"]}\
\>", "Input",ExpressionUUID->"e83908f8-5f27-1a45-be25-1a1160d60d5e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", "3", "}"}], ",", 
   RowBox[{"{", "}"}]}], "}"}]], "Output",ExpressionUUID->"4aac5565-c74f-6c4b-\
868d-8e6990bdac57"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "A name on both sides means the same vertex, and nothing else in the rule \
says so. That is what makes a rule readable as a local surgery: the shared \
vertices are the seam along which the output is sewn in where the input was \
cut out."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"8edc1dd0-e405-d34e-9bab-81162870fa35"],

Cell["A vertex mentioned only on the left is destroyed:", "Text",ExpressionUUID->"4cedcd65-9741-3241-8a11-71a699ae5fcd"],

Cell["HypergraphRule[{{1, 2}}, {{1}}][\"DeletedVertices\"]", "Input",ExpressionUUID->"94ebd108-e81d-f44d-af7d-07f11de3c399"],

Cell[BoxData[
 RowBox[{"{", "2", "}"}]], "Output",ExpressionUUID->"24a0829b-4edd-ac40-8cd7-76fb94271cf8"],

Cell["\<\
Rules are hypergraphs all the way down, so a side may carry symmetry types \
and labels:\
\>", "Text",ExpressionUUID->"26af39ce-2b16-4d44-93bc-1ce843aa51fb"],

Cell["\<\
HypergraphRule[{Edge[{1, 2, 3}, \"Unordered\", \"triple\"]}, {Edge[{1, 2}, \
\"Directed\"]}][\"Input\"]\
\>", "Input",ExpressionUUID->"5e787ff9-af11-2e48-8df2-22a5ac74902c"],

