Cell["\<\
Vertices correspond between the two sides by name. So the rule can be read \
off: 1 and 2 appear on both sides and are kept, 3 appears only on the right \
and is therefore created.\
\>", "Text",ExpressionUUID->"99165076-2298-1045-9528-98dd159f398a"],

Cell["\<\
{sub[\"SharedVertices\"], sub[\"NewVertices\"], sub[\"DeletedVertices\"]}\
\>", "Input",ExpressionUUID->"4897b5d7-414c-204d-9e9a-3d4095f103d9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", "3", "}"}], ",", 
   RowBox[{"{", "}"}]}], "}"}]], "Output",ExpressionUUID->"b91758cf-84e0-2644-\
92eb-c22e10b9bed7"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "A name on both sides means the same vertex, and nothing else in the rule \
says so. That is what makes a rule readable as a local surgery: the shared \
vertices are the seam along which the output is sewn in where the input was \
cut out."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"09a8584f-5922-6044-aa07-7013872098b6"],

Cell["A vertex mentioned only on the left is destroyed:", "Text",ExpressionUUID->"d19bb41c-41b1-624d-aad5-a0a40bba7b3d"],

Cell["HypergraphRule[{{1, 2}}, {{1}}][\"DeletedVertices\"]", "Input",ExpressionUUID->"293b06c1-d13f-864d-a3f1-3c6b4d29884f"],

Cell[BoxData[
 RowBox[{"{", "2", "}"}]], "Output",ExpressionUUID->"b9f387e9-4919-3348-9aee-652b5988df71"],

Cell["\<\
Rules are hypergraphs all the way down, so a side may carry symmetry types \
and labels:\
\>", "Text",ExpressionUUID->"5c5b07e4-8a75-3542-91ff-57ac7d59055b"],

Cell["\<\
HypergraphRule[{Edge[{1, 2, 3}, \"Unordered\", \"triple\"]}, {Edge[{1, 2}, \
\"Directed\"]}][\"Input\"]\
\>", "Input",ExpressionUUID->"e71f7f8e-fc27-0749-9e1e-aad3c2fb78c3"],

