Cell["An event", "Subsection",ExpressionUUID->"4cef8661-f5ce-544b-9d88-eff07dd07ce6"],

Cell["\<\
HypergraphEventPlot is the same idea applied to a particular match: what the \
event acted on with the match highlighted, an arrow, and what it made with \
the creations highlighted.\
\>", "Text",ExpressionUUID->"8e25edba-f7a7-3d4c-ba44-082c2bb91572"],

