Cell["Styling a hypergraph, one element at a time", "Subsection",ExpressionUUID->"b38f5a0e-8c4c-ec4e-a0d4-439032544f24"],

Cell["\<\
All of the above rests on HypergraphPlot taking a style per element. A single \
directive styles everything:\
\>", "Text",ExpressionUUID->"46f5b4d4-aedd-454f-9619-aed19f11867b"],

Cell["\<\
styled = Hypergraph[{Edge[{1, 2}], Edge[{2, 3}], Edge[{1, 2}], Edge[{1, 2, \
3}]}];
HypergraphPlot[styled, EdgeStyle -> Directive[Thick, Purple], VertexStyle -> \
Orange,
  ImageSize -> 220]\
\>", "Input",ExpressionUUID->"5333136a-00d2-9946-bfab-2ab152659c9d"],

