Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "A rule rewrites what it matched. Reaching into an edge it did not match, to \
strike a vertex out of it, would not be local, so a vertex the rule drops but \
another edge still holds simply stays and is not reported destroyed. The \
reference paclet does remove it from those other edges; this is a deliberate \
difference."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"a2c8688e-d4f5-8545-b10e-55f77cc17e34"],

Cell["An empty output deletes the matched edges outright:", "Text",ExpressionUUID->"bee8fb2f-9bee-224a-ac58-d805c3a702f3"],

Cell["First[HypergraphRule[{{1, 2}}, {}][path3]][\"Hypergraph\"]", "Input",ExpressionUUID->"e8efda2e-d13d-ec49-a9fe-75399136fa17"],

