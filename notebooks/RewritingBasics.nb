         FrontFaceColor->GrayLevel[0],
         BackFaceColor->GrayLevel[0],
         GraphicsColor->GrayLevel[0],
         FontColor->GrayLevel[0]], {1., 0.}, 
        ImageScaled[{-0.5, 0.5000000000000001}]], InsetBox[
        StyleBox["s",
         StripOnInput->False,
         LineColor->GrayLevel[0],
         FrontFaceColor->GrayLevel[0],
         BackFaceColor->GrayLevel[0],
         GraphicsColor->GrayLevel[0],
         FontColor->GrayLevel[0]], {0., 1.2246467991473532*^-16}, 
        ImageScaled[{1.5, 0.4999999999999999}]]}}}]],
  Background->GrayLevel[1],
  ImagePadding->20,
  PlotRange->{{0., 1.}, {-0.16666666666666666`, 0.16666666666666677`}},
  PlotRangePadding->Scaled[0.02]]], "Output",ExpressionUUID->"ee79e2a2-23cb-\
7d47-b9d6-94b12ef499ec"],

Cell["\<\
Applying it twice returns the edge to where it began, with the label \
recording that it was daggered twice rather than reduced:\
\>", "Text",ExpressionUUID->"a71bb956-b968-884f-a589-fd0c614a40ba"],

Cell["\<\
EdgeLabel /@ EdgeList @ \
First[dagger[First[dagger[objects]][\"Hypergraph\"]]][\"Hypergraph\"]\
\>", "Input",ExpressionUUID->"2ad4ac5e-dc99-6442-8064-c328eeaa5c83"],

Cell[BoxData[
 RowBox[{"{", 
  TemplateBox[{"\"(\"", 
    SuperscriptBox[
     TemplateBox[{"\"(\"", 
       SuperscriptBox["u", "\[Dagger]"], "\")\""}, "RowDefault"], 
     "\[Dagger]"], "\")\""},
   "RowDefault"], "}"}]], "Output",ExpressionUUID->"e0d7e1fe-e80f-774e-af4d-\
187a9a9fc0a3"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "That the label is not simplified is the right behaviour here: rewriting \
builds the expression, and whether the two daggers cancel is a fact about the \
algebra being modelled rather than about the rewriting. A rule asserting the \
involution would be a second rule, and the two together are what the \
reference notebooks use to check it."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"9608b970-1f8c-6546-b0ea-7f5c9d2976b5"],

Cell["\<\
A rule may also relabel. Where the output gives a vertex a label, that label \
is what the result carries; where it leaves one unlabelled, the hypergraph's \
own label stays:\
\>", "Text",ExpressionUUID->"0eee9e49-e270-7241-8762-3860edd44faf"],

Cell["\<\
swap = HypergraphRule[
  Hypergraph[{Vertex[1, p], Vertex[2, q]}, {Edge[{1, 2}, \"Directed\", x]}],
  Hypergraph[{Vertex[1, q], Vertex[2, p]}, {Edge[{1, 2}, \"Directed\", x]}]];
VertexLabel /@ VertexList @ First[swap[objects]][\"Hypergraph\"]\
\>", "Input",ExpressionUUID->"b6b914b5-f494-9f44-9450-e7cb6ca82707"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"s", ",", "r"}], "}"}]], "Output",ExpressionUUID->"ce5237c8-6ceb-f344-bcd3-5fd65af2dad5"],

Cell["5. Rules from the reference notebooks", "Section",ExpressionUUID->"5e186403-868d-0644-9224-c150a4fdf9f3"],

Cell["\<\
reference/Chemoids.wl builds small algebraic structures out of labelled \
rules: a composition, a unit, a dagger, an action, a zig-zag. Section 4 \
showed the mechanism those rules need; this section runs them and looks at \
the laws they were written to express. There is no multiway system here yet, \
so where the reference draws two steps of an evolution graph, this takes the \
second step by hand \[LongDash] applying the rule again to each state the \
first step produced.\
\>", "Text",ExpressionUUID->"06b9a7e6-6795-164b-8d5a-6cada512fa9b"],

Cell["Composition and the unit", "Subsection",ExpressionUUID->"8adf9a1c-523a-4c45-a270-cb1d2c979f3e"],

Cell["\<\
Composition joins two edges meeting head to tail and names the result after \
them. The unit takes a single labelled vertex and grows an identity edge at \
it. Both are written the way the reference writes them:\
\>", "Text",ExpressionUUID->"5741d5be-556f-444b-bb60-9de52eb25435"],

Cell["\<\
arrowComp = HypergraphRule[
  {Edge[{1, 2}, \"Directed\", x], Edge[{2, 3}, \"Directed\", y]},
  {Edge[{1, 3}, \"Directed\", Row[{\"(\", x, y, \")\"}]]}];
arrowUnit = HypergraphRule[
  Hypergraph[{Vertex[1, p]}, {}],
  Hypergraph[{Vertex[1, p], Vertex[2, p]},
             {Edge[{1, 2}, \"Directed\", Subscript[\"1\", p]]}]];
arrow = Hypergraph[{Vertex[1, r], Vertex[2, s]}, {Edge[{1, 2}, \"Directed\", \
f]}]\
\>", "Input",ExpressionUUID->"8b40d277-c2aa-7c47-8d3e-3003c2776aa2"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["Hypergraphs",
   DynamicModuleBox[{Typeset`hg = HoldComplete[
     WolframInstitute`Hypergraphs`Hypergraph[{
       WolframInstitute`Hypergraphs`Vertex[1, $CellContext`r], 
       WolframInstitute`Hypergraphs`Vertex[2, $CellContext`s]}, {
       WolframInstitute`Hypergraphs`Edge[{
         WolframInstitute`Hypergraphs`Vertex[1, $CellContext`r], 
         WolframInstitute`Hypergraphs`Vertex[2, $CellContext`s]}, 
        "Directed", $CellContext`f]}]]}, 
    {AbsoluteThickness[Medium], Opacity[0.5], Arrowheads[{{Medium, 0.5}}], 
     {Opacity[1], Arrowheads[{{Small, 0.5}}], 
      {Hue[0.63, 0.7, 0.5], Opacity[
       0.7], {ArrowBox[
         LineBox[{{1., 0.}, {0., 1.2246467991473532`*^-16}}]], {}}, 
       {Opacity[1], InsetBox[
         StyleBox["f",
          StripOnInput->False,
          LineColor->Hue[0.63, 0.7, 0.5],
          FrontFaceColor->Hue[0.63, 0.7, 0.5],
          BackFaceColor->Hue[0.63, 0.7, 0.5],
          GraphicsColor->Hue[0.63, 0.7, 0.5],
          FontColor->Hue[0.63, 0.7, 0.5]], {0.5, 0.010000000000000063}]}}}, 
     {Opacity[1], {
       {Hue[0.63, 0.26, 0.89], EdgeForm[{Hue[0.63, 0.7, 0.33], Opacity[
        0.95]}], DiskBox[{1., 0.}, Offset[{2., 2.}, {0., 0.}]]}, 
       {Hue[0.63, 0.26, 0.89], EdgeForm[{Hue[0.63, 0.7, 0.33], Opacity[
        0.95]}], 
        DiskBox[{0., 1.2246467991473532`*^-16}, 
         Offset[{2., 2.}, {0., 0.}]]}}, {InsetBox[
        StyleBox["r",
         StripOnInput->False,
         LineColor->GrayLevel[0],
         FrontFaceColor->GrayLevel[0],
         BackFaceColor->GrayLevel[0],
         GraphicsColor->GrayLevel[0],
         FontColor->GrayLevel[0]], {1., 0.}, 
        ImageScaled[{-0.5, 0.5000000000000001}]], InsetBox[
        StyleBox["s",
         StripOnInput->False,
         LineColor->GrayLevel[0],
         FrontFaceColor->GrayLevel[0],
         BackFaceColor->GrayLevel[0],
         GraphicsColor->GrayLevel[0],
         FontColor->GrayLevel[0]], {0., 1.2246467991473532*^-16}, 
        ImageScaled[{1.5, 0.4999999999999999}]]}}}]],
  Background->GrayLevel[1],
  ImagePadding->20,
  PlotRange->{{0., 1.}, {-0.16666666666666666`, 0.16666666666666677`}},
  PlotRangePadding->Scaled[0.02]]], "Output",ExpressionUUID->"eb5030bd-2652-\
cb46-9e2e-ef5c897aefee"],

Cell["\<\
Both rules against that one state. Composition finds nothing \[LongDash] a \
single edge has nothing to compose with \[LongDash] and the unit fires once \
at each end:\
\>", "Text",ExpressionUUID->"155caffa-dc37-0345-ba56-0219cb2baceb"],

Cell["\<\
EdgeLabel /@ EdgeList[#[\"Hypergraph\"]] & /@ Catenate[Through[{arrowUnit, \
arrowComp}[arrow]]]\
\>", "Input",ExpressionUUID->"461cd4aa-6adf-6a42-8386-d2197bd42a5b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"f", ",", 
     SubscriptBox["\<\"1\"\>", "r"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"f", ",", 
     SubscriptBox["\<\"1\"\>", "s"]}], "}"}]}], "}"}]], "Output",ExpressionUUI\
D->"d078c6f3-4b19-994b-a849-3c89f48b8cf4"],

Cell["\<\
Composing afterwards is the unit law. Of the two states the unit produced, \
only one goes further:\
\>", "Text",ExpressionUUID->"982d9735-b634-554c-9724-1ff47339b31f"],

Cell["\<\
EdgeLabel /@ EdgeList[#[\"Hypergraph\"]] & /@
  Catenate[arrowComp /@ (#[\"Hypergraph\"] & /@ arrowUnit[arrow])]\
\>", "Input",ExpressionUUID->"89f79f82-029f-784d-9061-65cb7e3929f0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   TemplateBox[{"\"(\"", "f", 
     SubscriptBox["\"1\"", "s"], "\")\""},
    "RowDefault"], "}"}], "}"}]], "Output",ExpressionUUID->"ecf9e16b-2a89-\
b14a-9c4f-91761e0992be"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "The unit built at the target of f leaves s, so it follows f head to tail \
and the pair composes; the one built at the source leaves r, which f also \
leaves, so the two share a source rather than meeting, and nothing composes. \
The orientation is doing the work. What comes out is the term (f Subscript[1, \
s]) \[LongDash] the left side of the unit law, not the law itself. Rewriting \
builds terms; asserting that this one equals f is a further rule, or the \
identification of states that a multiway system makes."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"b443dd46-0125-a948-a6db-0185ec6afd41"],

Cell["The dagger is an antihomomorphism", "Subsection",ExpressionUUID->"b5401aac-4e2b-e343-943f-0e544d1b062c"],

Cell["\<\
The dagger rule reverses an edge and daggers its label. Composing first and \
then daggering gives the dagger of the composite:\
\>", "Text",ExpressionUUID->"9751695f-01a4-7847-af4c-bfcddc4d4ff2"],

Cell["\<\
chain2 = Hypergraph[{Edge[{1, 2}, \"Directed\", f], Edge[{2, 3}, \
\"Directed\", g]}];
dag = HypergraphRule[
  Hypergraph[{Vertex[1, p], Vertex[2, q]}, {Edge[{1, 2}, \"Directed\", x]}],
  Hypergraph[{Vertex[1, p], Vertex[2, q]}, {Edge[{2, 1}, \"Directed\", \
SuperDagger[x]]}]];
EdgeLabel /@ EdgeList[#[\"Hypergraph\"]] & /@
  Catenate[dag /@ (#[\"Hypergraph\"] & /@ arrowComp[chain2])]\
\>", "Input",ExpressionUUID->"5c8e88e2-8394-bf4e-b0b2-51bb530bde9e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   SuperscriptBox[
    TemplateBox[{"\"(\"", "f", "g", "\")\""},
     "RowDefault"], "\[Dagger]"], "}"}], "}"}]], "Output",ExpressionUUID->\
"c02f7905-49ad-9348-82ed-9b20fcc7eafe"],

Cell["\<\
Daggering both edges first and then composing gives the composite of the \
daggers, in the other order:\
\>", "Text",ExpressionUUID->"0c6f9fa1-3c07-2c47-a45c-2592bbf0023d"],

Cell["\<\
bothDaggered = Select[
  #[\"Hypergraph\"] & /@ Catenate[dag /@ (#[\"Hypergraph\"] & /@ dag[chain2])],
  FreeQ[EdgeLabel /@ EdgeList[#], SuperDagger[SuperDagger[_]]] &];
DeleteDuplicates[EdgeLabel /@ EdgeList[#[\"Hypergraph\"]] & /@ \
Catenate[arrowComp /@ bothDaggered]]\
\>", "Input",ExpressionUUID->"293d3169-ac8e-7945-bb0e-22f926cf5112"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   TemplateBox[{"\"(\"", 
     SuperscriptBox["g", "\[Dagger]"], 
     SuperscriptBox["f", "\[Dagger]"], "\")\""},
    "RowDefault"], "}"}], "}"}]], "Output",ExpressionUUID->"cdbfc277-4ebb-\
e24e-a69c-0c747a6bdd98"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Two routes out of the same state reach two terms, and the antihomomorphism \
law is the claim that those terms are equal. Nothing here checks that claim; \
what the rewriting does is produce both sides of it from one state, which is \
what makes such a law something a causal or multiway analysis can be asked \
about rather than something asserted by hand. The Select drops the states \
where the same edge was daggered twice \[LongDash] those are the involution, \
not the antihomomorphism."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"f72e84b7-5086-634e-b433-bb6b3448794c"],

Cell["An action", "Subsection",ExpressionUUID->"8750ca7b-f56b-ff4a-8fb3-42b4a7cc073d"],

Cell["\<\
Not every edge in a rule has to be binary. The action rule consumes a unary \
edge \[LongDash] a point carrying an element \[LongDash] together with an \
arrow leaving that vertex, and leaves a point at the far end carrying the \
element acted on:\
\>", "Text",ExpressionUUID->"d500cde8-73ae-7e4d-873c-afb7feccb089"],

Cell["\<\
action = HypergraphRule[
  {Edge[{1}, \"Directed\", a], Edge[{1, 2}, \"Directed\", x]},
  {Edge[{2}, \"Directed\", Row[{x, \"[\", a, \"]\"}]]}];
pointed = Hypergraph[{Edge[{1}, \"Directed\", u], Edge[{1, 2}, \"Directed\", \
f],
                      Edge[{2, 3}, \"Directed\", g]}]\
\>", "Input",ExpressionUUID->"25f43d03-942f-3d40-ba6d-891440e0e515"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["Hypergraphs",
   DynamicModuleBox[{Typeset`hg = HoldComplete[
     WolframInstitute`Hypergraphs`Hypergraph[{
       WolframInstitute`Hypergraphs`Vertex[1], 
       WolframInstitute`Hypergraphs`Vertex[2], 
       WolframInstitute`Hypergraphs`Vertex[3]}, {
       WolframInstitute`Hypergraphs`Edge[{
         WolframInstitute`Hypergraphs`Vertex[1]}, "Directed", $CellContext`u], 
       WolframInstitute`Hypergraphs`Edge[{
         WolframInstitute`Hypergraphs`Vertex[1], 
         WolframInstitute`Hypergraphs`Vertex[2]}, "Directed", $CellContext`f], 
       WolframInstitute`Hypergraphs`Edge[{
         WolframInstitute`Hypergraphs`Vertex[2], 
         WolframInstitute`Hypergraphs`Vertex[3]}, 
        "Directed", $CellContext`g]}]]}, 
    {AbsoluteThickness[Medium], Opacity[0.5], Arrowheads[{{Medium, 0.5}}], {
      {Hue[0.63, 0.66, 0.81], Opacity[
       0.1], {DiskBox[{0., 3.6739403974420594`*^-16}, Offset[12.]], {}}, 
       {Opacity[1], InsetBox[
         StyleBox["u",
          StripOnInput->False,
          LineColor->Hue[0.63, 0.7, 0.5],
          FrontFaceColor->Hue[0.63, 0.7, 0.5],
          BackFaceColor->Hue[0.63, 0.7, 0.5],
          GraphicsColor->Hue[0.63, 0.7, 0.5],
          
          FontColor->Hue[
           0.63, 0.7, 
            0.5]], {0.019999999999999882, 0.019999999999996486}]}}, 
      {Opacity[1], Arrowheads[{{Small, 0.5}}], 
       {Hue[0.63, 0.7, 0.5], Opacity[
        0.7], {ArrowBox[
          LineBox[{{0., 3.6739403974420594`*^-16}, {1., 
           2.4492935982947064`*^-16}}]], {}}, 
        {Opacity[1], InsetBox[
          StyleBox["f",
           StripOnInput->False,
           LineColor->Hue[0.63, 0.7, 0.5],
           FrontFaceColor->Hue[0.63, 0.7, 0.5],
           BackFaceColor->Hue[0.63, 0.7, 0.5],
           GraphicsColor->Hue[0.63, 0.7, 0.5],
           FontColor->Hue[0.63, 0.7, 0.5]], {0.5, 0.020000000000000313}]}}}, 
      {Opacity[1], Arrowheads[{{Small, 0.5}}], 
       {Hue[0.63, 0.7, 0.5], Opacity[
        0.7], {ArrowBox[
          LineBox[{{1., 2.4492935982947064`*^-16}, {2., 0.}}]], {}}, 
        {Opacity[1], InsetBox[
          StyleBox["g",
           StripOnInput->False,
           LineColor->Hue[0.63, 0.7, 0.5],
           FrontFaceColor->Hue[0.63, 0.7, 0.5],
           BackFaceColor->Hue[0.63, 0.7, 0.5],
           GraphicsColor->Hue[0.63, 0.7, 0.5],
           FontColor->Hue[0.63, 0.7, 0.5]], {1.5, 0.02000000000000013}]}}}}, 
     {Opacity[1], {
       {Hue[0.63, 0.26, 0.89], EdgeForm[{Hue[0.63, 0.7, 0.33], Opacity[
        0.95]}], 
        DiskBox[{0., 3.6739403974420594`*^-16}, 
         Offset[{2., 2.}, {0., 0.}]]}, 
       {Hue[0.63, 0.26, 0.89], EdgeForm[{Hue[0.63, 0.7, 0.33], Opacity[
        0.95]}], 
        DiskBox[{1., 2.4492935982947064`*^-16}, 
         Offset[{2., 2.}, {0., 0.}]]}, 
       {Hue[0.63, 0.26, 0.89], EdgeForm[{Hue[0.63, 0.7, 0.33], Opacity[
        0.95]}], DiskBox[{2., 0.}, Offset[{2., 2.}, {0., 0.}]]}}, {InsetBox[
        StyleBox["1",
         StripOnInput->False,
         LineColor->GrayLevel[0],
         FrontFaceColor->GrayLevel[0],
         BackFaceColor->GrayLevel[0],
         GraphicsColor->GrayLevel[0],
         FontColor->GrayLevel[0]], {0., 3.6739403974420594*^-16}, 
        ImageScaled[{1.5, 0.49999999999999983}]], InsetBox[
        StyleBox["2",
         StripOnInput->False,
         LineColor->GrayLevel[0],
         FrontFaceColor->GrayLevel[0],
         BackFaceColor->GrayLevel[0],
         GraphicsColor->GrayLevel[0],
         FontColor->GrayLevel[0]], {1., 2.4492935982947064*^-16}, 
        ImageScaled[{0.5, -0.5}]], InsetBox[
        StyleBox["3",
         StripOnInput->False,
         LineColor->GrayLevel[0],
         FrontFaceColor->GrayLevel[0],
         BackFaceColor->GrayLevel[0],
         GraphicsColor->GrayLevel[0],
         FontColor->GrayLevel[0]], {2., 0.}, 
        ImageScaled[{-0.5, 0.5000000000000002}]]}}}]],
  Background->GrayLevel[1],
  ImagePadding->20,
  PlotRange->{{0., 2.}, {-0.3333333333333333, 0.3333333333333337}},
  PlotRangePadding->Scaled[0.02]]], "Output",ExpressionUUID->"03bbf546-be0d-\
b349-9baa-6f0af72e1418"],

Cell["\<\
Acting twice moves the point along the chain, one arrow at a time:\
\>", "Text",ExpressionUUID->"8113a8eb-c3ab-f64f-9b06-43b5f7a08a26"],

Cell["\<\
EdgeLabel /@ EdgeList[#[\"Hypergraph\"]] & /@
  Catenate[action /@ (#[\"Hypergraph\"] & /@ action[pointed])]\
\>", "Input",ExpressionUUID->"0b40d412-d926-0e4e-bfa9-64cfe838115a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   TemplateBox[{"g", "\"[\"", 
     TemplateBox[{"f", "\"[\"", "u", "\"]\""}, "RowDefault"], "\"]\""},
    "RowDefault"], "}"}], "}"}]], "Output",ExpressionUUID->"3087dcb5-4f93-\
8441-bf2d-97fff1fe1c2c"],

Cell["\<\
Composing the two arrows first and acting once gives the other side of the \
associativity law:\
\>", "Text",ExpressionUUID->"71047182-8519-c14c-ae11-235411638e94"],

Cell["\<\
EdgeLabel /@ EdgeList[#[\"Hypergraph\"]] & /@
  Catenate[action /@ (#[\"Hypergraph\"] & /@ arrowComp[pointed])]\
\>", "Input",ExpressionUUID->"f09af318-809a-8a46-be3f-36d493d37fbe"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   TemplateBox[{
     TemplateBox[{"\"(\"", "f", "g", "\")\""}, "RowDefault"], "\"[\"", "u", 
     "\"]\""},
    "RowDefault"], "}"}], "}"}]], "Output",ExpressionUUID->"9e642dce-7e64-\
9a4d-be00-f01d9ee20c2c"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "The two results are g[f[u]] and (f g)[u]. Which of f and g ends up \
outermost is fixed by the composition convention, not by the rewriting: \
arrowComp writes the composite in diagram order, first arrow first, so acting \
through the composite applies f before g and the nested form has g outside. \
Writing the composite the other way round would swap them. Both rules match \
on the same structure either way."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"5f78a86a-c681-7849-aa6d-8fc9bb3bd284"],

Cell["Zig-zag composition", "Subsection",ExpressionUUID->"bccd4275-b2cf-9a41-b90b-c5748054e450"],

Cell["\<\
The input of a rule need not be a directed path. This one matches three edges \
meeting at two shared vertices with the middle one reversed, and replaces \
them by a single edge across:\
\>", "Text",ExpressionUUID->"4ae5f219-e567-8741-a42b-4aafd176d81c"],

Cell["\<\
zigzag = HypergraphRule[
  {Edge[{1, 2}, \"Directed\", x], Edge[{3, 2}, \"Directed\", y], Edge[{3, 4}, \
\"Directed\", z]},
  {Edge[{1, 4}, \"Directed\", Row[{\"(\", x, y, z, \")\"}]]}];
long = Hypergraph[{Edge[{1, 2}, \"Directed\", a], Edge[{3, 2}, \"Directed\", \
b],
                   Edge[{3, 4}, \"Directed\", c], Edge[{5, 4}, \"Directed\", \
d],
                   Edge[{5, 6}, \"Directed\", e]}]\
\>", "Input",ExpressionUUID->"09c2fb7f-cf90-2447-aa13-c852f0bf9136"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["Hypergraphs",
   DynamicModuleBox[{Typeset`hg = HoldComplete[
     WolframInstitute`Hypergraphs`Hypergraph[{
       WolframInstitute`Hypergraphs`Vertex[1], 
       WolframInstitute`Hypergraphs`Vertex[2], 
       WolframInstitute`Hypergraphs`Vertex[3], 
       WolframInstitute`Hypergraphs`Vertex[4], 
       WolframInstitute`Hypergraphs`Vertex[5], 
       WolframInstitute`Hypergraphs`Vertex[6]}, {
       WolframInstitute`Hypergraphs`Edge[{
         WolframInstitute`Hypergraphs`Vertex[1], 
         WolframInstitute`Hypergraphs`Vertex[2]}, "Directed", $CellContext`a], 
       WolframInstitute`Hypergraphs`Edge[{
         WolframInstitute`Hypergraphs`Vertex[3], 
         WolframInstitute`Hypergraphs`Vertex[2]}, "Directed", $CellContext`b], 
       WolframInstitute`Hypergraphs`Edge[{
         WolframInstitute`Hypergraphs`Vertex[3], 
         WolframInstitute`Hypergraphs`Vertex[4]}, "Directed", $CellContext`c], 
       WolframInstitute`Hypergraphs`Edge[{
         WolframInstitute`Hypergraphs`Vertex[5], 
         WolframInstitute`Hypergraphs`Vertex[4]}, "Directed", $CellContext`d], 
       WolframInstitute`Hypergraphs`Edge[{
         WolframInstitute`Hypergraphs`Vertex[5], 
         WolframInstitute`Hypergraphs`Vertex[6]}, 
