Cell["\<\
Handing a layout back gives the same layout, which is the property everything \
else relies on:\
\>", "Text",ExpressionUUID->"2cca9346-5ca4-2348-a5de-80a3373f7fc7"],

Cell["\<\
triangle = Hypergraph[{Edge[{1, 2}], Edge[{2, 3}], Edge[{3, 1}]}];
here = Thread[VertexID /@ VertexList[triangle] -> \
HypergraphEmbedding[triangle]];
Chop[HypergraphEmbedding[triangle, VertexCoordinates -> here] - \
HypergraphEmbedding[triangle]]\
\>", "Input",ExpressionUUID->"93056a93-411f-eb43-97cd-fde2ea493f30"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"71021330-3cff-c943-9e85-1f9f3143df57"],

Cell["\<\
And a different hypergraph can be drawn on it, which is how the two halves of \
an event come to line up:\
\>", "Text",ExpressionUUID->"c7b03336-b6fd-1841-ae0f-af11ba433de7"],

Cell["\<\
{HypergraphPlot[triangle, ImageSize -> 190],
  HypergraphPlot[Hypergraph[{Edge[{1, 2}], Edge[{2, 3}]}], VertexCoordinates \
-> here,
    ImageSize -> 190]}\
\>", "Input",ExpressionUUID->"5191ee61-98fd-1d44-83ab-449013c0ba48"],

