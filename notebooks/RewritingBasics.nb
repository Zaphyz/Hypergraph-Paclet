Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Positions are what a multiset needs. This hypergraph has the edge {1, 2} \
twice, and only a position can say which of the two to colour \[LongDash] \
which is exactly what highlighting a match requires, since a match covers \
particular edges and not every edge that looks like them. Where a vertex is \
itself named by an integer the identifier wins over the position reading, \
since that is what anyone writing VertexStyle -> {1 -> Red} means."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"13fa9be8-5300-7d40-9074-b0f498887211"],

Cell["\<\
{HypergraphPlot[styled, EdgeStyle -> {1 -> Red}, ImageSize -> 190],
  HypergraphPlot[styled, EdgeStyle -> {3 -> Red}, ImageSize -> 190]}\
\>", "Input",ExpressionUUID->"5bff47ae-65c5-c242-b97c-015dbb4b7bd2"],

Cell[BoxData[
