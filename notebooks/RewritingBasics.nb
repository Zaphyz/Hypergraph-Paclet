 RowBox[{"{", 
  RowBox[{"2", ",", "1"}], "}"}]], "Output",ExpressionUUID->"b5ba6fce-5724-3542-b88b-76b06eeed880"],

Cell["\<\
The labelled pattern finds the edge carrying that label, and only it:\
\>", "Text",ExpressionUUID->"380d17ad-8f66-d447-8fca-6364662ef114"],

Cell["\<\
First @ HypergraphRuleMatches[
  HypergraphRule[{Edge[{1, 2}, \"Directed\", \"a\"]}, {{2, 1}}], labelled]\
\>", "Input",ExpressionUUID->"c038ce14-42d9-ef4e-b6d9-5c946a3a812e"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"MatchEdgePositions\"\>", "\[Rule]", 
    RowBox[{"{", "1", "}"}]}], ",", 
   RowBox[{"\<\"RuleVertexMap\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"1", "\[Rule]", "1"}], ",", 
      RowBox[{"2", "\[Rule]", "2"}]}], "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"LabelBindings\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}]}], 
  "\[RightAssociation]"}]], "Output",ExpressionUUID->"011a21bf-b127-4d4a-81fc-\
c7a103f21694"],

Cell["\<\
A label nothing carries matches nothing, and \"Labeled\" -> False puts labels \
aside altogether:\
\>", "Text",ExpressionUUID->"8738563c-bc83-d64f-9052-a576fc560e44"],

Cell["\<\
{HypergraphRuleMatches[HypergraphRule[{Edge[{1, 2}, \"Directed\", \"c\"]}, \
{}], labelled],
  Length @ HypergraphRuleMatches[HypergraphRule[{Edge[{1, 2}, \"Directed\", \
\"c\"]}, {}], labelled,
     \"Labeled\" -> False]}\
\>", "Input",ExpressionUUID->"4b423be6-ada0-a94d-aae6-99131f4fa474"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "}"}], ",", "2"}], "}"}]], "Output",ExpressionUUID->"547a20f1-\
78fc-b44f-a270-542b0263c06d"],

Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "An unlabelled pattern being a wildcard is what makes a rule written for \
skeletons work unchanged on a labelled hypergraph. The alternative \
\[LongDash] requiring a pattern to be unlabelled in order to match an \
unlabelled edge \[LongDash] would mean writing two versions of every rule."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"7ac162fd-9630-6442-a4a3-6e3e2d6f0da1"],

Cell["\<\
The output's labels are carried onto the edges it makes, so a rule can label \
what it builds:\
\>", "Text",ExpressionUUID->"b6c62466-df39-5e49-9c9b-eb9068a6e658"],

Cell["\<\
tag = HypergraphRule[{{1, 2}}, {Edge[{1, 3}, \"Directed\", \"first\"],
                           Edge[{3, 2}, \"Directed\", \"second\"]}];
First[tag[Hypergraph[{Edge[{1, 2}]}]]][\"Hypergraph\"]\
\>", "Input",ExpressionUUID->"292e4b92-16c4-744d-9623-0192ee8d8763"],

