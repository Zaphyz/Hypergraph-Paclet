Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "An event is reported rather than just a result because a result on its own \
forgets how it came about. Which edges were consumed and which were produced \
is exactly what decides whether two events could have happened in either \
order, so the causal machinery to come needs all of it. Returning it now \
costs nothing and means that machinery will not have to match the rule a \
second time."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"d7d46921-e8e5-534d-9eb2-beedf5821faa"],

Cell["\<\
rule[hg] and HypergraphRuleApply are the same thing, the first being the \
reference paclet's way of writing it:\
\>", "Text",ExpressionUUID->"ecc6351b-1191-7d4d-9bac-90db03438671"],

Cell["sub[chain] === HypergraphRuleApply[sub, chain]", "Input",ExpressionUUID->"56ee141a-d1d5-4347-84d8-b8f0251e0da9"],

Cell[BoxData["True"], "Output",ExpressionUUID->"4a6750c0-52df-ee4d-96c1-adb7dc606d3f"],

Cell["Every key of an event", "Subsection",ExpressionUUID->"35a466f7-637d-e346-a9d3-fdcb6a2da0a9"],

Cell["\<\
An event is an association, and each of its keys answers one question. Taking \
a single event and going through them:\
\>", "Text",ExpressionUUID->"106682d0-e1b5-ae4a-921e-ca9db1becde8"],

Cell["\<\
oneEvent = First @ sub[chain];
Keys[oneEvent]\
\>", "Input",ExpressionUUID->"992e783f-0846-6d41-9e31-b2ec76d2a765"],

