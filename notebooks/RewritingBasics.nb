Cell["\<\
An empty list of rules changes nothing, so a list of highlights can be built \
and passed without checking whether it came out empty:\
\>", "Text",ExpressionUUID->"b08bb15e-cf68-674f-8bb9-f3fb97cd0302"],

Cell["\<\
HypergraphPlot[styled, EdgeStyle -> {}] === HypergraphPlot[styled]\
\>", "Input",ExpressionUUID->"caa4ce0b-9652-4547-b611-ff339930497f"],

Cell[BoxData["True"], "Output",ExpressionUUID->"2600fc6d-e89a-fa47-a251-0391eabf6660"],

Cell["\<\
\"EdgeLineStyle\" colours the boundary lines and arrowheads rather than the \
fill, and the two label styles do what their names say:\
\>", "Text",ExpressionUUID->"0423e7af-8972-9749-9e64-25ebe63ed53d"],

Cell["\<\
HypergraphPlot[styled, \"EdgeLineStyle\" -> Purple, EdgeLabelStyle -> Purple,
  VertexLabelStyle -> {1 -> Red}, ImageSize -> 240]\
\>", "Input",ExpressionUUID->"dd9dda39-56de-674c-8585-8c88c751b652"],

