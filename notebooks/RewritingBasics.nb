Cell["2. Matching", "Section",ExpressionUUID->"a045fa12-dbc6-b647-9b7c-bbc0d4f4bd3a"],

Cell["\<\
Before anything is rewritten, the input has to be found. \
HypergraphRuleMatches gives the ways it sits inside a hypergraph, and nothing \
else:\
\>", "Text",ExpressionUUID->"733811c7-0e3e-8f4e-b748-ec455dce44e1"],

Cell["chain = Hypergraph[{Edge[{1, 2}], Edge[{2, 3}]}]", "Input",ExpressionUUID->"4b618529-1af7-9a47-a58d-7ccc55b458f7"],

