Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Choosing the first event each time is a choice made by hand, and it is \
exactly the choice a multiway system refuses to make: it keeps all of them, \
and the branching that results is what its evolution graph draws. Doing it by \
hand here shows what there is to keep."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"4eb4e70c-c96c-7645-a277-c7bb3ee8147f"],

Cell["A rule with no match", "Subsection",ExpressionUUID->"545a40f6-7978-8e4f-ac12-1b8a223dfa61"],

Cell["\<\
A rule that does not apply gives no events, which is not a failure but an \
answer:\
\>", "Text",ExpressionUUID->"e18b92df-338f-3846-b529-4a7e2953b637"],

Cell["contract[Hypergraph[{Edge[{1, 2}]}]]", "Input",ExpressionUUID->"181d1ab7-0db4-1a45-8b4d-3e686a46d905"],

