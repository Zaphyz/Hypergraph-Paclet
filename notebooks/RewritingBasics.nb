Cell[TextData[{
 StyleBox["Design note.  ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Choosing the first event each time is a choice made by hand, and it is \
exactly the choice a multiway system refuses to make: it keeps all of them, \
and the branching that results is what its evolution graph draws. Doing it by \
hand here shows what there is to keep."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 0}, {6, 6}},
 CellFrameColor->GrayLevel[0.7],
 FontColor->GrayLevel[
  0.25],ExpressionUUID->"3a7ca460-d25f-5c4c-9e0c-455567c11b7b"],

Cell["A rule with no match", "Subsection",ExpressionUUID->"044f1fa1-3c47-5b48-98fe-148afe0397ad"],

Cell["\<\
A rule that does not apply gives no events, which is not a failure but an \
answer:\
\>", "Text",ExpressionUUID->"f3d584c0-bebf-2544-b961-bb8afaf57f22"],

Cell["contract[Hypergraph[{Edge[{1, 2}]}]]", "Input",ExpressionUUID->"36a1a42d-cb64-fe46-a773-c313b4b2409e"],

Cell[BoxData[
 RowBox[{"{", "}"}]], "Output",ExpressionUUID->"1620ec21-7b6e-9947-a1eb-9d9c39290dc6"],

Cell["Every state one step away", "Subsection",ExpressionUUID->"31dc07a5-c3ae-c646-8476-5e0fcf11a9d4"],

Cell["\<\
All the events at once, from a slightly larger hypergraph, as the states they \
lead to:\
\>", "Text",ExpressionUUID->"b0078726-bf06-3c44-bab3-0c836ebdc0b6"],

