Cell["\<\
Placing only some of the vertices settles the rest among them rather than \
laying them out separately. A vertex a rewrite has just inserted into an edge \
lands between that edge's two ends:\
\>", "Text",ExpressionUUID->"c90a2280-b900-af43-92cc-84c804c67a62"],

Cell["\<\
HypergraphPlot[First[sub[triangle]][\"Hypergraph\"], VertexCoordinates -> here,
  VertexLabels -> \"Name\", ImageSize -> 240]\
\>", "Input",ExpressionUUID->"1f4db01c-0fe4-7b4a-ab91-99dab215ad11"],

