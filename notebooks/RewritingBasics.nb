reference paclet's way of writing it:\
\>", "Text",ExpressionUUID->"be5151aa-cc71-9d41-9502-70d41e405a74"],

Cell["sub[chain] === HypergraphRuleApply[sub, chain]", "Input",ExpressionUUID->"1388ba6b-4dcc-c942-90a8-ecd8659d28af"],

