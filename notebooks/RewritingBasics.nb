Cell["\<\
Handing a layout back gives the same layout, which is the property everything \
else relies on:\
\>", "Text",ExpressionUUID->"845c343d-94e1-584f-bd5d-daaa6ac91b5a"],

Cell["\<\
triangle = Hypergraph[{Edge[{1, 2}], Edge[{2, 3}], Edge[{3, 1}]}];
here = Thread[VertexID /@ VertexList[triangle] -> \
HypergraphEmbedding[triangle]];
Chop[HypergraphEmbedding[triangle, VertexCoordinates -> here] - \
HypergraphEmbedding[triangle]]\
\>", "Input",ExpressionUUID->"13cf2ce3-3200-554f-b21d-64121ea057e9"],

Cell[BoxData[
 RowBox[{"{", 
