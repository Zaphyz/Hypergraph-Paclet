Cell[BoxData[{
 RowBox[{
  RowBox[{"SetEdgeLabel", "[", 
   RowBox[{"label_", ",", "hyp_", ",", "edge_"}], "]"}], ":=", 
  RowBox[{"Hypergraph", "[", 
   RowBox[{"hyp", ",", 
    RowBox[{"EdgeLabels", "->", 
     RowBox[{"{", 
      RowBox[{"edge", "->", "label"}], "}"}]}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"HyperCompose", "[", "rule_", "]"}], "[", "args_", "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"ResourceFunction", "[", "\"\<AllSameBy\>\"", "]"}], "[", 
     RowBox[{"args", ",", "VertexCount"}], "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", 
        RowBox[{"EdgeList", "[", 
         RowBox[{"rule", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], "==", 
       RowBox[{"Length", "[", "args", "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"vars", "=", 
           RowBox[{"ToExpression", "/@", 
            RowBox[{"Alphabet", "[", "]"}]}]}], ",", 
          RowBox[{"largs", "=", 
           RowBox[{"MapThread", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"SetEdgeLabel", "[", 
               RowBox[{"#1", ",", "#2", ",", "All"}], "]"}], "&"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Array", "[", 
                RowBox[{"\[FormalA]", ",", 
                 RowBox[{"Length", "[", "args", "]"}]}], "]"}], ",", "args"}],
               "}"}]}], "]"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"lrule", "=", 
             RowBox[{"HypergraphRule", "[", 
              RowBox[{
               RowBox[{"Hypergraph", "[", 
                RowBox[{
                 RowBox[{"rule", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], ",", 
                 RowBox[{"EdgeLabels", "->", 
                  RowBox[{"Thread", "[", 
                   RowBox[{
                    RowBox[{"EdgeList", "[", 
                    RowBox[{"rule", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "]"}], "->", 
                    RowBox[{"Table", "[", 
                    RowBox[{
                    RowBox[{"vars", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"i", ",", 
                    RowBox[{"Length", "[", 
                    RowBox[{"EdgeList", "[", 
                    RowBox[{"test3rule", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}]}], "}"}]}], 
                    "]"}]}], "]"}]}]}], "]"}], ",", 
               RowBox[{"rule", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], ",", 
            RowBox[{"lhyp", "=", 
             RowBox[{"Plus", "@@", "largs"}]}]}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"OnePassRewriting", "[", 
           RowBox[{"lrule", ",", "lhyp"}], "]"}]}], "\[IndentingNewLine]", 
         "]"}]}], "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
      "\"\<Non-conformable number of arguments and input edges.\>\""}], 
     "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
    "\"\<Hypergraph arguments defined on different node sets.\>\""}], 
   "\[IndentingNewLine]", "]"}]}]}], "Input",
