Cell[BoxData[
 RowBox[{
  RowBox[{"PlexDiagram", "[", 
   RowBox[{"plexlist_List", ",", "indexlist_List", ",", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"indicesALL", "=", 
      RowBox[{"DeleteDuplicates", "[", 
       RowBox[{"Join", "@@", "plexlist"}], "]"}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"indicesC", "=", "indexlist"}], ",", 
        RowBox[{"indicesF", "=", 
         RowBox[{"DeleteElements", "[", 
          RowBox[{"indicesALL", ",", "indexlist"}], "]"}]}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Hypergraph", "[", 
       RowBox[{"indicesALL", ",", "plexlist", ",", "\[IndentingNewLine]", 
        RowBox[{"VertexLabels", "->", "Automatic"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"VertexSize", "->", 
         RowBox[{"Thread", "[", 
          RowBox[{"indicesC", "->", "0.02"}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"VertexStyle", "->", 
         RowBox[{"Thread", "[", 
          RowBox[{"indicesC", "->", 
           TemplateBox[<|"color" -> RGBColor[0.77, 0.77, 0.77]|>,
            "RGBColorSwatchTemplate"]}], "]"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"VertexSize", "->", 
         RowBox[{"Thread", "[", 
          RowBox[{"indicesF", "->", "0.02"}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"VertexStyle", "->", 
         RowBox[{"Thread", "[", 
          RowBox[{"indicesF", "->", 
           TemplateBox[<|"color" -> GrayLevel[0]|>,
            "GrayLevelColorSwatchTemplate"]}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"EdgeStyle", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", "__", "}"}], "->", 
           RowBox[{"RGBColor", "[", 
            RowBox[{"0.7", ",", "0.7", ",", "0.7", ",", "0.49"}], "]"}]}], 
          "}"}]}], ",", "\[IndentingNewLine]", 
