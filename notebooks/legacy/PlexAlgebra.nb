Cell["Plex Diagram \[Rule] Array Product", "Section",
 CellChangeTimes->{{3.92047345921845*^9, 3.920473491869804*^9}, {
  3.9206363933598824`*^9, 
  3.9206364007899323`*^9}},ExpressionUUID->"dec6a935-d53a-6a48-9b1e-\
c233e8d224aa"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PlexProduct", "[", "plex_", "]"}], ":=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"contractV", "=", 
       RowBox[{"ContractIndices", "[", "plex", "]"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"freeV", "=", 
       RowBox[{"DeleteElements", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "plex", "]"}], ",", 
         RowBox[{"ContractIndices", "[", "plex", "]"}]}], "]"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"arrayE", "=", 
       RowBox[{"DeleteElements", "[", 
        RowBox[{
         RowBox[{"EdgeList", "[", "plex", "]"}], ",", 
         RowBox[{"ContractIndices", "[", "plex", "]"}]}], "]"}]}]}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"args", "=", 
        RowBox[{"Array", "[", 
         RowBox[{"Slot", ",", 
          RowBox[{"Length", "[", "arrayE", "]"}]}], "]"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Function", "[", 
       RowBox[{"IndexContract", "[", 
        RowBox[{"args", ",", 
         RowBox[{"arrayE", "->", "freeV"}]}], "]"}], "]"}]}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.920530533132269*^9, 3.9205307135440216`*^9}, {
